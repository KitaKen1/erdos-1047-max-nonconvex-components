section


/-!
# Low-degree audit for the strict version of Erdős Problem 1047

The current upstream `max_non_convex_components` statement uses strict
sublevel sets and does not impose a root-count hypothesis.  This file closes
the completely elementary degrees zero and one for that exact shape of target.
It is intentionally separate from the older closed-sublevel surrogate in
`Erdos1047MaxNonConvexFC`.
-/

open Polynomial
open Set

namespace Erdos1047StrictLowDegreeAudit

noncomputable section

def strictAttainableNonConvexCounts (n : ℕ) : Set ℕ :=
  {k : ℕ | ∃ (f : ℂ[X]) (c : ℝ), f.Monic ∧ f.natDegree = n ∧ 0 < c ∧
    {t ∈ Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) |
      ¬ Convex ℝ t}.ncard = k}

theorem strict_nonconvexComponents_eq_empty_of_convex {S : Set ℂ}
    (hS : Convex ℝ S) :
    {t ∈ Erdos1047.componentsIn S | ¬ Convex ℝ t} = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.mpr
  rintro t ⟨⟨z, hz, rfl⟩, ht⟩
  apply ht
  rw [hS.isPreconnected.connectedComponentIn hz]
  exact hS

theorem strict_sublevel_convex_of_monic_degree_le_one (f : ℂ[X])
    (hf : f.Monic) (hdeg : f.natDegree ≤ 1) (c : ℝ) :
    Convex ℝ (Erdos1047.strictSublevelSet f c) := by
  by_cases h0 : f.natDegree = 0
  · have heq : f = 1 := hf.natDegree_eq_zero.mp h0
    rw [heq]
    by_cases hc : (1 : ℝ) < c
    · simpa [Erdos1047.strictSublevelSet, hc] using
        (convex_univ : Convex ℝ (Set.univ : Set ℂ))
    · have hempty : Erdos1047.strictSublevelSet (1 : ℂ[X]) c = ∅ := by
        ext z
        simp [Erdos1047.strictSublevelSet, hc]
      rw [hempty]
      exact convex_empty
  · have h1 : f.natDegree = 1 := by omega
    have heq : f = X + C (f.coeff 0) := hf.eq_X_add_C h1
    rw [heq]
    have hset : Erdos1047.strictSublevelSet (X + C (f.coeff 0)) c =
        Metric.ball (-(f.coeff 0)) c := by
      ext z
      simp [Erdos1047.strictSublevelSet, Metric.mem_ball, dist_eq_norm,
        sub_neg_eq_add]
    rw [hset]
    exact convex_ball _ _

theorem strict_attainable_eq_zero_of_degree_le_one {n k : ℕ}
    (hn : n ≤ 1) (hk : k ∈ strictAttainableNonConvexCounts n) : k = 0 := by
  obtain ⟨f, c, hf, hdeg, hc, hkcount⟩ := hk
  have hconv := strict_sublevel_convex_of_monic_degree_le_one f hf
    (by simpa [hdeg] using hn) c
  rw [strict_nonconvexComponents_eq_empty_of_convex hconv,
    Set.ncard_empty] at hkcount
  exact hkcount.symm

theorem strict_zero_attainable_of_degree_zero :
    0 ∈ strictAttainableNonConvexCounts 0 := by
  refine ⟨1, 2, monic_one, by simp, by norm_num, ?_⟩
  have huniv : Erdos1047.strictSublevelSet (1 : ℂ[X]) 2 = Set.univ := by
    ext z
    simp [Erdos1047.strictSublevelSet]
  rw [huniv]
  rw [strict_nonconvexComponents_eq_empty_of_convex (convex_univ :
    Convex ℝ (Set.univ : Set ℂ))]
  simp

theorem strict_zero_attainable_of_degree_one :
    0 ∈ strictAttainableNonConvexCounts 1 := by
  refine ⟨X, 1, monic_X, by simp, by norm_num, ?_⟩
  have hconv : Convex ℝ (Erdos1047.strictSublevelSet (X : ℂ[X]) 1) :=
    strict_sublevel_convex_of_monic_degree_le_one X monic_X (by norm_num) 1
  rw [strict_nonconvexComponents_eq_empty_of_convex hconv]
  simp

theorem strict_max_nonconvex_of_degree_zero :
    IsGreatest (strictAttainableNonConvexCounts 0) 0 := by
  exact ⟨strict_zero_attainable_of_degree_zero,
    fun _ hk => (strict_attainable_eq_zero_of_degree_le_one (by norm_num) hk).le⟩

theorem strict_max_nonconvex_of_degree_one :
    IsGreatest (strictAttainableNonConvexCounts 1) 0 := by
  exact ⟨strict_zero_attainable_of_degree_one,
    fun _ hk => (strict_attainable_eq_zero_of_degree_le_one (by norm_num) hk).le⟩

#print axioms strict_sublevel_convex_of_monic_degree_le_one
#print axioms strict_max_nonconvex_of_degree_zero
#print axioms strict_max_nonconvex_of_degree_one

end
end Erdos1047StrictLowDegreeAudit

