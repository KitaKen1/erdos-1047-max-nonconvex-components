/-! A lightweight algebraic core for the tuned degree-raising gadget.  The
    linear coefficient is selected so that a prescribed point is critical;
    geometric separation and component preservation remain separate inputs. -/

open Polynomial

namespace Erdos1047TunedRaise

noncomputable section

def tunedRaiseFactor (L A d : ℂ) : ℂ[X] :=
  (X - C L) ^ 2 + C A * (X - C L) + C d

def tunedRaisePolynomial (p : ℂ[X]) (L A d : ℂ) : ℂ[X] :=
  p * tunedRaiseFactor L A d

theorem tunedRaiseFactor_monic (L A d : ℂ) :
    (tunedRaiseFactor L A d).Monic := by
  unfold tunedRaiseFactor
  monicity!

theorem tunedRaiseFactor_natDegree (L A d : ℂ) :
    (tunedRaiseFactor L A d).natDegree = 2 := by
  unfold tunedRaiseFactor
  compute_degree!

theorem tunedRaisePolynomial_monic (p : ℂ[X]) (L A d : ℂ) (hp : p.Monic) :
    (tunedRaisePolynomial p L A d).Monic := by
  unfold tunedRaisePolynomial
  exact hp.mul (tunedRaiseFactor_monic L A d)

theorem tunedRaisePolynomial_natDegree (p : ℂ[X]) (L A d : ℂ) (hp : p.Monic) :
    (tunedRaisePolynomial p L A d).natDegree = p.natDegree + 2 := by
  unfold tunedRaisePolynomial
  rw [natDegree_mul hp.ne_zero (tunedRaiseFactor_monic L A d).ne_zero,
    tunedRaiseFactor_natDegree]

/-! The tuned quadratic is separable exactly away from its discriminant zero.
    The Bézout witness is explicit: after subtracting
    `(X-L)/2 + A/4` times the derivative from the quadratic, the constant
    remainder is `d - A^2/4`.  This keeps the tuned variant on the same
    algebraic footing as the untuned `raiseFactor`. -/
theorem tunedRaiseFactor_separable_of_discriminant_ne_zero
    {L A d : ℂ} (hΔ : d - A ^ 2 / 4 ≠ 0) :
    (tunedRaiseFactor L A d).Separable := by
  rw [Polynomial.separable_def']
  refine ⟨C ((d - A ^ 2 / 4)⁻¹),
    -C ((d - A ^ 2 / 4)⁻¹) *
      (C (1 / 2 : ℂ) * (X - C L) + C (A / 4)), ?_⟩
  apply Polynomial.funext
  intro z
  simp [tunedRaiseFactor, derivative_add, derivative_mul, derivative_pow,
    eval_C, eval_X, eval_sub, eval_add, pow_two]
  ring_nf
  have hden : d + A ^ 2 * (-1 / 4) ≠ 0 := by
    intro h
    apply hΔ
    linear_combination h
  calc
    d * (d + A ^ 2 * (-1 / 4))⁻¹ +
        A ^ 2 * (d + A ^ 2 * (-1 / 4))⁻¹ * (-1 / 4) =
      (d + A ^ 2 * (-1 / 4)) *
        (d + A ^ 2 * (-1 / 4))⁻¹ := by ring
    _ = 1 := by rw [mul_inv_cancel₀ hden]

theorem tunedRaisePolynomial_separable
    (p : ℂ[X]) (L A d : ℂ) (hp : p.Separable)
    (hΔ : d - A ^ 2 / 4 ≠ 0)
    (hcop : IsCoprime p (tunedRaiseFactor L A d)) :
    (tunedRaisePolynomial p L A d).Separable := by
  unfold tunedRaisePolynomial
  exact hp.mul (tunedRaiseFactor_separable_of_discriminant_ne_zero hΔ) hcop

theorem tunedRaisePolynomial_rootSet_ncard
    (p : ℂ[X]) (L A d : ℂ) (hp : p.Monic) (hpsep : p.Separable)
    (hΔ : d - A ^ 2 / 4 ≠ 0)
    (hcop : IsCoprime p (tunedRaiseFactor L A d)) :
    ((tunedRaisePolynomial p L A d).rootSet ℂ).ncard = p.natDegree + 2 := by
  have hsep : (tunedRaisePolynomial p L A d).Separable :=
    tunedRaisePolynomial_separable p L A d hpsep hΔ hcop
  have hcard : Fintype.card ((tunedRaisePolynomial p L A d).rootSet ℂ) =
      (tunedRaisePolynomial p L A d).natDegree :=
    Polynomial.card_rootSet_eq_natDegree hsep (IsAlgClosed.splits _)
  simpa [tunedRaisePolynomial_natDegree p L A d hp] using hcard

theorem tunedRaiseFactor_eval (L A d z : ℂ) :
    (tunedRaiseFactor L A d).eval z =
      (z - L) ^ 2 + A * (z - L) + d := by
  norm_num [tunedRaiseFactor]

theorem tunedRaisePolynomial_eval (p : ℂ[X]) (L A d z : ℂ) :
    (tunedRaisePolynomial p L A d).eval z =
      p.eval z * ((z - L) ^ 2 + A * (z - L) + d) := by
  unfold tunedRaisePolynomial
  rw [eval_mul, tunedRaiseFactor_eval]

theorem tunedRaisePolynomial_eval_center (p : ℂ[X]) (L A d : ℂ) :
    (tunedRaisePolynomial p L A d).eval L = p.eval L * d := by
  rw [tunedRaisePolynomial_eval]
  ring

theorem tunedRaisePolynomial_derivative_eval_center (p : ℂ[X]) (L A d : ℂ) :
    (tunedRaisePolynomial p L A d).derivative.eval L =
      p.derivative.eval L * d + p.eval L * A := by
  unfold tunedRaisePolynomial
  rw [derivative_mul, eval_add, eval_mul, eval_mul]
  have hQ : (tunedRaiseFactor L A d).derivative =
      C 2 * (X - C L) + C A := by
    unfold tunedRaiseFactor
    simp [derivative_add, derivative_mul, derivative_pow]
  rw [hQ]
  norm_num [tunedRaiseFactor_eval, eval_C, eval_X, eval_sub, pow_two]

def tunedRaiseSlope (p : ℂ[X]) (L d : ℂ) : ℂ :=
  -(p.derivative.eval L) * d / p.eval L

theorem tunedRaisePolynomial_derivative_eval_center_of_slope
    (p : ℂ[X]) (L d : ℂ) (hpL : p.eval L ≠ 0) :
    (tunedRaisePolynomial p L (tunedRaiseSlope p L d) d).derivative.eval L = 0 := by
  rw [tunedRaisePolynomial_derivative_eval_center]
  unfold tunedRaiseSlope
  field_simp
  ring

/-! The next two identities expose the local Taylor coefficients at the
