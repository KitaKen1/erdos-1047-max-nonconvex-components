open Erdos1047StrictCubicExact
open Erdos1047StrictCubicUpper

theorem strict_max_nonconvex_of_degree_three :
    IsGreatest (strictAttainableNonConvexCounts 3) 2 := by
  constructor
  · exact strict_cubic_two_nonconvex_attainable
  · intro k hk
    exact strict_attainable_degree_three_le_two hk

#print axioms strict_max_nonconvex_of_degree_three

