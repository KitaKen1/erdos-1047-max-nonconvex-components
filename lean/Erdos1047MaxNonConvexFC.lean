section


/-!
# Preservation of all old components under balanced raising

First lower the old certificate level strictly.  On a fixed large closed ball,
the normalized raised polynomial is uniformly close to the original polynomial.
The sphere is outside the old higher sublevel, hence also outside the new lower
sublevel for sufficiently large scales.  Connected old-anchor components cannot
cross this sphere; inside it they lie in the original strict sublevel.  Thus old
component labels remain injective without polynomial-specific coordinate barriers.

Only the old components are handled here.  Constructing and separating the two
new nonconvex components is still required for the full degree-raising step.
-/

open Polynomial Set Filter Erdos1047 Erdos1047Proof
open Erdos1047BalancedRaise Erdos1047BalancedCertificates Erdos1047ClosedLevelBridge
open scoped Topology

namespace Erdos1047BalancedOldComponents

noncomputable section

theorem mem_scaled_strict_iff {q : ℂ[X]} {L c : ℝ} (hL : 0 < L) {z : ℂ} :
    z ∈ strictSublevelSet q (L ^ 2 * c) ↔ ‖q.eval z / (L : ℂ) ^ 2‖ < c := by
  change ‖q.eval z‖ < L ^ 2 * c ↔ ‖q.eval z / (L : ℂ) ^ 2‖ < c
  rw [norm_div, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL,
    div_lt_iff₀ (sq_pos_of_pos hL)]
  rw [mul_comm c]

theorem component_subset_ball_of_sphere_avoidance
    {S : Set ℂ} {R : ℝ} {r : ℂ} (hr : r ∈ S) (hrnorm : ‖r‖ < R)
    (hsphere : ∀ z ∈ S, ‖z‖ ≠ R) :
    connectedComponentIn S r ⊆ Metric.ball (0 : ℂ) R := by
  have hneg : ∀ z ∈ connectedComponentIn S r, ‖z‖ - R < 0 :=
    negative_on_component (φ := fun z => ‖z‖ - R) (by fun_prop)
      (fun z hz he => hsphere z hz (by linarith)) hr (by linarith)
  intro z hz
  simp only [Metric.mem_ball, dist_zero_right]
  linarith [hneg z hz]

theorem components_ne_of_sphere_avoidance
    {S : Set ℂ} {R : ℝ} {r s : ℂ}
    (hr : r ∈ S) (hs : s ∈ S) (hrnorm : ‖r‖ < R) (hsnorm : R ≤ ‖s‖)
    (hsphere : ∀ z ∈ S, ‖z‖ ≠ R) :
    connectedComponentIn S r ≠ connectedComponentIn S s := by
  intro heq
  have hscomp : s ∈ connectedComponentIn S r := by
    rw [heq]
    exact mem_connectedComponentIn hs
  have hball := component_subset_ball_of_sphere_avoidance hr hrnorm hsphere hscomp
  have hlt : ‖s‖ < R := by
    simpa only [Metric.mem_ball, dist_zero_right] using hball
  exact (not_lt_of_ge hsnorm) hlt

theorem component_map_injOn_of_sphere_confinement
    {S T A : Set ℂ} {R : ℝ}
    (hmem : ∀ z ∈ A, z ∈ S)
    (hanchor : ∀ z ∈ A, ‖z‖ < R)
    (hsphere : ∀ z ∈ S, ‖z‖ ≠ R)
    (hlocal : ∀ z ∈ S, ‖z‖ ≤ R → z ∈ T)
    (hinj : Set.InjOn (fun z => connectedComponentIn T z) A) :
    Set.InjOn (fun z => connectedComponentIn S z) A := by
  intro r hr s hs heq
  change connectedComponentIn S r = connectedComponentIn S s at heq
  have hball := component_subset_ball_of_sphere_avoidance (hmem r hr) (hanchor r hr) hsphere
  have hsub : connectedComponentIn S r ⊆ T := by
    intro z hz
    have hzR : ‖z‖ < R := by
      simpa only [Metric.mem_ball, dist_zero_right] using hball hz
    exact hlocal z (connectedComponentIn_subset S r hz) hzR.le
  have hscomp : s ∈ connectedComponentIn S r := by
    rw [heq]
    exact mem_connectedComponentIn (hmem s hs)
  have hsT : s ∈ connectedComponentIn T r :=
    isPreconnected_connectedComponentIn.subset_connectedComponentIn
      (mem_connectedComponentIn (hmem r hr)) hsub hscomp
  exact hinj hr hs (connectedComponentIn_eq hsT)

theorem exists_eventual_old_region_control
    {p : ℝ[X]} (hp : p.Monic) (hdeg : 2 < p.natDegree)
    {c d : ℝ} (hdc : d < c) {A : Set ℂ}
    (hanchors : ∀ z ∈ A, z ∈ strictSublevelSet (complexify p) c)
    (b : ℝ) {level : ℝ → ℝ} (hlevel : Tendsto level atTop (𝓝 d))
    : ∃ R : ℝ, 0 < R ∧ (∀ z ∈ A, ‖z‖ < R) ∧
      ∀ᶠ L : ℝ in atTop,
        (∀ z ∈ strictSublevelSet (raised p b L) (L ^ 2 * level L), ‖z‖ ≠ R) ∧
        (∀ z ∈ strictSublevelSet (raised p b L) (L ^ 2 * level L),
          ‖z‖ ≤ R → z ∈ strictSublevelSet (complexify p) c) := by
  have hpC : (complexify p).Monic := hp.map _
  have hdegC : 0 < (complexify p).degree := by
    rw [degree_eq_natDegree hpC.ne_zero, complexify,
      natDegree_map_eq_of_injective (algebraMap ℝ ℂ).injective]
    exact_mod_cast (show 0 < p.natDegree by omega)
  have hcompact := Erdos1047StrictGeneralCore.sublevelSet_isCompact_of_positive_degree hdegC c
  obtain ⟨R₀, hR₀⟩ := hcompact.exists_bound_of_continuousOn continuous_id.continuousOn
  let R := max R₀ 0 + 1
  have hRpos : 0 < R := by dsimp [R]; linarith [le_max_right R₀ 0]
  have hR₀lt : R₀ < R := by dsimp [R]; linarith [le_max_left R₀ 0]
  have hanchorball : ∀ z ∈ A, ‖z‖ < R := by
    intro z hz
    have hzclosed : z ∈ sublevelSet (complexify p) c :=
      Erdos1047StrictGeneralCore.strictSublevel_subset_sublevel (hanchors z hz)
    have hb := hR₀ z hzclosed
    exact hb.trans_lt hR₀lt
  have hδ : 0 < (c - d) / 4 := by linarith
  have hclose := eventually_uniform_scaled_close_on_compact hp hdeg b
    (isCompact_closedBall (0 : ℂ) R) hδ
  have hlev : ∀ᶠ L : ℝ in atTop, level L < d + (c - d) / 4 :=
    hlevel.eventually_lt_const (by linarith)
  refine ⟨R, hRpos, hanchorball, ?_⟩
  filter_upwards [eventually_gt_atTop (0 : ℝ), hclose, hlev]
    with L hL hcloseL hlevL
  have hlocal : ∀ z ∈ strictSublevelSet (raised p b L) (L ^ 2 * level L),
      ‖z‖ ≤ R → z ∈ strictSublevelSet (complexify p) c := by
    intro z hz hznorm
    have hznormalized := (mem_scaled_strict_iff hL).mp hz
    have hzball : z ∈ Metric.closedBall (0 : ℂ) R := by
      simpa only [Metric.mem_closedBall, dist_zero_right] using hznorm
    have herror := hcloseL z hzball
    have htriangle : ‖(complexify p).eval z‖ ≤
        ‖(raised p b L).eval z / (L : ℂ) ^ 2‖ +
          ‖(raised p b L).eval z / (L : ℂ) ^ 2 - (complexify p).eval z‖ := by
      calc
        _ = ‖(raised p b L).eval z / (L : ℂ) ^ 2 -
            ((raised p b L).eval z / (L : ℂ) ^ 2 - (complexify p).eval z)‖ := by
          congr 1
          ring
        _ ≤ _ := norm_sub_le _ _
    change ‖(complexify p).eval z‖ < c
    linarith
  have hsphere : ∀ z ∈ strictSublevelSet (raised p b L) (L ^ 2 * level L),
      ‖z‖ ≠ R := by
    intro z hz heq
    have hzold := hlocal z hz heq.le
    have hzclosed : z ∈ sublevelSet (complexify p) c :=
      Erdos1047StrictGeneralCore.strictSublevel_subset_sublevel hzold
    have hb := hR₀ z hzclosed
    have hzlt : ‖z‖ < R := hb.trans_lt hR₀lt
    exact (ne_of_lt hzlt) heq
  exact ⟨hsphere, hlocal⟩

theorem eventually_old_component_injOn
    {p : ℝ[X]} (hp : p.Monic) (hdeg : 2 < p.natDegree)
    {c d : ℝ} (hdc : d < c) {A : Set ℂ}
    (hanchors : ∀ z ∈ A, z ∈ strictSublevelSet (complexify p) c)
    (hinj : Set.InjOn
      (fun z => connectedComponentIn (strictSublevelSet (complexify p) c) z) A)
    (b : ℝ) {level : ℝ → ℝ} (hlevel : Tendsto level atTop (𝓝 d))
    (hmem : ∀ᶠ L : ℝ in atTop,
      ∀ z ∈ A, z ∈ strictSublevelSet (raised p b L) (L ^ 2 * level L)) :
    ∀ᶠ L : ℝ in atTop, Set.InjOn
      (fun z => connectedComponentIn (strictSublevelSet (raised p b L)
        (L ^ 2 * level L)) z) A := by
  obtain ⟨R, _, hanchorball, hcontrol⟩ :=
    exists_eventual_old_region_control hp hdeg hdc hanchors b hlevel
  filter_upwards [hcontrol, hmem] with L hcontrolL hmemL
  exact component_map_injOn_of_sphere_confinement hmemL hanchorball
    hcontrolL.1 hcontrolL.2 hinj

theorem RealWitnessFamily.exists_level_preserving_old_family
    {n : ℕ} (w : RealWitnessFamily n) (hn : 2 < n) :
    ∃ d : ℝ, 0 < d ∧ d < w.level ∧
      ∀ level : ℝ → ℝ, Tendsto level atTop (𝓝 d) →
        ∀ᶠ L : ℝ in atTop,
          (∀ i, Nonempty (RobustNonconvexCertificate
            (fun z => (raised w.polynomial d L).eval z) (L ^ 2 * level L)
            (w.anchor i) (w.pointA i) (w.pointB i))) ∧
          Set.InjOn (fun z => connectedComponentIn
            (strictSublevelSet (raised w.polynomial d L) (L ^ 2 * level L)) z)
            (Set.range w.anchor) := by
  obtain ⟨d, hd, hdc, hcert⟩ := exists_lower_level_certificate_family
    (show 0 < n by omega) w.level_pos (fun i => ⟨w.certificate i⟩)
  refine ⟨d, hd, hdc, ?_⟩
  intro level hlevel
  have hdeg : 2 < w.polynomial.natDegree := by simpa only [w.degree] using hn
  have hcerts := eventually_preserves_finite_certificate_family w.monic hdeg d hcert hlevel
  have hmem : ∀ᶠ L : ℝ in atTop, ∀ z ∈ Set.range w.anchor,
      z ∈ strictSublevelSet (raised w.polynomial d L) (L ^ 2 * level L) := by
    filter_upwards [hcerts] with L hcertL
    rintro _ ⟨i, rfl⟩
    obtain ⟨hi⟩ := hcertL i
    have hm := hi.lineA_margin (w.anchor i)
      (left_mem_segment ℝ (w.anchor i) (w.pointA i))
    change ‖(raised w.polynomial d L).eval (w.anchor i)‖ < L ^ 2 * level L
    linarith [hi.eps_pos]
  have hanchors : ∀ z ∈ Set.range w.anchor,
      z ∈ strictSublevelSet (complexify w.polynomial) w.level := by
    rintro _ ⟨i, rfl⟩
    have hm := (w.certificate i).lineA_margin (w.anchor i)
      (left_mem_segment ℝ (w.anchor i) (w.pointA i))
    change ‖(complexify w.polynomial).eval (w.anchor i)‖ < w.level
    linarith [(w.certificate i).eps_pos]
  exact hcerts.and (eventually_old_component_injOn w.monic hdeg hdc hanchors
    w.component_injective d hlevel hmem)

#print axioms components_ne_of_sphere_avoidance
#print axioms exists_eventual_old_region_control
#print axioms eventually_old_component_injOn
/-- info: 'Erdos1047BalancedOldComponents.RealWitnessFamily.exists_level_preserving_old_family' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms RealWitnessFamily.exists_level_preserving_old_family

end
