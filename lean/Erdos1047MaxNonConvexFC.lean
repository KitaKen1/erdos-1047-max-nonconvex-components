/-!
# Strict degree-three lower bound

The existing cubic certificate is written for a closed sublevel, but its two
curvature witnesses are strict.  This file supplies the missing open-set
bookkeeping: an open-ball covering lift gives a root in every strict component,
and the three explicit anchors remain separated by the same coordinate barriers.
-/

open Polynomial
open Set

namespace Erdos1047StrictCubicLower

noncomputable section

open Erdos1047CubicLower

def strictSublevelSet : Set ℂ :=
  {z : ℂ | ‖p3Polynomial.eval z‖ < p3Level}

def componentsIn (s : Set ℂ) : Set (Set ℂ) :=
  {t : Set ℂ | ∃ z ∈ s, t = connectedComponentIn s z}

theorem strict_subset_closed : strictSublevelSet ⊆ sublevelSet p3Polynomial p3Level := by
  intro z hz
  change ‖p3Polynomial.eval z‖ < p3Level at hz
  exact hz.le

theorem p3_ball_subset_regular_values :
    Metric.ball (0 : ℂ) p3Level ⊆
      (p3Polynomial.eval '' {z : ℂ | p3Polynomial.derivative.eval z = 0})ᶜ := by
  intro w hw
  apply p3_closedBall_subset_regular_values
  exact Metric.ball_subset_closedBall hw

theorem strict_exists_root_in_component (z : ℂ) (hz : z ∈ strictSublevelSet) :
    ∃ r ∈ p3Polynomial.rootSet ℂ,
      r ∈ connectedComponentIn strictSublevelSet z := by
  let D : Set ℂ := Metric.ball 0 p3Level
  letI : ContractibleSpace D := by
    dsimp [D]
    exact Metric.contractibleSpace_ball (by norm_num [p3Level])
  letI : LocallyPathConnectedSpace D := by
    dsimp [D]
    exact (convex_ball (0 : ℂ) p3Level).locallyPathConnectedSpace
  let a0 : D := ⟨p3Polynomial.eval z, by
    change ‖p3Polynomial.eval z‖ < p3Level at hz
    simpa [D, Metric.mem_ball, dist_zero_right] using hz⟩
  let inclusion : C(D, ℂ) := ⟨fun w => w.1, continuous_subtype_val⟩
  have hreg : ∀ w : D,
      inclusion w ∈
        (p3Polynomial.eval '' {u : ℂ | p3Polynomial.derivative.eval u = 0})ᶜ := by
    intro w
    apply p3_ball_subset_regular_values
    exact w.2
  obtain ⟨F, hF, _⟩ :=
    (Polynomial.isCoveringMapOn_eval p3Polynomial).existsUnique_continuousMap_lifts
      inclusion (a₀ := a0) (e₀ := z) (by rfl) hreg
  have hlift (w : D) : p3Polynomial.eval (F w) = (w : ℂ) := by
    simpa [Function.comp_apply, inclusion] using congrFun hF.2 w
  let w0 : D := ⟨0, by
    simpa [D, Metric.mem_ball, dist_zero_right] using (show (0 : ℝ) < p3Level by
      norm_num [p3Level])⟩
  let r : ℂ := F w0
  have hrzero : p3Polynomial.eval r = 0 := by
    simpa [r, w0] using hlift w0
  have hrroot : r ∈ p3Polynomial.rootSet ℂ :=
    p3Polynomial_monic.mem_rootSet.mpr hrzero
  have hpre : IsPreconnected (Set.range F) := isPreconnected_range F.continuous
  have hzrange : z ∈ Set.range F := ⟨a0, hF.1⟩
  have hrrange : r ∈ Set.range F := ⟨w0, rfl⟩
  have hFK : Set.range F ⊆ strictSublevelSet := by
    rintro _ ⟨w, rfl⟩
    change ‖p3Polynomial.eval (F w)‖ < p3Level
    rw [hlift w]
    have hw' : (w : ℂ) ∈ Metric.ball (0 : ℂ) p3Level := by
      simpa [D] using w.2
    have hw'' := Metric.mem_ball.mp hw'
    simpa [dist_zero_right] using hw''
  exact ⟨r, hrroot, hpre.subset_connectedComponentIn hzrange hFK hrrange⟩

theorem strict_componentsIn_eq_image_rootSet :
    componentsIn strictSublevelSet =
      (fun r : ℂ => connectedComponentIn strictSublevelSet r) ''
        (↑(p3Polynomial.rootSet ℂ) : Set ℂ) := by
  apply Set.Subset.antisymm
  · rintro t ⟨z, hz, rfl⟩
    obtain ⟨r, hrroot, hrcomp⟩ := strict_exists_root_in_component z hz
    refine ⟨r, hrroot, ?_⟩
    exact (connectedComponentIn_eq hrcomp).symm
  · rintro _ ⟨r, hrroot, rfl⟩
    have hreval : p3Polynomial.eval r = 0 := p3Polynomial_monic.mem_rootSet.mp hrroot
    have hrK : r ∈ strictSublevelSet := by
      change ‖p3Polynomial.eval r‖ < p3Level
      rw [hreval, norm_zero]
      norm_num [p3Level]
    exact ⟨r, hrK, rfl⟩

theorem strict_componentsIn_ncard_le_three :
    (componentsIn strictSublevelSet).ncard ≤ 3 := by
  rw [strict_componentsIn_eq_image_rootSet]
  calc
    _ ≤ (p3Polynomial.rootSet ℂ).ncard :=
      Set.ncard_image_le (p3Polynomial.rootSet_finite ℂ)
    _ = 3 := p3_rootSet_ncard

theorem p3LowerAnchor_mem_strict : p3LowerAnchor ∈ strictSublevelSet := by
  exact p3Lower_lineA_strict p3LowerAnchor
    (left_mem_segment ℝ p3LowerAnchor p3LowerPointA)

theorem p3UpperAnchor_mem_strict : star p3LowerAnchor ∈ strictSublevelSet := by
  have hstar : ‖p3Polynomial.eval (star p3LowerAnchor)‖ =
      ‖p3Polynomial.eval p3LowerAnchor‖ := by
    rw [p3_eval_star, norm_star]
  change ‖p3Polynomial.eval (star p3LowerAnchor)‖ < p3Level
  rw [hstar]
  exact p3Lower_lineA_strict p3LowerAnchor
    (left_mem_segment ℝ p3LowerAnchor p3LowerPointA)

theorem p3_strict_mem_star_iff (z : ℂ) :
    star z ∈ strictSublevelSet ↔ z ∈ strictSublevelSet := by
  change ‖p3Polynomial.eval (star z)‖ < p3Level ↔
    ‖p3Polynomial.eval z‖ < p3Level
  rw [p3_eval_star, norm_star]

theorem p3_strict_star_segment {r a : ℂ}
    (h : segment ℝ r a ⊆ strictSublevelSet) :
    segment ℝ (star r) (star a) ⊆ strictSublevelSet := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  rw [show u • star r + v • star a = star (u • r + v • a) by simp]
  exact (p3_strict_mem_star_iff _).2 (h ⟨u, v, hu, hv, huv, rfl⟩)

theorem p3Lower_midpoint_outside_strict :
    midpoint ℝ p3LowerPointA p3LowerPointB ∉ strictSublevelSet := by
  intro hm
  apply p3Lower_midpoint_outside
  change ‖p3Polynomial.eval (midpoint ℝ p3LowerPointA p3LowerPointB)‖ ≤ p3Level
  exact hm.le

theorem p3Lower_component_not_convex_strict :
    ¬ Convex ℝ (connectedComponentIn strictSublevelSet p3LowerAnchor) := by
  apply Erdos1047CubicLower.component_not_convex_of_segments
  · exact p3Lower_lineA_strict
  · exact p3Lower_lineB_strict
  · exact p3Lower_midpoint_outside_strict

theorem p3Upper_component_not_convex_strict :
    ¬ Convex ℝ (connectedComponentIn strictSublevelSet (star p3LowerAnchor)) := by
  apply Erdos1047CubicLower.component_not_convex_of_segments
  · exact p3_strict_star_segment p3Lower_lineA_strict
  · exact p3_strict_star_segment p3Lower_lineB_strict
  · intro hm
    apply p3Lower_midpoint_outside_strict
    rw [← p3_strict_mem_star_iff]
    convert hm using 1
    simp [midpoint, AffineMap.lineMap_apply_module]

theorem p3_strict_imaginary_axis_avoids (y : ℝ) :
    (y : ℂ) * Complex.I ∉ strictSublevelSet := by
  intro hz
  apply p3_imaginary_axis_avoids y
  change ‖p3Polynomial.eval ((y : ℂ) * Complex.I)‖ < p3Level at hz
  exact hz.le

theorem p3_strict_right_real_axis_avoids (x : ℝ) (hx : 0 ≤ x) :
    (x : ℂ) ∉ strictSublevelSet := by
  intro hz
  apply p3_right_real_axis_avoids x hx
  change ‖p3Polynomial.eval (x : ℂ)‖ < p3Level at hz
  exact hz.le

theorem p3_strict_component_re_pos {r : ℂ} (hr : r ∈ strictSublevelSet)
    (hre : 0 < r.re) :
    ∀ z ∈ connectedComponentIn strictSublevelSet r, 0 < z.re := by
  have h := Erdos1047CubicLower.negative_on_component
    (S := strictSublevelSet) (r := r) (φ := fun z : ℂ => -z.re) (by fun_prop) (by
      intro z hz hzero
      have hzre : z.re = 0 := by linarith
      have hrepr : z = (z.im : ℂ) * Complex.I := by
        apply Complex.ext <;> simp [hzre]
      rw [hrepr] at hz
      exact p3_strict_imaginary_axis_avoids z.im hz) hr (by linarith)
  intro z hz
  linarith [h z hz]

theorem p3_strict_right_component_im_neg {r : ℂ}
    (hr : r ∈ strictSublevelSet) (hre : 0 < r.re) (him : r.im < 0) :
    ∀ z ∈ connectedComponentIn strictSublevelSet r, z.im < 0 := by
  let K := strictSublevelSet
  let C := connectedComponentIn K r
  have hreall := p3_strict_component_re_pos hr hre
  have hpos := Erdos1047CubicLower.positive_on_preconnected (S := C) (r := r)
    (φ := fun z : ℂ => -z.im) isPreconnected_connectedComponentIn (by fun_prop) (by
      intro z hz hzero
      have hzK : z ∈ K := connectedComponentIn_subset K r hz
      have hx : 0 ≤ z.re := (hreall z hz).le
      have hzim : z.im = 0 := by linarith
      have hrepr : z = (z.re : ℂ) := by
        apply Complex.ext <;> simp [hzim]
      rw [hrepr] at hzK
      exact p3_strict_right_real_axis_avoids z.re hx hzK)
    (mem_connectedComponentIn hr) (by linarith)
  intro z hz
  linarith [hpos z hz]

theorem p3_strict_component_re_neg {r : ℂ} (hr : r ∈ strictSublevelSet)
    (hre : r.re < 0) :
    ∀ z ∈ connectedComponentIn strictSublevelSet r, z.re < 0 := by
  apply Erdos1047CubicLower.negative_on_component
    (φ := fun z : ℂ => z.re) (by fun_prop) _ hr hre
  intro z hz hzero
  have hrepr : z = (z.im : ℂ) * Complex.I := by
    apply Complex.ext <;> simp [hzero]
  rw [hrepr] at hz
  exact p3_strict_imaginary_axis_avoids z.im hz

theorem p3_strict_three_components_pairwise_distinct :
    let K := strictSublevelSet
    let CL := connectedComponentIn K p3LeftAnchor
    let CD := connectedComponentIn K p3LowerAnchor
    let CU := connectedComponentIn K (star p3LowerAnchor)
    CL ≠ CD ∧ CL ≠ CU ∧ CD ≠ CU := by
  dsimp only
  have hleft : p3LeftAnchor ∈ sublevelSet p3Polynomial p3Level := p3LeftAnchor_mem
  have hleftsign := p3_component_re_neg hleft (by norm_num [p3LeftAnchor])
  have hleftstrict : p3LeftAnchor ∈ strictSublevelSet := by
    change ‖p3Polynomial.eval p3LeftAnchor‖ < p3Level
    norm_num [p3Polynomial, p3LeftAnchor, p3Level]
  have hstrict_to_closed_comp :
      connectedComponentIn strictSublevelSet p3LeftAnchor ⊆
        connectedComponentIn (sublevelSet p3Polynomial p3Level) p3LeftAnchor := by
    intro z hz
    have hsub : connectedComponentIn strictSublevelSet p3LeftAnchor ⊆
        sublevelSet p3Polynomial p3Level :=
      (connectedComponentIn_subset strictSublevelSet p3LeftAnchor).trans
        strict_subset_closed
    exact isPreconnected_connectedComponentIn.subset_connectedComponentIn
      (mem_connectedComponentIn hleftstrict) hsub hz
  have hlowerRe : 0 < p3LowerAnchor.re := by norm_num [p3LowerAnchor]
  have hlowerIm : p3LowerAnchor.im < 0 := by norm_num [p3LowerAnchor]
  have hlower := p3_strict_right_component_im_neg p3LowerAnchor_mem_strict
    hlowerRe hlowerIm
  constructor
  · intro heq
    have hmem : p3LowerAnchor ∈ connectedComponentIn strictSublevelSet p3LeftAnchor := by
      rw [heq]
      exact mem_connectedComponentIn p3LowerAnchor_mem_strict
    have hmemclosed : p3LowerAnchor ∈ connectedComponentIn
        (sublevelSet p3Polynomial p3Level) p3LeftAnchor := by
      exact hstrict_to_closed_comp hmem
    linarith [hleftsign p3LowerAnchor hmemclosed]
  · constructor
    · intro heq
      have hmem : star p3LowerAnchor ∈ connectedComponentIn strictSublevelSet p3LeftAnchor := by
        rw [heq]
        exact mem_connectedComponentIn p3UpperAnchor_mem_strict
      have hmemclosed : star p3LowerAnchor ∈ connectedComponentIn
          (sublevelSet p3Polynomial p3Level) p3LeftAnchor := by
        exact hstrict_to_closed_comp hmem
      have hre : 0 < (star p3LowerAnchor).re := by norm_num [p3LowerAnchor]
      linarith [hleftsign (star p3LowerAnchor) hmemclosed]
    · intro heq
      have hmem : star p3LowerAnchor ∈ connectedComponentIn strictSublevelSet p3LowerAnchor := by
        rw [heq]
        exact mem_connectedComponentIn p3UpperAnchor_mem_strict
      have hupperIm : 0 < (star p3LowerAnchor).im := by norm_num [p3LowerAnchor]
      linarith [hlower (star p3LowerAnchor) hmem, hupperIm]

def strictLeftSublevel : Set ℂ :=
  {z ∈ p3LeftStrip | p3NormSqFormula z < p3Level ^ 2}

theorem strictLeftSublevel_convex : Convex ℝ strictLeftSublevel :=
  p3NormSqFormula_convexOn_strip.convex_lt (p3Level ^ 2)

theorem p3LeftAnchor_mem_strict : p3LeftAnchor ∈ strictLeftSublevel := by
  constructor
  · change (-9 / 4 : ℝ) ≤ p3LeftAnchor.re ∧ p3LeftAnchor.re ≤ -39 / 20
    norm_num [p3LeftAnchor]
  · rw [p3NormSqFormula_eq, Complex.normSq_eq_norm_sq]
    change ‖p3Polynomial.eval p3LeftAnchor‖ ^ 2 < p3Level ^ 2
    have hval : ‖p3Polynomial.eval p3LeftAnchor‖ < p3Level := by
      norm_num [p3Polynomial, p3LeftAnchor, p3Level]
    exact (sq_lt_sq₀ (norm_nonneg _) (by norm_num [p3Level])).mpr hval

theorem strictLeftSublevel_subset_full :
    strictLeftSublevel ⊆ strictSublevelSet := by
  rintro z ⟨_, hsq⟩
  change ‖p3Polynomial.eval z‖ < p3Level
  rw [p3NormSqFormula_eq, Complex.normSq_eq_norm_sq] at hsq
  exact (sq_lt_sq₀ (norm_nonneg _) (by norm_num [p3Level])).mp hsq

theorem p3_strict_far_left_vertical_avoids' (y : ℝ) :
    ((-9 / 4 : ℝ) : ℂ) + (y : ℂ) * Complex.I ∉ strictSublevelSet := by
  intro hz
  apply p3_far_left_vertical_avoids y
  change ‖p3Polynomial.eval (((-9 / 4 : ℝ) : ℂ) + (y : ℂ) * Complex.I)‖ < p3Level at hz
  exact hz.le

theorem p3_strict_near_left_vertical_avoids' (y : ℝ) :
    ((-39 / 20 : ℝ) : ℂ) + (y : ℂ) * Complex.I ∉ strictSublevelSet := by
  intro hz
  apply p3_near_left_vertical_avoids y
  change ‖p3Polynomial.eval (((-39 / 20 : ℝ) : ℂ) + (y : ℂ) * Complex.I)‖ < p3Level at hz
  exact hz.le

theorem p3_strict_left_component_subset_strip :
    connectedComponentIn strictSublevelSet p3LeftAnchor ⊆ p3LeftStrip := by
  let K := strictSublevelSet
  let C := connectedComponentIn K p3LeftAnchor
  have hanchorK : p3LeftAnchor ∈ K :=
    strictLeftSublevel_subset_full p3LeftAnchor_mem_strict
  have hfar := Erdos1047CubicLower.positive_on_preconnected (S := C)
    (r := p3LeftAnchor) (φ := fun z : ℂ => z.re + 9 / 4)
    isPreconnected_connectedComponentIn (by fun_prop) (by
      intro z hz hzero
      have hzK : z ∈ K := connectedComponentIn_subset K p3LeftAnchor hz
      have hzre : z.re = -9 / 4 := by linarith
      have hrepr : z = ((-9 / 4 : ℝ) : ℂ) + (z.im : ℂ) * Complex.I := by
        apply Complex.ext <;> simp [hzre]
      rw [hrepr] at hzK
      exact p3_strict_far_left_vertical_avoids' z.im hzK)
    (mem_connectedComponentIn hanchorK) (by norm_num [p3LeftAnchor])
  have hnear := Erdos1047CubicLower.negative_on_component (S := K)
    (r := p3LeftAnchor) (φ := fun z : ℂ => z.re + 39 / 20) (by fun_prop) (by
      intro z hz hzero
      have hzre : z.re = -39 / 20 := by linarith
      have hrepr : z = ((-39 / 20 : ℝ) : ℂ) + (z.im : ℂ) * Complex.I := by
        apply Complex.ext <;> simp [hzre]
      rw [hrepr] at hz
      exact p3_strict_near_left_vertical_avoids' z.im hz)
    hanchorK (by norm_num [p3LeftAnchor])
  intro z hz
  change (-9 / 4 : ℝ) ≤ z.re ∧ z.re ≤ -39 / 20
  have hf := hfar z hz
  have hn := hnear z hz
  constructor <;> linarith

theorem p3_strict_far_left_vertical_avoids (y : ℝ) :
    ((-9 / 4 : ℝ) : ℂ) + (y : ℂ) * Complex.I ∉ strictSublevelSet := by
  intro hz
  apply p3_far_left_vertical_avoids y
  change ‖p3Polynomial.eval (((-9 / 4 : ℝ) : ℂ) + (y : ℂ) * Complex.I)‖ < p3Level at hz
  exact hz.le

theorem p3_strict_near_left_vertical_avoids (y : ℝ) :
    ((-39 / 20 : ℝ) : ℂ) + (y : ℂ) * Complex.I ∉ strictSublevelSet := by
  intro hz
  apply p3_near_left_vertical_avoids y
  change ‖p3Polynomial.eval (((-39 / 20 : ℝ) : ℂ) + (y : ℂ) * Complex.I)‖ < p3Level at hz
  exact hz.le

theorem p3_strict_left_component_eq_sublevel :
    connectedComponentIn strictSublevelSet p3LeftAnchor = strictLeftSublevel := by
  apply Set.Subset.antisymm
  · intro z hz
    constructor
    · exact p3_strict_left_component_subset_strip hz
    · rw [p3NormSqFormula_eq, Complex.normSq_eq_norm_sq]
      have hzK := connectedComponentIn_subset strictSublevelSet p3LeftAnchor hz
      change ‖p3Polynomial.eval z‖ < p3Level at hzK
      change ‖p3Polynomial.eval z‖ ^ 2 < p3Level ^ 2
      exact (sq_lt_sq₀ (norm_nonneg _) (by norm_num [p3Level])).mpr hzK
  · exact strictLeftSublevel_convex.isPreconnected.subset_connectedComponentIn
      p3LeftAnchor_mem_strict strictLeftSublevel_subset_full

theorem p3_strict_left_component_convex :
    Convex ℝ (connectedComponentIn strictSublevelSet p3LeftAnchor) := by
  rw [p3_strict_left_component_eq_sublevel]
  exact strictLeftSublevel_convex

end
end Erdos1047StrictCubicLower

end

