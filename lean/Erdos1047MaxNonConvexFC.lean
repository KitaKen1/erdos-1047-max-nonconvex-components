  exact closedBall_subset_regular_values_of_critical_value_norm_gt hcrit

theorem p5_component_re_neg {r : ℂ}
    (hr : r ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) (hre : r.re < 0) :
    ∀ z ∈ connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r, z.re < 0 := by
  apply negative_on_component (φ := fun z : ℂ ↦ z.re) (by fun_prop) _ hr hre
  intro z hz hzero
  have hrepr : z = (z.im : ℂ) * Complex.I := by
    apply Complex.ext <;> simp [hzero]
  rw [hrepr] at hz
  exact p5_imaginary_axis_avoids_witness z.im hz

theorem p5_component_re_pos {r : ℂ}
    (hr : r ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) (hre : 0 < r.re) :
    ∀ z ∈ connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r, 0 < z.re := by
  have h := negative_on_component (S := Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
    (r := r) (φ := fun z : ℂ ↦ -z.re) (by fun_prop) (by
      intro z hz hzero
      have hzre : z.re = 0 := by linarith
      have hrepr : z = (z.im : ℂ) * Complex.I := by
        apply Complex.ext <;> simp [hzre]
      rw [hrepr] at hz
      exact p5_imaginary_axis_avoids_witness z.im hz) hr (by linarith)
  intro z hz
  have hzneg := h z hz
  linarith

theorem p5_left_component_im_gt_of_barrier {r : ℂ} (y0 : ℝ)
    (hr : r ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
    (hre : r.re < 0) (him : y0 < r.im)
    (hbarrier : ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (y0 : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) :
    ∀ z ∈ connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r, y0 < z.im := by
  exact connectedComponentIn_im_gt_of_left_halfline_avoids y0
    p5_imaginary_axis_avoids_witness_via_eval_bound hr hre him hbarrier

theorem p5_left_component_im_lt_of_barrier {r : ℂ} (y0 : ℝ)
    (hr : r ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
    (hre : r.re < 0) (him : r.im < y0)
    (hbarrier : ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (y0 : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) :
    ∀ z ∈ connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r, z.im < y0 := by
  exact connectedComponentIn_im_lt_of_left_halfline_avoids y0
    p5_imaginary_axis_avoids_witness_via_eval_bound hr hre him hbarrier

theorem p5_right_component_im_pos {r : ℂ}
    (hr : r ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
    (hre : 0 < r.re) (him : 0 < r.im) :
    ∀ z ∈ connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r, 0 < z.im := by
  let K := Erdos1047.sublevelSet p5Polynomial p5WitnessLevel
  let C := connectedComponentIn K r
  have hreall := p5_component_re_pos hr hre
  apply positive_on_preconnected (S := C) (r := r) (φ := fun z : ℂ ↦ z.im)
    isPreconnected_connectedComponentIn (by fun_prop) _
    (mem_connectedComponentIn hr) him
  intro z hz hzero
  have hzK : z ∈ K := connectedComponentIn_subset K r hz
  have hx : 0 ≤ z.re := (hreall z hz).le
  have hrepr : z = (z.re : ℂ) := by
    apply Complex.ext <;> simp [hzero]
  rw [hrepr] at hzK
  exact p5_right_real_axis_avoids_witness z.re hx hzK

theorem p5_right_component_im_neg {r : ℂ}
    (hr : r ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
    (hre : 0 < r.re) (him : r.im < 0) :
    ∀ z ∈ connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r, z.im < 0 := by
  let K := Erdos1047.sublevelSet p5Polynomial p5WitnessLevel
  let C := connectedComponentIn K r
  have hreall := p5_component_re_pos hr hre
  have hpos := positive_on_preconnected (S := C) (r := r)
    (φ := fun z : ℂ ↦ -z.im) isPreconnected_connectedComponentIn (by fun_prop) (by
      intro z hz hzero
      have hzK : z ∈ K := connectedComponentIn_subset K r hz
      have hx : 0 ≤ z.re := (hreall z hz).le
      have hzim : z.im = 0 := by linarith
      have hrepr : z = (z.re : ℂ) := by
        apply Complex.ext <;> simp [hzim]
      rw [hrepr] at hzK
      exact p5_right_real_axis_avoids_witness z.re hx hzK)
    (mem_connectedComponentIn hr) (by linarith)
  intro z hz
  have hzpos := hpos z hz
  linarith

theorem p5_components_ne_of_re_sign {r s : ℂ}
    (hr : r ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
    (hs : s ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
    (hrneg : r.re < 0) (hspos : 0 < s.re) :
    connectedComponentIn (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r ≠
      connectedComponentIn (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) s := by
  intro heq
  have hsC : s ∈ connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r := by
    rw [heq]
    exact mem_connectedComponentIn hs
  linarith [p5_component_re_neg hr hrneg s hsC]

theorem p5_left_components_ne_of_im_barrier {r s : ℂ} (y0 : ℝ)
    (hr : r ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
    (hs : s ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
    (hrneg : r.re < 0) (hrabove : y0 < r.im) (hsbelow : s.im < y0)
    (hbarrier : ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (y0 : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) :
    connectedComponentIn (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r ≠
      connectedComponentIn (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) s := by
  intro heq
  have hsC : s ∈ connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r := by
    rw [heq]
    exact mem_connectedComponentIn hs
  linarith [p5_left_component_im_gt_of_barrier y0 hr hrneg hrabove hbarrier s hsC]

theorem p5_right_components_ne_of_im_sign {r s : ℂ}
    (hr : r ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
    (hs : s ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
    (hrpos : 0 < r.re) (hrim : 0 < r.im) (hsim : s.im < 0) :
    connectedComponentIn (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r ≠
      connectedComponentIn (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) s := by
  intro heq
  have hsC : s ∈ connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r := by
    rw [heq]
    exact mem_connectedComponentIn hs
  linarith [p5_right_component_im_pos hr hrpos hrim s hsC]

/-- The five exact p5 witnesses lie in pairwise distinct connected components. -/
theorem p5_five_components_pairwise_distinct :
    let K := Erdos1047.sublevelSet p5Polynomial p5WitnessLevel
    let C0 := connectedComponentIn K p5UpperLeftAnchor
    let C1 := connectedComponentIn K (star p5UpperLeftAnchor)
    let C2 := connectedComponentIn K p5CentralAnchor
    let C3 := connectedComponentIn K p5RightAnchor
    let C4 := connectedComponentIn K (star p5RightAnchor)
    C0 ≠ C1 ∧ C0 ≠ C2 ∧ C0 ≠ C3 ∧ C0 ≠ C4 ∧ C1 ≠ C2 ∧
      C1 ≠ C3 ∧ C1 ≠ C4 ∧ C2 ≠ C3 ∧ C2 ≠ C4 ∧ C3 ≠ C4 := by
  dsimp only
  have h0 : p5UpperLeftAnchor ∈
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel :=
    (p5UpperLeft_lineA_strict p5UpperLeftAnchor
      (left_mem_segment ℝ p5UpperLeftAnchor p5UpperLeftPointA)).le
  have h1 : star p5UpperLeftAnchor ∈
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel :=
    (p5_mem_star_iff p5UpperLeftAnchor).2 h0
  have h2 : p5CentralAnchor ∈
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel :=
    (p5Central_lineA_strict p5CentralAnchor
      (left_mem_segment ℝ p5CentralAnchor p5CentralPointA)).le
  have h3 : p5RightAnchor ∈
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel :=
    (p5Right_lineA_strict p5RightAnchor
      (left_mem_segment ℝ p5RightAnchor p5RightPointA)).le
  have h4 : star p5RightAnchor ∈
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel :=
    (p5_mem_star_iff p5RightAnchor).2 h3
  have hre0 : p5UpperLeftAnchor.re < 0 := by norm_num [p5UpperLeftAnchor]
  have hre1 : (star p5UpperLeftAnchor).re < 0 := by norm_num [p5UpperLeftAnchor]
  have hre2 : p5CentralAnchor.re < 0 := by norm_num [p5CentralAnchor]
  have hre3 : 0 < p5RightAnchor.re := by norm_num [p5RightAnchor]
  have hre4 : 0 < (star p5RightAnchor).re := by norm_num [p5RightAnchor]
  have him0half : (1 / 2 : ℝ) < p5UpperLeftAnchor.im := by
    norm_num [p5UpperLeftAnchor]
  have him1half : (star p5UpperLeftAnchor).im < (1 / 2 : ℝ) := by
    norm_num [p5UpperLeftAnchor]
  have him2half : p5CentralAnchor.im < (1 / 2 : ℝ) := by
    norm_num [p5CentralAnchor]
  have him2negHalf : (-1 / 2 : ℝ) < p5CentralAnchor.im := by
    norm_num [p5CentralAnchor]
  have him1negHalf : (star p5UpperLeftAnchor).im < (-1 / 2 : ℝ) := by
    norm_num [p5UpperLeftAnchor]
  have him3 : 0 < p5RightAnchor.im := by norm_num [p5RightAnchor]
  have him4 : (star p5RightAnchor).im < 0 := by norm_num [p5RightAnchor]
  have hu : ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + ((1 / 2 : ℝ) : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet p5Polynomial p5WitnessLevel := by
    intro x hx
    simpa using p5_left_upper_horizontal_avoids_witness x hx
  have hl : ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + ((-1 / 2 : ℝ) : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet p5Polynomial p5WitnessLevel := by
    intro x hx
    have heq : (x : ℂ) + ((-1 / 2 : ℝ) : ℂ) * Complex.I =
        (x : ℂ) - (1 / 2 : ℂ) * Complex.I := by
      apply Complex.ext <;> norm_num
    rw [heq]
    exact p5_left_lower_horizontal_avoids_witness x hx
  exact ⟨p5_left_components_ne_of_im_barrier (1 / 2 : ℝ)
      h0 h1 hre0 him0half him1half hu,
    p5_left_components_ne_of_im_barrier (1 / 2 : ℝ)
      h0 h2 hre0 him0half him2half hu,
    p5_components_ne_of_re_sign h0 h3 hre0 hre3,
    p5_components_ne_of_re_sign h0 h4 hre0 hre4,
    (p5_left_components_ne_of_im_barrier (-1 / 2 : ℝ)
      h2 h1 hre2 him2negHalf him1negHalf hl).symm,
    p5_components_ne_of_re_sign h1 h3 hre1 hre3,
    p5_components_ne_of_re_sign h1 h4 hre1 hre4,
    p5_components_ne_of_re_sign h2 h3 hre2 hre3,
    p5_components_ne_of_re_sign h2 h4 hre2 hre4,
    p5_right_components_ne_of_im_sign h3 h4 hre3 him3 him4⟩

/-- Below the critical level, every p5 component is the component of one of the
five roots. This is the component-level consequence of the covering lift above. -/
theorem p5_componentsIn_eq_image_rootSet :
    Erdos1047.componentsIn
        (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) =
      (fun r : ℂ ↦ connectedComponentIn
        (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) r) ''
        (↑(p5Polynomial.rootSet ℂ) : Set ℂ) := by
  exact componentsIn_eq_image_rootSet_of_regular_values p5Polynomial_monic
    (by norm_num [p5WitnessLevel, p5Level])
    (p5_closedBall_subset_regular_values (by norm_num [p5WitnessLevel, p5Level]))

theorem p5_five_component_set_ncard :
    let K := Erdos1047.sublevelSet p5Polynomial p5WitnessLevel
    let C0 := connectedComponentIn K p5UpperLeftAnchor
    let C1 := connectedComponentIn K (star p5UpperLeftAnchor)
    let C2 := connectedComponentIn K p5CentralAnchor
    let C3 := connectedComponentIn K p5RightAnchor
    let C4 := connectedComponentIn K (star p5RightAnchor)
    ({C0, C1, C2, C3, C4} : Set (Set ℂ)).ncard = 5 := by
  dsimp only
  let K := Erdos1047.sublevelSet p5Polynomial p5WitnessLevel
  let C0 := connectedComponentIn K p5UpperLeftAnchor
  let C1 := connectedComponentIn K (star p5UpperLeftAnchor)
  let C2 := connectedComponentIn K p5CentralAnchor
  let C3 := connectedComponentIn K p5RightAnchor
  let C4 := connectedComponentIn K (star p5RightAnchor)
  change ({C0, C1, C2, C3, C4} : Set (Set ℂ)).ncard = 5
  obtain ⟨h01, h02, h03, h04, h12, h13, h14, h23, h24, h34⟩ :=
    p5_five_components_pairwise_distinct
  change C0 ≠ C1 at h01
  change C0 ≠ C2 at h02
  change C0 ≠ C3 at h03
  change C0 ≠ C4 at h04
  change C1 ≠ C2 at h12
  change C1 ≠ C3 at h13
  change C1 ≠ C4 at h14
  change C2 ≠ C3 at h23
  change C2 ≠ C4 at h24
  change C3 ≠ C4 at h34
  rw [Set.ncard_insert_of_notMem (by simp [h01, h02, h03, h04])]
  rw [Set.ncard_insert_of_notMem (by simp [h12, h13, h14])]
  rw [Set.ncard_insert_of_notMem (by simp [h23, h24])]
  rw [Set.ncard_insert_of_notMem (by simp [h34])]
  simp

/-! The five-anchor component map is injective.  This is the reusable packaged
    form of the pairwise separator audit above; the cardinality argument keeps
    the finite-index bookkeeping out of subsequent transport lemmas. -/
theorem p5_component_map_injOn :
    Set.InjOn (fun z : ℂ ↦ connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) z)
      (Set.range p5FiveAnchor) := by
  let K := Erdos1047.sublevelSet p5Polynomial p5WitnessLevel
  let C : ℂ → Set ℂ := fun z ↦ connectedComponentIn K z
  let A : Set ℂ := Set.range p5FiveAnchor
  have hAcard : A.ncard = 5 := by
    rw [Set.ncard_range_of_injective p5FiveAnchor_injective]
    simp
  have himage : C '' A =
      {C p5UpperLeftAnchor, C (star p5UpperLeftAnchor), C p5CentralAnchor,
        C p5RightAnchor, C (star p5RightAnchor)} := by
    ext t
    constructor
    · rintro ⟨z, ⟨i, rfl⟩, rfl⟩
      fin_cases i <;> simp [p5FiveAnchor]
    · intro ht
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ht
      rcases ht with rfl | rfl | rfl | rfl | rfl
      · exact ⟨p5UpperLeftAnchor, ⟨⟨0, by decide⟩, by simp [p5FiveAnchor]⟩, rfl⟩
      · exact ⟨star p5UpperLeftAnchor, ⟨⟨1, by decide⟩, by simp [p5FiveAnchor]⟩, rfl⟩
      · exact ⟨p5CentralAnchor, ⟨⟨2, by decide⟩, by simp [p5FiveAnchor]⟩, rfl⟩
      · exact ⟨p5RightAnchor, ⟨⟨3, by decide⟩, by simp [p5FiveAnchor]⟩, rfl⟩
      · exact ⟨star p5RightAnchor, ⟨⟨4, by decide⟩, by simp [p5FiveAnchor]⟩, rfl⟩
  have himagecard : (C '' A).ncard = 5 := by
    rw [himage]
    simpa [K, C] using p5_five_component_set_ncard
  have heq : (C '' A).ncard = A.ncard := himagecard.trans hAcard.symm
  have hinj : Set.InjOn C A :=
    Set.injOn_of_ncard_image_eq heq (Set.finite_range p5FiveAnchor)
  simpa [K, C, A] using hinj

theorem p5_five_component_set_subset_componentsIn :
    let K := Erdos1047.sublevelSet p5Polynomial p5WitnessLevel
    let C0 := connectedComponentIn K p5UpperLeftAnchor
    let C1 := connectedComponentIn K (star p5UpperLeftAnchor)
    let C2 := connectedComponentIn K p5CentralAnchor
    let C3 := connectedComponentIn K p5RightAnchor
    let C4 := connectedComponentIn K (star p5RightAnchor)
    ({C0, C1, C2, C3, C4} : Set (Set ℂ)) ⊆ Erdos1047.componentsIn K := by
  dsimp only
  have h0 : p5UpperLeftAnchor ∈
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel :=
    (p5UpperLeft_lineA_strict p5UpperLeftAnchor
      (left_mem_segment ℝ p5UpperLeftAnchor p5UpperLeftPointA)).le
  have h1 : star p5UpperLeftAnchor ∈
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel :=
    (p5_mem_star_iff _).2 h0
  have h2 : p5CentralAnchor ∈
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel :=
    (p5Central_lineA_strict p5CentralAnchor
      (left_mem_segment ℝ p5CentralAnchor p5CentralPointA)).le
  have h3 : p5RightAnchor ∈
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel :=
    (p5Right_lineA_strict p5RightAnchor
      (left_mem_segment ℝ p5RightAnchor p5RightPointA)).le
  have h4 : star p5RightAnchor ∈
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel :=
    (p5_mem_star_iff _).2 h3
  simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
  exact ⟨⟨p5UpperLeftAnchor, h0, rfl⟩,
    ⟨star p5UpperLeftAnchor, h1, rfl⟩,
    ⟨p5CentralAnchor, h2, rfl⟩,
    ⟨p5RightAnchor, h3, rfl⟩,
    ⟨star p5RightAnchor, h4, rfl⟩⟩

/-- The p5 sublevel set has exactly five components; the previous topological
exhaustion hypothesis is now discharged. -/
theorem p5_componentsIn_ncard :
    (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)).ncard = 5 := by
  have hfin : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)).Finite := by
    rw [p5_componentsIn_eq_image_rootSet]
    exact (p5Polynomial.rootSet_finite ℂ).image _
  have hlower : 5 ≤ (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)).ncard := by
    rw [← p5_five_component_set_ncard]
    exact Set.ncard_le_ncard p5_five_component_set_subset_componentsIn hfin
  have hupper : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)).ncard ≤ 5 := by
    rw [p5_componentsIn_eq_image_rootSet]
    calc
      _ ≤ (p5Polynomial.rootSet ℂ).ncard :=
        Set.ncard_image_le (p5Polynomial.rootSet_finite ℂ)
      _ = 5 := p5_rootSet_ncard
  omega

/-! Once the p5 witness level has five components, every lower regular level
    still has five: monotonicity gives the lower bound, while the root-image
    theorem gives the degree-five upper bound.  This is a concrete sanity check
    that the abstract nested-level lemma is oriented correctly. -/
theorem p5_componentsIn_ncard_eq_of_le_witness {c : ℝ}
    (hc : 0 ≤ c) (hcw : c ≤ p5WitnessLevel) :
    (Erdos1047.componentsIn (Erdos1047.sublevelSet p5Polynomial c)).ncard = 5 := by
  have hWlt : p5WitnessLevel < p5Level := by
    norm_num [p5WitnessLevel, p5Level]
  have hregW := p5_closedBall_subset_regular_values hWlt
  have hmon := componentsIn_ncard_le_of_nested_regular_sublevels
    p5Polynomial p5Polynomial_monic hc hcw hregW
  have hregc := p5_closedBall_subset_regular_values (lt_of_le_of_lt hcw hWlt)
  have hupp := componentsIn_ncard_le_rootSet_ncard_of_regular_values
    p5Polynomial_monic hc hregc
  have hroot : (p5Polynomial.rootSet ℂ).ncard = 5 := p5_rootSet_ncard
  have hlow : 5 ≤ (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p5Polynomial c)).ncard := by
    rw [p5_componentsIn_ncard] at hmon
    exact hmon
  have hupp' : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p5Polynomial c)).ncard ≤ 5 := by
    exact hupp.trans_eq hroot
  omega

/-- Once the five exhibited components are known to exhaust the p5 sublevel set,
the exact finite certificates force all five components to be non-convex. -/
theorem p5_nonconvex_ncard_of_components_ncard
    (hc : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)).ncard = 5) :
    {t ∈ Erdos1047.componentsIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) |
      ¬ Convex ℝ t}.ncard = 5 := by
  let K := Erdos1047.sublevelSet p5Polynomial p5WitnessLevel
  let C0 := connectedComponentIn K p5UpperLeftAnchor
  let C1 := connectedComponentIn K (star p5UpperLeftAnchor)
  let C2 := connectedComponentIn K p5CentralAnchor
  let C3 := connectedComponentIn K p5RightAnchor
  let C4 := connectedComponentIn K (star p5RightAnchor)
  let N := {t ∈ Erdos1047.componentsIn K | ¬ Convex ℝ t}
  have h0K : p5UpperLeftAnchor ∈ K :=
    (p5UpperLeft_lineA_strict p5UpperLeftAnchor
      (left_mem_segment ℝ p5UpperLeftAnchor p5UpperLeftPointA)).le
  have h1K : star p5UpperLeftAnchor ∈ K := (p5_mem_star_iff _).2 h0K
  have h2K : p5CentralAnchor ∈ K :=
    (p5Central_lineA_strict p5CentralAnchor
      (left_mem_segment ℝ p5CentralAnchor p5CentralPointA)).le
  have h3K : p5RightAnchor ∈ K :=
    (p5Right_lineA_strict p5RightAnchor
      (left_mem_segment ℝ p5RightAnchor p5RightPointA)).le
  have h4K : star p5RightAnchor ∈ K := (p5_mem_star_iff _).2 h3K
  have h0 : C0 ∈ N := ⟨⟨p5UpperLeftAnchor, h0K, rfl⟩,
    p5UpperLeft_component_not_convex⟩
  have h1 : C1 ∈ N := ⟨⟨star p5UpperLeftAnchor, h1K, rfl⟩,
    p5LowerLeft_component_not_convex⟩
  have h2 : C2 ∈ N := ⟨⟨p5CentralAnchor, h2K, rfl⟩,
    p5Central_component_not_convex⟩
  have h3 : C3 ∈ N := ⟨⟨p5RightAnchor, h3K, rfl⟩,
    p5Right_component_not_convex⟩
  have h4 : C4 ∈ N := ⟨⟨star p5RightAnchor, h4K, rfl⟩,
    p5LowerRight_component_not_convex⟩
  obtain ⟨h01, h02, h03, h04, h12, h13, h14, h23, h24, h34⟩ :=
    p5_five_components_pairwise_distinct
  change C0 ≠ C1 at h01
  change C0 ≠ C2 at h02
  change C0 ≠ C3 at h03
  change C0 ≠ C4 at h04
  change C1 ≠ C2 at h12
  change C1 ≠ C3 at h13
  change C1 ≠ C4 at h14
  change C2 ≠ C3 at h23
  change C2 ≠ C4 at h24
  change C3 ≠ C4 at h34
  have hfive : ({C0, C1, C2, C3, C4} : Set (Set ℂ)).ncard = 5 := by
    rw [Set.ncard_insert_of_notMem (by simp [h01, h02, h03, h04])]
    rw [Set.ncard_insert_of_notMem (by simp [h12, h13, h14])]
    rw [Set.ncard_insert_of_notMem (by simp [h23, h24])]
    rw [Set.ncard_insert_of_notMem (by simp [h34])]
    simp
  have hfive_subset : ({C0, C1, C2, C3, C4} : Set (Set ℂ)) ⊆ N := by
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨h0, h1, h2, h3, h4⟩
  have hKfin : (Erdos1047.componentsIn K).Finite := Set.finite_of_ncard_pos (by
    dsimp [K]
    rw [hc]
    norm_num)
  have hNfin : N.Finite := hKfin.subset (by intro t ht; exact ht.1)
  have hlower : 5 ≤ N.ncard := by
    rw [← hfive]
    exact Set.ncard_le_ncard hfive_subset hNfin
  have hupper : N.ncard ≤ 5 := by
    rw [← hc]
    exact Set.ncard_le_ncard (by intro t ht; exact ht.1) hKfin
  change N.ncard = 5
  omega

/-! As for p₆, saturation upgrades the five explicit p₅ witnesses to a
    root-wise statement.  This keeps future degree-raising interfaces free to
    work with roots rather than the particular rational anchor coordinates. -/
theorem p5_all_root_components_nonconvex :
    ∀ z ∈ (↑(p5Polynomial.rootSet ℂ) : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) z) := by
  have hfin : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)).Finite := by
    rw [p5_componentsIn_eq_image_rootSet]
    exact (p5Polynomial.rootSet_finite ℂ).image _
  have hnc := p5_nonconvex_ncard_of_components_ncard p5_componentsIn_ncard
  have hall := all_components_nonconvex_of_ncard_eq hfin
    p5_componentsIn_ncard hnc
  intro z hz
  apply hall (connectedComponentIn
    (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) z)
  rw [p5_componentsIn_eq_image_rootSet]
  exact ⟨z, hz, rfl⟩

/-- The p5 construction is reduced to the single topological exhaustion count. -/
theorem five_attainable_of_p5_components_ncard
    (hc : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)).ncard = 5) :
    5 ∈ attainableNonConvexCounts 5 := by
  refine ⟨p5Polynomial, p5WitnessLevel, p5Polynomial_monic, p5Polynomial_natDegree,
    by norm_num [p5WitnessLevel, p5Level], ?_, p5_nonconvex_ncard_of_components_ncard hc⟩
  calc
    (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)).ncard = 5 := hc
    _ = (p5Polynomial.rootSet ℂ).ncard := p5_rootSet_ncard.symm

/-- The degree-five construction is complete. -/
theorem five_attainable : 5 ∈ attainableNonConvexCounts 5 :=
  five_attainable_of_p5_components_ncard p5_componentsIn_ncard

/-! The general degree upper bound closes the finite degree-five maximum once
    the explicit p₅ witness is available. -/
theorem max_nonconvex_five : IsGreatest (attainableNonConvexCounts 5) 5 := by
  constructor
  · exact five_attainable
  · intro k hk
    exact attainable_le_proposed_answer_of_four_le (by norm_num) hk

/- ## A completely algebraic degree-four non-convexity certificate -/

/-- A symmetric quartic used for an exact, finite non-convexity witness. -/
def p4Polynomial : ℂ[X] := (X ^ 2 - 1) ^ 2 + 1

def p4Level : ℝ := 99999 / 100000

/-! The finite angular-table route is completely checkable in the first even
    case.  For `m = 2`, the four canonical directions reduce to the coordinate
    axes.  A root of the even family has nonzero real and imaginary parts; if two
    roots have opposite signs on either coordinate, the corresponding axis
    separates them.  If both coordinate signs agree, the two roots solve the
    same square equation and the factorisation `(r-s)(r+s)=0` forces equality. -/
theorem evenFamily_two_components_via_direction_table :
    (componentsIn (sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial 2) p4Level)).ncard = 4 := by
  let u : Fin (2 * 2) → ℂ := ![1, Complex.I, -1, -Complex.I]
  apply evenFamily_componentsIn_ncard_eq_two_mul_of_canonical_direction_table
    (m := 2) (by norm_num) (by norm_num [p4Level]) (by norm_num [p4Level]) u
  · intro j
    fin_cases j <;> constructor <;> norm_num [u]
  · intro r s hr hs hrs
    have hrroot := (Erdos1047EvenFamily.evenFamily_mem_rootSet_iff
      (m := 2) (by norm_num) r).mp hr
    have hsroot := (Erdos1047EvenFamily.evenFamily_mem_rootSet_iff
      (m := 2) (by norm_num) s).mp hs
    have hrre : r.re ≠ 0 := by
      intro hzero
      rcases hrroot with h | h
      · have hi := congrArg Complex.im h
        norm_num [pow_two, Complex.mul_im] at hi
        simp [hzero] at hi
      · have hi := congrArg Complex.im h
        norm_num [pow_two, Complex.mul_im] at hi
        simp [hzero] at hi
    have hrim : r.im ≠ 0 := by
      intro hzero
      rcases hrroot with h | h
      · have hi := congrArg Complex.im h
        norm_num [pow_two, Complex.mul_im] at hi
        simp [hzero] at hi
      · have hi := congrArg Complex.im h
        norm_num [pow_two, Complex.mul_im] at hi
        simp [hzero] at hi
    have hsre : s.re ≠ 0 := by
      intro hzero
      rcases hsroot with h | h
      · have hi := congrArg Complex.im h
        norm_num [pow_two, Complex.mul_im] at hi
        simp [hzero] at hi
      · have hi := congrArg Complex.im h
        norm_num [pow_two, Complex.mul_im] at hi
        simp [hzero] at hi
    have hsim : s.im ≠ 0 := by
      intro hzero
      rcases hsroot with h | h
      · have hi := congrArg Complex.im h
        norm_num [pow_two, Complex.mul_im] at hi
        simp [hzero] at hi
      · have hi := congrArg Complex.im h
        norm_num [pow_two, Complex.mul_im] at hi
        simp [hzero] at hi
    have same_quadrant_eq :
        ((r.re < 0 ∧ s.re < 0) ∨ (0 < r.re ∧ 0 < s.re)) →
        ((r.im < 0 ∧ s.im < 0) ∨ (0 < r.im ∧ 0 < s.im)) →
        r = s := by
      intro hre him
      have hprod_same :
          (0 < r.re * r.im ∧ 0 < s.re * s.im) ∨
            (r.re * r.im < 0 ∧ s.re * s.im < 0) := by
        rcases hre with hre | hre <;> rcases him with him | him
        · left
          exact ⟨mul_pos_of_neg_of_neg hre.1 him.1,
            mul_pos_of_neg_of_neg hre.2 him.2⟩
        · right
          exact ⟨mul_neg_of_neg_of_pos hre.1 him.1,
            mul_neg_of_neg_of_pos hre.2 him.2⟩
        · right
          exact ⟨mul_neg_of_pos_of_neg hre.1 him.1,
            mul_neg_of_pos_of_neg hre.2 him.2⟩
        · left
          exact ⟨mul_pos hre.1 him.1, mul_pos hre.2 him.2⟩
      have hsq : r ^ 2 = s ^ 2 := by
        have hrroot' := hrroot
        have hsroot' := hsroot
        rcases hrroot' with hrp | hrm <;> rcases hsroot' with hsp | hsm
        · exact hrp.trans hsp.symm
        · have hir := congrArg Complex.im hrp
          have his := congrArg Complex.im hsm
          norm_num [pow_two, Complex.mul_im] at hir his
          rcases hprod_same with hprod_same | hprod_same <;> nlinarith
        · have hir := congrArg Complex.im hrm
          have his := congrArg Complex.im hsp
          norm_num [pow_two, Complex.mul_im] at hir his
          rcases hprod_same with hprod_same | hprod_same <;> nlinarith
        · exact hrm.trans hsm.symm
      have hfac : (r - s) * (r + s) = 0 := by
        calc
          (r - s) * (r + s) = r ^ 2 - s ^ 2 := by ring
          _ = 0 := sub_eq_zero.mpr hsq
      rcases mul_eq_zero.mp hfac with hzero | hsum
      · exact sub_eq_zero.mp hzero
      · have hreadd := congrArg Complex.re hsum
        norm_num [Complex.add_re] at hreadd
        rcases hre with hre | hre <;> nlinarith
    rcases lt_or_gt_of_ne hrim with hrneg | hrpos
    · rcases lt_or_gt_of_ne hsim with hsneg | hspos
      · rcases lt_or_gt_of_ne hrre with hrerneg | hrerpos
        · rcases lt_or_gt_of_ne hsre with hserneg | hserpos
          · exfalso
            exact hrs (same_quadrant_eq (Or.inl ⟨hrerneg, hserneg⟩)
              (Or.inl ⟨hrneg, hsneg⟩))
          · exact ⟨1, by simp [u, Complex.mul_re, Complex.mul_im, hrerneg, hserpos]⟩
        · rcases lt_or_gt_of_ne hsre with hserneg | hserpos
          · exact ⟨1, by simp [u, Complex.mul_re, Complex.mul_im, hrerpos, hserneg]⟩
          · exfalso
            exact hrs (same_quadrant_eq (Or.inr ⟨hrerpos, hserpos⟩)
              (Or.inl ⟨hrneg, hsneg⟩))
      · exact ⟨0, by simp [u, Complex.mul_re, Complex.mul_im, hrneg, hspos]⟩
    · rcases lt_or_gt_of_ne hsim with hsneg | hspos
      · exact ⟨0, by simp [u, Complex.mul_re, Complex.mul_im, hrpos, hsneg]⟩
      · rcases lt_or_gt_of_ne hrre with hrerneg | hrerpos
        · rcases lt_or_gt_of_ne hsre with hserneg | hserpos
          · exfalso
            exact hrs (same_quadrant_eq (Or.inl ⟨hrerneg, hserneg⟩)
              (Or.inr ⟨hrpos, hspos⟩))
          · exact ⟨1, by simp [u, Complex.mul_re, Complex.mul_im, hrerneg, hserpos]⟩
        · rcases lt_or_gt_of_ne hsre with hserneg | hserpos
          · exact ⟨1, by simp [u, Complex.mul_re, Complex.mul_im, hrerpos, hserneg]⟩
          · exfalso
            exact hrs (same_quadrant_eq (Or.inr ⟨hrerpos, hserpos⟩)
              (Or.inr ⟨hrpos, hspos⟩))

def p4Anchor : ℂ := (11 / 10 : ℂ) + (91 / 200 : ℂ) * Complex.I

def p4PointA : ℂ := (10101 / 10000 : ℂ) + (21 / 2000 : ℂ) * Complex.I

def p4PointB : ℂ := (10887 / 10000 : ℂ) + (423 / 5000 : ℂ) * Complex.I

/-- A fixed-degree Bernstein certificate: nonpositive coefficients give a nonpositive
polynomial throughout the unit interval. -/
theorem bernstein8_nonpos (t c0 c1 c2 c3 c4 c5 c6 c7 c8 : ℝ)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hc0 : c0 ≤ 0) (hc1 : c1 ≤ 0) (hc2 : c2 ≤ 0) (hc3 : c3 ≤ 0)
    (hc4 : c4 ≤ 0) (hc5 : c5 ≤ 0) (hc6 : c6 ≤ 0) (hc7 : c7 ≤ 0)
    (hc8 : c8 ≤ 0) :
    c0 * t ^ 0 * (1 - t) ^ 8 + c1 * t ^ 1 * (1 - t) ^ 7 +
      c2 * t ^ 2 * (1 - t) ^ 6 + c3 * t ^ 3 * (1 - t) ^ 5 +
      c4 * t ^ 4 * (1 - t) ^ 4 + c5 * t ^ 5 * (1 - t) ^ 3 +
      c6 * t ^ 6 * (1 - t) ^ 2 + c7 * t ^ 7 * (1 - t) ^ 1 +
      c8 * t ^ 8 * (1 - t) ^ 0 ≤ 0 := by
  have hsub : 0 ≤ 1 - t := by linarith
  have h0 := mul_nonpos_of_nonpos_of_nonneg hc0
    (mul_nonneg (pow_nonneg ht0 0) (pow_nonneg hsub 8))
  have h1 := mul_nonpos_of_nonpos_of_nonneg hc1
    (mul_nonneg (pow_nonneg ht0 1) (pow_nonneg hsub 7))
  have h2 := mul_nonpos_of_nonpos_of_nonneg hc2
    (mul_nonneg (pow_nonneg ht0 2) (pow_nonneg hsub 6))
  have h3 := mul_nonpos_of_nonpos_of_nonneg hc3
    (mul_nonneg (pow_nonneg ht0 3) (pow_nonneg hsub 5))
  have h4 := mul_nonpos_of_nonpos_of_nonneg hc4
    (mul_nonneg (pow_nonneg ht0 4) (pow_nonneg hsub 4))
  have h5 := mul_nonpos_of_nonpos_of_nonneg hc5
    (mul_nonneg (pow_nonneg ht0 5) (pow_nonneg hsub 3))
  have h6 := mul_nonpos_of_nonpos_of_nonneg hc6
    (mul_nonneg (pow_nonneg ht0 6) (pow_nonneg hsub 2))
  have h7 := mul_nonpos_of_nonpos_of_nonneg hc7
    (mul_nonneg (pow_nonneg ht0 7) (pow_nonneg hsub 1))
  have h8 := mul_nonpos_of_nonpos_of_nonneg hc8
    (mul_nonneg (pow_nonneg ht0 8) (pow_nonneg hsub 0))
  nlinarith

/-- The same Bernstein certificate is strict when its two endpoint coefficients
are strict.  Only one endpoint term is needed: the first if `t < 1`, and the last
if `t = 1`. -/
theorem bernstein8_neg (t c0 c1 c2 c3 c4 c5 c6 c7 c8 : ℝ)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hc0 : c0 < 0) (hc1 : c1 ≤ 0) (hc2 : c2 ≤ 0) (hc3 : c3 ≤ 0)
    (hc4 : c4 ≤ 0) (hc5 : c5 ≤ 0) (hc6 : c6 ≤ 0) (hc7 : c7 ≤ 0)
    (hc8 : c8 < 0) :
    c0 * t ^ 0 * (1 - t) ^ 8 + c1 * t ^ 1 * (1 - t) ^ 7 +
      c2 * t ^ 2 * (1 - t) ^ 6 + c3 * t ^ 3 * (1 - t) ^ 5 +
      c4 * t ^ 4 * (1 - t) ^ 4 + c5 * t ^ 5 * (1 - t) ^ 3 +
      c6 * t ^ 6 * (1 - t) ^ 2 + c7 * t ^ 7 * (1 - t) ^ 1 +
      c8 * t ^ 8 * (1 - t) ^ 0 < 0 := by
  by_cases ht : t < 1
  · have hrest := bernstein8_nonpos t 0 c1 c2 c3 c4 c5 c6 c7 c8 ht0 ht1
      (le_refl 0) hc1 hc2 hc3 hc4 hc5 hc6 hc7 hc8.le
    have hfirst : c0 * t ^ 0 * (1 - t) ^ 8 < 0 := by
      simpa using mul_neg_of_neg_of_pos hc0 (show 0 < (1 - t) ^ 8 by positivity)
    nlinarith
  · have ht' : t = 1 := le_antisymm ht1 (le_of_not_gt ht)
    simpa [ht'] using hc8

theorem p4_lineA_normSq (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    Complex.normSq
        (p4Polynomial.eval (p4Anchor + (t : ℂ) * (p4PointA - p4Anchor))) <
      p4Level ^ 2 := by
  have hid :
      Complex.normSq
          (p4Polynomial.eval (p4Anchor + (t : ℂ) * (p4PointA - p4Anchor))) -
        p4Level ^ 2 =
        (-2559847828737190879 / 2560000000000000000 : ℝ) * t ^ 0 * (1 - t) ^ 8 +
        (-5122001696234330689 / 640000000000000000 : ℝ) * t ^ 1 * (1 - t) ^ 7 +
        (-1167805771346946232087 / 50000000000000000000 : ℝ) * t ^ 2 * (1 - t) ^ 6 +
        (-27199301566371611540441 / 800000000000000000000 : ℝ) * t ^ 3 * (1 - t) ^ 5 +
        (-53637317462884929205355623 / 2000000000000000000000000 : ℝ) * t ^ 4 * (1 - t) ^ 4 +
        (-11128524535500400501063093 / 1000000000000000000000000 : ℝ) * t ^ 5 * (1 - t) ^ 3 +
        (-157584520669066811341393423 / 78125000000000000000000000 : ℝ) * t ^ 6 * (1 - t) ^ 2 +
        (-78587783783410601459613413 / 1250000000000000000000000000 : ℝ) * t ^ 7 * (1 - t) ^ 1 +
        (-398478423341172994897898639 / 6250000000000000000000000000000 : ℝ) * t ^ 8 * (1 - t) ^ 0 := by
    norm_num [p4Polynomial, p4Anchor, p4PointA, p4Level, Complex.normSq,
