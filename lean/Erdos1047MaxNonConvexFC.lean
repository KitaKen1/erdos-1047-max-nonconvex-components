/-! Once a single geometric `n → n+2` step is available, there is no further
    combinatorial obstruction: the degree-five and degree-six base witnesses
    generate every degree at least five by strong induction.  Keeping this
    schema separate makes the remaining analytic obligation explicit. -/
theorem proposed_answer_attainable_ge_five_of_degree_raise_step
    (hstep : ∀ m : ℕ, 5 ≤ m →
      m ∈ attainableNonConvexCounts m →
        m + 2 ∈ attainableNonConvexCounts (m + 2)) :
    ∀ n : ℕ, 5 ≤ n → n ∈ attainableNonConvexCounts n := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
      intro hn
      by_cases h5 : n = 5
      · subst n
        exact five_attainable
      by_cases h6 : n = 6
      · subst n
        exact p6_attainable_six
      have hnprev : 5 ≤ n - 2 := by omega
      have hprev : n - 2 ∈ attainableNonConvexCounts (n - 2) :=
        ih (n - 2) (by omega) hnprev
      have hstep' := hstep (n - 2) hnprev hprev
      have hn2 : 2 ≤ n := by omega
      simpa [Nat.sub_add_cancel hn2] using hstep'

theorem proposed_answer_attainable_six_le_of_degree_raise_step
    (hstep : ∀ m : ℕ, 5 ≤ m →
      m ∈ attainableNonConvexCounts m →
        m + 2 ∈ attainableNonConvexCounts (m + 2))
    (n : ℕ) (hn : 6 ≤ n) :
    maxNonConvexAnswer n ∈ attainableNonConvexCounts n := by
  have h := proposed_answer_attainable_ge_five_of_degree_raise_step hstep n (by omega)
  rw [maxNonConvexAnswer_of_four_le (show 4 ≤ n by omega)]
  exact h

