theorem evenFamilyRotatedLowerSector_subset_component {m : ℕ}
    (hm : 0 < m) {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level)
    {u : ℂ} (hu : u ^ m = 1) :
    evenFamilyRotatedLowerSector m c u ⊆ connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
      (u * evenFamilyLowerAnchor m) := by
  apply (evenFamilyRotatedLowerSector_preconnected hm hc1 u).subset_connectedComponentIn
    (show u * evenFamilyLowerAnchor m ∈
      evenFamilyRotatedLowerSector m c u from by
        refine ⟨evenFamilyLowerAnchor m, ?_, rfl⟩
        refine ⟨q2InverseL 0, ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩, rfl⟩)
  exact evenFamilyRotatedLowerSector_subset_sublevel hm hcpos hc1 hu

theorem evenFamilyUpperSector_subset_component {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) :
    evenFamilyUpperSector m c ⊆ connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
      (evenFamilyUpperAnchor m) := by
  apply (evenFamilyUpperSector_preconnected hm hc1).subset_connectedComponentIn
    (show evenFamilyUpperAnchor m ∈ evenFamilyUpperSector m c from by
      refine ⟨q2InverseU 0, ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩, rfl⟩)
  exact evenFamilyUpperSector_subset_sublevel hm hcpos hc1

theorem evenFamilyRotatedUpperSector_preconnected {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hc1 : c ≤ p4Level) (u : ℂ) :
    IsPreconnected (evenFamilyRotatedUpperSector m c u) := by
  exact (evenFamilyUpperSector_preconnected hm hc1).image _ (by fun_prop)

theorem evenFamilyRotatedUpperSector_subset_sublevel {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) {u : ℂ} (hu : u ^ m = 1) :
    evenFamilyRotatedUpperSector m c u ⊆
      sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c := by
  rintro z ⟨y, hy, rfl⟩
  change ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval (u * y)‖ ≤ c
  rw [Erdos1047EvenFamily.evenFamily_norm_eval_mul_root_of_unity hu]
  exact evenFamilyUpperSector_subset_sublevel hm hcpos hc1 hy

theorem evenFamilyRotatedUpperSector_anchor_mem_rootSet {m : ℕ}
    (hm : 0 < m) {u : ℂ} (hu : u ^ m = 1) :
    u * evenFamilyUpperAnchor m ∈
      (Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ := by
  exact Erdos1047EvenFamily.evenFamily_mul_root_of_unity_mem_rootSet
    hm hu (evenFamilyUpperAnchor_mem_rootSet hm)

theorem evenFamilyRotatedUpperSector_subset_component {m : ℕ}
    (hm : 0 < m) {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level)
    {u : ℂ} (hu : u ^ m = 1) :
    evenFamilyRotatedUpperSector m c u ⊆ connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
