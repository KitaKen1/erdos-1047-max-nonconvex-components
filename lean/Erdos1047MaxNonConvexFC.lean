  apply (evenFamilyRotatedUpperSector_preconnected hm hc1 u).subset_connectedComponentIn
    (show u * evenFamilyUpperAnchor m ∈
      evenFamilyRotatedUpperSector m c u from by
        refine ⟨evenFamilyUpperAnchor m, ?_, rfl⟩
        refine ⟨q2InverseU 0, ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩, rfl⟩)
  exact evenFamilyRotatedUpperSector_subset_sublevel hm hcpos hc1 hu

theorem evenFamilyRotatedUpperSector_disjoint {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hc1 : c ≤ p4Level) {u v : ℂ}
    (hu : u ^ m = 1) (hv : v ^ m = 1) (huv : u ≠ v) :
    Disjoint (evenFamilyRotatedUpperSector m c u)
      (evenFamilyRotatedUpperSector m c v) := by
  apply Set.disjoint_left.2
  intro x hxU hxV
  rcases hxU with ⟨r₁, ⟨a₁, ⟨w₁, hw₁, ha₁⟩, hr₁⟩, hxr₁⟩
  rcases hxV with ⟨r₂, ⟨a₂, ⟨w₂, hw₂, ha₂⟩, hr₂⟩, hxr₂⟩
  have hEq : u * r₁ = v * r₂ := hxr₁.trans hxr₂.symm
  have hpowEq := congrArg (fun z : ℂ => z ^ m) hEq
  rw [mul_pow, mul_pow, hu, hv, one_mul, one_mul] at hpowEq
  have hslit₁ : q2InverseU w₁ ∈ Complex.slitPlane :=
    q2UpperRegionAt_subset_slitPlane hc1 ⟨w₁, hw₁, rfl⟩
  have hslit₂ : q2InverseU w₂ ∈ Complex.slitPlane :=
    q2UpperRegionAt_subset_slitPlane hc1 ⟨w₂, hw₂, rfl⟩
  rw [← hr₁, ← hr₂, ← ha₁, ← ha₂] at hpowEq
  have hqEq : q2InverseU w₁ = q2InverseU w₂ := by
    calc
      q2InverseU w₁ =
          (Erdos1047EvenFamily.principalRoot m (q2InverseU w₁)) ^ m :=
        (Erdos1047EvenFamily.principalRoot_pow hm
          (Complex.slitPlane_ne_zero hslit₁)).symm
      _ = (Erdos1047EvenFamily.principalRoot m (q2InverseU w₂)) ^ m := hpowEq
      _ = q2InverseU w₂ := Erdos1047EvenFamily.principalRoot_pow hm
        (Complex.slitPlane_ne_zero hslit₂)
  have hwEq : w₁ = w₂ := by
    have heval := congrArg (fun z : ℂ => q2Polynomial.eval z) hqEq
    simpa [q2_inverse_eval] using heval
  have hrEq : r₁ = r₂ := by
    calc
      r₁ = Erdos1047EvenFamily.principalRoot m a₁ := hr₁.symm
      _ = Erdos1047EvenFamily.principalRoot m (q2InverseU w₁) := by rw [ha₁]
      _ = Erdos1047EvenFamily.principalRoot m (q2InverseU w₂) := by rw [hwEq]
      _ = Erdos1047EvenFamily.principalRoot m a₂ := by rw [ha₂]
      _ = r₂ := hr₂
  have hmul : u * r₁ = v * r₁ := by simpa [hrEq] using hEq
  have hr0 : r₁ ≠ 0 := by
    intro hzero
    apply Erdos1047EvenFamily.principalRoot_ne_zero m a₁
    rw [hr₁]
    exact hzero
  have : u = v := by
    exact (mul_right_cancel₀ hr0) hmul
  exact huv this

theorem evenFamilyRotatedLowerSector_angular_sign {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hc1 : c ≤ p4Level) {u : ℂ} (hu : u ^ m = 1)
    {z : ℂ} (hz : z ∈ evenFamilyRotatedLowerSector m c u) :
    (z * star u).im < 0 := by
  rcases hz with ⟨r, ⟨a, ⟨w, hw, rfl⟩, rfl⟩, rfl⟩
  have hwsmall : w ∈ p4OutputDisk := by
    apply mem_p4OutputDisk_of_norm_le_level
    have hw' : ‖w‖ ≤ c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    linarith
  have him : (Erdos1047EvenFamily.principalRoot m (q2InverseL w)).im < 0 :=
    Erdos1047EvenFamily.principalRoot_im_neg_of_im_neg hm
      (q2_inverse_lower_im_neg_of_output_disk hwsmall)
  have hu0 : u ≠ 0 := Erdos1047EvenFamily.evenFamily_root_unity_ne_zero hm hu
  have hnorm : 0 < Complex.normSq u := Complex.normSq_pos.mpr hu0
  have hid : u * star u = (Complex.normSq u : ℂ) := by
    apply Complex.ext <;>
      simp [Complex.normSq_apply, Complex.mul_re, Complex.mul_im] <;> ring
  have hcalc :
      ((u * Erdos1047EvenFamily.principalRoot m (q2InverseL w)) * star u).im =
        Complex.normSq u *
          (Erdos1047EvenFamily.principalRoot m (q2InverseL w)).im := by
    rw [show (u * Erdos1047EvenFamily.principalRoot m (q2InverseL w)) * star u =
      (u * star u) * Erdos1047EvenFamily.principalRoot m (q2InverseL w) by ring]
    rw [hid]
    norm_num [Complex.mul_im]
  rw [hcalc]
  exact mul_neg_of_pos_of_neg hnorm him

theorem evenFamilyRotatedUpperSector_angular_sign {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hc1 : c ≤ p4Level) {u : ℂ} (hu : u ^ m = 1)
    {z : ℂ} (hz : z ∈ evenFamilyRotatedUpperSector m c u) :
    0 < (z * star u).im := by
  rcases hz with ⟨r, ⟨a, ⟨w, hw, rfl⟩, rfl⟩, rfl⟩
  have hwsmall : w ∈ p4OutputDisk := by
    apply mem_p4OutputDisk_of_norm_le_level
    have hw' : ‖w‖ ≤ c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    linarith
  have him : 0 < (Erdos1047EvenFamily.principalRoot m (q2InverseU w)).im :=
    Erdos1047EvenFamily.principalRoot_im_pos_of_im_pos hm
      (q2_inverse_im_pos_of_output_disk hwsmall)
  have hu0 : u ≠ 0 := Erdos1047EvenFamily.evenFamily_root_unity_ne_zero hm hu
  have hnorm : 0 < Complex.normSq u := Complex.normSq_pos.mpr hu0
  have hid : u * star u = (Complex.normSq u : ℂ) := by
    apply Complex.ext <;>
      simp [Complex.normSq_apply, Complex.mul_re, Complex.mul_im] <;> ring
  have hcalc :
      ((u * Erdos1047EvenFamily.principalRoot m (q2InverseU w)) * star u).im =
        Complex.normSq u *
          (Erdos1047EvenFamily.principalRoot m (q2InverseU w)).im := by
    rw [show (u * Erdos1047EvenFamily.principalRoot m (q2InverseU w)) * star u =
      (u * star u) * Erdos1047EvenFamily.principalRoot m (q2InverseU w) by ring]
    rw [hid]
    norm_num [Complex.mul_im]
  rw [hcalc]
  exact mul_pos hnorm him

/-! The sector parametrization also records the sign of the `m`-th power.
    This is the missing direction needed to identify a whole component with
    one rotated upper sector. -/
theorem evenFamilyRotatedUpperSector_pow_im_pos {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hc1 : c ≤ p4Level) {u : ℂ} (hu : u ^ m = 1)
    {z : ℂ} (hz : z ∈ evenFamilyRotatedUpperSector m c u) :
    0 < (z ^ m).im := by
  rcases hz with ⟨z₀, ⟨r, ⟨w, hw, rfl⟩, rfl⟩, rfl⟩
  have hwsmall : w ∈ p4OutputDisk := by
    apply mem_p4OutputDisk_of_norm_le_level
    have hw' : ‖w‖ ≤ c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    linarith
  have hslit : q2InverseU w ∈ Complex.slitPlane :=
    q2UpperRegionAt_subset_slitPlane hc1 ⟨w, hw, rfl⟩
  have hpow := Erdos1047EvenFamily.principalRoot_pow hm
    (Complex.slitPlane_ne_zero hslit)
  have hpowz : (u * Erdos1047EvenFamily.principalRoot m
      (q2InverseU w)) ^ m = q2InverseU w := by
    rw [mul_pow, hu, one_mul, hpow]
  have him : 0 < (q2InverseU w).im :=
    q2_inverse_im_pos_of_output_disk hwsmall
  rw [hpowz]
  exact him

theorem evenFamilyRotatedLowerSector_pow_im_neg {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hc1 : c ≤ p4Level) {u : ℂ} (hu : u ^ m = 1)
    {z : ℂ} (hz : z ∈ evenFamilyRotatedLowerSector m c u) :
    (z ^ m).im < 0 := by
  rcases hz with ⟨z₀, ⟨r, ⟨w, hw, rfl⟩, rfl⟩, rfl⟩
  have hwsmall : w ∈ p4OutputDisk := by
    apply mem_p4OutputDisk_of_norm_le_level
    have hw' : ‖w‖ ≤ c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    linarith
  have hslit : q2InverseL w ∈ Complex.slitPlane :=
    q2LowerRegionAt_subset_slitPlane hc1 ⟨w, hw, rfl⟩
  have hpow := Erdos1047EvenFamily.principalRoot_pow hm
    (Complex.slitPlane_ne_zero hslit)
  have hpowz : (u * Erdos1047EvenFamily.principalRoot m
      (q2InverseL w)) ^ m = q2InverseL w := by
    rw [mul_pow, hu, one_mul, hpow]
  have him : (q2InverseL w).im < 0 :=
    q2_inverse_lower_im_neg_of_output_disk hwsmall
  rw [hpowz]
  exact him

/-! Every point of the component of a rotated upper anchor stays on the
    positive-power sheet.  The sector decomposition then forces its rotation
    label to be the anchor's label, using the already proved root-component
    injectivity. -/
theorem evenFamilyRotatedUpperSector_eq_component {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) {u : ℂ}
    (hu : u ^ m = 1) :
    evenFamilyRotatedUpperSector m c u =
      connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
        (u * evenFamilyUpperAnchor m) := by
  apply Set.Subset.antisymm
  · exact evenFamilyRotatedUpperSector_subset_component hm hcpos hc1 hu
  · intro z hz
    have hc_lt_one : c < 1 := lt_one_of_le_p4Level hc1
    have hanchor : u * evenFamilyUpperAnchor m ∈
        sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c := by
      apply evenFamilyRotatedUpperSector_subset_sublevel hm hcpos hc1 hu
      refine ⟨evenFamilyUpperAnchor m, ?_, rfl⟩
      refine ⟨q2InverseU 0, ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩, rfl⟩
    have hslit0 : q2InverseU 0 ∈ Complex.slitPlane := by
      rw [Complex.mem_slitPlane_iff]
      right
      have hzero : (0 : ℂ) ∈ p4OutputDisk := by
        have hnorm : ‖(0 : ℂ)‖ ≤ p4Level := by norm_num [p4Level]
        simpa [p4OutputDisk] using hnorm
      exact ne_of_gt (q2_inverse_im_pos_of_output_disk hzero)
    have hanchor_pow : 0 < ((u * evenFamilyUpperAnchor m) ^ m).im := by
      have hrootpow := Erdos1047EvenFamily.principalRoot_pow hm
        (Complex.slitPlane_ne_zero hslit0)
      have hu0 : (u * evenFamilyUpperAnchor m) ^ m =
          (q2InverseU 0) := by
        rw [mul_pow, hu, one_mul]
        simpa [evenFamilyUpperAnchor] using hrootpow
      rw [hu0]
      have hzero : (0 : ℂ) ∈ p4OutputDisk := by
        have hnorm : ‖(0 : ℂ)‖ ≤ p4Level := by norm_num [p4Level]
        simpa [p4OutputDisk] using hnorm
      exact q2_inverse_im_pos_of_output_disk hzero
    have hsign := evenFamily_component_pow_im_pos hc_lt_one hanchor hanchor_pow
    have hzpos : 0 < (z ^ m).im := hsign z hz
    obtain ⟨v, hv, hzsector⟩ :=
      evenFamily_sublevel_mem_rotated_upper_or_lower_sector hm hcpos hc1
        (connectedComponentIn_subset _ _ hz)
    rcases hzsector with hzupper | hzlower
    · have hzv : z ∈ connectedComponentIn
          (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
          (v * evenFamilyUpperAnchor m) :=
        evenFamilyRotatedUpperSector_subset_component hm hcpos hc1 hv hzupper
      have hcomp : connectedComponentIn
          (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
          (u * evenFamilyUpperAnchor m) =
          connectedComponentIn
          (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
          (v * evenFamilyUpperAnchor m) := by
        exact (connectedComponentIn_eq hz).trans (connectedComponentIn_eq hzv).symm
      have huroot := evenFamilyRotatedUpperSector_anchor_mem_rootSet hm hu
      have hvroot := evenFamilyRotatedUpperSector_anchor_mem_rootSet hm hv
      have huvroot : u * evenFamilyUpperAnchor m =
          v * evenFamilyUpperAnchor m :=
        evenFamily_root_component_injOn_via_sheet hm hcpos.le hc_lt_one
          huroot hvroot hcomp
      have hanchor0 : evenFamilyUpperAnchor m ≠ 0 := by
        dsimp [evenFamilyUpperAnchor]
        exact Erdos1047EvenFamily.principalRoot_ne_zero _ _
      have huv : u = v := (mul_right_cancel₀ hanchor0) huvroot
      simpa [huv] using hzupper
    · exfalso
      have hzneg := evenFamilyRotatedLowerSector_pow_im_neg hm hc1 hv hzlower
      linarith

theorem evenFamilyRotatedLowerSector_anchor_mem_rootSet {m : ℕ}
    (hm : 0 < m) {u : ℂ} (hu : u ^ m = 1) :
    u * evenFamilyLowerAnchor m ∈
      (Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ := by
  exact Erdos1047EvenFamily.evenFamily_mul_root_of_unity_mem_rootSet
    hm hu (evenFamilyLowerAnchor_mem_rootSet hm)

theorem evenFamilyRotatedLowerSector_eq_component {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) {u : ℂ}
    (hu : u ^ m = 1) :
    evenFamilyRotatedLowerSector m c u =
      connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
        (u * evenFamilyLowerAnchor m) := by
  apply Set.Subset.antisymm
  · exact evenFamilyRotatedLowerSector_subset_component hm hcpos hc1 hu
  · intro z hz
    have hc_lt_one : c < 1 := lt_one_of_le_p4Level hc1
    have hanchor : u * evenFamilyLowerAnchor m ∈
        sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c := by
      apply evenFamilyRotatedLowerSector_subset_sublevel hm hcpos hc1 hu
      refine ⟨evenFamilyLowerAnchor m, ?_, rfl⟩
      refine ⟨q2InverseL 0, ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩, rfl⟩
    have hslit0 : q2InverseL 0 ∈ Complex.slitPlane := by
      rw [Complex.mem_slitPlane_iff]
      right
      have hzero : (0 : ℂ) ∈ p4OutputDisk := by
        have hnorm : ‖(0 : ℂ)‖ ≤ p4Level := by norm_num [p4Level]
        simpa [p4OutputDisk] using hnorm
      exact ne_of_lt (q2_inverse_lower_im_neg_of_output_disk hzero)
    have hanchor_pow : ((u * evenFamilyLowerAnchor m) ^ m).im < 0 := by
      have hrootpow := Erdos1047EvenFamily.principalRoot_pow hm
        (Complex.slitPlane_ne_zero hslit0)
      have hu0 : (u * evenFamilyLowerAnchor m) ^ m =
          (q2InverseL 0) := by
        rw [mul_pow, hu, one_mul]
        simpa [evenFamilyLowerAnchor] using hrootpow
      rw [hu0]
      have hzero : (0 : ℂ) ∈ p4OutputDisk := by
        have hnorm : ‖(0 : ℂ)‖ ≤ p4Level := by norm_num [p4Level]
        simpa [p4OutputDisk] using hnorm
      exact q2_inverse_lower_im_neg_of_output_disk hzero
    have hsign := evenFamily_component_pow_im_neg hc_lt_one hanchor hanchor_pow
    have hzneg : (z ^ m).im < 0 := hsign z hz
    obtain ⟨v, hv, hzsector⟩ :=
      evenFamily_sublevel_mem_rotated_upper_or_lower_sector hm hcpos hc1
        (connectedComponentIn_subset _ _ hz)
    rcases hzsector with hzupper | hzlower
    · exfalso
      have hzpos := evenFamilyRotatedUpperSector_pow_im_pos hm hc1 hv hzupper
      linarith
    · have hzv : z ∈ connectedComponentIn
          (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
          (v * evenFamilyLowerAnchor m) :=
        evenFamilyRotatedLowerSector_subset_component hm hcpos hc1 hv hzlower
      have hcomp : connectedComponentIn
          (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
          (u * evenFamilyLowerAnchor m) =
          connectedComponentIn
          (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
          (v * evenFamilyLowerAnchor m) := by
        exact (connectedComponentIn_eq hz).trans (connectedComponentIn_eq hzv).symm
      have huroot := evenFamilyRotatedLowerSector_anchor_mem_rootSet hm hu
      have hvroot := evenFamilyRotatedLowerSector_anchor_mem_rootSet hm hv
      have huvroot : u * evenFamilyLowerAnchor m =
          v * evenFamilyLowerAnchor m :=
        evenFamily_root_component_injOn_via_sheet hm hcpos.le hc_lt_one
          huroot hvroot hcomp
      have hanchor0 : evenFamilyLowerAnchor m ≠ 0 := by
        dsimp [evenFamilyLowerAnchor]
        exact Erdos1047EvenFamily.principalRoot_ne_zero _ _
      have huv : u = v := (mul_right_cancel₀ hanchor0) huvroot
      simpa [huv] using hzlower

theorem evenFamilyRotatedUpperSector_not_convex_of_certificate
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level)
    {u : ℂ} (hu : u ^ m = 1) {a b : ℂ}
    (hcert : Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
      c (u * evenFamilyUpperAnchor m) a b)) :
    ¬ Convex ℝ (evenFamilyRotatedUpperSector m c u) := by
  rw [evenFamilyRotatedUpperSector_eq_component hm hcpos hc1 hu]
  obtain ⟨h⟩ := hcert
  exact h.not_convex_component

theorem evenFamilyRotatedLowerSector_not_convex_of_certificate
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level)
    {u : ℂ} (hu : u ^ m = 1) {a b : ℂ}
    (hcert : Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
      c (u * evenFamilyLowerAnchor m) a b)) :
    ¬ Convex ℝ (evenFamilyRotatedLowerSector m c u) := by
  rw [evenFamilyRotatedLowerSector_eq_component hm hcpos hc1 hu]
  obtain ⟨h⟩ := hcert
  exact h.not_convex_component

theorem evenFamily_rotated_upper_lower_anchor_components_ne {m : ℕ}
    (hm : 0 < m) {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level)
    {u : ℂ} (hu : u ^ m = 1) :
    connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
        (u * evenFamilyUpperAnchor m) ≠
    connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
        (u * evenFamilyLowerAnchor m) := by
  have hc_lt_one : c < 1 := lt_one_of_le_p4Level hc1
  have hU : u * evenFamilyUpperAnchor m ∈
      evenFamilyRotatedUpperSector m c u := by
    refine ⟨evenFamilyUpperAnchor m, ?_, rfl⟩
    refine ⟨q2InverseU 0, ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩, rfl⟩
  have hL : u * evenFamilyLowerAnchor m ∈
      evenFamilyRotatedLowerSector m c u := by
    refine ⟨evenFamilyLowerAnchor m, ?_, rfl⟩
    refine ⟨q2InverseL 0, ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩, rfl⟩
  have hUS : u * evenFamilyUpperAnchor m ∈
      sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c :=
    evenFamilyRotatedUpperSector_subset_sublevel hm hcpos hc1 hu hU
  have hLS : u * evenFamilyLowerAnchor m ∈
      sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c :=
    evenFamilyRotatedLowerSector_subset_sublevel hm hcpos hc1 hu hL
  have hpos : 0 < ((u * evenFamilyUpperAnchor m) * star u).im :=
    evenFamilyRotatedUpperSector_angular_sign hm hc1 hu hU
  have hneg : ((u * evenFamilyLowerAnchor m) * star u).im < 0 :=
    evenFamilyRotatedLowerSector_angular_sign hm hc1 hu hL
  apply connectedComponentIn_ne_of_separator_sign
    (S := sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
    (r := u * evenFamilyUpperAnchor m) (s := u * evenFamilyLowerAnchor m)
    (φ := fun z : ℂ => (z * star u).im) (by fun_prop)
  · exact evenFamily_root_unity_angular_barrier_avoids_sublevel hm hu hc_lt_one
  · exact hUS
  · exact hLS
  · exact hpos
  · exact hneg

theorem q2UpperRegion_subset_sublevel :
    q2UpperRegion ⊆ sublevelSet q2Polynomial p4Level := by
  rintro z ⟨w, hw, rfl⟩
  change ‖q2Polynomial.eval (q2InverseU w)‖ ≤ p4Level
  rw [q2_inverse_eval]
  simpa [p4OutputDisk, Metric.mem_closedBall, dist_zero_right] using hw

theorem q2InverseU_injOn : Set.InjOn q2InverseU p4OutputDisk := by
  intro w₁ hw₁ w₂ hw₂ heq
  have heval := congrArg (fun z : ℂ => q2Polynomial.eval z) heq
  simpa [q2_inverse_eval] using heval

theorem q2UpperRegion_subset_upper_halfplane :
    q2UpperRegion ⊆ {z : ℂ | 0 < z.im} := by
  rintro z ⟨w, hw, rfl⟩
  exact q2_inverse_im_pos_of_output_disk hw

theorem q2LowerRegion_preconnected_of_level {c : ℝ} (hc1 : c ≤ p4Level) :
    IsPreconnected (q2InverseL '' Metric.closedBall (0 : ℂ) c) := by
  have hsmall : ∀ w ∈ Metric.closedBall (0 : ℂ) c,
      w ∈ p4OutputDisk := by
    intro w hw
    apply mem_p4OutputDisk_of_norm_le_level
    have hw' : ‖w‖ ≤ c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    linarith
  have hcont : ContinuousOn q2InverseL (Metric.closedBall (0 : ℂ) c) := by
    intro w hw
    exact (q2_lower_continuousOn_inverse w (hsmall w hw)).mono (by
      intro z hz
      exact hsmall z hz)
  exact (convex_closedBall (0 : ℂ) c).isPreconnected.image
    q2InverseL hcont

theorem q2_upper_component_eq_sublevel_inter_upper
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) :
    connectedComponentIn (q2SublevelSet c) (q2InverseU 0) =
      q2InverseU '' Metric.closedBall (0 : ℂ) c := by
  have hc_lt_one : c < 1 := lt_one_of_le_p4Level hc1
  have hsmall : ∀ w ∈ Metric.closedBall (0 : ℂ) c,
      w ∈ p4OutputDisk := by
    intro w hw
    apply mem_p4OutputDisk_of_norm_le_level
    have hw' : ‖w‖ ≤ c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    linarith
  have hcont : ContinuousOn q2InverseU (Metric.closedBall (0 : ℂ) c) := by
    intro w hw
    exact (q2_continuousOn_inverse w (hsmall w hw)).mono (by
      intro z hz
      exact hsmall z hz)
  have hpre : IsPreconnected
      (q2InverseU '' Metric.closedBall (0 : ℂ) c) :=
    (convex_closedBall (0 : ℂ) c).isPreconnected.image q2InverseU hcont
  have hUS : q2InverseU '' Metric.closedBall (0 : ℂ) c ⊆ q2SublevelSet c := by
    rintro z ⟨w, hw, rfl⟩
    change ‖q2Polynomial.eval (q2InverseU w)‖ ≤ c
    rw [q2_inverse_eval]
    simpa [Metric.mem_closedBall, dist_zero_right] using hw
  have hzero : ∀ z ∈ q2SublevelSet c, z.im ≠ 0 := by
    intro z hz hzim
    have hge := q2_norm_ge_one_of_im_zero hzim
    have hzle : ‖q2Polynomial.eval z‖ ≤ c := hz
    linarith
  have h0disk : (0 : ℂ) ∈ p4OutputDisk := by
    have hzero : ‖(0 : ℂ)‖ ≤ p4Level := by norm_num [p4Level]
    simpa [p4OutputDisk] using hzero
  have hanchor_im : 0 < (q2InverseU 0).im :=
    q2_inverse_im_pos_of_output_disk h0disk
  have hanchorS : q2InverseU 0 ∈ q2SublevelSet c := by
    exact hUS ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩
  have hUtoC : q2InverseU '' Metric.closedBall (0 : ℂ) c ⊆
      connectedComponentIn (q2SublevelSet c) (q2InverseU 0) := by
    apply hpre.subset_connectedComponentIn
      (show q2InverseU 0 ∈ q2InverseU '' Metric.closedBall (0 : ℂ) c from
        ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩)
      hUS
  apply Set.Subset.antisymm
  · intro z hz
    have hsign : ∀ z ∈ connectedComponentIn (q2SublevelSet c) (q2InverseU 0),
        0 < z.im := by
      apply positive_on_preconnected
        (S := connectedComponentIn (q2SublevelSet c) (q2InverseU 0))
        (r := q2InverseU 0) (φ := fun z : ℂ => z.im)
        isPreconnected_connectedComponentIn (by fun_prop)
      · intro u hu hzero'
        exact hzero u (connectedComponentIn_subset (q2SublevelSet c)
          (q2InverseU 0) hu) hzero'
      · exact mem_connectedComponentIn hanchorS
      · exact hanchor_im
    have hzS : z ∈ q2SublevelSet c :=
      connectedComponentIn_subset (q2SublevelSet c) (q2InverseU 0) hz
    rw [q2UpperRegion_eq_sublevel_inter_upper hcpos hc1]
    exact ⟨hzS, hsign z hz⟩
  · exact hUtoC

theorem q2_lower_component_eq_sublevel_inter_lower
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) :
    connectedComponentIn (q2SublevelSet c) (q2InverseL 0) =
      q2InverseL '' Metric.closedBall (0 : ℂ) c := by
  have hc_lt_one : c < 1 := lt_one_of_le_p4Level hc1
  have hsmall : ∀ w ∈ Metric.closedBall (0 : ℂ) c,
      w ∈ p4OutputDisk := by
    intro w hw
    apply mem_p4OutputDisk_of_norm_le_level
    have hw' : ‖w‖ ≤ c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    linarith
  have hcont : ContinuousOn q2InverseL (Metric.closedBall (0 : ℂ) c) := by
    intro w hw
    exact (q2_lower_continuousOn_inverse w (hsmall w hw)).mono (by
      intro z hz
      exact hsmall z hz)
  have hpre : IsPreconnected
      (q2InverseL '' Metric.closedBall (0 : ℂ) c) :=
    (convex_closedBall (0 : ℂ) c).isPreconnected.image q2InverseL hcont
  have hLS : q2InverseL '' Metric.closedBall (0 : ℂ) c ⊆ q2SublevelSet c := by
    rintro z ⟨w, hw, rfl⟩
    change ‖q2Polynomial.eval (q2InverseL w)‖ ≤ c
    rw [q2_inverse_lower_eval]
    simpa [Metric.mem_closedBall, dist_zero_right] using hw
  have hzero : ∀ z ∈ q2SublevelSet c, z.im ≠ 0 := by
    intro z hz hzim
    have hge := q2_norm_ge_one_of_im_zero hzim
    have hzle : ‖q2Polynomial.eval z‖ ≤ c := hz
    linarith
  have h0disk : (0 : ℂ) ∈ p4OutputDisk := by
    have hzero : ‖(0 : ℂ)‖ ≤ p4Level := by norm_num [p4Level]
    simpa [p4OutputDisk] using hzero
  have hanchor_im : (q2InverseL 0).im < 0 :=
    q2_inverse_lower_im_neg_of_output_disk h0disk
  have hanchorS : q2InverseL 0 ∈ q2SublevelSet c := by
    exact hLS ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩
  have hLtoC : q2InverseL '' Metric.closedBall (0 : ℂ) c ⊆
      connectedComponentIn (q2SublevelSet c) (q2InverseL 0) := by
    apply hpre.subset_connectedComponentIn
      (show q2InverseL 0 ∈ q2InverseL '' Metric.closedBall (0 : ℂ) c from
        ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩)
      hLS
  apply Set.Subset.antisymm
  · intro z hz
    have hsign := negative_on_component
      (S := q2SublevelSet c) (r := q2InverseL 0)
      (φ := fun z : ℂ => z.im) (by fun_prop) hzero hanchorS hanchor_im z hz
    have hzS : z ∈ q2SublevelSet c :=
      connectedComponentIn_subset (q2SublevelSet c) (q2InverseL 0) hz
    rw [q2LowerRegion_eq_sublevel_inter_lower hcpos hc1]
    exact ⟨hzS, hsign⟩
  · exact hLtoC

theorem q2_root_eq_one_add_I_of_im_pos {z : ℂ}
    (hz : z ∈ q2Polynomial.rootSet ℂ) (hzpos : 0 < z.im) :
    z = 1 + Complex.I := by
  have hval : q2Polynomial.eval z = 0 := by
    simpa [aeval_def] using q2Polynomial_algebraic_data.1.mem_rootSet.mp hz
  have hre := congrArg Complex.re hval
  have him := congrArg Complex.im hval
  rw [q2Polynomial_eval] at hre him
  norm_num [Complex.mul_re, Complex.mul_im, Complex.sub_re,
    Complex.sub_im, pow_two] at hre him
  have hzre : z.re = 1 := by nlinarith
  have hzim : z.im = 1 := by nlinarith
  apply Complex.ext <;> simp [hzre, hzim]

theorem q2_root_eq_one_sub_I_of_im_neg {z : ℂ}
    (hz : z ∈ q2Polynomial.rootSet ℂ) (hzneg : z.im < 0) :
    z = 1 - Complex.I := by
  have hval : q2Polynomial.eval z = 0 := by
    simpa [aeval_def] using q2Polynomial_algebraic_data.1.mem_rootSet.mp hz
  have hre := congrArg Complex.re hval
  have him := congrArg Complex.im hval
  rw [q2Polynomial_eval] at hre him
  norm_num [Complex.mul_re, Complex.mul_im, Complex.sub_re,
    Complex.sub_im, pow_two] at hre him
  have hzre : z.re = 1 := by nlinarith
  have hzim : z.im = -1 := by nlinarith
  apply Complex.ext <;> simp [hzre, hzim]

theorem evenFamilyUpperAnchor_pow_eq_one_add_I {m : ℕ} (hm : 0 < m) :
    (evenFamilyUpperAnchor m) ^ m = 1 + Complex.I := by
  have hzero : (0 : ℂ) ∈ p4OutputDisk := by
    have hnorm : ‖(0 : ℂ)‖ ≤ p4Level := by norm_num [p4Level]
    simpa [p4OutputDisk] using hnorm
  have hslit : q2InverseU 0 ∈ Complex.slitPlane := by
    rw [Complex.mem_slitPlane_iff]
    right
    exact ne_of_gt (q2_inverse_im_pos_of_output_disk hzero)
  have hroot : q2InverseU 0 ∈ q2Polynomial.rootSet ℂ := by
    apply q2Polynomial_algebraic_data.1.mem_rootSet.mpr
    simpa using q2_inverse_eval 0
  have hq : q2InverseU 0 = 1 + Complex.I :=
    q2_root_eq_one_add_I_of_im_pos hroot
      (q2_inverse_im_pos_of_output_disk hzero)
  rw [show evenFamilyUpperAnchor m =
      Erdos1047EvenFamily.principalRoot m (q2InverseU 0) by rfl]
  rw [Erdos1047EvenFamily.principalRoot_pow hm
    (Complex.slitPlane_ne_zero hslit)]
  exact hq

theorem evenFamilyLowerAnchor_pow_eq_one_sub_I {m : ℕ} (hm : 0 < m) :
    (evenFamilyLowerAnchor m) ^ m = 1 - Complex.I := by
  have hzero : (0 : ℂ) ∈ p4OutputDisk := by
    have hnorm : ‖(0 : ℂ)‖ ≤ p4Level := by norm_num [p4Level]
    simpa [p4OutputDisk] using hnorm
  have hslit : q2InverseL 0 ∈ Complex.slitPlane := by
    rw [Complex.mem_slitPlane_iff]
    right
    exact ne_of_lt (q2_inverse_lower_im_neg_of_output_disk hzero)
  have hroot : q2InverseL 0 ∈ q2Polynomial.rootSet ℂ := by
    apply q2Polynomial_algebraic_data.1.mem_rootSet.mpr
    simpa using q2_inverse_lower_eval 0
  have hq : q2InverseL 0 = 1 - Complex.I :=
    q2_root_eq_one_sub_I_of_im_neg hroot
      (q2_inverse_lower_im_neg_of_output_disk hzero)
  rw [show evenFamilyLowerAnchor m =
      Erdos1047EvenFamily.principalRoot m (q2InverseL 0) by rfl]
  rw [Erdos1047EvenFamily.principalRoot_pow hm
    (Complex.slitPlane_ne_zero hslit)]
  exact hq

theorem evenFamily_attainable_of_upper_anchor_certificate
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : 0 < c) (hc1 : c < 1)
    {a b : ℂ}
    (hcert : Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
      c (evenFamilyUpperAnchor m) a b)) :
    2 * m ∈ attainableNonConvexCounts (2 * m) := by
  apply evenFamily_attainable_of_single_certificate_and_sheet hm hc hc1
  · exact evenFamilyUpperAnchor_mem_rootSet hm
  · exact evenFamilyUpperAnchor_pow_eq_one_add_I hm
  · exact hcert

/-! The analytic provider can work directly with strict inequalities on the two
    joining segments and their midpoint.  Compactness of a segment then
    manufactures the quantitative certificate internally; this keeps the
    remaining even-family obligation in its natural paper-level form. -/
theorem evenFamily_attainable_of_upper_anchor_strict_segments
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : 0 < c) (hc1 : c < 1)
    {a b : ℂ}
    (hA : ∀ z ∈ segment ℝ (evenFamilyUpperAnchor m) a,
      ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ < c)
    (hB : ∀ z ∈ segment ℝ (evenFamilyUpperAnchor m) b,
      ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ < c)
    (hM : c < ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval
      (midpoint ℝ a b)‖) :
    2 * m ∈ attainableNonConvexCounts (2 * m) := by
  have hcert : Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
      c (evenFamilyUpperAnchor m) a b) := by
    apply robustNonconvexCertificate_of_strict
    · fun_prop
    · exact hA
    · exact hB
    · exact hM
  exact evenFamily_attainable_of_upper_anchor_certificate hm hc hc1 hcert

/-! Pull strict norm estimates back through the two q₂ inverse branches.  These
    adapters are useful when a future sector proof tracks the powered point
    `z^m` rather than expanding the even-family polynomial on the segment. -/
theorem evenFamily_norm_eval_lt_of_pow_eq_upper_inverse
    {m : ℕ} {c : ℝ} {z w : ℂ}
    (hw : ‖w‖ < c) (hz : z ^ m = q2InverseU w) :
    ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ < c := by
  calc
    ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ =
        ‖q2Polynomial.eval (z ^ m)‖ := by
          rw [q2Polynomial_eval, Erdos1047EvenFamily.evenFamily_eval]
    _ = ‖q2Polynomial.eval (q2InverseU w)‖ := by rw [hz]
    _ = ‖w‖ := by rw [q2_inverse_eval]
    _ < c := hw

theorem evenFamily_norm_eval_lt_of_pow_eq_lower_inverse
    {m : ℕ} {c : ℝ} {z w : ℂ}
    (hw : ‖w‖ < c) (hz : z ^ m = q2InverseL w) :
    ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ < c := by
  calc
    ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ =
        ‖q2Polynomial.eval (z ^ m)‖ := by
          rw [q2Polynomial_eval, Erdos1047EvenFamily.evenFamily_eval]
    _ = ‖q2Polynomial.eval (q2InverseL w)‖ := by rw [hz]
    _ = ‖w‖ := by rw [q2_inverse_lower_eval]
    _ < c := hw

theorem lt_norm_evenFamily_eval_of_pow_eq_upper_inverse
    {m : ℕ} {c : ℝ} {z w : ℂ}
    (hw : c < ‖w‖) (hz : z ^ m = q2InverseU w) :
    c < ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ := by
  rw [show ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ =
      ‖q2Polynomial.eval (z ^ m)‖ by
        rw [q2Polynomial_eval, Erdos1047EvenFamily.evenFamily_eval]]
  rw [hz, q2_inverse_eval]
  exact hw

theorem lt_norm_evenFamily_eval_of_pow_eq_lower_inverse
    {m : ℕ} {c : ℝ} {z w : ℂ}
    (hw : c < ‖w‖) (hz : z ^ m = q2InverseL w) :
    c < ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ := by
  rw [show ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ =
      ‖q2Polynomial.eval (z ^ m)‖ by
        rw [q2Polynomial_eval, Erdos1047EvenFamily.evenFamily_eval]]
  rw [hz, q2_inverse_lower_eval]
  exact hw

theorem q2_root_component_injOn
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) :
    Set.InjOn (fun z : ℂ => connectedComponentIn (q2SublevelSet c) z)
      (↑(q2Polynomial.rootSet ℂ) : Set ℂ) := by
  have hc_lt_one : c < 1 := lt_one_of_le_p4Level hc1
  intro r hr s hs hrs
  change connectedComponentIn (q2SublevelSet c) r =
    connectedComponentIn (q2SublevelSet c) s at hrs
  have hroot : ∀ {z : ℂ}, z ∈ q2Polynomial.rootSet ℂ →
      q2Polynomial.eval z = 0 := by
    intro z hz
    simpa [aeval_def] using q2Polynomial_algebraic_data.1.mem_rootSet.mp hz
  have hrS : r ∈ q2SublevelSet c := by
    change ‖q2Polynomial.eval r‖ ≤ c
    rw [hroot hr, norm_zero]
    exact hcpos.le
  have hsS : s ∈ q2SublevelSet c := by
    change ‖q2Polynomial.eval s‖ ≤ c
    rw [hroot hs, norm_zero]
    exact hcpos.le
  have hzero : ∀ z ∈ q2SublevelSet c, z.im ≠ 0 := by
    intro z hz hzim
    have hge := q2_norm_ge_one_of_im_zero hzim
    have hzle : ‖q2Polynomial.eval z‖ ≤ c := hz
    linarith
  have hrne : r.im ≠ 0 := hzero r hrS
  have hsne : s.im ≠ 0 := hzero s hsS
  rcases lt_or_gt_of_ne hrne with hrneg | hrpos
  · rcases lt_or_gt_of_ne hsne with hsneg | hspos
    · exact (q2_root_eq_one_sub_I_of_im_neg hr hrneg).trans
        (q2_root_eq_one_sub_I_of_im_neg hs hsneg).symm
    · exfalso
      exact (connectedComponentIn_ne_of_separator_sign
        (S := q2SublevelSet c) (r := s) (s := r)
        (φ := fun z : ℂ => z.im) (by fun_prop) hzero hsS hrS hspos hrneg) hrs.symm
  · rcases lt_or_gt_of_ne hsne with hsneg | hspos
    · exfalso
      exact (connectedComponentIn_ne_of_separator_sign
        (S := q2SublevelSet c) (r := r) (s := s)
        (φ := fun z : ℂ => z.im) (by fun_prop) hzero hrS hsS hrpos hsneg) hrs
    · exact (q2_root_eq_one_add_I_of_im_pos hr hrpos).trans
        (q2_root_eq_one_add_I_of_im_pos hs hspos).symm

theorem q2_componentsIn_ncard_eq_two
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) :
    (componentsIn (q2SublevelSet c)).ncard = 2 := by
  change (componentsIn (sublevelSet q2Polynomial c)).ncard = 2
  have hc_lt_one : c < 1 := by
    have hp4 : p4Level < 1 := by norm_num [p4Level]
    linarith
  have hcount := componentsIn_ncard_eq_rootSet_ncard_of_regular_values_of_root_injOn
    (f := q2Polynomial) q2Polynomial_algebraic_data.1 hcpos.le (by
      rw [q2Polynomial_eq_evenFamily_one]
      exact evenFamily_closedBall_subset_regular_values_of_lt_one (m := 1)
        (by omega) hc_lt_one)
      (q2_root_component_injOn hcpos hc1)
  calc
    (componentsIn (sublevelSet q2Polynomial c)).ncard =
        (q2Polynomial.rootSet ℂ).ncard := hcount
    _ = 2 := q2Polynomial_algebraic_data.2.2.2

theorem p4_quadrant_preconnected : IsPreconnected p4QuadrantUR := by
  rw [p4_quadrant_eq_image]
  exact (convex_closedBall (0 : ℂ) p4Level).isPreconnected.image
    p4InverseUR p4_continuousOn_inverse

/-- The right-upper component is exactly the right-upper quadrant slice. -/
theorem p4_anchor_component_eq_quadrant :
    connectedComponentIn (sublevelSet p4Polynomial p4Level) p4Anchor = p4QuadrantUR := by
  have hanchorK : p4Anchor ∈ sublevelSet p4Polynomial p4Level :=
    p4_lineA_subset (left_mem_segment ℝ p4Anchor p4PointA)
  have hre : 0 < p4Anchor.re := by norm_num [p4Anchor]
  have him : 0 < p4Anchor.im := by norm_num [p4Anchor]
  apply Set.Subset.antisymm
  · intro z hz
    exact ⟨connectedComponentIn_subset _ _ hz,
      p4_component_re_pos p4Anchor hanchorK hre z hz,
      p4_component_im_pos p4Anchor hanchorK him z hz⟩
  · exact p4_quadrant_preconnected.subset_connectedComponentIn
      (show p4Anchor ∈ p4QuadrantUR from ⟨hanchorK, hre, him⟩)
      (by intro z hz; exact hz.1)

/-! The inverse branch at the regular value `0` supplies an actual quartic root
    in the same quadrant.  This closes the small but important bookkeeping gap
    between the concrete rational certificate (anchored at `p4Anchor`) and the
    root-anchored interface used by the even-family lifting lemmas. -/
def p4RootUR : ℂ := p4InverseUR 0

theorem p4RootUR_mem_and_signs :
    p4RootUR ∈ sublevelSet p4Polynomial p4Level ∧
      0 < p4RootUR.re ∧ 0 < p4RootUR.im := by
  have hzero : (0 : ℂ) ∈ p4OutputDisk := by
    have hnorm : ‖(0 : ℂ)‖ ≤ p4Level := by norm_num [p4Level]
    simpa [p4OutputDisk] using hnorm
  simpa [p4RootUR] using (p4_inverse_mem_and_signs (0 : ℂ) hzero)

theorem p4RootUR_mem_rootSet : p4RootUR ∈ p4Polynomial.rootSet ℂ := by
  apply p4Polynomial_monic.mem_rootSet.mpr
  simpa [p4RootUR] using (p4_inverse_eval (0 : ℂ))

theorem p4RootUR_component_eq_quadrant :
    connectedComponentIn (sublevelSet p4Polynomial p4Level) p4RootUR = p4QuadrantUR := by
  have hr := p4RootUR_mem_and_signs
  apply Set.Subset.antisymm
  · intro z hz
    exact ⟨connectedComponentIn_subset _ _ hz,
      p4_component_re_pos p4RootUR hr.1 hr.2.1 z hz,
      p4_component_im_pos p4RootUR hr.1 hr.2.2 z hz⟩
  · exact p4_quadrant_preconnected.subset_connectedComponentIn
      (show p4RootUR ∈ p4QuadrantUR from ⟨hr.1, hr.2.1, hr.2.2⟩)
      (by intro z hz; exact hz.1)

theorem p4RootUR_component_not_convex :
    ¬ Convex ℝ
      (connectedComponentIn (sublevelSet p4Polynomial p4Level) p4RootUR) := by
  rw [p4RootUR_component_eq_quadrant, ← p4_anchor_component_eq_quadrant]
  exact p4_component_not_convex

/-! For `m = 2`, the even-family principal-root anchor is literally this
    quartic root.  The proof uses only the square identity for `principalRoot`
    and positivity of the real parts, so it is independent of any unproved
    sector-exhaustion claim. -/
theorem evenFamilyUpperAnchor_two_eq_p4RootUR :
    evenFamilyUpperAnchor 2 = p4RootUR := by
  have hr := p4RootUR_mem_and_signs
  have hr0 : p4RootUR ≠ 0 := by
    intro h
    rw [h] at hr
    norm_num at hr
  have hzim : 0 < (p4RootUR ^ 2).im := by
    norm_num [pow_two, Complex.mul_im]
    nlinarith [hr.2.1, hr.2.2]
  have ha_re : 0 <
      (Erdos1047EvenFamily.principalRoot 2 (p4RootUR ^ 2)).re :=
    Erdos1047EvenFamily.principalRoot_re_pos_of_im_pos_of_two_le
      (by norm_num) hzim
  have hr_re : 0 < p4RootUR.re := hr.2.1
  have hpow := Erdos1047EvenFamily.principalRoot_pow (m := 2)
    (by norm_num) (pow_ne_zero 2 hr0)
  have hmul :
      ((Erdos1047EvenFamily.principalRoot 2 (p4RootUR ^ 2)) - p4RootUR) *
        ((Erdos1047EvenFamily.principalRoot 2 (p4RootUR ^ 2)) + p4RootUR) = 0 := by
    calc
      _ = (Erdos1047EvenFamily.principalRoot 2 (p4RootUR ^ 2)) ^ 2 -
          p4RootUR ^ 2 := by ring
      _ = 0 := sub_eq_zero.mpr hpow
  have hsum_ne :
      (Erdos1047EvenFamily.principalRoot 2 (p4RootUR ^ 2)) + p4RootUR ≠ 0 := by
    intro hsum
    have hre := congrArg Complex.re hsum
    simp only [Complex.add_re] at hre
    norm_num at hre
    linarith
  have hdiff :
      Erdos1047EvenFamily.principalRoot 2 (p4RootUR ^ 2) - p4RootUR = 0 := by
    rcases mul_eq_zero.mp hmul with h | h
    · exact h
    · exact False.elim (hsum_ne h)
  have hroot :
      Erdos1047EvenFamily.principalRoot 2 (p4RootUR ^ 2) = p4RootUR :=
    sub_eq_zero.mp hdiff
  simpa [evenFamilyUpperAnchor, q2InverseU, p4RootUR] using hroot

theorem evenFamilyUpperAnchor_two_component_not_convex :
    ¬ Convex ℝ
      (connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial 2) p4Level)
        (evenFamilyUpperAnchor 2)) := by
  rw [evenFamilyUpperAnchor_two_eq_p4RootUR]
  simpa [p4Polynomial, Erdos1047EvenFamily.evenFamilyPolynomial] using
    p4RootUR_component_not_convex

def p4RegionLR : Set ℂ := star '' p4QuadrantUR
def p4RegionLL : Set ℂ := (fun z : ℂ ↦ -z) '' p4QuadrantUR
def p4RegionUL : Set ℂ := (fun z : ℂ ↦ -star z) '' p4QuadrantUR

theorem p4_regionLR_preconnected : IsPreconnected p4RegionLR := by
  exact p4_quadrant_preconnected.image _ (by fun_prop)

theorem p4_regionLL_preconnected : IsPreconnected p4RegionLL := by
  exact p4_quadrant_preconnected.image _ (by fun_prop)

theorem p4_regionUL_preconnected : IsPreconnected p4RegionUL := by
  exact p4_quadrant_preconnected.image _ (by fun_prop)

theorem p4_quadrant_subset : p4QuadrantUR ⊆ sublevelSet p4Polynomial p4Level :=
  fun _ hz ↦ hz.1

theorem p4_regionLR_subset : p4RegionLR ⊆ sublevelSet p4Polynomial p4Level := by
  rintro _ ⟨z, hz, rfl⟩
  exact (p4_mem_star_iff z).2 hz.1

theorem p4_regionLL_subset : p4RegionLL ⊆ sublevelSet p4Polynomial p4Level := by
  rintro _ ⟨z, hz, rfl⟩
  exact (p4_mem_neg_iff z).2 hz.1

theorem p4_regionUL_subset : p4RegionUL ⊆ sublevelSet p4Polynomial p4Level := by
  rintro _ ⟨z, hz, rfl⟩
  exact (p4_mem_neg_iff (star z)).2 ((p4_mem_star_iff z).2 hz.1)

theorem p4_mem_region_cases (z : ℂ) (hz : z ∈ sublevelSet p4Polynomial p4Level) :
    z ∈ p4QuadrantUR ∨ z ∈ p4RegionLR ∨ z ∈ p4RegionLL ∨ z ∈ p4RegionUL := by
  have hre0 : z.re ≠ 0 := fun h ↦ p4_not_mem_of_re_zero z h hz
  have him0 : z.im ≠ 0 := fun h ↦ p4_not_mem_of_im_zero z h hz
  rcases lt_or_gt_of_ne hre0 with hre | hre <;>
    rcases lt_or_gt_of_ne him0 with him | him
  · right; right; left
    refine ⟨-z, ?_, by simp⟩
    exact ⟨(p4_mem_neg_iff z).2 hz, by simp; linarith, by simp; linarith⟩
  · right; right; right
    refine ⟨-star z, ?_, by simp⟩
    exact ⟨(p4_mem_neg_iff (star z)).2 ((p4_mem_star_iff z).2 hz),
      by simp; linarith, by simp; linarith⟩
  · right; left
    refine ⟨star z, ?_, by simp⟩
    exact ⟨(p4_mem_star_iff z).2 hz, by simp; linarith, by simp; linarith⟩
  · left
    exact ⟨hz, hre, him⟩

/-- The component set is exactly the four symmetry-related components. -/
theorem p4_componentsIn_eq_four :
    componentsIn (sublevelSet p4Polynomial p4Level) =
      { connectedComponentIn (sublevelSet p4Polynomial p4Level) p4Anchor,
        connectedComponentIn (sublevelSet p4Polynomial p4Level) (star p4Anchor),
        connectedComponentIn (sublevelSet p4Polynomial p4Level) (-p4Anchor),
        connectedComponentIn (sublevelSet p4Polynomial p4Level) (-star p4Anchor) } := by
  let K := sublevelSet p4Polynomial p4Level
  have h0K : p4Anchor ∈ K :=
    p4_lineA_subset (left_mem_segment ℝ p4Anchor p4PointA)
  have h1K : star p4Anchor ∈ K := (p4_mem_star_iff p4Anchor).2 h0K
  have h2K : -p4Anchor ∈ K := (p4_mem_neg_iff p4Anchor).2 h0K
  have h3K : -star p4Anchor ∈ K := (p4_mem_neg_iff (star p4Anchor)).2 h1K
  have h0R : p4Anchor ∈ p4QuadrantUR := by
    exact ⟨h0K, by norm_num [p4Anchor], by norm_num [p4Anchor]⟩
  have h1R : star p4Anchor ∈ p4RegionLR := ⟨p4Anchor, h0R, rfl⟩
  have h2R : -p4Anchor ∈ p4RegionLL := ⟨p4Anchor, h0R, rfl⟩
  have h3R : -star p4Anchor ∈ p4RegionUL := ⟨p4Anchor, h0R, rfl⟩
  ext t
  constructor
  · rintro ⟨z, hz, rfl⟩
    rcases p4_mem_region_cases z hz with hz0 | hz1 | hz2 | hz3
    · left
      exact connectedComponentIn_eq
        (p4_quadrant_preconnected.subset_connectedComponentIn hz0 p4_quadrant_subset h0R)
    · right; left
      exact connectedComponentIn_eq
        (p4_regionLR_preconnected.subset_connectedComponentIn hz1 p4_regionLR_subset h1R)
    · right; right; left
      exact connectedComponentIn_eq
        (p4_regionLL_preconnected.subset_connectedComponentIn hz2 p4_regionLL_subset h2R)
    · right; right; right
      exact connectedComponentIn_eq
        (p4_regionUL_preconnected.subset_connectedComponentIn hz3 p4_regionUL_subset h3R)
  · intro ht
    rcases ht with (rfl | rfl | rfl | rfl)
    · exact ⟨p4Anchor, h0K, rfl⟩
    · exact ⟨star p4Anchor, h1K, rfl⟩
    · exact ⟨-p4Anchor, h2K, rfl⟩
    · exact ⟨-star p4Anchor, h3K, rfl⟩

/-! Every quartic root is now covered by one of the four explicitly certified
    components.  This is the root-wise form of the quartic non-convexity result
    needed by the generic even-family attainment wrapper. -/
theorem p4_all_root_components_not_convex :
    ∀ z ∈ (↑(p4Polynomial.rootSet ℂ) : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet p4Polynomial p4Level) z) := by
  intro z hz
  have hzK : z ∈ sublevelSet p4Polynomial p4Level := by
    change ‖p4Polynomial.eval z‖ ≤ p4Level
    have hz0 : p4Polynomial.eval z = 0 :=
      p4Polynomial_monic.mem_rootSet.mp hz
    rw [hz0, norm_zero]
    norm_num [p4Level]
  have hzC : connectedComponentIn
      (sublevelSet p4Polynomial p4Level) z ∈
      componentsIn (sublevelSet p4Polynomial p4Level) :=
    ⟨z, hzK, rfl⟩
  rw [p4_componentsIn_eq_four] at hzC
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hzC
  rcases hzC with h0 | h1 | h2 | h3
  · rw [h0]
    exact p4_component_not_convex
  · rw [h1]
    exact p4_star_component_not_convex
  · rw [h2]
    exact p4_neg_component_not_convex
  · rw [h3]
    exact p4_neg_star_component_not_convex

theorem evenFamily_two_all_root_components_not_convex :
    ∀ z ∈
      (↑((Erdos1047EvenFamily.evenFamilyPolynomial 2).rootSet ℂ) : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial 2) p4Level) z) := by
  intro z hz
  have hz' : z ∈ (↑(p4Polynomial.rootSet ℂ) : Set ℂ) := by
    simpa [p4Polynomial, Erdos1047EvenFamily.evenFamilyPolynomial] using hz
  have h := p4_all_root_components_not_convex z hz'
  simpa [p4Polynomial, Erdos1047EvenFamily.evenFamilyPolynomial] using h

theorem evenFamily_two_attainable_via_root_components :
    4 ∈ attainableNonConvexCounts 4 := by
  apply evenFamily_attainable_of_sheet_and_nonconvex (m := 2) (c := p4Level)
  · norm_num
  · norm_num [p4Level]
  · norm_num [p4Level]
  · exact evenFamily_two_all_root_components_not_convex

theorem p4_componentsIn_ncard :
    (componentsIn (sublevelSet p4Polynomial p4Level)).ncard = 4 := by
  rw [p4_componentsIn_eq_four]
  let K := sublevelSet p4Polynomial p4Level
  let C0 := connectedComponentIn K p4Anchor
  let C1 := connectedComponentIn K (star p4Anchor)
  let C2 := connectedComponentIn K (-p4Anchor)
  let C3 := connectedComponentIn K (-star p4Anchor)
  change ({C0, C1, C2, C3} : Set (Set ℂ)).ncard = 4
  obtain ⟨h01, h02, h03, h12, h13, h23⟩ := p4_four_components_pairwise_distinct
  change C0 ≠ C1 at h01
  change C0 ≠ C2 at h02
  change C0 ≠ C3 at h03
  change C1 ≠ C2 at h12
  change C1 ≠ C3 at h13
  change C2 ≠ C3 at h23
  rw [Set.ncard_insert_of_notMem (by simp [h01, h02, h03])]
  rw [Set.ncard_insert_of_notMem (by simp [h12, h13])]
  rw [Set.ncard_insert_of_notMem (by simp [h23])]
  simp

/-- Fully verified degree-four attainment, with no remaining assumptions. -/
theorem four_attainable : 4 ∈ attainableNonConvexCounts 4 :=
  four_attainable_of_p4_components_ncard p4_componentsIn_ncard

/-! The quartic witness can likewise be consumed by the generic even-family
    count-only interface. -/
theorem evenFamily_two_attainable_via_count :
    4 ∈ attainableNonConvexCounts 4 := by
  apply evenFamily_attainable_of_nonconvex_count (m := 2) (c := p4Level) (by norm_num)
    (by norm_num [p4Level]) (by norm_num [p4Level])
  simpa [p4Polynomial, Erdos1047EvenFamily.evenFamilyPolynomial] using
    (p4_nonconvex_ncard_of_components_ncard p4_componentsIn_ncard)

/-- The full greatest-element conclusion is complete in degree four. -/
theorem max_nonconvex_four : IsGreatest (attainableNonConvexCounts 4) 4 :=
  ⟨four_attainable, fun _ hk ↦ attainable_le_degree (by norm_num) hk⟩

/-- Polynomial certificate replacing the Stieltjes integral for the pointwise sign estimate. -/
theorem cubic_ratio_re_lt_one (z B : ℂ) (hu : z.re < -1)
    (hT : 0 < 3 * z.re ^ 2 - z.im ^ 2 - 3) (hB : 0 ≤ B.re)
    (hlevel : Complex.normSq (z ^ 3 - 3 * z + B) ≤ Complex.normSq (B - 2)) :
    (2 * z * (z ^ 3 - 3 * z + B) / (z ^ 2 - 1) ^ 2).re < 1 := by
  let T := 3 * z.re ^ 2 - z.im ^ 2 - 3
  let D := (z ^ 2 - 1) ^ 2
  let P := T * (z.re ^ 2 + z.im ^ 2 - 1) + 4 * (z.re ^ 2 - 1)
  let A := ((z.re - 1) ^ 2 + z.im ^ 2) ^ 2
  let N := (2 * z * (z ^ 3 - 3 * z + B)).re * D.re +
    (2 * z * (z ^ 3 - 3 * z + B)).im * D.im
  have hu2 : 1 < z.re ^ 2 := by nlinarith
  have hP : 0 ≤ P := by
    dsimp [P]
    have h1 : 0 ≤ z.re ^ 2 + z.im ^ 2 - 1 := by nlinarith [sq_nonneg z.im]
    have h2 : 0 ≤ z.re ^ 2 - 1 := by linarith
    exact add_nonneg (mul_nonneg hT.le h1) (mul_nonneg (by norm_num) h2)
  have hD0 : D ≠ 0 := by
    dsimp [D]
    apply pow_ne_zero
    intro he
    have he' : z ^ 2 = 1 := sub_eq_zero.mp he
    rcases (sq_eq_one_iff).mp he' with he' | he' <;> simp_all
  have hD : 0 < Complex.normSq D := Complex.normSq_pos.mpr hD0
  have hidentity :
      T * (Complex.normSq D - N) =
        Complex.normSq D - 4 * (z.re + 1) * A * B.re +
          P * (Complex.normSq (B - 2) - Complex.normSq (z ^ 3 - 3 * z + B)) := by
    dsimp [T, D, N, A, P]
    norm_num [Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
    ring
  have hpositive : 0 < T * (Complex.normSq D - N) := by
    rw [hidentity]
    have hterm : 0 ≤ -(4 * (z.re + 1) * A * B.re) := by
      have : 4 * (z.re + 1) * A * B.re ≤ 0 :=
        mul_nonpos_of_nonpos_of_nonneg
          (mul_nonpos_of_nonpos_of_nonneg
            (mul_nonpos_of_nonneg_of_nonpos (by norm_num) (by linarith))
            (sq_nonneg _)) hB
      linarith
    have hslack := mul_nonneg hP (sub_nonneg.mpr hlevel)
    linarith
  have hN : N < Complex.normSq D := by
    dsimp [T] at hpositive
    nlinarith
  change (2 * z * (z ^ 3 - 3 * z + B) / D).re < 1
  rw [Complex.div_re, ← add_div]
  exact (div_lt_one hD).mpr hN



noncomputable def cubicPolynomial (B : ℂ) : ℂ[X] :=
  Polynomial.X ^ 3 - Polynomial.C 3 * Polynomial.X + Polynomial.C B

/-! Explicit critical-threshold reduction for the centered cubic.  Once the
    missing analytic lemma supplies a collision of two root branches at or
    above `‖B-2‖`, the component-count hypothesis immediately forces the
    strict subcritical inequality. -/
theorem cubic_three_components_forces_subcritical_of_collision
    {B : ℂ} {c : ℝ}
    (hcount : (componentsIn (sublevelSet (cubicPolynomial B) c)).ncard = 3)
    (hroot : ((cubicPolynomial B).rootSet ℂ).ncard = 3)
    (himage : componentsIn (sublevelSet (cubicPolynomial B) c) =
      (fun r : ℂ ↦ connectedComponentIn
        (sublevelSet (cubicPolynomial B) c) r) ''
        (↑((cubicPolynomial B).rootSet ℂ) : Set ℂ))
    (hcollision : Complex.normSq (B - 2) ≤ c ^ 2 →
      ∃ r ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ s ∈ (cubicPolynomial B).rootSet ℂ, r ≠ s ∧
        connectedComponentIn (sublevelSet (cubicPolynomial B) c) r =
          connectedComponentIn (sublevelSet (cubicPolynomial B) c) s) :
    c ^ 2 < Complex.normSq (B - 2) := by
  by_contra hnot
  have hge : Complex.normSq (B - 2) ≤ c ^ 2 := le_of_not_gt hnot
  have hlt := componentsIn_ncard_lt_of_root_collision
    (fun r : ℂ ↦ connectedComponentIn
      (sublevelSet (cubicPolynomial B) c) r) himage
      ((cubicPolynomial B).rootSet_finite ℂ) (hcollision hge)
  rw [hcount, hroot] at hlt
  omega

/-- The algebraic estimate is about the actual first and second polynomial derivatives. -/
theorem cubic_curvature_gt_two_thirds (z B : ℂ) (hu : z.re < -1)
    (hT : 0 < 3 * z.re ^ 2 - z.im ^ 2 - 3) (hB : 0 ≤ B.re)
    (hlevel : Complex.normSq (z ^ 3 - 3 * z + B) ≤ Complex.normSq (B - 2)) :
    (2 / 3 : ℝ) <
      (1 - (cubicPolynomial B).eval z * (cubicPolynomial B).derivative.derivative.eval z /
        ((cubicPolynomial B).derivative.eval z) ^ 2).re := by
  have hr := cubic_ratio_re_lt_one z B hu hT hB hlevel
  have he : (z ^ 3 - 3 * z + B) * (6 * z) / (3 * z ^ 2 - 3) ^ 2 =
      (2 * z * (z ^ 3 - 3 * z + B) / (z ^ 2 - 1) ^ 2) / 3 := by
    rw [show 3 * z ^ 2 - 3 = 3 * (z ^ 2 - 1) by ring, mul_pow, div_mul_eq_div_div]
    ring
  have hder : (1 - (cubicPolynomial B).eval z *
      (cubicPolynomial B).derivative.derivative.eval z /
      ((cubicPolynomial B).derivative.eval z) ^ 2 : ℂ) =
      1 - (z ^ 3 - 3 * z + B) * (6 * z) / (3 * z ^ 2 - 3) ^ 2 := by
    norm_num [cubicPolynomial]
    ring
  rw [hder, he]
  norm_num [Complex.div_re] at hr ⊢
  linarith

/- The core calculus interface uses the explicit centered-cubic expression;
   this bridge exposes the verified curvature estimate in that form. -/
theorem cubic_ratio_positive_of_left_subcritical (z B : ℂ) (hu : z.re < -1)
    (hT : 0 < 3 * z.re ^ 2 - z.im ^ 2 - 3) (hB : 0 ≤ B.re)
    (hlevel : Complex.normSq (z ^ 3 - 3 * z + B) ≤
      Complex.normSq (B - 2)) :
    0 < (1 - Erdos1047CubicBarrier.cubicValue B z * (6 * z) /
      (3 * (z ^ 2 - 1)) ^ 2).re := by
  have h := cubic_curvature_gt_two_thirds z B hu hT hB hlevel
  have he : Erdos1047CubicBarrier.cubicValue B z * (6 * z) /
      (3 * (z ^ 2 - 1)) ^ 2 =
      (cubicPolynomial B).eval z * (cubicPolynomial B).derivative.derivative.eval z /
        ((cubicPolynomial B).derivative.eval z) ^ 2 := by
    norm_num [cubicPolynomial, Erdos1047CubicBarrier.cubicValue]
    ring
  rw [he] at ⊢
  norm_num at h ⊢
  linarith

theorem nonconvexComponents_eq_empty_of_convex {S : Set ℂ} (hS : Convex ℝ S) :
    {t ∈ Erdos1047.componentsIn S | ¬ Convex ℝ t} = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.mpr
  rintro t ⟨⟨z, hz, rfl⟩, ht⟩
  exact ht (by rwa [hS.isPreconnected.connectedComponentIn hz])

theorem componentsIn_eq_singleton_of_isPreconnected {S : Set ℂ}
    (hS : IsPreconnected S) (hne : S.Nonempty) : Erdos1047.componentsIn S = {S} := by
  ext t
  constructor
  · rintro ⟨z, hz, rfl⟩
    simpa using hS.connectedComponentIn hz
  · intro ht
    obtain ⟨z, hz⟩ := hne
    exact ⟨z, hz, (Set.mem_singleton_iff.mp ht).trans (hS.connectedComponentIn hz).symm⟩

/- ## Quadratic normal form and the critical-level split -/

/-- The centered normal form used for the degree-two upper bound. -/
def quadraticCenteredSublevel (q : ℂ) (c : ℝ) : Set ℂ :=
  {z | ‖z ^ 2 + q‖ ≤ c}

/-- Above the modulus of the unique critical value, a centered quadratic sublevel set
is star-convex about its critical point.  The identity used in the proof is
`(bz)² + q = b²(z² + q) + (1-b²)q`. -/
theorem quadraticCenteredSublevel_starConvex (q : ℂ) (c : ℝ) (hq : ‖q‖ ≤ c) :
    StarConvex ℝ 0 (quadraticCenteredSublevel q c) := by
  intro z hz a b ha hb hab
  change ‖(a • (0 : ℂ) + b • z) ^ 2 + q‖ ≤ c
  rw [smul_zero, zero_add]
  have hb1 : b ≤ 1 := by linarith
  have hb2 : 0 ≤ b ^ 2 := sq_nonneg b
  have hb2one : b ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg ha (sub_nonneg.mpr hb1)]
  have hid : (b • z) ^ 2 + q =
      (b ^ 2) • (z ^ 2 + q) + (1 - b ^ 2) • q := by
    simp only [Complex.real_smul]
    push_cast
    ring
  rw [hid]
  calc
    ‖(b ^ 2) • (z ^ 2 + q) + (1 - b ^ 2) • q‖ ≤
        ‖(b ^ 2) • (z ^ 2 + q)‖ + ‖(1 - b ^ 2) • q‖ := norm_add_le _ _
    _ = b ^ 2 * ‖z ^ 2 + q‖ + (1 - b ^ 2) * ‖q‖ := by
      rw [norm_smul, norm_smul]
      simp [abs_of_nonneg (sub_nonneg.mpr hb2one)]
    _ ≤ b ^ 2 * c + (1 - b ^ 2) * c :=
      add_le_add (mul_le_mul_of_nonneg_left hz hb2)
        (mul_le_mul_of_nonneg_left hq (sub_nonneg.mpr hb2one))
    _ = c := by ring

/-- Coefficient expansion of a monic quadratic. -/
theorem monic_quadratic_eq (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) :
    f = X ^ 2 + C (f.coeff 1) * X + C (f.coeff 0) := by
  conv_lhs =>
    rw [f.as_sum_range_C_mul_X_pow, hdeg, Finset.sum_range_succ, Finset.sum_range_succ,
      Finset.sum_range_one, ← hdeg, hf.coeff_natDegree, hdeg]
  simp only [C_1]
  ring

/-- Critical point of a monic quadratic. -/
def quadraticCenter (f : ℂ[X]) : ℂ := -(f.coeff 1) / 2

/-- Value of a monic quadratic at its critical point. -/
def quadraticCriticalValue (f : ℂ[X]) : ℂ :=
  f.coeff 0 - (f.coeff 1) ^ 2 / 4

theorem monic_quadratic_eval_center_add (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (z : ℂ) :
    f.eval (quadraticCenter f + z) = z ^ 2 + quadraticCriticalValue f := by
  rw [monic_quadratic_eq f hf hdeg]
  simp [quadraticCenter, quadraticCriticalValue]
  ring

theorem monic_quadratic_sublevel_eq (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) :
    sublevelSet f c =
      (fun z => quadraticCenter f + z) '' quadraticCenteredSublevel (quadraticCriticalValue f) c := by
  ext z
  constructor
  · intro hz
    change ‖f.eval z‖ ≤ c at hz
    refine ⟨z - quadraticCenter f, ?_, by ring⟩
    change ‖(z - quadraticCenter f) ^ 2 + quadraticCriticalValue f‖ ≤ c
    rw [← monic_quadratic_eval_center_add f hf hdeg (z - quadraticCenter f)]
    simpa only [add_sub_cancel] using hz
  · rintro ⟨w, hw, rfl⟩
    change ‖w ^ 2 + quadraticCriticalValue f‖ ≤ c at hw
    change ‖f.eval (quadraticCenter f + w)‖ ≤ c
    rw [monic_quadratic_eval_center_add f hf hdeg]
    exact hw

theorem monic_quadratic_sublevel_starConvex (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) (hc : ‖quadraticCriticalValue f‖ ≤ c) :
    StarConvex ℝ (quadraticCenter f) (sublevelSet f c) := by
  rw [monic_quadratic_sublevel_eq f hf hdeg c]
  simpa using
    (quadraticCenteredSublevel_starConvex (quadraticCriticalValue f) c hc).add_left
      (quadraticCenter f)

theorem monic_quadratic_center_mem_sublevel (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) (hc : ‖quadraticCriticalValue f‖ ≤ c) :
    quadraticCenter f ∈ sublevelSet f c := by
  change ‖f.eval (quadraticCenter f)‖ ≤ c
  have he := monic_quadratic_eval_center_add f hf hdeg 0
  have heval : f.eval (quadraticCenter f) = quadraticCriticalValue f := by simpa using he
  rw [heval]
  exact hc

theorem monic_quadratic_sublevel_isPreconnected (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) (hc : ‖quadraticCriticalValue f‖ ≤ c) :
    IsPreconnected (sublevelSet f c) :=
  (((monic_quadratic_sublevel_starConvex f hf hdeg c hc).isPathConnected
    (monic_quadratic_center_mem_sublevel f hf hdeg c hc)).isConnected).isPreconnected

theorem monic_quadratic_components_ncard_eq_one (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) (hc : ‖quadraticCriticalValue f‖ ≤ c) :
    (componentsIn (sublevelSet f c)).ncard = 1 := by
  rw [componentsIn_eq_singleton_of_isPreconnected
    (monic_quadratic_sublevel_isPreconnected f hf hdeg c hc)
    ⟨quadraticCenter f, monic_quadratic_center_mem_sublevel f hf hdeg c hc⟩]
  simp

theorem monic_quadratic_derivative (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) :
    f.derivative = C 2 * X + C (f.coeff 1) := by
  rw [monic_quadratic_eq f hf hdeg]
  norm_num

theorem monic_quadratic_separable_iff (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) :
    f.Separable ↔ quadraticCriticalValue f ≠ 0 := by
  rw [Polynomial.separable_def,
    Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed (k := ℂ) ℂ f f.derivative]
  change (∀ z : ℂ, f.eval z ≠ 0 ∨ f.derivative.eval z ≠ 0) ↔
    quadraticCriticalValue f ≠ 0
  constructor
  · intro hsep hq
    have heval := monic_quadratic_eval_center_add f hf hdeg 0
    have hroot : f.eval (quadraticCenter f) = 0 := by simpa [hq] using heval
    have hder : f.derivative.eval (quadraticCenter f) = 0 := by
      rw [monic_quadratic_derivative f hf hdeg]
      simp [quadraticCenter]
      ring
    exact (hsep (quadraticCenter f)).elim (fun hn => hn hroot) (fun hn => hn hder)
  · intro hq z
    by_cases hd : f.derivative.eval z = 0
    · left
      have hz : z = quadraticCenter f := by
        rw [monic_quadratic_derivative f hf hdeg] at hd
        simp [quadraticCenter] at hd ⊢
        linear_combination (1 / 2 : ℂ) * hd
      subst z
      have heval := monic_quadratic_eval_center_add f hf hdeg 0
      simpa using
        (show f.eval (quadraticCenter f) = quadraticCriticalValue f by simpa using heval).trans_ne hq
    · exact Or.inr hd

theorem monic_quadratic_rootSet_ncard_eq_two (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (hq : quadraticCriticalValue f ≠ 0) :
    (f.rootSet ℂ).ncard = 2 := by
  have hsep : f.Separable := (monic_quadratic_separable_iff f hf hdeg).mpr hq
  have hcard : Fintype.card (f.rootSet ℂ) = f.natDegree :=
    Polynomial.card_rootSet_eq_natDegree hsep (IsAlgClosed.splits _)
  simpa [hdeg] using hcard

/-- Under the component-count hypothesis, a separable quadratic must be below its
critical level.  This reduces the remaining degree-two geometry to two disjoint Cassini lobes. -/
theorem monic_quadratic_criticalValue_norm_gt_of_component_count (f : ℂ[X])
    (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ)
    (hcount : (componentsIn (sublevelSet f c)).ncard = (f.rootSet ℂ).ncard)
    (hq : quadraticCriticalValue f ≠ 0) :
    c < ‖quadraticCriticalValue f‖ := by
  by_contra h
  have hc : ‖quadraticCriticalValue f‖ ≤ c := le_of_not_gt h
  have hcomponents := monic_quadratic_components_ncard_eq_one f hf hdeg c hc
  have hroots := monic_quadratic_rootSet_ncard_eq_two f hf hdeg hq
  omega

/-- A monic quadratic with zero critical value is a translated square, so its
sublevel set is a closed disk. -/
theorem monic_quadratic_sublevel_eq_closedBall_of_criticalValue_eq_zero
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ) (hc : 0 ≤ c)
    (hq : quadraticCriticalValue f = 0) :
    sublevelSet f c = Metric.closedBall (quadraticCenter f) (Real.sqrt c) := by
  ext z
  have heval : f.eval z = (z - quadraticCenter f) ^ 2 := by
    have he := monic_quadratic_eval_center_add f hf hdeg (z - quadraticCenter f)
    simpa [hq] using he
  rw [sublevelSet, Set.mem_ofPred_eq, heval, norm_pow, Metric.mem_closedBall, dist_eq_norm]
  rw [← sq_le_sq₀ (norm_nonneg _) (Real.sqrt_nonneg c), Real.sq_sqrt hc]

theorem monic_quadratic_sublevel_convex_of_criticalValue_eq_zero
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ) (hc : 0 ≤ c)
    (hq : quadraticCriticalValue f = 0) :
    Convex ℝ (sublevelSet f c) := by
  rw [monic_quadratic_sublevel_eq_closedBall_of_criticalValue_eq_zero f hf hdeg c hc hq]
  exact convex_closedBall _ _

theorem sublevelSet_X_pow_one {n : ℕ} (hn : 0 < n) :
    Erdos1047.sublevelSet (X ^ n : ℂ[X]) 1 = Metric.closedBall 0 1 := by
  ext z
  simp only [Erdos1047.sublevelSet, Set.mem_ofPred_eq, eval_pow, eval_X, norm_pow,
    Metric.mem_closedBall, dist_zero_right]
  exact pow_le_one_iff_of_nonneg (norm_nonneg _) (by omega)

theorem zero_attainable (n : ℕ) : 0 ∈ attainableNonConvexCounts n := by
  by_cases hn : n = 0
  · subst n
    refine ⟨1, 1 / 2, monic_one, by simp, by norm_num, ?_, ?_⟩
    all_goals norm_num [Erdos1047.sublevelSet, Erdos1047.componentsIn]
  · have hnpos : 0 < n := by omega
    have hK := sublevelSet_X_pow_one hnpos
    have hC : Erdos1047.componentsIn (Erdos1047.sublevelSet (X ^ n : ℂ[X]) 1) =
        {Metric.closedBall (0 : ℂ) 1} := by
      rw [hK]
      apply componentsIn_eq_singleton_of_isPreconnected (convex_closedBall _ _).isPreconnected
      exact ⟨0, by simp⟩
    have hroot : ((X ^ n : ℂ[X]).rootSet ℂ) = {0} := by
      ext z
      simp [Monic.mem_rootSet (monic_X_pow n), hn]
    refine ⟨X ^ n, 1, monic_X_pow n, by simp, by norm_num, ?_, ?_⟩
    · rw [hC, hroot]
      simp
    · rw [nonconvexComponents_eq_empty_of_convex (by rw [hK]; exact convex_closedBall _ _)]
      simp

theorem sublevelSet_convex_of_monic_degree_le_one (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree ≤ 1) (c : ℝ) : Convex ℝ (Erdos1047.sublevelSet f c) := by
  by_cases h0 : f.natDegree = 0
  · have heq : f = 1 := hf.natDegree_eq_zero.mp h0
    rw [heq]
    by_cases hc : 1 ≤ c
    · simpa [Erdos1047.sublevelSet, hc] using (convex_univ : Convex ℝ (Set.univ : Set ℂ))
    · simpa [Erdos1047.sublevelSet, hc] using (convex_empty : Convex ℝ (∅ : Set ℂ))
  · have h1 : f.natDegree = 1 := by omega
    have heq : Erdos1047.sublevelSet f c = Metric.closedBall (-(f.coeff 0)) c := by
      rw [hf.eq_X_add_C h1]
      ext z
      simp [Erdos1047.sublevelSet, Metric.mem_closedBall, dist_eq_norm, sub_neg_eq_add]
    rw [heq]
    exact convex_closedBall _ _

theorem attainable_eq_zero_of_le_one {n k : ℕ} (hn : n ≤ 1)
    (hk : k ∈ attainableNonConvexCounts n) : k = 0 := by
  obtain ⟨f, c, hf, hdeg, _, _, hk⟩ := hk
  have hconv := sublevelSet_convex_of_monic_degree_le_one f hf (by omega) c
  rw [nonconvexComponents_eq_empty_of_convex hconv, Set.ncard_empty] at hk
  exact hk.symm

/-- The full greatest-element target, without proof holes, in degrees zero and one. -/
theorem max_nonconvex_of_le_one {n : ℕ} (hn : n ≤ 1) :
    IsGreatest (attainableNonConvexCounts n) 0 := by
  exact ⟨zero_attainable n, fun _ hk => (attainable_eq_zero_of_le_one hn hk).le⟩

/-- Degree two contributes no non-convex component to the Formal Conjectures set. -/
theorem attainable_eq_zero_of_degree_two {k : ℕ}
    (hk : k ∈ attainableNonConvexCounts 2) : k = 0 := by
  obtain ⟨f, c, hf, hdeg, hc, hcount, hkcount⟩ := hk
  have hcount' :
      (Erdos1047Quadratic.componentsIn (Erdos1047Quadratic.sublevelSet f c)).ncard =
        (f.rootSet ℂ).ncard := by
    simpa [Erdos1047Quadratic.componentsIn, Erdos1047Quadratic.sublevelSet,
      componentsIn, sublevelSet] using hcount
  have hall' := Erdos1047Quadratic.monic_quadratic_components_convex
    f hf hdeg c hc hcount'
  have hall : ∀ t ∈ componentsIn (sublevelSet f c), Convex ℝ t := by
    simpa [Erdos1047Quadratic.componentsIn, Erdos1047Quadratic.sublevelSet,
      componentsIn, sublevelSet] using hall'
  have hempty :
      {t ∈ componentsIn (sublevelSet f c) | ¬ Convex ℝ t} = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    rintro t ⟨ht, hnconv⟩
    exact hnconv (hall t ht)
  rw [hempty, Set.ncard_empty] at hkcount
  exact hkcount.symm

/-- The full greatest-element conclusion in degree two. -/
theorem max_nonconvex_two : IsGreatest (attainableNonConvexCounts 2) 0 := by
  exact ⟨zero_attainable 2, fun _ hk => (attainable_eq_zero_of_degree_two hk).le⟩

/-- Negative exactly on the left hyperbolic branch region, without square roots. -/
def cubicBarrier (z : ℂ) : ℝ :=
  max (z.re + 1) (z.im ^ 2 + 3 - 3 * z.re ^ 2)

theorem continuous_cubicBarrier : Continuous cubicBarrier := by
  unfold cubicBarrier
  fun_prop

theorem cubicBarrier_neg_iff (z : ℂ) :
    cubicBarrier z < 0 ↔ z.re < -1 ∧ 0 < 3 * z.re ^ 2 - z.im ^ 2 - 3 := by
  rw [cubicBarrier, max_lt_iff]
  constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith

theorem cubicBarrier_neg_convex :
    Convex ℝ {z : ℂ | cubicBarrier z < 0} := by
  have heq : {z : ℂ | cubicBarrier z < 0} =
      {z : ℂ | Erdos1047CubicBarrier.region z} := by
    ext z
    simp [Erdos1047CubicBarrier.region, cubicBarrier_neg_iff]
  rw [heq]
  exact Erdos1047CubicBarrier.region_convex

/-- Every point of the boundary maps beyond the critical-value barrier. -/
theorem cubic_boundary_normSq (z B : ℂ) (hB : 0 ≤ B.re) (hz : cubicBarrier z = 0) :
    Complex.normSq (B - 2) ≤ Complex.normSq (z ^ 3 - 3 * z + B) := by
  have hu : z.re ≤ -1 := by
    have := (le_max_left (z.re + 1) (z.im ^ 2 + 3 - 3 * z.re ^ 2)).trans hz.le
    linarith
  have hT : 3 * z.re ^ 2 - z.im ^ 2 - 3 = 0 := by
    rcases le_total (z.re + 1) (z.im ^ 2 + 3 - 3 * z.re ^ 2) with h | h
    · rw [cubicBarrier, max_eq_right h] at hz
      linarith
    · rw [cubicBarrier, max_eq_left h] at hz
      have hre : z.re = -1 := by linarith
      rw [hre] at h ⊢
      nlinarith [sq_nonneg z.im]
  have him : (z ^ 3 - 3 * z).im = 0 := by
    norm_num [pow_succ, Complex.mul_re, Complex.mul_im]
    linear_combination z.im * hT
  have hre : (z ^ 3 - 3 * z).re = -8 * z.re ^ 3 + 6 * z.re := by
    norm_num [pow_succ, Complex.mul_re, Complex.mul_im]
    linear_combination 3 * z.re * hT
  have hq : 2 ≤ (z ^ 3 - 3 * z).re := by
    rw [hre]
    have hprod : 0 ≤ (-2 * (z.re + 1)) * (2 * z.re - 1) ^ 2 :=
      mul_nonneg (by linarith) (sq_nonneg _)
    nlinarith
  have hprod : 0 ≤ ((z ^ 3 - 3 * z).re + 2) *
      ((z ^ 3 - 3 * z).re - 2 + 2 * B.re) :=
    mul_nonneg (by linarith) (by linarith)
  have hpoly : Complex.normSq (z ^ 3 - 3 * z + B) - Complex.normSq (B - 2) =
      ((z ^ 3 - 3 * z).re + 2) * ((z ^ 3 - 3 * z).re - 2 + 2 * B.re) := by
    simp only [Complex.normSq_apply, Complex.add_re, Complex.add_im, him]
    norm_num
    ring
  linarith

/-- A separated cubic sublevel component meeting the left region stays in that region. -/
theorem cubic_component_stays_left (B : ℂ) (c : ℝ) (r : ℂ)
    (hB : 0 ≤ B.re) (hcrit : c ^ 2 < Complex.normSq (B - 2))
    (hr : r ∈ Erdos1047.sublevelSet (cubicPolynomial B) c) (hleft : cubicBarrier r < 0) :
    ∀ z ∈ connectedComponentIn (Erdos1047.sublevelSet (cubicPolynomial B) c) r,
      z.re < -1 ∧ 0 < 3 * z.re ^ 2 - z.im ^ 2 - 3 := by
  have hzero : ∀ z ∈ Erdos1047.sublevelSet (cubicPolynomial B) c, cubicBarrier z ≠ 0 := by
    intro z hz hboundary
    have hzlevel : ‖z ^ 3 - 3 * z + B‖ ≤ c := by
      simpa [Erdos1047.sublevelSet, cubicPolynomial] using hz
    have hsq : Complex.normSq (z ^ 3 - 3 * z + B) ≤ c ^ 2 := by
      rw [Complex.normSq_eq_norm_sq]
      exact pow_le_pow_left₀ (norm_nonneg _) hzlevel 2
    have := cubic_boundary_normSq z B hB hboundary
    linarith
  intro z hz
  exact (cubicBarrier_neg_iff z).mp
    (negative_on_component continuous_cubicBarrier hzero hr hleft z hz)

/- The remaining geometric step is now isolated precisely: it is enough to
   show that every chord of the component stays below the critical value.
   The one-dimensional calculus and all normalization algebra are discharged
   by `Erdos1047CubicBarrier.cubic_segment_normSq_le_max_endpoints`. -/
theorem cubic_component_convex_of_subcritical_chords
    (B : ℂ) (c : ℝ) (r : ℂ)
    (hB : 0 ≤ B.re) (hcrit : c ^ 2 < Complex.normSq (B - 2))
    (hr : r ∈ Erdos1047.sublevelSet (cubicPolynomial B) c)
    (hleft : cubicBarrier r < 0)
    (hchord : ∀ ⦃x y : ℂ⦄,
      x ∈ connectedComponentIn (Erdos1047.sublevelSet (cubicPolynomial B) c) r →
      y ∈ connectedComponentIn (Erdos1047.sublevelSet (cubicPolynomial B) c) r →
      ∀ t ∈ Set.Icc (0 : ℝ) 1,
        Complex.normSq (Erdos1047CubicBarrier.cubicValue B
          (x + (t : ℂ) * (y - x))) ≤ Complex.normSq (B - 2)) :
    Convex ℝ (connectedComponentIn
      (Erdos1047.sublevelSet (cubicPolynomial B) c) r) := by
  let K : Set ℂ := Erdos1047.sublevelSet (cubicPolynomial B) c
  let C : Set ℂ := connectedComponentIn K r
  have hc : 0 ≤ c := by
    have hr' : ‖(cubicPolynomial B).eval r‖ ≤ c := by
      simpa [K, Erdos1047.sublevelSet] using hr
    exact (norm_nonneg _).trans hr'
  have hregion : ∀ z ∈ C, Erdos1047CubicBarrier.region z := by
    intro z hz
    exact cubic_component_stays_left B c r hB hcrit hr hleft z hz
  apply Erdos1047CubicBarrier.convex_connectedComponentIn_of_segment_subset K r
  intro x y hx hy
  rintro w ⟨a, b, ha, hb, hab, rfl⟩
  have hparam : a • x + b • y = x + (b : ℂ) * (y - x) := by
    rw [Complex.real_smul, Complex.real_smul]
    have hab' : (a : ℂ) + (b : ℂ) = 1 := by exact_mod_cast hab
    linear_combination x * hab'
  rw [hparam]
  by_cases hv : y - x = 0
  · have hxy : y = x := sub_eq_zero.mp hv
    rw [hxy, sub_self, mul_zero, add_zero]
    exact connectedComponentIn_subset K r hx
  · have hline_region : ∀ t ∈ Set.Icc (0 : ℝ) 1,
        Erdos1047CubicBarrier.region (x + (t : ℂ) * (y - x)) := by
      intro t ht
      have hconv := Erdos1047CubicBarrier.region_convex
        (hregion x hx) (hregion y hy) (sub_nonneg.mpr ht.2) ht.1
        (by ring : (1 - t) + t = 1)
      have heq : x + (t : ℂ) * (y - x) = (1 - t) • x + t • y := by
        apply Complex.ext <;>
          norm_num [Complex.real_smul, Complex.mul_re, Complex.mul_im] <;> ring
      rw [heq]
      exact hconv
    have hpd : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
        3 * ((x + (t : ℂ) * (y - x)) ^ 2 - 1) ≠ 0 := by
      intro t ht hzero
      have hreg := hline_region t ⟨ht.1.le, ht.2.le⟩
      have hfac : (x + (t : ℂ) * (y - x)) ^ 2 - 1 = 0 := by
        rcases mul_eq_zero.mp hzero with hthree | hfac
        · norm_num at hthree
        · exact hfac
      rcases (sq_eq_one_iff.mp (sub_eq_zero.mp hfac)) with hplus | hminus
      · rw [hplus] at hreg
        have hcontr := hreg.1
        norm_num at hcontr
      · rw [hminus] at hreg
        have hcontr := hreg.1
        norm_num at hcontr
    have hq : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
        0 < (1 - Erdos1047CubicBarrier.cubicValue B
          (x + (t : ℂ) * (y - x)) * (6 * (x + (t : ℂ) * (y - x))) /
          (3 * ((x + (t : ℂ) * (y - x)) ^ 2 - 1)) ^ 2).re := by
      intro t ht
      have hreg := hline_region t ⟨ht.1.le, ht.2.le⟩
      apply cubic_ratio_positive_of_left_subcritical
        (x + (t : ℂ) * (y - x)) B hreg.1 hreg.2 hB
      simpa [Erdos1047CubicBarrier.cubicValue] using
        hchord hx hy t ⟨ht.1.le, ht.2.le⟩
    have hseg := Erdos1047CubicBarrier.cubic_segment_normSq_le_max_endpoints
      B x (y - x) hv hpd hq b ⟨hb, by linarith⟩
    have hxK : ‖(cubicPolynomial B).eval x‖ ≤ c := by
      exact connectedComponentIn_subset K r hx
    have hyK : ‖(cubicPolynomial B).eval y‖ ≤ c := by
      exact connectedComponentIn_subset K r hy
    have hxSq : Erdos1047CubicBarrier.cubicNormSq B x ≤ c ^ 2 := by
      have hxval : Erdos1047CubicBarrier.cubicValue B x =
          (cubicPolynomial B).eval x := by
        simp [cubicPolynomial, Erdos1047CubicBarrier.cubicValue]
      rw [Erdos1047CubicBarrier.cubicNormSq_eq]
      rw [Complex.normSq_eq_norm_sq]
      rw [hxval]
      nlinarith [sq_nonneg (‖(cubicPolynomial B).eval x‖),
        norm_nonneg ((cubicPolynomial B).eval x)]
    have hySq : Erdos1047CubicBarrier.cubicNormSq B (x + (y - x)) ≤ c ^ 2 := by
      rw [show x + (y - x) = y by ring]
      have hyval : Erdos1047CubicBarrier.cubicValue B y =
          (cubicPolynomial B).eval y := by
        simp [cubicPolynomial, Erdos1047CubicBarrier.cubicValue]
      rw [Erdos1047CubicBarrier.cubicNormSq_eq]
      rw [Complex.normSq_eq_norm_sq]
      rw [hyval]
      nlinarith [sq_nonneg (‖(cubicPolynomial B).eval y‖),
        norm_nonneg ((cubicPolynomial B).eval y)]
    have hbound : Erdos1047CubicBarrier.cubicNormSq B
        (x + (b : ℂ) * (y - x)) ≤ c ^ 2 := by
      exact le_trans hseg (max_le hxSq hySq)
    have hnormsq : Complex.normSq
        (Erdos1047CubicBarrier.cubicValue B
          (x + (b : ℂ) * (y - x))) ≤ c ^ 2 := by
      simpa [Erdos1047CubicBarrier.cubicNormSq_eq] using hbound
    have hnorm : ‖Erdos1047CubicBarrier.cubicValue B
        (x + (b : ℂ) * (y - x))‖ ≤ c := by
      rw [Complex.normSq_eq_norm_sq] at hnormsq
      nlinarith [norm_nonneg
        (Erdos1047CubicBarrier.cubicValue B
          (x + (b : ℂ) * (y - x)))]
    simpa [cubicPolynomial, Erdos1047CubicBarrier.cubicValue, K,
      Erdos1047.sublevelSet] using hnorm

/-- The pointwise algebraic estimate now holds on an actual connected component. -/
theorem continuous_gap_propagation {X : Type*} [TopologicalSpace X]
    {C : Set X} (hC : IsPreconnected C) {F : X → ℝ}
    (hF : ContinuousOn F C) {a b : ℝ} (hab : a < b)
    {x : X} (hx : x ∈ C) (hbase : F x ≤ a)
    (hgap : ∀ y ∈ C, F y ≤ b → F y ≤ a) :
    ∀ y ∈ C, F y ≤ a := by
  intro y hy
  by_contra hn
  have hhigh : b < F y := lt_of_not_ge (fun h => hn (hgap y hy h))
  obtain ⟨z, hz, heq⟩ := hC.intermediate_value hx hy hF
    (show (a + b) / 2 ∈ Icc (F x) (F y) by constructor <;> linarith)
  have hlow := hgap z hz (by linarith : F z ≤ b)
  linarith

/-- Compact maximization turns a conditional chord bound into a global one. -/
theorem chord_bound_of_gap {C : Set ℂ} (hC : IsPreconnected C)
    {G : ℂ → ℝ} (hG : Continuous G) {a b : ℝ} (hab : a < b)
    (hlevel : ∀ z ∈ C, G z ≤ a)
    (himprove : ∀ x ∈ C, ∀ y ∈ C,
      (∀ t ∈ Icc (0 : ℝ) 1, G (x + (t : ℂ) * (y - x)) ≤ b) →
      ∀ t ∈ Icc (0 : ℝ) 1, G (x + (t : ℂ) * (y - x)) ≤ a) :
    ∀ x ∈ C, ∀ y ∈ C, ∀ t ∈ Icc (0 : ℝ) 1,
      G (x + (t : ℂ) * (y - x)) ≤ a := by
  intro x hx
  let f : ℂ → ℝ → ℝ := fun y t => G (x + (t : ℂ) * (y - x))
  let M : ℂ → ℝ := fun y => sSup (f y '' Icc (0 : ℝ) 1)
  have hf : Continuous ↿f := by dsimp [f]; fun_prop
  have hM : Continuous M := isCompact_Icc.continuous_sSup hf
  have hf_y (y : ℂ) : Continuous (f y) := by dsimp [f]; fun_prop
  have hnon (y : ℂ) : (f y '' Icc (0 : ℝ) 1).Nonempty :=
    (nonempty_Icc.mpr (by norm_num)).image _
  have hupper (y : ℂ) (d : ℝ)
      (hd : ∀ t ∈ Icc (0 : ℝ) 1, f y t ≤ d) : M y ≤ d := by
    exact csSup_le (hnon y) (by rintro _ ⟨t, ht, rfl⟩; exact hd t ht)
  have hlower (y : ℂ) (t : ℝ) (ht : t ∈ Icc (0 : ℝ) 1) : f y t ≤ M y :=
    le_csSup (isCompact_Icc.bddAbove_image (hf_y y).continuousOn)
      (mem_image_of_mem (f y) ht)
  have hbase : M x ≤ a := by
    apply hupper
    intro t ht
    simpa [f] using hlevel x hx
  have hgap : ∀ y ∈ C, M y ≤ b → M y ≤ a := by
    intro y hy hMy
    apply hupper
    exact himprove x hx y hy (fun t ht => (hlower y t ht).trans hMy)
  have hall := continuous_gap_propagation hC hM.continuousOn hab hx hbase hgap
  intro y hy t ht
  exact (hlower y t ht).trans (hall y hy)

/-- The previously assumed global chord bound follows from the gap argument. -/
theorem cubic_convex_of_subcritical
    (B : ℂ) (c : ℝ) (r : ℂ)
    (hB : 0 ≤ B.re) (hcrit : c ^ 2 < Complex.normSq (B - 2))
    (hr : r ∈ sublevelSet (cubicPolynomial B) c)
    (hleft : cubicBarrier r < 0) :
    Convex ℝ (connectedComponentIn (sublevelSet (cubicPolynomial B) c) r) := by
  let K := sublevelSet (cubicPolynomial B) c
  let C := connectedComponentIn K r
  let G := Erdos1047CubicBarrier.cubicNormSq B
  have hG : Continuous G := by
    change Continuous (fun z => Erdos1047CubicBarrier.cubicNormSq B z)
    simp_rw [Erdos1047CubicBarrier.cubicNormSq_eq]
    unfold Erdos1047CubicBarrier.cubicValue
    fun_prop
  have hlevel : ∀ z ∈ C, G z ≤ c ^ 2 := by
    intro z hz
    have hzK : ‖(cubicPolynomial B).eval z‖ ≤ c := connectedComponentIn_subset K r hz
    have hval : Erdos1047CubicBarrier.cubicValue B z = (cubicPolynomial B).eval z := by
      simp [Erdos1047CubicBarrier.cubicValue, cubicPolynomial]
    dsimp [G]
    rw [Erdos1047CubicBarrier.cubicNormSq_eq, hval, Complex.normSq_eq_norm_sq]
    exact pow_le_pow_left₀ (norm_nonneg _) hzK 2
  have hregion : ∀ z ∈ C, Erdos1047CubicBarrier.region z := by
    intro z hz
    exact cubic_component_stays_left B c r hB hcrit hr hleft z hz
  have himprove : ∀ x ∈ C, ∀ y ∈ C,
      (∀ t ∈ Icc (0 : ℝ) 1, G (x + (t : ℂ) * (y - x)) ≤ Complex.normSq (B - 2)) →
      ∀ t ∈ Icc (0 : ℝ) 1, G (x + (t : ℂ) * (y - x)) ≤ c ^ 2 := by
    intro x hx y hy hbound t ht
    by_cases hv : y - x = 0
    · simpa [hv] using hlevel x hx
    have hreg : ∀ u ∈ Icc (0 : ℝ) 1,
        Erdos1047CubicBarrier.region (x + (u : ℂ) * (y - x)) := by
      intro u hu
      have hh := Erdos1047CubicBarrier.region_convex (hregion x hx) (hregion y hy)
        (sub_nonneg.mpr hu.2) hu.1 (by ring : (1 - u) + u = 1)
      have heq : (1 - u) • x + u • y = x + (u : ℂ) * (y - x) := by
        simp only [Complex.real_smul]
        push_cast
        ring
      rwa [heq] at hh
    have hpd : ∀ u ∈ Ioo (0 : ℝ) 1,
        3 * ((x + (u : ℂ) * (y - x)) ^ 2 - 1) ≠ 0 := by
      intro u hu hz
      have hregu := hreg u ⟨hu.1.le, hu.2.le⟩
      have hfac : (x + (u : ℂ) * (y - x)) ^ 2 - 1 = 0 := by
        rcases mul_eq_zero.mp hz with hz | hz
        · norm_num at hz
        · exact hz
      rcases sq_eq_one_iff.mp (sub_eq_zero.mp hfac) with hh | hh
      · rw [hh] at hregu
        norm_num [Erdos1047CubicBarrier.region] at hregu
      · rw [hh] at hregu
        norm_num [Erdos1047CubicBarrier.region] at hregu
    have hq : ∀ u ∈ Ioo (0 : ℝ) 1,
        0 < (1 - Erdos1047CubicBarrier.cubicValue B (x + (u : ℂ) * (y - x)) *
          (6 * (x + (u : ℂ) * (y - x))) /
          (3 * ((x + (u : ℂ) * (y - x)) ^ 2 - 1)) ^ 2).re := by
      intro u hu
      have hregu := hreg u ⟨hu.1.le, hu.2.le⟩
      apply cubic_ratio_positive_of_left_subcritical _ B hregu.1 hregu.2 hB
      simpa [G, Erdos1047CubicBarrier.cubicNormSq_eq,
        Erdos1047CubicBarrier.cubicValue] using hbound u ⟨hu.1.le, hu.2.le⟩
    have hh := Erdos1047CubicBarrier.cubic_segment_normSq_le_max_endpoints
      B x (y - x) hv hpd hq t ht
    have heq : x + (y - x) = y := by ring
    rw [heq] at hh
    exact hh.trans (max_le (hlevel x hx) (hlevel y hy))
  have hchords := chord_bound_of_gap (C := C) isPreconnected_connectedComponentIn
    hG hcrit hlevel himprove
  apply cubic_component_convex_of_subcritical_chords B c r hB hcrit hr hleft
  intro x y hx hy t ht
  have hh := (hchords x hx y hy t ht).trans hcrit.le
  simpa [G, Erdos1047CubicBarrier.cubicNormSq_eq] using hh

theorem cubic_curvature_on_component (B : ℂ) (c : ℝ) (r : ℂ)
    (hB : 0 ≤ B.re) (hcrit : c ^ 2 < Complex.normSq (B - 2))
    (hr : r ∈ Erdos1047.sublevelSet (cubicPolynomial B) c) (hleft : cubicBarrier r < 0) :
    ∀ z ∈ connectedComponentIn (Erdos1047.sublevelSet (cubicPolynomial B) c) r,
      (2 / 3 : ℝ) <
        (1 - (cubicPolynomial B).eval z * (cubicPolynomial B).derivative.derivative.eval z /
          ((cubicPolynomial B).derivative.eval z) ^ 2).re := by
  intro z hz
  obtain ⟨hu, hT⟩ := cubic_component_stays_left B c r hB hcrit hr hleft z hz
  apply cubic_curvature_gt_two_thirds z B hu hT hB
  have hzlevel : ‖z ^ 3 - 3 * z + B‖ ≤ c := by
    simpa [Erdos1047.sublevelSet, cubicPolynomial] using connectedComponentIn_subset _ _ hz
  rw [Complex.normSq_eq_norm_sq]
  exact (pow_le_pow_left₀ (norm_nonneg _) hzlevel 2).trans hcrit.le

theorem cubicPolynomial_monic (B : ℂ) : (cubicPolynomial B).Monic := by
  unfold cubicPolynomial
  monicity!

theorem cubicPolynomial_natDegree (B : ℂ) : (cubicPolynomial B).natDegree = 3 := by
  unfold cubicPolynomial
  compute_degree!

/-! The centered normal form has a useful sign symmetry.  Replacing `z` by
    `-z` changes `B` to `-B` and only multiplies the value by `-1`, hence it
    preserves every norm sublevel set up to an affine homeomorphism. -/
theorem cubicPolynomial_neg_eval (B z : ℂ) :
    (cubicPolynomial (-B)).eval (-z) = -(cubicPolynomial B).eval z := by
  norm_num [cubicPolynomial]
  ring

/-! Explicit values at the two critical points.  These small bridges let the
    threshold inequality be read directly as membership of `±1` in the
    corresponding sublevel set. -/
theorem cubicPolynomial_eval_one (B : ℂ) :
    (cubicPolynomial B).eval (1 : ℂ) = B - 2 := by
  norm_num [cubicPolynomial]
  ring

theorem cubicPolynomial_eval_neg_one (B : ℂ) :
    (cubicPolynomial B).eval (-1 : ℂ) = B + 2 := by
  norm_num [cubicPolynomial]
  ring

/-! A straight-line sublevel estimate for the two roots lying to the right of
the barrier `Re z = -1`.  The independent algebraic norm inequality is in
`Erdos1047CubicRootChordCore`; this bridge only expands the centered cubic and
uses the root equation. -/
theorem cubic_eval_segment_norm_le_of_root_re_ge_neg_one
    {B r : ℂ} {t : ℝ}
    (hrzero : (cubicPolynomial B).eval r = 0)
    (hr : -1 ≤ r.re) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    ‖(cubicPolynomial B).eval (r + (t : ℂ) * (1 - r))‖ ≤ ‖B - 2‖ := by
  have hz : r ^ 3 - 3 * r + B = 0 := by
    simpa [cubicPolynomial] using hrzero
  have hrel : B - 2 = -(r - 1) ^ 2 * (r + 2) := by
    linear_combination hz
  have hB : B = 2 - (r - 1) ^ 2 * (r + 2) := by
    linear_combination hrel
  let s : ℝ := 1 - t
  have hs0 : 0 ≤ s := by dsimp [s]; linarith
  have hs1 : s ≤ 1 := by dsimp [s]; linarith
  have hcore := Erdos1047CubicRootChord.affine_cubic_segment_norm_le
    (r := r) (s := s) hr hs0 hs1
  have heval : (cubicPolynomial B).eval (r + (t : ℂ) * (1 - r)) =
      (r - 1) ^ 2 *
        (-((1 - s ^ 3 : ℝ) : ℂ) * (r + 2) +
          3 * ((s ^ 2 : ℝ) : ℂ) * ((1 - s : ℝ) : ℂ)) := by
    dsimp [s]
    rw [hB]
    norm_num [cubicPolynomial]
    ring
  calc
    ‖(cubicPolynomial B).eval (r + (t : ℂ) * (1 - r))‖ =
        ‖r - 1‖ ^ 2 *
          ‖-((1 - s ^ 3 : ℝ) : ℂ) * (r + 2) +
            3 * ((s ^ 2 : ℝ) : ℂ) * ((1 - s : ℝ) : ℂ)‖ := by
      rw [heval, norm_mul, norm_pow]
    _ ≤ ‖r - 1‖ ^ 2 * ‖r + 2‖ := by
      exact mul_le_mul_of_nonneg_left hcore (by positivity)
    _ = ‖B - 2‖ := by
      calc
        ‖r - 1‖ ^ 2 * ‖r + 2‖ = ‖-(r - 1) ^ 2 * (r + 2)‖ := by
          rw [norm_mul, norm_neg, norm_pow]
        _ = ‖B - 2‖ := by rw [← hrel]

theorem cubic_exists_two_roots_re_ge_neg_one
    {B : ℂ} (hB : 0 ≤ B.re)
    (hroot : ((cubicPolynomial B).rootSet ℂ).ncard = 3) :
    ∃ r ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ s ∈ (cubicPolynomial B).rootSet ℂ, r ≠ s ∧
        -1 ≤ r.re ∧ -1 ≤ s.re := by
  let R : Set ℂ := (↑((cubicPolynomial B).rootSet ℂ) : Set ℂ)
  let L : Set ℂ := {z : ℂ | z ∈ R ∧ z.re < -1}
  let G : Set ℂ := {z : ℂ | z ∈ R ∧ -1 ≤ z.re}
  have hRfin : R.Finite := (cubicPolynomial B).rootSet_finite ℂ
  have hLfin : L.Finite := hRfin.subset (by intro z hz; exact hz.1)
  have hGfin : G.Finite := hRfin.subset (by intro z hz; exact hz.1)
  have hLsub : L.Subsingleton := by
    intro r hr s hs
    by_contra hrs
    have hrzero : r ^ 3 - 3 * r + B = 0 := by
      simpa [cubicPolynomial] using
        (cubicPolynomial_monic B).mem_rootSet.mp hr.1
    have hszero : s ^ 3 - 3 * s + B = 0 := by
      simpa [cubicPolynomial] using
        (cubicPolynomial_monic B).mem_rootSet.mp hs.1
    apply Erdos1047CubicRootChord.not_two_roots_re_lt_neg_one hB
      hrzero hszero hrs
      hr.2 hs.2
  have hLcard : L.ncard ≤ 1 := (Set.ncard_le_one_iff_subsingleton).2 hLsub
  have hdisj : Disjoint G L := by
    rw [Set.disjoint_left]
    intro z hzG hzL
    linarith [hzG.2, hzL.2]
  have hRU : R = G ∪ L := by
    ext z
    constructor
    · intro hz
      by_cases h : -1 ≤ z.re
      · exact Or.inl ⟨hz, h⟩
      · exact Or.inr ⟨hz, lt_of_not_ge h⟩
    · intro hz
      exact hz.elim (fun h => h.1) (fun h => h.1)
  have hRcard : R.ncard = 3 := by simpa [R] using hroot
  have hcard : R.ncard = G.ncard + L.ncard := by
    rw [hRU, Set.ncard_union_eq hdisj hGfin hLfin]
  have hGgt : 1 < G.ncard := by omega
  obtain ⟨r, hrG, s, hsG, hrs⟩ := Set.one_lt_ncard hGfin |>.mp hGgt
  exact ⟨r, hrG.1, s, hsG.1, hrs, hrG.2, hsG.2⟩

/-! Above the first critical level, the two roots with `Re r ≥ -1` can be
joined to the critical point by literal straight segments.  The preceding
norm estimate is exactly what keeps these segments inside the sublevel. -/
theorem cubic_two_root_paths_of_supercritical
    {B : ℂ} {c : ℝ} (hB : 0 ≤ B.re) (hc : 0 ≤ c)
    (hcrit : Complex.normSq (B - 2) ≤ c ^ 2)
    (hroot : ((cubicPolynomial B).rootSet ℂ).ncard = 3) :
    ∃ r ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ s ∈ (cubicPolynomial B).rootSet ℂ, r ≠ s ∧
        (∃ γr : ℝ → ℂ,
          ContinuousOn γr (Set.Icc (0 : ℝ) 1) ∧
          (∀ t ∈ Set.Ioo (0 : ℝ) 1,
            γr t ∈ sublevelSet (cubicPolynomial B) c) ∧
          γr 0 = r ∧ γr 1 = 1) ∧
        (∃ γs : ℝ → ℂ,
          ContinuousOn γs (Set.Icc (0 : ℝ) 1) ∧
          (∀ t ∈ Set.Ioo (0 : ℝ) 1,
            γs t ∈ sublevelSet (cubicPolynomial B) c) ∧
          γs 0 = s ∧ γs 1 = 1) := by
  obtain ⟨r, hr, s, hs, hrs, hrre, hsre⟩ :=
    cubic_exists_two_roots_re_ge_neg_one hB hroot
  have hrzero : (cubicPolynomial B).eval r = 0 :=
    (cubicPolynomial_monic B).mem_rootSet.mp hr
  have hszero : (cubicPolynomial B).eval s = 0 :=
    (cubicPolynomial_monic B).mem_rootSet.mp hs
  have hnormcrit : ‖B - 2‖ ≤ c := by
    rw [Complex.normSq_eq_norm_sq] at hcrit
    nlinarith [norm_nonneg (B - 2)]
  let γr : ℝ → ℂ := fun t => r + (t : ℂ) * (1 - r)
  let γs : ℝ → ℂ := fun t => s + (t : ℂ) * (1 - s)
  have hcont_r : ContinuousOn γr (Set.Icc (0 : ℝ) 1) := by
    dsimp [γr]
    fun_prop
  have hcont_s : ContinuousOn γs (Set.Icc (0 : ℝ) 1) := by
    dsimp [γs]
    fun_prop
  have hmem_r : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
      γr t ∈ sublevelSet (cubicPolynomial B) c := by
    intro t ht
    change ‖(cubicPolynomial B).eval (r + (t : ℂ) * (1 - r))‖ ≤ c
    exact (cubic_eval_segment_norm_le_of_root_re_ge_neg_one hrzero hrre
      (le_of_lt ht.1) (le_of_lt ht.2)).trans hnormcrit
  have hmem_s : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
      γs t ∈ sublevelSet (cubicPolynomial B) c := by
    intro t ht
    change ‖(cubicPolynomial B).eval (s + (t : ℂ) * (1 - s))‖ ≤ c
    exact (cubic_eval_segment_norm_le_of_root_re_ge_neg_one hszero hsre
      (le_of_lt ht.1) (le_of_lt ht.2)).trans hnormcrit
  refine ⟨r, hr, s, hs, hrs, ⟨γr, hcont_r, hmem_r, ?_, ?_⟩,
    ⟨γs, hcont_s, hmem_s, ?_, ?_⟩⟩ <;>
    simp [γr, γs]

theorem cubic_two_root_paths_of_supercritical_exact
    {B : ℂ} {c : ℝ} (hB : 0 ≤ B.re) (hc : 0 ≤ c)
    (hcrit : Complex.normSq (B - 2) ≤ c ^ 2)
    (hroot : ((cubicPolynomial B).rootSet ℂ).ncard = 3) :
    ∃ r ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ s ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ γr γs : ℝ → ℂ, r ≠ s ∧
        ContinuousOn γr (Set.Icc (0 : ℝ) 1) ∧
        (∀ t ∈ Set.Ioo (0 : ℝ) 1,
          γr t ∈ sublevelSet (cubicPolynomial B) c) ∧
        γr 0 = r ∧ γr 1 = 1 ∧
        ContinuousOn γs (Set.Icc (0 : ℝ) 1) ∧
        (∀ t ∈ Set.Ioo (0 : ℝ) 1,
          γs t ∈ sublevelSet (cubicPolynomial B) c) ∧
        γs 0 = s ∧ γs 1 = 1 := by
  rcases cubic_two_root_paths_of_supercritical hB hc hcrit hroot with
    ⟨r, hr, s, hs, hrs, ⟨γr, hcr, hmr, hsr, her⟩,
      ⟨γs, hcs, hms, hss, hes⟩⟩
  exact ⟨r, hr, s, hs, γr, γs, hrs, hcr, hmr, hsr, her,
    hcs, hms, hss, hes⟩

theorem cubicPolynomial_derivative_eval_one (B : ℂ) :
    (cubicPolynomial B).derivative.eval (1 : ℂ) = 0 := by
  norm_num [cubicPolynomial]

theorem cubicPolynomial_derivative_eval_neg_one (B : ℂ) :
    (cubicPolynomial B).derivative.eval (-1 : ℂ) = 0 := by
  norm_num [cubicPolynomial]

theorem cubic_one_mem_sublevel_of_normSq_le {B : ℂ} {c : ℝ}
    (hc : 0 ≤ c) (hcrit : Complex.normSq (B - 2) ≤ c ^ 2) :
    (1 : ℂ) ∈ Erdos1047.sublevelSet (cubicPolynomial B) c := by
  change ‖(cubicPolynomial B).eval (1 : ℂ)‖ ≤ c
  rw [cubicPolynomial_eval_one]
  rw [Complex.normSq_eq_norm_sq] at hcrit
  nlinarith [norm_nonneg (B - 2)]

theorem cubic_neg_one_mem_sublevel_of_normSq_le {B : ℂ} {c : ℝ}
    (hc : 0 ≤ c) (hcrit : Complex.normSq (B + 2) ≤ c ^ 2) :
    (-1 : ℂ) ∈ Erdos1047.sublevelSet (cubicPolynomial B) c := by
  change ‖(cubicPolynomial B).eval (-1 : ℂ)‖ ≤ c
  rw [cubicPolynomial_eval_neg_one]
  rw [Complex.normSq_eq_norm_sq] at hcrit
  nlinarith [norm_nonneg (B + 2)]

theorem cubic_critical_one_mem_sublevel_of_normSq_le {B : ℂ} {c : ℝ}
    (hc : 0 ≤ c) (hcrit : Complex.normSq (B - 2) ≤ c ^ 2) :
    (1 : ℂ) ∈ Erdos1047.sublevelSet (cubicPolynomial B) c :=
  cubic_one_mem_sublevel_of_normSq_le hc hcrit

/-! Concrete collision interface for the first critical point.  The only
    non-algebraic inputs are the two lifted paths; all root membership and
    endpoint bookkeeping is discharged here. -/
theorem cubic_root_collision_of_two_paths_to_one
    {B : ℂ} {c : ℝ} {r s : ℂ}
    (hc : 0 ≤ c) (hcrit : Complex.normSq (B - 2) ≤ c ^ 2)
    (hr : r ∈ (cubicPolynomial B).rootSet ℂ)
    (hs : s ∈ (cubicPolynomial B).rootSet ℂ) (hrs : r ≠ s)
    {γr γs : ℝ → ℂ}
    (hcont_r : ContinuousOn γr (Set.Icc (0 : ℝ) 1))
    (hmem_r : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
      γr t ∈ Erdos1047.sublevelSet (cubicPolynomial B) c)
    (hstart_r : γr 0 = r) (hend_r : γr 1 = 1)
    (hcont_s : ContinuousOn γs (Set.Icc (0 : ℝ) 1))
    (hmem_s : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
      γs t ∈ Erdos1047.sublevelSet (cubicPolynomial B) c)
    (hstart_s : γs 0 = s) (hend_s : γs 1 = 1) :
    ∃ r ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ s ∈ (cubicPolynomial B).rootSet ℂ, r ≠ s ∧
        connectedComponentIn (Erdos1047.sublevelSet (cubicPolynomial B) c) r =
          connectedComponentIn (Erdos1047.sublevelSet (cubicPolynomial B) c) s := by
  let S : Set ℂ := Erdos1047.sublevelSet (cubicPolynomial B) c
  have hrS : r ∈ S := by
    change ‖(cubicPolynomial B).eval r‖ ≤ c
    have hreval : (cubicPolynomial B).eval r = 0 :=
      (cubicPolynomial_monic B).mem_rootSet.mp hr
    rw [hreval, norm_zero]
    exact hc
  have hsS : s ∈ S := by
    change ‖(cubicPolynomial B).eval s‖ ≤ c
    have hseval : (cubicPolynomial B).eval s = 0 :=
      (cubicPolynomial_monic B).mem_rootSet.mp hs
    rw [hseval, norm_zero]
    exact hc
  have hqS : (1 : ℂ) ∈ S := cubic_critical_one_mem_sublevel_of_normSq_le hc hcrit
  have hmem_r' : ∀ t ∈ Set.Icc (0 : ℝ) 1, γr t ∈ S := by
    intro t ht
    rcases eq_or_lt_of_le ht.1 with hzero | hpos
    · subst t
      rw [hstart_r]
      exact hrS
    · rcases eq_or_lt_of_le ht.2 with hone | hlt
      · subst t
        rw [hend_r]
        exact hqS
      · exact hmem_r t ⟨hpos, hlt⟩
  have hmem_s' : ∀ t ∈ Set.Icc (0 : ℝ) 1, γs t ∈ S := by
    intro t ht
    rcases eq_or_lt_of_le ht.1 with hzero | hpos
    · subst t
      rw [hstart_s]
      exact hsS
    · rcases eq_or_lt_of_le ht.2 with hone | hlt
      · subst t
        rw [hend_s]
        exact hqS
      · exact hmem_s t ⟨hpos, hlt⟩
  have hcomp := roots_collide_of_two_paths_to_common_point
    hcont_r hmem_r' hstart_r hend_r hcont_s hmem_s' hstart_s hend_s
  exact ⟨r, hr, s, hs, hrs, hcomp⟩

/-! End-to-end threshold interface.  The hypothesis is intentionally only a
    path-pair existence statement for each supercritical level.  Once such a
    pair is supplied by a path-lifting argument, the component-count hypothesis
    forces strict subcriticality with no further topology hidden in the proof. -/
theorem cubic_three_components_forces_subcritical_of_two_paths_to_one
    {B : ℂ} {c : ℝ} (hc : 0 ≤ c)
    (hcount : (componentsIn (sublevelSet (cubicPolynomial B) c)).ncard = 3)
    (hroot : ((cubicPolynomial B).rootSet ℂ).ncard = 3)
    (himage : componentsIn (sublevelSet (cubicPolynomial B) c) =
      (fun r : ℂ ↦ connectedComponentIn
        (sublevelSet (cubicPolynomial B) c) r) ''
        (↑((cubicPolynomial B).rootSet ℂ) : Set ℂ))
    (hpaths : ∀ hge : Complex.normSq (B - 2) ≤ c ^ 2,
      ∃ r ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ s ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ γr γs : ℝ → ℂ, r ≠ s ∧
        ContinuousOn γr (Set.Icc (0 : ℝ) 1) ∧
        (∀ t ∈ Set.Ioo (0 : ℝ) 1,
          γr t ∈ sublevelSet (cubicPolynomial B) c) ∧
        γr 0 = r ∧ γr 1 = 1 ∧
        ContinuousOn γs (Set.Icc (0 : ℝ) 1) ∧
        (∀ t ∈ Set.Ioo (0 : ℝ) 1,
          γs t ∈ sublevelSet (cubicPolynomial B) c) ∧
        γs 0 = s ∧ γs 1 = 1) :
    c ^ 2 < Complex.normSq (B - 2) := by
  apply cubic_three_components_forces_subcritical_of_collision hcount hroot himage
  intro hge
  rcases hpaths hge with
    ⟨r, hr, s, hs, γr, γs, hrs, hcont_r, hmem_r, hstart_r, hend_r,
      hcont_s, hmem_s, hstart_s, hend_s⟩
  exact cubic_root_collision_of_two_paths_to_one hc hge hr hs hrs
    hcont_r hmem_r hstart_r hend_r hcont_s hmem_s hstart_s hend_s

theorem cubicPolynomial_neg_sublevel_image (B : ℂ) (c : ℝ) :
    (fun z : ℂ => -z) '' Erdos1047.sublevelSet (cubicPolynomial B) c =
      Erdos1047.sublevelSet (cubicPolynomial (-B)) c := by
  ext w
  constructor
  · rintro ⟨z, hz, rfl⟩
    change ‖(cubicPolynomial (-B)).eval (-z)‖ ≤ c
    rw [cubicPolynomial_neg_eval, norm_neg]
    exact hz
  · intro hw
    refine ⟨-w, ?_, by simp⟩
    change ‖(cubicPolynomial B).eval (-w)‖ ≤ c
    have he : (cubicPolynomial B).eval (-w) =
        -(cubicPolynomial (-B)).eval w := by
      simpa using (cubicPolynomial_neg_eval (-B) w)
    rw [he, norm_neg]
    exact hw

theorem cubicPolynomial_neg_component_convex_iff (B : ℂ) (c : ℝ) {r : ℂ}
    (hr : r ∈ Erdos1047.sublevelSet (cubicPolynomial B) c) :
    Convex ℝ (connectedComponentIn
      (Erdos1047.sublevelSet (cubicPolynomial B) c) r) ↔
      Convex ℝ (connectedComponentIn
        (Erdos1047.sublevelSet (cubicPolynomial (-B)) c) (-r)) := by
  have h := Erdos1047CubicNormalize.affine_image_connectedComponentIn_convex_iff
    (0 : ℂ) (-1 : ℂ) (by norm_num) hr
  have hset : (fun z : ℂ => (0 : ℂ) + (-1 : ℂ) * z) ''
      Erdos1047.sublevelSet (cubicPolynomial B) c =
        Erdos1047.sublevelSet (cubicPolynomial (-B)) c := by
    simpa using (cubicPolynomial_neg_sublevel_image B c)
  rw [hset] at h
  simpa using h.symm

theorem exists_nonneg_realpart_sign (B : ℂ) :
    0 ≤ B.re ∨ 0 ≤ (-B).re := by
  by_cases hB : 0 ≤ B.re
  · exact Or.inl hB
  · right
    simp only [Complex.neg_re]
    linarith

theorem cubic_critical_value_order {B : ℂ} (hB : 0 ≤ B.re) :
    Complex.normSq (B - 2) ≤ Complex.normSq (B + 2) := by
  rw [Complex.normSq_apply, Complex.normSq_apply]
  norm_num [Complex.sub_re, Complex.sub_im, Complex.add_re, Complex.add_im]
  nlinarith

theorem cubic_subcritical_both_of_minus {B : ℂ} {c : ℝ}
    (hB : 0 ≤ B.re) (hcrit : c ^ 2 < Complex.normSq (B - 2)) :
    c ^ 2 < Complex.normSq (B + 2) :=
  lt_of_lt_of_le hcrit (cubic_critical_value_order hB)

/-- Vieta's identities force a root in the open left half-plane. -/
theorem cubic_exists_root_re_neg (B : ℂ) :
    ∃ r : ℂ, (cubicPolynomial B).eval r = 0 ∧ r.re < 0 := by
  have hcard : (cubicPolynomial B).roots.card = 3 := by
    rw [IsAlgClosed.card_roots_eq_natDegree, cubicPolynomial_natDegree]
  obtain ⟨a, b, c, hroots⟩ := Multiset.card_eq_three.mp hcard
  have hfactor := (IsAlgClosed.splits (cubicPolynomial B)).eq_prod_roots_of_monic
    (cubicPolynomial_monic B)
  rw [hroots] at hfactor
  have h0 := congrArg (Polynomial.eval (0 : ℂ)) hfactor
  have h1 := congrArg (Polynomial.eval (1 : ℂ)) hfactor
  have hm := congrArg (Polynomial.eval (-1 : ℂ)) hfactor
  norm_num [cubicPolynomial] at h0 h1 hm
  have hsum : a + b + c = 0 := by
    linear_combination (1 / 2) * h1 + (1 / 2) * hm - h0
  have hpair : a * b + a * c + b * c = -3 := by
    linear_combination (1 / 2) * hm - (1 / 2) * h1
  have hneg : a.re < 0 ∨ b.re < 0 ∨ c.re < 0 := by
    by_contra h
    push Not at h
    have hsre := congrArg Complex.re hsum
    have hsim := congrArg Complex.im hsum
    have hpre := congrArg Complex.re hpair
    simp only [Complex.add_re, Complex.zero_re] at hsre
    have ha : a.re = 0 := by linarith
    have hb : b.re = 0 := by linarith
    have hc : c.re = 0 := by linarith
    norm_num [Complex.mul_re, ha, hb, hc] at hpre
    simp only [Complex.add_im, Complex.zero_im] at hsim
    have hsq := congrArg (fun t : ℝ => t ^ 2) hsim
    norm_num at hsq
    nlinarith [sq_nonneg a.im, sq_nonneg b.im, sq_nonneg c.im]
  have ha : (cubicPolynomial B).eval a = 0 := by rw [hfactor]; simp
  have hb : (cubicPolynomial B).eval b = 0 := by rw [hfactor]; simp
  have hc : (cubicPolynomial B).eval c = 0 := by rw [hfactor]; simp
  rcases hneg with h | h | h
  · exact ⟨a, ha, h⟩
  · exact ⟨b, hb, h⟩
  · exact ⟨c, hc, h⟩

/-- With Re B nonnegative, a left-half-plane root lies strictly in the hyperbolic region. -/
theorem cubic_exists_root_left (B : ℂ) (hB : 0 ≤ B.re) :
    ∃ r : ℂ, (cubicPolynomial B).eval r = 0 ∧
      r.re < -1 ∧ 0 < 3 * r.re ^ 2 - r.im ^ 2 - 3 := by
  obtain ⟨r, hr, hre⟩ := cubic_exists_root_re_neg B
  have he : r.re * (r.re ^ 2 - 3 * r.im ^ 2 - 3) + B.re = 0 := by
    have h := congrArg Complex.re hr
    norm_num [cubicPolynomial, pow_succ, Complex.mul_re, Complex.mul_im] at h
    nlinarith [h]
  have hfactor : 0 ≤ r.re ^ 2 - 3 * r.im ^ 2 - 3 := by
    by_contra h
    have := mul_pos_of_neg_of_neg hre (lt_of_not_ge h)
    linarith
  have hr2 : 3 ≤ r.re ^ 2 := by nlinarith [sq_nonneg r.im]
  refine ⟨r, hr, ?_, ?_⟩
  · nlinarith
  · nlinarith [sq_nonneg r.im]

/-- Existence, not just a conditional pointwise estimate: an actual root component has
the positive curvature expression everywhere, below the minimum critical level. -/
theorem cubic_exists_component_curvature (B : ℂ) (c : ℝ)
    (hB : 0 ≤ B.re) (hc : 0 ≤ c) (hcrit : c ^ 2 < Complex.normSq (B - 2)) :
    ∃ r ∈ (cubicPolynomial B).rootSet ℂ,
      connectedComponentIn (Erdos1047.sublevelSet (cubicPolynomial B) c) r ∈
        Erdos1047.componentsIn (Erdos1047.sublevelSet (cubicPolynomial B) c) ∧
      ∀ z ∈ connectedComponentIn (Erdos1047.sublevelSet (cubicPolynomial B) c) r,
        (2 / 3 : ℝ) <
          (1 - (cubicPolynomial B).eval z * (cubicPolynomial B).derivative.derivative.eval z /
            ((cubicPolynomial B).derivative.eval z) ^ 2).re := by
  obtain ⟨r, hr, hregion⟩ := cubic_exists_root_left B hB
  have hrK : r ∈ Erdos1047.sublevelSet (cubicPolynomial B) c := by
    simpa [Erdos1047.sublevelSet, hr] using hc
  refine ⟨r, ?_, ⟨r, hrK, rfl⟩, ?_⟩
  · exact (cubicPolynomial_monic B).mem_rootSet.mpr (by simpa using hr)
  · exact cubic_curvature_on_component B c r hB hcrit hrK
      ((cubicBarrier_neg_iff r).mpr hregion)

/-! Wrapper for the final cubic upper-bound geometry.  Vieta supplies a left
    root, the subcritical barrier keeps its component in the left region, and
    the previously verified segment criterion turns the remaining universal
    chord estimate into an actual convex component. -/
theorem cubic_exists_convex_component_of_subcritical_chords
    (B : ℂ) (c : ℝ) (hB : 0 ≤ B.re) (hc : 0 ≤ c)
    (hcrit : c ^ 2 < Complex.normSq (B - 2))
    (hchord : ∀ {r : ℂ}, r ∈ (cubicPolynomial B).rootSet ℂ →
      cubicBarrier r < 0 →
      ∀ ⦃x y : ℂ⦄,
        x ∈ connectedComponentIn (sublevelSet (cubicPolynomial B) c) r →
        y ∈ connectedComponentIn (sublevelSet (cubicPolynomial B) c) r →
        ∀ t ∈ Set.Icc (0 : ℝ) 1,
          Complex.normSq (Erdos1047CubicBarrier.cubicValue B
            (x + (t : ℂ) * (y - x))) ≤ Complex.normSq (B - 2)) :
    ∃ t ∈ componentsIn (sublevelSet (cubicPolynomial B) c), Convex ℝ t := by
  obtain ⟨r, hrzero, hregion⟩ := cubic_exists_root_left B hB
  have hrroot : r ∈ (cubicPolynomial B).rootSet ℂ := by
    exact (cubicPolynomial_monic B).mem_rootSet.mpr (by simpa using hrzero)
  have hrK : r ∈ sublevelSet (cubicPolynomial B) c := by
    change ‖(cubicPolynomial B).eval r‖ ≤ c
    rw [hrzero, norm_zero]
    exact hc
  have hleft : cubicBarrier r < 0 := (cubicBarrier_neg_iff r).mpr hregion
  have hconv := cubic_component_convex_of_subcritical_chords B c r hB hcrit hrK hleft
    (hchord hrroot hleft)
  exact ⟨connectedComponentIn (sublevelSet (cubicPolynomial B) c) r,
    ⟨r, hrK, rfl⟩, hconv⟩

/-! The global chord hypothesis is no longer needed: the preceding gap
    propagation theorem supplies the chord bound on the actual left root
    component.  This wrapper is the form used by the eventual cubic count
    argument. -/
theorem cubic_exists_convex_component_of_subcritical
    (B : ℂ) (c : ℝ) (hB : 0 ≤ B.re) (hc : 0 ≤ c)
    (hcrit : c ^ 2 < Complex.normSq (B - 2)) :
    ∃ t ∈ componentsIn (sublevelSet (cubicPolynomial B) c), Convex ℝ t := by
  obtain ⟨r, hrzero, hregion⟩ := cubic_exists_root_left B hB
  have hrK : r ∈ sublevelSet (cubicPolynomial B) c := by
    change ‖(cubicPolynomial B).eval r‖ ≤ c
    rw [hrzero, norm_zero]
    exact hc
  have hleft : cubicBarrier r < 0 := (cubicBarrier_neg_iff r).mpr hregion
  have hconv := cubic_convex_of_subcritical B c r hB hcrit hrK hleft
  exact ⟨connectedComponentIn (sublevelSet (cubicPolynomial B) c) r,
    ⟨r, hrK, rfl⟩, hconv⟩

/- ## Exact cubic lower-bound witness -/

theorem p3Witness_eq_cubicPolynomial_three :
    Erdos1047CubicLower.p3Polynomial = cubicPolynomial 3 := by
  rfl

/-- The explicit cubic witness has exactly three components, matching its three roots. -/
theorem p3Witness_componentsIn_ncard :
    (Erdos1047.componentsIn (Erdos1047.sublevelSet
      Erdos1047CubicLower.p3Polynomial Erdos1047CubicLower.p3Level)).ncard = 3 := by
  simpa [Erdos1047CubicLower.componentsIn, Erdos1047CubicLower.sublevelSet,
    Erdos1047.componentsIn, Erdos1047.sublevelSet] using
      Erdos1047CubicLower.p3_componentsIn_ncard

theorem p3Witness_rootSet_ncard :
    (Erdos1047CubicLower.p3Polynomial.rootSet ℂ).ncard = 3 :=
  Erdos1047CubicLower.p3_rootSet_ncard

/-- Two conjugate components of the explicit cubic are certified non-convex by exact
rational line segments and an outside midpoint. -/
theorem p3Witness_two_le_nonconvex_ncard :
    2 ≤ {t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet
      Erdos1047CubicLower.p3Polynomial Erdos1047CubicLower.p3Level) |
      ¬ Convex ℝ t}.ncard := by
  simpa [Erdos1047CubicLower.componentsIn, Erdos1047CubicLower.sublevelSet,
    Erdos1047.componentsIn, Erdos1047.sublevelSet] using
      Erdos1047CubicLower.p3_two_le_nonconvex_ncard

/-- The already-proved cubic estimate applies throughout the isolated left component
of the explicit lower-bound witness. -/
theorem p3Witness_left_component_curvature :
    ∀ z ∈ connectedComponentIn
      (Erdos1047.sublevelSet Erdos1047CubicLower.p3Polynomial
        Erdos1047CubicLower.p3Level) Erdos1047CubicLower.p3LeftAnchor,
      (2 / 3 : ℝ) <
        (1 - Erdos1047CubicLower.p3Polynomial.eval z *
          Erdos1047CubicLower.p3Polynomial.derivative.derivative.eval z /
          (Erdos1047CubicLower.p3Polynomial.derivative.eval z) ^ 2).re := by
  rw [p3Witness_eq_cubicPolynomial_three]
  apply cubic_curvature_on_component (3 : ℂ) Erdos1047CubicLower.p3Level
    Erdos1047CubicLower.p3LeftAnchor
  · norm_num
  · norm_num [Erdos1047CubicLower.p3Level, Complex.normSq]
  · simpa [p3Witness_eq_cubicPolynomial_three,
      Erdos1047CubicLower.sublevelSet, Erdos1047.sublevelSet] using
        Erdos1047CubicLower.p3LeftAnchor_mem
  · rw [cubicBarrier_neg_iff]
    norm_num [Erdos1047CubicLower.p3LeftAnchor]

/-- The explicit cubic construction is reduced to one geometric fact: convexity of
its isolated left component. -/
theorem three_attainable_of_p3_left_convex
    (hleft : Convex ℝ (connectedComponentIn
      (Erdos1047.sublevelSet Erdos1047CubicLower.p3Polynomial
        Erdos1047CubicLower.p3Level) Erdos1047CubicLower.p3LeftAnchor)) :
    2 ∈ attainableNonConvexCounts 3 := by
  have hleft' : Convex ℝ (connectedComponentIn
      (Erdos1047CubicLower.sublevelSet Erdos1047CubicLower.p3Polynomial
        Erdos1047CubicLower.p3Level) Erdos1047CubicLower.p3LeftAnchor) := by
    simpa [Erdos1047CubicLower.sublevelSet, Erdos1047.sublevelSet] using hleft
  refine ⟨Erdos1047CubicLower.p3Polynomial, Erdos1047CubicLower.p3Level,
    Erdos1047CubicLower.p3Polynomial_monic,
    Erdos1047CubicLower.p3Polynomial_natDegree,
    by norm_num [Erdos1047CubicLower.p3Level], ?_, ?_⟩
  · rw [p3Witness_componentsIn_ncard, p3Witness_rootSet_ncard]
  · simpa [Erdos1047CubicLower.componentsIn, Erdos1047CubicLower.sublevelSet,
      Erdos1047.componentsIn, Erdos1047.sublevelSet] using
        Erdos1047CubicLower.p3_nonconvex_ncard_eq_two hleft'

/-- The isolated left component of the explicit cubic is convex. -/
theorem p3Witness_left_component_convex :
    Convex ℝ (connectedComponentIn
      (Erdos1047.sublevelSet Erdos1047CubicLower.p3Polynomial
        Erdos1047CubicLower.p3Level) Erdos1047CubicLower.p3LeftAnchor) := by
  simpa [Erdos1047CubicLower.sublevelSet, Erdos1047.sublevelSet] using
    Erdos1047CubicLower.p3Left_component_convex

/-- The exact cubic witness attains two non-convex components. -/
theorem three_attainable : 2 ∈ attainableNonConvexCounts 3 :=
  three_attainable_of_p3_left_convex p3Witness_left_component_convex

/-- A convex component makes the general counting upper bound strictly smaller. -/
theorem nonconvex_count_lt_degree_of_convex_component (f : ℂ[X]) (c : ℝ)
    (hf : f.Monic) (hn : 0 < f.natDegree)
    (hcount : (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard = (f.rootSet ℂ).ncard)
    (hconv : ∃ t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c), Convex ℝ t) :
    {t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c) | ¬ Convex ℝ t}.ncard < f.natDegree := by
  have hfin : (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).Finite := Set.finite_of_ncard_pos (by
    rw [hcount]
    exact rootSet_ncard_pos f hf hn)
  have hstrict : {t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c) | ¬ Convex ℝ t} ⊂
      Erdos1047.componentsIn (Erdos1047.sublevelSet f c) := by
    refine ⟨fun _ ht => ht.1, ?_⟩
    intro hreverse
    obtain ⟨t, ht, htconv⟩ := hconv
    exact (hreverse ht).2 htconv
  calc
    _ < (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard := Set.ncard_lt_ncard hstrict hfin
    _ = (f.rootSet ℂ).ncard := hcount
    _ ≤ f.natDegree := f.ncard_rootSet_le ℂ

/-- This isolates exactly what a convex-component theorem would supply for degree three. -/
theorem cubic_count_le_two_of_convex_component (f : ℂ[X]) (c : ℝ)
    (hf : f.Monic) (hdeg : f.natDegree = 3)
    (hcount : (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard = (f.rootSet ℂ).ncard)
    (hconv : ∃ t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c), Convex ℝ t) :
    {t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c) | ¬ Convex ℝ t}.ncard ≤ 2 := by
  have := nonconvex_count_lt_degree_of_convex_component f c hf (by omega) hcount hconv
  omega

/-! Conditional end-to-end centered-cubic upper bound.  This theorem composes
    the threshold collision reduction with the chord-to-convexity lemma and
    the component-count bookkeeping.  It is the exact remaining analytic
    interface for the centered branch; no cardinality argument is repeated in
    the final `attainable_le_proposed_answer_three` theorem. -/
theorem cubic_count_le_two_of_subcritical_chords_and_root_paths
    (B : ℂ) (c : ℝ) (hB : 0 ≤ B.re) (hc : 0 ≤ c)
    (hcount : (componentsIn (sublevelSet (cubicPolynomial B) c)).ncard = 3)
    (hroot : ((cubicPolynomial B).rootSet ℂ).ncard = 3)
    (himage : componentsIn (sublevelSet (cubicPolynomial B) c) =
      (fun r : ℂ ↦ connectedComponentIn
        (sublevelSet (cubicPolynomial B) c) r) ''
        (↑((cubicPolynomial B).rootSet ℂ) : Set ℂ))
    (hpaths : ∀ hge : Complex.normSq (B - 2) ≤ c ^ 2,
      ∃ r ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ s ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ γr γs : ℝ → ℂ, r ≠ s ∧
        ContinuousOn γr (Set.Icc (0 : ℝ) 1) ∧
        (∀ t ∈ Set.Ioo (0 : ℝ) 1,
          γr t ∈ sublevelSet (cubicPolynomial B) c) ∧
        γr 0 = r ∧ γr 1 = 1 ∧
        ContinuousOn γs (Set.Icc (0 : ℝ) 1) ∧
        (∀ t ∈ Set.Ioo (0 : ℝ) 1,
          γs t ∈ sublevelSet (cubicPolynomial B) c) ∧
        γs 0 = s ∧ γs 1 = 1)
    (hchord : ∀ {r : ℂ}, r ∈ (cubicPolynomial B).rootSet ℂ →
      cubicBarrier r < 0 →
      ∀ ⦃x y : ℂ⦄,
        x ∈ connectedComponentIn (sublevelSet (cubicPolynomial B) c) r →
        y ∈ connectedComponentIn (sublevelSet (cubicPolynomial B) c) r →
        ∀ t ∈ Set.Icc (0 : ℝ) 1,
          Complex.normSq (Erdos1047CubicBarrier.cubicValue B
            (x + (t : ℂ) * (y - x))) ≤ Complex.normSq (B - 2)) :
    {t ∈ componentsIn (sublevelSet (cubicPolynomial B) c) |
      ¬ Convex ℝ t}.ncard ≤ 2 := by
  have hcrit := cubic_three_components_forces_subcritical_of_two_paths_to_one
    hc hcount hroot himage hpaths
  have hconv := cubic_exists_convex_component_of_subcritical_chords
    B c hB hc hcrit hchord
  have hcount' : (componentsIn (sublevelSet (cubicPolynomial B) c)).ncard =
      ((cubicPolynomial B).rootSet ℂ).ncard := by omega
  exact cubic_count_le_two_of_convex_component (cubicPolynomial B) c
    (cubicPolynomial_monic B) (cubicPolynomial_natDegree B) hcount' hconv

/-! The same count bound with the chord premise removed.  This is the
    preferred interface after `cubic_convex_of_subcritical` was proved by
    continuous gap propagation. -/
theorem cubic_count_le_two_of_subcritical_and_root_paths
    (B : ℂ) (c : ℝ) (hB : 0 ≤ B.re) (hc : 0 ≤ c)
    (hcount : (componentsIn (sublevelSet (cubicPolynomial B) c)).ncard = 3)
    (hroot : ((cubicPolynomial B).rootSet ℂ).ncard = 3)
    (himage : componentsIn (sublevelSet (cubicPolynomial B) c) =
      (fun r : ℂ ↦ connectedComponentIn
        (sublevelSet (cubicPolynomial B) c) r) ''
        (↑((cubicPolynomial B).rootSet ℂ) : Set ℂ))
    (hpaths : ∀ hge : Complex.normSq (B - 2) ≤ c ^ 2,
      ∃ r ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ s ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ γr γs : ℝ → ℂ, r ≠ s ∧
        ContinuousOn γr (Set.Icc (0 : ℝ) 1) ∧
        (∀ t ∈ Set.Ioo (0 : ℝ) 1,
          γr t ∈ sublevelSet (cubicPolynomial B) c) ∧
        γr 0 = r ∧ γr 1 = 1 ∧
        ContinuousOn γs (Set.Icc (0 : ℝ) 1) ∧
        (∀ t ∈ Set.Ioo (0 : ℝ) 1,
          γs t ∈ sublevelSet (cubicPolynomial B) c) ∧
        γs 0 = s ∧ γs 1 = 1) :
    {t ∈ componentsIn (sublevelSet (cubicPolynomial B) c) |
      ¬ Convex ℝ t}.ncard ≤ 2 := by
  have hcrit := cubic_three_components_forces_subcritical_of_two_paths_to_one
    hc hcount hroot himage hpaths
  have hconv := cubic_exists_convex_component_of_subcritical
    B c hB hc hcrit
  have hcount' : (componentsIn (sublevelSet (cubicPolynomial B) c)).ncard =
      ((cubicPolynomial B).rootSet ℂ).ncard := by omega
  exact cubic_count_le_two_of_convex_component (cubicPolynomial B) c
    (cubicPolynomial_monic B) (cubicPolynomial_natDegree B) hcount' hconv

/-! The explicit straight segments above close the centered branch once the
    component-exhaustion certificate is available. -/
theorem cubic_count_le_two_of_centered_component_exhaustion
    (B : ℂ) (c : ℝ) (hB : 0 ≤ B.re) (hc : 0 ≤ c)
    (hcount : (componentsIn (sublevelSet (cubicPolynomial B) c)).ncard = 3)
    (hroot : ((cubicPolynomial B).rootSet ℂ).ncard = 3)
    (himage : componentsIn (sublevelSet (cubicPolynomial B) c) =
      (fun r : ℂ ↦ connectedComponentIn
        (sublevelSet (cubicPolynomial B) c) r) ''
        (↑((cubicPolynomial B).rootSet ℂ) : Set ℂ)) :
    {t ∈ componentsIn (sublevelSet (cubicPolynomial B) c) |
      ¬ Convex ℝ t}.ncard ≤ 2 := by
  apply cubic_count_le_two_of_subcritical_and_root_paths
    B c hB hc hcount hroot himage
  intro hge
  rcases cubic_two_root_paths_of_supercritical_exact hB hc hge hroot with
    ⟨r, hr, s, hs, γr, γs, hrs, hcr, hmr, hsr, her,
      hcs, hms, hss, hes⟩
  exact ⟨r, hr, s, hs, γr, γs, hrs, hcr, hmr, hsr, her,
    hcs, hms, hss, hes⟩

/-! A separability split for the cubic upper bound.  The non-separable branch is
already finite-cardinality bookkeeping: a cubic with a repeated root has at most two
distinct roots, hence at most two components under the target hypothesis. -/

theorem cubic_rootSet_ncard_eq_three_iff_separable
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3) :
    (f.rootSet ℂ).ncard = 3 ↔ f.Separable := by
  have h := Polynomial.card_rootSet_eq_natDegree_iff_of_splits
    (K := ℂ) hf.ne_zero (by simpa using (IsAlgClosed.splits f))
  simpa [hdeg] using h

theorem separable_cubic_normalization_cases
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3)
    (hsep : f.Separable) :
    (∃ d : ℂ, d ≠ 0 ∧
      d ^ 2 = -Erdos1047CubicNormalize.cubicLinear f / 3) ∨
      (Erdos1047CubicNormalize.cubicLinear f = 0 ∧
        Erdos1047CubicNormalize.cubicConstant f ≠ 0) := by
  exact Erdos1047CubicNormalize.monic_cubic_normalization_cases f hf hdeg hsep

theorem separable_cubic_normalized_rootSet_ncard
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3)
    (hsep : f.Separable) {d : ℂ} (hd0 : d ≠ 0)
    (hd : d ^ 2 = -Erdos1047CubicNormalize.cubicLinear f / 3) :
    ((Erdos1047CubicNormalize.normalizedCubic f d).rootSet ℂ).ncard = 3 := by
  calc
    ((Erdos1047CubicNormalize.normalizedCubic f d).rootSet ℂ).ncard =
        (f.rootSet ℂ).ncard :=
      Erdos1047CubicNormalize.affine_image_normalized_rootSet_ncard f hf hdeg hd0 hd
    _ = 3 := by
      have hcard : Fintype.card (f.rootSet ℂ) = f.natDegree :=
        Polynomial.card_rootSet_eq_natDegree hsep (IsAlgClosed.splits _)
      simpa [hdeg] using hcard

theorem affine_image_normalized_sublevelSet_eq
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3) {d : ℂ}
    (hd0 : d ≠ 0) (hd : d ^ 2 =
      -Erdos1047CubicNormalize.cubicLinear f / 3) (c : ℝ) :
    (fun z : ℂ => Erdos1047CubicNormalize.cubicCenter f + d * z) ''
        Erdos1047.sublevelSet (Erdos1047CubicNormalize.normalizedCubic f d) c =
      Erdos1047.sublevelSet f (‖d‖ ^ 3 * c) := by
  ext w
  constructor
  · rintro ⟨z, hz, rfl⟩
    change ‖f.eval (Erdos1047CubicNormalize.cubicCenter f + d * z)‖ ≤
      ‖d‖ ^ 3 * c
    change ‖(Erdos1047CubicNormalize.normalizedCubic f d).eval z‖ ≤ c at hz
    rw [Erdos1047CubicNormalize.monic_cubic_eval_normalized_as_polynomial
      f hf hdeg hd0 hd z, norm_mul, norm_pow]
    exact mul_le_mul_of_nonneg_left hz (by positivity)
  · intro hw
    change ‖f.eval w‖ ≤ ‖d‖ ^ 3 * c at hw
    let z : ℂ := (w - Erdos1047CubicNormalize.cubicCenter f) / d
    have hmap : Erdos1047CubicNormalize.cubicCenter f + d * z = w := by
      dsimp [z]
      field_simp [hd0]
      ring
    refine ⟨z, ?_, hmap⟩
    change ‖(Erdos1047CubicNormalize.normalizedCubic f d).eval z‖ ≤ c
    have hw' : ‖f.eval
        (Erdos1047CubicNormalize.cubicCenter f + d * z)‖ ≤ ‖d‖ ^ 3 * c := by
      rw [hmap]
      exact hw
    rw [Erdos1047CubicNormalize.monic_cubic_eval_normalized_as_polynomial
      f hf hdeg hd0 hd z, norm_mul, norm_pow] at hw'
    have hdnorm : 0 < ‖d‖ ^ 3 := by
      have : 0 < ‖d‖ := norm_pos_iff.mpr hd0
      positivity
    exact le_of_mul_le_mul_left hw' hdnorm

theorem convex_of_normalized_sublevel_convex
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3) {d : ℂ}
    (hd0 : d ≠ 0) (hd : d ^ 2 =
      -Erdos1047CubicNormalize.cubicLinear f / 3) (c : ℝ)
    (hconv : Convex ℝ (Erdos1047.sublevelSet
      (Erdos1047CubicNormalize.normalizedCubic f d) c)) :
    Convex ℝ (Erdos1047.sublevelSet f (‖d‖ ^ 3 * c)) := by
  rw [← affine_image_normalized_sublevelSet_eq f hf hdeg hd0 hd c]
  exact Erdos1047CubicNormalize.affine_image_convex hconv
    (Erdos1047CubicNormalize.cubicCenter f) d

theorem normalized_component_convex_iff
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3) {d : ℂ}
    (hd0 : d ≠ 0) (hd : d ^ 2 =
      -Erdos1047CubicNormalize.cubicLinear f / 3) (c : ℝ)
    {r : ℂ} (hr : r ∈ Erdos1047.sublevelSet
      (Erdos1047CubicNormalize.normalizedCubic f d) c) :
    Convex ℝ (connectedComponentIn (Erdos1047.sublevelSet f (‖d‖ ^ 3 * c))
      (Erdos1047CubicNormalize.cubicCenter f + d * r)) ↔
      Convex ℝ (connectedComponentIn
        (Erdos1047.sublevelSet (Erdos1047CubicNormalize.normalizedCubic f d) c) r) := by
  rw [← affine_image_normalized_sublevelSet_eq f hf hdeg hd0 hd c]
  exact Erdos1047CubicNormalize.affine_image_connectedComponentIn_convex_iff
    (Erdos1047CubicNormalize.cubicCenter f) d hd0 hr

/-! Components themselves commute with the affine similarity used above.  This
    bookkeeping lemma is useful when transporting the root-component image
    certificate from an arbitrary monic cubic to its centered normal form. -/
theorem affine_image_componentsIn_eq
    {S : Set ℂ} (center d : ℂ) (hd : d ≠ 0) :
    componentsIn ((fun z : ℂ => center + d * z) '' S) =
      (fun C : Set ℂ => (fun z : ℂ => center + d * z) '' C) ''
        componentsIn S := by
  ext C
  constructor
  · intro hC
    rcases hC with ⟨y, hy, rfl⟩
    rcases hy with ⟨x, hx, rfl⟩
    refine ⟨connectedComponentIn S x, ⟨x, hx, rfl⟩, ?_⟩
    exact Erdos1047CubicNormalize.affine_image_connectedComponentIn_eq
      center d hd hx
  · rintro ⟨D, ⟨x, hx, rfl⟩, rfl⟩
    refine ⟨center + d * x, ⟨x, hx, rfl⟩, ?_⟩
    exact Erdos1047CubicNormalize.affine_image_connectedComponentIn_eq
      center d hd hx

theorem affine_image_componentsIn_ncard
    {S : Set ℂ} (center d : ℂ) (hd : d ≠ 0) :
    (componentsIn ((fun z : ℂ => center + d * z) '' S)).ncard =
      (componentsIn S).ncard := by
  rw [affine_image_componentsIn_eq center d hd]
  apply Set.ncard_image_of_injective
  apply (Set.image_injective).2
  intro z w hzw
  apply mul_left_cancel₀ hd
  linear_combination hzw

theorem affine_image_nonconvex_components_ncard
    {S : Set ℂ} (center d : ℂ) (hd : d ≠ 0) :
    {t ∈ componentsIn ((fun z : ℂ => center + d * z) '' S) |
      ¬ Convex ℝ t}.ncard =
      {t ∈ componentsIn S | ¬ Convex ℝ t}.ncard := by
  let A : ℂ → ℂ := fun z => center + d * z
  have hAinj : Function.Injective A := by
    intro z w hzw
    apply mul_left_cancel₀ hd
    linear_combination hzw
  have hcomp : componentsIn (A '' S) =
      (fun C : Set ℂ => A '' C) '' componentsIn S := by
    simpa [A] using affine_image_componentsIn_eq center d hd
  have hfilter :
      {t ∈ componentsIn (A '' S) | ¬ Convex ℝ t} =
        (fun C : Set ℂ => A '' C) ''
          {t ∈ componentsIn S | ¬ Convex ℝ t} := by
    ext t
    constructor
    · intro ht
      have htcomp : t ∈ componentsIn (A '' S) := ht.1
      rw [hcomp] at htcomp
      rcases htcomp with ⟨C, hC, rfl⟩
      have hCnon : ¬ Convex ℝ C := by
        intro hCconv
        exact ht.2 ((Erdos1047CubicNormalize.affine_image_convex_iff
          center d hd).2 hCconv)
      exact ⟨C, ⟨hC, hCnon⟩, rfl⟩
    · rintro ⟨C, ⟨hC, hCnon⟩, rfl⟩
      refine ⟨?_, ?_⟩
      · rw [hcomp]
        exact ⟨C, hC, rfl⟩
      · intro hconv
        exact hCnon ((Erdos1047CubicNormalize.affine_image_convex_iff
          center d hd).1 hconv)
  rw [hfilter]
  exact Set.ncard_image_of_injective _ ((Set.image_injective).2 hAinj)

/-! The finite-component root exhaustion now closes the centered separable
cubic branch, once the normalization parameter is chosen with nonnegative
constant real part. -/
theorem separable_cubic_centered_upper_bound
    (f : ℂ[X]) (k : ℕ)
    (hf : f.Monic) (hdeg : f.natDegree = 3) (hsep : f.Separable)
    (cval : ℝ) (hcval : 0 < cval)
    (hcount : (componentsIn (Erdos1047.sublevelSet f cval)).ncard =
      (f.rootSet ℂ).ncard)
    (hkcount : {t ∈ componentsIn (Erdos1047.sublevelSet f cval) |
      ¬ Convex ℝ t}.ncard = k)
    {d B : ℂ} (hd0 : d ≠ 0)
    (hd : d ^ 2 = -Erdos1047CubicNormalize.cubicLinear f / 3)
    (hB : 0 ≤ B.re)
    (hnorm : Erdos1047CubicNormalize.normalizedCubic f d = cubicPolynomial B) :
    k ≤ 2 := by
  have hrootOrig : (f.rootSet ℂ).ncard = 3 :=
    (cubic_rootSet_ncard_eq_three_iff_separable f hf hdeg).2 hsep
  let c0 : ℝ := cval / ‖d‖ ^ 3
  have hdnorm : 0 < ‖d‖ ^ 3 := by
    have hdpos : 0 < ‖d‖ := norm_pos_iff.mpr hd0
    positivity
  have hc0 : 0 < c0 := by
    dsimp [c0]
    exact div_pos hcval hdnorm
  have hscaleval : ‖d‖ ^ 3 * c0 = cval := by
    dsimp [c0]
    field_simp
  have hcountN :
      (componentsIn (Erdos1047.sublevelSet
        (Erdos1047CubicNormalize.normalizedCubic f d) c0)).ncard = 3 := by
    have htrans := affine_image_componentsIn_ncard
      (S := Erdos1047.sublevelSet
        (Erdos1047CubicNormalize.normalizedCubic f d) c0)
      (Erdos1047CubicNormalize.cubicCenter f) d hd0
    rw [affine_image_normalized_sublevelSet_eq f hf hdeg hd0 hd c0] at htrans
    rw [hscaleval, hcount, hrootOrig] at htrans
    exact htrans.symm
  have hrootN :
      ((Erdos1047CubicNormalize.normalizedCubic f d).rootSet ℂ).ncard = 3 :=
    separable_cubic_normalized_rootSet_ncard f hf hdeg hsep hd0 hd
  have hdegN : 0 <
      (Erdos1047CubicNormalize.normalizedCubic f d).degree := by
    rw [degree_eq_natDegree
      (Erdos1047CubicNormalize.normalizedCubic_monic f d).ne_zero]
    rw [Erdos1047CubicNormalize.normalizedCubic_natDegree]
    norm_num
  have hfinN :
      (componentsIn (Erdos1047.sublevelSet
        (Erdos1047CubicNormalize.normalizedCubic f d) c0)).Finite :=
    Set.finite_of_ncard_pos (by rw [hcountN]; norm_num)
  have himageN := componentsIn_eq_image_rootSet_of_finite_components
    (Erdos1047CubicNormalize.normalizedCubic_monic f d) hdegN hc0 hfinN
  have hcountB :
      (componentsIn (Erdos1047.sublevelSet (cubicPolynomial B) c0)).ncard = 3 := by
    rw [← hnorm]
    exact hcountN
  have hrootB : ((cubicPolynomial B).rootSet ℂ).ncard = 3 := by
    rw [← hnorm]
    exact hrootN
  have himageB : componentsIn (Erdos1047.sublevelSet (cubicPolynomial B) c0) =
      (fun r : ℂ ↦ connectedComponentIn
        (Erdos1047.sublevelSet (cubicPolynomial B) c0) r) ''
        (↑((cubicPolynomial B).rootSet ℂ) : Set ℂ) := by
    rw [← hnorm]
    exact himageN
  have hboundB := cubic_count_le_two_of_centered_component_exhaustion
    B c0 hB (le_of_lt hc0) hcountB hrootB himageB
  have htransNon := affine_image_nonconvex_components_ncard
    (S := Erdos1047.sublevelSet
      (Erdos1047CubicNormalize.normalizedCubic f d) c0)
    (Erdos1047CubicNormalize.cubicCenter f) d hd0
  rw [affine_image_normalized_sublevelSet_eq f hf hdeg hd0 hd c0] at htransNon
  rw [hscaleval] at htransNon
  have hboundOrig :
      {t ∈ componentsIn (Erdos1047.sublevelSet f cval) |
        ¬ Convex ℝ t}.ncard ≤ 2 := by
    calc
      _ = {t ∈ componentsIn (Erdos1047.sublevelSet
          (Erdos1047CubicNormalize.normalizedCubic f d) c0) |
          ¬ Convex ℝ t}.ncard := htransNon
      _ = {t ∈ componentsIn (Erdos1047.sublevelSet (cubicPolynomial B) c0) |
          ¬ Convex ℝ t}.ncard := by rw [hnorm]
      _ ≤ 2 := hboundB
  rw [hkcount] at hboundOrig
  exact hboundOrig

theorem affine_image_root_component_image_eq
    {S T R Rf : Set ℂ} (center d : ℂ) (hd : d ≠ 0)
    (hset : (fun z : ℂ => center + d * z) '' S = T)
    (hroot : (fun z : ℂ => center + d * z) '' R = Rf)
    (hRsub : R ⊆ S)
    (himage : componentsIn T =
      (fun r : ℂ => connectedComponentIn T r) '' Rf) :
    componentsIn S =
      (fun r : ℂ => connectedComponentIn S r) '' R := by
  have hcomp : componentsIn T =
      (fun C : Set ℂ => (fun z : ℂ => center + d * z) '' C) ''
        componentsIn S := by
    rw [← hset]
    exact affine_image_componentsIn_eq center d hd
  have hmapinj : Function.Injective (fun z : ℂ => center + d * z) := by
    intro z w hzw
    apply mul_left_cancel₀ hd
    linear_combination hzw
  have hsetinj : Function.Injective
      (fun C : Set ℂ => (fun z : ℂ => center + d * z) '' C) :=
    (Set.image_injective).2 hmapinj
  ext C
  constructor
  · intro hC
    have hCm : (fun z : ℂ => center + d * z) '' C ∈ componentsIn T := by
      rw [hcomp]
      exact ⟨C, hC, rfl⟩
    rw [himage] at hCm
    rcases hCm with ⟨y, hy, hCy⟩
    have hy' : y ∈ (fun z : ℂ => center + d * z) '' R := by
      rw [hroot]
      exact hy
    rcases hy' with ⟨r, hr, rfl⟩
    have hcomp_r : (fun z : ℂ => center + d * z) ''
        connectedComponentIn S r = connectedComponentIn T (center + d * r) := by
      rw [← hset]
      exact Erdos1047CubicNormalize.affine_image_connectedComponentIn_eq
        center d hd (hRsub hr)
    have hCe : (fun z : ℂ => center + d * z) '' C =
        (fun z : ℂ => center + d * z) '' connectedComponentIn S r := by
      calc
        (fun z : ℂ => center + d * z) '' C =
            connectedComponentIn T (center + d * r) := hCy.symm
        _ = (fun z : ℂ => center + d * z) ''
            connectedComponentIn S r := hcomp_r.symm
    have hCeq : C = connectedComponentIn S r := hsetinj hCe
    exact ⟨r, hr, hCeq.symm⟩
  · rintro ⟨r, hr, rfl⟩
    exact ⟨r, hRsub hr, rfl⟩

/-! The regular-value branch of the normalized cubic is now completely
    automatic.  The only critical points are `±1`; below the smaller critical
    modulus, the generic covering-map exhaustion theorem applies. -/
theorem cubic_derivative_eval_eq_zero_iff (B z : ℂ) :
    (cubicPolynomial B).derivative.eval z = 0 ↔ z = 1 ∨ z = -1 := by
  constructor
  · intro hz
    have hz' : z ^ 2 - 1 = 0 := by
      norm_num [cubicPolynomial] at hz
      apply (mul_left_cancel₀ (show (3 : ℂ) ≠ 0 by norm_num))
      linear_combination hz
    have hz'' : z ^ 2 = 1 := sub_eq_zero.mp hz'
    exact (sq_eq_one_iff).mp hz''
  · intro hz
    rcases hz with rfl | rfl <;> norm_num [cubicPolynomial]

theorem cubic_closedBall_subset_regular_values_of_subcritical
    {B : ℂ} {c : ℝ} (hB : 0 ≤ B.re)
    (hcrit : c ^ 2 < Complex.normSq (B - 2)) :
    Metric.closedBall (0 : ℂ) c ⊆
      ((cubicPolynomial B).eval ''
        {u : ℂ | (cubicPolynomial B).derivative.eval u = 0})ᶜ := by
  apply closedBall_subset_regular_values_of_critical_value_norm_gt
  intro u hu
  rcases (cubic_derivative_eval_eq_zero_iff B u).mp hu with rfl | rfl
  · have hcrit' : c < ‖B - 2‖ := by
      rw [Complex.normSq_eq_norm_sq] at hcrit
      nlinarith [norm_nonneg (B - 2)]
    rw [cubicPolynomial_eval_one]
    exact hcrit'
  · have hcrit₂ : c ^ 2 < Complex.normSq (B + 2) :=
      cubic_subcritical_both_of_minus hB hcrit
    have hcrit₂' : c < ‖B + 2‖ := by
      rw [Complex.normSq_eq_norm_sq] at hcrit₂
      nlinarith [norm_nonneg (B + 2)]
    rw [cubicPolynomial_eval_neg_one]
    exact hcrit₂'

theorem cubic_component_exhaustion_of_subcritical
    {B : ℂ} {c : ℝ} (hB : 0 ≤ B.re) (hc : 0 ≤ c)
    (hcrit : c ^ 2 < Complex.normSq (B - 2)) :
    componentsIn (sublevelSet (cubicPolynomial B) c) =
      (fun r : ℂ ↦ connectedComponentIn
        (sublevelSet (cubicPolynomial B) c) r) ''
        (↑((cubicPolynomial B).rootSet ℂ) : Set ℂ) := by
  exact componentsIn_eq_image_rootSet_of_regular_values
    (cubicPolynomial_monic B) hc
    (cubic_closedBall_subset_regular_values_of_subcritical hB hcrit)

theorem affine_image_convex_component_of_normalized
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3) {d : ℂ}
    (hd0 : d ≠ 0) (hd : d ^ 2 =
      -Erdos1047CubicNormalize.cubicLinear f / 3) (c : ℝ)
    (hconv : ∃ t ∈ componentsIn (sublevelSet
      (Erdos1047CubicNormalize.normalizedCubic f d) c), Convex ℝ t) :
    ∃ t ∈ componentsIn (sublevelSet f (‖d‖ ^ 3 * c)), Convex ℝ t := by
  obtain ⟨t, ht, htc⟩ := hconv
  let A : ℂ → ℂ := fun z => Erdos1047CubicNormalize.cubicCenter f + d * z
  have hset : A '' sublevelSet
      (Erdos1047CubicNormalize.normalizedCubic f d) c =
      sublevelSet f (‖d‖ ^ 3 * c) := by
    simpa [A] using affine_image_normalized_sublevelSet_eq f hf hdeg hd0 hd c
  have hmem : A '' t ∈ componentsIn (sublevelSet f (‖d‖ ^ 3 * c)) := by
    rw [← hset]
    rw [affine_image_componentsIn_eq
      (Erdos1047CubicNormalize.cubicCenter f) d hd0]
    exact ⟨t, ht, rfl⟩
  refine ⟨A '' t, hmem, ?_⟩
  exact Erdos1047CubicNormalize.affine_image_convex htc
    (Erdos1047CubicNormalize.cubicCenter f) d

/- An analytic inverse-branch theorem is the remaining interface needed for the
   separable cubic upper bound.  The geometric content is isolated in `hconv`; the
   rest is purely component bookkeeping and is fully formalizable in the target. -/
theorem convex_component_of_continuous_inverse_section
    (g : ℂ[X]) (c : ℝ) (F : ℂ → ℂ) (r : ℂ)
    (hFcont : ContinuousOn F (Metric.closedBall (0 : ℂ) c))
    (hFmem : ∀ w ∈ Metric.closedBall (0 : ℂ) c,
      F w ∈ Erdos1047.sublevelSet g c)
    (hFr : F 0 = r)
    (hsection : ∀ z ∈ connectedComponentIn
      (Erdos1047.sublevelSet g c) r, F (g.eval z) = z)
    (hconv : Convex ℝ (F '' Metric.closedBall (0 : ℂ) c))
    (hr : r ∈ Erdos1047.sublevelSet g c) :
    Convex ℝ (connectedComponentIn (Erdos1047.sublevelSet g c) r) := by
  let D : Set ℂ := Metric.closedBall (0 : ℂ) c
  let K : Set ℂ := Erdos1047.sublevelSet g c
  let C : Set ℂ := connectedComponentIn K r
  have hc0 : 0 ≤ c := by
    have hr' : ‖g.eval r‖ ≤ c := hr
    exact le_trans (norm_nonneg _) hr'
  have hDconv : Convex ℝ D := by
    dsimp [D]
    exact convex_closedBall _ _
  have hDpre : IsPreconnected D := hDconv.isPreconnected
  have hImpre : IsPreconnected (F '' D) := hDpre.image F hFcont
  have hrIm : r ∈ F '' D := by
    refine ⟨0, ?_, hFr⟩
    dsimp [D]
    simp [Metric.mem_closedBall, hc0]
  have hImsub : F '' D ⊆ C := by
    apply hImpre.subset_connectedComponentIn hrIm
    rintro z ⟨w, hw, rfl⟩
    exact hFmem w hw
  have hCsub : C ⊆ F '' D := by
    intro z hz
    have hzK : z ∈ K := connectedComponentIn_subset K r hz
    change ‖g.eval z‖ ≤ c at hzK
    have hzD : g.eval z ∈ D := by
      simpa [D, Metric.mem_closedBall, dist_zero_right] using hzK
    exact ⟨g.eval z, hzD, hsection z hz⟩
  have hCeq : C = F '' D := Set.Subset.antisymm hCsub hImsub
  change Convex ℝ C
  rw [hCeq]
  exact hconv

/-! If the relevant component is path-connected, uniqueness of lifts for the
    polynomial covering upgrades a continuous inverse branch on the value disk
    to a genuine section on the whole component.  This is the precise bridge
    needed before applying `convex_component_of_continuous_inverse_section`;
    no unproved branch-selection principle is hidden in the statement. -/
theorem inverse_section_of_path_connected_component
    {f : ℂ[X]} {c : ℝ} (hf : f.Monic)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ)
    (F : ℂ → ℂ) (r : ℂ)
    (hFcont : ContinuousOn F (Metric.closedBall (0 : ℂ) c))
    (hFmem : ∀ w ∈ Metric.closedBall (0 : ℂ) c,
      F w ∈ sublevelSet f c)
    (hFr : F 0 = r)
    (hFeval : ∀ w ∈ Metric.closedBall (0 : ℂ) c, f.eval (F w) = w)
    (hr : r ∈ sublevelSet f c)
    (hpath : IsPathConnected
      (connectedComponentIn (sublevelSet f c) r)) :
    ∀ z ∈ connectedComponentIn (sublevelSet f c) r, F (f.eval z) = z := by
  intro z hz
  have hzK : z ∈ sublevelSet f c := connectedComponentIn_subset _ _ hz
  have hc0 : 0 ≤ c := (norm_nonneg (f.eval r)).trans hr
  have hrC : r ∈ connectedComponentIn (sublevelSet f c) r :=
    mem_connectedComponentIn hr
  obtain ⟨γ, hγ⟩ := (hpath.joinedIn r hrC z hz)
  let β : C(I, ℂ) := (γ.map f.continuous).toContinuousMap
  have hβD : ∀ t : I, β t ∈ Metric.closedBall (0 : ℂ) c := by
    intro t
    have hzt : γ t ∈ connectedComponentIn (sublevelSet f c) r :=
      hγ t
    have hK := connectedComponentIn_subset _ _ hzt
    change ‖f.eval (γ t)‖ ≤ c at hK
    simpa [β, Metric.mem_closedBall, dist_zero_right] using hK
  have hβreg : ∀ t : I, β t ∈
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ := by
    intro t
    exact hreg (hβD t)
  letI : ContractibleSpace I := by
    exact (convex_Icc (0 : ℝ) 1).contractibleSpace
      ⟨(0 : ℝ), by norm_num, by norm_num⟩
  letI : LocallyPathConnectedSpace I := by
    exact (convex_Icc (0 : ℝ) 1).locallyPathConnectedSpace
  have hstart : f.eval r = β 0 := by
    have h0 := hFeval 0 (by simpa [Metric.mem_closedBall] using hc0)
    rw [hFr] at h0
    simpa [β] using h0.symm
  obtain ⟨G, hG, hGuniq⟩ :=
    (Polynomial.isCoveringMapOn_eval f).existsUnique_continuousMap_lifts
      β (a₀ := (0 : I)) (e₀ := r) hstart hβreg
  have hγeq : γ.toContinuousMap = G := by
    apply hGuniq
    constructor
    · simpa using γ.source
    · apply _root_.funext
      intro t
      change f.eval (γ t) = β t
      rfl
  have hFcomp : Continuous (F ∘ β) := by
    apply hFcont.comp_continuous β.continuous
    exact hβD
  let H : C(I, ℂ) := ⟨F ∘ β, hFcomp⟩
  have hH0 : H 0 = r := by
    change F (β 0) = r
    have hroot : f.eval r = 0 := by
      rw [← hFr]
      exact hFeval 0 (by simpa [Metric.mem_closedBall] using hc0)
    rw [← hstart, hroot]
    exact hFr
  have hHlift : f.eval ∘ H = β := by
    apply _root_.funext
    intro t
    change f.eval (F (β t)) = β t
    exact hFeval (β t) (hβD t)
  have hHeq : H = G := hGuniq H ⟨hH0, hHlift⟩
  have hG1 : G (⟨1, by norm_num⟩ : I) = z := by
    rw [← hγeq]
    simpa using γ.target
  have hlast := congrFun (congrArg DFunLike.coe hHeq) (⟨1, by norm_num⟩ : I)
  change F (β (⟨1, by norm_num⟩ : I)) = G (⟨1, by norm_num⟩ : I) at hlast
  rw [hG1] at hlast
  simpa [β] using hlast

/-! A small topological interface used by the cubic paper proof.  It avoids
   unfolding `connectedComponentIn`: once every segment joining two points of
   a component stays in the ambient sublevel set, the component is convex. -/
theorem convex_connectedComponentIn_of_segment_subset
    (S : Set ℂ) (r : ℂ)
    (hseg : ∀ ⦃x y : ℂ⦄,
      x ∈ connectedComponentIn S r → y ∈ connectedComponentIn S r →
        segment ℝ x y ⊆ S) :
    Convex ℝ (connectedComponentIn S r) := by
  rw [convex_iff_segment_subset]
  intro x hx y hy
  rw [connectedComponentIn_eq hx]
  apply (convex_segment x y).isPreconnected.subset_connectedComponentIn
    (left_mem_segment ℝ x y)
  exact hseg hx hy

/-! On an open component, ambient local path-connectedness upgrades the
    connected-component statement to the path-connected hypothesis required by
    the covering-map lift bridge.  This is intentionally conditional: the
    actual closed sublevel components still need a separate regular-boundary
    argument to establish openness (or path-connectedness directly). -/
theorem pathConnected_component_of_isOpen
    {S : Set ℂ} {r : ℂ}
    (hr : r ∈ S) (hop : IsOpen (connectedComponentIn S r)) :
    IsPathConnected (connectedComponentIn S r) := by
  exact hop.isConnected_iff_isPathConnected.mp
    (isConnected_connectedComponentIn_iff.mpr hr)

/-! Fully composed interface: once a continuous inverse branch has convex
    image and the relevant component is path-connected, the component itself is
    convex.  The only analytic inputs are the regular-value condition, the
    branch section on the value disk, and convexity of the branch image. -/
theorem convex_component_of_path_connected_inverse_section
    {f : ℂ[X]} {c : ℝ} (hf : f.Monic)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ)
    (F : ℂ → ℂ) (r : ℂ)
    (hFcont : ContinuousOn F (Metric.closedBall (0 : ℂ) c))
    (hFmem : ∀ w ∈ Metric.closedBall (0 : ℂ) c,
      F w ∈ sublevelSet f c)
    (hFr : F 0 = r)
    (hFeval : ∀ w ∈ Metric.closedBall (0 : ℂ) c, f.eval (F w) = w)
    (hr : r ∈ sublevelSet f c)
    (hpath : IsPathConnected
      (connectedComponentIn (sublevelSet f c) r))
    (hconv : Convex ℝ (F '' Metric.closedBall (0 : ℂ) c)) :
    Convex ℝ (connectedComponentIn (sublevelSet f c) r) := by
  apply convex_component_of_continuous_inverse_section
    f c F r hFcont hFmem hFr ?_ hconv hr
  exact inverse_section_of_path_connected_component
    hf hreg F r hFcont hFmem hFr hFeval hr hpath

theorem cubic_witness_count_le_two_of_nonseparable
    (f : ℂ[X]) (c : ℝ) (k : ℕ)
    (hf : f.Monic) (hdeg : f.natDegree = 3)
    (hcount : (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard =
      (f.rootSet ℂ).ncard)
    (hk : {t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c) |
      ¬ Convex ℝ t}.ncard = k)
    (hsep : ¬ f.Separable) : k ≤ 2 := by
  have hroot_le : (f.rootSet ℂ).ncard ≤ 3 := by
    calc
      (f.rootSet ℂ).ncard ≤ f.natDegree := f.ncard_rootSet_le ℂ
      _ = 3 := hdeg
  have hroot_ne : (f.rootSet ℂ).ncard ≠ 3 := by
    intro hroot
    exact hsep ((cubic_rootSet_ncard_eq_three_iff_separable f hf hdeg).mp hroot)
  have hroot_le_two : (f.rootSet ℂ).ncard ≤ 2 := by omega
  have hfin : (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).Finite :=
    Set.finite_of_ncard_pos (by
      rw [hcount]
      exact rootSet_ncard_pos f hf (by omega))
  calc
    k = {t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c) |
        ¬ Convex ℝ t}.ncard := hk.symm
    _ ≤ (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard :=
      Set.ncard_le_ncard (by intro t ht; exact ht.1) hfin
    _ = (f.rootSet ℂ).ncard := hcount
    _ ≤ 2 := hroot_le_two

/-! Target-level bridge to the lightweight tuned degree-raising core. -/
theorem tuned_degree_raise_center_certificate
    (p : ℂ[X]) (L d : ℂ) (hpL : p.eval L ≠ 0) :
    (Erdos1047TunedRaise.tunedRaisePolynomial p L
      (Erdos1047TunedRaise.tunedRaiseSlope p L d) d).eval L = p.eval L * d ∧
      (Erdos1047TunedRaise.tunedRaisePolynomial p L
        (Erdos1047TunedRaise.tunedRaiseSlope p L d) d).derivative.eval L = 0 :=
  Erdos1047TunedRaise.tunedRaisePolynomial_center_certificate p L d hpL

/-! Target-level aliases for the exact local Taylor coefficients at the
    tuned raising centre.  These are algebraic only; the later geometric
    proof must still establish the required sign and separation inequalities. -/
theorem tuned_degree_raise_second_derivative_eval_center
    (p : ℂ[X]) (L A d : ℂ) :
    (Erdos1047TunedRaise.tunedRaisePolynomial p L A d).derivative.derivative.eval L / 2 =
      p.derivative.derivative.eval L / 2 * d +
        p.derivative.eval L * A + p.eval L :=
  Erdos1047TunedRaise.tunedRaisePolynomial_second_derivative_eval_center p L A d

theorem tuned_degree_raise_third_derivative_eval_center
    (p : ℂ[X]) (L A d : ℂ) :
    (Erdos1047TunedRaise.tunedRaisePolynomial p L A d).derivative.derivative.derivative.eval L / 6 =
      p.derivative.derivative.derivative.eval L / 6 * d +
        p.derivative.derivative.eval L / 2 * A +
          p.derivative.eval L :=
  Erdos1047TunedRaise.tunedRaisePolynomial_third_derivative_eval_center p L A d

theorem tuned_degree_raise_complex_root_coordinates_of_real_disc_pos
    {L A d : ℝ} (hdisc : A ^ 2 / 4 < d) :
    let q : ℝ := Real.sqrt (d - A ^ 2 / 4)
    let rPlus : ℂ := (L - A / 2 : ℂ) + (q : ℂ) * Complex.I
    let rMinus : ℂ := (L - A / 2 : ℂ) - (q : ℂ) * Complex.I
    (Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval rPlus = 0 ∧
      (Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval rMinus = 0 ∧
      rPlus ≠ rMinus :=
  Erdos1047TunedRaise.tunedRaiseFactor_complex_root_coordinates_of_real_disc_pos hdisc

theorem tuned_degree_raise_real_discriminant_pos
    {a b v : ℝ} (ha : 0 < a) (hv : 0 < v)
    (hsmall : v * b ^ 2 < 4 * a ^ 3) :
    (-(b * v / a ^ 2)) ^ 2 / 4 < v / a :=
  Erdos1047TunedRaise.real_tuned_discriminant_pos ha hv hsmall

theorem tuned_degree_raise_center_data_of_real_parameters
    {p : ℂ[X]} {L a b v : ℝ}
    (hval : p.eval (L : ℂ) = (a : ℂ))
    (hderiv : p.derivative.eval (L : ℂ) = (b : ℂ))
    (ha : 0 < a) (hv : 0 < v)
    (hsmall : v * b ^ 2 < 4 * a ^ 3) :
    let d : ℝ := v / a
    let A : ℝ := -(b * v / a ^ 2)
    (Erdos1047TunedRaise.tunedRaisePolynomial p (L : ℂ) (A : ℂ) (d : ℂ)).eval (L : ℂ) = (v : ℂ) ∧
      (Erdos1047TunedRaise.tunedRaisePolynomial p (L : ℂ) (A : ℂ) (d : ℂ)).derivative.eval (L : ℂ) = 0 ∧
      A ^ 2 / 4 < d :=
  Erdos1047TunedRaise.tunedRaise_center_data_of_real_parameters
    hval hderiv ha hv hsmall

/-! Target-level aliases for the quartic degree-raising gadget.  The gadget is
an algebraic `p₄` translate/scale; its geometric four-component transport is
still a separate obligation. -/
theorem quartic_raise_factor_monic (L s : ℂ) :
    (Erdos1047QuarticRaise.quarticRaiseFactor L s).Monic :=
  Erdos1047QuarticRaise.quarticRaiseFactor_monic L s

theorem quartic_raise_factor_separable {L s : ℂ} (hs : s ≠ 0) :
    (Erdos1047QuarticRaise.quarticRaiseFactor L s).Separable :=
  Erdos1047QuarticRaise.quarticRaiseFactor_separable hs

theorem quartic_raise_factor_rootSet_ncard {L s : ℂ} (hs : s ≠ 0) :
    ((Erdos1047QuarticRaise.quarticRaiseFactor L s).rootSet ℂ).ncard = 4 :=
  Erdos1047QuarticRaise.quarticRaiseFactor_rootSet_ncard hs

theorem quartic_raise_polynomial_rootSet_ncard
    (p : ℂ[X]) (L s : ℂ) (hp : p.Monic) (hpsep : p.Separable)
    (hs : s ≠ 0)
    (hcop : IsCoprime p (Erdos1047QuarticRaise.quarticRaiseFactor L s)) :
    ((Erdos1047QuarticRaise.quarticRaisePolynomial p L s).rootSet ℂ).ncard =
      p.natDegree + 4 :=
  Erdos1047QuarticRaise.quarticRaisePolynomial_rootSet_ncard
    p L s hp hpsep hs hcop

/-! The translated/scaled quartic factor is pointwise the affine image of the
    already verified Goodman quartic.  This identity is the bridge needed to
    reuse its robust non-convex certificates. -/
theorem quartic_raise_factor_eval_affine_p4
    {L s w : ℂ} :
    (Erdos1047QuarticRaise.quarticRaiseFactor L s).eval (L + s * w) =
      s ^ 4 * p4Polynomial.eval w := by
  rw [Erdos1047QuarticRaise.quarticRaiseFactor_eval]
  simp [p4Polynomial]
  ring

theorem quartic_raise_factor_robust_certificate
    {L s : ℝ} (hs : 0 < s) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ =>
        (Erdos1047QuarticRaise.quarticRaiseFactor (L : ℂ) (s : ℂ)).eval z)
      (p4Level * s ^ 4)
      ((L : ℂ) + (s : ℂ) * p4Anchor)
      ((L : ℂ) + (s : ℂ) * p4PointA)
      ((L : ℂ) + (s : ℂ) * p4PointB)) := by
  obtain ⟨hbase⟩ := p4_robust_certificate
  obtain ⟨hcert⟩ := robustNonconvexCertificate_of_real_affine_scaled
    (F := fun z : ℂ => p4Polynomial.eval z) hbase hs
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hs)
  have heval : ∀ z : ℂ,
      (Erdos1047QuarticRaise.quarticRaiseFactor (L : ℂ) (s : ℂ)).eval z =
        (s : ℂ) ^ 4 * p4Polynomial.eval ((z - (L : ℂ)) / (s : ℂ)) := by
    intro z
    rw [Erdos1047QuarticRaise.quarticRaiseFactor_eval]
    simp [p4Polynomial]
    field_simp [hs0]
  simpa only [heval] using (Nonempty.intro hcert)

/-! Local-chart transport for the four new components.  If the old polynomial
    is uniformly close to a positive scalar `α` on the compact witness chart,
    then the quartic factor's robust p₄ certificate transfers to the product.
    The analytic task is isolated in the three `hA`, `hB`, and `hM` hypotheses. -/
theorem quartic_raise_new_region_robust_certificate_of_local_close
    {p : ℂ[X]} {L s α δ : ℝ} {r a b : ℂ}
    (hα : 0 < α) (hs : 0 < s)
    (hbase : RobustNonconvexCertificate
      (fun w : ℂ => p4Polynomial.eval w) p4Level r a b)
    (hδ : 0 ≤ δ) (hδlt : δ < hbase.eps)
    (hA : ∀ w ∈ segment ℝ r a,
      ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) * p4Polynomial.eval w -
          p4Polynomial.eval w‖ ≤ δ)
    (hB : ∀ w ∈ segment ℝ r b,
      ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) * p4Polynomial.eval w -
          p4Polynomial.eval w‖ ≤ δ)
    (hM : ‖p.eval ((L : ℂ) + (s : ℂ) * midpoint ℝ a b) / (α : ℂ) *
        p4Polynomial.eval (midpoint ℝ a b) -
          p4Polynomial.eval (midpoint ℝ a b)‖ ≤ δ) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ =>
        (Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) (s : ℂ)).eval z)
      (α * p4Level * s ^ 4)
      ((L : ℂ) + (s : ℂ) * r)
      ((L : ℂ) + (s : ℂ) * a)
      ((L : ℂ) + (s : ℂ) * b)) := by
  let G : ℂ → ℂ := fun w =>
    p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) * p4Polynomial.eval w
  have hGA : ∀ w ∈ segment ℝ r a, ‖G w - p4Polynomial.eval w‖ ≤ δ := by
    intro w hw
    simpa [G] using hA w hw
  have hGB : ∀ w ∈ segment ℝ r b, ‖G w - p4Polynomial.eval w‖ ≤ δ := by
    intro w hw
    simpa [G] using hB w hw
  have hGM : ‖G (midpoint ℝ a b) - p4Polynomial.eval (midpoint ℝ a b)‖ ≤ δ := by
    simpa [G] using hM
  obtain ⟨hG⟩ := RobustNonconvexCertificate.of_uniform_close hbase hδ hδlt hGA hGB hGM
  obtain ⟨hαG⟩ := RobustNonconvexCertificate.of_pos_real_scalar hG hα
  obtain ⟨htrans⟩ := robustNonconvexCertificate_of_real_affine_scaled hαG hs
  refine ⟨?_⟩
  convert htrans using 1
  funext z
  dsimp [G]
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hs)
  have hα0 : (α : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hα)
  let w : ℂ := (z - (L : ℂ)) / (s : ℂ)
  have hchart : (L : ℂ) + (s : ℂ) * w = z := by
    dsimp [w]
    field_simp [hs0]
    ring
  have hchart' : (L : ℂ) + (s : ℂ) * ((z - (L : ℂ)) / (s : ℂ)) = z := by
    simpa [w] using hchart
  have hq : (Erdos1047QuarticRaise.quarticRaiseFactor (L : ℂ) (s : ℂ)).eval z =
      (s : ℂ) ^ 4 * p4Polynomial.eval w := by
    rw [← hchart]
    exact quartic_raise_factor_eval_affine_p4
  have hq' : ((z - (L : ℂ)) ^ 2 - (s : ℂ) ^ 2) ^ 2 + (s : ℂ) ^ 4 =
      (s : ℂ) ^ 4 * p4Polynomial.eval w := by
    simpa [Erdos1047QuarticRaise.quarticRaiseFactor_eval] using hq
  rw [Erdos1047QuarticRaise.quarticRaisePolynomial_eval]
  rw [hq']
  rw [hchart']
  field_simp [hα0, hs0]
  ring

/-! A compact-chart front-end for the preceding local theorem.  Instead of
    checking the product error separately on the two witness segments and at
    their midpoint, it is enough to bound the scalar factor uniformly on one
    set containing those three pieces and to bound the p₄ factor there. -/
theorem quartic_raise_new_region_robust_certificate_of_compact_close
    {p : ℂ[X]} {L s α δ η M : ℝ} {r a b : ℂ}
    (hα : 0 < α) (hs : 0 < s)
    (hbase : RobustNonconvexCertificate
      (fun w : ℂ => p4Polynomial.eval w) p4Level r a b)
    (K : Set ℂ)
    (hsegA : segment ℝ r a ⊆ K)
    (hsegB : segment ℝ r b ⊆ K)
    (hmid : midpoint ℝ a b ∈ K)
    (hclose : ∀ w ∈ K,
      ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) - 1‖ ≤ η)
    (hp4bound : ∀ w ∈ K, ‖p4Polynomial.eval w‖ ≤ M)
    (hη : 0 ≤ η) (hM : 0 ≤ M) (hηM : η * M ≤ δ)
    (hδ : 0 ≤ δ) (hδlt : δ < hbase.eps) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ =>
        (Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) (s : ℂ)).eval z)
      (α * p4Level * s ^ 4)
      ((L : ℂ) + (s : ℂ) * r)
      ((L : ℂ) + (s : ℂ) * a)
      ((L : ℂ) + (s : ℂ) * b)) := by
  apply quartic_raise_new_region_robust_certificate_of_local_close
    hα hs hbase hδ hδlt
  · intro w hw
    have hfac := hclose w (hsegA hw)
    have hp4 := hp4bound w (hsegA hw)
    calc
      ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) * p4Polynomial.eval w -
          p4Polynomial.eval w‖ =
          ‖(p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) - 1) *
            p4Polynomial.eval w‖ := by congr 1 <;> ring
      _ = ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) - 1‖ *
            ‖p4Polynomial.eval w‖ := norm_mul _ _
      _ ≤ η * M := mul_le_mul hfac hp4 (norm_nonneg _) hη
      _ ≤ δ := hηM
  · intro w hw
    have hfac := hclose w (hsegB hw)
    have hp4 := hp4bound w (hsegB hw)
    calc
      ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) * p4Polynomial.eval w -
          p4Polynomial.eval w‖ =
          ‖(p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) - 1) *
            p4Polynomial.eval w‖ := by congr 1 <;> ring
      _ = ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) - 1‖ *
            ‖p4Polynomial.eval w‖ := norm_mul _ _
      _ ≤ η * M := mul_le_mul hfac hp4 (norm_nonneg _) hη
      _ ≤ δ := hηM
  · have hfac := hclose (midpoint ℝ a b) hmid
    have hp4 := hp4bound (midpoint ℝ a b) hmid
    calc
      ‖p.eval ((L : ℂ) + (s : ℂ) * midpoint ℝ a b) / (α : ℂ) *
          p4Polynomial.eval (midpoint ℝ a b) -
          p4Polynomial.eval (midpoint ℝ a b)‖ =
          ‖(p.eval ((L : ℂ) + (s : ℂ) * midpoint ℝ a b) / (α : ℂ) - 1) *
            p4Polynomial.eval (midpoint ℝ a b)‖ := by congr 1 <;> ring
      _ = ‖p.eval ((L : ℂ) + (s : ℂ) * midpoint ℝ a b) / (α : ℂ) - 1‖ *
            ‖p4Polynomial.eval (midpoint ℝ a b)‖ := norm_mul _ _
      _ ≤ η * M := mul_le_mul hfac hp4 (norm_nonneg _) hη
      _ ≤ δ := hηM

/-! A common-scale version for all four p₄ symmetry branches.  The compact
    chart is the finite union of the four two-segment witness charts.  This
    is still a local non-convexity statement: no claim about separation from
    old components is made here. -/
theorem exists_quartic_raise_new_region_robust_certificates_of_center_value_pos
    (p : ℂ[X]) {L α : ℝ} (hα : 0 < α)
    (hL : p.eval (L : ℂ) = (α : ℂ)) :
    ∃ s : ℝ, 0 < s ∧
      (Nonempty (RobustNonconvexCertificate
        (fun z : ℂ =>
          (Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) (s : ℂ)).eval z)
        (α * p4Level * s ^ 4)
        ((L : ℂ) + (s : ℂ) * p4Anchor)
        ((L : ℂ) + (s : ℂ) * p4PointA)
        ((L : ℂ) + (s : ℂ) * p4PointB)) ∧
      Nonempty (RobustNonconvexCertificate
        (fun z : ℂ =>
          (Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) (s : ℂ)).eval z)
        (α * p4Level * s ^ 4)
        ((L : ℂ) + (s : ℂ) * star p4Anchor)
        ((L : ℂ) + (s : ℂ) * star p4PointA)
        ((L : ℂ) + (s : ℂ) * star p4PointB)) ∧
      Nonempty (RobustNonconvexCertificate
        (fun z : ℂ =>
          (Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) (s : ℂ)).eval z)
        (α * p4Level * s ^ 4)
        ((L : ℂ) + (s : ℂ) * (-p4Anchor))
        ((L : ℂ) + (s : ℂ) * (-p4PointA))
        ((L : ℂ) + (s : ℂ) * (-p4PointB))) ∧
      Nonempty (RobustNonconvexCertificate
        (fun z : ℂ =>
          (Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) (s : ℂ)).eval z)
        (α * p4Level * s ^ 4)
        ((L : ℂ) + (s : ℂ) * (-star p4Anchor))
        ((L : ℂ) + (s : ℂ) * (-star p4PointA))
        ((L : ℂ) + (s : ℂ) * (-star p4PointB))) ) := by
  obtain ⟨h0, h1, h2, h3⟩ := p4_four_robust_certificates
  obtain ⟨h0⟩ := h0
  obtain ⟨h1⟩ := h1
  obtain ⟨h2⟩ := h2
  obtain ⟨h3⟩ := h3
  let K0 : Set ℂ :=
    (segment ℝ p4Anchor p4PointA ∪ segment ℝ p4Anchor p4PointB) ∪
      ({midpoint ℝ p4PointA p4PointB} : Set ℂ)
  let K1 : Set ℂ :=
    (segment ℝ (star p4Anchor) (star p4PointA) ∪
      segment ℝ (star p4Anchor) (star p4PointB)) ∪
      ({midpoint ℝ (star p4PointA) (star p4PointB)} : Set ℂ)
  let K2 : Set ℂ :=
    (segment ℝ (-p4Anchor) (-p4PointA) ∪
      segment ℝ (-p4Anchor) (-p4PointB)) ∪
      ({midpoint ℝ (-p4PointA) (-p4PointB)} : Set ℂ)
  let K3 : Set ℂ :=
    (segment ℝ (-star p4Anchor) (-star p4PointA) ∪
      segment ℝ (-star p4Anchor) (-star p4PointB)) ∪
      ({midpoint ℝ (-star p4PointA) (-star p4PointB)} : Set ℂ)
  let K : Set ℂ := K0 ∪ (K1 ∪ (K2 ∪ K3))
  have hseg : ∀ x y : ℂ, IsCompact (segment ℝ x y) := by
    intro x y
    rw [segment_eq_image]
    exact isCompact_Icc.image (by fun_prop)
  have hK0 : IsCompact K0 := by
    dsimp [K0]
    exact (hseg _ _).union (hseg _ _) |>.union isCompact_singleton
  have hK1 : IsCompact K1 := by
    dsimp [K1]
    exact (hseg _ _).union (hseg _ _) |>.union isCompact_singleton
  have hK2 : IsCompact K2 := by
    dsimp [K2]
    exact (hseg _ _).union (hseg _ _) |>.union isCompact_singleton
  have hK3 : IsCompact K3 := by
    dsimp [K3]
    exact (hseg _ _).union (hseg _ _) |>.union isCompact_singleton
  have hK : IsCompact K := by
    dsimp [K]
    exact hK0.union (hK1.union (hK2.union hK3))
  have hseg0A : segment ℝ p4Anchor p4PointA ⊆ K := by
    intro z hz
    exact Or.inl (Or.inl (Or.inl hz))
  have hseg0B : segment ℝ p4Anchor p4PointB ⊆ K := by
    intro z hz
    exact Or.inl (Or.inl (Or.inr hz))
  have hmid0 : midpoint ℝ p4PointA p4PointB ∈ K := by
    exact Or.inl (Or.inr (Set.mem_singleton _))
  have hseg1A : segment ℝ (star p4Anchor) (star p4PointA) ⊆ K := by
    intro z hz
    exact Or.inr (Or.inl (Or.inl (Or.inl hz)))
  have hseg1B : segment ℝ (star p4Anchor) (star p4PointB) ⊆ K := by
    intro z hz
    exact Or.inr (Or.inl (Or.inl (Or.inr hz)))
  have hmid1 : midpoint ℝ (star p4PointA) (star p4PointB) ∈ K := by
    exact Or.inr (Or.inl (Or.inr (Set.mem_singleton _)))
  have hseg2A : segment ℝ (-p4Anchor) (-p4PointA) ⊆ K := by
    intro z hz
    exact Or.inr (Or.inr (Or.inl (Or.inl (Or.inl hz))))
  have hseg2B : segment ℝ (-p4Anchor) (-p4PointB) ⊆ K := by
    intro z hz
    exact Or.inr (Or.inr (Or.inl (Or.inl (Or.inr hz))))
  have hmid2 : midpoint ℝ (-p4PointA) (-p4PointB) ∈ K := by
    exact Or.inr (Or.inr (Or.inl (Or.inr (Set.mem_singleton _))))
  have hseg3A : segment ℝ (-star p4Anchor) (-star p4PointA) ⊆ K := by
    intro z hz
    exact Or.inr (Or.inr (Or.inr (Or.inl (Or.inl hz))))
  have hseg3B : segment ℝ (-star p4Anchor) (-star p4PointB) ⊆ K := by
    intro z hz
    exact Or.inr (Or.inr (Or.inr (Or.inl (Or.inr hz))))
  have hmid3 : midpoint ℝ (-star p4PointA) (-star p4PointB) ∈ K := by
    exact Or.inr (Or.inr (Or.inr (Or.inr (Set.mem_singleton _))))
  obtain ⟨M, hM⟩ := hK.exists_bound_of_continuousOn
    p4Polynomial.continuous.continuousOn
  have hM0 : 0 ≤ M := by
    exact (norm_nonneg (p4Polynomial.eval p4Anchor)).trans
      (hM p4Anchor (hseg0A (left_mem_segment ℝ p4Anchor p4PointA)))
  let epsMin : ℝ := min h0.eps (min h1.eps (min h2.eps h3.eps))
  have hepsMin : 0 < epsMin := by
    dsimp [epsMin]
    exact lt_min h0.eps_pos
      (lt_min h1.eps_pos (lt_min h2.eps_pos h3.eps_pos))
  let δ : ℝ := epsMin / 2
  have hδ : 0 ≤ δ := by
    dsimp [δ]
    linarith
  have hδlt0 : δ < h0.eps := by
    have hmin : epsMin ≤ h0.eps := by
      dsimp [epsMin]
      exact min_le_left _ _
    dsimp [δ]
    linarith
  have hδlt1 : δ < h1.eps := by
    have hmin : epsMin ≤ h1.eps := by
      dsimp [epsMin]
      exact (min_le_right _ _).trans (min_le_left _ _)
    dsimp [δ]
    linarith
  have hδlt2 : δ < h2.eps := by
    have hmin : epsMin ≤ h2.eps := by
      dsimp [epsMin]
      exact (min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _))
    dsimp [δ]
    linarith
  have hδlt3 : δ < h3.eps := by
    have hmin : epsMin ≤ h3.eps := by
      dsimp [epsMin]
      exact (min_le_right _ _).trans
        ((min_le_right _ _).trans (min_le_right _ _))
    dsimp [δ]
    linarith
  let η : ℝ := δ / (M + 1)
  have hMplus : 0 < M + 1 := by linarith
  have hη : 0 < η := by
    dsimp [η]
    have hδpos : 0 < δ := by
      dsimp [δ]
      linarith [hepsMin]
    exact div_pos hδpos hMplus
  have hMη : η * M ≤ δ := by
    have hMle : M ≤ M + 1 := by linarith
    dsimp [η]
    rw [div_mul_eq_mul_div]
    apply (div_le_iff₀ hMplus).2
    nlinarith [mul_le_mul_of_nonneg_left hMle hδ]
  obtain ⟨s, hs, hclose⟩ :=
    Erdos1047DegreeRaise.exists_pos_real_local_scale_close_on_compact
      p hα hL K hK η hη
  have hclose' : ∀ w ∈ K,
      ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) - 1‖ ≤ η := by
    intro w hw
    exact (hclose w hw).le
  obtain ⟨hc0⟩ := quartic_raise_new_region_robust_certificate_of_compact_close
    hα hs h0 K hseg0A hseg0B hmid0 hclose' hM hη.le hM0 hMη hδ hδlt0
  obtain ⟨hc1⟩ := quartic_raise_new_region_robust_certificate_of_compact_close
    hα hs h1 K hseg1A hseg1B hmid1 hclose' hM hη.le hM0 hMη hδ hδlt1
  obtain ⟨hc2⟩ := quartic_raise_new_region_robust_certificate_of_compact_close
    hα hs h2 K hseg2A hseg2B hmid2 hclose' hM hη.le hM0 hMη hδ hδlt2
  obtain ⟨hc3⟩ := quartic_raise_new_region_robust_certificate_of_compact_close
    hα hs h3 K hseg3A hseg3B hmid3 hclose' hM hη.le hM0 hMη hδ hδlt3
  exact ⟨s, hs, ⟨⟨hc0⟩, ⟨hc1⟩, ⟨hc2⟩, ⟨hc3⟩⟩⟩

/-! A concrete existence wrapper for one quartic new-region witness.  The
    compact chart is the union of the two p₄ witness segments and their
    midpoint.  Continuity at a real centre with positive value supplies a
    sufficiently small chart scale; the remaining geometric separation is
    intentionally not folded into this local statement. -/
theorem exists_quartic_raise_new_region_robust_certificate_of_center_value_pos
    (p : ℂ[X]) {L α : ℝ} (hα : 0 < α)
    (hL : p.eval (L : ℂ) = (α : ℂ)) :
    ∃ s : ℝ, 0 < s ∧
      Nonempty (RobustNonconvexCertificate
        (fun z : ℂ =>
          (Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) (s : ℂ)).eval z)
        (α * p4Level * s ^ 4)
        ((L : ℂ) + (s : ℂ) * p4Anchor)
        ((L : ℂ) + (s : ℂ) * p4PointA)
        ((L : ℂ) + (s : ℂ) * p4PointB)) := by
  obtain ⟨hbase⟩ := p4_robust_certificate
  let K : Set ℂ :=
    (segment ℝ p4Anchor p4PointA ∪ segment ℝ p4Anchor p4PointB) ∪
      ({midpoint ℝ p4PointA p4PointB} : Set ℂ)
  have hK : IsCompact K := by
    dsimp [K]
    have hseg : ∀ x y : ℂ, IsCompact (segment ℝ x y) := by
      intro x y
      rw [segment_eq_image]
      exact isCompact_Icc.image (by fun_prop)
    exact (hseg p4Anchor p4PointA).union
      (hseg p4Anchor p4PointB) |>.union isCompact_singleton
  have hsegA : segment ℝ p4Anchor p4PointA ⊆ K := by
    intro w hw
    exact Or.inl (Or.inl hw)
  have hsegB : segment ℝ p4Anchor p4PointB ⊆ K := by
    intro w hw
    exact Or.inl (Or.inr hw)
  have hmid : midpoint ℝ p4PointA p4PointB ∈ K := by
    exact Or.inr (Set.mem_singleton _)
  obtain ⟨M, hM⟩ := hK.exists_bound_of_continuousOn
    p4Polynomial.continuous.continuousOn
  have hM0 : 0 ≤ M := by
    exact (norm_nonneg (p4Polynomial.eval p4Anchor)).trans
      (hM p4Anchor (hsegA (left_mem_segment ℝ p4Anchor p4PointA)))
  let δ : ℝ := hbase.eps / 2
  have hδ : 0 ≤ δ := by
    dsimp [δ]
    linarith [hbase.eps_pos]
  have hδlt : δ < hbase.eps := by
    dsimp [δ]
    linarith [hbase.eps_pos]
  let η : ℝ := δ / (M + 1)
  have hMplus : 0 < M + 1 := by linarith
  have hη : 0 < η := by
    dsimp [η]
    exact div_pos (by dsimp [δ]; linarith [hbase.eps_pos]) hMplus
  have hMη : η * M ≤ δ := by
    have hMle : M ≤ M + 1 := by linarith
    dsimp [η]
    rw [div_mul_eq_mul_div]
    apply (div_le_iff₀ hMplus).2
    nlinarith [mul_le_mul_of_nonneg_left hMle hδ]
  obtain ⟨s, hs, hclose⟩ :=
    Erdos1047DegreeRaise.exists_pos_real_local_scale_close_on_compact
      p hα hL K hK η hη
  have hclose' : ∀ w ∈ K,
      ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) - 1‖ ≤ η := by
    intro w hw
    exact (hclose w hw).le
  obtain ⟨hcert⟩ := quartic_raise_new_region_robust_certificate_of_compact_close
    hα hs hbase K hsegA hsegB hmid hclose' hM hη.le hM0 hMη hδ hδlt
  exact ⟨s, hs, ⟨hcert⟩⟩

/-! The preceding local construction applies directly at the real point `1`
    of the explicit p₅ polynomial, where its value is the positive witness
    level.  This gives a fully checked degree-nine local four-component
    certificate (without yet asserting global component separation). -/
theorem exists_p5_quartic_new_region_robust_certificate :
    ∃ s : ℝ, 0 < s ∧
      Nonempty (RobustNonconvexCertificate
        (fun z : ℂ =>
          (Erdos1047QuarticRaise.quarticRaisePolynomial p5Polynomial
            (1 : ℂ) (s : ℂ)).eval z)
        (p5Level * p4Level * s ^ 4)
        ((1 : ℂ) + (s : ℂ) * p4Anchor)
        ((1 : ℂ) + (s : ℂ) * p4PointA)
        ((1 : ℂ) + (s : ℂ) * p4PointB)) := by
  have hα : 0 < p5Level := by norm_num [p5Level]
  simpa using
    (exists_quartic_raise_new_region_robust_certificate_of_center_value_pos
      p5Polynomial hα p5_eval_one)

/-! The four symmetry branches of the Goodman quartic are packaged as a
    finite certificate family.  This separates the finite bookkeeping from
    the local analytic transport used by quartic degree raising. -/
def quarticFourAnchor (i : Fin 4) : ℂ :=
  match i.1 with
  | 0 => p4Anchor
  | 1 => star p4Anchor
  | 2 => -p4Anchor
  | _ => -star p4Anchor

def quarticFourPointA (i : Fin 4) : ℂ :=
  match i.1 with
  | 0 => p4PointA
  | 1 => star p4PointA
  | 2 => -p4PointA
  | _ => -star p4PointA

def quarticFourPointB (i : Fin 4) : ℂ :=
  match i.1 with
  | 0 => p4PointB
  | 1 => star p4PointB
  | 2 => -p4PointB
  | _ => -star p4PointB

def quarticRaisedFourAnchor (L s : ℂ) (i : Fin 4) : ℂ :=
  L + s * quarticFourAnchor i

def quarticRaisedFourPointA (L s : ℂ) (i : Fin 4) : ℂ :=
  L + s * quarticFourPointA i

def quarticRaisedFourPointB (L s : ℂ) (i : Fin 4) : ℂ :=
  L + s * quarticFourPointB i

def quarticRaisedFourCertificateFamily
    (F : ℂ → ℂ) (c : ℝ) (L s : ℂ) : Prop :=
  ∀ i : Fin 4, Nonempty (RobustNonconvexCertificate F c
    (quarticRaisedFourAnchor L s i) (quarticRaisedFourPointA L s i)
    (quarticRaisedFourPointB L s i))

def quarticFourCertificateFamily (F : ℂ → ℂ) (c : ℝ) : Prop :=
  ∀ i : Fin 4, Nonempty (RobustNonconvexCertificate F c
    (quarticFourAnchor i) (quarticFourPointA i) (quarticFourPointB i))

theorem quarticFourAnchor_injective : Function.Injective quarticFourAnchor := by
  intro i j hij
  fin_cases i <;> fin_cases j
  all_goals
    first
    | rfl
    | exfalso
      solve
      | have h := congrArg Complex.re hij
        norm_num [quarticFourAnchor, p4Anchor] at h
      | have h := congrArg Complex.im hij
        norm_num [quarticFourAnchor, p4Anchor] at h

theorem quarticRaisedFourAnchor_injective {L s : ℂ} (hs : s ≠ 0) :
    Function.Injective (quarticRaisedFourAnchor L s) := by
  intro i j hij
  apply quarticFourAnchor_injective
  apply mul_left_cancel₀ hs
  dsimp [quarticRaisedFourAnchor] at hij
  linear_combination hij

theorem quartic_certificate_family_nonconvex_lower_bound
    {F : ℂ → ℂ} {c : ℝ}
    (hcert : quarticFourCertificateFamily F c)
    (hcompInj : Set.InjOn (fun z : ℂ => connectedComponentIn
      {w : ℂ | ‖F w‖ ≤ c} z) (Set.range quarticFourAnchor))
    (hcompfin : (componentsIn {w : ℂ | ‖F w‖ ≤ c}).Finite) :
    4 ≤ {t ∈ componentsIn {w : ℂ | ‖F w‖ ≤ c} |
      ¬ Convex ℝ t}.ncard := by
  let S : Set ℂ := {w : ℂ | ‖F w‖ ≤ c}
  let A : Set ℂ := Set.range quarticFourAnchor
  have hAfin : A.Finite := Set.finite_range _
  have hAcard : A.ncard = 4 := by
    rw [Set.ncard_range_of_injective quarticFourAnchor_injective]
    simp
  have hmem_i : ∀ i : Fin 4, quarticFourAnchor i ∈ S := by
    intro i
    obtain ⟨hc⟩ := hcert i
    have hm := hc.lineA_margin (quarticFourAnchor i)
      (left_mem_segment ℝ (quarticFourAnchor i) (quarticFourPointA i))
    change ‖F (quarticFourAnchor i)‖ ≤ c
    linarith [hm, hc.eps_pos]
  have hmem : ∀ z ∈ A, z ∈ S := by
    rintro z ⟨i, rfl⟩
    exact hmem_i i
  have hnc : ∀ z ∈ A, ¬ Convex ℝ (connectedComponentIn S z) := by
    rintro z ⟨i, rfl⟩
    obtain ⟨hc⟩ := hcert i
    have hnc' := hc.not_convex_component
    simpa [S] using hnc'
  have hcompInj' : Set.InjOn
      (fun z : ℂ => connectedComponentIn S z) A := by
    simpa [S] using hcompInj
  have hcompfin' : (componentsIn S).Finite := by
    simpa [S] using hcompfin
  simpa [S, A] using
    (nonconvex_ncard_ge_of_finite_witnesses hAfin hAcard hmem
      hcompInj' hnc hcompfin')

theorem quartic_raised_certificate_family_nonconvex_lower_bound
    {F : ℂ → ℂ} {c : ℝ} {L s : ℂ}
    (hs : s ≠ 0)
    (hcert : quarticRaisedFourCertificateFamily F c L s)
    (hcompInj : Set.InjOn (fun z : ℂ => connectedComponentIn
      {w : ℂ | ‖F w‖ ≤ c} z) (Set.range (quarticRaisedFourAnchor L s)))
    (hcompfin : (componentsIn {w : ℂ | ‖F w‖ ≤ c}).Finite) :
    4 ≤ {t ∈ componentsIn {w : ℂ | ‖F w‖ ≤ c} |
      ¬ Convex ℝ t}.ncard := by
  let S : Set ℂ := {w : ℂ | ‖F w‖ ≤ c}
  let A : Set ℂ := Set.range (quarticRaisedFourAnchor L s)
  have hAfin : A.Finite := Set.finite_range _
  have hAcard : A.ncard = 4 := by
    rw [Set.ncard_range_of_injective (quarticRaisedFourAnchor_injective hs)]
    simp
  have hmem_i : ∀ i : Fin 4, quarticRaisedFourAnchor L s i ∈ S := by
    intro i
    obtain ⟨hc⟩ := hcert i
    have hm := hc.lineA_margin (quarticRaisedFourAnchor L s i)
      (left_mem_segment ℝ (quarticRaisedFourAnchor L s i)
        (quarticRaisedFourPointA L s i))
    change ‖F (quarticRaisedFourAnchor L s i)‖ ≤ c
    linarith [hm, hc.eps_pos]
  have hmem : ∀ z ∈ A, z ∈ S := by
    rintro z ⟨i, rfl⟩
    exact hmem_i i
  have hnc : ∀ z ∈ A, ¬ Convex ℝ (connectedComponentIn S z) := by
    rintro z ⟨i, rfl⟩
    obtain ⟨hc⟩ := hcert i
    have hnc' := hc.not_convex_component
    simpa [S] using hnc'
  have hcompInj' : Set.InjOn
      (fun z : ℂ => connectedComponentIn S z) A := by
    simpa [S] using hcompInj
  have hcompfin' : (componentsIn S).Finite := by
    simpa [S] using hcompfin
  simpa [S, A] using
    (nonconvex_ncard_ge_of_finite_witnesses hAfin hAcard hmem
      hcompInj' hnc hcompfin')

theorem p4_four_robust_certificate_family :
    quarticFourCertificateFamily (fun z : ℂ => p4Polynomial.eval z) p4Level := by
  obtain ⟨h0, h1, h2, h3⟩ := p4_four_robust_certificates
  intro i
  fin_cases i
  · simpa [quarticFourCertificateFamily, quarticFourAnchor,
      quarticFourPointA, quarticFourPointB] using h0
  · simpa [quarticFourCertificateFamily, quarticFourAnchor,
      quarticFourPointA, quarticFourPointB] using h1
  · simpa [quarticFourCertificateFamily, quarticFourAnchor,
      quarticFourPointA, quarticFourPointB] using h2
  · simpa [quarticFourCertificateFamily, quarticFourAnchor,
      quarticFourPointA, quarticFourPointB] using h3

/-! Repackage the common-scale four-certificate construction in the named
    family interface.  The only remaining input for a global lower bound is
    the component-map injectivity and finiteness of the raised sublevel set. -/
theorem exists_quartic_raise_four_certificate_family_of_center_value_pos
    (p : ℂ[X]) {L α : ℝ} (hα : 0 < α)
    (hL : p.eval (L : ℂ) = (α : ℂ)) :
    ∃ s : ℝ, 0 < s ∧
      quarticRaisedFourCertificateFamily
        (fun z : ℂ =>
          (Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) (s : ℂ)).eval z)
        (α * p4Level * s ^ 4) (L : ℂ) (s : ℂ) := by
  obtain ⟨s, hs, ⟨h0, h1, h2, h3⟩⟩ :=
    exists_quartic_raise_new_region_robust_certificates_of_center_value_pos
      p hα hL
  refine ⟨s, hs, ?_⟩
  intro i
  fin_cases i
  · simpa [quarticRaisedFourCertificateFamily, quarticRaisedFourAnchor,
      quarticRaisedFourPointA, quarticRaisedFourPointB, quarticFourAnchor,
      quarticFourPointA, quarticFourPointB] using h0
  · simpa [quarticRaisedFourCertificateFamily, quarticRaisedFourAnchor,
      quarticRaisedFourPointA, quarticRaisedFourPointB, quarticFourAnchor,
      quarticFourPointA, quarticFourPointB] using h1
  · simpa [quarticRaisedFourCertificateFamily, quarticRaisedFourAnchor,
      quarticRaisedFourPointA, quarticRaisedFourPointB, quarticFourAnchor,
      quarticFourPointA, quarticFourPointB] using h2
  · simpa [quarticRaisedFourCertificateFamily, quarticRaisedFourAnchor,
      quarticRaisedFourPointA, quarticRaisedFourPointB, quarticFourAnchor,
      quarticFourPointA, quarticFourPointB] using h3

theorem quartic_raise_four_nonconvex_lower_bound_of_component_data
    (p : ℂ[X]) {L α : ℝ} (hα : 0 < α)
    (hL : p.eval (L : ℂ) = (α : ℂ))
    (hgeom : ∀ s : ℝ, 0 < s →
      Set.InjOn (fun z : ℂ => connectedComponentIn
        {w : ℂ |
          ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) (s : ℂ)).eval w‖ ≤
            α * p4Level * s ^ 4} z)
        (Set.range (quarticRaisedFourAnchor (L : ℂ) (s : ℂ))) ∧
      (componentsIn {w : ℂ |
        ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) (s : ℂ)).eval w‖ ≤
          α * p4Level * s ^ 4}).Finite) :
    ∃ s : ℝ, 0 < s ∧ 4 ≤ {t ∈ componentsIn {w : ℂ |
      ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) (s : ℂ)).eval w‖ ≤
        α * p4Level * s ^ 4} | ¬ Convex ℝ t}.ncard := by
  obtain ⟨s, hs, hcert⟩ :=
    exists_quartic_raise_four_certificate_family_of_center_value_pos p hα hL
  obtain ⟨hinj, hfin⟩ := hgeom s hs
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hs)
  exact ⟨s, hs, quartic_raised_certificate_family_nonconvex_lower_bound
    hs0 hcert hinj hfin⟩

/-! Explicit p₅ instance of the four-branch family.  The centre `L=1` has
    the positive value `p5Level`, so the local quartic insertion supplies all
    four robust non-convex witnesses at one common raised level. -/
theorem exists_p5_quartic_four_certificate_family :
    ∃ s : ℝ, 0 < s ∧
      quarticRaisedFourCertificateFamily
        (fun z : ℂ =>
          (Erdos1047QuarticRaise.quarticRaisePolynomial p5Polynomial
            (1 : ℂ) (s : ℂ)).eval z)
        (p5Level * p4Level * s ^ 4) (1 : ℂ) (s : ℂ) := by
  have hα : 0 < p5Level := by norm_num [p5Level]
  simpa using
    (exists_quartic_raise_four_certificate_family_of_center_value_pos
      p5Polynomial hα p5_eval_one)

theorem p5_quartic_raise_four_nonconvex_lower_bound_of_component_data
    (hgeom : ∀ s : ℝ, 0 < s →
      Set.InjOn (fun z : ℂ => connectedComponentIn
        {w : ℂ |
          ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p5Polynomial
              (1 : ℂ) (s : ℂ)).eval w‖ ≤ p5Level * p4Level * s ^ 4} z)
        (Set.range (quarticRaisedFourAnchor (1 : ℂ) (s : ℂ))) ∧
      (componentsIn {w : ℂ |
        ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p5Polynomial
            (1 : ℂ) (s : ℂ)).eval w‖ ≤ p5Level * p4Level * s ^ 4}).Finite) :
    ∃ s : ℝ, 0 < s ∧ 4 ≤ {t ∈ componentsIn {w : ℂ |
      ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p5Polynomial
          (1 : ℂ) (s : ℂ)).eval w‖ ≤ p5Level * p4Level * s ^ 4} |
      ¬ Convex ℝ t}.ncard := by
  obtain ⟨s, hs, hcert⟩ := exists_p5_quartic_four_certificate_family
  obtain ⟨hinj, hfin⟩ := hgeom s hs
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hs)
  exact ⟨s, hs, quartic_raised_certificate_family_nonconvex_lower_bound
    hs0 hcert hinj hfin⟩

/-! At a positive real scale, the quartic factor's sublevel set is exactly an
    affine image of the verified Goodman quartic sublevel set. -/
theorem quartic_raise_factor_sublevelSet_eq_affine_image
    {L s : ℝ} (hs : 0 < s) :
    Erdos1047.sublevelSet
        (Erdos1047QuarticRaise.quarticRaiseFactor (L : ℂ) (s : ℂ))
        (p4Level * s ^ 4) =
      (fun w : ℂ => (L : ℂ) + (s : ℂ) * w) ''
        Erdos1047.sublevelSet p4Polynomial p4Level := by
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hs)
  have hs4 : 0 < s ^ 4 := by positivity
  ext z
  constructor
  · intro hz
    change ‖(Erdos1047QuarticRaise.quarticRaiseFactor (L : ℂ) (s : ℂ)).eval z‖ ≤
      p4Level * s ^ 4 at hz
    let w : ℂ := (z - (L : ℂ)) / (s : ℂ)
    have hmap : (L : ℂ) + (s : ℂ) * w = z := by
      dsimp [w]
      field_simp [hs0]
      ring
    refine ⟨w, ?_, hmap⟩
    change ‖p4Polynomial.eval w‖ ≤ p4Level
    have heval := quartic_raise_factor_eval_affine_p4
      (L := (L : ℂ)) (s := (s : ℂ)) (w := w)
    have hq :
        (Erdos1047QuarticRaise.quarticRaiseFactor (L : ℂ) (s : ℂ)).eval z =
          (s : ℂ) ^ 4 * p4Polynomial.eval w := by
      rw [← hmap]
      exact heval
    rw [hq, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hs] at hz
    nlinarith
  · rintro ⟨w, hw, rfl⟩
    change ‖(Erdos1047QuarticRaise.quarticRaiseFactor (L : ℂ) (s : ℂ)).eval
      ((L : ℂ) + (s : ℂ) * w)‖ ≤ p4Level * s ^ 4
    rw [quartic_raise_factor_eval_affine_p4, norm_mul, norm_pow,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos hs]
    change ‖p4Polynomial.eval w‖ ≤ p4Level at hw
    nlinarith

theorem quartic_raise_factor_componentsIn_ncard
    {L s : ℝ} (hs : 0 < s) :
    (Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047QuarticRaise.quarticRaiseFactor (L : ℂ) (s : ℂ))
        (p4Level * s ^ 4))).ncard = 4 := by
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hs)
  rw [quartic_raise_factor_sublevelSet_eq_affine_image hs]
  rw [affine_image_componentsIn_ncard (L : ℂ) (s : ℂ) hs0]
  exact p4_componentsIn_ncard

theorem quartic_raise_factor_nonconvex_components_ncard
    {L s : ℝ} (hs : 0 < s) :
    {t ∈ Erdos1047.componentsIn
        (Erdos1047.sublevelSet
          (Erdos1047QuarticRaise.quarticRaiseFactor (L : ℂ) (s : ℂ))
          (p4Level * s ^ 4)) |
      ¬ Convex ℝ t}.ncard = 4 := by
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hs)
  rw [quartic_raise_factor_sublevelSet_eq_affine_image hs]
  rw [affine_image_nonconvex_components_ncard (L : ℂ) (s : ℂ) hs0]
  have h := p4_nonconvex_ncard_of_components_ncard p4_componentsIn_ncard
  exact h

theorem quartic_raise_factor_attainable
    {L s : ℝ} (hs : 0 < s) :
    4 ∈ attainableNonConvexCounts 4 := by
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hs)
  let q : ℂ[X] :=
    Erdos1047QuarticRaise.quarticRaiseFactor (L : ℂ) (s : ℂ)
  have hqmonic : q.Monic := by
    dsimp [q]
    exact Erdos1047QuarticRaise.quarticRaiseFactor_monic _ _
  have hqdeg : q.natDegree = 4 := by
    dsimp [q]
    exact Erdos1047QuarticRaise.quarticRaiseFactor_natDegree _ _
  have hqroot : (q.rootSet ℂ).ncard = 4 := by
    dsimp [q]
    exact Erdos1047QuarticRaise.quarticRaiseFactor_rootSet_ncard hs0
  have hqc : 0 < p4Level * s ^ 4 := by
    have hp4 : 0 < p4Level := by norm_num [p4Level]
    positivity
  have hqcomp :
      (Erdos1047.componentsIn (Erdos1047.sublevelSet q
        (p4Level * s ^ 4))).ncard = 4 := by
    dsimp [q]
    exact quartic_raise_factor_componentsIn_ncard hs
  refine ⟨q, p4Level * s ^ 4, hqmonic, hqdeg, hqc, ?_, ?_⟩
  · rw [hqcomp, hqroot]
  · dsimp [q]
    exact quartic_raise_factor_nonconvex_components_ncard hs

theorem quartic_raise_polynomial_eval
    (p : ℂ[X]) (L s z : ℂ) :
    (Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z =
      p.eval z * (((z - L) ^ 2 - s ^ 2) ^ 2 + s ^ 4) :=
  Erdos1047QuarticRaise.quarticRaisePolynomial_eval p L s z

theorem quartic_raise_polynomial_scaled_eval_sub_original
    (p : ℂ[X]) (L s z : ℂ) (hL : L ≠ 0) :
    (Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z / L ^ 4 - p.eval z =
      p.eval z * ((((1 - z / L) ^ 2 - (s / L) ^ 2) ^ 2 +
        (s / L) ^ 4) - 1) :=
  Erdos1047QuarticRaise.quarticRaisePolynomial_scaled_eval_sub_original
    p L s z hL

theorem quartic_raise_polynomial_scaled_difference_norm_le
    (p : ℂ[X]) (L s z : ℂ) (hL : L ≠ 0) :
    ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z / L ^ 4 -
        p.eval z‖ ≤
      ‖p.eval z‖ *
        (4 * ‖z / L‖ + 6 * ‖z / L‖ ^ 2 + 4 * ‖z / L‖ ^ 3 +
          ‖z / L‖ ^ 4 + 2 * ‖s / L‖ ^ 2 +
          4 * ‖z / L‖ * ‖s / L‖ ^ 2 +
          2 * ‖z / L‖ ^ 2 * ‖s / L‖ ^ 2 + 2 * ‖s / L‖ ^ 4) :=
  Erdos1047QuarticRaise.quarticRaisePolynomial_scaled_difference_norm_le
    p L s z hL

theorem tendsto_quartic_raise_polynomial_scaled_difference_norm_atTop
    (p : ℂ[X]) (s z : ℂ) :
    Tendsto (fun L : ℝ =>
      ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) s).eval z /
          (L : ℂ) ^ 4 - p.eval z‖) atTop (𝓝 0) :=
  Erdos1047QuarticRaise.tendsto_quarticRaisePolynomial_scaled_difference_norm_atTop
    p s z

theorem exists_uniform_quartic_raise_polynomial_scaled_difference_on_compact
    (p : ℂ[X]) (s : ℂ) (K : Set ℂ) (hK : IsCompact K) :
    ∀ ε : ℝ, 0 < ε → ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ∀ z ∈ K,
        ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) s).eval z /
            (L : ℂ) ^ 4 - p.eval z‖ < ε :=
  Erdos1047QuarticRaise.exists_uniform_quarticRaisePolynomial_scaled_difference_on_compact
    p s K hK

theorem exists_uniform_quartic_raise_polynomial_scaled_difference_on_compact_of_norm_le
    (p : ℂ[X]) (K : Set ℂ) (hK : IsCompact K) (S : ℝ) (hS : 0 ≤ S) :
    ∀ ε : ℝ, 0 < ε → ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ∀ s : ℂ, ‖s‖ ≤ S → ∀ z ∈ K,
        ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) s).eval z /
            (L : ℂ) ^ 4 - p.eval z‖ < ε :=
  Erdos1047QuarticRaise.exists_uniform_quarticRaisePolynomial_scaled_difference_on_compact_of_norm_le
    p K hK S hS

theorem exists_uniform_scaled_difference_of_d_eq_sub_one_mul_sq_on_compact
