theorem connectedComponentIn_im_lt_of_right_halfline_avoids
    {S : Set ℂ} {r : ℂ} (y0 : ℝ)
    (hzeroRe : ∀ z ∈ S, z.re ≠ 0) (hr : r ∈ S) (hrRe : 0 < r.re)
