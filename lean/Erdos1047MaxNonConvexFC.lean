    (hprovider : ∀ m : ℕ, 2 ≤ m →
      ∃ (c : ℝ) (r a b : ℂ),
        0 < c ∧ c < 1 ∧
        r ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ) ∧
        r ^ m = 1 + Complex.I ∧
        Nonempty (RobustNonconvexCertificate
          (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
          c r a b))
    (m : ℕ) (hm : 2 ≤ m) :
    IsGreatest (attainableNonConvexCounts (2 * m)) (2 * m) := by
  constructor
  · have hlow := proposed_answer_attainable_even_of_single_certificate_provider
      hprovider m hm
    rw [maxNonConvexAnswer_of_four_le (by omega : 4 ≤ 2 * m)] at hlow
    exact hlow
  · intro k hk
    exact attainable_le_degree (by omega) hk

theorem max_nonconvex_even_of_even_family_provider
    (hprovider : ∀ m : ℕ, 2 ≤ m →
      ∃ c : ℝ, 0 < c ∧ c < 1 ∧
        {t ∈ componentsIn
            (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) |
          ¬ Convex ℝ t}.ncard = 2 * m)
    (m : ℕ) (hm : 2 ≤ m) :
    IsGreatest (attainableNonConvexCounts (2 * m)) (2 * m) := by
  constructor
  · have hlow := proposed_answer_attainable_even_of_even_family_provider hprovider m hm
    rw [maxNonConvexAnswer_of_four_le (by omega : 4 ≤ 2 * m)] at hlow
    exact hlow
  · intro k hk
    exact attainable_le_degree (by omega) hk

/-- The sharp degree-three upper bound. -/
theorem attainable_le_proposed_answer_three (k : ℕ)
    (hk : k ∈ attainableNonConvexCounts 3) : k ≤ 2 := by
  obtain ⟨f, c, hf, hdeg, hc, hcount, hkcount⟩ := hk
  by_cases hsep : f.Separable
  · rcases separable_cubic_normalization_cases f hf hdeg hsep with hscale | hpure
    · rcases hscale with ⟨d, hd0, hd⟩
      let B0 : ℂ := Erdos1047CubicNormalize.normalizedCubicConstant f d
      by_cases hB0 : 0 ≤ B0.re
      · have hnorm : Erdos1047CubicNormalize.normalizedCubic f d =
            cubicPolynomial B0 := by
          rfl
        exact separable_cubic_centered_upper_bound f k hf hdeg hsep c hc
          hcount hkcount hd0 hd hB0 hnorm
      · have hnormneg : Erdos1047CubicNormalize.normalizedCubic f (-d) =
            cubicPolynomial (-B0) := by
          apply Polynomial.funext
          intro z
          simp [Erdos1047CubicNormalize.normalizedCubic, cubicPolynomial,
            Erdos1047CubicNormalize.normalizedCubicConstant, B0]
          field_simp
        have hdneg0 : -d ≠ 0 := neg_ne_zero.mpr hd0
        have hdneg : (-d) ^ 2 =
            -Erdos1047CubicNormalize.cubicLinear f / 3 := by
          calc
            (-d) ^ 2 = d ^ 2 := by ring
            _ = -Erdos1047CubicNormalize.cubicLinear f / 3 := hd
        have hBneg : 0 ≤ (-B0).re := by
          simp only [Complex.neg_re]
          linarith
        exact separable_cubic_centered_upper_bound f k hf hdeg hsep c hc
          hcount hkcount hdneg0 hdneg hBneg hnormneg
    · have hbound := cubic_count_le_two_of_convex_component f c hf hdeg hcount
        (Erdos1047PureCubicUpper.pure_cubic_convex_component f c hf hdeg hcount hsep
          hpure.1 hpure.2 hc)
      rw [hkcount] at hbound
      exact hbound
  · exact cubic_witness_count_le_two_of_nonseparable f c k hf hdeg hcount hkcount hsep

theorem max_nonconvex_three : IsGreatest (attainableNonConvexCounts 3) 2 := by
  constructor
  · exact three_attainable
  · exact attainable_le_proposed_answer_three

/-- The low-degree upper bound, using the completed quadratic case. -/
theorem attainable_le_proposed_answer_two_three (n k : ℕ) (hn : 2 ≤ n ∧ n ≤ 3)
    (hk : k ∈ attainableNonConvexCounts n) :
    k ≤ maxNonConvexAnswer n := by
  by_cases h2 : n = 2
  · subst n
    rw [attainable_eq_zero_of_degree_two hk]
    simp
  · have h3 : n = 3 := by omega
    subst n
    simpa using attainable_le_proposed_answer_three k hk

/-- Combine the general bound with the sharp low-degree bounds. -/
theorem attainable_le_proposed_answer (n k : ℕ)
    (hk : k ∈ attainableNonConvexCounts n) : k ≤ maxNonConvexAnswer n := by
  by_cases hn : 4 ≤ n
  · exact attainable_le_proposed_answer_of_four_le hn hk
  · by_cases hsmall : n ≤ 1
    · rw [attainable_eq_zero_of_le_one hsmall hk]
      exact Nat.zero_le _
    · exact attainable_le_proposed_answer_two_three n k ⟨by omega, by omega⟩ hk

