/-! The existing quartic certificate also verifies the corresponding powered
    q₂ inverse transport at `m = 2`.  The old p₄ anchor is retained here (it is
    an interior certificate point, rather than the principal-root anchor), so
    this lemma is a regression test for the algebraic transport itself. -/
theorem p4_powered_certificate_two :
    ∃ (c : ℝ) (a b : ℂ),
      0 < c ∧ c < 1 ∧
      (∀ z ∈ segment ℝ p4Anchor a,
        ∃ w : ℂ, ‖w‖ < c ∧ z ^ 2 = q2InverseU w) ∧
      (∀ z ∈ segment ℝ p4Anchor b,
        ∃ w : ℂ, ‖w‖ < c ∧ z ^ 2 = q2InverseU w) ∧
      ∃ w : ℂ, c < ‖w‖ ∧
        (midpoint ℝ a b) ^ 2 = q2InverseU w := by
  refine ⟨p4Level, p4PointA, p4PointB, by norm_num [p4Level],
    lt_one_of_le_p4Level (le_rfl), ?_, ?_, ?_⟩
  · intro z hz
    have hw : ‖p4Polynomial.eval z‖ < p4Level := p4_lineA_strict z hz
    rcases hz with ⟨u, v, hu, hv, huv, rfl⟩
    have hzre : 0 < (u • p4Anchor + v • p4PointA).re := by
      rw [Complex.real_smul, Complex.real_smul]
      norm_num [p4Anchor, p4PointA]
      nlinarith
    have hzim : 0 < (u • p4Anchor + v • p4PointA).im := by
      rw [Complex.real_smul, Complex.real_smul]
      norm_num [p4Anchor, p4PointA]
      nlinarith
    refine ⟨p4Polynomial.eval (u • p4Anchor + v • p4PointA), hw, ?_⟩
    have hinv := p4_inverse_eval_eq_self
      (u • p4Anchor + v • p4PointA) hzre hzim
    simpa [q2InverseU] using (congrArg (fun x : ℂ => x ^ 2) hinv).symm
  · intro z hz
    have hw : ‖p4Polynomial.eval z‖ < p4Level := p4_lineB_strict z hz
    rcases hz with ⟨u, v, hu, hv, huv, rfl⟩
    have hzre : 0 < (u • p4Anchor + v • p4PointB).re := by
      rw [Complex.real_smul, Complex.real_smul]
      norm_num [p4Anchor, p4PointB]
      nlinarith
    have hzim : 0 < (u • p4Anchor + v • p4PointB).im := by
      rw [Complex.real_smul, Complex.real_smul]
      norm_num [p4Anchor, p4PointB]
      nlinarith
    refine ⟨p4Polynomial.eval (u • p4Anchor + v • p4PointB), hw, ?_⟩
    have hinv := p4_inverse_eval_eq_self
      (u • p4Anchor + v • p4PointB) hzre hzim
    simpa [q2InverseU] using (congrArg (fun x : ℂ => x ^ 2) hinv).symm
  · let z : ℂ := midpoint ℝ p4PointA p4PointB
    have hzre : 0 < z.re := by
      dsimp [z]
      norm_num [midpoint, AffineMap.lineMap_apply_module, p4PointA, p4PointB,
        Complex.add_re, Complex.add_im]
    have hzim : 0 < z.im := by
      dsimp [z]
      norm_num [midpoint, AffineMap.lineMap_apply_module, p4PointA, p4PointB,
        Complex.add_re, Complex.add_im]
    refine ⟨p4Polynomial.eval z, ?_, ?_⟩
    · exact p4_midpoint_norm_gt
    · have hinv := p4_inverse_eval_eq_self z hzre hzim
      simpa [z, q2InverseU] using (congrArg (fun x : ℂ => x ^ 2) hinv).symm

