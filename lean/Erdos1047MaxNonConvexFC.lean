def p3RealPart (x y : ℝ) : ℝ := x ^ 3 - 3 * x * y ^ 2 - 3 * x + 3

def p3ImagPart (x y : ℝ) : ℝ := 3 * x ^ 2 * y - y ^ 3 - 3 * y

def p3RealFirst (x y vx vy : ℝ) : ℝ :=
  3 * x ^ 2 * vx - 3 * vx * y ^ 2 - 6 * x * y * vy - 3 * vx

def p3ImagFirst (x y vx vy : ℝ) : ℝ :=
  6 * x * vx * y + 3 * x ^ 2 * vy - 3 * y ^ 2 * vy - 3 * vy

def p3RealSecond (x y vx vy : ℝ) : ℝ :=
  6 * x * vx ^ 2 - 12 * vx * y * vy - 6 * x * vy ^ 2

def p3ImagSecond (x y vx vy : ℝ) : ℝ :=
  6 * vx ^ 2 * y + 12 * x * vx * vy - 6 * y * vy ^ 2

def p3NormSqFormula (z : ℂ) : ℝ :=
  p3RealPart z.re z.im ^ 2 + p3ImagPart z.re z.im ^ 2

