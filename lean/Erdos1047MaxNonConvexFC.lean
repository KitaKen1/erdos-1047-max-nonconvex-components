    {n : ℕ} (hn : 2 ≤ n) {c : ℝ} (hc : c < n - 1) :
    Metric.closedBall (0 : ℂ) c ⊆
      ((powerLinearPolynomial n).eval ''
        {u : ℂ | (powerLinearPolynomial n).derivative.eval u = 0})ᶜ := by
