theorem p5UpperLeft_lineA_norm_lt (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    ‖p5Polynomial.eval
      (p5UpperLeftAnchor + (t : ℂ) * (p5UpperLeftPointA - p5UpperLeftAnchor))‖ <
      p5WitnessLevel := by
  have hs := p5UpperLeft_lineA_normSq t ht0 ht1
  rw [Complex.normSq_eq_norm_sq] at hs
  have hc : 0 ≤ p5WitnessLevel := by norm_num [p5WitnessLevel, p5Level]
  nlinarith [norm_nonneg (p5Polynomial.eval
    (p5UpperLeftAnchor + (t : ℂ) * (p5UpperLeftPointA - p5UpperLeftAnchor)))]

theorem p5UpperLeft_lineB_norm_lt (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    ‖p5Polynomial.eval
      (p5UpperLeftAnchor + (t : ℂ) * (p5UpperLeftPointB - p5UpperLeftAnchor))‖ <
      p5WitnessLevel := by
  have hs := p5UpperLeft_lineB_normSq t ht0 ht1
  rw [Complex.normSq_eq_norm_sq] at hs
  have hc : 0 ≤ p5WitnessLevel := by norm_num [p5WitnessLevel, p5Level]
  nlinarith [norm_nonneg (p5Polynomial.eval
    (p5UpperLeftAnchor + (t : ℂ) * (p5UpperLeftPointB - p5UpperLeftAnchor)))]

theorem p5UpperLeft_lineA_strict :
    ∀ z ∈ segment ℝ p5UpperLeftAnchor p5UpperLeftPointA,
      ‖p5Polynomial.eval z‖ < p5WitnessLevel := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hv1 : v ≤ 1 := by linarith
  have hparam : u • p5UpperLeftAnchor + v • p5UpperLeftPointA =
      p5UpperLeftAnchor + (v : ℂ) * (p5UpperLeftPointA - p5UpperLeftAnchor) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination p5UpperLeftAnchor * huv'
  rw [hparam]
  exact p5UpperLeft_lineA_norm_lt v hv hv1

theorem p5UpperLeft_lineB_strict :
    ∀ z ∈ segment ℝ p5UpperLeftAnchor p5UpperLeftPointB,
      ‖p5Polynomial.eval z‖ < p5WitnessLevel := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hv1 : v ≤ 1 := by linarith
  have hparam : u • p5UpperLeftAnchor + v • p5UpperLeftPointB =
      p5UpperLeftAnchor + (v : ℂ) * (p5UpperLeftPointB - p5UpperLeftAnchor) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination p5UpperLeftAnchor * huv'
  rw [hparam]
  exact p5UpperLeft_lineB_norm_lt v hv hv1

theorem p5UpperLeft_midpoint_norm_gt :
    p5WitnessLevel <
      ‖p5Polynomial.eval (midpoint ℝ p5UpperLeftPointA p5UpperLeftPointB)‖ := by
  have hgt : p5WitnessLevel ^ 2 < Complex.normSq
      (p5Polynomial.eval (midpoint ℝ p5UpperLeftPointA p5UpperLeftPointB)) := by
    norm_num [p5Polynomial, p5WitnessLevel, p5Level, p5UpperLeftPointA,
      p5UpperLeftPointB, midpoint, AffineMap.lineMap_apply_module,
      Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
  rw [Complex.normSq_eq_norm_sq] at hgt
  have hc : 0 ≤ p5WitnessLevel := by norm_num [p5WitnessLevel, p5Level]
  nlinarith [norm_nonneg
    (p5Polynomial.eval (midpoint ℝ p5UpperLeftPointA p5UpperLeftPointB))]

/-- A fully exact non-convex component of the quintic, certified without a
local-curvature-to-convexity theorem. -/
theorem p5UpperLeft_component_not_convex :
    ¬ Convex ℝ (connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) p5UpperLeftAnchor) := by
  apply component_not_convex_of_segments
  · intro z hz
    exact (p5UpperLeft_lineA_strict z hz).le
  · intro z hz
    exact (p5UpperLeft_lineB_strict z hz).le
  · intro hm
    exact (not_lt_of_ge hm) p5UpperLeft_midpoint_norm_gt

theorem p5UpperLeft_robust_certificate :
    Nonempty (RobustNonconvexCertificate (fun z ↦ p5Polynomial.eval z) p5WitnessLevel
      p5UpperLeftAnchor p5UpperLeftPointA p5UpperLeftPointB) := by
  apply robustNonconvexCertificate_of_strict (by fun_prop)
  · exact p5UpperLeft_lineA_strict
  · exact p5UpperLeft_lineB_strict
  · exact p5UpperLeft_midpoint_norm_gt

theorem p5UpperLeft_midpoint_outside :
    midpoint ℝ p5UpperLeftPointA p5UpperLeftPointB ∉
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel := by
  intro hm
  exact (not_lt_of_ge hm) p5UpperLeft_midpoint_norm_gt

theorem p5UpperLeft_component_mem :
    connectedComponentIn (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel)
      p5UpperLeftAnchor ∈
      Erdos1047.componentsIn (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) := by
  refine ⟨p5UpperLeftAnchor, ?_, rfl⟩
  exact (p5UpperLeft_lineA_strict p5UpperLeftAnchor
    (left_mem_segment ℝ p5UpperLeftAnchor p5UpperLeftPointA)).le

theorem p5_eval_star (z : ℂ) :
    p5Polynomial.eval (star z) = star (p5Polynomial.eval z) := by
  simp [p5Polynomial]

theorem p5_mem_star_iff (z : ℂ) :
    star z ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel ↔
      z ∈ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel := by
  simp only [Erdos1047.sublevelSet, Set.mem_ofPred_eq, p5_eval_star, norm_star]

theorem p5_star_segment {r a : ℂ}
    (h : segment ℝ r a ⊆ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) :
    segment ℝ (star r) (star a) ⊆
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  rw [show u • star r + v • star a = star (u • r + v • a) by simp]
  exact (p5_mem_star_iff _).2 (h ⟨u, v, hu, hv, huv, rfl⟩)

theorem p5_star_midpoint_outside {a b : ℂ}
    (h : midpoint ℝ a b ∉ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) :
    midpoint ℝ (star a) (star b) ∉
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel := by
  intro hm
  apply h
  rw [← p5_mem_star_iff]
  convert hm using 1
  simp [midpoint, AffineMap.lineMap_apply_module]

/-! Conjugation preserves a quantitative robust certificate, not just the weak
    segment and midpoint statements.  This generic bridge lets the p₅ upper
    witnesses be mirrored without repeating their rational inequalities. -/
theorem robustNonconvexCertificate_of_star
    {F : ℂ → ℂ} {c : ℝ} {r a b : ℂ}
    (hF : ∀ z, F (star z) = star (F z))
    (hcert : Nonempty (RobustNonconvexCertificate F c r a b)) :
    Nonempty (RobustNonconvexCertificate F c (star r) (star a) (star b)) := by
  obtain ⟨hcert⟩ := hcert
  refine ⟨⟨hcert.eps, hcert.eps_pos, ?_, ?_, ?_⟩⟩
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
    rw [show u • star r + v • star a = star (u • r + v • a) by simp,
      hF, norm_star]
    exact hcert.lineA_margin _ ⟨u, v, hu, hv, huv, rfl⟩
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
    rw [show u • star r + v • star b = star (u • r + v • b) by simp,
      hF, norm_star]
    exact hcert.lineB_margin _ ⟨u, v, hu, hv, huv, rfl⟩
  · rw [show midpoint ℝ (star a) (star b) = star (midpoint ℝ a b) by
      simp [midpoint, AffineMap.lineMap_apply_module], hF, norm_star]
    exact hcert.midpoint_margin

/-! Negation is the second elementary symmetry needed for the four quartic
    witness branches.  It preserves real segments, midpoints, and norms. -/
theorem robustNonconvexCertificate_of_neg
    {F : ℂ → ℂ} {c : ℝ} {r a b : ℂ}
    (hF : ∀ z, F (-z) = F z)
    (hcert : Nonempty (RobustNonconvexCertificate F c r a b)) :
    Nonempty (RobustNonconvexCertificate F c (-r) (-a) (-b)) := by
  obtain ⟨hcert⟩ := hcert
  refine ⟨⟨hcert.eps, hcert.eps_pos, ?_, ?_, ?_⟩⟩
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
    rw [show u • (-r) + v • (-a) = -(u • r + v • a) by module, hF]
    exact hcert.lineA_margin _ ⟨u, v, hu, hv, huv, rfl⟩
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
    rw [show u • (-r) + v • (-b) = -(u • r + v • b) by module, hF]
    exact hcert.lineB_margin _ ⟨u, v, hu, hv, huv, rfl⟩
  · rw [show midpoint ℝ (-a) (-b) = -midpoint ℝ a b by
      simp [midpoint, AffineMap.lineMap_apply_module]
      ring, hF]
    exact hcert.midpoint_margin

/-! Rotational symmetry gives the analogous transport for the even family.
    This turns one robust witness in a root orbit into witnesses at every
    rotated root, without repeating the segment inequalities. -/
theorem robustNonconvexCertificate_of_evenFamily_root_unity
    {m : ℕ} (hm : 0 < m) {u : ℂ} (hu : u ^ m = 1)
    {c : ℝ} {r a b : ℂ}
    (hcert : Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
      c r a b)) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
      c (u * r) (u * a) (u * b)) := by
  obtain ⟨hcert⟩ := hcert
  refine ⟨⟨hcert.eps, hcert.eps_pos, ?_, ?_, ?_⟩⟩
  · rintro z ⟨α, β, hα, hβ, hαβ, rfl⟩
    have hmap : α • (u * r) + β • (u * a) =
        u * (α • r + β • a) := by
      rw [Complex.real_smul, Complex.real_smul, Complex.real_smul,
        Complex.real_smul]
      ring
    rw [hmap]
    change ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval
      (u * (α • r + β • a))‖ + hcert.eps ≤ c
    rw [Erdos1047EvenFamily.evenFamily_norm_eval_mul_root_of_unity hu]
    exact hcert.lineA_margin _ ⟨α, β, hα, hβ, hαβ, rfl⟩
  · rintro z ⟨α, β, hα, hβ, hαβ, rfl⟩
    have hmap : α • (u * r) + β • (u * b) =
        u * (α • r + β • b) := by
      rw [Complex.real_smul, Complex.real_smul, Complex.real_smul,
        Complex.real_smul]
      ring
    rw [hmap]
    change ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval
      (u * (α • r + β • b))‖ + hcert.eps ≤ c
    rw [Erdos1047EvenFamily.evenFamily_norm_eval_mul_root_of_unity hu]
    exact hcert.lineB_margin _ ⟨α, β, hα, hβ, hαβ, rfl⟩
  · have hmap : midpoint ℝ (u * a) (u * b) =
        u * midpoint ℝ a b := by
      simp [midpoint, AffineMap.lineMap_apply_module]
      ring
    rw [hmap]
    change c + hcert.eps ≤ ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval
      (u * midpoint ℝ a b)‖
    rw [Erdos1047EvenFamily.evenFamily_norm_eval_mul_root_of_unity hu]
    exact hcert.midpoint_margin

theorem robustNonconvexCertificate_of_evenFamily_star
    {m : ℕ} {c : ℝ} {r a b : ℂ}
    (hcert : Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
      c r a b)) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
      c (star r) (star a) (star b)) := by
  apply robustNonconvexCertificate_of_star
  · intro z
    exact Erdos1047EvenFamily.evenFamily_eval_star m z
  · exact hcert

/-! A single robust certificate at a root of the `1+i` branch supplies
    non-convexity for every root.  The core orbit lemma handles the two
    branches, while the two certificate transport lemmas handle rotation and
    conjugation. -/
theorem evenFamily_root_nonconvex_of_single_certificate
    {m : ℕ} (hm : 0 < m) {c : ℝ} {r a b : ℂ}
    (hr : r ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ))
    (hrplus : r ^ m = 1 + Complex.I)
    (hcert : Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
      c r a b)) :
    ∀ z ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) z) := by
  intro z hz
  have hzroot : z ∈ (Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ := hz
  rcases Erdos1047EvenFamily.evenFamily_root_orbit_representation hm
      (hr := hr) hrplus hzroot with hrep | hrep
  · obtain ⟨u, hu, hzu⟩ := hrep
    subst z
    obtain ⟨hc⟩ := robustNonconvexCertificate_of_evenFamily_root_unity hm hu hcert
    simpa [sublevelSet] using hc.not_convex_component
  · obtain ⟨u, hu, hzu⟩ := hrep
    subst z
    obtain ⟨hcstar⟩ := robustNonconvexCertificate_of_evenFamily_star hcert
    obtain ⟨hc⟩ := robustNonconvexCertificate_of_evenFamily_root_unity hm hu ⟨hcstar⟩
    simpa [sublevelSet] using hc.not_convex_component

theorem p5LowerLeft_robust_certificate :
    Nonempty (RobustNonconvexCertificate (fun z ↦ p5Polynomial.eval z) p5WitnessLevel
      (star p5UpperLeftAnchor) (star p5UpperLeftPointA) (star p5UpperLeftPointB)) := by
  exact robustNonconvexCertificate_of_star p5_eval_star p5UpperLeft_robust_certificate

/-- Conjugation supplies a second exact non-convex p5 component witness. -/
theorem p5LowerLeft_component_not_convex :
    ¬ Convex ℝ (connectedComponentIn
      (Erdos1047.sublevelSet p5Polynomial p5WitnessLevel) (star p5UpperLeftAnchor)) := by
  apply component_not_convex_of_segments
