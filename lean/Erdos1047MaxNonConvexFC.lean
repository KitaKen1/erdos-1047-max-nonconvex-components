/-! A concrete audit of the degree-raising transport.  This does not claim the
    full seven-component construction: it records that one certified p₅
    non-convex component, together with separability and the new two roots,
    can already be transported to degree seven by the common scale-selection
    interface. -/
theorem p5_upper_left_raise_has_one_nonconvex_component
    {e : ℂ} (he : e ≠ 0) :
    ∃ L : ℂ, L ≠ 0 ∧
      (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L (e ^ 2)).Separable ∧
      ((Erdos1047DegreeRaise.raisePolynomial p5Polynomial L (e ^ 2)).rootSet ℂ).ncard = 7 ∧
      ¬ Convex ℝ (connectedComponentIn
        (Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L (e ^ 2))
          (p5WitnessLevel * ‖L‖ ^ 2)) p5UpperLeftAnchor) := by
  obtain ⟨hcert⟩ := p5UpperLeft_robust_certificate
  obtain ⟨L, hL, hsep, hroot, hgeo⟩ :=
    exists_large_scale_separable_raised_nonconvex_component
      (p := p5Polynomial) (e := e) (c := p5WitnessLevel)
      (r := p5UpperLeftAnchor) (a := p5UpperLeftPointA)
      (b := p5UpperLeftPointB) p5Polynomial_monic p5Polynomial_separable he
      hcert
  refine ⟨L, hL, hsep, ?_, hgeo⟩
  simpa [p5Polynomial_natDegree] using hroot

/-! The same scale-selection interface can transport the three explicitly
    certified p₅ witnesses at once.  This is still only a certificate family:
    component injectivity for the raised level is deliberately left as a
    separate separator obligation. -/
theorem p5_raise_three_robust_certificates_same_scale
    {e : ℂ} (he : e ≠ 0) :
    ∃ L : ℂ, L ≠ 0 ∧
      ∀ i : Fin 3, Nonempty (RobustNonconvexCertificate
        (fun z : ℂ =>
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
            (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L)).eval z)
        (p5WitnessLevel * ‖L‖ ^ 2) (match i.1 with
          | 0 => p5UpperLeftAnchor
          | 1 => p5CentralAnchor
          | _ => p5RightAnchor)
        (match i.1 with
          | 0 => p5UpperLeftPointA
          | 1 => p5CentralPointA
          | _ => p5RightPointA)
        (match i.1 with
          | 0 => p5UpperLeftPointB
          | 1 => p5CentralPointB
          | _ => p5RightPointB)) := by
  let r : Fin 3 → ℂ := fun i =>
    if i.1 = 0 then p5UpperLeftAnchor
    else if i.1 = 1 then p5CentralAnchor else p5RightAnchor
  let a : Fin 3 → ℂ := fun i =>
    if i.1 = 0 then p5UpperLeftPointA
    else if i.1 = 1 then p5CentralPointA else p5RightPointA
  let b : Fin 3 → ℂ := fun i =>
    if i.1 = 0 then p5UpperLeftPointB
    else if i.1 = 1 then p5CentralPointB else p5RightPointB
  obtain ⟨hc0⟩ := p5UpperLeft_robust_certificate
  obtain ⟨hc1⟩ := p5Central_robust_certificate
  obtain ⟨hc2⟩ := p5Right_robust_certificate
  let hcert : ∀ i : Fin 3, RobustNonconvexCertificate
      (fun z : ℂ => p5Polynomial.eval z) p5WitnessLevel (r i) (a i) (b i) := fun i => by
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [r, a, b] using hc0
    · refine Fin.cases ?_ (fun k => ?_) j
      · simpa [r, a, b] using hc1
      · refine Fin.cases ?_ (fun l => ?_) k
        · simpa [r, a, b] using hc2
        · exact Fin.elim0 l
  let eps₀ : ℝ := min hc0.eps (min hc1.eps hc2.eps)
  have heps₀ : 0 < eps₀ := by
    dsimp [eps₀]
    exact lt_min hc0.eps_pos (lt_min hc1.eps_pos hc2.eps_pos)
  have heps : ∀ i : Fin 3, eps₀ ≤ (hcert i).eps := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp only [hcert, r, a, b, Fin.cases_zero, Fin.cases_succ]
      dsimp [eps₀]
      exact min_le_left _ _
    · refine Fin.cases ?_ (fun k => ?_) j
      · simp only [hcert, r, a, b, Fin.cases_zero, Fin.cases_succ]
        dsimp [eps₀]
        exact (min_le_right _ _).trans (min_le_left _ _)
      · refine Fin.cases ?_ (fun l => ?_) k
        · simp only [hcert, r, a, b, Fin.cases_zero, Fin.cases_succ]
          dsimp [eps₀]
          exact (min_le_right _ _).trans (min_le_right _ _)
        · exact Fin.elim0 l
  obtain ⟨R0, A0, hR0a, hA0a, hR0b, hA0b, hR0m, hA0m⟩ :=
    Erdos1047DegreeRaise.exists_two_segment_eval_bounds p5Polynomial
      p5UpperLeftAnchor p5UpperLeftPointA p5UpperLeftPointB
  obtain ⟨R1, A1, hR1a, hA1a, hR1b, hA1b, hR1m, hA1m⟩ :=
    Erdos1047DegreeRaise.exists_two_segment_eval_bounds p5Polynomial
      p5CentralAnchor p5CentralPointA p5CentralPointB
  obtain ⟨R2, A2, hR2a, hA2a, hR2b, hA2b, hR2m, hA2m⟩ :=
    Erdos1047DegreeRaise.exists_two_segment_eval_bounds p5Polynomial
      p5RightAnchor p5RightPointA p5RightPointB
  let R : ℝ := max R0 (max R1 R2)
  let A : ℝ := max A0 (max A1 A2)
  have hR : 0 ≤ R := by
    dsimp [R]
    exact ((norm_nonneg (midpoint ℝ p5UpperLeftPointA p5UpperLeftPointB)).trans hR0m).trans
      (le_max_left _ _)
  have hA : 0 ≤ A := by
    dsimp [A]
    exact ((norm_nonneg (p5Polynomial.eval
      (midpoint ℝ p5UpperLeftPointA p5UpperLeftPointB))).trans hA0m).trans
      (le_max_left _ _)
  have hRₐ : ∀ i z, z ∈ segment ℝ (r i) (a i) → ‖z‖ ≤ R := by
    intro i z hz
    fin_cases i
    · have hz' : z ∈ segment ℝ p5UpperLeftAnchor p5UpperLeftPointA := by
        simpa [r, a] using hz
      exact (hR0a z hz').trans (by simpa [R] using le_max_left R0 (max R1 R2))
    · have hz' : z ∈ segment ℝ p5CentralAnchor p5CentralPointA := by
        simpa [r, a] using hz
      exact (hR1a z hz').trans (by
        simpa [R] using (le_max_right R0 (max R1 R2)).trans (le_max_left R1 R2))
    · have hz' : z ∈ segment ℝ p5RightAnchor p5RightPointA := by
        simpa [r, a] using hz
      exact (hR2a z hz').trans (by
        simpa [R] using (le_max_right R0 (max R1 R2)).trans (le_max_right R1 R2))
  have hAₐ : ∀ i z, z ∈ segment ℝ (r i) (a i) → ‖p5Polynomial.eval z‖ ≤ A := by
    intro i z hz
    fin_cases i
    · have hz' : z ∈ segment ℝ p5UpperLeftAnchor p5UpperLeftPointA := by
        simpa [r, a] using hz
      exact (hA0a z hz').trans (by simpa [A] using le_max_left A0 (max A1 A2))
    · have hz' : z ∈ segment ℝ p5CentralAnchor p5CentralPointA := by
        simpa [r, a] using hz
      exact (hA1a z hz').trans (by
        simpa [A] using (le_max_right A0 (max A1 A2)).trans (le_max_left A1 A2))
    · have hz' : z ∈ segment ℝ p5RightAnchor p5RightPointA := by
        simpa [r, a] using hz
      exact (hA2a z hz').trans (by
        simpa [A] using (le_max_right A0 (max A1 A2)).trans (le_max_right A1 A2))
  have hRᵦ : ∀ i z, z ∈ segment ℝ (r i) (b i) → ‖z‖ ≤ R := by
    intro i z hz
    fin_cases i
    · have hz' : z ∈ segment ℝ p5UpperLeftAnchor p5UpperLeftPointB := by
        simpa [r, b] using hz
      exact (hR0b z hz').trans (by simpa [R] using le_max_left R0 (max R1 R2))
    · have hz' : z ∈ segment ℝ p5CentralAnchor p5CentralPointB := by
        simpa [r, b] using hz
      exact (hR1b z hz').trans (by
        simpa [R] using (le_max_right R0 (max R1 R2)).trans (le_max_left R1 R2))
    · have hz' : z ∈ segment ℝ p5RightAnchor p5RightPointB := by
        simpa [r, b] using hz
      exact (hR2b z hz').trans (by
        simpa [R] using (le_max_right R0 (max R1 R2)).trans (le_max_right R1 R2))
  have hAᵦ : ∀ i z, z ∈ segment ℝ (r i) (b i) → ‖p5Polynomial.eval z‖ ≤ A := by
    intro i z hz
    fin_cases i
    · have hz' : z ∈ segment ℝ p5UpperLeftAnchor p5UpperLeftPointB := by
        simpa [r, b] using hz
      exact (hA0b z hz').trans (by simpa [A] using le_max_left A0 (max A1 A2))
    · have hz' : z ∈ segment ℝ p5CentralAnchor p5CentralPointB := by
        simpa [r, b] using hz
      exact (hA1b z hz').trans (by
        simpa [A] using (le_max_right A0 (max A1 A2)).trans (le_max_left A1 A2))
    · have hz' : z ∈ segment ℝ p5RightAnchor p5RightPointB := by
        simpa [r, b] using hz
      exact (hA2b z hz').trans (by
        simpa [A] using (le_max_right A0 (max A1 A2)).trans (le_max_right A1 A2))
  have hRₘ : ∀ i, ‖midpoint ℝ (a i) (b i)‖ ≤ R := by
    intro i
    fin_cases i
    · exact hR0m.trans (by simpa [R] using le_max_left R0 (max R1 R2))
    · exact hR1m.trans (by
        simpa [R] using (le_max_right R0 (max R1 R2)).trans (le_max_left R1 R2))
    · exact hR2m.trans (by
        simpa [R] using (le_max_right R0 (max R1 R2)).trans (le_max_right R1 R2))
  have hAₘ : ∀ i, ‖p5Polynomial.eval (midpoint ℝ (a i) (b i))‖ ≤ A := by
    intro i
    fin_cases i
    · exact hA0m.trans (by simpa [A] using le_max_left A0 (max A1 A2))
    · exact hA1m.trans (by
        simpa [A] using (le_max_right A0 (max A1 A2)).trans (le_max_left A1 A2))
    · exact hA2m.trans (by
        simpa [A] using (le_max_right A0 (max A1 A2)).trans (le_max_right A1 A2))
  obtain ⟨L, hL, hfamily⟩ :=
    exists_common_scale_raised_robust_certificates
      (ι := Fin 3) (p := p5Polynomial) (n := 5) (q := e ^ 2)
      (c := p5WitnessLevel) (eps₀ := eps₀) (R := R) (A := A) (B := ‖e ^ 2‖)
      (r := r) (a := a) (b := b) (by omega) hR hA (le_rfl) heps₀ hcert heps
      hRₐ hAₐ hRᵦ hAᵦ hRₘ hAₘ
  refine ⟨L, hL, ?_⟩
  intro i
  fin_cases i
  · simpa [r, a, b, Erdos1047DegreeRaise.raiseParameter] using hfamily 0
  · simpa [r, a, b, Erdos1047DegreeRaise.raiseParameter] using hfamily 1
  · simpa [r, a, b, Erdos1047DegreeRaise.raiseParameter] using hfamily 2

/-! The conjugate bridge supplies the missing two reflected witnesses, so all
    five p₅ certificates can be transported at one common scale.  This theorem
    is still deliberately certificate-level: it does not identify the five
    raised components or assert the exact component count. -/
theorem p5_raise_five_robust_certificates_same_scale
    {e : ℂ} (he : e ≠ 0) :
    ∃ L : ℂ, L ≠ 0 ∧
      ∀ i : Fin 5, Nonempty (RobustNonconvexCertificate
        (fun z : ℂ =>
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
            (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L)).eval z)
        (p5WitnessLevel * ‖L‖ ^ 2) (match i.1 with
          | 0 => p5UpperLeftAnchor
          | 1 => star p5UpperLeftAnchor
          | 2 => p5CentralAnchor
          | 3 => p5RightAnchor
          | _ => star p5RightAnchor)
        (match i.1 with
          | 0 => p5UpperLeftPointA
          | 1 => star p5UpperLeftPointA
          | 2 => p5CentralPointA
          | 3 => p5RightPointA
          | _ => star p5RightPointA)
        (match i.1 with
          | 0 => p5UpperLeftPointB
          | 1 => star p5UpperLeftPointB
          | 2 => p5CentralPointB
          | 3 => p5RightPointB
          | _ => star p5RightPointB)) := by
  let r : Fin 5 → ℂ := fun i =>
    if i.1 = 0 then p5UpperLeftAnchor
    else if i.1 = 1 then star p5UpperLeftAnchor
    else if i.1 = 2 then p5CentralAnchor
    else if i.1 = 3 then p5RightAnchor else star p5RightAnchor
  let a : Fin 5 → ℂ := fun i =>
    if i.1 = 0 then p5UpperLeftPointA
    else if i.1 = 1 then star p5UpperLeftPointA
    else if i.1 = 2 then p5CentralPointA
    else if i.1 = 3 then p5RightPointA else star p5RightPointA
  let b : Fin 5 → ℂ := fun i =>
    if i.1 = 0 then p5UpperLeftPointB
    else if i.1 = 1 then star p5UpperLeftPointB
    else if i.1 = 2 then p5CentralPointB
    else if i.1 = 3 then p5RightPointB else star p5RightPointB
  obtain ⟨hc0⟩ := p5UpperLeft_robust_certificate
  obtain ⟨hc1⟩ := p5LowerLeft_robust_certificate
  obtain ⟨hc2⟩ := p5Central_robust_certificate
  obtain ⟨hc3⟩ := p5Right_robust_certificate
  obtain ⟨hc4⟩ := p5LowerRight_robust_certificate
  let hcert : ∀ i : Fin 5, RobustNonconvexCertificate
      (fun z : ℂ => p5Polynomial.eval z) p5WitnessLevel (r i) (a i) (b i) := fun i => by
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa [r, a, b] using hc0
    · refine Fin.cases ?_ (fun k => ?_) j
      · simpa [r, a, b] using hc1
      · refine Fin.cases ?_ (fun l => ?_) k
        · simpa [r, a, b] using hc2
        · refine Fin.cases ?_ (fun m => ?_) l
          · simpa [r, a, b] using hc3
          · refine Fin.cases ?_ (fun n => ?_) m
            · simpa [r, a, b] using hc4
            · exact Fin.elim0 n
  let eps₀ : ℝ := min hc0.eps (min hc1.eps (min hc2.eps (min hc3.eps hc4.eps)))
  have heps₀ : 0 < eps₀ := by
    dsimp [eps₀]
    exact lt_min hc0.eps_pos
      (lt_min hc1.eps_pos (lt_min hc2.eps_pos (lt_min hc3.eps_pos hc4.eps_pos)))
  have heps : ∀ i : Fin 5, eps₀ ≤ (hcert i).eps := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · dsimp [hcert, r, a, b]
      dsimp [eps₀]
      exact min_le_left _ _
    · refine Fin.cases ?_ (fun k => ?_) j
      · dsimp [hcert, r, a, b]
        dsimp [eps₀]
        exact (min_le_right _ _).trans (min_le_left _ _)
      · refine Fin.cases ?_ (fun l => ?_) k
        · dsimp [hcert, r, a, b]
          dsimp [eps₀]
          exact (min_le_right _ _).trans
            ((min_le_right _ _).trans (min_le_left _ _))
        · refine Fin.cases ?_ (fun m => ?_) l
          · simp only [hcert, r, a, b, Fin.cases_zero, Fin.cases_succ]
            dsimp [eps₀]
            exact (min_le_right _ _).trans
              ((min_le_right _ _).trans
                ((min_le_right _ _).trans (min_le_left _ _)))
          · refine Fin.cases ?_ (fun n => ?_) m
            · simp only [hcert, r, a, b, Fin.cases_zero, Fin.cases_succ]
              dsimp [eps₀]
              exact (min_le_right _ _).trans
                ((min_le_right _ _).trans
                  ((min_le_right _ _).trans
                    (min_le_right hc3.eps hc4.eps)))
            · exact Fin.elim0 n
  obtain ⟨R0, A0, hR0a, hA0a, hR0b, hA0b, hR0m, hA0m⟩ :=
    Erdos1047DegreeRaise.exists_two_segment_eval_bounds p5Polynomial
      p5UpperLeftAnchor p5UpperLeftPointA p5UpperLeftPointB
  obtain ⟨R1, A1, hR1a, hA1a, hR1b, hA1b, hR1m, hA1m⟩ :=
    Erdos1047DegreeRaise.exists_two_segment_eval_bounds p5Polynomial
      (star p5UpperLeftAnchor) (star p5UpperLeftPointA) (star p5UpperLeftPointB)
  obtain ⟨R2, A2, hR2a, hA2a, hR2b, hA2b, hR2m, hA2m⟩ :=
    Erdos1047DegreeRaise.exists_two_segment_eval_bounds p5Polynomial
      p5CentralAnchor p5CentralPointA p5CentralPointB
  obtain ⟨R3, A3, hR3a, hA3a, hR3b, hA3b, hR3m, hA3m⟩ :=
    Erdos1047DegreeRaise.exists_two_segment_eval_bounds p5Polynomial
      p5RightAnchor p5RightPointA p5RightPointB
  obtain ⟨R4, A4, hR4a, hA4a, hR4b, hA4b, hR4m, hA4m⟩ :=
    Erdos1047DegreeRaise.exists_two_segment_eval_bounds p5Polynomial
      (star p5RightAnchor) (star p5RightPointA) (star p5RightPointB)
  let R : ℝ := max R0 (max R1 (max R2 (max R3 R4)))
  let A : ℝ := max A0 (max A1 (max A2 (max A3 A4)))
  have hR0' : R0 ≤ R := by simpa [R] using le_max_left R0 (max R1 (max R2 (max R3 R4)))
  have hR1' : R1 ≤ R := by
    simpa [R] using
      ((le_max_right R0 (max R1 (max R2 (max R3 R4)))).trans
        (le_max_left R1 (max R2 (max R3 R4))))
  have hR2' : R2 ≤ R := by
    simpa [R] using
      ((le_max_right R0 (max R1 (max R2 (max R3 R4)))).trans
        ((le_max_right R1 (max R2 (max R3 R4))).trans
          (le_max_left R2 (max R3 R4))))
  have hR3' : R3 ≤ R := by
    simpa [R] using
      ((le_max_right R0 (max R1 (max R2 (max R3 R4)))).trans
        ((le_max_right R1 (max R2 (max R3 R4))).trans
          ((le_max_right R2 (max R3 R4)).trans (le_max_left R3 R4))))
  have hR4' : R4 ≤ R := by
    simpa [R] using
      ((le_max_right R0 (max R1 (max R2 (max R3 R4)))).trans
        ((le_max_right R1 (max R2 (max R3 R4))).trans
          ((le_max_right R2 (max R3 R4)).trans (le_max_right R3 R4))))
  have hA0' : A0 ≤ A := by simpa [A] using le_max_left A0 (max A1 (max A2 (max A3 A4)))
  have hA1' : A1 ≤ A := by
    simpa [A] using
      ((le_max_right A0 (max A1 (max A2 (max A3 A4)))).trans
        (le_max_left A1 (max A2 (max A3 A4))))
  have hA2' : A2 ≤ A := by
    simpa [A] using
      ((le_max_right A0 (max A1 (max A2 (max A3 A4)))).trans
        ((le_max_right A1 (max A2 (max A3 A4))).trans
          (le_max_left A2 (max A3 A4))))
  have hA3' : A3 ≤ A := by
    simpa [A] using
      ((le_max_right A0 (max A1 (max A2 (max A3 A4)))).trans
        ((le_max_right A1 (max A2 (max A3 A4))).trans
          ((le_max_right A2 (max A3 A4)).trans (le_max_left A3 A4))))
  have hA4' : A4 ≤ A := by
    simpa [A] using
      ((le_max_right A0 (max A1 (max A2 (max A3 A4)))).trans
        ((le_max_right A1 (max A2 (max A3 A4))).trans
          ((le_max_right A2 (max A3 A4)).trans (le_max_right A3 A4))))
  have hR : 0 ≤ R := by
    exact (norm_nonneg (midpoint ℝ p5UpperLeftPointA p5UpperLeftPointB)).trans hR0m |>.trans hR0'
  have hA : 0 ≤ A := by
    exact (norm_nonneg (p5Polynomial.eval
      (midpoint ℝ p5UpperLeftPointA p5UpperLeftPointB))).trans hA0m |>.trans hA0'
  have hRₐ : ∀ i z, z ∈ segment ℝ (r i) (a i) → ‖z‖ ≤ R := by
    intro i z hz
    fin_cases i
    · have hz' : z ∈ segment ℝ p5UpperLeftAnchor p5UpperLeftPointA := by
        simpa [r, a] using hz
      exact (hR0a z hz').trans hR0'
    · have hz' : z ∈ segment ℝ (star p5UpperLeftAnchor) (star p5UpperLeftPointA) := by
        simpa [r, a] using hz
      exact (hR1a z hz').trans hR1'
    · have hz' : z ∈ segment ℝ p5CentralAnchor p5CentralPointA := by
        simpa [r, a] using hz
      exact (hR2a z hz').trans hR2'
    · have hz' : z ∈ segment ℝ p5RightAnchor p5RightPointA := by
        simpa [r, a] using hz
      exact (hR3a z hz').trans hR3'
    · have hz' : z ∈ segment ℝ (star p5RightAnchor) (star p5RightPointA) := by
        simpa [r, a] using hz
      exact (hR4a z hz').trans hR4'
  have hAₐ : ∀ i z, z ∈ segment ℝ (r i) (a i) → ‖p5Polynomial.eval z‖ ≤ A := by
    intro i z hz
    fin_cases i
    · have hz' : z ∈ segment ℝ p5UpperLeftAnchor p5UpperLeftPointA := by
        simpa [r, a] using hz
      exact (hA0a z hz').trans hA0'
    · have hz' : z ∈ segment ℝ (star p5UpperLeftAnchor) (star p5UpperLeftPointA) := by
        simpa [r, a] using hz
      exact (hA1a z hz').trans hA1'
    · have hz' : z ∈ segment ℝ p5CentralAnchor p5CentralPointA := by
        simpa [r, a] using hz
      exact (hA2a z hz').trans hA2'
    · have hz' : z ∈ segment ℝ p5RightAnchor p5RightPointA := by
        simpa [r, a] using hz
      exact (hA3a z hz').trans hA3'
    · have hz' : z ∈ segment ℝ (star p5RightAnchor) (star p5RightPointA) := by
        simpa [r, a] using hz
      exact (hA4a z hz').trans hA4'
  have hRᵦ : ∀ i z, z ∈ segment ℝ (r i) (b i) → ‖z‖ ≤ R := by
    intro i z hz
    fin_cases i
    · have hz' : z ∈ segment ℝ p5UpperLeftAnchor p5UpperLeftPointB := by
        simpa [r, b] using hz
      exact (hR0b z hz').trans hR0'
    · have hz' : z ∈ segment ℝ (star p5UpperLeftAnchor) (star p5UpperLeftPointB) := by
        simpa [r, b] using hz
      exact (hR1b z hz').trans hR1'
    · have hz' : z ∈ segment ℝ p5CentralAnchor p5CentralPointB := by
        simpa [r, b] using hz
      exact (hR2b z hz').trans hR2'
    · have hz' : z ∈ segment ℝ p5RightAnchor p5RightPointB := by
        simpa [r, b] using hz
      exact (hR3b z hz').trans hR3'
    · have hz' : z ∈ segment ℝ (star p5RightAnchor) (star p5RightPointB) := by
        simpa [r, b] using hz
      exact (hR4b z hz').trans hR4'
  have hAᵦ : ∀ i z, z ∈ segment ℝ (r i) (b i) → ‖p5Polynomial.eval z‖ ≤ A := by
    intro i z hz
    fin_cases i
    · have hz' : z ∈ segment ℝ p5UpperLeftAnchor p5UpperLeftPointB := by
        simpa [r, b] using hz
      exact (hA0b z hz').trans hA0'
    · have hz' : z ∈ segment ℝ (star p5UpperLeftAnchor) (star p5UpperLeftPointB) := by
        simpa [r, b] using hz
      exact (hA1b z hz').trans hA1'
    · have hz' : z ∈ segment ℝ p5CentralAnchor p5CentralPointB := by
        simpa [r, b] using hz
      exact (hA2b z hz').trans hA2'
    · have hz' : z ∈ segment ℝ p5RightAnchor p5RightPointB := by
        simpa [r, b] using hz
      exact (hA3b z hz').trans hA3'
    · have hz' : z ∈ segment ℝ (star p5RightAnchor) (star p5RightPointB) := by
        simpa [r, b] using hz
      exact (hA4b z hz').trans hA4'
  have hRₘ : ∀ i, ‖midpoint ℝ (a i) (b i)‖ ≤ R := by
    intro i
    fin_cases i
    · exact hR0m.trans hR0'
    · exact hR1m.trans hR1'
    · exact hR2m.trans hR2'
    · exact hR3m.trans hR3'
    · exact hR4m.trans hR4'
  have hAₘ : ∀ i, ‖p5Polynomial.eval (midpoint ℝ (a i) (b i))‖ ≤ A := by
    intro i
    fin_cases i
    · exact hA0m.trans hA0'
    · exact hA1m.trans hA1'
    · exact hA2m.trans hA2'
    · exact hA3m.trans hA3'
    · exact hA4m.trans hA4'
  obtain ⟨L, hL, hfamily⟩ :=
    exists_common_scale_raised_robust_certificates
      (ι := Fin 5) (p := p5Polynomial) (n := 5) (q := e ^ 2)
      (c := p5WitnessLevel) (eps₀ := eps₀) (R := R) (A := A) (B := ‖e ^ 2‖)
      (r := r) (a := a) (b := b) (by omega) hR hA (le_rfl) heps₀ hcert heps
      hRₐ hAₐ hRᵦ hAᵦ hRₘ hAₘ
  refine ⟨L, hL, ?_⟩
  intro i
  fin_cases i
  · simpa [r, a, b, Erdos1047DegreeRaise.raiseParameter] using hfamily 0
  · simpa [r, a, b, Erdos1047DegreeRaise.raiseParameter] using hfamily 1
  · simpa [r, a, b, Erdos1047DegreeRaise.raiseParameter] using hfamily 2
  · simpa [r, a, b, Erdos1047DegreeRaise.raiseParameter] using hfamily 3
  · simpa [r, a, b, Erdos1047DegreeRaise.raiseParameter] using hfamily 4

/-! The five transported certificates can now be consumed by the generic
    finite-witness lower-bound lemma.  This is intentionally stated with the
    raised component map injectivity and finiteness as explicit hypotheses:
    the analytic certificate transport is complete, while proving that the
    five labels remain distinct components is the remaining geometric gate. -/
def p5FiveAnchor (i : Fin 5) : ℂ :=
  match i.1 with
  | 0 => p5UpperLeftAnchor
  | 1 => star p5UpperLeftAnchor
  | 2 => p5CentralAnchor
  | 3 => p5RightAnchor
  | _ => star p5RightAnchor

/-! The corresponding endpoint maps are named explicitly so that the
    finite-witness bookkeeping can be reused for any function and level.
    Keeping these maps separate also prevents repeated large dependent `match`
    expressions from entering theorem statements. -/
def p5FivePointA (i : Fin 5) : ℂ :=
  match i.1 with
  | 0 => p5UpperLeftPointA
  | 1 => star p5UpperLeftPointA
  | 2 => p5CentralPointA
  | 3 => p5RightPointA
  | _ => star p5RightPointA

def p5FivePointB (i : Fin 5) : ℂ :=
  match i.1 with
  | 0 => p5UpperLeftPointB
  | 1 => star p5UpperLeftPointB
  | 2 => p5CentralPointB
  | 3 => p5RightPointB
  | _ => star p5RightPointB

def p5FiveCertificateFamily (F : ℂ → ℂ) (c : ℝ) : Prop :=
  ∀ i : Fin 5, Nonempty (RobustNonconvexCertificate F c
    (p5FiveAnchor i) (p5FivePointA i) (p5FivePointB i))

theorem p5FiveAnchor_injective : Function.Injective p5FiveAnchor := by
  intro i j hij
  fin_cases i <;> fin_cases j
  all_goals
    first
    | rfl
    | exfalso
      solve
      | have h := congrArg Complex.re hij
        norm_num [p5FiveAnchor, p5UpperLeftAnchor, p5CentralAnchor,
          p5RightAnchor] at h
      | have h := congrArg Complex.im hij
        norm_num [p5FiveAnchor, p5UpperLeftAnchor, p5CentralAnchor,
          p5RightAnchor] at h

/-! The five explicit p₅ certificates are exposed through the named family
    interface.  This is the concrete base family consumed by the later
    degree-raising transport theorems. -/
theorem p5_five_robust_certificate_family :
    p5FiveCertificateFamily (fun z : ℂ => p5Polynomial.eval z) p5WitnessLevel := by
  obtain ⟨h0⟩ := p5UpperLeft_robust_certificate
  obtain ⟨h1⟩ := p5LowerLeft_robust_certificate
  obtain ⟨h2⟩ := p5Central_robust_certificate
  obtain ⟨h3⟩ := p5Right_robust_certificate
  obtain ⟨h4⟩ := p5LowerRight_robust_certificate
  intro i
  fin_cases i
  · simpa [p5FiveAnchor, p5FivePointA, p5FivePointB] using (Nonempty.intro h0)
  · simpa [p5FiveAnchor, p5FivePointA, p5FivePointB] using (Nonempty.intro h1)
  · simpa [p5FiveAnchor, p5FivePointA, p5FivePointB] using (Nonempty.intro h2)
  · simpa [p5FiveAnchor, p5FivePointA, p5FivePointB] using (Nonempty.intro h3)
  · simpa [p5FiveAnchor, p5FivePointA, p5FivePointB] using (Nonempty.intro h4)

theorem p5_raise_five_nonconvex_lower_bound
    {e L : ℂ}
    (hcert : ∀ i : Fin 5, Nonempty (RobustNonconvexCertificate
      (fun z : ℂ =>
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
          (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L)).eval z)
      (p5WitnessLevel * ‖L‖ ^ 2) (match i.1 with
        | 0 => p5UpperLeftAnchor
        | 1 => star p5UpperLeftAnchor
        | 2 => p5CentralAnchor
        | 3 => p5RightAnchor
        | _ => star p5RightAnchor)
      (match i.1 with
        | 0 => p5UpperLeftPointA
        | 1 => star p5UpperLeftPointA
        | 2 => p5CentralPointA
        | 3 => p5RightPointA
        | _ => star p5RightPointA)
      (match i.1 with
        | 0 => p5UpperLeftPointB
        | 1 => star p5UpperLeftPointB
        | 2 => p5CentralPointB
        | 3 => p5RightPointB
        | _ => star p5RightPointB)))
    (hcompInj : Set.InjOn (fun z : ℂ => connectedComponentIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
          (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L))
        (p5WitnessLevel * ‖L‖ ^ 2)) z) (Set.range p5FiveAnchor))
    (hcompfin : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
          (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L))
        (p5WitnessLevel * ‖L‖ ^ 2))).Finite) :
    5 ≤ {t ∈ Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
          (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L))
        (p5WitnessLevel * ‖L‖ ^ 2)) |
      ¬ Convex ℝ t}.ncard := by
  let q : ℂ[X] := Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
    (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L)
  let c : ℝ := p5WitnessLevel * ‖L‖ ^ 2
  let S : Set ℂ := Erdos1047.sublevelSet q c
  let A : Set ℂ := Set.range p5FiveAnchor
  have hAfin : A.Finite := Set.finite_range _
  have hAcard : A.ncard = 5 := by
    rw [Set.ncard_range_of_injective p5FiveAnchor_injective]
    simp
  have hmem_i : ∀ i : Fin 5, p5FiveAnchor i ∈ S := by
    intro i
    obtain ⟨hc⟩ := hcert i
    fin_cases i
    · have hm := hc.lineA_margin p5UpperLeftAnchor
        (left_mem_segment ℝ p5UpperLeftAnchor p5UpperLeftPointA)
      change ‖q.eval p5UpperLeftAnchor‖ ≤ c
      dsimp [q, c] at hm ⊢
      linarith [hc.eps_pos]
    · have hm := hc.lineA_margin (star p5UpperLeftAnchor)
        (left_mem_segment ℝ (star p5UpperLeftAnchor) (star p5UpperLeftPointA))
      change ‖q.eval (star p5UpperLeftAnchor)‖ ≤ c
      dsimp [q, c] at hm ⊢
      linarith [hm, hc.eps_pos]
    · have hm := hc.lineA_margin p5CentralAnchor
        (left_mem_segment ℝ p5CentralAnchor p5CentralPointA)
      change ‖q.eval p5CentralAnchor‖ ≤ c
      dsimp [q, c] at hm ⊢
      linarith [hm, hc.eps_pos]
    · have hm := hc.lineA_margin p5RightAnchor
        (left_mem_segment ℝ p5RightAnchor p5RightPointA)
      change ‖q.eval p5RightAnchor‖ ≤ c
      dsimp [q, c] at hm ⊢
      linarith [hm, hc.eps_pos]
    · have hm := hc.lineA_margin (star p5RightAnchor)
        (left_mem_segment ℝ (star p5RightAnchor) (star p5RightPointA))
      change ‖q.eval (star p5RightAnchor)‖ ≤ c
      dsimp [q, c] at hm ⊢
      linarith [hm, hc.eps_pos]
  have hmem : ∀ z ∈ A, z ∈ S := by
    rintro z ⟨i, rfl⟩
    exact hmem_i i
  have hnc_i : ∀ i : Fin 5,
      ¬ Convex ℝ (connectedComponentIn S (p5FiveAnchor i)) := by
    intro i
    obtain ⟨hc⟩ := hcert i
    have hnc := hc.not_convex_component
    simpa [S, q, c, Erdos1047.sublevelSet,
      p5FiveAnchor, Erdos1047DegreeRaise.raiseParameter] using hnc
  have hnc : ∀ z ∈ A,
      ¬ Convex ℝ (connectedComponentIn S z) := by
    rintro z ⟨i, rfl⟩
    exact hnc_i i
  have hcompInj' : Set.InjOn
      (fun z : ℂ => connectedComponentIn S z) A := by
    simpa [S, q, c] using hcompInj
  have hcompfin' : (Erdos1047.componentsIn S).Finite := by
    simpa [S, q, c] using hcompfin
  simpa [S, q, c, A] using
    (nonconvex_ncard_ge_of_finite_witnesses hAfin hAcard hmem
      hcompInj' hnc hcompfin')

/-! Generic p₅ witness consumption.  This is the same finite-cardinality
    argument as above, but with the polynomial function and level abstracted.
    It is the intended adapter for future degree-raising constructions whose
    scale or auxiliary factor differs from `raiseParameter 5 (e²) L`. -/
theorem p5_certificate_family_nonconvex_lower_bound
    {F : ℂ → ℂ} {c : ℝ}
    (hcert : p5FiveCertificateFamily F c)
    (hcompInj : Set.InjOn (fun z : ℂ => connectedComponentIn
      {w : ℂ | ‖F w‖ ≤ c} z) (Set.range p5FiveAnchor))
    (hcompfin : (componentsIn {w : ℂ | ‖F w‖ ≤ c}).Finite) :
    5 ≤ {t ∈ componentsIn {w : ℂ | ‖F w‖ ≤ c} |
      ¬ Convex ℝ t}.ncard := by
  let S : Set ℂ := {w : ℂ | ‖F w‖ ≤ c}
  let A : Set ℂ := Set.range p5FiveAnchor
  have hAfin : A.Finite := Set.finite_range _
  have hAcard : A.ncard = 5 := by
    rw [Set.ncard_range_of_injective p5FiveAnchor_injective]
    simp
  have hmem_i : ∀ i : Fin 5, p5FiveAnchor i ∈ S := by
    intro i
    obtain ⟨hc⟩ := hcert i
    have hm := hc.lineA_margin (p5FiveAnchor i)
      (left_mem_segment ℝ (p5FiveAnchor i) (p5FivePointA i))
    change ‖F (p5FiveAnchor i)‖ ≤ c
    linarith [hm, hc.eps_pos]
  have hmem : ∀ z ∈ A, z ∈ S := by
    rintro z ⟨i, rfl⟩
    exact hmem_i i
  have hnc : ∀ z ∈ A, ¬ Convex ℝ (connectedComponentIn S z) := by
    rintro z ⟨i, rfl⟩
    obtain ⟨hc⟩ := hcert i
    have hnc' := hc.not_convex_component
    simpa [S] using hnc'
  have hcompInj' : Set.InjOn
      (fun z : ℂ => connectedComponentIn S z) A := by
    simpa [S] using hcompInj
  have hcompfin' : (componentsIn S).Finite := by
    simpa [S] using hcompfin
  simpa [S, A] using
    (nonconvex_ncard_ge_of_finite_witnesses hAfin hAcard hmem
      hcompInj' hnc hcompfin')

/-! Repackage the existing common-scale transport in the named certificate
    family interface.  The five cases are only finite bookkeeping; all
    analytic transport remains in `p5_raise_five_robust_certificates_same_scale`. -/
theorem p5_raise_five_robust_certificates_same_scale_family
    {e : ℂ} (he : e ≠ 0) :
    ∃ L : ℂ, L ≠ 0 ∧ p5FiveCertificateFamily
      (fun z : ℂ =>
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
          (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L)).eval z)
      (p5WitnessLevel * ‖L‖ ^ 2) := by
  obtain ⟨L, hL, hcert⟩ := p5_raise_five_robust_certificates_same_scale he
  refine ⟨L, hL, ?_⟩
  intro i
  fin_cases i
  · simpa [p5FiveCertificateFamily, p5FiveAnchor, p5FivePointA, p5FivePointB] using hcert 0
  · simpa [p5FiveCertificateFamily, p5FiveAnchor, p5FivePointA, p5FivePointB] using hcert 1
  · simpa [p5FiveCertificateFamily, p5FiveAnchor, p5FivePointA, p5FivePointB] using hcert 2
  · simpa [p5FiveCertificateFamily, p5FiveAnchor, p5FivePointA, p5FivePointB] using hcert 3
  · simpa [p5FiveCertificateFamily, p5FiveAnchor, p5FivePointA, p5FivePointB] using hcert 4

/-! Pack the common-scale selection and the finite-witness lower bound into a
    single interface.  The caller only has to prove the geometric gate for
    whichever scale the analytic selection returns. -/
theorem p5_raise_five_nonconvex_lower_bound_of_component_data
    {e : ℂ} (he : e ≠ 0)
    (hgeom : ∀ L : ℂ, L ≠ 0 →
      Set.InjOn (fun z : ℂ => connectedComponentIn
        (Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
            (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L))
          (p5WitnessLevel * ‖L‖ ^ 2)) z) (Set.range p5FiveAnchor) ∧
      (Erdos1047.componentsIn
        (Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
            (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L))
          (p5WitnessLevel * ‖L‖ ^ 2))).Finite) :
    ∃ L : ℂ, L ≠ 0 ∧ 5 ≤ {t ∈ Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
          (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L))
        (p5WitnessLevel * ‖L‖ ^ 2)) |
      ¬ Convex ℝ t}.ncard := by
  obtain ⟨L, hL, hcert⟩ := p5_raise_five_robust_certificates_same_scale he
  obtain ⟨hinj, hfin⟩ := hgeom L hL
  exact ⟨L, hL, p5_raise_five_nonconvex_lower_bound hcert hinj hfin⟩

/- ## Exact separation barriers for the five p5 witnesses -/

theorem bernstein8_pos (t c0 c1 c2 c3 c4 c5 c6 c7 c8 : ℝ)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hc0 : 0 < c0) (hc1 : 0 ≤ c1) (hc2 : 0 ≤ c2) (hc3 : 0 ≤ c3)
    (hc4 : 0 ≤ c4) (hc5 : 0 ≤ c5) (hc6 : 0 ≤ c6) (hc7 : 0 ≤ c7)
    (hc8 : 0 < c8) :
    0 < c0 * t ^ 0 * (1 - t) ^ 8 + c1 * t ^ 1 * (1 - t) ^ 7 +
      c2 * t ^ 2 * (1 - t) ^ 6 + c3 * t ^ 3 * (1 - t) ^ 5 +
      c4 * t ^ 4 * (1 - t) ^ 4 + c5 * t ^ 5 * (1 - t) ^ 3 +
      c6 * t ^ 6 * (1 - t) ^ 2 + c7 * t ^ 7 * (1 - t) ^ 1 +
      c8 * t ^ 8 * (1 - t) ^ 0 := by
  have hsub : 0 ≤ 1 - t := by linarith
  by_cases ht : t < 1
  · have h0 : 0 < c0 * t ^ 0 * (1 - t) ^ 8 := by positivity
    have h1 : 0 ≤ c1 * t ^ 1 * (1 - t) ^ 7 := by positivity
    have h2 : 0 ≤ c2 * t ^ 2 * (1 - t) ^ 6 := by positivity
    have h3 : 0 ≤ c3 * t ^ 3 * (1 - t) ^ 5 := by positivity
    have h4 : 0 ≤ c4 * t ^ 4 * (1 - t) ^ 4 := by positivity
    have h5 : 0 ≤ c5 * t ^ 5 * (1 - t) ^ 3 := by positivity
    have h6 : 0 ≤ c6 * t ^ 6 * (1 - t) ^ 2 := by positivity
    have h7 : 0 ≤ c7 * t ^ 7 * (1 - t) ^ 1 := by positivity
    have h8 : 0 ≤ c8 * t ^ 8 * (1 - t) ^ 0 := by positivity
    nlinarith
  · have ht' : t = 1 := le_antisymm ht1 (le_of_not_gt ht)
    simpa [ht'] using hc8

/-- The residual octic in the horizontal critical-line factorization is
strictly positive on the closed left half-line. -/
theorem p5_left_horizontal_octic_pos (x : ℝ) (hx : x ≤ 0) :
    0 < 6414336 * x ^ 8 + 8017920 * x ^ 7 - 14198400 * x ^ 6 -
      38669760 * x ^ 5 + 37497000 * x ^ 4 + 108962148 * x ^ 3 -
      74277690 * x ^ 2 - 202151015 * x + 163087250 := by
  by_cases hxm2 : x < -2
  · have hu : 0 ≤ -x - 2 := by linarith
    have hid :
        6414336 * x ^ 8 + 8017920 * x ^ 7 - 14198400 * x ^ 6 -
          38669760 * x ^ 5 + 37497000 * x ^ 4 + 108962148 * x ^ 3 -
          74277690 * x ^ 2 - 202151015 * x + 163087250 =
        6414336 * (-x - 2) ^ 8 + 94611456 * (-x - 2) ^ 7 +
          591956352 * (-x - 2) ^ 6 + 2068406208 * (-x - 2) ^ 5 +
          4511329320 * (-x - 2) ^ 4 + 6470515164 * (-x - 2) ^ 3 +
          5964290094 * (-x - 2) ^ 2 + 3141138383 * (-x - 2) +
          943044312 := by ring
    rw [hid]
    positivity
  · have hxm2' : -2 ≤ x := le_of_not_gt hxm2
    let t : ℝ := (x + 2) / 2
    have ht0 : 0 ≤ t := by dsimp [t]; linarith
    have ht1 : t ≤ 1 := by dsimp [t]; linarith
    have hbern := bernstein8_pos t
      943044312 1262077730 6286463750 12261510330 17351483230
      14968866886 7099446450 1709000030 163087250 ht0 ht1
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    have hid :
        6414336 * x ^ 8 + 8017920 * x ^ 7 - 14198400 * x ^ 6 -
          38669760 * x ^ 5 + 37497000 * x ^ 4 + 108962148 * x ^ 3 -
          74277690 * x ^ 2 - 202151015 * x + 163087250 =
        943044312 * t ^ 0 * (1-t) ^ 8 +
          1262077730 * t ^ 1 * (1-t) ^ 7 +
          6286463750 * t ^ 2 * (1-t) ^ 6 +
          12261510330 * t ^ 3 * (1-t) ^ 5 +
          17351483230 * t ^ 4 * (1-t) ^ 4 +
          14968866886 * t ^ 5 * (1-t) ^ 3 +
          7099446450 * t ^ 6 * (1-t) ^ 2 +
          1709000030 * t ^ 7 * (1-t) ^ 1 +
          163087250 * t ^ 8 * (1-t) ^ 0 := by
      dsimp [t]
      ring
    rw [hid]
    exact hbern

/-- On the half-line through the nonreal critical point `-5/4 + i/2`,
the squared norm never drops below the common critical value. -/
theorem p5_left_horizontal_normSq_ge (x : ℝ) (hx : x ≤ 0) :
    p5Level ^ 2 ≤ Complex.normSq
      (p5Polynomial.eval ((x : ℂ) + (1 / 2 : ℂ) * Complex.I)) := by
  have hQ := p5_left_horizontal_octic_pos x hx
  have hid :
      Complex.normSq (p5Polynomial.eval ((x : ℂ) + (1 / 2 : ℂ) * Complex.I)) -
          p5Level ^ 2 =
        (4 * x + 5) ^ 2 *
          (6414336 * x ^ 8 + 8017920 * x ^ 7 - 14198400 * x ^ 6 -
            38669760 * x ^ 5 + 37497000 * x ^ 4 + 108962148 * x ^ 3 -
            74277690 * x ^ 2 - 202151015 * x + 163087250) /
          102629376 := by
    norm_num [p5Polynomial, p5Level, Complex.normSq, pow_succ,
      Complex.mul_re, Complex.mul_im]
    ring
  rw [← sub_nonneg, hid]
  positivity

theorem sublevelSet_avoids_im_line_on_left_halfline_of_eval_norm_gt
    {f : ℂ[X]} {c a : ℝ}
    (hbound : ∀ x : ℝ, x ≤ 0 →
      c < ‖f.eval ((x : ℂ) + (a : ℂ) * Complex.I)‖) :
    ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (a : ℂ) * Complex.I ∉ sublevelSet f c := by
  intro x hx hz
  change ‖f.eval ((x : ℂ) + (a : ℂ) * Complex.I)‖ ≤ c at hz
  exact (not_lt_of_ge hz) (hbound x hx)

theorem p5_left_upper_horizontal_eval_norm_gt (x : ℝ) (hx : x ≤ 0) :
    p5WitnessLevel < ‖p5Polynomial.eval
      ((x : ℂ) + (1 / 2 : ℂ) * Complex.I)‖ := by
  have hs := p5_left_horizontal_normSq_ge x hx
  rw [Complex.normSq_eq_norm_sq] at hs
  have hlevel : p5WitnessLevel < p5Level := by
    norm_num [p5WitnessLevel, p5Level]
  have hw : 0 ≤ ‖p5Polynomial.eval
      ((x : ℂ) + (1 / 2 : ℂ) * Complex.I)‖ := norm_nonneg _
  have hc : 0 ≤ p5Level := by norm_num [p5Level]
  have hc' : 0 ≤ p5WitnessLevel := by norm_num [p5WitnessLevel, p5Level]
  nlinarith

theorem p5_left_upper_horizontal_avoids_witness (x : ℝ) (hx : x ≤ 0) :
    (x : ℂ) + (1 / 2 : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel := by
  intro hz
  have hn : ‖p5Polynomial.eval ((x : ℂ) + (1 / 2 : ℂ) * Complex.I)‖ ≤
      p5WitnessLevel := hz
  have hs : Complex.normSq
      (p5Polynomial.eval ((x : ℂ) + (1 / 2 : ℂ) * Complex.I)) ≤
      p5WitnessLevel ^ 2 := by
    rw [Complex.normSq_eq_norm_sq]
    exact pow_le_pow_left₀ (norm_nonneg _) hn 2
  have hgap : p5WitnessLevel ^ 2 < p5Level ^ 2 := by
    norm_num [p5WitnessLevel, p5Level]
  linarith [p5_left_horizontal_normSq_ge x hx]

/-- The same horizontal barrier, exposed through the analytic half-line API.
    This theorem is kept as a separate checked route so the older component
    proof remains independent of the front-end while both proofs are available
    for later degree-raising reuse. -/
theorem p5_left_upper_horizontal_avoids_witness_via_eval_bound (x : ℝ) (hx : x ≤ 0) :
    (x : ℂ) + (1 / 2 : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel := by
  intro hz
  change ‖p5Polynomial.eval ((x : ℂ) + (1 / 2 : ℂ) * Complex.I)‖ ≤
      p5WitnessLevel at hz
  exact (not_lt_of_ge hz) (p5_left_upper_horizontal_eval_norm_gt x hx)

theorem p5_left_lower_horizontal_avoids_witness (x : ℝ) (hx : x ≤ 0) :
    (x : ℂ) - (1 / 2 : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel := by
  intro hz
  have hstar := (p5_mem_star_iff
    ((x : ℂ) - (1 / 2 : ℂ) * Complex.I)).2 hz
  have heq : star ((x : ℂ) - (1 / 2 : ℂ) * Complex.I) =
      (x : ℂ) + (1 / 2 : ℂ) * Complex.I := by
    apply Complex.ext <;> norm_num
  rw [heq] at hstar
  exact p5_left_upper_horizontal_avoids_witness x hx hstar

theorem p5_real_right_eval_re_ge (x : ℝ) (hx : 0 ≤ x) :
    p5Level ≤ (p5Polynomial.eval (x : ℂ)).re := by
  have hid :
      (p5Polynomial.eval (x : ℂ)).re - p5Level =
        (x - 1) ^ 2 * (96 * x ^ 3 + 372 * x ^ 2 + 538 * x + 269) / 96 := by
    norm_num [p5Polynomial, p5Level, pow_succ]
    ring
  rw [← sub_nonneg, hid]
  positivity

/-! Quantitative strengthening on the nonnegative real axis.  The factored
    remainder is retained explicitly so the real-axis separator can be used
    at the doubled strict level arising from the real-square degree raise. -/
theorem p5_real_right_eval_re_ge_quadratic (x : ℝ) (hx : 0 ≤ x) :
    p5Level + (x - 1) ^ 2 *
        (96 * x ^ 3 + 372 * x ^ 2 + 538 * x + 269) / 96 ≤
      (p5Polynomial.eval (x : ℂ)).re := by
  have hid :
      (p5Polynomial.eval (x : ℂ)).re - p5Level =
        (x - 1) ^ 2 * (96 * x ^ 3 + 372 * x ^ 2 + 538 * x + 269) / 96 := by
    norm_num [p5Polynomial, p5Level, pow_succ]
    ring
  linarith [hid]

theorem p5_right_real_axis_avoids_witness (x : ℝ) (hx : 0 ≤ x) :
    (x : ℂ) ∉ Erdos1047.sublevelSet p5Polynomial p5WitnessLevel := by
  intro hz
  have hn : ‖p5Polynomial.eval (x : ℂ)‖ ≤ p5WitnessLevel := hz
  have hre : (p5Polynomial.eval (x : ℂ)).re ≤ p5WitnessLevel :=
    (Complex.re_le_norm _).trans hn
  have hgap : p5WitnessLevel < p5Level := by
    norm_num [p5WitnessLevel, p5Level]
  linarith [p5_real_right_eval_re_ge x hx]

/-! The right-half-line real-axis estimate in the norm form consumed by the
    degree-raising front-end. -/
theorem p5_right_real_axis_eval_norm_gt (x : ℝ) (hx : 0 ≤ x) :
    p5WitnessLevel < ‖p5Polynomial.eval (x : ℂ)‖ := by
  have hgap : p5WitnessLevel < p5Level := by
    norm_num [p5WitnessLevel, p5Level]
  exact lt_of_lt_of_le
    (lt_of_lt_of_le hgap (p5_real_right_eval_re_ge x hx))
    (Complex.re_le_norm _)

theorem p5_imaginary_axis_avoids_witness (y : ℝ) :
    (y : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet p5Polynomial p5WitnessLevel := by
  intro hz
  apply p5_imaginary_axis_avoids_sublevel y
  have hz' : ‖p5Polynomial.eval ((y : ℂ) * Complex.I)‖ ≤ p5WitnessLevel := hz
  exact hz'.trans (by norm_num [p5WitnessLevel, p5Level])

/- ## Covering-space exhaustion of p5 components -/

/-- A disk strictly below the common critical level consists only of regular
values of `p5Polynomial`. -/
theorem p5_closedBall_subset_regular_values {c : ℝ} (hc : c < p5Level) :
    Metric.closedBall (0 : ℂ) c ⊆
      (p5Polynomial.eval '' {z : ℂ | p5Polynomial.derivative.eval z = 0})ᶜ := by
  rintro w hw ⟨z, hzcrit, rfl⟩
  have hw' : ‖p5Polynomial.eval z‖ ≤ c := by
    simpa [Metric.mem_closedBall] using hw
  linarith [p5_critical_value_norm_ge z hzcrit]

/-!
This is the reusable version of the p5 lifting argument.  Isolating it from the
particular critical-value calculation means that future degree-raising proofs only
have to supply a regular-value certificate for the chosen polynomial.
-/
theorem polynomial_exists_root_in_component_of_regular_values
    {f : ℂ[X]} (hf : f.Monic) {c : ℝ} (hc0 : 0 ≤ c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ)
    (z : ℂ) (hz : z ∈ Erdos1047.sublevelSet f c) :
    ∃ r ∈ f.rootSet ℂ,
      r ∈ connectedComponentIn (Erdos1047.sublevelSet f c) z := by
  let D : Set ℂ := Metric.closedBall 0 c
  letI : ContractibleSpace D := by
    dsimp [D]
    exact Metric.contractibleSpace_closedBall hc0
  letI : LocallyPathConnectedSpace D := by
    dsimp [D]
    exact (convex_closedBall (0 : ℂ) c).locallyPathConnectedSpace
  let a0 : D := ⟨f.eval z, by
    have hz' : ‖f.eval z‖ ≤ c := hz
    simpa [D, Metric.mem_closedBall] using hz'⟩
  let inclusion : C(D, ℂ) := ⟨fun w ↦ w.1, continuous_subtype_val⟩
  have hreg' : ∀ w : D,
      inclusion w ∈ (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ := by
    intro w
    apply hreg
    exact w.2
  obtain ⟨F, hF, _⟩ :=
    (Polynomial.isCoveringMapOn_eval f).existsUnique_continuousMap_lifts
      inclusion (a₀ := a0) (e₀ := z) (by rfl) hreg'
  have hlift (w : D) : f.eval (F w) = (w : ℂ) := by
    simpa [Function.comp_apply, inclusion] using congrFun hF.2 w
  let w0 : D := ⟨0, by simpa [D, Metric.mem_closedBall] using hc0⟩
  let r : ℂ := F w0
  have hrzero : f.eval r = 0 := by
    simpa [r, w0] using hlift w0
  have hrroot : r ∈ f.rootSet ℂ := hf.mem_rootSet.mpr hrzero
  have hpre : IsPreconnected (Set.range F) := isPreconnected_range F.continuous
  have hzrange : z ∈ Set.range F := ⟨a0, hF.1⟩
  have hrrange : r ∈ Set.range F := ⟨w0, rfl⟩
  have hFK : Set.range F ⊆ Erdos1047.sublevelSet f c := by
    rintro _ ⟨w, rfl⟩
    have hw : ‖(w : ℂ)‖ ≤ c := by
      have hw' := w.2
      change (w : ℂ) ∈ Metric.closedBall 0 c at hw'
      rw [Metric.mem_closedBall, dist_zero_right] at hw'
      exact hw'
    change ‖f.eval (F w)‖ ≤ c
    rw [hlift w]
    exact hw
  exact ⟨r, hrroot, hpre.subset_connectedComponentIn hzrange hFK hrrange⟩

/-!
The lifting lemma immediately gives a generic component exhaustion statement.
This is intentionally separated from any particular polynomial: once a closed
disk of values is regular, every component of the corresponding lemniscate is
represented by a root.  It is the reusable replacement for the earlier p5-only
copy of this argument.
-/
theorem componentsIn_eq_image_rootSet_of_regular_values
    {f : ℂ[X]} (hf : f.Monic) {c : ℝ} (hc0 : 0 ≤ c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ) :
    Erdos1047.componentsIn (Erdos1047.sublevelSet f c) =
      (fun r : ℂ ↦ connectedComponentIn (Erdos1047.sublevelSet f c) r) ''
        (↑(f.rootSet ℂ) : Set ℂ) := by
  apply Set.Subset.antisymm
  · rintro t ⟨z, hz, rfl⟩
    obtain ⟨r, hrroot, hrcomp⟩ :=
      polynomial_exists_root_in_component_of_regular_values hf hc0 hreg z hz
    refine ⟨r, hrroot, ?_⟩
    exact (connectedComponentIn_eq hrcomp).symm
  · rintro _ ⟨r, hrroot, rfl⟩
    have hreval : f.eval r = 0 := hf.mem_rootSet.mp hrroot
    have hrK : r ∈ Erdos1047.sublevelSet f c := by
      change ‖f.eval r‖ ≤ c
      rw [hreval, norm_zero]
      exact hc0
    exact ⟨r, hrK, rfl⟩

theorem powerLinearPolynomial_componentsIn_ncard_le
    {n : ℕ} (hn : 2 ≤ n) {c : ℝ} (hc : 0 ≤ c) (hc_lt : c < n - 1) :
    (componentsIn (sublevelSet (powerLinearPolynomial n) c)).ncard ≤ n := by
  change (componentsIn (sublevelSet (Erdos1047PowerLinear.polynomial n) c)).ncard ≤ n
  rw [componentsIn_eq_image_rootSet_of_regular_values
    (Erdos1047PowerLinear.monic hn) hc
    (powerLinearPolynomial_closedBall_subset_regular_values hn hc_lt)]
  calc
    (connectedComponentIn (sublevelSet (powerLinearPolynomial n) c) ''
      (↑((powerLinearPolynomial n).rootSet ℂ) : Set ℂ)).ncard ≤
        ((powerLinearPolynomial n).rootSet ℂ).ncard :=
      Set.ncard_image_le ((powerLinearPolynomial n).rootSet_finite ℂ)
    _ = n := Erdos1047PowerLinear.rootSet_ncard hn

theorem powerLinearPolynomial_componentsIn_ncard_eq_n_of_root_injOn
    {n : ℕ} (hn : 2 ≤ n) {c : ℝ} (hc : 0 ≤ c) (hc_lt : c < n - 1)
    (hinj : Set.InjOn (fun r : ℂ ↦ connectedComponentIn
      (sublevelSet (powerLinearPolynomial n) c) r)
      (↑((powerLinearPolynomial n).rootSet ℂ) : Set ℂ)) :
    (componentsIn (sublevelSet (powerLinearPolynomial n) c)).ncard = n := by
  have hinj' : Set.InjOn (fun r : ℂ ↦ connectedComponentIn
      (sublevelSet (Erdos1047PowerLinear.polynomial n) c) r)
      (↑((Erdos1047PowerLinear.polynomial n).rootSet ℂ) : Set ℂ) := by
    simpa [powerLinearPolynomial] using hinj
  change (componentsIn (sublevelSet (Erdos1047PowerLinear.polynomial n) c)).ncard = n
  rw [componentsIn_eq_image_rootSet_of_regular_values
    (Erdos1047PowerLinear.monic hn) hc
    (powerLinearPolynomial_closedBall_subset_regular_values hn hc_lt)]
  calc
    (connectedComponentIn (sublevelSet (powerLinearPolynomial n) c) ''
      (↑((powerLinearPolynomial n).rootSet ℂ) : Set ℂ)).ncard =
        ((Erdos1047PowerLinear.polynomial n).rootSet ℂ).ncard := hinj'.ncard_image
    _ = n := Erdos1047PowerLinear.rootSet_ncard hn

/-! A simple analytic criterion for regular values: if every critical value
    has norm strictly above the level, the closed value disk contains no
    critical value. -/
theorem closedBall_subset_regular_values_of_critical_value_norm_gt
    {f : ℂ[X]} {c : ℝ}
    (hcrit : ∀ u : ℂ, f.derivative.eval u = 0 → c < ‖f.eval u‖) :
    Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ := by
  rintro w hw ⟨u, hu, rfl⟩
  have hw' : ‖f.eval u‖ ≤ c := by
    simpa [Metric.mem_closedBall, dist_zero_right] using hw
  exact (not_lt_of_ge hw') (hcrit u hu)

/-! Properness of a nonconstant polynomial gives compact sublevel sets.  The
    projection bounds below are deliberately stated separately, since they
    are the only old-set information needed by the coordinate barriers. -/
theorem sublevelSet_isCompact_of_positive_degree
    {p : ℂ[X]} (hdeg : 0 < p.degree) (c : ℝ) :
    IsCompact (Erdos1047.sublevelSet p c) := by
  have hp : IsProperMap (fun z : ℂ => p.eval z) := p.isProperMap_eval hdeg
  have hpre : IsCompact ((fun z : ℂ => p.eval z) ⁻¹'
      Metric.closedBall (0 : ℂ) c) :=
    hp.isCompact_preimage (isCompact_closedBall (0 : ℂ) c)
  convert hpre using 1
  ext z
  simp [Erdos1047.sublevelSet, Metric.mem_closedBall, dist_zero_right]

/-! Connected components of a polynomial sublevel set inherit compactness.
This is the compactness input needed by the distance-function separator route
for preserving old components under degree raising. -/
theorem sublevelSet_component_isCompact_of_positive_degree
    {p : ℂ[X]} (hdeg : 0 < p.degree) (c : ℝ) (r : ℂ) :
    IsCompact (connectedComponentIn (Erdos1047.sublevelSet p c) (r : ℂ)) := by
  by_cases hr : r ∈ Erdos1047.sublevelSet p c
  · rw [connectedComponentIn_eq_image hr]
    letI : CompactSpace (Erdos1047.sublevelSet p c) :=
      isCompact_iff_compactSpace.mp (sublevelSet_isCompact_of_positive_degree hdeg c)
    exact isClosed_connectedComponent.isCompact.image continuous_subtype_val
  · simp [connectedComponentIn, hr]

/-! A finite family of compact connected components is relatively clopen.
The statement is deliberately phrased as a neighborhood in the ambient space;
this is the form needed at a boundary minimizer of a polynomial sublevel. -/
theorem componentsIn_finite_component_rel_open
    {S : Set ℂ} (hS : IsCompact S)
    (hfin : (componentsIn S).Finite) {x : ℂ} (hx : x ∈ S) :
    ∃ U ∈ 𝓝 x, U ∩ S ⊆ connectedComponentIn S x := by
  let C : Set ℂ := connectedComponentIn S x
  have hcomp : ∀ D : Set ℂ, D ∈ componentsIn S → IsCompact D := by
    intro D hD
    rcases hD with ⟨y, hy, rfl⟩
    rw [connectedComponentIn_eq_image hy]
    letI : CompactSpace S := isCompact_iff_compactSpace.mp hS
    exact isClosed_connectedComponent.isCompact.image continuous_subtype_val
  let O : Set (Set ℂ) := (componentsIn S) \ {C}
  have hOfin : O.Finite := by
    exact hfin.sdiff
  have hOcomp : IsCompact (⋃₀ O) := hOfin.isCompact_sUnion (by
    intro D hD
    exact hcomp D hD.1)
  have hOclosed : IsClosed (⋃₀ O) := hOcomp.isClosed
  have hEq : S \ C = ⋃₀ O := by
    apply Set.Subset.antisymm
    · intro y hy
      have hyS : y ∈ S := hy.1
      let D : Set ℂ := connectedComponentIn S y
      have hDy : y ∈ D := mem_connectedComponentIn hyS
      have hDmem : D ∈ componentsIn S := ⟨y, hyS, rfl⟩
      have hDne : D ≠ C := by
        intro hDC
        have : y ∈ C := by simpa [D, hDC] using hDy
        exact hy.2 this
      have hDO : D ∈ O := ⟨hDmem, by simpa [C, D] using hDne⟩
      exact mem_sUnion_of_mem hDy hDO
    · intro y hy
      rcases mem_sUnion.1 hy with ⟨D, hDO, hyD⟩
      have hDmem : D ∈ componentsIn S := hDO.1
      rcases hDmem with ⟨w, hw, hDw⟩
      have hyS : y ∈ S := by
        have hyD' : y ∈ connectedComponentIn S w := by simpa [hDw] using hyD
        exact connectedComponentIn_subset S w hyD'
      refine ⟨hyS, ?_⟩
      intro hyC
      have hxy : C = connectedComponentIn S y :=
        connectedComponentIn_eq hyC
      have hne : D ≠ C := by simpa [hDw] using hDO.2
      have hDy' : D = connectedComponentIn S y := by
        rw [hDw]
        have hyD' : y ∈ connectedComponentIn S w := by simpa [hDw] using hyD
        exact connectedComponentIn_eq hyD'
      have hDC : D = C := hDy'.trans hxy.symm
      exact hne hDC
  have hxnot : x ∉ ⋃₀ O := by
    rw [← hEq]
    intro hxother
    exact hxother.2 (by simpa [C] using mem_connectedComponentIn hx)
  have hnh : (⋃₀ O)ᶜ ∈ 𝓝 x := hOclosed.isOpen_compl.mem_nhds hxnot
  refine ⟨(⋃₀ O)ᶜ, hnh, ?_⟩
  intro y hy
  have hyS : y ∈ S := hy.2
  have hynot : y ∉ ⋃₀ O := hy.1
  by_contra hyC
  apply hynot
  let D : Set ℂ := connectedComponentIn S y
  have hDy : y ∈ D := mem_connectedComponentIn hyS
  have hDmem : D ∈ componentsIn S := ⟨y, hyS, rfl⟩
  have hDne : D ≠ C := by
    intro hDC
    apply hyC
    simpa [D, C, hDC] using hDy
  exact mem_sUnion_of_mem hDy ⟨hDmem, hDne⟩

/-! Minimum-modulus principle plus the preceding relative-openness lemma:
without assuming that the value disk avoids critical values, every compact
finite-component polynomial sublevel has a root in each component. -/
theorem polynomial_exists_root_in_component_of_finite_components
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree) {c : ℝ} (hc : 0 < c)
    (hfin : (componentsIn (Erdos1047.sublevelSet f c)).Finite)
    (z : ℂ) (hz : z ∈ Erdos1047.sublevelSet f c) :
    ∃ r ∈ f.rootSet ℂ,
      r ∈ connectedComponentIn (Erdos1047.sublevelSet f c) z := by
  have hScomp : IsCompact (Erdos1047.sublevelSet f c) :=
    sublevelSet_isCompact_of_positive_degree hdeg c
  let C : Set ℂ := connectedComponentIn (Erdos1047.sublevelSet f c) z
  have hCcomp : IsCompact C := by
    dsimp [C]
    rw [connectedComponentIn_eq_image hz]
    letI : CompactSpace (Erdos1047.sublevelSet f c) :=
      isCompact_iff_compactSpace.mp hScomp
    exact isClosed_connectedComponent.isCompact.image continuous_subtype_val
  have hcont : ContinuousOn (fun w : ℂ => ‖f.eval w‖) C := by
    exact (continuous_norm.comp f.continuous_aeval).continuousOn
  obtain ⟨x, hxC, hmin⟩ := hCcomp.exists_isMinOn
    ⟨z, by simpa [C] using mem_connectedComponentIn hz⟩ hcont
  have hxS : x ∈ Erdos1047.sublevelSet f c :=
    connectedComponentIn_subset _ _ hxC
  have hxle : ‖f.eval x‖ ≤ c := hxS
  by_cases hzero : f.eval x = 0
  · refine ⟨x, hf.mem_rootSet.mpr hzero, hxC⟩
  have hnatpos : 0 < f.natDegree := by
    rw [degree_eq_natDegree hf.ne_zero] at hdeg
    exact_mod_cast hdeg
  have hdiff : ∀ᶠ w : ℂ in 𝓝 x,
      DifferentiableAt ℂ (fun w : ℂ => f.eval w) w :=
    Filter.Eventually.of_forall (fun w => f.differentiableAt_aeval)
  have hlocal_from_min (hCnhds : C ∈ 𝓝 x) :
      IsLocalMin (norm ∘ (fun w : ℂ => f.eval w)) x := by
    have hmin' : IsMinOn (norm ∘ (fun w : ℂ => f.eval w)) C x := by
      simpa [Function.comp_def] using hmin
    exact hmin'.isLocalMin hCnhds
  by_cases hlt : ‖f.eval x‖ < c
  · have hopen : IsOpen {w : ℂ | ‖f.eval w‖ < c} := by
      exact isOpen_lt (continuous_norm.comp f.continuous_aeval) continuous_const
    have hxopen : x ∈ {w : ℂ | ‖f.eval w‖ < c} := hlt
    obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp (hopen.mem_nhds hxopen)
    have hballX : Metric.ball x ε ⊆
        connectedComponentIn (Erdos1047.sublevelSet f c) x := by
      apply (convex_ball x ε).isPreconnected.subset_connectedComponentIn
        (by simp [Metric.mem_ball, hε])
      intro w hw
      change ‖f.eval w‖ ≤ c
      exact le_of_lt (hball hw)
    have hballC : Metric.ball x ε ⊆ C := by
      have hCx : C = connectedComponentIn (Erdos1047.sublevelSet f c) x := by
        simpa [C] using (connectedComponentIn_eq hxC)
      intro w hw
      rw [hCx]
      exact hballX hw
    have hCnhds : C ∈ 𝓝 x :=
      Filter.mem_of_superset (Metric.ball_mem_nhds x hε) hballC
    rcases Complex.eventually_eq_or_eq_zero_of_isLocalMin_norm hdiff
      (hlocal_from_min hCnhds) with heq | hzx
    · exfalso
      have hnot : ¬ (∀ᶠ w : ℂ in 𝓝 x, f.eval w = f.eval x) := by
        intro hconst
        have hfun : (fun w : ℂ => f.eval w) = (fun _ : ℂ => f.eval x) := by
          exact AnalyticOnNhd.eq_of_eventuallyEq
            (analyticOnNhd_id.aeval_polynomial f)
            (show AnalyticOnNhd ℂ (fun _ : ℂ => f.eval x) (Set.univ : Set ℂ) by
              exact analyticOnNhd_const) hconst
        have hpoly : f = Polynomial.C (f.eval x) := by
          apply Polynomial.funext
          intro w
          simpa using congrFun hfun w
        have hnat : f.natDegree = 0 := by
          rw [hpoly, natDegree_C]
        omega
      exact hnot heq
    · exact False.elim (hzero hzx)
  · have hxeq : ‖f.eval x‖ = c := le_antisymm hxle (le_of_not_gt hlt)
    obtain ⟨U, hUnh, hUsub⟩ :=
      componentsIn_finite_component_rel_open hScomp hfin hxS
    have hCx : connectedComponentIn (Erdos1047.sublevelSet f c) x = C :=
      (connectedComponentIn_eq hxC).symm
    have hop : IsOpenMap (fun w : ℂ => f.eval w) :=
      (Polynomial.isOpenQuotientMap_eval f (Nat.ne_of_gt hnatpos)).isOpenMap
    have himg : f.eval '' U ∈ 𝓝 (f.eval x) := hop.image_mem_nhds hUnh
    obtain ⟨ε, hε, hεsub⟩ := Metric.mem_nhds_iff.mp himg
    let t : ℝ := min (ε / (2 * c)) (1 / 2)
    have htpos : 0 < t := by
      dsimp [t]
      exact lt_min (by positivity) (by norm_num)
    have ht_half : t ≤ (1 / 2 : ℝ) := min_le_right _ _
    have ht_eps : t ≤ ε / (2 * c) := min_le_left _ _
    let v : ℂ := (1 - t : ℝ) • f.eval x
    have hvnorm : ‖v‖ < c := by
      dsimp [v]
      change ‖(1 - t : ℝ) • f.eval x‖ < c
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by linarith)]
      rw [hxeq]
      nlinarith [htpos]
    have hvdist : dist v (f.eval x) < ε := by
      rw [dist_eq_norm]
      have hsub : v - f.eval x = (-t : ℝ) • f.eval x := by
        dsimp [v]
        change (1 - t : ℝ) • f.eval x - f.eval x = (-t : ℝ) • f.eval x
        calc
          (1 - t : ℝ) • f.eval x - f.eval x =
              (1 - t : ℝ) • f.eval x - (1 : ℝ) • f.eval x := by rw [one_smul]
          _ = ((1 - t : ℝ) - 1) • f.eval x := by
            simpa using (sub_smul (1 - t : ℝ) 1 (f.eval x)).symm
          _ = (-t : ℝ) • f.eval x := by congr 1 <;> ring
      rw [hsub, norm_smul, Real.norm_eq_abs, abs_of_neg (by linarith : -t < 0), hxeq]
      have htepsmul : t * c ≤ ε / 2 := by
        calc
          t * c ≤ (ε / (2 * c)) * c :=
            mul_le_mul_of_nonneg_right ht_eps (le_of_lt hc)
          _ = ε / 2 := by field_simp
      have htc : t * c < ε := lt_of_le_of_lt htepsmul (by linarith)
      simpa [neg_neg] using htc
    have hvball : v ∈ Metric.ball (f.eval x) ε := Metric.mem_ball.mpr hvdist
    rcases hεsub hvball with ⟨y, hyU, hyval⟩
    change f.eval y = v at hyval
    have hyS : y ∈ Erdos1047.sublevelSet f c := by
      change ‖f.eval y‖ ≤ c
      rw [hyval]
      exact hvnorm.le
    have hyC : y ∈ C := by
      rw [← hCx]
      exact hUsub ⟨hyU, hyS⟩
    have hminy : ‖f.eval x‖ ≤ ‖f.eval y‖ := hmin hyC
    rw [hyval] at hminy
    exact False.elim (by linarith [hminy, hvnorm, hxeq])

theorem componentsIn_eq_image_rootSet_of_finite_components
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree) {c : ℝ} (hc : 0 < c)
    (hfin : (componentsIn (Erdos1047.sublevelSet f c)).Finite) :
    componentsIn (Erdos1047.sublevelSet f c) =
      (fun r : ℂ ↦ connectedComponentIn (Erdos1047.sublevelSet f c) r) ''
        (↑(f.rootSet ℂ) : Set ℂ) := by
  apply Set.Subset.antisymm
  · rintro t ⟨z, hz, rfl⟩
    obtain ⟨r, hrroot, hrcomp⟩ :=
      polynomial_exists_root_in_component_of_finite_components hf hdeg hc hfin z hz
    refine ⟨r, hrroot, ?_⟩
    exact (connectedComponentIn_eq hrcomp).symm
  · rintro _ ⟨r, hrroot, rfl⟩
    have hreval : f.eval r = 0 := hf.mem_rootSet.mp hrroot
    have hrK : r ∈ Erdos1047.sublevelSet f c := by
      change ‖f.eval r‖ ≤ c
      rw [hreval, norm_zero]
      exact hc.le
    exact ⟨r, hrK, rfl⟩

theorem sublevelSet_re_bound_of_positive_degree
    {p : ℂ[X]} (hdeg : 0 < p.degree) (c : ℝ) :
    ∃ M : ℝ, ∀ z ∈ Erdos1047.sublevelSet p c, ‖z.re‖ ≤ M := by
  exact (sublevelSet_isCompact_of_positive_degree hdeg c).exists_bound_of_continuousOn
    Complex.continuous_re.continuousOn

theorem sublevelSet_im_bound_of_positive_degree
    {p : ℂ[X]} (hdeg : 0 < p.degree) (c : ℝ) :
    ∃ M : ℝ, ∀ z ∈ Erdos1047.sublevelSet p c, ‖z.im‖ ≤ M := by
  exact (sublevelSet_isCompact_of_positive_degree hdeg c).exists_bound_of_continuousOn
    Complex.continuous_im.continuousOn

/-! Coordinate barrier front-end for the degree-raising factor.  If the old
    sublevel lies strictly to the left of `Re z = L/2`, the vertical line is
    avoided by the raised sublevel. -/
theorem degree_raise_vertical_line_avoids_of_sublevel_re_bound
    {p : ℂ[X]} {c L E : ℝ}
    (hL : 0 < L) (hE : L ≤ E)
    (hsep : ∀ z ∈ Erdos1047.sublevelSet p c, z.re < L / 2) :
    ∀ y : ℝ, (L / 2 : ℂ) + (y : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
        (c * L ^ 2) := by
  intro y hz
  let z : ℂ := (L / 2 : ℂ) + (y : ℂ) * Complex.I
  have hq : ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
      ((E : ℂ) ^ 2)).eval z‖ ≤ c * L ^ 2 := by
    simpa [z, Erdos1047.sublevelSet] using hz
  have hfacSq : (L * E) ^ 2 ≤ Complex.normSq
      ((z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
    simpa [z] using Erdos1047DegreeRaise.raiseFactor_normSq_on_vertical L E y
  have hfacSq' : (L * E) ^ 2 ≤
      ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ ^ 2 := by
    simpa [Complex.normSq_eq_norm_sq] using hfacSq
  have hLE : L ^ 2 ≤ L * E := by nlinarith
  have hfac : L ^ 2 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := by
    have hnon : 0 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := norm_nonneg _
    nlinarith
  have hq' := hq
  rw [Erdos1047DegreeRaise.raisePolynomial_eval, norm_mul] at hq'
  have hpL : ‖p.eval z‖ * L ^ 2 ≤
      ‖p.eval z‖ * ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ :=
    mul_le_mul_of_nonneg_left hfac (norm_nonneg _)
  have hpbound : ‖p.eval z‖ ≤ c := by
    nlinarith [hq', hpL, sq_pos_of_pos hL]
  have hmem : z ∈ Erdos1047.sublevelSet p c := by
    change ‖p.eval z‖ ≤ c
    exact hpbound
  have hsep' := hsep z hmem
  have hzre : z.re = L / 2 := by
    dsimp [z]
    norm_num [Complex.add_re, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, Complex.I_re, Complex.I_im]
  linarith

/-! A persistence form of the vertical barrier.  Unlike the preceding
old-sublevel half-plane lemma, this only asks for a strict lower bound for the
old polynomial on the separator line itself.  It is the form needed to keep
an existing `Re z = 0` separator after multiplying by a distant quadratic. -/
theorem degree_raise_vertical_line_avoids_of_eval_norm_gt
    {p : ℂ[X]} {c L E : ℝ}
    (hL : 0 < L) (hE : E ^ 2 ≤ L ^ 2)
    (hsep : ∀ y : ℝ, c < ‖p.eval ((y : ℂ) * Complex.I)‖) :
    ∀ y : ℝ, (y : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
        (c * L ^ 2) := by
  intro y hz
  let z : ℂ := (y : ℂ) * Complex.I
  have hq : ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
      ((E : ℂ) ^ 2)).eval z‖ ≤ c * L ^ 2 := by
    simpa [z, Erdos1047.sublevelSet] using hz
  have hfacSq : L ^ 4 ≤ Complex.normSq
      ((z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
    simpa [z] using
      Erdos1047DegreeRaise.raiseFactor_normSq_on_vertical_fixed_line
        L E 0 y (by simpa using hE)
  have hfacSq' : L ^ 4 ≤
      ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ ^ 2 := by
    simpa [Complex.normSq_eq_norm_sq] using hfacSq
  have hfac : L ^ 2 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := by
    have hnon : 0 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := norm_nonneg _
    nlinarith
  have hq' := hq
  rw [Erdos1047DegreeRaise.raisePolynomial_eval, norm_mul] at hq'
  have hpL : ‖p.eval z‖ * L ^ 2 ≤
      ‖p.eval z‖ * ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ :=
    mul_le_mul_of_nonneg_left hfac (norm_nonneg _)
  have hpbound : ‖p.eval z‖ ≤ c := by
    nlinarith [hq', hpL, sq_pos_of_pos hL]
  exact (not_lt_of_ge hpbound) (by simpa [z] using hsep y)

/-! A parameter-free version of the vertical barrier.  The preceding theorem
    is convenient for the real quadratic `(z-L)^2+E^2`; the degree-raising
    induction also uses complex or tuned parameters.  Here the only input is
    the actual pointwise lower bound for the factor on the separator line. -/
theorem degree_raise_vertical_line_avoids_of_factor_norm_ge
    {p : ℂ[X]} {c L : ℝ} {d : ℂ}
    (hL : 0 < L)
    (hfactor : ∀ y : ℝ, L ^ 2 ≤
      ‖(((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + d)‖)
    (hsep : ∀ y : ℝ, c < ‖p.eval ((y : ℂ) * Complex.I)‖) :
    ∀ y : ℝ, (y : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) d)
        (c * L ^ 2) := by
  intro y hz
  let z : ℂ := (y : ℂ) * Complex.I
  have hq : ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) d).eval z‖ ≤
      c * L ^ 2 := by
    simpa [z, Erdos1047.sublevelSet] using hz
  have hfac : L ^ 2 ≤
      ‖(z - (L : ℂ)) ^ 2 + d‖ := by
    simpa [z] using hfactor y
  have hq' := hq
  rw [Erdos1047DegreeRaise.raisePolynomial_eval, norm_mul] at hq'
  have hpL : ‖p.eval z‖ * L ^ 2 ≤
      ‖p.eval z‖ * ‖(z - (L : ℂ)) ^ 2 + d‖ :=
    mul_le_mul_of_nonneg_left hfac (norm_nonneg _)
  have hpbound : ‖p.eval z‖ ≤ c := by
    nlinarith [hq', hpL, sq_pos_of_pos hL]
  exact (not_lt_of_ge hpbound) (by simpa [z] using hsep y)

/-! The horizontal analogue: if the old sublevel lies below `Im z = a` and
    the factor is at least `L²` on that line, the raised sublevel avoids it. -/
theorem degree_raise_horizontal_line_avoids_of_sublevel_im_bound
    {p : ℂ[X]} {c L E a : ℝ}
    (hL : 0 < L) (hfactor : L ^ 2 ≤ E ^ 2 - a ^ 2)
    (hsep : ∀ z ∈ Erdos1047.sublevelSet p c, z.im < a) :
    ∀ x : ℝ, (x : ℂ) + (a : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
        (c * L ^ 2) := by
  intro x hz
  let z : ℂ := (x : ℂ) + (a : ℂ) * Complex.I
  have hq : ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
      ((E : ℂ) ^ 2)).eval z‖ ≤ c * L ^ 2 := by
    simpa [z, Erdos1047.sublevelSet] using hz
  have hfacSq : (E ^ 2 - a ^ 2) ^ 2 ≤ Complex.normSq
      ((z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
    simpa [z] using Erdos1047DegreeRaise.raiseFactor_normSq_on_horizontal L E a x
  have hfacSq' : (E ^ 2 - a ^ 2) ^ 2 ≤
      ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ ^ 2 := by
    simpa [Complex.normSq_eq_norm_sq] using hfacSq
  have hfac : L ^ 2 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := by
    have hnon : 0 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := norm_nonneg _
    nlinarith [hfactor]
  have hq' := hq
  rw [Erdos1047DegreeRaise.raisePolynomial_eval, norm_mul] at hq'
  have hpL : ‖p.eval z‖ * L ^ 2 ≤
      ‖p.eval z‖ * ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ :=
    mul_le_mul_of_nonneg_left hfac (norm_nonneg _)
  have hpbound : ‖p.eval z‖ ≤ c := by
    nlinarith [hq', hpL, sq_pos_of_pos hL]
  have hmem : z ∈ Erdos1047.sublevelSet p c := by
    change ‖p.eval z‖ ≤ c
    exact hpbound
  have hsep' := hsep z hmem
  have hzim : z.im = a := by
    dsimp [z]
    norm_num [Complex.add_im, Complex.mul_im, Complex.ofReal_re,
      Complex.ofReal_im, Complex.I_re, Complex.I_im]
  linarith

/-! Lower-half-plane analogue of the preceding horizontal barrier. -/
theorem degree_raise_horizontal_line_avoids_of_sublevel_im_lower_bound
    {p : ℂ[X]} {c L E a : ℝ}
    (hL : 0 < L) (hfactor : L ^ 2 ≤ E ^ 2 - a ^ 2)
    (hsep : ∀ z ∈ Erdos1047.sublevelSet p c, a < z.im) :
    ∀ x : ℝ, (x : ℂ) + (a : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
        (c * L ^ 2) := by
  intro x hz
  let z : ℂ := (x : ℂ) + (a : ℂ) * Complex.I
  have hq : ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
      ((E : ℂ) ^ 2)).eval z‖ ≤ c * L ^ 2 := by
    simpa [z, Erdos1047.sublevelSet] using hz
  have hfacSq : (E ^ 2 - a ^ 2) ^ 2 ≤ Complex.normSq
      ((z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
    simpa [z] using Erdos1047DegreeRaise.raiseFactor_normSq_on_horizontal L E a x
  have hfacSq' : (E ^ 2 - a ^ 2) ^ 2 ≤
      ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ ^ 2 := by
    simpa [Complex.normSq_eq_norm_sq] using hfacSq
  have hfac : L ^ 2 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := by
    have hnon : 0 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := norm_nonneg _
    nlinarith [hfactor]
  have hq' := hq
  rw [Erdos1047DegreeRaise.raisePolynomial_eval, norm_mul] at hq'
  have hpL : ‖p.eval z‖ * L ^ 2 ≤
      ‖p.eval z‖ * ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ :=
    mul_le_mul_of_nonneg_left hfac (norm_nonneg _)
  have hpbound : ‖p.eval z‖ ≤ c := by
    nlinarith [hq', hpL, sq_pos_of_pos hL]
  have hmem : z ∈ Erdos1047.sublevelSet p c := by
    change ‖p.eval z‖ ≤ c
    exact hpbound
  have hsep' := hsep z hmem
  have hzim : z.im = a := by
    dsimp [z]
    norm_num [Complex.add_im, Complex.mul_im, Complex.ofReal_re,
      Complex.ofReal_im, Complex.I_re, Complex.I_im]
  linarith

/-! A symmetric two-line package, useful when the old sublevel has a uniform
    bound on the imaginary coordinate. -/
theorem degree_raise_horizontal_lines_avoids_of_sublevel_im_abs_bound
    {p : ℂ[X]} {c L E a : ℝ}
    (hL : 0 < L) (hfactor : L ^ 2 ≤ E ^ 2 - a ^ 2)
    (hsep : ∀ z ∈ Erdos1047.sublevelSet p c, |z.im| < a) :
    (∀ x : ℝ, (x : ℂ) + (a : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
        (c * L ^ 2)) ∧
    (∀ x : ℝ, (x : ℂ) + (-a : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
        (c * L ^ 2)) := by
  have hu : ∀ z ∈ Erdos1047.sublevelSet p c, z.im < a := by
    intro z hz
    exact (abs_lt.mp (hsep z hz)).2
  have hl : ∀ z ∈ Erdos1047.sublevelSet p c, -a < z.im := by
    intro z hz
    exact (abs_lt.mp (hsep z hz)).1
  refine ⟨degree_raise_horizontal_line_avoids_of_sublevel_im_bound hL hfactor hu, ?_⟩
  have hfactor' : L ^ 2 ≤ E ^ 2 - (-a) ^ 2 := by
    simpa [sq] using hfactor
  convert degree_raise_horizontal_line_avoids_of_sublevel_im_lower_bound
    (a := -a) hL hfactor' hl using 1 <;> norm_num

/-! Fixed-line persistence for horizontal separators. -/
theorem degree_raise_horizontal_line_avoids_of_eval_norm_gt
    {p : ℂ[X]} {c L E a : ℝ}
    (hL : 0 < L) (hfactor : L ^ 2 ≤ E ^ 2 - a ^ 2)
    (hsep : ∀ x : ℝ, c < ‖p.eval ((x : ℂ) + (a : ℂ) * Complex.I)‖) :
    ∀ x : ℝ, (x : ℂ) + (a : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
        (c * L ^ 2) := by
  intro x hz
  let z : ℂ := (x : ℂ) + (a : ℂ) * Complex.I
  have hq : ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
      ((E : ℂ) ^ 2)).eval z‖ ≤ c * L ^ 2 := by
    simpa [z, Erdos1047.sublevelSet] using hz
  have hfacSq : (E ^ 2 - a ^ 2) ^ 2 ≤ Complex.normSq
      ((z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
    simpa [z] using Erdos1047DegreeRaise.raiseFactor_normSq_on_horizontal L E a x
  have hfacSq' : (E ^ 2 - a ^ 2) ^ 2 ≤
      ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ ^ 2 := by
    simpa [Complex.normSq_eq_norm_sq] using hfacSq
  have hfac : L ^ 2 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := by
    have hnon : 0 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := norm_nonneg _
    nlinarith [hfactor]
  have hq' := hq
  rw [Erdos1047DegreeRaise.raisePolynomial_eval, norm_mul] at hq'
  have hpL : ‖p.eval z‖ * L ^ 2 ≤
      ‖p.eval z‖ * ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ :=
    mul_le_mul_of_nonneg_left hfac (norm_nonneg _)
  have hpbound : ‖p.eval z‖ ≤ c := by
    nlinarith [hq', hpL, sq_pos_of_pos hL]
  exact (not_lt_of_ge hpbound) (by simpa [z] using hsep x)

/-! Restricted horizontal separators.  The predicate `P` allows the same
    estimate to be used on a half-line (for example `x ≤ 0` or `0 ≤ x`)
    without strengthening a one-variable bound to the whole line. -/
theorem degree_raise_horizontal_set_avoids_of_eval_norm_gt
    {p : ℂ[X]} {c L E a : ℝ} {P : ℝ → Prop}
    (hL : 0 < L) (hfactor : L ^ 2 ≤ E ^ 2 - a ^ 2)
    (hsep : ∀ x : ℝ, P x →
      c < ‖p.eval ((x : ℂ) + (a : ℂ) * Complex.I)‖) :
    ∀ x : ℝ, P x →
      (x : ℂ) + (a : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
          (c * L ^ 2) := by
  intro x hx hz
  let z : ℂ := (x : ℂ) + (a : ℂ) * Complex.I
  have hq : ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
      ((E : ℂ) ^ 2)).eval z‖ ≤ c * L ^ 2 := by
    simpa [z, Erdos1047.sublevelSet] using hz
  have hfacSq : (E ^ 2 - a ^ 2) ^ 2 ≤ Complex.normSq
      ((z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
    simpa [z] using Erdos1047DegreeRaise.raiseFactor_normSq_on_horizontal L E a x
  have hfacSq' : (E ^ 2 - a ^ 2) ^ 2 ≤
      ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ ^ 2 := by
    simpa [Complex.normSq_eq_norm_sq] using hfacSq
  have hfac : L ^ 2 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := by
    have hnon : 0 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := norm_nonneg _
    nlinarith [hfactor]
  have hq' := hq
  rw [Erdos1047DegreeRaise.raisePolynomial_eval, norm_mul] at hq'
  have hpL : ‖p.eval z‖ * L ^ 2 ≤
      ‖p.eval z‖ * ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ :=
    mul_le_mul_of_nonneg_left hfac (norm_nonneg _)
  have hpbound : ‖p.eval z‖ ≤ c := by
    nlinarith [hq', hpL, sq_pos_of_pos hL]
  exact (not_lt_of_ge hpbound) (by simpa [z] using hsep x hx)

/-! A sharpened horizontal barrier estimate.  The preceding interface asks
    for a factor lower bound of `L²`, which is convenient for uniform
    bookkeeping but is unnecessarily strong on a fixed line.  Here the
    actual lower bound `E²-a²` is retained and compared directly with the new
    level.  This is useful for the p₅ half-line barriers when `E=L`: the loss
    of `a²` is absorbed by the strict gap between `p5Level` and
    `p5WitnessLevel` at a sufficiently large scale. -/
theorem degree_raise_horizontal_set_avoids_of_eval_norm_gt_scaled
    {p : ℂ[X]} {c₀ c L E a : ℝ} {P : ℝ → Prop}
    (hfactor : 0 ≤ E ^ 2 - a ^ 2)
    (hsep : ∀ x : ℝ, P x → c₀ ≤ ‖p.eval ((x : ℂ) + (a : ℂ) * Complex.I)‖)
    (hlevel : c < c₀ * (E ^ 2 - a ^ 2)) :
    ∀ x : ℝ, P x →
      (x : ℂ) + (a : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2)) c := by
  intro x hx hz
  let z : ℂ := (x : ℂ) + (a : ℂ) * Complex.I
  have hq : ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
      ((E : ℂ) ^ 2)).eval z‖ ≤ c := by
    change ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
      ((E : ℂ) ^ 2)).eval ((x : ℂ) + ((a : ℝ) : ℂ) * Complex.I)‖ ≤ c at hz
    simpa [z] using hz
  have hfacSq : (E ^ 2 - a ^ 2) ^ 2 ≤ Complex.normSq
      ((z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
    simpa [z] using Erdos1047DegreeRaise.raiseFactor_normSq_on_horizontal L E a x
  have hfacSq' : (E ^ 2 - a ^ 2) ^ 2 ≤
      ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ ^ 2 := by
    simpa [Complex.normSq_eq_norm_sq] using hfacSq
  have hfac : E ^ 2 - a ^ 2 ≤
      ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := by
    have hnon : 0 ≤ ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := norm_nonneg _
    nlinarith [hfactor]
  have hstrict : c₀ * (E ^ 2 - a ^ 2) ≤
      ‖p.eval z‖ * ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := by
    have hleft := mul_le_mul_of_nonneg_right (hsep x hx) hfactor
    have hright := mul_le_mul_of_nonneg_left hfac (norm_nonneg (p.eval z))
    linarith
  have hcontra : c <
      ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2)).eval z‖ := by
    rw [Erdos1047DegreeRaise.raisePolynomial_eval, norm_mul]
    exact lt_of_lt_of_le hlevel hstrict
  exact (not_lt_of_ge hq) hcontra

/-! A half-line variant with the sharper distance-to-the-real-centre bound.
    On `x ≤ 0` and `L ≥ 0`, the real part of the quadratic factor is at least
    `L²-a²`; this is stronger than the full-line bound when `E²` is small.
    It is the exact estimate needed to transport the p₅ left barriers for a
    direct factor `(z-L)²+E²` at the rescaled level `c·L²`. -/
theorem degree_raise_horizontal_set_avoids_of_eval_norm_gt_left_halfline
    {p : ℂ[X]} {c₀ c L E a : ℝ} {P : ℝ → Prop}
    (hL : 0 ≤ L) (hLa : a ^ 2 ≤ L ^ 2)
    (hP : ∀ x : ℝ, P x → x ≤ 0)
    (hsep : ∀ x : ℝ, P x →
      c₀ ≤ ‖p.eval ((x : ℂ) + ((a : ℝ) : ℂ) * Complex.I)‖)
    (hlevel : c < c₀ * (L ^ 2 - a ^ 2)) :
    ∀ x : ℝ, P x →
      (x : ℂ) + ((a : ℝ) : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2)) c := by
  intro x hx hz
  let z : ℂ := (x : ℂ) + ((a : ℝ) : ℂ) * Complex.I
  have hq : ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
      ((E : ℂ) ^ 2)).eval z‖ ≤ c := by
    change ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
      ((E : ℂ) ^ 2)).eval ((x : ℂ) + ((a : ℝ) : ℂ) * Complex.I)‖ ≤ c at hz
    simpa [z] using hz
  have hxa : L ^ 2 - a ^ 2 ≤
      (((z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2).re) := by
    have hx0 : x ≤ 0 := hP x hx
    have hprod : x * L ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hx0 hL
    have hsqx : 0 ≤ x ^ 2 := sq_nonneg x
    have hsq : L ^ 2 ≤ (x - L) ^ 2 := by
      nlinarith
    have hformula :
        (((z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2).re) =
          (x - L) ^ 2 - a ^ 2 + E ^ 2 := by
      dsimp [z]
      norm_num [Complex.sub_re, Complex.sub_im, Complex.mul_re,
        Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
        Complex.I_re, Complex.I_im, pow_two]
    rw [hformula]
    nlinarith
  have hfac : L ^ 2 - a ^ 2 ≤
      ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ :=
    le_trans hxa (Complex.re_le_norm _)
  have hstrict : c₀ * (L ^ 2 - a ^ 2) ≤
      ‖p.eval z‖ * ‖(z - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2‖ := by
    have hsep' : c₀ ≤ ‖p.eval z‖ := by
      simpa [z] using hsep x hx
    have hleft := mul_le_mul_of_nonneg_right hsep'
      (sub_nonneg.mpr hLa)
    have hright := mul_le_mul_of_nonneg_left hfac (norm_nonneg (p.eval z))
    linarith
  have hcontra : c <
      ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
        ((E : ℂ) ^ 2)).eval z‖ := by
    rw [Erdos1047DegreeRaise.raisePolynomial_eval, norm_mul]
    exact lt_of_lt_of_le hlevel hstrict
  exact (not_lt_of_ge hq) hcontra

/-! Fully parameter-free horizontal barrier.  This is the companion to
    `degree_raise_vertical_line_avoids_of_factor_norm_ge`: it accepts a direct
    lower bound for the actual complex factor, so no real square-root or
    discriminant representation is required by callers. -/
theorem degree_raise_horizontal_set_avoids_of_factor_norm_ge
    {p : ℂ[X]} {c₀ c L a : ℝ} {d : ℂ} {P : ℝ → Prop}
    (hbase : 0 ≤ L ^ 2 - a ^ 2)
    (hsep : ∀ x : ℝ, P x →
      c₀ ≤ ‖p.eval ((x : ℂ) + ((a : ℝ) : ℂ) * Complex.I)‖)
    (hfactor : ∀ x : ℝ, P x → L ^ 2 - a ^ 2 ≤
      ‖(((x : ℂ) + ((a : ℝ) : ℂ) * Complex.I - (L : ℂ)) ^ 2 + d)‖)
    (hlevel : c < c₀ * (L ^ 2 - a ^ 2)) :
    ∀ x : ℝ, P x →
      (x : ℂ) + ((a : ℝ) : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) d) c := by
  intro x hx hz
  let z : ℂ := (x : ℂ) + ((a : ℝ) : ℂ) * Complex.I
  have hq : ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) d).eval z‖ ≤ c := by
    change ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) d).eval
        ((x : ℂ) + ((a : ℝ) : ℂ) * Complex.I)‖ ≤ c at hz
    simpa [z] using hz
  have hfac : L ^ 2 - a ^ 2 ≤ ‖(z - (L : ℂ)) ^ 2 + d‖ := by
    simpa [z] using hfactor x hx
  have hstrict : c₀ * (L ^ 2 - a ^ 2) ≤
      ‖p.eval z‖ * ‖(z - (L : ℂ)) ^ 2 + d‖ := by
    have hsep' : c₀ ≤ ‖p.eval z‖ := by
      simpa [z] using hsep x hx
    have hleft := mul_le_mul_of_nonneg_right hsep' hbase
    have hright := mul_le_mul_of_nonneg_left hfac (norm_nonneg (p.eval z))
    linarith
  have hcontra : c <
      ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) d).eval z‖ := by
    rw [Erdos1047DegreeRaise.raisePolynomial_eval, norm_mul]
    exact lt_of_lt_of_le hlevel hstrict
  exact (not_lt_of_ge hq) hcontra

/-! The same half-line barrier for the tuned quadratic.  The extra sign
    assumption `A ≤ 0` is exactly the large-positive-centre regime of the
    prescribed-slope construction. -/
theorem tuned_raise_horizontal_set_avoids_of_eval_norm_gt_left_halfline
    {p : ℂ[X]} {c₀ c L A d a : ℝ} {P : ℝ → Prop}
    (hL : 0 ≤ L) (hLa : a ^ 2 ≤ L ^ 2) (hA : A ≤ 0) (hd : 0 ≤ d)
    (hP : ∀ x : ℝ, P x → x ≤ 0)
    (hsep : ∀ x : ℝ, P x →
      c₀ ≤ ‖p.eval ((x : ℂ) + ((a : ℝ) : ℂ) * Complex.I)‖)
    (hlevel : c < c₀ * (L ^ 2 - a ^ 2)) :
    ∀ x : ℝ, P x →
      (x : ℂ) + ((a : ℝ) : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047TunedRaise.tunedRaisePolynomial p
            (L : ℂ) (A : ℂ) (d : ℂ)) c := by
  intro x hx hz
  let z : ℂ := (x : ℂ) + ((a : ℝ) : ℂ) * Complex.I
  have hq : ‖(Erdos1047TunedRaise.tunedRaisePolynomial p
      (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ ≤ c := by
    change ‖(Erdos1047TunedRaise.tunedRaisePolynomial p
      (L : ℂ) (A : ℂ) (d : ℂ)).eval
        ((x : ℂ) + ((a : ℝ) : ℂ) * Complex.I)‖ ≤ c at hz
    simpa [z] using hz
  have hxa : L ^ 2 - a ^ 2 ≤
      ((Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval z).re := by
    simpa [z] using Erdos1047TunedRaise.tunedRaiseFactor_re_ge_sq_sub_on_left_halfline
      hL hA hd (hP x hx)
  have hfac : L ^ 2 - a ^ 2 ≤
      ‖(Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ :=
    le_trans hxa (Complex.re_le_norm _)
  have hstrict : c₀ * (L ^ 2 - a ^ 2) ≤
      ‖p.eval z‖ *
        ‖(Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ := by
    have hsep' : c₀ ≤ ‖p.eval z‖ := by
      simpa [z] using hsep x hx
    have hleft := mul_le_mul_of_nonneg_right hsep'
      (sub_nonneg.mpr hLa)
    have hright := mul_le_mul_of_nonneg_left hfac (norm_nonneg (p.eval z))
    linarith
  have hcontra : c <
      ‖(Erdos1047TunedRaise.tunedRaisePolynomial p
        (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ := by
    rw [Erdos1047TunedRaise.tunedRaisePolynomial_eval, norm_mul]
    have hstrict' := hstrict
    rw [Erdos1047TunedRaise.tunedRaiseFactor_eval] at hstrict'
    exact lt_of_lt_of_le hlevel hstrict'
  exact (not_lt_of_ge hq) hcontra

/-! Imaginary-axis barrier for the tuned factor.  The shared core computes the
    exact squared norm as a quadratic in `y²`; the two sign hypotheses certify
    that its minimum is the value at the origin.  This is the vertical
    separator needed by the component transport argument. -/
theorem tuned_raise_imaginary_axis_set_avoids_of_eval_norm_ge
    {p : ℂ[X]} {c₀ c L A d : ℝ}
    (hB : 0 ≤ L ^ 2 - A * L + d)
    (hC : 0 ≤ 2 * L ^ 2 - 2 * A * L + A ^ 2 - 2 * d)
    (hsep : ∀ y : ℝ, c₀ ≤ ‖p.eval ((y : ℂ) * Complex.I)‖)
    (hlevel : c < c₀ * (L ^ 2 - A * L + d)) :
    ∀ y : ℝ, (y : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047TunedRaise.tunedRaisePolynomial p
          (L : ℂ) (A : ℂ) (d : ℂ)) c := by
  intro y hz
  let z : ℂ := (y : ℂ) * Complex.I
  have hq : ‖(Erdos1047TunedRaise.tunedRaisePolynomial p
      (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ ≤ c := by
    change ‖(Erdos1047TunedRaise.tunedRaisePolynomial p
      (L : ℂ) (A : ℂ) (d : ℂ)).eval ((y : ℂ) * Complex.I)‖ ≤ c at hz
    simpa [z] using hz
  have hnormsq : (L ^ 2 - A * L + d) ^ 2 ≤
      ‖(Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ ^ 2 := by
    have h := Erdos1047TunedRaise.tunedRaiseFactor_normSq_on_imaginary_axis
      (L := L) (A := A) (d := d) (y := y) hB hC
    rw [Complex.normSq_eq_norm_sq] at h
    simpa [z, Erdos1047TunedRaise.tunedRaiseFactor_eval] using h
  have hfac : L ^ 2 - A * L + d ≤
      ‖(Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ := by
    have hn := norm_nonneg
      ((Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval z)
    nlinarith
  have hstrict : c₀ * (L ^ 2 - A * L + d) ≤
      ‖p.eval z‖ *
        ‖(Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ := by
    have hsep' : c₀ ≤ ‖p.eval z‖ := by
      simpa [z] using hsep y
    have hleft := mul_le_mul_of_nonneg_right hsep' hB
    have hright := mul_le_mul_of_nonneg_left hfac (norm_nonneg (p.eval z))
    linarith
  have hcontra : c <
      ‖(Erdos1047TunedRaise.tunedRaisePolynomial p
        (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ := by
    rw [Erdos1047TunedRaise.tunedRaisePolynomial_eval, norm_mul]
    have hstrict' := hstrict
    rw [Erdos1047TunedRaise.tunedRaiseFactor_eval] at hstrict'
    exact lt_of_lt_of_le hlevel hstrict'
  exact (not_lt_of_ge hq) hcontra

/-! Real-axis barrier for a tuned factor with nonnegative discriminant gap.
    Completing the square gives
    `q(x)=(x-L+A/2)^2 + d-A^2/4`; hence `A^2≤4d` supplies a uniform
    lower bound on the factor norm over the whole real axis. -/
theorem tuned_raise_real_axis_set_avoids_of_eval_norm_ge
    {p : ℂ[X]} {c₀ c L A d : ℝ}
    (hdisc : A ^ 2 ≤ 4 * d)
    (hsep : ∀ x : ℝ, 0 ≤ x → c₀ ≤ ‖p.eval (x : ℂ)‖)
    (hlevel : c < c₀ * (d - A ^ 2 / 4)) :
    ∀ x : ℝ, 0 ≤ x → (x : ℂ) ∉
      Erdos1047.sublevelSet
        (Erdos1047TunedRaise.tunedRaisePolynomial p
          (L : ℂ) (A : ℂ) (d : ℂ)) c := by
  intro x hx hz
  let z : ℂ := (x : ℂ)
  have hq : ‖(Erdos1047TunedRaise.tunedRaisePolynomial p
      (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ ≤ c := by
    change ‖(Erdos1047TunedRaise.tunedRaisePolynomial p
      (L : ℂ) (A : ℂ) (d : ℂ)).eval (x : ℂ)‖ ≤ c at hz
    simpa [z] using hz
  have hgap : 0 ≤ d - A ^ 2 / 4 := by nlinarith
  have hxa : d - A ^ 2 / 4 ≤
      ((Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval z).re := by
    rw [Erdos1047TunedRaise.tunedRaiseFactor_eval]
    dsimp [z]
    norm_num [Complex.sub_re, Complex.sub_im, Complex.mul_re,
      Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im, pow_two]
    nlinarith [sq_nonneg (x - L + A / 2)]
  have hfac : d - A ^ 2 / 4 ≤
      ‖(Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ :=
    le_trans hxa (Complex.re_le_norm _)
  have hstrict : c₀ * (d - A ^ 2 / 4) ≤
      ‖p.eval z‖ *
        ‖(Erdos1047TunedRaise.tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ := by
    have hsep' : c₀ ≤ ‖p.eval z‖ := by
      simpa [z] using hsep x hx
    have hleft := mul_le_mul_of_nonneg_right hsep' hgap
    have hright := mul_le_mul_of_nonneg_left hfac (norm_nonneg (p.eval z))
    linarith
  have hcontra : c <
      ‖(Erdos1047TunedRaise.tunedRaisePolynomial p
        (L : ℂ) (A : ℂ) (d : ℂ)).eval z‖ := by
    rw [Erdos1047TunedRaise.tunedRaisePolynomial_eval, norm_mul]
    have hstrict' := hstrict
    rw [Erdos1047TunedRaise.tunedRaiseFactor_eval] at hstrict'
    exact lt_of_lt_of_le hlevel hstrict'
  exact (not_lt_of_ge hq) hcontra

/-! Concrete p₅ right-half-line specialization of the restricted separator. -/
theorem p5_right_real_axis_raise_avoids_of_eval_bound
    {L E : ℝ} (hL : 0 < L) (hfactor : L ^ 2 ≤ E ^ 2) :
    ∀ x : ℝ, 0 ≤ x →
      (x : ℂ) ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ) ((E : ℂ) ^ 2))
          (p5WitnessLevel * L ^ 2) := by
  have h := degree_raise_horizontal_set_avoids_of_eval_norm_gt
    (p := p5Polynomial) (c := p5WitnessLevel) (L := L) (E := E)
    (a := (0 : ℝ)) (P := fun x : ℝ => 0 ≤ x) hL
    (by nlinarith [hfactor])
    (by
      intro x hx
      simpa using p5_right_real_axis_eval_norm_gt x hx)
  simpa using h

/-! Concrete p₅ left-upper half-line specialization. -/
theorem p5_left_upper_horizontal_raise_avoids_of_eval_bound
    {L E : ℝ} (hL : 0 < L)
    (hfactor : L ^ 2 ≤ E ^ 2 - (1 / 2 : ℝ) ^ 2) :
    ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (1 / 2 : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ) ((E : ℂ) ^ 2))
          (p5WitnessLevel * L ^ 2) := by
  intro x hx
  have hsep : ∀ x : ℝ, x ≤ 0 →
      p5WitnessLevel < ‖p5Polynomial.eval
        ((x : ℂ) + (1 / 2 : ℝ) * Complex.I)‖ := by
    intro y hy
    have hy' := p5_left_upper_horizontal_eval_norm_gt y hy
    convert hy' using 1 <;> norm_num
  have h := degree_raise_horizontal_set_avoids_of_eval_norm_gt
    (p := p5Polynomial) (c := p5WitnessLevel) (L := L) (E := E)
    (a := (1 / 2 : ℝ)) (P := fun y : ℝ => y ≤ 0) hL hfactor hsep
  have hx' := h x hx
  convert hx' using 1 <;> norm_num

/-! With the sharpened factor estimate, the same left horizontal barrier
    persists for the natural choice `E=L`.  The loss `1/4` on the factor is
    dominated by the tiny but strict gap between the witness level and the
    critical level once `L` is at least `1000`. -/
theorem p5_left_upper_horizontal_eval_norm_ge (x : ℝ) (hx : x ≤ 0) :
    p5Level ≤ ‖p5Polynomial.eval
      ((x : ℂ) + (1 / 2 : ℝ) * Complex.I)‖ := by
  have hs := p5_left_horizontal_normSq_ge x hx
  rw [Complex.normSq_eq_norm_sq] at hs
  have hn : 0 ≤ ‖p5Polynomial.eval
      ((x : ℂ) + (1 / 2 : ℝ) * Complex.I)‖ := norm_nonneg _
  have heq : (1 / 2 : ℂ) = ((1 / 2 : ℝ) : ℂ) := by norm_num
  rw [heq] at hs
  exact le_of_sq_le_sq hs hn

/-! Concrete p₅ instance for the tuned slope.  The old left-upper barrier
    survives for every nonpositive slope and nonnegative height once the real
    centre is large; no estimate on the linear correction is needed. -/
theorem p5_left_upper_horizontal_tuned_raise_avoids_of_scaled_eval_bound
    {L A d : ℝ} (hL : 1000 ≤ L) (hA : A ≤ 0) (hd : 0 ≤ d) :
    ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (1 / 2 : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047TunedRaise.tunedRaisePolynomial p5Polynomial
            (L : ℂ) (A : ℂ) (d : ℂ))
          (p5WitnessLevel * L ^ 2) := by
  have h := tuned_raise_horizontal_set_avoids_of_eval_norm_gt_left_halfline
    (p := p5Polynomial) (c₀ := p5Level) (c := p5WitnessLevel * L ^ 2)
    (L := L) (A := A) (d := d) (a := (1 / 2 : ℝ))
    (P := fun x : ℝ => x ≤ 0) (by nlinarith [sq_nonneg (L - 1000)])
    (by nlinarith [sq_nonneg (L - 1000)]) hA hd
    (by intro x hx; exact hx)
    (by
      intro x hx
      exact p5_left_upper_horizontal_eval_norm_ge x hx)
    (by
      have hLsq : 1000000 ≤ L ^ 2 := by
        nlinarith [sq_nonneg (L - 1000)]
      norm_num [p5WitnessLevel, p5Level]
      nlinarith [hLsq])
  simpa using h

theorem p5_left_upper_horizontal_raise_avoids_of_scaled_eval_bound
    {L : ℝ} (hL : 1000 ≤ L) :
    ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (1 / 2 : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
            ((L : ℂ) ^ 2))
          (p5WitnessLevel * L ^ 2) := by
  have h := degree_raise_horizontal_set_avoids_of_eval_norm_gt_scaled
    (p := p5Polynomial) (c₀ := p5Level) (c := p5WitnessLevel * L ^ 2)
    (L := L) (E := L) (a := (1 / 2 : ℝ)) (P := fun x : ℝ => x ≤ 0)
    (by nlinarith [sq_nonneg (L - 1000)])
    (by
      intro x hx
      exact p5_left_upper_horizontal_eval_norm_ge x hx)
    (by
      have hLsq : 1000000 ≤ L ^ 2 := by
        nlinarith [sq_nonneg (L - 1000)]
      norm_num [p5WitnessLevel, p5Level]
      nlinarith [hLsq])
  simpa using h

theorem p5_left_lower_horizontal_eval_norm_gt (x : ℝ) (hx : x ≤ 0) :
    p5Level ≤ ‖p5Polynomial.eval
      ((x : ℂ) + (-1 / 2 : ℝ) * Complex.I)‖ := by
  let z : ℂ := (x : ℂ) + (-1 / 2 : ℝ) * Complex.I
  have hstar : star z = (x : ℂ) + (1 / 2 : ℝ) * Complex.I := by
    dsimp [z]
    apply Complex.ext <;> norm_num
  calc
    p5Level ≤ ‖p5Polynomial.eval (star z)‖ := by
      rw [hstar]
      simpa using p5_left_upper_horizontal_eval_norm_ge x hx
    _ = ‖star (p5Polynomial.eval z)‖ := by rw [p5_eval_star]
    _ = ‖p5Polynomial.eval z‖ := norm_star _

theorem p5_left_lower_horizontal_eval_norm_ge (x : ℝ) (hx : x ≤ 0) :
    p5Level ≤ ‖p5Polynomial.eval
      ((x : ℂ) + (-1 / 2 : ℝ) * Complex.I)‖ := by
  exact p5_left_lower_horizontal_eval_norm_gt x hx

theorem p5_left_lower_horizontal_raise_avoids_of_scaled_eval_bound
    {L : ℝ} (hL : 1000 ≤ L) :
    ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (-1 / 2 : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
            ((L : ℂ) ^ 2))
          (p5WitnessLevel * L ^ 2) := by
  have h := degree_raise_horizontal_set_avoids_of_eval_norm_gt_scaled
    (p := p5Polynomial) (c₀ := p5Level) (c := p5WitnessLevel * L ^ 2)
    (L := L) (E := L) (a := (-1 / 2 : ℝ)) (P := fun x : ℝ => x ≤ 0)
    (by nlinarith [sq_nonneg (L - 1000)])
    (by
      intro x hx
      exact p5_left_lower_horizontal_eval_norm_ge x hx)
    (by
      have hLsq : 1000000 ≤ L ^ 2 := by
        nlinarith [sq_nonneg (L - 1000)]
      norm_num [p5WitnessLevel, p5Level]
      nlinarith [hLsq])
  simpa using h

/-! Compactness supplies simultaneous coordinate barriers for one degree raise.
    The choice `E = L + a + 1` makes both factor inequalities automatic.
    This is a front-end lemma: it isolates the old-sublevel geometry before
    the still-missing old-old component transport argument. -/
theorem exists_degree_raise_coordinate_barriers
    {p : ℂ[X]} (hdeg : 0 < p.degree) (c : ℝ) :
    ∃ L E a : ℝ,
      0 < L ∧ L ≤ E ∧ L ^ 2 ≤ E ^ 2 - a ^ 2 ∧
      (∀ z ∈ Erdos1047.sublevelSet p c, z.re < L / 2) ∧
      (∀ z ∈ Erdos1047.sublevelSet p c, z.im < a) := by
  rcases sublevelSet_re_bound_of_positive_degree hdeg c with ⟨Mre, hMre⟩
  rcases sublevelSet_im_bound_of_positive_degree hdeg c with ⟨Mim, hMim⟩
  let L : ℝ := 2 * (|Mre| + 1)
  let a : ℝ := |Mim| + 1
  let E : ℝ := L + a + 1
  have hL : 0 < L := by
    dsimp [L]
    have hnon : 0 ≤ |Mre| := abs_nonneg _
    nlinarith
  have ha : 0 ≤ a := by
    dsimp [a]
    have hnon : 0 ≤ |Mim| := abs_nonneg _
    nlinarith
  have hLE : L ≤ E := by
    dsimp [E]
    nlinarith
  have hfactor : L ^ 2 ≤ E ^ 2 - a ^ 2 := by
    dsimp [E]
    nlinarith [sq_nonneg L, sq_nonneg a]
  refine ⟨L, E, a, hL, hLE, hfactor, ?_, ?_⟩
  · intro z hz
    have hzabs : |z.re| ≤ Mre := by
      simpa [Real.norm_eq_abs] using hMre z hz
    have hzre : z.re ≤ |z.re| := le_abs_self _
    have hMabs : Mre ≤ |Mre| := le_abs_self _
    dsimp [L]
    nlinarith
  · intro z hz
    have hzabs : |z.im| ≤ Mim := by
      simpa [Real.norm_eq_abs] using hMim z hz
    have hzim : z.im ≤ |z.im| := le_abs_self _
    have hMabs : Mim ≤ |Mim| := le_abs_self _
    dsimp [a]
    nlinarith

/-! Composition with the factor lower bounds gives actual avoided lines for the
    raised sublevel.  This is the strongest unconditional geometric statement
    currently available for the new-root separation front-end. -/
theorem exists_degree_raise_avoiding_coordinate_lines
    {p : ℂ[X]} (hdeg : 0 < p.degree) (c : ℝ) :
    ∃ L E a : ℝ,
      0 < L ∧ L ≤ E ∧ L ^ 2 ≤ E ^ 2 - a ^ 2 ∧
      (∀ y : ℝ, (L / 2 : ℂ) + (y : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
          (c * L ^ 2)) ∧
      (∀ x : ℝ, (x : ℂ) + (a : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
          (c * L ^ 2)) := by
  rcases exists_degree_raise_coordinate_barriers hdeg c with
    ⟨L, E, a, hL, hLE, hfactor, hsepRe, hsepIm⟩
  refine ⟨L, E, a, hL, hLE, hfactor, ?_, ?_⟩
  · exact degree_raise_vertical_line_avoids_of_sublevel_re_bound hL hLE hsepRe
  · exact degree_raise_horizontal_line_avoids_of_sublevel_im_bound hL hfactor hsepIm

/-! A symmetric version of the coordinate-barrier front end.  The compactness
    bounds give both horizontal half-planes, so the two new roots can be
    separated from the old sublevel on opposite sides of the pair. -/
theorem exists_degree_raise_avoiding_symmetric_coordinate_lines
    {p : ℂ[X]} (hdeg : 0 < p.degree) (c : ℝ) :
    ∃ L E a : ℝ,
      0 < L ∧ L ≤ E ∧ L ^ 2 ≤ E ^ 2 - a ^ 2 ∧
      (∀ y : ℝ, (L / 2 : ℂ) + (y : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
          (c * L ^ 2)) ∧
      (∀ x : ℝ, (x : ℂ) + (a : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
          (c * L ^ 2)) ∧
      (∀ x : ℝ, (x : ℂ) + (-a : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
          (c * L ^ 2)) := by
  rcases sublevelSet_re_bound_of_positive_degree hdeg c with ⟨Mre, hMre⟩
  rcases sublevelSet_im_bound_of_positive_degree hdeg c with ⟨Mim, hMim⟩
  let L : ℝ := 2 * (|Mre| + 1)
  let a : ℝ := |Mim| + 1
  let E : ℝ := L + a + 1
  have hL : 0 < L := by
    dsimp [L]
    have hnon : 0 ≤ |Mre| := abs_nonneg _
    nlinarith
  have ha : 0 ≤ a := by
    dsimp [a]
    have hnon : 0 ≤ |Mim| := abs_nonneg _
    nlinarith
  have hLE : L ≤ E := by
    dsimp [E]
    nlinarith
  have hfactor : L ^ 2 ≤ E ^ 2 - a ^ 2 := by
    dsimp [E]
    nlinarith [sq_nonneg L, sq_nonneg a]
  have hRe : ∀ z ∈ Erdos1047.sublevelSet p c, z.re < L / 2 := by
    intro z hz
    have hzabs : |z.re| ≤ Mre := by
      simpa [Real.norm_eq_abs] using hMre z hz
    have hzre : z.re ≤ |z.re| := le_abs_self _
    have hMabs : Mre ≤ |Mre| := le_abs_self _
    dsimp [L]
    nlinarith
  have hImUpper : ∀ z ∈ Erdos1047.sublevelSet p c, z.im < a := by
    intro z hz
    have hzabs : |z.im| ≤ Mim := by
      simpa [Real.norm_eq_abs] using hMim z hz
    have hzim : z.im ≤ |z.im| := le_abs_self _
    have hMabs : Mim ≤ |Mim| := le_abs_self _
    dsimp [a]
    nlinarith
  have hImLower : ∀ z ∈ Erdos1047.sublevelSet p c, -a < z.im := by
    intro z hz
    have hzabs : |z.im| ≤ Mim := by
      simpa [Real.norm_eq_abs] using hMim z hz
    have hneg : -|z.im| ≤ z.im := neg_abs_le _
    have hMabs : Mim ≤ |Mim| := le_abs_self _
    dsimp [a]
    nlinarith
  refine ⟨L, E, a, hL, hLE, hfactor, ?_, ?_, ?_⟩
  · exact degree_raise_vertical_line_avoids_of_sublevel_re_bound hL hLE hRe
  · exact degree_raise_horizontal_line_avoids_of_sublevel_im_bound hL hfactor hImUpper
  · have hfactor' : L ^ 2 ≤ E ^ 2 - (-a) ^ 2 := by
      simpa [sq] using hfactor
    convert degree_raise_horizontal_line_avoids_of_sublevel_im_lower_bound
      (a := -a) hL hfactor' hImLower using 1 <;> norm_num

/-! The symmetric barriers separate the two new quadratic roots from every
    old root.  This is the finite bookkeeping step that can be combined with
    any independently transported old-old separators. -/
theorem degree_raise_new_root_coordinate_separators
    {p : ℂ[X]} {L E a c : ℝ}
    (hL : 0 < L) (hLE : L ≤ E) (hnew : -E < a ∧ a < E)
    (hOldRe : ∀ r ∈ (↑(p.rootSet ℂ) : Set ℂ), r.re < L / 2)
    (hvert : ∀ y : ℝ, (L / 2 : ℂ) + (y : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
        (c * L ^ 2))
    (hupper : ∀ x : ℝ, (x : ℂ) + (a : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
        (c * L ^ 2))
    (holdsep : ∀ ⦃r s : ℂ⦄,
      r ∈ (↑(p.rootSet ℂ) : Set ℂ) → s ∈ (↑(p.rootSet ℂ) : Set ℂ) → r ≠ s →
      (∃ b : ℝ, (∀ z ∈ Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
          (c * L ^ 2), z.re ≠ b) ∧
        ((r.re < b ∧ b < s.re) ∨ (s.re < b ∧ b < r.re))) ∨
      (∃ b : ℝ, (∀ z ∈ Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
          (c * L ^ 2), z.im ≠ b) ∧
        ((r.im < b ∧ b < s.im) ∨ (s.im < b ∧ b < r.im)))) :
    ∀ ⦃r s : ℂ⦄,
      r ∈ (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({(L : ℂ) + (E : ℂ) * Complex.I,
          (L : ℂ) - (E : ℂ) * Complex.I} : Set ℂ) →
      s ∈ (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({(L : ℂ) + (E : ℂ) * Complex.I,
          (L : ℂ) - (E : ℂ) * Complex.I} : Set ℂ) →
      r ≠ s →
      (∃ b : ℝ, (∀ z ∈ Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
          (c * L ^ 2), z.re ≠ b) ∧
        ((r.re < b ∧ b < s.re) ∨ (s.re < b ∧ b < r.re))) ∨
      (∃ b : ℝ, (∀ z ∈ Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
          (c * L ^ 2), z.im ≠ b) ∧
        ((r.im < b ∧ b < s.im) ∨ (s.im < b ∧ b < r.im))) := by
  have hzeroRe : ∀ z ∈ Erdos1047.sublevelSet
      (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
      (c * L ^ 2), z.re ≠ L / 2 := by
    intro z hz hzr
    have hrepr : z = (L / 2 : ℂ) + (z.im : ℂ) * Complex.I := by
      apply Complex.ext <;> simp [hzr]
    apply (hvert z.im)
    rw [← hrepr]
    exact hz
  have hzeroIm : ∀ z ∈ Erdos1047.sublevelSet
      (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((E : ℂ) ^ 2))
      (c * L ^ 2), z.im ≠ a := by
    intro z hz hzi
    have hrepr : z = (z.re : ℂ) + (a : ℂ) * Complex.I := by
      apply Complex.ext <;> simp [hzi]
    apply (hupper z.re)
    rw [← hrepr]
    exact hz
  intro r s hr hs hrs
  rcases hr with hrOld | hrNew
  · rcases hs with hsOld | hsNew
    · exact holdsep hrOld hsOld hrs
    · have hs' : s = (L : ℂ) + (E : ℂ) * Complex.I ∨
          s = (L : ℂ) - (E : ℂ) * Complex.I := by
        simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hsNew
      refine Or.inl ⟨L / 2, hzeroRe, ?_⟩
      rcases hs' with rfl | rfl
      · left
        constructor
        · exact hOldRe r hrOld
        · norm_num
          linarith
      · left
        constructor
        · exact hOldRe r hrOld
        · norm_num
          linarith
  · rcases hs with hsOld | hsNew
    · have hr' : r = (L : ℂ) + (E : ℂ) * Complex.I ∨
          r = (L : ℂ) - (E : ℂ) * Complex.I := by
        simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hrNew
      refine Or.inl ⟨L / 2, hzeroRe, ?_⟩
      rcases hr' with rfl | rfl
      · right
        constructor
        · exact hOldRe s hsOld
        · norm_num
          linarith
      · right
        constructor
        · exact hOldRe s hsOld
        · norm_num
          linarith
    · have hr' : r = (L : ℂ) + (E : ℂ) * Complex.I ∨
          r = (L : ℂ) - (E : ℂ) * Complex.I := by
        simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hrNew
      have hs' : s = (L : ℂ) + (E : ℂ) * Complex.I ∨
          s = (L : ℂ) - (E : ℂ) * Complex.I := by
        simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hsNew
      rcases hr' with rfl | rfl <;> rcases hs' with rfl | rfl
      · exact (hrs rfl).elim
      · refine Or.inr ⟨a, hzeroIm, Or.inr ?_⟩
        exact ⟨by norm_num; linarith [hnew.1], by norm_num; linarith [hnew.2]⟩
      · refine Or.inr ⟨a, hzeroIm, Or.inl ?_⟩
        exact ⟨by norm_num; linarith [hnew.2], by norm_num; linarith [hnew.1]⟩
      · exact (hrs rfl).elim

/-! The even family has an explicit regular-value range.  Since its critical
    values are exactly `1` and `2`, every level strictly below `1` is regular. -/
theorem evenFamily_closedBall_subset_regular_values_of_lt_one
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : c < 1) :
    Metric.closedBall (0 : ℂ) c ⊆
      ((Erdos1047EvenFamily.evenFamilyPolynomial m).eval ''
        {u : ℂ | (Erdos1047EvenFamily.evenFamilyPolynomial m).derivative.eval u = 0})ᶜ := by
  apply closedBall_subset_regular_values_of_critical_value_norm_gt
  intro u hu
  rcases Erdos1047EvenFamily.evenFamily_critical_eval_eq_one_or_two hm hu with h1 | h2
  · rw [h1]
    simpa using hc
  · rw [h2]
    calc
      c < 1 := hc
      _ < ‖(2 : ℂ)‖ := by norm_num

/-! At a nonnegative level below `1`, regular-value exhaustion and the exact
    root count give the universal component upper bound for the even family. -/
theorem evenFamily_componentsIn_ncard_le
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : 0 ≤ c) (hc1 : c < 1) :
    (Erdos1047.componentsIn
      (Erdos1047.sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)).ncard ≤
      2 * m := by
  rw [componentsIn_eq_image_rootSet_of_regular_values
    (Erdos1047EvenFamily.evenFamily_monic m hm) hc
    (evenFamily_closedBall_subset_regular_values_of_lt_one hm hc1)]
  calc
    (connectedComponentIn
        (Erdos1047.sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) ''
      (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ)).ncard ≤
        ((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ).ncard :=
      Set.ncard_image_le ((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet_finite ℂ)
    _ = 2 * m := Erdos1047EvenFamily.evenFamily_rootSet_ncard m hm

/-! The matching lower bound is isolated as a geometric injectivity hypothesis:
    once distinct roots are known to lie in distinct components, the regular
    value theorem upgrades the even-family upper bound to the exact count
    `2*m`.  This keeps the unresolved work purely in component separation. -/
theorem evenFamily_componentsIn_ncard_eq_two_mul_of_root_injOn
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : 0 ≤ c) (hc1 : c < 1)
    (hinj : Set.InjOn (fun r : ℂ => connectedComponentIn
      (Erdos1047.sublevelSet
        (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r)
      (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ)) :
    (Erdos1047.componentsIn
      (Erdos1047.sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)).ncard =
      2 * m := by
  rw [componentsIn_eq_image_rootSet_of_regular_values
    (Erdos1047EvenFamily.evenFamily_monic m hm) hc
    (evenFamily_closedBall_subset_regular_values_of_lt_one hm hc1)]
  calc
    (connectedComponentIn
        (Erdos1047.sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) ''
      (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ)).ncard =
        ((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ).ncard :=
      hinj.ncard_image
    _ = 2 * m := Erdos1047EvenFamily.evenFamily_rootSet_ncard m hm

/-! The regular-value form removes the otherwise separate finiteness gate:
    the root-exhaustion theorem identifies componentsIn with an image of the
    finite root set.  Thus the remaining geometric input is only injectivity
    of the five anchored components plus the regular-value condition. -/
theorem p5_raise_five_nonconvex_lower_bound_of_regular_values
    {e : ℂ} (he : e ≠ 0)
    (hinj : ∀ L : ℂ, L ≠ 0 →
      Set.InjOn (fun z : ℂ => connectedComponentIn
        (Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
            (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L))
          (p5WitnessLevel * ‖L‖ ^ 2)) z) (Set.range p5FiveAnchor))
    (hreg : ∀ L : ℂ, L ≠ 0 →
      Metric.closedBall (0 : ℂ) (p5WitnessLevel * ‖L‖ ^ 2) ⊆
        ((Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
            (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L)).eval ''
          {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
            (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L)).derivative.eval u = 0})ᶜ) :
    ∃ L : ℂ, L ≠ 0 ∧ 5 ≤ {t ∈ Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
          (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L))
        (p5WitnessLevel * ‖L‖ ^ 2)) |
      ¬ Convex ℝ t}.ncard := by
  obtain ⟨L, hL, hcert⟩ := p5_raise_five_robust_certificates_same_scale he
  have hmonic : (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
      (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L)).Monic := by
    exact Erdos1047DegreeRaise.raisePolynomial_monic p5Polynomial L
      (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L) p5Polynomial_monic
  have hc0 : 0 ≤ p5WitnessLevel * ‖L‖ ^ 2 := by
    have hp : 0 ≤ p5WitnessLevel := by
      norm_num [p5WitnessLevel, p5Level]
    positivity
  have hcompfin : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
          (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L))
        (p5WitnessLevel * ‖L‖ ^ 2))).Finite := by
    rw [componentsIn_eq_image_rootSet_of_regular_values hmonic hc0 (hreg L hL)]
    exact ((Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
      (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L)).rootSet_finite ℂ).image _
  exact ⟨L, hL,
    p5_raise_five_nonconvex_lower_bound hcert (hinj L hL) hcompfin⟩
/-! The preceding regular-value interface can itself be fed by a scalar
    critical-value estimate.  This is the intended reduction for the raised
    p₅ level: all topology is downstream of a single norm inequality. -/
theorem p5_raise_five_nonconvex_lower_bound_of_critical_value_bounds
    {e : ℂ} (he : e ≠ 0)
    (hinj : ∀ L : ℂ, L ≠ 0 →
      Set.InjOn (fun z : ℂ => connectedComponentIn
        (Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
            (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L))
          (p5WitnessLevel * ‖L‖ ^ 2)) z) (Set.range p5FiveAnchor))
    (hcrit : ∀ L : ℂ, L ≠ 0 → ∀ u : ℂ,
      (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
        (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L)).derivative.eval u = 0 →
      p5WitnessLevel * ‖L‖ ^ 2 <
        ‖(Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
          (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L)).eval u‖) :
    ∃ L : ℂ, L ≠ 0 ∧ 5 ≤ {t ∈ Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial L
          (Erdos1047DegreeRaise.raiseParameter 5 (e ^ 2) L))
        (p5WitnessLevel * ‖L‖ ^ 2)) |
      ¬ Convex ℝ t}.ncard := by
  apply p5_raise_five_nonconvex_lower_bound_of_regular_values he hinj
  intro L hL
  exact closedBall_subset_regular_values_of_critical_value_norm_gt (hcrit L hL)

/-! Specialization to nested polynomial sublevels at regular values.  The
    covering-map exhaustion theorem says every larger component contains a
    polynomial root; every root is already in the smaller sublevel.  Hence the
    abstract component injection applies without any extra choice of paths. -/
theorem componentsIn_ncard_le_of_nested_regular_sublevels
    (f : ℂ[X]) {c₁ c₂ : ℝ} (hf : f.Monic)
    (hc₁ : 0 ≤ c₁) (hcc : c₁ ≤ c₂)
    (hreg₂ : Metric.closedBall (0 : ℂ) c₂ ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ) :
    (componentsIn (sublevelSet f c₂)).ncard ≤
      (componentsIn (sublevelSet f c₁)).ncard := by
  let S : Set ℂ := sublevelSet f c₁
  let T : Set ℂ := sublevelSet f c₂
  have hc₂ : 0 ≤ c₂ := hc₁.trans hcc
  have hreg₁ : Metric.closedBall (0 : ℂ) c₁ ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ := by
    intro w hw
    apply hreg₂
    exact Metric.closedBall_subset_closedBall (by simpa using hcc) hw
  have himage₁ : componentsIn S =
      (fun r : ℂ ↦ connectedComponentIn S r) '' (↑(f.rootSet ℂ) : Set ℂ) := by
    exact componentsIn_eq_image_rootSet_of_regular_values hf hc₁ hreg₁
  have himage₂ : componentsIn T =
      (fun r : ℂ ↦ connectedComponentIn T r) '' (↑(f.rootSet ℂ) : Set ℂ) := by
    exact componentsIn_eq_image_rootSet_of_regular_values hf hc₂ hreg₂
  have hfinS : (componentsIn S).Finite := by
    rw [himage₁]
    exact (f.rootSet_finite ℂ).image _
  have hST : S ⊆ T := by
    intro z hz
    exact hz.trans hcc
  have hmeet : ∀ t ∈ componentsIn T, ∃ x ∈ t, x ∈ S := by
    intro t ht
    rw [himage₂] at ht
    obtain ⟨r, hr, hrt⟩ := ht
    have hrS : r ∈ S := by
      change ‖f.eval r‖ ≤ c₁
      have hrzero : f.eval r = 0 := by
        simpa using (hf.mem_rootSet.mp hr)
      rw [hrzero]
      simpa using hc₁
    refine ⟨r, ?_, hrS⟩
    rw [← hrt]
    exact mem_connectedComponentIn (hST hrS)
  exact componentsIn_ncard_le_of_component_meets hST hmeet hfinS

/-! A collision of two proposed root labels forces a strict drop in the
    component count whenever the component set is exhausted by those labels.
    This is the cardinality half of the critical-value argument: the remaining
    analytic task is to exhibit the collision at a critical level. -/
theorem componentsIn_ncard_lt_of_root_collision
    {S R : Set ℂ} (C : ℂ → Set ℂ)
    (hcomp : componentsIn S = C '' R) (hRfin : R.Finite)
    (hcollision : ∃ r ∈ R, ∃ s ∈ R, r ≠ s ∧ C r = C s) :
    (componentsIn S).ncard < R.ncard := by
  have hle : (C '' R).ncard ≤ R.ncard := Set.ncard_image_le hRfin
  have hne : (C '' R).ncard ≠ R.ncard := by
    intro heq
    have hinj : Set.InjOn C R := Set.injOn_of_ncard_image_eq heq hRfin
    obtain ⟨r, hr, s, hs, hrs, hC⟩ := hcollision
    exact hrs (hinj hr hs hC)
  rw [hcomp]
  exact Nat.lt_of_le_of_ne hle hne

theorem componentsIn_ncard_le_rootSet_ncard_of_regular_values
    {f : ℂ[X]} (hf : f.Monic) {c : ℝ} (hc0 : 0 ≤ c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ) :
    (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard ≤
      (f.rootSet ℂ).ncard := by
  rw [componentsIn_eq_image_rootSet_of_regular_values hf hc0 hreg]
  exact Set.ncard_image_le (f.rootSet_finite ℂ)

theorem componentsIn_ncard_le_natDegree_of_regular_values
    {f : ℂ[X]} (hf : f.Monic) {c : ℝ} (hc0 : 0 ≤ c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ) :
    (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard ≤ f.natDegree := by
  exact (componentsIn_ncard_le_rootSet_ncard_of_regular_values hf hc0 hreg).trans
    (f.ncard_rootSet_le ℂ)

/-! If the level is regular, the lifting theorem gives the component upper bound
    automatically. Thus a separable polynomial with `n` finite, pairwise
    separated non-convex witnesses already satisfies the exact component-count
    hypothesis required by Formal Conjectures. -/
theorem attainable_of_finite_nonconvex_witnesses_of_regular_values
    {f : ℂ[X]} {c : ℝ} {n : ℕ}
    (hf : f.Monic) (hsep : f.Separable) (hdeg : f.natDegree = n)
    (hn : 0 < n) (hc : 0 < c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ)
    {A : Set ℂ} (hAfin : A.Finite) (hAcard : A.ncard = n)
    (hmem : ∀ z ∈ A, z ∈ sublevelSet f c)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn (sublevelSet f c) z) A)
    (hnc : ∀ z ∈ A,
      ¬ Convex ℝ (connectedComponentIn (sublevelSet f c) z)) :
    n ∈ attainableNonConvexCounts n := by
  have hroot : (f.rootSet ℂ).ncard = n := by
    have hcard : Fintype.card (f.rootSet ℂ) = f.natDegree :=
      Polynomial.card_rootSet_eq_natDegree hsep (IsAlgClosed.splits _)
    simpa [hdeg] using hcard
  have hcompfin : (componentsIn (sublevelSet f c)).Finite := by
    rw [componentsIn_eq_image_rootSet_of_regular_values hf (le_of_lt hc) hreg]
    exact (f.rootSet_finite ℂ).image _
  have hCsub : (fun z : ℂ => connectedComponentIn
      (sublevelSet f c) z) '' A ⊆ componentsIn (sublevelSet f c) := by
    rintro t ⟨z, hzA, rfl⟩
    exact ⟨z, hmem z hzA, rfl⟩
  have hCcard : ((fun z : ℂ => connectedComponentIn
      (sublevelSet f c) z) '' A).ncard = n := by
    rw [hcompInj.ncard_image, hAcard]
  have hcompLower : n ≤ (componentsIn (sublevelSet f c)).ncard := by
    rw [← hCcard]
    exact Set.ncard_le_ncard hCsub hcompfin
  have hcompUpper : (componentsIn (sublevelSet f c)).ncard ≤ n := by
    rw [← hroot]
    exact componentsIn_ncard_le_rootSet_ncard_of_regular_values hf
      (le_of_lt hc) hreg
  have hcomp : (componentsIn (sublevelSet f c)).ncard = n :=
    Nat.le_antisymm hcompUpper hcompLower
  exact attainable_of_finite_nonconvex_witnesses_of_separable hf hsep hdeg hn hc
    hcomp hAfin hAcard hmem hcompInj hnc

/-! Count-only interface for the power-linear detour.  Once an explicit
    calculation gives `n` non-convex components at a level below the critical
    circle, the regular-value bookkeeping supplies the exact root/component
    hypothesis required by `attainableNonConvexCounts`. -/
theorem powerLinearPolynomial_attainable_of_nonconvex_count
    {n : ℕ} (hn : 2 ≤ n) {c : ℝ} (hc : 0 < c) (hc_lt : c < n - 1)
    (hnc : {t ∈ componentsIn (sublevelSet (powerLinearPolynomial n) c) |
      ¬ Convex ℝ t}.ncard = n) :
    n ∈ attainableNonConvexCounts n := by
  let f : ℂ[X] := powerLinearPolynomial n
  have hfm : f.Monic := by
    dsimp [f]
    exact Erdos1047PowerLinear.monic hn
  have hfsep : f.Separable := by
    dsimp [f]
    exact Erdos1047PowerLinear.separable hn
  have hfdeg : f.natDegree = n := by
    dsimp [f]
    exact Erdos1047PowerLinear.natDegree hn
  have hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ := by
    dsimp [f]
    exact powerLinearPolynomial_closedBall_subset_regular_values hn hc_lt
  have hupper : (componentsIn (sublevelSet f c)).ncard ≤ n := by
    dsimp [f]
    exact powerLinearPolynomial_componentsIn_ncard_le hn (le_of_lt hc) hc_lt
  have hcompfin : (componentsIn (sublevelSet f c)).Finite := by
    rw [componentsIn_eq_image_rootSet_of_regular_values hfm (le_of_lt hc) hreg]
    exact (f.rootSet_finite ℂ).image _
  have hnc' : {t ∈ componentsIn (sublevelSet f c) | ¬ Convex ℝ t}.ncard = n := by
    simpa [f] using hnc
  have hcomp : (componentsIn (sublevelSet f c)).ncard = n := by
    have hle : {t ∈ componentsIn (sublevelSet f c) | ¬ Convex ℝ t}.ncard ≤
        (componentsIn (sublevelSet f c)).ncard := by
      apply Set.ncard_le_ncard
      · intro t ht
        exact ht.1
      · exact hcompfin
    have hlow : n ≤ (componentsIn (sublevelSet f c)).ncard := by
      rw [← hnc']
      exact hle
    exact Nat.le_antisymm hupper hlow
  have hroot : (f.rootSet ℂ).ncard = n := by
    dsimp [f]
    exact Erdos1047PowerLinear.rootSet_ncard hn
  refine ⟨f, c, hfm, hfdeg, hc, ?_, ?_⟩
  · exact hcomp.trans hroot.symm
  · simpa [f] using hnc

/-! The degree-six even-family candidate has no critical value in the closed
disc of radius `level`; hence every sublevel component is represented by a
root.  The reverse injectivity (needed for the exact component count) remains
a separate geometric obligation. -/
theorem p6_componentsIn_eq_image_rootSet :
    Erdos1047.componentsIn
        (Erdos1047.sublevelSet p6Polynomial Erdos1047P6.level) =
      (fun r : ℂ ↦ connectedComponentIn
        (Erdos1047.sublevelSet p6Polynomial Erdos1047P6.level) r) ''
        (↑(p6Polynomial.rootSet ℂ) : Set ℂ) := by
  simpa [p6Polynomial] using
    (componentsIn_eq_image_rootSet_of_regular_values
      (Erdos1047EvenFamily.evenFamily_monic 3 (by omega))
      (by norm_num [Erdos1047P6.level])
      Erdos1047P6.closedBall_subset_regular_values)

theorem p6_componentsIn_ncard_le_six :
    (Erdos1047.componentsIn
        (Erdos1047.sublevelSet p6Polynomial Erdos1047P6.level)).ncard ≤ 6 := by
  rw [p6_componentsIn_eq_image_rootSet]
  calc
    _ ≤ (p6Polynomial.rootSet ℂ).ncard :=
      Set.ncard_image_le (p6Polynomial.rootSet_finite ℂ)
    _ = 6 := p6Polynomial_algebraic_data.2.2.2

/-! The six explicit anchors are pairwise separated by the three forbidden
lines.  Together with the root-component upper bound this closes the exact
component count for the degree-six candidate. -/
theorem p6_componentsIn_ncard_core :
    (componentsIn (sublevelSet Erdos1047P6.polynomial Erdos1047P6.level)).ncard = 6 := by
  let K := sublevelSet Erdos1047P6.polynomial Erdos1047P6.level
  let C0 := connectedComponentIn K Erdos1047P6.anchor
  let C1 := connectedComponentIn K
    (Erdos1047P6.omega ^ 1 * Erdos1047P6.anchor)
  let C2 := connectedComponentIn K
    (Erdos1047P6.omega ^ 2 * Erdos1047P6.anchor)
  let C3 := connectedComponentIn K (star Erdos1047P6.anchor)
  let C4 := connectedComponentIn K
    (Erdos1047P6.omega ^ 1 * star Erdos1047P6.anchor)
  let C5 := connectedComponentIn K
    (Erdos1047P6.omega ^ 2 * star Erdos1047P6.anchor)
  have hfin : (componentsIn K).Finite := by
    change (componentsIn (sublevelSet p6Polynomial Erdos1047P6.level)).Finite
    rw [p6_componentsIn_eq_image_rootSet]
    exact (p6Polynomial.rootSet_finite ℂ).image _
  have hupper : (componentsIn K).ncard ≤ 6 := by
    change (componentsIn (sublevelSet p6Polynomial Erdos1047P6.level)).ncard ≤ 6
    exact p6_componentsIn_ncard_le_six
  have h0K : Erdos1047P6.anchor ∈ K :=
    p6_lineA_subset (left_mem_segment ℝ Erdos1047P6.anchor Erdos1047P6.pointA)
  have h1K : Erdos1047P6.omega ^ 1 * Erdos1047P6.anchor ∈ K :=
    (p6_mem_mul_omega_pow_iff 1 Erdos1047P6.anchor).2 h0K
  have h2K : Erdos1047P6.omega ^ 2 * Erdos1047P6.anchor ∈ K :=
    (p6_mem_mul_omega_pow_iff 2 Erdos1047P6.anchor).2 h0K
  have h3K : star Erdos1047P6.anchor ∈ K :=
    (p6_mem_star_iff Erdos1047P6.anchor).2 h0K
  have h4K : Erdos1047P6.omega ^ 1 * star Erdos1047P6.anchor ∈ K :=
    (p6_mem_mul_omega_pow_iff 1 (star Erdos1047P6.anchor)).2 h3K
  have h5K : Erdos1047P6.omega ^ 2 * star Erdos1047P6.anchor ∈ K :=
    (p6_mem_mul_omega_pow_iff 2 (star Erdos1047P6.anchor)).2 h3K
  obtain ⟨h01, h02, h03, h04, h05, h12, h13, h14, h15,
    h23, h24, h25, h34, h35, h45⟩ := p6_six_components_pairwise_distinct
  change C0 ≠ C1 at h01
  change C0 ≠ C2 at h02
  change C0 ≠ C3 at h03
  change C0 ≠ C4 at h04
  change C0 ≠ C5 at h05
  change C1 ≠ C2 at h12
  change C1 ≠ C3 at h13
  change C1 ≠ C4 at h14
  change C1 ≠ C5 at h15
  change C2 ≠ C3 at h23
  change C2 ≠ C4 at h24
  change C2 ≠ C5 at h25
  change C3 ≠ C4 at h34
  change C3 ≠ C5 at h35
  change C4 ≠ C5 at h45
  have hsix : ({C0, C1, C2, C3, C4, C5} : Set (Set ℂ)).ncard = 6 := by
    rw [Set.ncard_insert_of_notMem (by simp [h01, h02, h03, h04, h05])]
    rw [Set.ncard_insert_of_notMem (by simp [h12, h13, h14, h15])]
    rw [Set.ncard_insert_of_notMem (by simp [h23, h24, h25])]
    rw [Set.ncard_insert_of_notMem (by simp [h34, h35])]
    rw [Set.ncard_insert_of_notMem (by simp [h45])]
    simp
  have hsubset : ({C0, C1, C2, C3, C4, C5} : Set (Set ℂ)) ⊆ componentsIn K := by
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨⟨Erdos1047P6.anchor, h0K, rfl⟩,
      ⟨Erdos1047P6.omega ^ 1 * Erdos1047P6.anchor, h1K, rfl⟩,
      ⟨Erdos1047P6.omega ^ 2 * Erdos1047P6.anchor, h2K, rfl⟩,
      ⟨star Erdos1047P6.anchor, h3K, rfl⟩,
      ⟨Erdos1047P6.omega ^ 1 * star Erdos1047P6.anchor, h4K, rfl⟩,
      ⟨Erdos1047P6.omega ^ 2 * star Erdos1047P6.anchor, h5K, rfl⟩⟩
  have hlower : 6 ≤ (componentsIn K).ncard := by
    rw [← hsix]
    exact Set.ncard_le_ncard hsubset hfin
  change (componentsIn K).ncard = 6
  exact Nat.le_antisymm hupper hlower

theorem p6_componentsIn_ncard :
    (componentsIn (sublevelSet p6Polynomial Erdos1047P6.level)).ncard = 6 := by
  simpa [p6Polynomial, Erdos1047P6.polynomial] using p6_componentsIn_ncard_core

theorem p6_nonconvex_ncard_core :
    {t ∈ componentsIn (sublevelSet Erdos1047P6.polynomial Erdos1047P6.level) |
      ¬ Convex ℝ t}.ncard = 6 := by
  let K := sublevelSet Erdos1047P6.polynomial Erdos1047P6.level
  let C0 := connectedComponentIn K Erdos1047P6.anchor
  let C1 := connectedComponentIn K
    (Erdos1047P6.omega ^ 1 * Erdos1047P6.anchor)
  let C2 := connectedComponentIn K
    (Erdos1047P6.omega ^ 2 * Erdos1047P6.anchor)
  let C3 := connectedComponentIn K (star Erdos1047P6.anchor)
  let C4 := connectedComponentIn K
    (Erdos1047P6.omega ^ 1 * star Erdos1047P6.anchor)
  let C5 := connectedComponentIn K
    (Erdos1047P6.omega ^ 2 * star Erdos1047P6.anchor)
  let N := {t ∈ componentsIn K | ¬ Convex ℝ t}
  have hK : (componentsIn K).ncard = 6 := by
    simpa using p6_componentsIn_ncard_core
  have hKfin : (componentsIn K).Finite := by
    change (componentsIn (sublevelSet p6Polynomial Erdos1047P6.level)).Finite
    rw [p6_componentsIn_eq_image_rootSet]
    exact (p6Polynomial.rootSet_finite ℂ).image _
  have h0K : Erdos1047P6.anchor ∈ K :=
    p6_lineA_subset (left_mem_segment ℝ Erdos1047P6.anchor Erdos1047P6.pointA)
  have h1K : Erdos1047P6.omega ^ 1 * Erdos1047P6.anchor ∈ K :=
    (p6_mem_mul_omega_pow_iff 1 Erdos1047P6.anchor).2 h0K
  have h2K : Erdos1047P6.omega ^ 2 * Erdos1047P6.anchor ∈ K :=
    (p6_mem_mul_omega_pow_iff 2 Erdos1047P6.anchor).2 h0K
  have h3K : star Erdos1047P6.anchor ∈ K :=
    (p6_mem_star_iff Erdos1047P6.anchor).2 h0K
  have h4K : Erdos1047P6.omega ^ 1 * star Erdos1047P6.anchor ∈ K :=
    (p6_mem_mul_omega_pow_iff 1 (star Erdos1047P6.anchor)).2 h3K
  have h5K : Erdos1047P6.omega ^ 2 * star Erdos1047P6.anchor ∈ K :=
    (p6_mem_mul_omega_pow_iff 2 (star Erdos1047P6.anchor)).2 h3K
  have hstar2 : star (Erdos1047P6.omega ^ 2 * Erdos1047P6.anchor) =
      Erdos1047P6.omega ^ 1 * star Erdos1047P6.anchor := by
    apply Complex.ext <;>
      norm_num [Erdos1047P6.omega, Erdos1047P6.anchor,
        Complex.mul_re, Complex.mul_im, pow_succ] <;>
      ring_nf <;>
      nlinarith [Erdos1047P6.sqrt_three_sq]
  have hstar1 : star (Erdos1047P6.omega ^ 1 * Erdos1047P6.anchor) =
      Erdos1047P6.omega ^ 2 * star Erdos1047P6.anchor := by
    apply Complex.ext <;>
      norm_num [Erdos1047P6.omega, Erdos1047P6.anchor,
        Complex.mul_re, Complex.mul_im, pow_succ] <;>
      ring_nf <;>
      nlinarith [Erdos1047P6.sqrt_three_sq]
  have h0 : C0 ∈ N := ⟨⟨Erdos1047P6.anchor, h0K, rfl⟩,
    p6_anchor_component_not_convex⟩
  have h1 : C1 ∈ N := ⟨⟨Erdos1047P6.omega ^ 1 * Erdos1047P6.anchor, h1K, rfl⟩,
    p6_mul_omega_pow_component_not_convex 1⟩
  have h2 : C2 ∈ N := ⟨⟨Erdos1047P6.omega ^ 2 * Erdos1047P6.anchor, h2K, rfl⟩,
    p6_mul_omega_pow_component_not_convex 2⟩
  have h3 : C3 ∈ N := ⟨⟨star Erdos1047P6.anchor, h3K, rfl⟩,
    p6_star_component_not_convex⟩
  have h4' : connectedComponentIn K
      (star (Erdos1047P6.omega ^ 2 * Erdos1047P6.anchor)) ∈ N :=
    ⟨⟨star (Erdos1047P6.omega ^ 2 * Erdos1047P6.anchor), by
      rw [hstar2]
      exact h4K, rfl⟩,
      p6_star_mul_omega_pow_component_not_convex 2⟩
  have h4 : C4 ∈ N := by
    change connectedComponentIn K
      (Erdos1047P6.omega ^ 1 * star Erdos1047P6.anchor) ∈ N
    rw [← hstar2]
    exact h4'
  have h5' : connectedComponentIn K
      (star (Erdos1047P6.omega ^ 1 * Erdos1047P6.anchor)) ∈ N :=
    ⟨⟨star (Erdos1047P6.omega ^ 1 * Erdos1047P6.anchor), by
      rw [hstar1]
      exact h5K, rfl⟩,
      p6_star_mul_omega_pow_component_not_convex 1⟩
  have h5 : C5 ∈ N := by
    change connectedComponentIn K
      (Erdos1047P6.omega ^ 2 * star Erdos1047P6.anchor) ∈ N
    rw [← hstar1]
    exact h5'
  obtain ⟨h01, h02, h03, h04', h05', h12, h13, h14, h15,
    h23, h24, h25, h34, h35, h45⟩ := p6_six_components_pairwise_distinct
  change C0 ≠ C1 at h01
  change C0 ≠ C2 at h02
  change C0 ≠ C3 at h03
  change C0 ≠ C4 at h04'
  change C0 ≠ C5 at h05'
  change C1 ≠ C2 at h12
  change C1 ≠ C3 at h13
  change C1 ≠ C4 at h14
  change C1 ≠ C5 at h15
  change C2 ≠ C3 at h23
  change C2 ≠ C4 at h24
  change C2 ≠ C5 at h25
  change C3 ≠ C4 at h34
  change C3 ≠ C5 at h35
  change C4 ≠ C5 at h45
  have hsix : ({C0, C1, C2, C3, C4, C5} : Set (Set ℂ)).ncard = 6 := by
    rw [Set.ncard_insert_of_notMem (by simp [h01, h02, h03, h04', h05'])]
    rw [Set.ncard_insert_of_notMem (by simp [h12, h13, h14, h15])]
    rw [Set.ncard_insert_of_notMem (by simp [h23, h24, h25])]
    rw [Set.ncard_insert_of_notMem (by simp [h34, h35])]
    rw [Set.ncard_insert_of_notMem (by simp [h45])]
    simp
  have hsubset : ({C0, C1, C2, C3, C4, C5} : Set (Set ℂ)) ⊆ N := by
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨h0, h1, h2, h3, h4, h5⟩
  have hNfin : N.Finite := hKfin.subset (by intro t ht; exact ht.1)
  have hlower : 6 ≤ N.ncard := by
    rw [← hsix]
    exact Set.ncard_le_ncard hsubset hNfin
  have hupper : N.ncard ≤ 6 := by
    rw [← hK]
    exact Set.ncard_le_ncard (by intro t ht; exact ht.1) hKfin
  change N.ncard = 6
  exact Nat.le_antisymm hupper hlower

theorem p6_nonconvex_ncard :
    {t ∈ componentsIn (sublevelSet p6Polynomial Erdos1047P6.level) |
      ¬ Convex ℝ t}.ncard = 6 := by
  simpa [p6Polynomial, Erdos1047P6.polynomial] using p6_nonconvex_ncard_core

/-! The saturated p₆ witness also implies non-convexity at every root, not
    merely at the six explicit rational anchors.  This is a useful bridge for
    later root-based providers: regular-value exhaustion puts every rooted
    component into `componentsIn`, and the preceding cardinality lemma then
    forces it into the non-convex subcollection. -/
theorem p6_all_root_components_nonconvex :
    ∀ z ∈ (↑(p6Polynomial.rootSet ℂ) : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet p6Polynomial Erdos1047P6.level) z) := by
  have hfin : (componentsIn
      (sublevelSet p6Polynomial Erdos1047P6.level)).Finite := by
    rw [p6_componentsIn_eq_image_rootSet]
    exact (p6Polynomial.rootSet_finite ℂ).image _
  have hall := all_components_nonconvex_of_ncard_eq hfin
    p6_componentsIn_ncard p6_nonconvex_ncard
  intro z hz
  apply hall (connectedComponentIn
    (sublevelSet p6Polynomial Erdos1047P6.level) z)
  rw [p6_componentsIn_eq_image_rootSet]
  exact ⟨z, hz, rfl⟩


theorem p6_attainable_six : 6 ∈ attainableNonConvexCounts 6 := by
  have hroots : (p6Polynomial.rootSet ℂ).ncard = 6 :=
    p6Polynomial_algebraic_data.2.2.2
  have hcomp :
      (componentsIn (sublevelSet p6Polynomial Erdos1047P6.level)).ncard =
        (p6Polynomial.rootSet ℂ).ncard := by
    rw [p6_componentsIn_ncard, hroots]
  refine ⟨p6Polynomial, Erdos1047P6.level,
    p6Polynomial_algebraic_data.1,
    p6Polynomial_algebraic_data.2.1,
    by norm_num [Erdos1047P6.level], hcomp, ?_⟩
  exact p6_nonconvex_ncard

theorem proposed_answer_attainable_at_six :
    maxNonConvexAnswer 6 ∈ attainableNonConvexCounts 6 := by
  simpa [maxNonConvexAnswer] using p6_attainable_six

theorem max_nonconvex_six : IsGreatest (attainableNonConvexCounts 6) 6 := by
  constructor
  · exact p6_attainable_six
  · intro k hk
    exact attainable_le_proposed_answer_of_four_le (by norm_num) hk


theorem root_component_injOn_of_regular_values_of_ncard_eq
    {f : ℂ[X]} (hf : f.Monic) {c : ℝ} (hc0 : 0 ≤ c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ)
    (hcount : (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard =
      (f.rootSet ℂ).ncard) :
    Set.InjOn (fun r : ℂ ↦ connectedComponentIn
      (Erdos1047.sublevelSet f c) r) (↑(f.rootSet ℂ) : Set ℂ) := by
  apply Set.injOn_of_ncard_image_eq _ (f.rootSet_finite ℂ)
  rw [← componentsIn_eq_image_rootSet_of_regular_values hf hc0 hreg]
  exact hcount

/-! Converse bookkeeping lemma: at a regular level, injectivity of the root
component label map upgrades the covering-map surjection to an exact component
count.  This is useful for explicit degree-raising witnesses, where
injectivity is often proved by coordinate barriers. -/
theorem componentsIn_ncard_eq_rootSet_ncard_of_regular_values_of_root_injOn
    {f : ℂ[X]} (hf : f.Monic) {c : ℝ} (hc0 : 0 ≤ c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ)
    (hinj : Set.InjOn (fun r : ℂ ↦ connectedComponentIn
      (sublevelSet f c) r) (↑(f.rootSet ℂ) : Set ℂ)) :
    (componentsIn (sublevelSet f c)).ncard = (f.rootSet ℂ).ncard := by
  rw [componentsIn_eq_image_rootSet_of_regular_values hf hc0 hreg]
  exact hinj.ncard_image

/-- Path lifting for the polynomial covering shows that every component of a
strict subcritical p5 lemniscate contains a zero. -/
theorem p5_exists_root_in_component {c : ℝ} (hc0 : 0 ≤ c) (hc : c < p5Level)
    (z : ℂ) (hz : z ∈ Erdos1047.sublevelSet p5Polynomial c) :
    ∃ r ∈ p5Polynomial.rootSet ℂ,
      r ∈ connectedComponentIn (Erdos1047.sublevelSet p5Polynomial c) z := by
  let D : Set ℂ := Metric.closedBall 0 c
  letI : ContractibleSpace D := by
    dsimp [D]
    exact Metric.contractibleSpace_closedBall hc0
  letI : LocallyPathConnectedSpace D := by
    dsimp [D]
    exact (convex_closedBall (0 : ℂ) c).locallyPathConnectedSpace
  let a0 : D := ⟨p5Polynomial.eval z, by
    have hz' : ‖p5Polynomial.eval z‖ ≤ c := hz
    simpa [D, Metric.mem_closedBall] using hz'⟩
  let inclusion : C(D, ℂ) := ⟨fun w ↦ w.1, continuous_subtype_val⟩
  have hreg : ∀ w : D,
      inclusion w ∈
        (p5Polynomial.eval '' {u : ℂ | p5Polynomial.derivative.eval u = 0})ᶜ := by
    intro w
    apply p5_closedBall_subset_regular_values hc
    exact w.2
  obtain ⟨F, hF, _⟩ :=
    (Polynomial.isCoveringMapOn_eval p5Polynomial).existsUnique_continuousMap_lifts
      inclusion (a₀ := a0) (e₀ := z) (by rfl) hreg
  have hlift (w : D) : p5Polynomial.eval (F w) = (w : ℂ) := by
    simpa [Function.comp_apply, inclusion] using congrFun hF.2 w
  let w0 : D := ⟨0, by simpa [D, Metric.mem_closedBall] using hc0⟩
  let r : ℂ := F w0
  have hrzero : p5Polynomial.eval r = 0 := by
    simpa [r, w0] using hlift w0
  have hrroot : r ∈ p5Polynomial.rootSet ℂ :=
    p5Polynomial_monic.mem_rootSet.mpr hrzero
  have hpre : IsPreconnected (Set.range F) := isPreconnected_range F.continuous
  have hzrange : z ∈ Set.range F := ⟨a0, hF.1⟩
  have hrrange : r ∈ Set.range F := ⟨w0, rfl⟩
  have hFK : Set.range F ⊆ Erdos1047.sublevelSet p5Polynomial c := by
    rintro _ ⟨w, rfl⟩
    have hw : ‖(w : ℂ)‖ ≤ c := by
      have hw' := w.2
      change (w : ℂ) ∈ Metric.closedBall 0 c at hw'
      rw [Metric.mem_closedBall, dist_zero_right] at hw'
      exact hw'
    change ‖p5Polynomial.eval (F w)‖ ≤ c
    rw [hlift w]
    exact hw
  exact ⟨r, hrroot, hpre.subset_connectedComponentIn hzrange hFK hrrange⟩

/-- A continuous real function cannot change sign within a component without vanishing. -/
theorem negative_on_component {S : Set ℂ} {r : ℂ} {φ : ℂ → ℝ}
    (hφ : Continuous φ) (hzero : ∀ z ∈ S, φ z ≠ 0) (hr : r ∈ S) (hneg : φ r < 0) :
    ∀ z ∈ connectedComponentIn S r, φ z < 0 := by
  intro z hz
  by_contra hnonneg
  obtain ⟨w, hw, hwzero⟩ :=
    isPreconnected_connectedComponentIn.intermediate_value
      (mem_connectedComponentIn hr) hz hφ.continuousOn
      (show (0 : ℝ) ∈ Set.Icc (φ r) (φ z) from ⟨hneg.le, le_of_not_gt hnonneg⟩)
  exact hzero w (connectedComponentIn_subset S r hw) hwzero

/-! A generic sign separator.  This is the reusable form of the p₆ line
barriers: one continuous, nonvanishing real-valued function distinguishes two
component anchors by opposite signs. -/
theorem connectedComponentIn_ne_of_separator_sign
    {S : Set ℂ} {r s : ℂ} {φ : ℂ → ℝ}
    (hφ : Continuous φ) (hzero : ∀ z ∈ S, φ z ≠ 0)
    (hr : r ∈ S) (hs : s ∈ S) (hrpos : 0 < φ r) (hsneg : φ s < 0) :
    connectedComponentIn S r ≠ connectedComponentIn S s := by
  intro heq
  have hsC : s ∈ connectedComponentIn S r := by
    rw [heq]
    exact mem_connectedComponentIn hs
  have hzero' : ∀ z ∈ S, (-φ z) ≠ 0 := by
    intro z hz h
    exact hzero z hz (by linarith)
  have hsign := negative_on_component (S := S) (r := r)
    (φ := fun z => -φ z) (by fun_prop) hzero' hr (by linarith) s hsC
  linarith

/-! A metric construction of the abstract separator above.  If two nonempty
compact sets are disjoint, the difference of their distance functions is a
continuous sign separator.  This is the exact interface needed when the
coordinate barriers used for the explicit p₆ witness are unavailable. -/
theorem metric_separator_of_compact_disjoint
    {A B : Set ℂ} (hA : A.Nonempty) (hB : B.Nonempty)
    (hAcompact : IsCompact A) (hBcompact : IsCompact B)
    (hdisj : Disjoint A B) :
    ∃ φ : ℂ → ℝ, Continuous φ ∧
      (∀ z ∈ A, φ z < 0) ∧ (∀ z ∈ B, 0 < φ z) := by
  let φ : ℂ → ℝ := fun z => Metric.infDist z A - Metric.infDist z B
  refine ⟨φ, ?_, ?_, ?_⟩
  · dsimp [φ]
    fun_prop
  · intro z hz
    have hzB : z ∉ B := by
      intro hzb
      exact Set.disjoint_left.1 hdisj hz hzb
    have hpos : 0 < Metric.infDist z B :=
      (hBcompact.isClosed.notMem_iff_infDist_pos hB).1 hzB
    have hzero : Metric.infDist z A = 0 := Metric.infDist_zero_of_mem hz
    dsimp [φ]
    linarith
  · intro z hz
    have hzA : z ∉ A := by
      intro hza
      exact Set.disjoint_left.1 hdisj hza hz
    have hpos : 0 < Metric.infDist z A :=
      (hAcompact.isClosed.notMem_iff_infDist_pos hA).1 hzA
    have hzero : Metric.infDist z B = 0 := Metric.infDist_zero_of_mem hz
    dsimp [φ]
    linarith

/-! Concrete specialization for old polynomial components.  Once the old
sublevel is compact, disjoint old components admit the metric separator
without any further normality argument. -/
theorem sublevelSet_old_component_metric_separator
    {p : ℂ[X]} (hdeg : 0 < p.degree) (c : ℝ) {r s : ℂ}
    (hr : r ∈ Erdos1047.sublevelSet p c)
    (hs : s ∈ Erdos1047.sublevelSet p c)
    (hdisj : Disjoint
      (connectedComponentIn (Erdos1047.sublevelSet p c) r)
      (connectedComponentIn (Erdos1047.sublevelSet p c) s)) :
    ∃ φ : ℂ → ℝ, Continuous φ ∧
      (∀ z ∈ connectedComponentIn (Erdos1047.sublevelSet p c) r, φ z < 0) ∧
      (∀ z ∈ connectedComponentIn (Erdos1047.sublevelSet p c) s, 0 < φ z) := by
  let A : Set ℂ := connectedComponentIn (Erdos1047.sublevelSet p c) r
  let B : Set ℂ := connectedComponentIn (Erdos1047.sublevelSet p c) s
  have hA : A.Nonempty := ⟨r, by exact mem_connectedComponentIn hr⟩
  have hB : B.Nonempty := ⟨s, by exact mem_connectedComponentIn hs⟩
  have hAcompact : IsCompact A := by
    dsimp [A]
    exact sublevelSet_component_isCompact_of_positive_degree hdeg c r
  have hBcompact : IsCompact B := by
    dsimp [B]
    exact sublevelSet_component_isCompact_of_positive_degree hdeg c s
  obtain ⟨φ, hφ, hneg, hpos⟩ := metric_separator_of_compact_disjoint
    hA hB hAcompact hBcompact (by simpa [A, B] using hdisj)
  exact ⟨φ, hφ, by simpa [A] using hneg, by simpa [B] using hpos⟩

/-! If the ambient set is covered by the two compact pieces, the metric
separator immediately gives component separation for anchors in opposite
pieces.  The hypothesis is deliberately explicit: in the degree-raising
application it is the missing neighbourhood/old-component preservation
estimate, rather than an implicit topological assumption. -/
theorem connectedComponentIn_ne_of_compact_disjoint_sets
    {S A B : Set ℂ} {r s : ℂ}
    (hA : A.Nonempty) (hB : B.Nonempty)
    (hAcompact : IsCompact A) (hBcompact : IsCompact B)
    (hdisj : Disjoint A B) (hcover : S ⊆ A ∪ B)
    (hmem : A ∪ B ⊆ S)
    (hr : r ∈ A) (hs : s ∈ B) :
    connectedComponentIn S r ≠ connectedComponentIn S s := by
  obtain ⟨φ, hφ, hneg, hpos⟩ := metric_separator_of_compact_disjoint
    hA hB hAcompact hBcompact hdisj
  have hzero : ∀ z ∈ S, φ z ≠ 0 := by
    intro z hz hzero
    rcases hcover hz with hzA | hzB
    · exact (ne_of_lt (hneg z hzA)) hzero
    · exact (ne_of_gt (hpos z hzB)) hzero
  have hneq : connectedComponentIn S s ≠ connectedComponentIn S r :=
    connectedComponentIn_ne_of_separator_sign hφ hzero
      (hmem (Or.inr hs)) (hmem (Or.inl hr)) (hpos s hs) (hneg r hr)
  exact hneq.symm

/-! Pairwise version used for finite anchor families.  Supplying one
nonvanishing continuous separator for each pair is enough to obtain the
injectivity hypothesis consumed by the finite-union attainment wrapper. -/
theorem component_map_injOn_of_pairwise_separators
    {S : Set ℂ} {A : Set ℂ}
    (hmem : ∀ z ∈ A, z ∈ S)
    (hsep : ∀ ⦃r s : ℂ⦄, r ∈ A → s ∈ A → r ≠ s →
      ∃ φ : ℂ → ℝ, Continuous φ ∧ (∀ z ∈ S, φ z ≠ 0) ∧
        ((0 < φ r ∧ φ s < 0) ∨ (φ r < 0 ∧ 0 < φ s))) :
    Set.InjOn (fun z : ℂ => connectedComponentIn S z) A := by
  intro r hr s hs heq
  by_contra hrs
  obtain ⟨φ, hφ, hzero, hsign⟩ := hsep hr hs hrs
  rcases hsign with ⟨hrpos, hsneg⟩ | ⟨hrneg, hspos⟩
  · exact (connectedComponentIn_ne_of_separator_sign hφ hzero
      (hmem r hr) (hmem s hs) hrpos hsneg) heq
  · exact (connectedComponentIn_ne_of_separator_sign hφ hzero
      (hmem s hs) (hmem r hr) hspos hrneg) heq.symm

/-! Coordinate half-plane barriers are convenient instances of the generic sign
    separator.  They turn an avoided vertical/horizontal line into a component
    invariant, which is the form needed for the old/new root separation step. -/
theorem connectedComponentIn_re_lt_of_avoids
    {S : Set ℂ} {r : ℂ} (a : ℝ)
    (hzero : ∀ z ∈ S, z.re ≠ a) (hr : r ∈ S) (hrside : r.re < a) :
    ∀ z ∈ connectedComponentIn S r, z.re < a := by
  have hnz : ∀ w ∈ S, (w.re - a) ≠ 0 := by
    intro w hw h
    exact hzero w hw (by linarith)
  intro z hz
  have h := negative_on_component (S := S) (r := r)
    (φ := fun w : ℂ => w.re - a) (by fun_prop) hnz hr (by linarith) z hz
  linarith

theorem connectedComponentIn_re_gt_of_avoids
    {S : Set ℂ} {r : ℂ} (a : ℝ)
    (hzero : ∀ z ∈ S, z.re ≠ a) (hr : r ∈ S) (hrside : a < r.re) :
    ∀ z ∈ connectedComponentIn S r, a < z.re := by
  have hnz : ∀ w ∈ S, (a - w.re) ≠ 0 := by
    intro w hw h
    exact hzero w hw (by linarith)
  intro z hz
  have h := negative_on_component (S := S) (r := r)
    (φ := fun w : ℂ => a - w.re) (by fun_prop) hnz hr (by linarith) z hz
  linarith

/-! Opposite sides of one avoided vertical line cannot belong to the same
connected component.  This is the direct old-root/new-root separation lemma
used by the degree-raising construction. -/
theorem connectedComponentIn_ne_of_vertical_separator
    {S : Set ℂ} {r s : ℂ} {a : ℝ}
    (hzero : ∀ z ∈ S, z.re ≠ a)
    (hr : r ∈ S) (hs : s ∈ S)
    (hrlt : r.re < a) (hslt : a < s.re) :
    connectedComponentIn S r ≠ connectedComponentIn S s := by
  intro heq
  have hsC : s ∈ connectedComponentIn S r := by
    rw [heq]
    exact mem_connectedComponentIn hs
  have hleft := connectedComponentIn_re_lt_of_avoids a hzero hr hrlt s hsC
  linarith

theorem connectedComponentIn_im_lt_of_avoids
    {S : Set ℂ} {r : ℂ} (a : ℝ)
    (hzero : ∀ z ∈ S, z.im ≠ a) (hr : r ∈ S) (hrside : r.im < a) :
    ∀ z ∈ connectedComponentIn S r, z.im < a := by
  have hnz : ∀ w ∈ S, (w.im - a) ≠ 0 := by
    intro w hw h
    exact hzero w hw (by linarith)
  intro z hz
  have h := negative_on_component (S := S) (r := r)
    (φ := fun w : ℂ => w.im - a) (by fun_prop) hnz hr (by linarith) z hz
  linarith

theorem connectedComponentIn_im_gt_of_avoids
    {S : Set ℂ} {r : ℂ} (a : ℝ)
    (hzero : ∀ z ∈ S, z.im ≠ a) (hr : r ∈ S) (hrside : a < r.im) :
    ∀ z ∈ connectedComponentIn S r, a < z.im := by
  have hnz : ∀ w ∈ S, (a - w.im) ≠ 0 := by
    intro w hw h
    exact hzero w hw (by linarith)
  intro z hz
  have h := negative_on_component (S := S) (r := r)
    (φ := fun w : ℂ => a - w.im) (by fun_prop) hnz hr (by linarith) z hz
  linarith

/-! The horizontal analogue is useful when the two new quadratic roots are
separated vertically rather than horizontally. -/
theorem connectedComponentIn_ne_of_horizontal_separator
    {S : Set ℂ} {r s : ℂ} {a : ℝ}
    (hzero : ∀ z ∈ S, z.im ≠ a)
    (hr : r ∈ S) (hs : s ∈ S)
    (hrlt : r.im < a) (hslt : a < s.im) :
    connectedComponentIn S r ≠ connectedComponentIn S s := by
  intro heq
  have hsC : s ∈ connectedComponentIn S r := by
    rw [heq]
    exact mem_connectedComponentIn hs
  have hbelow := connectedComponentIn_im_lt_of_avoids a hzero hr hrlt s hsC
  linarith

/-! A finite collection of points cannot obstruct choosing a vertical line
    strictly between two points with different real parts.  The finite-set
    argument chooses a point between the singleton containing the left
    coordinate and all coordinates strictly to its right; hence the line is
    automatically disjoint from every point in the collection. -/
theorem exists_vertical_separator_avoiding_finite_set
    {F : Set ℂ} (hF : F.Finite) {r s : ℂ}
    (hr : r ∈ F) (hs : s ∈ F) (hrs : r.re < s.re) :
    ∃ a : ℝ, r.re < a ∧ a < s.re ∧ ∀ z ∈ F, z.re ≠ a := by
  let T : Set ℝ := (fun z : ℂ => z.re) '' {z ∈ F | r.re < z.re}
  have hTfin : T.Finite := by
    dsimp [T]
    exact (hF.subset (by
      intro z hz
      exact hz.1)).image Complex.re
  have hsT : s.re ∈ T := by
    refine ⟨s, ?_, rfl⟩
    exact ⟨hs, hrs⟩
  obtain ⟨a, haL, haR⟩ := Set.Finite.exists_between'
    (s := ({r.re} : Set ℝ)) (t := T) (Set.toFinite _) hTfin
      (by
        intro x hx y hy
        simp only [Set.mem_singleton_iff] at hx
        rcases hy with ⟨z, hz, rfl⟩
        simpa [hx] using hz.2)
  refine ⟨a, ?_, ?_, ?_⟩
  · simpa using haL r.re (by simp)
  · exact haR s.re hsT
  · intro z hz hza
    have hzgt : r.re < z.re := by
      by_contra h
      have hzle : z.re ≤ r.re := le_of_not_gt h
      have har : r.re < a := haL r.re (by simp)
      linarith
    have hzT : z.re ∈ T := ⟨z, ⟨hz, hzgt⟩, rfl⟩
    have haz := haR z.re hzT
    linarith

theorem exists_horizontal_separator_avoiding_finite_set
    {F : Set ℂ} (hF : F.Finite) {r s : ℂ}
    (hr : r ∈ F) (hs : s ∈ F) (hrs : r.im < s.im) :
    ∃ a : ℝ, r.im < a ∧ a < s.im ∧ ∀ z ∈ F, z.im ≠ a := by
  let T : Set ℝ := (fun z : ℂ => z.im) '' {z ∈ F | r.im < z.im}
  have hTfin : T.Finite := by
    dsimp [T]
    exact (hF.subset (by
      intro z hz
      exact hz.1)).image Complex.im
  have hsT : s.im ∈ T := by
    refine ⟨s, ?_, rfl⟩
    exact ⟨hs, hrs⟩
  obtain ⟨a, haL, haR⟩ := Set.Finite.exists_between'
    (s := ({r.im} : Set ℝ)) (t := T) (Set.toFinite _) hTfin
      (by
        intro x hx y hy
        simp only [Set.mem_singleton_iff] at hx
        rcases hy with ⟨z, hz, rfl⟩
        simpa [hx] using hz.2)
  refine ⟨a, ?_, ?_, ?_⟩
  · simpa using haL r.im (by simp)
  · exact haR s.im hsT
  · intro z hz hza
    have hzgt : r.im < z.im := by
      by_contra h
      have hzle : z.im ≤ r.im := le_of_not_gt h
      have har : r.im < a := haL r.im (by simp)
      linarith
    have hzT : z.im ∈ T := ⟨z, ⟨hz, hzgt⟩, rfl⟩
    have haz := haR z.im hzT
    linarith

theorem exists_coordinate_separator_avoiding_finite_set
    {F : Set ℂ} (hF : F.Finite) {r s : ℂ}
    (hr : r ∈ F) (hs : s ∈ F) (hrs : r ≠ s) :
    (∃ a : ℝ, (∀ z ∈ F, z.re ≠ a) ∧
      ((r.re < a ∧ a < s.re) ∨ (s.re < a ∧ a < r.re))) ∨
    (∃ a : ℝ, (∀ z ∈ F, z.im ≠ a) ∧
      ((r.im < a ∧ a < s.im) ∨ (s.im < a ∧ a < r.im))) := by
  by_cases hre : r.re = s.re
  · have him : r.im ≠ s.im := by
      intro h
      apply hrs
      apply Complex.ext <;> linarith
    rcases lt_or_gt_of_ne him with h | h
    · rcases exists_horizontal_separator_avoiding_finite_set hF hr hs h with
        ⟨a, h₁, h₂, havoid⟩
      exact Or.inr ⟨a, havoid, Or.inl ⟨h₁, h₂⟩⟩
    · rcases exists_horizontal_separator_avoiding_finite_set hF hs hr h with
        ⟨a, h₁, h₂, havoid⟩
      exact Or.inr ⟨a, havoid, Or.inr ⟨h₁, h₂⟩⟩
  · rcases lt_or_gt_of_ne hre with h | h
    · rcases exists_vertical_separator_avoiding_finite_set hF hr hs h with
        ⟨a, h₁, h₂, havoid⟩
      exact Or.inl ⟨a, havoid, Or.inl ⟨h₁, h₂⟩⟩
    · rcases exists_vertical_separator_avoiding_finite_set hF hs hr h with
        ⟨a, h₁, h₂, havoid⟩
      exact Or.inl ⟨a, havoid, Or.inr ⟨h₁, h₂⟩⟩

/-! Specialization to polynomial roots: the finite-coordinate separator can be
    chosen to miss the entire root multiset, and the corresponding product gap
    is strictly positive. -/
theorem exists_root_coordinate_separator_with_positive_gap
    {f : ℂ[X]} (hf : f.Monic) {r s : ℂ}
    (hr : r ∈ (↑(f.rootSet ℂ) : Set ℂ))
    (hs : s ∈ (↑(f.rootSet ℂ) : Set ℂ)) (hrs : r ≠ s) :
    (∃ a : ℝ,
      (∀ z ∈ f.roots, z.re ≠ a) ∧
      0 < (f.roots.map (fun z => |a - z.re|)).prod ∧
      ((r.re < a ∧ a < s.re) ∨ (s.re < a ∧ a < r.re))) ∨
    (∃ a : ℝ,
      (∀ z ∈ f.roots, z.im ≠ a) ∧
      0 < (f.roots.map (fun z => |a - z.im|)).prod ∧
      ((r.im < a ∧ a < s.im) ∨ (s.im < a ∧ a < r.im))) := by
  rcases exists_coordinate_separator_avoiding_finite_set
      (f.rootSet_finite ℂ) hr hs hrs with hRe | hIm
  · rcases hRe with ⟨a, havoid, horder⟩
    have hroot : ∀ z ∈ f.roots, z.re ≠ a := by
      intro z hz
      apply havoid z
      rw [Polynomial.rootSet_def]
      apply Multiset.mem_toFinset.mpr
      simpa [Polynomial.aroots] using hz
    exact Or.inl ⟨a, hroot,
      Erdos1047DegreeRaise.monic_root_distance_prod_pos_of_line_avoids_roots f a hroot,
      horder⟩
  · rcases hIm with ⟨a, havoid, horder⟩
    have hroot : ∀ z ∈ f.roots, z.im ≠ a := by
      intro z hz
      apply havoid z
      rw [Polynomial.rootSet_def]
      apply Multiset.mem_toFinset.mpr
      simpa [Polynomial.aroots] using hz
    exact Or.inr ⟨a, hroot,
      Erdos1047DegreeRaise.monic_root_im_distance_prod_pos_of_line_avoids_roots
        f a hroot, horder⟩

/-! A finite positive family has a common positive lower level.  Applied to
    the finitely many pairwise root-coordinate gaps, this supplies a single
    `c` below every selected separator gap; no compactness or choice of a
    limiting level is needed. -/
theorem exists_pos_lt_all_of_finset
    {α : Type*} (s : Finset α) (g : α → ℝ)
    (hg : ∀ i ∈ s, 0 < g i) :
    ∃ c : ℝ, 0 < c ∧ ∀ i ∈ s, c < g i := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      refine ⟨1, by norm_num, ?_⟩
      simp
  | @insert a s ha ih =>
      have hga : 0 < g a := hg a (by simp)
      have hgs : ∀ i ∈ s, 0 < g i := by
        intro i hi
        exact hg i (by simp [hi])
      rcases ih hgs with ⟨c, hc, hcs⟩
      refine ⟨min c (g a) / 2, ?_, ?_⟩
      · have hmin : 0 < min c (g a) := lt_min hc hga
        linarith
      · intro i hi
        simp only [Finset.mem_insert] at hi
        rcases hi with hia | hi
        · subst i
          have hle : min c (g a) ≤ g a := min_le_right _ _
          linarith
        · have hle : min c (g a) ≤ c := min_le_left _ _
          linarith [hcs i hi]

/-! For every monic polynomial there is a single positive level below all the
    finitely many root-coordinate gaps.  At that level every distinct pair of
    roots is separated by a vertical or horizontal line whose entire line is
    avoided by the sublevel set. -/
theorem exists_root_coordinate_separator_level
    (f : ℂ[X]) (hf : f.Monic) :
    ∃ c : ℝ, 0 < c ∧
      ∀ ⦃r s : ℂ⦄,
        r ∈ (↑(f.rootSet ℂ) : Set ℂ) →
        s ∈ (↑(f.rootSet ℂ) : Set ℂ) →
        r ≠ s →
        (∃ a : ℝ,
          (∀ z ∈ f.roots, z.re ≠ a) ∧
          c < (f.roots.map (fun z => |a - z.re|)).prod ∧
          ((r.re < a ∧ a < s.re) ∨ (s.re < a ∧ a < r.re))) ∨
        (∃ a : ℝ,
          (∀ z ∈ f.roots, z.im ≠ a) ∧
          c < (f.roots.map (fun z => |a - z.im|)).prod ∧
          ((r.im < a ∧ a < s.im) ∨ (s.im < a ∧ a < r.im))) := by
  classical
  let F : Finset ℂ := (f.rootSet_finite ℂ).toFinset
  let P : Finset (ℂ × ℂ) := F.product F |>.filter (fun rs => rs.1 ≠ rs.2)
  have hex : ∀ (rs : ℂ × ℂ), rs ∈ P →
      ∃ δ : ℝ, 0 < δ ∧
        ((∃ a : ℝ,
          (∀ z ∈ f.roots, z.re ≠ a) ∧
          δ < (f.roots.map (fun z => |a - z.re|)).prod ∧
          ((rs.1.re < a ∧ a < rs.2.re) ∨ (rs.2.re < a ∧ a < rs.1.re))) ∨
        (∃ a : ℝ,
          (∀ z ∈ f.roots, z.im ≠ a) ∧
          δ < (f.roots.map (fun z => |a - z.im|)).prod ∧
          ((rs.1.im < a ∧ a < rs.2.im) ∨ (rs.2.im < a ∧ a < rs.1.im)))) := by
    intro rs hrs
    have hrs' : rs ∈ F.product F ∧ rs.1 ≠ rs.2 := by
      simpa [P] using hrs
    have hr : rs.1 ∈ (↑(f.rootSet ℂ) : Set ℂ) := by
      have : rs.1 ∈ F := (Finset.mem_product.mp hrs'.1).1
      simpa [F] using this
    have hs : rs.2 ∈ (↑(f.rootSet ℂ) : Set ℂ) := by
      have : rs.2 ∈ F := (Finset.mem_product.mp hrs'.1).2
      simpa [F] using this
    have hne : rs.1 ≠ rs.2 := hrs'.2
    rcases exists_root_coordinate_separator_with_positive_gap hf hr hs hne with hRe | hIm
    · rcases hRe with ⟨a, hroot, hpos, horder⟩
      refine ⟨(f.roots.map (fun z => |a - z.re|)).prod / 2, by linarith,
        Or.inl ⟨a, hroot, ?_, horder⟩⟩
      linarith
    · rcases hIm with ⟨a, hroot, hpos, horder⟩
      refine ⟨(f.roots.map (fun z => |a - z.im|)).prod / 2, by linarith,
        Or.inr ⟨a, hroot, ?_, horder⟩⟩
      linarith
  let δ : ℂ × ℂ → ℝ := fun rs =>
    if h : rs ∈ P then Classical.choose (hex rs h) else 1
  have hδ : ∀ rs ∈ P, 0 < δ rs := by
    intro rs hrs
    dsimp [δ]
    rw [dif_pos hrs]
    exact (Classical.choose_spec (hex rs hrs)).1
  obtain ⟨c, hc, hcδ⟩ := exists_pos_lt_all_of_finset P δ hδ
  refine ⟨c, hc, ?_⟩
  intro r s hr hs hrs
  have hrF : r ∈ F := by simpa [F] using hr
  have hsF : s ∈ F := by simpa [F] using hs
  have hP : (r, s) ∈ P := by
    simp [P, hrF, hsF, hrs]
  have hcd : c < δ (r, s) := hcδ (r, s) hP
  have hspec := Classical.choose_spec (hex (r, s) hP)
  have hδeq : δ (r, s) = Classical.choose (hex (r, s) hP) := by
    simp [δ, hP]
  rw [hδeq] at hcd
  rcases hspec.2 with hRe | hIm
  · rcases hRe with ⟨a, hroot, hgap, horder⟩
    exact Or.inl ⟨a, hroot, lt_trans hcd hgap, horder⟩
  · rcases hIm with ⟨a, hroot, hgap, horder⟩
    exact Or.inr ⟨a, hroot, lt_trans hcd hgap, horder⟩

/-! A finite-family specialization: if every distinct anchor pair is cut by
    an avoided vertical or horizontal line, the component map is injective on
    the anchor set.  This is the coordinate form used by the degree-raising
    bookkeeping theorem. -/
theorem component_map_injOn_of_coordinate_line_separators
    {S : Set ℂ} {A : Set ℂ}
    (hmem : ∀ z ∈ A, z ∈ S)
    (hsep : ∀ ⦃r s : ℂ⦄, r ∈ A → s ∈ A → r ≠ s →
      (∃ a : ℝ, (∀ z ∈ S, z.re ≠ a) ∧
        ((r.re < a ∧ a < s.re) ∨ (s.re < a ∧ a < r.re))) ∨
      (∃ a : ℝ, (∀ z ∈ S, z.im ≠ a) ∧
        ((r.im < a ∧ a < s.im) ∨ (s.im < a ∧ a < r.im)))) :
    Set.InjOn (fun z : ℂ => connectedComponentIn S z) A := by
  apply component_map_injOn_of_pairwise_separators hmem
  intro r s hr hs hrs
  rcases hsep hr hs hrs with hRe | hIm
  · rcases hRe with ⟨a, hzero, horder | horder⟩
    · refine ⟨fun z : ℂ => z.re - a, by fun_prop, ?_, Or.inr ?_⟩
      · intro z hz h
        exact hzero z hz (by linarith)
      · exact ⟨by linarith, by linarith⟩
    · refine ⟨fun z : ℂ => z.re - a, by fun_prop, ?_, Or.inl ?_⟩
      · intro z hz h
        exact hzero z hz (by linarith)
      · exact ⟨by linarith, by linarith⟩
  · rcases hIm with ⟨a, hzero, horder | horder⟩
    · refine ⟨fun z : ℂ => z.im - a, by fun_prop, ?_, Or.inr ?_⟩
      · intro z hz h
        exact hzero z hz (by linarith)
      · exact ⟨by linarith, by linarith⟩
    · refine ⟨fun z : ℂ => z.im - a, by fun_prop, ?_, Or.inl ?_⟩
      · intro z hz h
        exact hzero z hz (by linarith)
      · exact ⟨by linarith, by linarith⟩


/-! Degree-raising exact-count bridge. -/
theorem degree_raise_componentsIn_ncard_eq_natDegree_of_coordinate_separators
    {p : ℂ[X]} {n : ℕ} {L e : ℂ} {c : ℝ}
    (hp : p.Monic) (hpsep : p.Separable) (hdeg : p.natDegree = n)
    (he : e ≠ 0)
    (hcop : IsCoprime p (Erdos1047DegreeRaise.raiseFactor L (e ^ 2)))
    (hc : 0 < c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      ((Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval ''
        {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).derivative.eval u = 0})ᶜ)
    (hsep : ∀ ⦃r s : ℂ⦄,
      r ∈ (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) →
      s ∈ (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) →
      r ≠ s →
      (∃ a : ℝ, (∀ z ∈ sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c, z.re ≠ a) ∧
        ((r.re < a ∧ a < s.re) ∨ (s.re < a ∧ a < r.re))) ∨
      (∃ a : ℝ, (∀ z ∈ sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c, z.im ≠ a) ∧
        ((r.im < a ∧ a < s.im) ∨ (s.im < a ∧ a < r.im)))) :
    (componentsIn (sublevelSet
      (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c)).ncard = n + 2 := by
  let q : ℂ[X] := Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)
  have hqmonic : q.Monic := by
    dsimp [q]
    exact Erdos1047DegreeRaise.raisePolynomial_monic p L (e ^ 2) hp
  have hqsep : q.Separable := by
    dsimp [q]
    exact Erdos1047DegreeRaise.raisePolynomial_separable p L (e ^ 2) hpsep
      (pow_ne_zero 2 he) hcop
  have hqdeg : q.natDegree = n + 2 := by
    dsimp [q]
    rw [Erdos1047DegreeRaise.raisePolynomial_natDegree p L (e ^ 2) hp, hdeg]
  have hqrootset : q.rootSet ℂ =
      p.rootSet ℂ ∪ ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) := by
    dsimp [q]
    exact Erdos1047DegreeRaise.raisePolynomial_rootSet_eq_union p L e hp he
  have hinj : Set.InjOn (fun z : ℂ => connectedComponentIn
      (sublevelSet q c) z) (↑(q.rootSet ℂ) : Set ℂ) := by
    rw [hqrootset]
    apply component_map_injOn_of_coordinate_line_separators
    · intro z hz
      change ‖q.eval z‖ ≤ c
      have hc0 : 0 ≤ c := le_of_lt hc
      rcases hz with hzold | hznew
      · have hroot := Erdos1047DegreeRaise.raisePolynomial_root_of_original_root
          p L e z hp hzold
        rw [hroot, norm_zero]
        exact hc0
      · have hz' : z = L + e * Complex.I ∨ z = L - e * Complex.I := by
          simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hznew
        rcases hz' with rfl | rfl
        · have hfactor := Erdos1047DegreeRaise.raiseFactor_eval_center_add_mul_I L e
          have hroot := Erdos1047DegreeRaise.raisePolynomial_root_of_factor_root
            p L (e ^ 2) (L + e * Complex.I) hfactor
          rw [hroot, norm_zero]
          exact hc0
        · have hfactor := Erdos1047DegreeRaise.raiseFactor_eval_center_sub_mul_I L e
          have hroot := Erdos1047DegreeRaise.raisePolynomial_root_of_factor_root
            p L (e ^ 2) (L - e * Complex.I) hfactor
          rw [hroot, norm_zero]
          exact hc0
    · exact hsep
  have hcount : (componentsIn (sublevelSet q c)).ncard =
      (q.rootSet ℂ).ncard :=
    componentsIn_ncard_eq_rootSet_ncard_of_regular_values_of_root_injOn
      hqmonic (le_of_lt hc) (by simpa [q] using hreg) hinj
  have hroot : (q.rootSet ℂ).ncard = q.natDegree := by
    have hcard : Fintype.card (q.rootSet ℂ) = q.natDegree :=
      Polynomial.card_rootSet_eq_natDegree hqsep (IsAlgClosed.splits _)
    simpa using hcard
  change (componentsIn (sublevelSet q c)).ncard = n + 2
  calc
    (componentsIn (sublevelSet q c)).ncard = (q.rootSet ℂ).ncard := hcount
    _ = q.natDegree := hroot
    _ = n + 2 := hqdeg

/-! Analytic-to-topological bridge for coordinate barriers: a strict uniform
lower bound for the polynomial on a vertical or horizontal line implies that
the corresponding sublevel set avoids that line. -/
theorem sublevelSet_avoids_re_line_of_eval_norm_gt
    {f : ℂ[X]} {c a : ℝ}
    (hbound : ∀ y : ℝ, c < ‖f.eval ((a : ℂ) + (y : ℂ) * Complex.I)‖) :
    ∀ z ∈ sublevelSet f c, z.re ≠ a := by
  intro z hz hline
  change ‖f.eval z‖ ≤ c at hz
  have hrepr : z = (a : ℂ) + (z.im : ℂ) * Complex.I := by
    apply Complex.ext <;> simp [hline]
  rw [hrepr] at hz
  exact (not_lt_of_ge hz) (hbound _)

theorem sublevelSet_avoids_im_line_of_eval_norm_gt
    {f : ℂ[X]} {c a : ℝ}
    (hbound : ∀ x : ℝ, c < ‖f.eval ((x : ℂ) + (a : ℂ) * Complex.I)‖) :
    ∀ z ∈ sublevelSet f c, z.im ≠ a := by
  intro z hz hline
  change ‖f.eval z‖ ≤ c at hz
  have hrepr : z = (z.re : ℂ) + (a : ℂ) * Complex.I := by
    apply Complex.ext <;> simp [hline]
  rw [hrepr] at hz
  exact (not_lt_of_ge hz) (hbound _)

/-! Root-coordinate versions of the preceding analytic wrappers.  The product
    lower bound from `Erdos1047DegreeRaiseCore` supplies the uniform estimate,
    so callers only need to prove that the selected line misses every root. -/
theorem sublevelSet_avoids_re_line_of_root_distance
    {f : ℂ[X]} (hf : f.Monic) {c a : ℝ}
    (hroot : ∀ r ∈ f.roots, r.re ≠ a)
    (hc : c < (f.roots.map (fun r => |a - r.re|)).prod) :
    ∀ z ∈ sublevelSet f c, z.re ≠ a := by
  apply sublevelSet_avoids_re_line_of_eval_norm_gt
  exact Erdos1047DegreeRaise.monic_eval_norm_gt_of_root_distance
    f hf a c hroot hc

theorem sublevelSet_avoids_im_line_of_root_distance
    {f : ℂ[X]} (hf : f.Monic) {c a : ℝ}
    (hroot : ∀ r ∈ f.roots, r.im ≠ a)
    (hc : c < (f.roots.map (fun r => |a - r.im|)).prod) :
    ∀ z ∈ sublevelSet f c, z.im ≠ a := by
  apply sublevelSet_avoids_im_line_of_eval_norm_gt
  exact Erdos1047DegreeRaise.monic_eval_norm_gt_of_root_im_distance
    f hf a c hroot hc

/-! The root-distance estimates can be consumed directly by the component
    injectivity theorem.  This is the lightweight degree-raising interface:
    an analytic proof is reduced to choosing, for each anchor pair, a line
    between their coordinates that misses all roots and whose explicit product
    gap is larger than the chosen level. -/
theorem component_map_injOn_of_root_distance_gaps
    {f : ℂ[X]} (hf : f.Monic) {c : ℝ} {A : Set ℂ}
    (hmem : ∀ z ∈ A, z ∈ sublevelSet f c)
    (hsep : ∀ ⦃r s : ℂ⦄, r ∈ A → s ∈ A → r ≠ s →
      (∃ a : ℝ,
        (∀ z ∈ f.roots, z.re ≠ a) ∧
        c < (f.roots.map (fun z => |a - z.re|)).prod ∧
        ((r.re < a ∧ a < s.re) ∨ (s.re < a ∧ a < r.re))) ∨
      (∃ a : ℝ,
        (∀ z ∈ f.roots, z.im ≠ a) ∧
        c < (f.roots.map (fun z => |a - z.im|)).prod ∧
        ((r.im < a ∧ a < s.im) ∨ (s.im < a ∧ a < r.im)))) :
    Set.InjOn (fun z : ℂ => connectedComponentIn (sublevelSet f c) z) A := by
  apply component_map_injOn_of_coordinate_line_separators hmem
  intro r s hr hs hrs
  rcases hsep hr hs hrs with hRe | hIm
  · rcases hRe with ⟨a, hroot, hgap, horder⟩
    exact Or.inl ⟨a, sublevelSet_avoids_re_line_of_root_distance hf hroot hgap,
      horder⟩
  · rcases hIm with ⟨a, hroot, hgap, horder⟩
    exact Or.inr ⟨a, sublevelSet_avoids_im_line_of_root_distance hf hroot hgap,
      horder⟩

theorem exists_root_component_injOn_at_positive_level
    (f : ℂ[X]) (hf : f.Monic) :
    ∃ c : ℝ, 0 < c ∧
      Set.InjOn (fun z : ℂ => connectedComponentIn (sublevelSet f c) z)
        (↑(f.rootSet ℂ) : Set ℂ) := by
  obtain ⟨c, hc, hsep⟩ := exists_root_coordinate_separator_level f hf
  refine ⟨c, hc, ?_⟩
  apply component_map_injOn_of_root_distance_gaps hf
  · intro z hz
    change ‖f.eval z‖ ≤ c
    have hroot : f.eval z = 0 := by
      simpa [aeval_def] using hf.mem_rootSet.mp hz
    rw [hroot, norm_zero]
    exact le_of_lt hc
  · exact hsep

/-! The even-family barrier from the algebraic core becomes a concrete line
avoidance statement for every level strictly below `1`. -/
theorem evenFamily_real_line_direction_avoids_sublevel
    {m : ℕ} {u : ℂ} {c : ℝ} (hu : (u ^ m).im = 0) (hc : c < 1) :
    ∀ t : ℝ,
      (t : ℂ) * u ∉ sublevelSet
        (Erdos1047EvenFamily.evenFamilyPolynomial m) c := by
  intro t ht
  have hnorm :=
    Erdos1047EvenFamily.evenFamily_norm_ge_one_of_real_line_direction hu t
  have hsub :
      ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval ((t : ℂ) * u)‖ ≤ c := ht
  linarith

/-! In particular, every line in an `m`-fold root-of-unity direction is
excluded below level `1`; these are the canonical angular-sector barriers. -/
theorem evenFamily_root_unity_line_avoids_sublevel
    {m : ℕ} {u : ℂ} {c : ℝ} (hu : u ^ m = 1) (hc : c < 1) :
    ∀ t : ℝ,
      (t : ℂ) * u ∉ sublevelSet
        (Erdos1047EvenFamily.evenFamilyPolynomial m) c := by
  apply evenFamily_real_line_direction_avoids_sublevel
  · rw [hu]
    norm_num
  · exact hc

/-! A zero of the continuous angular functional
`z ↦ Im (z * conj u)` lies on the real line through `u`.  This elementary
coordinate fact lets the real-line barrier produce a genuine separator. -/
theorem complex_mem_real_line_of_mul_star_im_zero
    {u z : ℂ} (hu : u ≠ 0) (hz : (z * star u).im = 0) :
    ∃ t : ℝ, z = (t : ℂ) * u := by
  have hreal : z * star u = ((z * star u).re : ℂ) := by
    apply Complex.ext
    · simp
    · exact hz
  have hnormpos : 0 < Complex.normSq u := Complex.normSq_pos.mpr hu
  have hnorm : Complex.normSq u ≠ 0 := ne_of_gt hnormpos
  have hnormc : (Complex.normSq u : ℂ) = star u * u :=
    Complex.normSq_eq_conj_mul_self
  have hscaled : z * (Complex.normSq u : ℂ) =
      ((z * star u).re : ℂ) * u := by
    calc
      z * (Complex.normSq u : ℂ) = z * (star u * u) := by rw [hnormc]
      _ = (z * star u) * u := by ring
      _ = ((z * star u).re : ℂ) * u :=
        congrArg (fun w : ℂ => w * u) hreal
  refine ⟨(z * star u).re / Complex.normSq u, ?_⟩
  calc
    z = z * (Complex.normSq u : ℂ) / (Complex.normSq u : ℂ) := by
      field_simp [hnorm]
    _ = (((z * star u).re : ℂ) * u) / (Complex.normSq u : ℂ) := by
      rw [hscaled]
    _ = ((z * star u).re / Complex.normSq u : ℝ) * u := by
      norm_num
      ring

/-! The angular separator is now available for every direction whose `m`-th
power is real and which is nonzero. -/
theorem evenFamily_angular_barrier_avoids_sublevel
    {m : ℕ} {u : ℂ} {c : ℝ} (hu0 : u ≠ 0)
    (hum : (u ^ m).im = 0) (hc : c < 1) :
    ∀ z ∈ sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c,
      (z * star u).im ≠ 0 := by
  intro z hz hzero
  obtain ⟨t, rfl⟩ := complex_mem_real_line_of_mul_star_im_zero hu0 hzero
  exact (evenFamily_real_line_direction_avoids_sublevel hum hc t) hz

/-! The preceding line barrier has a canonical angular form for every
`m`-th root of unity.  The positivity hypothesis is essential here: it lets
us recover `u ≠ 0` from `u ^ m = 1`, so the angular functional really defines
a line separator rather than the degenerate zero functional. -/
theorem evenFamily_root_unity_angular_barrier_avoids_sublevel
    {m : ℕ} (hm : 0 < m) {u : ℂ} {c : ℝ} (hu : u ^ m = 1) (hc : c < 1) :
    ∀ z ∈ sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c,
      (z * star u).im ≠ 0 := by
  have hu0 : u ≠ 0 := by
    intro hzero
    subst u
    simp [zero_pow (by omega : m ≠ 0)] at hu
  apply evenFamily_angular_barrier_avoids_sublevel hu0
  · rw [hu]
    norm_num
  · exact hc

/-! The complementary family of canonical directions has `u^m = -1`.
Together with the preceding theorem these are the `2*m` equally spaced line
directions used by the intended root-angle table. -/
theorem evenFamily_neg_root_unity_angular_barrier_avoids_sublevel
    {m : ℕ} (hm : 0 < m) {u : ℂ} {c : ℝ} (hu : u ^ m = -1) (hc : c < 1) :
    ∀ z ∈ sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c,
      (z * star u).im ≠ 0 := by
  have hu0 : u ≠ 0 := by
    intro hzero
    subst u
    simp [zero_pow (by omega : m ≠ 0)] at hu
  apply evenFamily_angular_barrier_avoids_sublevel hu0
  · rw [hu]
    norm_num
  · exact hc

/-! A single interface for the two canonical real values of `u^m`. -/
theorem evenFamily_canonical_angular_barrier_avoids_sublevel
    {m : ℕ} (hm : 0 < m) {u : ℂ} {c : ℝ}
    (hu : u ^ m = 1 ∨ u ^ m = -1) (hc : c < 1) :
    ∀ z ∈ sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c,
      (z * star u).im ≠ 0 := by
  rcases hu with hu | hu
  · exact evenFamily_root_unity_angular_barrier_avoids_sublevel hm hu hc
  · exact evenFamily_neg_root_unity_angular_barrier_avoids_sublevel hm hu hc

/-! Pairwise angular sign data is sufficient for component injectivity.  This
is the reusable topological interface for proving the `2*m` component count
of the even family without committing to a particular coordinate picture. -/
theorem evenFamily_component_map_injOn_of_angular_separators
    {m : ℕ} {c : ℝ} {A : Set ℂ} (hc : c < 1)
    (hmem : ∀ z ∈ A,
      z ∈ sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
    (hsep : ∀ ⦃r s : ℂ⦄, r ∈ A → s ∈ A → r ≠ s →
      ∃ u : ℂ, u ≠ 0 ∧ (u ^ m).im = 0 ∧
        ((0 < (r * star u).im ∧ (s * star u).im < 0) ∨
          ((r * star u).im < 0 ∧ 0 < (s * star u).im))) :
    Set.InjOn (fun z : ℂ => connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) z) A := by
  apply component_map_injOn_of_pairwise_separators hmem
  intro r s hr hs hrs
  obtain ⟨u, hu0, hum, hsign⟩ := hsep hr hs hrs
  refine ⟨fun z : ℂ => (z * star u).im, by fun_prop, ?_, hsign⟩
  exact evenFamily_angular_barrier_avoids_sublevel hu0 hum hc

/-! Combining the angular separator with the regular-value exhaustion gives
the exact `2*m` component count. -/
theorem evenFamily_componentsIn_ncard_eq_two_mul_of_angular_separators
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc0 : 0 ≤ c) (hc1 : c < 1)
    (hsep : ∀ ⦃r s : ℂ⦄,
      r ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ) →
      s ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ) →
      r ≠ s →
      ∃ u : ℂ, u ≠ 0 ∧ (u ^ m).im = 0 ∧
        ((0 < (r * star u).im ∧ (s * star u).im < 0) ∨
          ((r * star u).im < 0 ∧ 0 < (s * star u).im))) :
    (componentsIn (sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c)).ncard = 2 * m := by
  apply evenFamily_componentsIn_ncard_eq_two_mul_of_root_injOn hm hc0 hc1
  apply evenFamily_component_map_injOn_of_angular_separators hc1
  · intro z hz
    change ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ ≤ c
    have hroot :
        (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z = 0 := by
      simpa [aeval_def] using
        (Erdos1047EvenFamily.evenFamily_monic m hm).mem_rootSet.mp hz
    rw [hroot, norm_zero]
    exact hc0
  · exact hsep

/-! Finite-table form of the preceding theorem.  In the intended root-angle
proof, the directions are indexed by `Fin (2*m)` and each has `m`-th power
`±1`; the only remaining input is the finite sign-table check for each root
pair. -/
theorem evenFamily_componentsIn_ncard_eq_two_mul_of_canonical_direction_table
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc0 : 0 ≤ c) (hc1 : c < 1)
    (u : Fin (2 * m) → ℂ)
    (hu : ∀ j, u j ≠ 0 ∧ (u j ^ m = 1 ∨ u j ^ m = -1))
    (hsign : ∀ ⦃r s : ℂ⦄,
      r ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ) →
      s ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ) →
      r ≠ s →
      ∃ j : Fin (2 * m),
        ((0 < (r * star (u j)).im ∧ (s * star (u j)).im < 0) ∨
          ((r * star (u j)).im < 0 ∧ 0 < (s * star (u j)).im))) :
    (componentsIn (sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c)).ncard = 2 * m := by
  apply evenFamily_componentsIn_ncard_eq_two_mul_of_angular_separators hm hc0 hc1
  intro r s hr hs hrs
  obtain ⟨j, hj⟩ := hsign hr hs hrs
  refine ⟨u j, (hu j).1, ?_, hj⟩
  rcases (hu j).2 with hplus | hminus
  · rw [hplus]
    norm_num
  · rw [hminus]
    norm_num

/-! A direct attainment wrapper for the even family.  Once the finite angular
    sign table has been checked and every anchored root component is certified
    non-convex, the regular-value bookkeeping is completely automatic. -/
theorem evenFamily_attainable_of_root_inj_and_nonconvex
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : 0 < c) (hc1 : c < 1)
    (hinj : Set.InjOn (fun z : ℂ => connectedComponentIn
      (Erdos1047.sublevelSet
        (Erdos1047EvenFamily.evenFamilyPolynomial m) c) z)
      (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ))
    (hnc : ∀ z ∈
      (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (Erdos1047.sublevelSet
          (Erdos1047EvenFamily.evenFamilyPolynomial m) c) z)) :
    2 * m ∈ attainableNonConvexCounts (2 * m) := by
  let f : ℂ[X] := Erdos1047EvenFamily.evenFamilyPolynomial m
  have hfm : f.Monic := by
    dsimp [f]
    exact Erdos1047EvenFamily.evenFamily_monic m hm
  have hfsep : f.Separable := by
    dsimp [f]
    exact Erdos1047EvenFamily.evenFamily_separable m hm
  have hfdeg : f.natDegree = 2 * m := by
    dsimp [f]
    exact Erdos1047EvenFamily.evenFamily_natDegree m hm
  have hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ := by
    dsimp [f]
    exact evenFamily_closedBall_subset_regular_values_of_lt_one hm hc1
  have hcomp : (componentsIn (sublevelSet f c)).ncard = 2 * m := by
    apply evenFamily_componentsIn_ncard_eq_two_mul_of_root_injOn hm
      (le_of_lt hc) hc1
    simpa [f] using hinj
  apply attainable_of_finite_nonconvex_witnesses_of_separable
    hfm hfsep hfdeg (by omega) hc hcomp
  · exact f.rootSet_finite ℂ
  · dsimp [f]
    exact Erdos1047EvenFamily.evenFamily_rootSet_ncard m hm
  · intro z hz
    change ‖f.eval z‖ ≤ c
    have hzroot : f.eval z = 0 := hfm.mem_rootSet.mp hz
    rw [hzroot, norm_zero]
    exact le_of_lt hc
  · simpa [f] using hinj
  · simpa [f] using hnc

/-! The finite direction-table form also closes the attainability statement:
    the table supplies the component injection, while the non-convexity field
    is the sole geometric input left for each root. -/
theorem evenFamily_attainable_of_canonical_direction_table
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : 0 < c) (hc1 : c < 1)
    (u : Fin (2 * m) → ℂ)
    (hu : ∀ j, u j ≠ 0 ∧ (u j ^ m = 1 ∨ u j ^ m = -1))
    (hsign : ∀ ⦃r s : ℂ⦄,
      r ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ) →
      s ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ) →
      r ≠ s →
      ∃ j : Fin (2 * m),
        ((0 < (r * star (u j)).im ∧ (s * star (u j)).im < 0) ∨
          ((r * star (u j)).im < 0 ∧ 0 < (s * star (u j)).im)))
    (hnc : ∀ z ∈
      (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (Erdos1047.sublevelSet
          (Erdos1047EvenFamily.evenFamilyPolynomial m) c) z)) :
    2 * m ∈ attainableNonConvexCounts (2 * m) := by
  apply evenFamily_attainable_of_root_inj_and_nonconvex hm hc hc1
  · apply evenFamily_component_map_injOn_of_angular_separators hc1
    · intro z hz
      change ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ ≤ c
      have hroot :
          (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z = 0 := by
        simpa [aeval_def] using
          (Erdos1047EvenFamily.evenFamily_monic m hm).mem_rootSet.mp hz
      rw [hroot, norm_zero]
      exact le_of_lt hc
    · intro r s hr hs hrs
      obtain ⟨j, hj⟩ := hsign hr hs hrs
      refine ⟨u j, (hu j).1, ?_, hj⟩
      rcases (hu j).2 with hplus | hminus
      · rw [hplus]
        norm_num
      · rw [hminus]
        norm_num
  · exact hnc

/-! The representative-certificate interface packages the orbit reduction with
    the finite angular table.  Thus the remaining even-family construction can
    be supplied by one root on the `1+i` branch, one robust certificate there,
    and the finite sign check; no duplicated certificate for the other `2*m-1`
    roots is required. -/
theorem evenFamily_attainable_of_single_certificate_and_direction_table
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : 0 < c) (hc1 : c < 1)
    {r a b : ℂ}
    (hr : r ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ))
    (hrplus : r ^ m = 1 + Complex.I)
    (hcert : Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
      c r a b))
    (u : Fin (2 * m) → ℂ)
    (hu : ∀ j, u j ≠ 0 ∧ (u j ^ m = 1 ∨ u j ^ m = -1))
    (hsign : ∀ ⦃r s : ℂ⦄,
      r ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ) →
      s ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ) →
      r ≠ s →
      ∃ j : Fin (2 * m),
        ((0 < (r * star (u j)).im ∧ (s * star (u j)).im < 0) ∨
          ((r * star (u j)).im < 0 ∧ 0 < (s * star (u j)).im))) :
    2 * m ∈ attainableNonConvexCounts (2 * m) := by
  apply evenFamily_attainable_of_canonical_direction_table hm hc hc1 u hu hsign
  exact evenFamily_root_nonconvex_of_single_certificate hm hr hrplus hcert

/-! A count-only variant is useful when non-convexity has already been proved
    by a finite witness calculation: the regular-value upper bound supplies the
    missing component equality automatically. -/
theorem evenFamily_attainable_of_nonconvex_count
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : 0 < c) (hc1 : c < 1)
    (hnc : {t ∈ componentsIn (sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c) |
      ¬ Convex ℝ t}.ncard = 2 * m) :
    2 * m ∈ attainableNonConvexCounts (2 * m) := by
  let f : ℂ[X] := Erdos1047EvenFamily.evenFamilyPolynomial m
  have hfm : f.Monic := by
    dsimp [f]
    exact Erdos1047EvenFamily.evenFamily_monic m hm
  have hfsep : f.Separable := by
    dsimp [f]
    exact Erdos1047EvenFamily.evenFamily_separable m hm
  have hfdeg : f.natDegree = 2 * m := by
    dsimp [f]
    exact Erdos1047EvenFamily.evenFamily_natDegree m hm
  have hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ := by
    dsimp [f]
    exact evenFamily_closedBall_subset_regular_values_of_lt_one hm hc1
  have hupper : (componentsIn (sublevelSet f c)).ncard ≤ 2 * m := by
    apply evenFamily_componentsIn_ncard_le hm (le_of_lt hc) hc1
  have hcompfin : (componentsIn (sublevelSet f c)).Finite := by
    rw [componentsIn_eq_image_rootSet_of_regular_values hfm (le_of_lt hc) hreg]
    exact (f.rootSet_finite ℂ).image _
  have hcomp : (componentsIn (sublevelSet f c)).ncard = 2 * m := by
    have hle : {t ∈ componentsIn (sublevelSet f c) | ¬ Convex ℝ t}.ncard ≤
        (componentsIn (sublevelSet f c)).ncard := by
      apply Set.ncard_le_ncard
      · intro t ht
        exact ht.1
      · exact hcompfin
    have hlow : 2 * m ≤ (componentsIn (sublevelSet f c)).ncard := by
      rw [← hnc]
      exact hle
    exact Nat.le_antisymm hupper hlow
  have hroot : (f.rootSet ℂ).ncard = 2 * m := by
    dsimp [f]
    exact Erdos1047EvenFamily.evenFamily_rootSet_ncard m hm
  refine ⟨f, c, hfm, hfdeg, hc, ?_, ?_⟩
  · exact hcomp.trans hroot.symm
  · simpa [f] using hnc

def p8Anchors : Fin 8 → ℂ := ![
  (107 / 100 : ℂ) - (21 / 100 : ℂ) * Complex.I,
  (21 / 100 : ℂ) + (107 / 100 : ℂ) * Complex.I,
  (-107 / 100 : ℂ) + (21 / 100 : ℂ) * Complex.I,
  (-21 / 100 : ℂ) - (107 / 100 : ℂ) * Complex.I,
  (107 / 100 : ℂ) + (21 / 100 : ℂ) * Complex.I,
  (-21 / 100 : ℂ) + (107 / 100 : ℂ) * Complex.I,
  (-107 / 100 : ℂ) - (21 / 100 : ℂ) * Complex.I,
  (21 / 100 : ℂ) - (107 / 100 : ℂ) * Complex.I
]

def p8Directions : Fin 4 → ℂ := ![
  (1 : ℂ), Complex.I, 1 + Complex.I, 1 - Complex.I
]

def p8SepIndex : Fin 8 → Fin 8 → Fin 4 := ![
  ![0, 0, 0, 1, 0, 0, 1, 3],
  ![0, 0, 1, 0, 2, 1, 0, 0],
  ![0, 1, 0, 0, 1, 3, 0, 0],
  ![1, 0, 0, 0, 0, 0, 2, 1],
  ![0, 2, 1, 0, 0, 1, 0, 0],
  ![0, 1, 3, 0, 1, 0, 0, 0],
  ![1, 0, 0, 2, 0, 0, 0, 1],
  ![3, 0, 0, 1, 0, 0, 1, 0]
]

theorem p8_direction_data (k : Fin 4) :
    p8Directions k ≠ 0 ∧ (p8Directions k ^ 4).im = 0 := by
  fin_cases k <;>
    norm_num [p8Directions, Complex.mul_re, Complex.mul_im,
      Complex.I_sq, Complex.star_def, pow_succ] <;>
    intro h <;>
    have h' := congrArg Complex.im h <;>
    norm_num at h'

theorem p8_anchor_sign_table :
    ∀ i j : Fin 8, i ≠ j →
      ∃ k : Fin 4,
        ((0 < (p8Anchors i * star (p8Directions k)).im ∧
            (p8Anchors j * star (p8Directions k)).im < 0) ∨
          ((p8Anchors i * star (p8Directions k)).im < 0 ∧
            0 < (p8Anchors j * star (p8Directions k)).im)) := by
  intro i j hij
  refine ⟨p8SepIndex i j, ?_⟩
  fin_cases i <;> fin_cases j <;>
    simp [p8Anchors, p8Directions, p8SepIndex] at * <;>
    norm_num [p8Anchors, p8SepIndex, Complex.star_def, Complex.mul_re,
      Complex.mul_im, Complex.I_sq, pow_succ] at *

theorem p8_polynomial_eval_I_pow_norm (k : ℕ) (z : ℂ) :
    ‖Erdos1047P8.polynomial.eval (Complex.I ^ k * z)‖ =
      ‖Erdos1047P8.polynomial.eval z‖ := by
  rw [Erdos1047P8.polynomial_expanded]
  simp only [eval_sub, eval_add, eval_mul, eval_C, eval_X, eval_pow]
  have h4 : Complex.I ^ 4 = (1 : ℂ) := by
    rw [show Complex.I ^ 4 = (Complex.I ^ 2) ^ 2 by ring, Complex.I_sq]
    norm_num
  have h8 : Complex.I ^ 8 = (1 : ℂ) := by
    rw [show Complex.I ^ 8 = (Complex.I ^ 4) ^ 2 by ring, h4]
    norm_num
  have hk4 : (Complex.I ^ k) ^ 4 = (1 : ℂ) := by
    rw [← pow_mul, Nat.mul_comm, pow_mul, h4]
    simp
  have hk8 : (Complex.I ^ k) ^ 8 = (1 : ℂ) := by
    rw [← pow_mul, Nat.mul_comm, pow_mul, h8]
    simp
  rw [show (Complex.I ^ k * z) ^ 8 = (Complex.I ^ k) ^ 8 * z ^ 8 by ring,
    show (Complex.I ^ k * z) ^ 4 = (Complex.I ^ k) ^ 4 * z ^ 4 by ring,
    hk8, hk4]
  simp

theorem p8_mem_I_pow_iff (k : ℕ) (z : ℂ) :
    Complex.I ^ k * z ∈ sublevelSet Erdos1047P8.polynomial Erdos1047P8.level ↔
      z ∈ sublevelSet Erdos1047P8.polynomial Erdos1047P8.level := by
  change ‖Erdos1047P8.polynomial.eval (Complex.I ^ k * z)‖ ≤
      Erdos1047P8.level ↔
        ‖Erdos1047P8.polynomial.eval z‖ ≤ Erdos1047P8.level
  rw [p8_polynomial_eval_I_pow_norm]

theorem p8_polynomial_eval_star_norm (z : ℂ) :
    ‖Erdos1047P8.polynomial.eval (star z)‖ =
      ‖Erdos1047P8.polynomial.eval z‖ := by
  calc
    ‖Erdos1047P8.polynomial.eval (star z)‖ =
        ‖star (Erdos1047P8.polynomial.eval z)‖ := by
      congr 1
      rw [Erdos1047P8.polynomial_expanded]
      simp [map_add, map_sub, map_mul, map_pow]
    _ = ‖Erdos1047P8.polynomial.eval z‖ := norm_star _

theorem p8_mul_I_pow_segment {k : ℕ} {r a : ℂ}
    (h : segment ℝ r a ⊆
      sublevelSet Erdos1047P8.polynomial Erdos1047P8.level) :
    segment ℝ (Complex.I ^ k * r) (Complex.I ^ k * a) ⊆
      sublevelSet Erdos1047P8.polynomial Erdos1047P8.level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hmap : u • (Complex.I ^ k * r) + v •
      (Complex.I ^ k * a) =
      Complex.I ^ k * (u • r + v • a) := by
    rw [Complex.real_smul, Complex.real_smul, Complex.real_smul,
      Complex.real_smul]
    ring
  rw [hmap]
  exact (p8_mem_I_pow_iff k _).2 (h ⟨u, v, hu, hv, huv, rfl⟩)

theorem p8_star_segment {r a : ℂ}
    (h : segment ℝ r a ⊆
      sublevelSet Erdos1047P8.polynomial Erdos1047P8.level) :
    segment ℝ (star r) (star a) ⊆
      sublevelSet Erdos1047P8.polynomial Erdos1047P8.level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  rw [show u • star r + v • star a = star (u • r + v • a) by simp]
  change ‖Erdos1047P8.polynomial.eval
      (star (u • r + v • a))‖ ≤ Erdos1047P8.level
  rw [p8_polynomial_eval_star_norm]
  exact h ⟨u, v, hu, hv, huv, rfl⟩

theorem p8_mul_I_pow_midpoint_outside {k : ℕ} {a b : ℂ}
    (h : midpoint ℝ a b ∉
      sublevelSet Erdos1047P8.polynomial Erdos1047P8.level) :
    midpoint ℝ (Complex.I ^ k * a) (Complex.I ^ k * b) ∉
      sublevelSet Erdos1047P8.polynomial Erdos1047P8.level := by
  intro hm
  apply h
  have hmap : midpoint ℝ (Complex.I ^ k * a)
      (Complex.I ^ k * b) =
      Complex.I ^ k * midpoint ℝ a b := by
    simp [midpoint, AffineMap.lineMap_apply_module]
    ring
  rw [hmap] at hm
  exact (p8_mem_I_pow_iff k _).1 hm

theorem p8_star_midpoint_outside {a b : ℂ}
    (h : midpoint ℝ a b ∉
      sublevelSet Erdos1047P8.polynomial Erdos1047P8.level) :
    midpoint ℝ (star a) (star b) ∉
      sublevelSet Erdos1047P8.polynomial Erdos1047P8.level := by
  intro hm
  apply h
  change ‖Erdos1047P8.polynomial.eval
      (midpoint ℝ (star a) (star b))‖ ≤ Erdos1047P8.level at hm
  have hmid : midpoint ℝ (star a) (star b) =
      star (midpoint ℝ a b) := by
    simp [midpoint, AffineMap.lineMap_apply_module]
  rw [hmid, p8_polynomial_eval_star_norm] at hm
  exact hm

theorem p8_mem_star_iff (z : ℂ) :
    star z ∈ sublevelSet Erdos1047P8.polynomial Erdos1047P8.level ↔
      z ∈ sublevelSet Erdos1047P8.polynomial Erdos1047P8.level := by
  change ‖Erdos1047P8.polynomial.eval (star z)‖ ≤ Erdos1047P8.level ↔
    ‖Erdos1047P8.polynomial.eval z‖ ≤ Erdos1047P8.level
  rw [p8_polynomial_eval_star_norm]

theorem p8_I_pow_component_not_convex (k : ℕ) :
    ¬ Convex ℝ (connectedComponentIn
      (sublevelSet Erdos1047P8.polynomial Erdos1047P8.level)
      (Complex.I ^ k * Erdos1047P8.anchor)) := by
  exact component_not_convex_of_segments
    (p8_mul_I_pow_segment Erdos1047Proof.p8_lineA_subset)
    (p8_mul_I_pow_segment Erdos1047Proof.p8_lineB_subset)
    (p8_mul_I_pow_midpoint_outside Erdos1047Proof.p8_midpoint_outside)

theorem p8_star_component_not_convex :
    ¬ Convex ℝ (connectedComponentIn
      (sublevelSet Erdos1047P8.polynomial Erdos1047P8.level)
      (star Erdos1047P8.anchor)) := by
  exact component_not_convex_of_segments
    (p8_star_segment Erdos1047Proof.p8_lineA_subset)
    (p8_star_segment Erdos1047Proof.p8_lineB_subset)
    (p8_star_midpoint_outside Erdos1047Proof.p8_midpoint_outside)

theorem p8_star_I_pow_component_not_convex (k : ℕ) :
    ¬ Convex ℝ (connectedComponentIn
      (sublevelSet Erdos1047P8.polynomial Erdos1047P8.level)
      (star (Complex.I ^ k * Erdos1047P8.anchor))) := by
  exact component_not_convex_of_segments
    (p8_star_segment (p8_mul_I_pow_segment Erdos1047Proof.p8_lineA_subset))
    (p8_star_segment (p8_mul_I_pow_segment Erdos1047Proof.p8_lineB_subset))
      (p8_star_midpoint_outside
      (p8_mul_I_pow_midpoint_outside Erdos1047Proof.p8_midpoint_outside))

theorem p8_anchor_eq_transformed (i : Fin 8) :
    p8Anchors i =
      match i.1 with
      | 0 => Erdos1047P8.anchor
      | 1 => Complex.I * Erdos1047P8.anchor
      | 2 => Complex.I ^ 2 * Erdos1047P8.anchor
      | 3 => Complex.I ^ 3 * Erdos1047P8.anchor
      | 4 => star Erdos1047P8.anchor
      | 5 => Complex.I * star Erdos1047P8.anchor
      | 6 => Complex.I ^ 2 * star Erdos1047P8.anchor
      | _ => Complex.I ^ 3 * star Erdos1047P8.anchor := by
  fin_cases i <;>
    norm_num [p8Anchors, Erdos1047P8.anchor, Complex.star_def,
      Complex.mul_re, Complex.mul_im, Complex.I_sq, pow_succ] <;>
    ring_nf <;>
    norm_num [Complex.I_sq] <;>
    ring

theorem p8_anchors_injective : Function.Injective p8Anchors := by
  intro i j hij
  fin_cases i <;> fin_cases j <;>
    norm_num [p8Anchors, Complex.ext_iff, Complex.mul_re, Complex.mul_im,
      Complex.I_sq, pow_succ] at hij <;>
    rfl

theorem p8_anchor_mem (i : Fin 8) :
    p8Anchors i ∈ sublevelSet Erdos1047P8.polynomial Erdos1047P8.level := by
  rw [p8_anchor_eq_transformed]
  fin_cases i
  · exact Erdos1047Proof.p8_lineA_subset
      (left_mem_segment ℝ Erdos1047P8.anchor Erdos1047P8.pointA)
  · simpa [pow_one] using (p8_mem_I_pow_iff 1 _).2
      (Erdos1047Proof.p8_lineA_subset
        (left_mem_segment ℝ Erdos1047P8.anchor Erdos1047P8.pointA))
  · exact (p8_mem_I_pow_iff 2 _).2
      (Erdos1047Proof.p8_lineA_subset
        (left_mem_segment ℝ Erdos1047P8.anchor Erdos1047P8.pointA))
  · exact (p8_mem_I_pow_iff 3 _).2
      (Erdos1047Proof.p8_lineA_subset
        (left_mem_segment ℝ Erdos1047P8.anchor Erdos1047P8.pointA))
  · exact (p8_mem_star_iff Erdos1047P8.anchor).2
      (Erdos1047Proof.p8_lineA_subset
        (left_mem_segment ℝ Erdos1047P8.anchor Erdos1047P8.pointA))
  · simpa [pow_one] using (p8_mem_I_pow_iff 1 _).2
      ((p8_mem_star_iff Erdos1047P8.anchor).2
        (Erdos1047Proof.p8_lineA_subset
          (left_mem_segment ℝ Erdos1047P8.anchor Erdos1047P8.pointA)))
  · exact (p8_mem_I_pow_iff 2 _).2
      ((p8_mem_star_iff Erdos1047P8.anchor).2
        (Erdos1047Proof.p8_lineA_subset
          (left_mem_segment ℝ Erdos1047P8.anchor Erdos1047P8.pointA)))
  · exact (p8_mem_I_pow_iff 3 _).2
      ((p8_mem_star_iff Erdos1047P8.anchor).2
        (Erdos1047Proof.p8_lineA_subset
          (left_mem_segment ℝ Erdos1047P8.anchor Erdos1047P8.pointA)))

theorem p8_anchor_nonconvex (i : Fin 8) :
    ¬ Convex ℝ (connectedComponentIn
      (sublevelSet Erdos1047P8.polynomial Erdos1047P8.level)
      (p8Anchors i)) := by
  rw [p8_anchor_eq_transformed]
  fin_cases i
  · exact Erdos1047Proof.p8_anchor_component_not_convex
  · simpa [pow_one] using p8_I_pow_component_not_convex 1
  · exact p8_I_pow_component_not_convex 2
  · exact p8_I_pow_component_not_convex 3
  · exact p8_star_component_not_convex
  · simpa [Complex.star_def, pow_succ, Complex.I_sq] using
      p8_star_I_pow_component_not_convex 3
  · simpa [Complex.star_def, pow_succ, Complex.I_sq] using
      p8_star_I_pow_component_not_convex 2
  · simpa [pow_one, Complex.star_def, pow_succ, Complex.I_sq] using
      p8_star_I_pow_component_not_convex 1

theorem p8_anchors_component_inj :
    Set.InjOn (fun z : ℂ => connectedComponentIn
      (sublevelSet Erdos1047P8.polynomial Erdos1047P8.level) z)
      (Set.range p8Anchors) := by
  have hmem : ∀ z ∈ (Set.range p8Anchors),
      z ∈ sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial 4)
        Erdos1047P8.level := by
    intro z hz
    rcases hz with ⟨i, rfl⟩
    simpa [Erdos1047P8.polynomial] using p8_anchor_mem i
  have hsep : ∀ ⦃r s : ℂ⦄, r ∈ (Set.range p8Anchors) →
      s ∈ (Set.range p8Anchors) → r ≠ s →
      ∃ u : ℂ, u ≠ 0 ∧ (u ^ 4).im = 0 ∧
        ((0 < (r * star u).im ∧ (s * star u).im < 0) ∨
          ((r * star u).im < 0 ∧ 0 < (s * star u).im)) := by
    intro r s hr hs hrs
    rcases hr with ⟨i, rfl⟩
    rcases hs with ⟨j, rfl⟩
    have hij : i ≠ j := by
      intro heq
      apply hrs
      rw [heq]
    obtain ⟨k, hk⟩ := p8_anchor_sign_table i j hij
    exact ⟨p8Directions k, (p8_direction_data k).1,
      (p8_direction_data k).2, hk⟩
  have hEven := evenFamily_component_map_injOn_of_angular_separators
    (m := 4) (c := Erdos1047P8.level) (by norm_num [Erdos1047P8.level])
      hmem hsep
  simpa [Erdos1047P8.polynomial] using hEven

theorem p8_attainable_eight : 8 ∈ attainableNonConvexCounts 8 := by
  apply attainable_of_finite_nonconvex_witnesses_of_regular_values
    (f := Erdos1047EvenFamily.evenFamilyPolynomial 4)
    (c := Erdos1047P8.level) (n := 8)
  · exact Erdos1047EvenFamily.evenFamily_monic 4 (by omega)
  · exact Erdos1047EvenFamily.evenFamily_separable 4 (by omega)
  · simpa using Erdos1047EvenFamily.evenFamily_natDegree 4 (by omega)
  · norm_num
  · norm_num [Erdos1047P8.level]
  · exact Erdos1047Proof.evenFamily_closedBall_subset_regular_values_of_lt_one
      (m := 4) (by omega) (by norm_num [Erdos1047P8.level])
  · exact Set.finite_range p8Anchors
  · simpa using (Set.ncard_range_of_injective p8_anchors_injective)
  · simpa [Erdos1047P8.polynomial] using p8_anchor_mem
  · exact p8_anchors_component_inj
  · intro z hz
    rcases hz with ⟨i, rfl⟩
    exact p8_anchor_nonconvex i

/-! The p₈ finite-witness proof also exposes exact component cardinalities as
    standalone facts.  This makes the saturated witness reusable by
    root-oriented degree-raising code without unpacking the target predicate. -/
theorem p8_componentsIn_ncard :
    (componentsIn (sublevelSet p8Polynomial Erdos1047P8.level)).ncard = 8 := by
  have hreg : Metric.closedBall (0 : ℂ) Erdos1047P8.level ⊆
      ((p8Polynomial).eval '' {u : ℂ | p8Polynomial.derivative.eval u = 0})ᶜ := by
    simpa [p8Polynomial] using
      (evenFamily_closedBall_subset_regular_values_of_lt_one
        (m := 4) (by omega) (by norm_num [Erdos1047P8.level]))
  have hfin : (componentsIn
      (sublevelSet p8Polynomial Erdos1047P8.level)).Finite := by
    rw [componentsIn_eq_image_rootSet_of_regular_values
      p8Polynomial_algebraic_data.1 (by norm_num [Erdos1047P8.level]) hreg]
    exact (p8Polynomial.rootSet_finite ℂ).image _
  have hupper : (componentsIn
      (sublevelSet p8Polynomial Erdos1047P8.level)).ncard ≤ 8 := by
    rw [componentsIn_eq_image_rootSet_of_regular_values
      p8Polynomial_algebraic_data.1 (by norm_num [Erdos1047P8.level]) hreg]
    calc
      _ ≤ (p8Polynomial.rootSet ℂ).ncard :=
        Set.ncard_image_le (p8Polynomial.rootSet_finite ℂ)
      _ = 8 := p8Polynomial_algebraic_data.2.2.2
  have hAcard : (Set.range p8Anchors).ncard = 8 := by
    rw [Set.ncard_range_of_injective p8_anchors_injective]
    simp
  have hmem : ∀ z ∈ (Set.range p8Anchors),
      z ∈ sublevelSet p8Polynomial Erdos1047P8.level := by
    intro z hz
    rcases hz with ⟨i, rfl⟩
    simpa [p8Polynomial, Erdos1047P8.polynomial] using p8_anchor_mem i
  have hInj : Set.InjOn (fun z : ℂ => connectedComponentIn
      (sublevelSet p8Polynomial Erdos1047P8.level) z)
      (Set.range p8Anchors) := by
    simpa [p8Polynomial, Erdos1047P8.polynomial] using p8_anchors_component_inj
  have himage_subset :
      (fun z : ℂ => connectedComponentIn
        (sublevelSet p8Polynomial Erdos1047P8.level) z) ''
        (Set.range p8Anchors) ⊆
      componentsIn (sublevelSet p8Polynomial Erdos1047P8.level) := by
    rintro t ⟨z, hz, rfl⟩
    exact ⟨z, hmem z hz, rfl⟩
  have himagecard :
      ((fun z : ℂ => connectedComponentIn
        (sublevelSet p8Polynomial Erdos1047P8.level) z) ''
        (Set.range p8Anchors)).ncard = 8 := by
    rw [hInj.ncard_image, hAcard]
  have hlower : 8 ≤ (componentsIn
      (sublevelSet p8Polynomial Erdos1047P8.level)).ncard := by
    rw [← himagecard]
    exact Set.ncard_le_ncard himage_subset hfin
  exact Nat.le_antisymm hupper hlower

theorem p8_nonconvex_ncard :
    {t ∈ componentsIn (sublevelSet p8Polynomial Erdos1047P8.level) |
      ¬ Convex ℝ t}.ncard = 8 := by
  have hfin : (componentsIn
      (sublevelSet p8Polynomial Erdos1047P8.level)).Finite := by
    rw [componentsIn_eq_image_rootSet_of_regular_values
      p8Polynomial_algebraic_data.1 (by norm_num [Erdos1047P8.level])
      (by
        simpa [p8Polynomial] using
          (evenFamily_closedBall_subset_regular_values_of_lt_one
            (m := 4) (by omega) (by norm_num [Erdos1047P8.level])))]
    exact (p8Polynomial.rootSet_finite ℂ).image _
  have hmem : ∀ z ∈ (Set.range p8Anchors),
      z ∈ sublevelSet p8Polynomial Erdos1047P8.level := by
    intro z hz
    rcases hz with ⟨i, rfl⟩
    simpa [p8Polynomial, Erdos1047P8.polynomial] using p8_anchor_mem i
  have hInj : Set.InjOn (fun z : ℂ => connectedComponentIn
      (sublevelSet p8Polynomial Erdos1047P8.level) z)
      (Set.range p8Anchors) := by
    simpa [p8Polynomial, Erdos1047P8.polynomial] using p8_anchors_component_inj
  have hnc : ∀ z ∈ (Set.range p8Anchors),
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet p8Polynomial Erdos1047P8.level) z) := by
    intro z hz
    rcases hz with ⟨i, rfl⟩
    simpa [p8Polynomial, Erdos1047P8.polynomial] using p8_anchor_nonconvex i
  exact nonconvex_ncard_eq_of_finite_witnesses
    (S := sublevelSet p8Polynomial Erdos1047P8.level)
    (A := Set.range p8Anchors) (n := 8)
    (Set.finite_range p8Anchors) (by
      rw [Set.ncard_range_of_injective p8_anchors_injective]
      simp)
    hmem hInj hnc p8_componentsIn_ncard hfin

theorem p8_all_root_components_nonconvex :
    ∀ z ∈ (↑(p8Polynomial.rootSet ℂ) : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet p8Polynomial Erdos1047P8.level) z) := by
  have hfin : (componentsIn
      (sublevelSet p8Polynomial Erdos1047P8.level)).Finite := by
    rw [componentsIn_eq_image_rootSet_of_regular_values
      p8Polynomial_algebraic_data.1 (by norm_num [Erdos1047P8.level])
      (by
        simpa [p8Polynomial] using
          (evenFamily_closedBall_subset_regular_values_of_lt_one
            (m := 4) (by omega) (by norm_num [Erdos1047P8.level])))]
    exact (p8Polynomial.rootSet_finite ℂ).image _
  have hall := all_components_nonconvex_of_ncard_eq hfin
    p8_componentsIn_ncard p8_nonconvex_ncard
  intro z hz
  apply hall (connectedComponentIn
    (sublevelSet p8Polynomial Erdos1047P8.level) z)
  rw [componentsIn_eq_image_rootSet_of_regular_values
    p8Polynomial_algebraic_data.1 (by norm_num [Erdos1047P8.level])
    (by
      simpa [p8Polynomial] using
        (evenFamily_closedBall_subset_regular_values_of_lt_one
          (m := 4) (by omega) (by norm_num [Erdos1047P8.level])))]
  exact ⟨z, hz, rfl⟩

theorem max_nonconvex_eight : IsGreatest (attainableNonConvexCounts 8) 8 :=
  ⟨p8_attainable_eight, fun _ hk ↦ attainable_le_degree (by norm_num) hk⟩
/-! The already verified six-component witness is also an instance of the
    even-family count-only wrapper.  This sanity-checks that the generic route
    recovers the concrete p₆ result without importing its bespoke component
    bookkeeping. -/
theorem evenFamily_three_attainable_via_count :
    6 ∈ attainableNonConvexCounts 6 := by
  have hc : 0 < Erdos1047P6.level := by
    norm_num [Erdos1047P6.level]
  have hc1 : Erdos1047P6.level < 1 := by
    norm_num [Erdos1047P6.level]
  apply evenFamily_attainable_of_nonconvex_count (m := 3) (by norm_num) hc hc1
  simpa [p6Polynomial, Erdos1047P6.polynomial] using p6_nonconvex_ncard

/-! Concrete p₅ instantiation.  The previously checked real-part formula on
    the imaginary axis is strengthened to a strict norm bound, then fed
    through the generic line-avoidance bridge at `a = 0`. -/
theorem p5_imaginary_axis_eval_norm_gt (y : ℝ) :
    p5Level < ‖p5Polynomial.eval ((y : ℂ) * Complex.I)‖ := by
  have hre : p5Level <
      (p5Polynomial.eval ((y : ℂ) * Complex.I)).re := by
    rw [p5_imaginary_axis_re]
    have hs0 : 0 ≤ y ^ 2 := sq_nonneg y
    have hs1 : 0 ≤ y ^ 4 := by positivity
    have hgap : 0 < (6066209 / 1069056 : ℝ) - p5Level := by
      rw [p5_constant_sub_level]
      norm_num
    nlinarith
  exact lt_of_lt_of_le hre (Complex.re_le_norm _)

/-! Concrete p₅ wrapper for the tuned vertical barrier.  The arithmetic
    hypotheses expose exactly the scale conditions still needed when choosing
    the tuned factor; no unproved geometric claim is hidden here. -/
theorem p5_tuned_raise_imaginary_axis_avoids_of_scaled_eval_bound
    {L A d : ℝ}
    (hB : 0 ≤ L ^ 2 - A * L + d)
    (hC : 0 ≤ 2 * L ^ 2 - 2 * A * L + A ^ 2 - 2 * d)
    (hlevel : p5WitnessLevel * L ^ 2 < p5Level * (L ^ 2 - A * L + d)) :
    ∀ y : ℝ, (y : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047TunedRaise.tunedRaisePolynomial p5Polynomial
          (L : ℂ) (A : ℂ) (d : ℂ)) (p5WitnessLevel * L ^ 2) := by
  intro y
  apply tuned_raise_imaginary_axis_set_avoids_of_eval_norm_ge
    (p := p5Polynomial) (c₀ := p5Level)
    (c := p5WitnessLevel * L ^ 2) hB hC
  · intro x
    exact (p5_imaginary_axis_eval_norm_gt x).le
  · exact hlevel

theorem p5_imaginary_axis_avoids_sublevel_via_eval_bound :
    ∀ z ∈ sublevelSet p5Polynomial p5Level, z.re ≠ 0 := by
  apply sublevelSet_avoids_re_line_of_eval_norm_gt
  intro y
  simpa using p5_imaginary_axis_eval_norm_gt y

theorem p5_imaginary_axis_avoids_witness_via_eval_bound :
    ∀ z ∈ sublevelSet p5Polynomial p5WitnessLevel, z.re ≠ 0 := by
  apply sublevelSet_avoids_re_line_of_eval_norm_gt
  intro y
  have hlevel : p5WitnessLevel < p5Level := by
    norm_num [p5WitnessLevel, p5Level]
  simpa [zero_add] using lt_trans hlevel (p5_imaginary_axis_eval_norm_gt y)

/-! Convert analytic lower bounds on finitely many coordinate lines into the
    separator certificates consumed by `component_map_injOn...`.  This is a
    deliberately assumption-preserving bridge: it does not assert any bound
    for a line unless the caller supplies it. -/
theorem coordinate_line_separators_of_eval_norm_gt
    {f : ℂ[X]} {c : ℝ} {A : Set ℂ}
    (hsep : ∀ ⦃r s : ℂ⦄, r ∈ A → s ∈ A → r ≠ s →
      (∃ a : ℝ, (∀ y : ℝ,
          c < ‖f.eval ((a : ℂ) + (y : ℂ) * Complex.I)‖) ∧
        ((r.re < a ∧ a < s.re) ∨ (s.re < a ∧ a < r.re))) ∨
      (∃ a : ℝ, (∀ x : ℝ,
          c < ‖f.eval ((x : ℂ) + (a : ℂ) * Complex.I)‖) ∧
        ((r.im < a ∧ a < s.im) ∨ (s.im < a ∧ a < r.im)))) :
    ∀ ⦃r s : ℂ⦄, r ∈ A → s ∈ A → r ≠ s →
      (∃ a : ℝ, (∀ z ∈ sublevelSet f c, z.re ≠ a) ∧
        ((r.re < a ∧ a < s.re) ∨ (s.re < a ∧ a < r.re))) ∨
      (∃ a : ℝ, (∀ z ∈ sublevelSet f c, z.im ≠ a) ∧
        ((r.im < a ∧ a < s.im) ∨ (s.im < a ∧ a < r.im))) := by
  intro r s hr hs hrs
  rcases hsep hr hs hrs with hRe | hIm
  · rcases hRe with ⟨a, hbound, horder⟩
    exact Or.inl ⟨a, sublevelSet_avoids_re_line_of_eval_norm_gt hbound, horder⟩
  · rcases hIm with ⟨a, hbound, horder⟩
    exact Or.inr ⟨a, sublevelSet_avoids_im_line_of_eval_norm_gt hbound, horder⟩

/-! Full exact-count wrapper with analytic separator input.  It is the
    intended entry point when the remaining mathematics is an explicit
    one-variable norm estimate on each separating line. -/
theorem degree_raise_componentsIn_ncard_eq_natDegree_of_eval_norm_separators
    {p : ℂ[X]} {n : ℕ} {L e : ℂ} {c : ℝ}
    (hp : p.Monic) (hpsep : p.Separable) (hdeg : p.natDegree = n)
    (he : e ≠ 0)
    (hcop : IsCoprime p (Erdos1047DegreeRaise.raiseFactor L (e ^ 2)))
    (hc : 0 < c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      ((Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval ''
        {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).derivative.eval u = 0})ᶜ)
    (hsep : ∀ ⦃r s : ℂ⦄,
      r ∈ (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) →
      s ∈ (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) →
      r ≠ s →
      (∃ a : ℝ, (∀ y : ℝ,
          c < ‖(Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval
            ((a : ℂ) + (y : ℂ) * Complex.I)‖) ∧
        ((r.re < a ∧ a < s.re) ∨ (s.re < a ∧ a < r.re))) ∨
      (∃ a : ℝ, (∀ x : ℝ,
          c < ‖(Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval
            ((x : ℂ) + (a : ℂ) * Complex.I)‖) ∧
        ((r.im < a ∧ a < s.im) ∨ (s.im < a ∧ a < r.im)))) :
    (componentsIn (sublevelSet
      (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c)).ncard = n + 2 := by
  apply degree_raise_componentsIn_ncard_eq_natDegree_of_coordinate_separators
    hp hpsep hdeg he hcop hc hreg
  exact coordinate_line_separators_of_eval_norm_gt hsep

/-! The component-sign consequences of the three separating lines. -/
theorem p6_component_im_positive (k : ℕ) {r : ℂ}
    (hr : r ∈ sublevelSet Erdos1047P6.polynomial Erdos1047P6.level)
    (hpos : 0 < (Erdos1047P6.omega ^ k * r).im) :
    ∀ z ∈ connectedComponentIn
      (sublevelSet Erdos1047P6.polynomial Erdos1047P6.level) r,
      0 < (Erdos1047P6.omega ^ k * z).im := by
  have hnz : ∀ w ∈ sublevelSet Erdos1047P6.polynomial Erdos1047P6.level,
      -(Erdos1047P6.omega ^ k * w).im ≠ 0 := by
    intro w hw hzero
    have hzero' : (Erdos1047P6.omega ^ k * w).im = 0 := by linarith
    exact (p6_not_mem_of_rotated_im_zero k hzero') hw
  intro z hz
  have h := negative_on_component
    (S := sublevelSet Erdos1047P6.polynomial Erdos1047P6.level)
    (r := r) (φ := fun w : ℂ => -(Erdos1047P6.omega ^ k * w).im)
    (by fun_prop) hnz hr (by linarith) z hz
  linarith

