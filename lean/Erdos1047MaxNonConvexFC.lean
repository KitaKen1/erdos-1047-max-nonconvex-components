section


/-!
# Real seeds and degree-two induction

The existing quartic and quintic robust certificates supply real witness
families. The balanced step then constructs families in every degree at least
four. The closed-level bridge gives the original closed/root-count conclusion.
Only the reusable proved core is imported; the final main file imports this induction.
-/

open Polynomial Set Erdos1047 Erdos1047Proof
open Erdos1047BalancedRaise Erdos1047BalancedCertificates Erdos1047BalancedTransport
open Erdos1047BalancedStep Erdos1047ClosedLevelBridge

namespace Erdos1047BalancedInduction

noncomputable section

def familyOfClosedCertificates {n : ℕ} (p : ℝ[X]) (q : ℂ[X])
    (hmap : complexify p = q) (hp : q.Monic) (hdeg : q.natDegree = n)
    {c : ℝ} (hc : 0 < c) (r a b : Fin n → ℂ) (hr : Function.Injective r)
    (hcert : ∀ i, Nonempty (RobustNonconvexCertificate (fun z => q.eval z) c (r i) (a i) (b i)))
    (hcomp : Set.InjOn (fun z => connectedComponentIn (sublevelSet q c) z) (Set.range r)) :
    RealWitnessFamily n := by
  subst q
  have hmem : ∀ z ∈ Set.range r, z ∈ strictSublevelSet (complexify p) c := by
    rintro _ ⟨i, rfl⟩
    exact certificate_anchor_mem (Classical.choice (hcert i))
  exact {
    polynomial := p
    monic := Polynomial.monic_of_injective (algebraMap ℝ ℂ).injective hp
    degree := by
      simpa only [complexify, natDegree_map_eq_of_injective (algebraMap ℝ ℂ).injective] using hdeg
    level := c
    level_pos := hc
    anchor := r
    pointA := a
    pointB := b
    anchor_injective := hr
    certificate := fun i => Classical.choice (hcert i)
    component_injective := component_map_injOn_of_subset
      Erdos1047StrictGeneralCore.strictSublevel_subset_sublevel hmem hcomp
  }

def realP4 : ℝ[X] := (X ^ 2 - 1) ^ 2 + 1

def realP5 : ℝ[X] :=
  X ^ 5 + C (15 / 8 : ℝ) * X ^ 4 - C (55 / 48 : ℝ) * X ^ 3 -
    C (145 / 32 : ℝ) * X ^ 2 + C (6066209 / 1069056 : ℝ)

theorem complexify_realP4 : complexify realP4 = p4Polynomial := by
  simp [complexify, realP4, p4Polynomial]

theorem complexify_realP5 : complexify realP5 = p5Polynomial := by
  norm_num [complexify, realP5, p5Polynomial]

theorem quartic_component_map_injOn :
    Set.InjOn (fun z => connectedComponentIn (sublevelSet p4Polynomial p4Level) z)
      (Set.range quarticFourAnchor) := by
  have hi : Function.Injective (fun i : Fin 4 =>
      connectedComponentIn (sublevelSet p4Polynomial p4Level) (quarticFourAnchor i)) := by
    obtain ⟨h01, h02, h03, h12, h13, h23⟩ := p4_four_components_pairwise_distinct
    intro i j heq
    fin_cases i <;> fin_cases j <;> simp_all [quarticFourAnchor]
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ heq
  exact congrArg quarticFourAnchor (hi heq)

def quarticFamily : RealWitnessFamily 4 :=
  familyOfClosedCertificates realP4 p4Polynomial complexify_realP4
    p4Polynomial_monic p4Polynomial_natDegree (by norm_num [p4Level])
    quarticFourAnchor quarticFourPointA quarticFourPointB quarticFourAnchor_injective
    p4_four_robust_certificate_family quartic_component_map_injOn

def quinticFamily : RealWitnessFamily 5 :=
  familyOfClosedCertificates realP5 p5Polynomial complexify_realP5
    p5Polynomial_monic p5Polynomial_natDegree (by norm_num [p5WitnessLevel, p5Level])
    p5FiveAnchor p5FivePointA p5FivePointB p5FiveAnchor_injective
    p5_five_robust_certificate_family p5_component_map_injOn

theorem witnessFamily_all_large_degrees (n : ℕ) :
    4 ≤ n → Nonempty (RealWitnessFamily n) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro hn
    by_cases h4 : n = 4
    · subst n
      exact ⟨quarticFamily⟩
    by_cases h5 : n = 5
    · subst n
      exact ⟨quinticFamily⟩
    obtain ⟨w⟩ := ih (n - 2) (by omega) (by omega)
    simpa only [show n - 2 + 2 = n by omega] using raise_by_two w (by omega)

/-- Closed attainability includes the required equality of component and distinct-root counts. -/
theorem closed_attainable_all_large_degrees (n : ℕ) (hn : 4 ≤ n) :
    n ∈ attainableNonConvexCounts n := by
  obtain ⟨w⟩ := witnessFamily_all_large_degrees n hn
  exact w.closed_attainable (by omega)

theorem max_nonconvex_all_large_degrees (n : ℕ) (hn : 4 ≤ n) :
    IsGreatest (attainableNonConvexCounts n) n := by
  exact ⟨closed_attainable_all_large_degrees n hn, fun k hk => attainable_le_degree (by omega) hk⟩

theorem closed_attainable_answer (n : ℕ) :
    maxNonConvexAnswer n ∈ attainableNonConvexCounts n := by
  by_cases hsmall : n ≤ 2
  · simpa only [maxNonConvexAnswer_of_le_two hsmall] using zero_attainable n
  by_cases hthree : n = 3
  · subst n
    simpa only [maxNonConvexAnswer_three] using three_attainable
  have hn : 4 ≤ n := by omega
  simpa only [maxNonConvexAnswer_of_four_le hn] using closed_attainable_all_large_degrees n hn

theorem max_nonconvex_all_degrees (n : ℕ) :
    IsGreatest (attainableNonConvexCounts n) (maxNonConvexAnswer n) :=
  ⟨closed_attainable_answer n, attainable_le_proposed_answer n⟩

/-- The exact closed/root-count target from the completed balanced induction. -/
theorem erdos_1047_max_non_convex_components (n : ℕ) :
    IsGreatest
      {k : ℕ | ∃ (f : ℂ[X]) (c : ℝ), f.Monic ∧ f.natDegree = n ∧ 0 < c ∧
        (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard =
          (f.rootSet ℂ).ncard ∧
        {t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c) |
          ¬ Convex ℝ t}.ncard = k}
      answer(maxNonConvexAnswer n) := by
  change IsGreatest (attainableNonConvexCounts n) (maxNonConvexAnswer n)
  exact max_nonconvex_all_degrees n

/-- info: 'Erdos1047BalancedInduction.witnessFamily_all_large_degrees' depends on axioms:
[propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms witnessFamily_all_large_degrees

/-- info: 'Erdos1047BalancedInduction.max_nonconvex_all_large_degrees' depends on axioms:
[propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms max_nonconvex_all_large_degrees

/-- info: 'Erdos1047BalancedInduction.erdos_1047_max_non_convex_components' depends on axioms:
[propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms erdos_1047_max_non_convex_components

end
end Erdos1047BalancedInduction

