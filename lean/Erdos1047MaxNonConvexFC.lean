/-!
# Exact degree-two value for the current strict target

The strict quadratic audit supplies a witness with one non-convex component.
The normal-form and Cassini cores supply the matching upper bound: above the
critical level there is only one component, while at or below the critical
level every component is convex (including the cusp level).  The double-root
case is a translated open disk.
-/

open Polynomial
open Set

namespace Erdos1047StrictQuadraticExact

noncomputable section

open Erdos1047StrictLowDegreeAudit
open Erdos1047StrictQuadratic
open Erdos1047StrictQuadraticSubcritical

theorem monic_quadratic_strictSublevel_convex_of_criticalValue_eq_zero
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ)
    (hc : 0 < c) (hq : criticalValue f = 0) :
    Convex ℝ (Erdos1047.strictSublevelSet f c) := by
  have hset : Erdos1047.strictSublevelSet f c =
      Metric.ball (center f) (Real.sqrt c) := by
    ext z
    have heval : f.eval z = (z - center f) ^ 2 := by
      have he := monic_quadratic_eval_center_add f hf hdeg (z - center f)
      simpa [hq] using he
    change ‖f.eval z‖ < c ↔ z ∈ Metric.ball (center f) (Real.sqrt c)
    rw [heval, norm_pow, Metric.mem_ball, dist_eq_norm]
    rw [← sq_lt_sq₀ (norm_nonneg _) (Real.sqrt_nonneg c), Real.sq_sqrt hc.le]
  rw [hset]
  exact convex_ball _ _

theorem monic_quadratic_strictSublevel_nonconvex_ncard_le_one
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ)
    (hc : 0 < c) :
    {t ∈ Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) |
      ¬ Convex ℝ t}.ncard ≤ 1 := by
  by_cases hq : criticalValue f = 0
  · have hconv := monic_quadratic_strictSublevel_convex_of_criticalValue_eq_zero
      f hf hdeg c hc hq
    have hempty : {t ∈ Erdos1047.componentsIn
        (Erdos1047.strictSublevelSet f c) | ¬ Convex ℝ t} = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      rintro t ⟨ht, hnc⟩
      rcases ht with ⟨z, hz, rfl⟩
      exact hnc (by rw [hconv.isPreconnected.connectedComponentIn hz]; exact hconv)
    rw [hempty]
    simp
  · by_cases hlt : c < ‖criticalValue f‖
    · have hall := monic_quadratic_strictSublevel_nonconvex_ncard_eq_zero_of_subcritical
        f hf hdeg c hc hq hlt
      rw [hall]
      exact Nat.zero_le _
    · by_cases heq : c = ‖criticalValue f‖
      · have hall := monic_quadratic_strictSublevel_components_convex_of_critical_level
          f hf hdeg c hc hq heq
        have hempty : {t ∈ Erdos1047.componentsIn
            (Erdos1047.strictSublevelSet f c) | ¬ Convex ℝ t} = ∅ := by
          apply Set.eq_empty_iff_forall_notMem.mpr
          rintro t ⟨ht, hnc⟩
          exact hnc (hall t ht)
        rw [hempty]
        simp
      · have hle : ‖criticalValue f‖ ≤ c := le_of_not_gt hlt
        have hne : ‖criticalValue f‖ ≠ c := by
          intro h
          exact heq h.symm
        have hgt : ‖criticalValue f‖ < c := lt_of_le_of_ne hle hne
        exact Erdos1047StrictQuadratic.monic_quadratic_strictSublevel_nonconvex_ncard_le_one
          f hf hdeg c hgt

theorem strict_max_nonconvex_of_degree_two :
    IsGreatest (strictAttainableNonConvexCounts 2) 1 := by
  have hlower : 1 ∈ strictAttainableNonConvexCounts 2 := by
    simpa [strictAttainableNonConvexCounts] using
      Erdos1047StrictQuadraticAudit.strict_quadratic_attains_one
  refine ⟨hlower, ?_⟩
  intro k hk
  obtain ⟨f, c, hf, hdeg, hc, hkcount⟩ := hk
  have hle := monic_quadratic_strictSublevel_nonconvex_ncard_le_one
    f hf hdeg c hc
  rw [hkcount] at hle
  exact hle

#print axioms monic_quadratic_strictSublevel_convex_of_criticalValue_eq_zero
#print axioms monic_quadratic_strictSublevel_nonconvex_ncard_le_one
#print axioms strict_max_nonconvex_of_degree_two

end
end Erdos1047StrictQuadraticExact

