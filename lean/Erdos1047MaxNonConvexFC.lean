/-! A finite-union wrapper for the regular-value construction.  This isolates
the exact bookkeeping needed by degree raising: old and new anchors may be
verified separately, while component injectivity and non-convexity are stated
on their disjoint union.  The analytic separation argument is intentionally
left in these hypotheses. -/
theorem attainable_of_disjoint_union_nonconvex_witnesses_of_regular_values
    {f : ℂ[X]} {c : ℝ} {a b : ℕ}
    (hf : f.Monic) (hsep : f.Separable)
    (hdeg : f.natDegree = a + b) (hn : 0 < a + b) (hc : 0 < c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      (f.eval '' {u : ℂ | f.derivative.eval u = 0})ᶜ)
    {A B : Set ℂ} (hAfin : A.Finite) (hBfin : B.Finite)
    (hdisj : Disjoint A B) (hAcard : A.ncard = a) (hBcard : B.ncard = b)
    (hmem : ∀ z ∈ A ∪ B, z ∈ sublevelSet f c)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn (sublevelSet f c) z) (A ∪ B))
    (hnc : ∀ z ∈ A ∪ B,
      ¬ Convex ℝ (connectedComponentIn (sublevelSet f c) z)) :
    a + b ∈ attainableNonConvexCounts (a + b) := by
  have hUfin : (A ∪ B).Finite := hAfin.union hBfin
  have hUcard : (A ∪ B).ncard = a + b := by
    rw [Set.ncard_union_eq hdisj hAfin hBfin, hAcard, hBcard]
  exact attainable_of_finite_nonconvex_witnesses_of_regular_values
    hf hsep hdeg hn hc hreg hUfin hUcard hmem hcompInj hnc

/-! Degree-raising specialization.  Algebra supplies monicity, separability,
and the degree increment; the only remaining inputs are the geometric facts
that the old and new anchor families occupy distinct components and are all
non-convex. -/
theorem attainable_of_degree_raise_anchor_package
    {p : ℂ[X]} {n : ℕ} {L e : ℂ} {c : ℝ}
    (hp : p.Monic) (hpsep : p.Separable) (hdeg : p.natDegree = n)
    (he : e ≠ 0)
    (hcop : IsCoprime p (Erdos1047DegreeRaise.raiseFactor L (e ^ 2)))
    (hc : 0 < c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      ((Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval ''
        {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).derivative.eval u = 0})ᶜ)
    {A B : Set ℂ} (hAfin : A.Finite) (hBfin : B.Finite)
    (hdisj : Disjoint A B) (hAcard : A.ncard = n) (hBcard : B.ncard = 2)
    (hmem : ∀ z ∈ A ∪ B, z ∈ sublevelSet
      (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn
        (sublevelSet (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)
      (A ∪ B))
    (hnc : ∀ z ∈ A ∪ B,
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)) :
    n + 2 ∈ attainableNonConvexCounts (n + 2) := by
  let q : ℂ[X] := Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)
  have hqmonic : q.Monic := by
    dsimp [q]
    exact Erdos1047DegreeRaise.raisePolynomial_monic p L (e ^ 2) hp
  have hqsep : q.Separable := by
    dsimp [q]
    exact Erdos1047DegreeRaise.raisePolynomial_separable p L (e ^ 2) hpsep
      (pow_ne_zero 2 he) hcop
  have hqdeg : q.natDegree = n + 2 := by
    dsimp [q]
    rw [Erdos1047DegreeRaise.raisePolynomial_natDegree p L (e ^ 2) hp, hdeg]
  apply attainable_of_disjoint_union_nonconvex_witnesses_of_regular_values
    (f := q) (a := n) (b := 2) hqmonic hqsep hqdeg (by omega) hc
  · simpa [q] using hreg
  · exact hAfin
  · exact hBfin
  · exact hdisj
  · exact hAcard
  · exact hBcard
  · simpa [q] using hmem
  · simpa [q] using hcompInj
  · simpa [q] using hnc

/-! Canonical version of the raising package.  Taking the old root set and the
    two explicit quadratic roots removes an otherwise distracting layer of
    finite-set bookkeeping.  The only hypotheses left are precisely the
    geometric obligations: every canonical anchor lies in the raised
    sublevel, their component labels are injective, and each labelled
    component is non-convex. -/
theorem attainable_of_degree_raise_canonical_anchor_package
    {p : ℂ[X]} {n : ℕ} {L e : ℂ} {c : ℝ}
    (hp : p.Monic) (hpsep : p.Separable) (hdeg : p.natDegree = n)
    (he : e ≠ 0)
    (hcop : IsCoprime p (Erdos1047DegreeRaise.raiseFactor L (e ^ 2)))
    (hc : 0 < c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      ((Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval ''
        {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).derivative.eval u = 0})ᶜ)
    (hmem : ∀ z ∈
      (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ),
      z ∈ sublevelSet (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn
        (sublevelSet (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)
      ((↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ)))
    (hnc : ∀ z ∈
      (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)) :
    n + 2 ∈ attainableNonConvexCounts (n + 2) := by
  have hAcard : (↑(p.rootSet ℂ) : Set ℂ).ncard = n := by
    have hcard : Fintype.card (p.rootSet ℂ) = p.natDegree :=
      Polynomial.card_rootSet_eq_natDegree hpsep (IsAlgClosed.splits _)
    simpa [hdeg] using hcard
  have hBcard :
      ({L + e * Complex.I, L - e * Complex.I} : Set ℂ).ncard = 2 := by
    have hne : L + e * Complex.I ≠ L - e * Complex.I := by
      intro h
      have hzero : e * Complex.I = 0 := by
        apply mul_left_cancel₀ (show (2 : ℂ) ≠ 0 by norm_num)
        linear_combination h
      exact (mul_eq_zero.mp hzero).elim he Complex.I_ne_zero
    simp [hne]
  have hdisj := Erdos1047DegreeRaise.raisePolynomial_old_new_rootSet_disjoint
    p L e hp he hcop
  apply attainable_of_degree_raise_anchor_package hp hpsep hdeg he hcop hc hreg
    (A := (↑(p.rootSet ℂ) : Set ℂ))
    (B := ({L + e * Complex.I, L - e * Complex.I} : Set ℂ))
  · exact (p.rootSet_finite ℂ)
  · exact (Set.finite_singleton _).insert _
  · exact hdisj
  · exact hAcard
  · exact hBcard
  · exact hmem
  · exact hcompInj
  · exact hnc

/-! Every canonical anchor is automatically in a positive raised sublevel: old
    anchors are roots of the old factor, and the two new anchors are roots of
    the quadratic factor.  This discharges the membership input of the
    canonical package and leaves only the genuinely geometric conditions. -/
theorem degree_raise_canonical_anchors_mem_sublevel
    {p : ℂ[X]} {L e : ℂ} {c : ℝ} (hp : p.Monic) (hc : 0 < c)
    (z : ℂ)
    (hz : z ∈ (↑(p.rootSet ℂ) : Set ℂ) ∪
      ({L + e * Complex.I, L - e * Complex.I} : Set ℂ)) :
    z ∈ sublevelSet
      (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c := by
  change ‖(Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval z‖ ≤ c
  have hc0 : 0 ≤ c := le_of_lt hc
  rcases hz with hzold | hznew
  · have hroot := Erdos1047DegreeRaise.raisePolynomial_root_of_original_root
      p L e z hp hzold
    rw [hroot, norm_zero]
    exact hc0
  · have hz' : z = L + e * Complex.I ∨ z = L - e * Complex.I := by
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hznew
    rcases hz' with rfl | rfl
    · have hfactor := Erdos1047DegreeRaise.raiseFactor_eval_center_add_mul_I L e
      have hroot := Erdos1047DegreeRaise.raisePolynomial_root_of_factor_root
        p L (e ^ 2) (L + e * Complex.I) hfactor
      rw [hroot, norm_zero]
      exact hc0
    · have hfactor := Erdos1047DegreeRaise.raiseFactor_eval_center_sub_mul_I L e
      have hroot := Erdos1047DegreeRaise.raisePolynomial_root_of_factor_root
        p L (e ^ 2) (L - e * Complex.I) hfactor
      rw [hroot, norm_zero]
      exact hc0

/-! Consequently the canonical raising package can be called with no separate
    sublevel-membership proof: positivity of the level supplies it uniformly. -/
theorem attainable_of_degree_raise_canonical_anchor_package_auto_mem
    {p : ℂ[X]} {n : ℕ} {L e : ℂ} {c : ℝ}
    (hp : p.Monic) (hpsep : p.Separable) (hdeg : p.natDegree = n)
    (he : e ≠ 0)
    (hcop : IsCoprime p (Erdos1047DegreeRaise.raiseFactor L (e ^ 2)))
    (hc : 0 < c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      ((Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval ''
        {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).derivative.eval u = 0})ᶜ)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn
        (sublevelSet (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)
      ((↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ)))
    (hnc : ∀ z ∈
      (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)) :
    n + 2 ∈ attainableNonConvexCounts (n + 2) := by
  apply attainable_of_degree_raise_canonical_anchor_package hp hpsep hdeg he hcop hc hreg
  · intro z hz
    exact degree_raise_canonical_anchors_mem_sublevel hp hc z hz
  · exact hcompInj
  · exact hnc

/-! Coordinate-separator specialization of the canonical raising package.  This
is the intended lightweight interface for the remaining degree-raising proof:
once the raised sublevel avoids a finite collection of vertical or horizontal
lines separating the canonical anchors, component injectivity is automatic. -/
theorem attainable_of_degree_raise_canonical_anchor_package_auto_mem_of_coordinate_separators
    {p : ℂ[X]} {n : ℕ} {L e : ℂ} {c : ℝ}
    (hp : p.Monic) (hpsep : p.Separable) (hdeg : p.natDegree = n)
    (he : e ≠ 0)
    (hcop : IsCoprime p (Erdos1047DegreeRaise.raiseFactor L (e ^ 2)))
    (hc : 0 < c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      ((Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval ''
        {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).derivative.eval u = 0})ᶜ)
    (hsep : ∀ ⦃r s : ℂ⦄,
      r ∈ (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) →
      s ∈ (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) →
      r ≠ s →
      (∃ a : ℝ, (∀ z ∈ sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c, z.re ≠ a) ∧
        ((r.re < a ∧ a < s.re) ∨ (s.re < a ∧ a < r.re))) ∨
      (∃ a : ℝ, (∀ z ∈ sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c, z.im ≠ a) ∧
        ((r.im < a ∧ a < s.im) ∨ (s.im < a ∧ a < r.im))))
    (hnc : ∀ z ∈
      (↑(p.rootSet ℂ) : Set ℂ) ∪
        ({L + e * Complex.I, L - e * Complex.I} : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)) :
    n + 2 ∈ attainableNonConvexCounts (n + 2) := by
  apply attainable_of_degree_raise_canonical_anchor_package_auto_mem
    hp hpsep hdeg he hcop hc hreg
  · apply component_map_injOn_of_coordinate_line_separators
    · intro z hz
      exact degree_raise_canonical_anchors_mem_sublevel hp hc z hz
    · exact hsep
  · exact hnc

/-! A named certificate for the remaining geometric `n → n+2` step.  Keeping
    these fields in a structure makes the unresolved obligations explicit and
    lets later analytic lemmas construct the certificate incrementally. -/
structure DegreeRaiseCoordinateCertificate
    (p : ℂ[X]) (n : ℕ) (L e : ℂ) (c : ℝ) : Prop where
  monic : p.Monic
  separable : p.Separable
  degree : p.natDegree = n
  e_ne_zero : e ≠ 0
  coprime : IsCoprime p (Erdos1047DegreeRaise.raiseFactor L (e ^ 2))
  level_pos : 0 < c
  regular : Metric.closedBall (0 : ℂ) c ⊆
    ((Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval ''
      {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).derivative.eval u = 0})ᶜ
  separators : ∀ ⦃r s : ℂ⦄,
    r ∈ (↑(p.rootSet ℂ) : Set ℂ) ∪
      ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) →
    s ∈ (↑(p.rootSet ℂ) : Set ℂ) ∪
      ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) →
    r ≠ s →
    (∃ a : ℝ, (∀ z ∈ sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c, z.re ≠ a) ∧
      ((r.re < a ∧ a < s.re) ∨ (s.re < a ∧ a < r.re))) ∨
    (∃ a : ℝ, (∀ z ∈ sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c, z.im ≠ a) ∧
      ((r.im < a ∧ a < s.im) ∨ (s.im < a ∧ a < r.im)))
  nonconvex : ∀ z ∈
    (↑(p.rootSet ℂ) : Set ℂ) ∪
      ({L + e * Complex.I, L - e * Complex.I} : Set ℂ),
    ¬ Convex ℝ (connectedComponentIn
      (sublevelSet (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)

theorem attainable_of_degree_raise_coordinate_certificate
    {p : ℂ[X]} {n : ℕ} {L e : ℂ} {c : ℝ}
    (hcert : DegreeRaiseCoordinateCertificate p n L e c) :
    n + 2 ∈ attainableNonConvexCounts (n + 2) := by
  exact attainable_of_degree_raise_canonical_anchor_package_auto_mem_of_coordinate_separators
    hcert.monic hcert.separable hcert.degree hcert.e_ne_zero hcert.coprime
    hcert.level_pos hcert.regular hcert.separators hcert.nonconvex

/-! The quartic-gadget analogue of the canonical raising package.  It is
parameterized by the two finite anchor families so that the four transported
`p₄` witnesses can be supplied independently of the old-root family. -/
theorem attainable_of_quartic_raise_anchor_package
    {p : ℂ[X]} {n : ℕ} {L s : ℂ} {c : ℝ}
    (hp : p.Monic) (hpsep : p.Separable) (hdeg : p.natDegree = n)
    (hs : s ≠ 0)
    (hcop : IsCoprime p (Erdos1047QuarticRaise.quarticRaiseFactor L s))
    (hc : 0 < c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      ((Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval ''
        {u : ℂ | (Erdos1047QuarticRaise.quarticRaisePolynomial p L s).derivative.eval u = 0})ᶜ)
    {A B : Set ℂ} (hAfin : A.Finite) (hBfin : B.Finite)
    (hdisj : Disjoint A B) (hAcard : A.ncard = n) (hBcard : B.ncard = 4)
    (hmem : ∀ z ∈ A ∪ B,
      z ∈ sublevelSet (Erdos1047QuarticRaise.quarticRaisePolynomial p L s) c)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn
        (sublevelSet (Erdos1047QuarticRaise.quarticRaisePolynomial p L s) c) z)
      (A ∪ B))
    (hnc : ∀ z ∈ A ∪ B,
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet (Erdos1047QuarticRaise.quarticRaisePolynomial p L s) c) z)) :
    n + 4 ∈ attainableNonConvexCounts (n + 4) := by
  let q : ℂ[X] := Erdos1047QuarticRaise.quarticRaisePolynomial p L s
  have hqmonic : q.Monic := by
    dsimp [q]
    exact Erdos1047QuarticRaise.quarticRaisePolynomial_monic p L s hp
  have hqsep : q.Separable := by
    dsimp [q]
    exact Erdos1047QuarticRaise.quarticRaisePolynomial_separable p L s hpsep hs hcop
  have hqdeg : q.natDegree = n + 4 := by
    dsimp [q]
    rw [Erdos1047QuarticRaise.quarticRaisePolynomial_natDegree p L s hp, hdeg]
  apply attainable_of_disjoint_union_nonconvex_witnesses_of_regular_values
    (f := q) (a := n) (b := 4) hqmonic hqsep hqdeg (by omega) hc
  · simpa [q] using hreg
  · exact hAfin
  · exact hBfin
  · exact hdisj
  · exact hAcard
  · exact hBcard
  · simpa [q] using hmem
  · simpa [q] using hcompInj
  · simpa [q] using hnc

/-! Canonical quartic anchors: the old root set and the translated quartic
    factor root set.  Positivity makes membership automatic, while coprimality
    supplies the disjointness needed for the exact `n+4` count. -/
theorem attainable_of_quartic_raise_canonical_anchor_package_auto_mem
    {p : ℂ[X]} {n : ℕ} {L s : ℂ} {c : ℝ}
    (hp : p.Monic) (hpsep : p.Separable) (hdeg : p.natDegree = n)
    (hs : s ≠ 0)
    (hcop : IsCoprime p (Erdos1047QuarticRaise.quarticRaiseFactor L s))
    (hc : 0 < c)
    (hreg : Metric.closedBall (0 : ℂ) c ⊆
      ((Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval ''
        {u : ℂ | (Erdos1047QuarticRaise.quarticRaisePolynomial p L s).derivative.eval u = 0})ᶜ)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn
        (sublevelSet (Erdos1047QuarticRaise.quarticRaisePolynomial p L s) c) z)
      ((↑(p.rootSet ℂ) : Set ℂ) ∪
        (↑((Erdos1047QuarticRaise.quarticRaiseFactor L s).rootSet ℂ) : Set ℂ)))
    (hnc : ∀ z ∈
      (↑(p.rootSet ℂ) : Set ℂ) ∪
        (↑((Erdos1047QuarticRaise.quarticRaiseFactor L s).rootSet ℂ) : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet (Erdos1047QuarticRaise.quarticRaisePolynomial p L s) c) z)) :
    n + 4 ∈ attainableNonConvexCounts (n + 4) := by
  have hAcard : (↑(p.rootSet ℂ) : Set ℂ).ncard = n := by
    have hcard : Fintype.card (p.rootSet ℂ) = p.natDegree :=
      Polynomial.card_rootSet_eq_natDegree hpsep (IsAlgClosed.splits _)
    simpa [hdeg] using hcard
  have hBcard :
