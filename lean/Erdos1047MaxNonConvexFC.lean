section


/-!
# Subcritical strict quadratics

This file transports the strict Cassini component theorem through the affine
normal form of a monic quadratic.  It proves that every strict sublevel with
`0 < c < ‖criticalValue f‖` has only convex components.  The critical equality
is intentionally left separate.
-/

open Polynomial
open Set

namespace Erdos1047StrictQuadraticSubcritical

noncomputable section

open Erdos1047StrictQuadratic
open Erdos1047StrictCassini

theorem monic_quadratic_strictSublevel_eq_affine_cassini
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ)
    (hq : criticalValue f ≠ 0) {d : ℂ} (hd0 : d ≠ 0)
    (hd : d ^ 2 = -criticalValue f) :
    Erdos1047.strictSublevelSet f c =
      Erdos1047Quadratic.complexAffineImage (center f) d
        (strictCassiniSublevel (c / ‖criticalValue f‖)) := by
  have hqnorm : 0 < ‖criticalValue f‖ := norm_pos_iff.mpr hq
  ext z
  constructor
  · intro hz
    change ‖f.eval z‖ < c at hz
    let w := (z - center f) / d
    refine ⟨w, ?_, ?_⟩
    · change ‖w ^ 2 - 1‖ < c / ‖criticalValue f‖
      have heval : f.eval z = -(criticalValue f) * (w ^ 2 - 1) := by
        have hzrepr : center f + d * w = z := by
          dsimp [w]
          field_simp
          ring
        rw [← hzrepr]
        exact monic_quadratic_eval_center_add f hf hdeg (d * w) |>.trans (by
          rw [mul_pow, hd]
          ring)
      rw [heval, norm_mul, norm_neg] at hz
      exact (lt_div_iff₀ hqnorm).mpr (by simpa [mul_comm] using hz)
    · dsimp [w]
      field_simp
      ring
  · rintro ⟨w, hw, rfl⟩
    change ‖f.eval (center f + d * w)‖ < c
    have heval : f.eval (center f + d * w) =
        -(criticalValue f) * (w ^ 2 - 1) := by
      rw [monic_quadratic_eval_center_add f hf hdeg]
      rw [mul_pow, hd]
      ring
    rw [heval, norm_mul, norm_neg]
    simpa [mul_comm] using (lt_div_iff₀ hqnorm).mp hw

theorem strict_affineCassini_components_convex {h d : ℂ} (hd : d ≠ 0)
    {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ ≤ 1) :
    ∀ t ∈ Erdos1047.componentsIn
    (Erdos1047Quadratic.complexAffineImage h d (strictCassiniSublevel ρ)), Convex ℝ t := by
  rintro _ ⟨z, hz, rfl⟩
  obtain ⟨w, hw, rfl⟩ := hz
  have hwne : w.re ≠ 0 := strictCassini_re_ne_zero hρ hρ1 hw
  let φ : ℂ → ℝ := fun z => ((z - h) / d).re
  have hφ : Continuous φ := by
    dsimp [φ]
    fun_prop
  have hφzero : ∀ z ∈ Erdos1047Quadratic.complexAffineImage h d (strictCassiniSublevel ρ),
      φ z ≠ 0 := by
    rintro _ ⟨u, hu, rfl⟩
    have hcoord := Erdos1047Quadratic.affineCoordinate_apply (h := h) (d := d) (w := u) hd
    dsimp [φ]
    rw [hcoord]
    exact strictCassini_re_ne_zero hρ hρ1 hu
  rcases lt_or_gt_of_ne hwne with hwneg | hwpos
  · let L := Erdos1047Quadratic.complexAffineImage h d (strictCassiniLeftSublevel ρ)
    have hanchor : h + d * w ∈ L :=
      ⟨w, ⟨hw, hwneg.le⟩, rfl⟩
    have hLconv : Convex ℝ L := Erdos1047Quadratic.complexAffineImage_convex
      (strictCassiniLeftSublevel_convex_of_le_one hρ hρ1)
    have hLsub : L ⊆ Erdos1047Quadratic.complexAffineImage h d (strictCassiniSublevel ρ) := by
      rintro _ ⟨u, hu, rfl⟩
      exact ⟨u, hu.1, rfl⟩
    have hstart : φ (h + d * w) < 0 := by
      dsimp [φ]
      rw [Erdos1047Quadratic.affineCoordinate_apply hd]
      exact hwneg
    have hstay := Erdos1047Quadratic.negative_on_component hφ hφzero
      ⟨w, hw, rfl⟩ hstart
    have heq : connectedComponentIn
        (Erdos1047Quadratic.complexAffineImage h d (strictCassiniSublevel ρ)) (h + d * w) = L := by
      apply Set.Subset.antisymm
      · intro z hzC
        have hzS := connectedComponentIn_subset _ _ hzC
        obtain ⟨u, hu, rfl⟩ := hzS
        refine ⟨u, ⟨hu, ?_⟩, rfl⟩
        have huφ := hstay (h + d * u) hzC
        dsimp [φ] at huφ
        rw [Erdos1047Quadratic.affineCoordinate_apply hd] at huφ
        exact huφ.le
      · exact hLconv.isPreconnected.subset_connectedComponentIn hanchor hLsub
    rw [heq]
    exact hLconv
  · let R := Erdos1047Quadratic.complexAffineImage h d (strictCassiniRightSublevel ρ)
    have hanchor : h + d * w ∈ R :=
      ⟨w, ⟨hw, hwpos.le⟩, rfl⟩
    have hRconv : Convex ℝ R := Erdos1047Quadratic.complexAffineImage_convex
      (strictCassiniRightSublevel_convex_of_le_one hρ hρ1)
    have hRsub : R ⊆ Erdos1047Quadratic.complexAffineImage h d (strictCassiniSublevel ρ) := by
      rintro _ ⟨u, hu, rfl⟩
      exact ⟨u, hu.1, rfl⟩
    have hstart : -φ (h + d * w) < 0 := by
      dsimp [φ]
      rw [Erdos1047Quadratic.affineCoordinate_apply hd]
      linarith
    have hstay := Erdos1047Quadratic.negative_on_component
        (S := Erdos1047Quadratic.complexAffineImage h d (strictCassiniSublevel ρ))
      (r := h + d * w) (φ := fun z => -φ z) hφ.neg
      (fun z hzS hzero => hφzero z hzS (by linarith))
      ⟨w, hw, rfl⟩ hstart
    have heq : connectedComponentIn
        (Erdos1047Quadratic.complexAffineImage h d (strictCassiniSublevel ρ)) (h + d * w) = R := by
      apply Set.Subset.antisymm
      · intro z hzC
        have hzS := connectedComponentIn_subset _ _ hzC
        obtain ⟨u, hu, rfl⟩ := hzS
        refine ⟨u, ⟨hu, ?_⟩, rfl⟩
        have huφ := hstay (h + d * u) hzC
        dsimp [φ] at huφ
        rw [Erdos1047Quadratic.affineCoordinate_apply hd] at huφ
        linarith
      · exact hRconv.isPreconnected.subset_connectedComponentIn hanchor hRsub
    rw [heq]
    exact hRconv

theorem monic_quadratic_strictSublevel_components_convex_of_subcritical
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ)
    (hc : 0 < c) (hq : criticalValue f ≠ 0)
    (hcritical : c < ‖criticalValue f‖) :
    ∀ t ∈ Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c),
      Convex ℝ t := by
  obtain ⟨d, hd0, hd⟩ := Erdos1047Quadratic.exists_quadratic_scale
    (criticalValue f) hq
  have hqnorm : 0 < ‖criticalValue f‖ := norm_pos_iff.mpr hq
  have hρ : 0 < c / ‖criticalValue f‖ := div_pos hc hqnorm
  have hρ1 : c / ‖criticalValue f‖ < 1 :=
    (div_lt_one hqnorm).mpr hcritical
  rw [monic_quadratic_strictSublevel_eq_affine_cassini f hf hdeg c hq hd0 hd]
  exact strict_affineCassini_components_convex hd0 hρ hρ1.le

theorem monic_quadratic_strictSublevel_components_convex_of_critical_level
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ)
    (hc : 0 < c) (hq : criticalValue f ≠ 0)
    (hcritical : c = ‖criticalValue f‖) :
    ∀ t ∈ Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c),
      Convex ℝ t := by
  obtain ⟨d, hd0, hd⟩ := Erdos1047Quadratic.exists_quadratic_scale
    (criticalValue f) hq
  have hqnorm : 0 < ‖criticalValue f‖ := norm_pos_iff.mpr hq
  have hρ : c / ‖criticalValue f‖ = 1 := by
    rw [hcritical, div_self hqnorm.ne']
  rw [monic_quadratic_strictSublevel_eq_affine_cassini f hf hdeg c hq hd0 hd]
  rw [hρ]
  exact strict_affineCassini_components_convex hd0 one_pos le_rfl

theorem monic_quadratic_strictSublevel_nonconvex_ncard_eq_zero_of_subcritical
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ)
    (hc : 0 < c) (hq : criticalValue f ≠ 0)
    (hcritical : c < ‖criticalValue f‖) :
    {t ∈ Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) |
      ¬ Convex ℝ t}.ncard = 0 := by
  have hall := monic_quadratic_strictSublevel_components_convex_of_subcritical
    f hf hdeg c hc hq hcritical
  have hempty : {t ∈ Erdos1047.componentsIn
      (Erdos1047.strictSublevelSet f c) | ¬ Convex ℝ t} = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    rintro t ⟨ht, hnc⟩
    exact hnc (hall t ht)
  rw [hempty]
  simp

#print axioms strict_affineCassini_components_convex
#print axioms monic_quadratic_strictSublevel_components_convex_of_critical_level
#print axioms monic_quadratic_strictSublevel_nonconvex_ncard_eq_zero_of_subcritical

end
