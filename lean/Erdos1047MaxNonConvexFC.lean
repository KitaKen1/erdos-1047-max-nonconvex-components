/-! A small sign bridge used by the local curvature argument.  Once the
    three Taylor coefficients are known to be positive real numbers, their
    curvature ratio has positive real part. -/
theorem re_mul_sq_div_cube_pos_of_real_pos
    {v a b : ℂ}
    (hv : 0 < v.re) (ha : 0 < a.re) (hb : 0 < b.re)
    (hvim : v.im = 0) (haim : a.im = 0) (hbim : b.im = 0) :
    0 < (v * b ^ 2 / a ^ 3).re := by
  have hv_eq : v = (v.re : ℂ) := by
    apply Complex.ext <;> simp [hvim]
  have ha_eq : a = (a.re : ℂ) := by
    apply Complex.ext <;> simp [haim]
  have hb_eq : b = (b.re : ℂ) := by
    apply Complex.ext <;> simp [hbim]
  rw [hv_eq, ha_eq, hb_eq]
  norm_num [Complex.div_re, Complex.mul_re, Complex.mul_im,
    Complex.ofReal_re, Complex.ofReal_im, pow_two]
  have hbsq : 0 < b.re * b.re := mul_pos hb hb
  have hnum : 0 < v.re * (b.re * b.re) := mul_pos hv hbsq
  have hpow_re : ((a.re : ℂ) ^ 3).re = a.re ^ 3 := by
    rw [← Complex.ofReal_pow]
    exact Complex.ofReal_re _
  rw [hpow_re]
  have hnum' : 0 < v.re * (b.re * b.re) * a.re ^ 3 :=
    mul_pos hnum (pow_pos ha 3)
  exact div_pos hnum' (pow_pos (mul_pos ha ha) 3)

/-! The usual real tuning parameters are separated from the complex
    polynomial bookkeeping.  The single inequality below is exactly the
    condition that the tuned quadratic has a non-real conjugate pair of roots:
    `d = v/a` and `A = -bv/a²` give `A²/4 < d` whenever `v b² < 4a³`. -/
theorem real_tuned_discriminant_pos
    {a b v : ℝ} (ha : 0 < a) (hv : 0 < v)
    (hsmall : v * b ^ 2 < 4 * a ^ 3) :
    (-(b * v / a ^ 2)) ^ 2 / 4 < v / a := by
  have ha0 : a ≠ 0 := ne_of_gt ha
  have ha2 : 0 < a ^ 2 := sq_pos_of_pos ha
  have ha3 : 0 < a ^ 3 := pow_pos ha 3
  field_simp [ha0]
  nlinarith

/-! A target-ready wrapper for the real tuning used in the degree-raising
    construction.  The value and derivative hypotheses are intentionally
    explicit: all analytic growth estimates can be supplied later, while this
    lemma closes the exact center value, critical-point equation, and
    non-real-root discriminant in one kernel-checked step. -/
theorem tunedRaise_center_data_of_real_parameters
    {p : ℂ[X]} {L a b v : ℝ}
    (hval : p.eval (L : ℂ) = (a : ℂ))
    (hderiv : p.derivative.eval (L : ℂ) = (b : ℂ))
    (ha : 0 < a) (hv : 0 < v)
    (hsmall : v * b ^ 2 < 4 * a ^ 3) :
    let d : ℝ := v / a
    let A : ℝ := -(b * v / a ^ 2)
    (tunedRaisePolynomial p (L : ℂ) (A : ℂ) (d : ℂ)).eval (L : ℂ) = (v : ℂ) ∧
      (tunedRaisePolynomial p (L : ℂ) (A : ℂ) (d : ℂ)).derivative.eval (L : ℂ) = 0 ∧
      A ^ 2 / 4 < d := by
  dsimp
  have ha0 : (a : ℂ) ≠ 0 := by
    exact_mod_cast (ne_of_gt ha)
  have hpL0 : p.eval (L : ℂ) ≠ 0 := by
    rw [hval]
    exact_mod_cast (ne_of_gt ha)
  have hslope :
      tunedRaiseSlope p (L : ℂ) ((v / a : ℝ) : ℂ) =
        ((-(b * v / a ^ 2) : ℝ) : ℂ) := by
    unfold tunedRaiseSlope
    rw [hval, hderiv]
    norm_num [div_eq_mul_inv]
    field_simp [ha0]
  have hcenter_value := tunedRaisePolynomial_eval_center p (L : ℂ)
    (tunedRaiseSlope p (L : ℂ) ((v / a : ℝ) : ℂ)) ((v / a : ℝ) : ℂ)
  have hcenter_derivative := tunedRaisePolynomial_derivative_eval_center_of_slope
    p (L : ℂ) ((v / a : ℝ) : ℂ) hpL0
  have hvalue :
      (tunedRaisePolynomial p (L : ℂ)
        ((-(b * v / a ^ 2) : ℝ) : ℂ) ((v / a : ℝ) : ℂ)).eval (L : ℂ) =
        (v : ℂ) := by
    rw [← hslope, hcenter_value, hval]
    have hreal : a * (v / a) = v := by
      field_simp [ne_of_gt ha]
    exact_mod_cast hreal
  have hcritical :
      (tunedRaisePolynomial p (L : ℂ)
        ((-(b * v / a ^ 2) : ℝ) : ℂ) ((v / a : ℝ) : ℂ)).derivative.eval (L : ℂ) =
        0 := by
    rw [← hslope]
    exact hcenter_derivative
  exact ⟨hvalue, hcritical,
    real_tuned_discriminant_pos ha hv hsmall⟩

/-! On a left half-line, a nonpositive real tuning slope only improves the
    real-part lower bound.  This is the barrier estimate needed when the
    prescribed critical point is made exact by the linear correction `A`. -/
theorem tunedRaiseFactor_re_ge_sq_sub_on_left_halfline
    {L A d a x : ℝ} (hL : 0 ≤ L) (hA : A ≤ 0) (hd : 0 ≤ d)
    (hx : x ≤ 0) :
    L ^ 2 - a ^ 2 ≤
      ((tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval
        ((x : ℂ) + (a : ℂ) * Complex.I)).re := by
  rw [tunedRaiseFactor_eval]
  have hxl : x - L ≤ 0 := by linarith
  have hsq : L ^ 2 ≤ (x - L) ^ 2 := by
    have hprod : x * L ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hx hL
    have hprod' : 0 ≤ -(x * L) := by linarith
    nlinarith
  have hAt : 0 ≤ A * (x - L) :=
    mul_nonneg_of_nonpos_of_nonpos hA hxl
  have hformula :
      (((x : ℂ) + (a : ℂ) * Complex.I - (L : ℂ)) ^ 2 +
        (A : ℂ) * ((x : ℂ) + (a : ℂ) * Complex.I - (L : ℂ)) +
        (d : ℂ)).re =
        (x - L) ^ 2 - a ^ 2 + A * (x - L) + d := by
    norm_num [Complex.sub_re, Complex.sub_im, Complex.mul_re,
      Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im, pow_two]
  rw [hformula]
  nlinarith

/-! A root parameterization for the tuned quadratic.  It avoids choosing a
    global complex square-root branch: any `w` satisfying
    `w² = A²/4 - d` gives the two roots explicitly. -/
theorem tunedRaiseFactor_eval_factorization
    {L A d w z : ℂ} (hw : w ^ 2 = A ^ 2 / 4 - d) :
    (tunedRaiseFactor L A d).eval z =
      (z - (L - A / 2 + w)) * (z - (L - A / 2 - w)) := by
  rw [tunedRaiseFactor_eval]
  calc
    (z - L) ^ 2 + A * (z - L) + d =
        (z - L) ^ 2 + A * (z - L) + A ^ 2 / 4 - w ^ 2 := by
          rw [hw]
          ring
    _ = (z - (L - A / 2 + w)) * (z - (L - A / 2 - w)) := by
          ring

theorem tunedRaiseFactor_eval_eq_zero_iff
    {L A d w z : ℂ} (hw : w ^ 2 = A ^ 2 / 4 - d) :
    (tunedRaiseFactor L A d).eval z = 0 ↔
      z = L - A / 2 + w ∨ z = L - A / 2 - w := by
  rw [tunedRaiseFactor_eval_factorization hw, mul_eq_zero]
  simp only [sub_eq_zero]

/-! Coprimality adapter for the tuned quadratic.  As in the untuned raise
    core, over `ℂ` it is enough to rule out a common evaluation root. -/
theorem tunedRaiseFactor_coprime_of_no_common_root
    (p : ℂ[X]) (L A d : ℂ)
    (hno : ∀ z : ℂ, p.eval z = 0 →
      (tunedRaiseFactor L A d).eval z ≠ 0) :
    IsCoprime p (tunedRaiseFactor L A d) := by
  rw [Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed (k := ℂ)
    ℂ p (tunedRaiseFactor L A d)]
  change ∀ z : ℂ, p.eval z ≠ 0 ∨ (tunedRaiseFactor L A d).eval z ≠ 0
  intro z
  by_cases hpz : p.eval z = 0
  · exact Or.inr (hno z hpz)
  · exact Or.inl hpz

/-! When the real discriminant is negative, the two roots have explicit
    conjugate imaginary coordinates.  This is the coordinate form used by
    the geometric separator arguments; the proof is only the square-root
    identity and the factorization above. -/
theorem tunedRaiseFactor_complex_root_coordinates_of_real_disc_pos
    {L A d : ℝ} (hdisc : A ^ 2 / 4 < d) :
    let q : ℝ := Real.sqrt (d - A ^ 2 / 4)
    let rPlus : ℂ := (L - A / 2 : ℂ) + (q : ℂ) * Complex.I
    let rMinus : ℂ := (L - A / 2 : ℂ) - (q : ℂ) * Complex.I
    (tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval rPlus = 0 ∧
      (tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval rMinus = 0 ∧
      rPlus ≠ rMinus := by
  dsimp
  have hnonneg : 0 ≤ d - A ^ 2 / 4 := by linarith
  have hqpos : 0 < Real.sqrt (d - A ^ 2 / 4) :=
    Real.sqrt_pos.2 (by linarith)
  have hq2 : (Real.sqrt (d - A ^ 2 / 4)) ^ 2 = d - A ^ 2 / 4 :=
    Real.sq_sqrt hnonneg
  let w : ℂ := (Real.sqrt (d - A ^ 2 / 4) : ℂ) * Complex.I
  have hw : w ^ 2 = (A : ℂ) ^ 2 / 4 - (d : ℂ) := by
    dsimp [w]
    apply Complex.ext <;>
      norm_num [Complex.mul_re, Complex.mul_im, Complex.ofReal_re,
        Complex.ofReal_im, Complex.I_re, Complex.I_im, pow_two]
    · have hq2' : Real.sqrt (d - A * A / 4) *
          Real.sqrt (d - A * A / 4) = d - A * A / 4 := by
        simpa [pow_two] using hq2
      nlinarith [hq2']
  have hplus :
      (tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval
          ((L - A / 2 : ℂ) + w) = 0 := by
    rw [(tunedRaiseFactor_eval_eq_zero_iff hw)]
    exact Or.inl rfl
  have hminus :
      (tunedRaiseFactor (L : ℂ) (A : ℂ) (d : ℂ)).eval
          ((L - A / 2 : ℂ) - w) = 0 := by
    rw [(tunedRaiseFactor_eval_eq_zero_iff hw)]
    exact Or.inr rfl
  have hne :
      (L - A / 2 : ℂ) + w ≠ (L - A / 2 : ℂ) - w := by
    intro h
    have hwzero : w = 0 := by
      apply mul_left_cancel₀ (show (2 : ℂ) ≠ 0 by norm_num)
      linear_combination h
    apply (show w ≠ 0 by
      dsimp [w]
      apply mul_ne_zero
      · exact_mod_cast (ne_of_gt hqpos)
      · exact Complex.I_ne_zero) hwzero
  simpa [w] using And.intro hplus (And.intro hminus hne)

/-! On the imaginary axis the tuned factor is a quadratic polynomial in
    `y²`.  The two displayed sign conditions make its squared norm attain its
    lower bound at `y = 0`; this is the vertical barrier used to keep the old
    left and new right regions apart. -/
theorem tunedRaiseFactor_normSq_on_imaginary_axis
    {L A d y : ℝ}
    (hB : 0 ≤ L ^ 2 - A * L + d)
    (hC : 0 ≤ 2 * L ^ 2 - 2 * A * L + A ^ 2 - 2 * d) :
    (L ^ 2 - A * L + d) ^ 2 ≤
      Complex.normSq
        (((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 +
          (A : ℂ) * ((y : ℂ) * Complex.I - (L : ℂ)) + (d : ℂ)) := by
  norm_num [Complex.normSq_apply, Complex.mul_re, Complex.mul_im,
    Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im,
    pow_succ]
  nlinarith [sq_nonneg (y ^ 2)]

/-! A compact certificate: the tuned center keeps the chosen level value and
    is simultaneously a critical point. -/
theorem tunedRaisePolynomial_center_certificate
    (p : ℂ[X]) (L d : ℂ) (hpL : p.eval L ≠ 0) :
    (tunedRaisePolynomial p L (tunedRaiseSlope p L d) d).eval L = p.eval L * d ∧
      (tunedRaisePolynomial p L (tunedRaiseSlope p L d) d).derivative.eval L = 0 := by
  constructor
  · exact tunedRaisePolynomial_eval_center p L (tunedRaiseSlope p L d) d
  · exact tunedRaisePolynomial_derivative_eval_center_of_slope p L d hpL

/-! A nonzero value at the chosen center always permits a nonzero tuning
    parameter whose quadratic discriminant is nonzero.  The derivative-zero
    branch takes `d = 1`; otherwise `d = 2 p(L)^2/p'(L)^2`, for which the
    discriminant reduces to a nonzero multiple of `p(L)^2/p'(L)^2`. -/
theorem exists_tuned_parameter_center_separable
    (p : ℂ[X]) (L : ℂ) (hpL : p.eval L ≠ 0) :
    ∃ d : ℂ, d ≠ 0 ∧
      d - (tunedRaiseSlope p L d) ^ 2 / 4 ≠ 0 := by
  by_cases hp' : p.derivative.eval L = 0
  · have h1 : (1 : ℂ) ≠ 0 := by norm_num
    refine ⟨(1 : ℂ), h1, ?_⟩
    simp [tunedRaiseSlope, hp']
  · let d : ℂ := 2 * (p.eval L) ^ 2 / (p.derivative.eval L) ^ 2
    have hp'0 : p.derivative.eval L ≠ 0 := hp'
    have hd : d ≠ 0 := by
      dsimp [d]
      exact div_ne_zero (mul_ne_zero (by norm_num) (pow_ne_zero 2 hpL))
        (pow_ne_zero 2 hp'0)
    refine ⟨d, hd, ?_⟩
    have hslope : tunedRaiseSlope p L d =
        -2 * p.eval L / p.derivative.eval L := by
      dsimp [tunedRaiseSlope, d]
      field_simp [hpL, hp'0]
    rw [hslope]
    have hrewrite : d -
        (-2 * p.eval L / p.derivative.eval L) ^ 2 / 4 =
        (p.eval L) ^ 2 / (p.derivative.eval L) ^ 2 := by
      dsimp [d]
      field_simp [hpL, hp'0]
      ring
    rw [hrewrite]
    exact div_ne_zero (pow_ne_zero 2 hpL) (pow_ne_zero 2 hp'0)

end
end Erdos1047TunedRaise

