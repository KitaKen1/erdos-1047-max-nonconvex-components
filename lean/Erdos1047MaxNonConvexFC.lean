    norm_num [polynomial, anchor, pointA, level, bernsteinCoeffA,
      Erdos1047EvenFamily.evenFamilyPolynomial, Complex.normSq,
      pow_succ, Complex.mul_re, Complex.mul_im, Fin.sum_univ_succ]
    ring
  rw [← sub_neg, hid]
  apply bernstein16_neg bernsteinCoeffA t ht0 ht1
  intro i
  fin_cases i <;> norm_num [bernsteinCoeffA]

theorem lineB_normSq (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    Complex.normSq
        (polynomial.eval (anchor + (t : ℂ) * (pointB - anchor))) < level ^ 2 := by
