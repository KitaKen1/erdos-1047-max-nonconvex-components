    rw [derivative_mul]
  have hP2 : (tunedRaisePolynomial p L A d).derivative.derivative =
      p.derivative.derivative * tunedRaiseFactor L A d +
        p.derivative * (tunedRaiseFactor L A d).derivative +
        p.derivative * (tunedRaiseFactor L A d).derivative +
        p * (tunedRaiseFactor L A d).derivative.derivative := by
