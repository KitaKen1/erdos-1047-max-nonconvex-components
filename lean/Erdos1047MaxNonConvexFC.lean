open Polynomial

namespace Erdos1047CubicLower

noncomputable section

def sublevelSet (f : ℂ[X]) (c : ℝ) : Set ℂ :=
  {z : ℂ | ‖f.eval z‖ ≤ c}

def componentsIn (s : Set ℂ) : Set (Set ℂ) :=
  {t : Set ℂ | ∃ z ∈ s, t = connectedComponentIn s z}

theorem component_not_convex_of_segments {S : Set ℂ} {r a b : ℂ}
    (ha : segment ℝ r a ⊆ S) (hb : segment ℝ r b ⊆ S)
    (hm : midpoint ℝ a b ∉ S) :
    ¬ Convex ℝ (connectedComponentIn S r) := by
  have haC : a ∈ connectedComponentIn S r :=
    ((convex_segment r a).isPreconnected.subset_connectedComponentIn
      (left_mem_segment ℝ r a) ha) (right_mem_segment ℝ r a)
  have hbC : b ∈ connectedComponentIn S r :=
    ((convex_segment r b).isPreconnected.subset_connectedComponentIn
      (left_mem_segment ℝ r b) hb) (right_mem_segment ℝ r b)
  intro hc
  exact hm (connectedComponentIn_subset S r (hc.midpoint_mem haC hbC))

theorem segment_strict_of_parametric_normSq_lt
    {F : ℂ → ℂ} {c : ℝ} {r a : ℂ} (hc : 0 ≤ c)
    (h : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
      Complex.normSq (F (r + (t : ℂ) * (a - r))) < c ^ 2) :
    ∀ z ∈ segment ℝ r a, ‖F z‖ < c := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hv1 : v ≤ 1 := by linarith
  have hparam : u • r + v • a = r + (v : ℂ) * (a - r) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination r * huv'
  rw [hparam]
  have hs := h v hv hv1
  rw [Complex.normSq_eq_norm_sq] at hs
  nlinarith [norm_nonneg (F (r + (v : ℂ) * (a - r)))]

theorem negative_on_component {S : Set ℂ} {r : ℂ} {φ : ℂ → ℝ}
    (hφ : Continuous φ) (hzero : ∀ z ∈ S, φ z ≠ 0) (hr : r ∈ S) (hneg : φ r < 0) :
    ∀ z ∈ connectedComponentIn S r, φ z < 0 := by
  intro z hz
  by_contra hnonneg
  obtain ⟨w, hw, hwzero⟩ :=
    isPreconnected_connectedComponentIn.intermediate_value
      (mem_connectedComponentIn hr) hz hφ.continuousOn
      (show (0 : ℝ) ∈ Set.Icc (φ r) (φ z) from ⟨hneg.le, le_of_not_gt hnonneg⟩)
  exact hzero w (connectedComponentIn_subset S r hw) hwzero

theorem positive_on_preconnected {S : Set ℂ} {r : ℂ} {φ : ℂ → ℝ}
    (hS : IsPreconnected S) (hφ : Continuous φ) (hzero : ∀ z ∈ S, φ z ≠ 0)
    (hr : r ∈ S) (hpos : 0 < φ r) : ∀ z ∈ S, 0 < φ z := by
  intro z hz
  by_contra hnonpos
  obtain ⟨w, hw, hwzero⟩ :=
    hS.intermediate_value hz hr hφ.continuousOn
      (show (0 : ℝ) ∈ Set.Icc (φ z) (φ r) from ⟨le_of_not_gt hnonpos, hpos.le⟩)
  exact hzero w hw hwzero

def p3Polynomial : ℂ[X] := X ^ 3 - C 3 * X + C 3

def p3Level : ℝ := 999999 / 1000000

def p3LowerAnchor : ℂ := 1 - (1 / 2 : ℂ) * Complex.I

def p3LowerPointA : ℂ :=
  (1016384 / 1000000 : ℂ) - (16319 / 1000000 : ℂ) * Complex.I

def p3LowerPointB : ℂ :=
  (1010098 / 1000000 : ℂ) - (10084 / 1000000 : ℂ) * Complex.I

def p3LeftAnchor : ℂ := -21 / 10

/-- Nonpositive Bernstein coefficients give a nonpositive degree-six polynomial
on the unit interval. -/
theorem bernstein6_nonpos (t c0 c1 c2 c3 c4 c5 c6 : ℝ)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hc0 : c0 ≤ 0) (hc1 : c1 ≤ 0) (hc2 : c2 ≤ 0) (hc3 : c3 ≤ 0)
    (hc4 : c4 ≤ 0) (hc5 : c5 ≤ 0) (hc6 : c6 ≤ 0) :
    c0 * t ^ 0 * (1 - t) ^ 6 + c1 * t ^ 1 * (1 - t) ^ 5 +
      c2 * t ^ 2 * (1 - t) ^ 4 + c3 * t ^ 3 * (1 - t) ^ 3 +
      c4 * t ^ 4 * (1 - t) ^ 2 + c5 * t ^ 5 * (1 - t) ^ 1 +
      c6 * t ^ 6 * (1 - t) ^ 0 ≤ 0 := by
  have hsub : 0 ≤ 1 - t := by linarith
  have h0 := mul_nonpos_of_nonpos_of_nonneg hc0
    (mul_nonneg (pow_nonneg ht0 0) (pow_nonneg hsub 6))
  have h1 := mul_nonpos_of_nonpos_of_nonneg hc1
    (mul_nonneg (pow_nonneg ht0 1) (pow_nonneg hsub 5))
  have h2 := mul_nonpos_of_nonpos_of_nonneg hc2
    (mul_nonneg (pow_nonneg ht0 2) (pow_nonneg hsub 4))
  have h3 := mul_nonpos_of_nonpos_of_nonneg hc3
    (mul_nonneg (pow_nonneg ht0 3) (pow_nonneg hsub 3))
  have h4 := mul_nonpos_of_nonpos_of_nonneg hc4
    (mul_nonneg (pow_nonneg ht0 4) (pow_nonneg hsub 2))
  have h5 := mul_nonpos_of_nonpos_of_nonneg hc5
    (mul_nonneg (pow_nonneg ht0 5) (pow_nonneg hsub 1))
  have h6 := mul_nonpos_of_nonpos_of_nonneg hc6
    (mul_nonneg (pow_nonneg ht0 6) (pow_nonneg hsub 0))
  nlinarith

theorem bernstein6_neg (t c0 c1 c2 c3 c4 c5 c6 : ℝ)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hc0 : c0 < 0) (hc1 : c1 ≤ 0) (hc2 : c2 ≤ 0) (hc3 : c3 ≤ 0)
    (hc4 : c4 ≤ 0) (hc5 : c5 ≤ 0) (hc6 : c6 < 0) :
    c0 * t ^ 0 * (1 - t) ^ 6 + c1 * t ^ 1 * (1 - t) ^ 5 +
      c2 * t ^ 2 * (1 - t) ^ 4 + c3 * t ^ 3 * (1 - t) ^ 3 +
      c4 * t ^ 4 * (1 - t) ^ 2 + c5 * t ^ 5 * (1 - t) ^ 1 +
      c6 * t ^ 6 * (1 - t) ^ 0 < 0 := by
  by_cases ht : t < 1
  · have hrest := bernstein6_nonpos t 0 c1 c2 c3 c4 c5 c6 ht0 ht1
      (le_refl 0) hc1 hc2 hc3 hc4 hc5 hc6.le
    have hfirst : c0 * t ^ 0 * (1 - t) ^ 6 < 0 := by
      simpa using mul_neg_of_neg_of_pos hc0 (show 0 < (1 - t) ^ 6 by positivity)
    nlinarith
  · have ht' : t = 1 := le_antisymm ht1 (le_of_not_gt ht)
    simpa [ht'] using hc6

theorem p3Lower_lineA_normSq (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    Complex.normSq (p3Polynomial.eval
      (p3LowerAnchor + (t : ℂ) * (p3LowerPointA - p3LowerAnchor))) <
      p3Level ^ 2 := by
  have hid :
      Complex.normSq (p3Polynomial.eval
        (p3LowerAnchor + (t : ℂ) * (p3LowerPointA - p3LowerAnchor))) -
        p3Level ^ 2 =
      (-921873000001 / 1000000000000 : ℝ) * t ^ 0 * (1-t) ^ 6 +
      (-2457419343753 / 500000000000 : ℝ) * t ^ 1 * (1-t) ^ 5 +
      (-139928403503337 / 16000000000000 : ℝ) * t ^ 2 * (1-t) ^ 4 +
      (-13163760330879511401 / 2000000000000000000 : ℝ) * t ^ 3 * (1-t) ^ 3 +
      (-7663262415723420575289549 / 4000000000000000000000000 : ℝ) * t ^ 4 * (1-t) ^ 2 +
      (-99343373882819367163139496771 / 1000000000000000000000000000000 : ℝ) * t ^ 5 * (1-t) ^ 1 +
      (-27217518133079002494836866687 / 1000000000000000000000000000000000000 : ℝ) * t ^ 6 * (1-t) ^ 0 := by
    norm_num [p3Polynomial, p3Level, p3LowerAnchor, p3LowerPointA,
      Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
    ring
  rw [← sub_neg, hid]
  exact bernstein6_neg t _ _ _ _ _ _ _ ht0 ht1
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num)

theorem p3Lower_lineB_normSq (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    Complex.normSq (p3Polynomial.eval
      (p3LowerAnchor + (t : ℂ) * (p3LowerPointB - p3LowerAnchor))) <
      p3Level ^ 2 := by
  have hid :
      Complex.normSq (p3Polynomial.eval
        (p3LowerAnchor + (t : ℂ) * (p3LowerPointB - p3LowerAnchor))) -
        p3Level ^ 2 =
      (-921873000001 / 1000000000000 : ℝ) * t ^ 0 * (1-t) ^ 6 +
      (-2449791750003 / 500000000000 : ℝ) * t ^ 1 * (1-t) ^ 5 +
      (-34514967800133 / 4000000000000 : ℝ) * t ^ 2 * (1-t) ^ 4 +
      (-198776720762388681 / 31250000000000000 : ℝ) * t ^ 3 * (1-t) ^ 3 +
      (-87852471234003997327629 / 50000000000000000000000 : ℝ) * t ^ 4 * (1-t) ^ 2 +
      (-3816907989857642596836081 / 62500000000000000000000000 : ℝ) * t ^ 5 * (1-t) ^ 1 +
      (-3818064149198948875996463 / 125000000000000000000000000000000 : ℝ) * t ^ 6 * (1-t) ^ 0 := by
    norm_num [p3Polynomial, p3Level, p3LowerAnchor, p3LowerPointB,
      Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
    ring
  rw [← sub_neg, hid]
  exact bernstein6_neg t _ _ _ _ _ _ _ ht0 ht1
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num)

theorem p3Lower_lineA_strict :
    ∀ z ∈ segment ℝ p3LowerAnchor p3LowerPointA,
      ‖p3Polynomial.eval z‖ < p3Level :=
  segment_strict_of_parametric_normSq_lt (by norm_num [p3Level]) p3Lower_lineA_normSq

theorem p3Lower_lineB_strict :
    ∀ z ∈ segment ℝ p3LowerAnchor p3LowerPointB,
      ‖p3Polynomial.eval z‖ < p3Level :=
  segment_strict_of_parametric_normSq_lt (by norm_num [p3Level]) p3Lower_lineB_normSq

theorem p3Lower_midpoint_norm_gt :
    p3Level < ‖p3Polynomial.eval (midpoint ℝ p3LowerPointA p3LowerPointB)‖ := by
  have hgt : p3Level ^ 2 < Complex.normSq
      (p3Polynomial.eval (midpoint ℝ p3LowerPointA p3LowerPointB)) := by
    norm_num [p3Polynomial, p3Level, p3LowerPointA, p3LowerPointB,
      midpoint, AffineMap.lineMap_apply_module, Complex.normSq, pow_succ,
      Complex.mul_re, Complex.mul_im]
  rw [Complex.normSq_eq_norm_sq] at hgt
  have hc : 0 ≤ p3Level := by norm_num [p3Level]
  nlinarith [norm_nonneg
    (p3Polynomial.eval (midpoint ℝ p3LowerPointA p3LowerPointB))]

theorem p3Lower_component_not_convex :
    ¬ Convex ℝ (connectedComponentIn
      (sublevelSet p3Polynomial p3Level) p3LowerAnchor) := by
  apply component_not_convex_of_segments
  · intro z hz
    exact (p3Lower_lineA_strict z hz).le
  · intro z hz
    exact (p3Lower_lineB_strict z hz).le
  · intro hm
    exact (not_lt_of_ge hm) p3Lower_midpoint_norm_gt

theorem p3_eval_star (z : ℂ) :
    p3Polynomial.eval (star z) = star (p3Polynomial.eval z) := by
  simp [p3Polynomial]

theorem p3_mem_star_iff (z : ℂ) :
    star z ∈ sublevelSet p3Polynomial p3Level ↔
      z ∈ sublevelSet p3Polynomial p3Level := by
  simp only [sublevelSet, Set.mem_ofPred_eq, p3_eval_star, norm_star]

theorem p3_star_segment {r a : ℂ}
    (h : segment ℝ r a ⊆ sublevelSet p3Polynomial p3Level) :
    segment ℝ (star r) (star a) ⊆ sublevelSet p3Polynomial p3Level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  rw [show u • star r + v • star a = star (u • r + v • a) by simp]
  exact (p3_mem_star_iff _).2 (h ⟨u, v, hu, hv, huv, rfl⟩)

theorem p3_star_midpoint_outside {a b : ℂ}
    (h : midpoint ℝ a b ∉ sublevelSet p3Polynomial p3Level) :
    midpoint ℝ (star a) (star b) ∉ sublevelSet p3Polynomial p3Level := by
  intro hm
  apply h
  rw [← p3_mem_star_iff]
  convert hm using 1
  simp [midpoint, AffineMap.lineMap_apply_module]

theorem p3Lower_midpoint_outside :
    midpoint ℝ p3LowerPointA p3LowerPointB ∉
      sublevelSet p3Polynomial p3Level := by
  intro hm
  exact (not_lt_of_ge hm) p3Lower_midpoint_norm_gt

theorem p3Upper_component_not_convex :
    ¬ Convex ℝ (connectedComponentIn
      (sublevelSet p3Polynomial p3Level) (star p3LowerAnchor)) := by
  apply component_not_convex_of_segments
  · exact p3_star_segment (fun z hz => (p3Lower_lineA_strict z hz).le)
  · exact p3_star_segment (fun z hz => (p3Lower_lineB_strict z hz).le)
  · exact p3_star_midpoint_outside p3Lower_midpoint_outside

theorem p3Polynomial_monic : p3Polynomial.Monic := by
  unfold p3Polynomial
  monicity!

theorem p3Polynomial_natDegree : p3Polynomial.natDegree = 3 := by
  unfold p3Polynomial
  compute_degree!

theorem p3Polynomial_derivative :
    p3Polynomial.derivative = C 3 * (X - C 1) * (X + C 1) := by
  apply Polynomial.funext
  intro z
  norm_num [p3Polynomial]
  ring

theorem p3_derivative_eval_zero_iff (z : ℂ) :
    p3Polynomial.derivative.eval z = 0 ↔ z = 1 ∨ z = -1 := by
  rw [p3Polynomial_derivative]
  simp only [eval_mul, eval_C, eval_X, eval_sub, eval_add, eval_one]
  norm_num
  constructor
  · intro h
    rcases h with h | h
    · left; exact sub_eq_zero.mp h
    · right; exact eq_neg_of_add_eq_zero_left h
  · rintro (rfl | rfl) <;> norm_num

theorem p3_critical_value_norm_ge_one (z : ℂ)
    (hz : p3Polynomial.derivative.eval z = 0) :
    1 ≤ ‖p3Polynomial.eval z‖ := by
  rcases (p3_derivative_eval_zero_iff z).mp hz with rfl | rfl
  · norm_num [p3Polynomial]
  · norm_num [p3Polynomial]

theorem p3Polynomial_separable : p3Polynomial.Separable := by
  rw [Polynomial.separable_def']
  refine ⟨C (3 / 5 : ℂ) + C (2 / 5 : ℂ) * X,
    C (4 / 15 : ℂ) - C (1 / 5 : ℂ) * X - C (2 / 15 : ℂ) * X ^ 2, ?_⟩
  rw [p3Polynomial_derivative]
  apply Polynomial.funext
  intro z
  norm_num [p3Polynomial]
  ring

theorem p3_rootSet_ncard : (p3Polynomial.rootSet ℂ).ncard = 3 := by
  have hcard : Fintype.card (p3Polynomial.rootSet ℂ) = p3Polynomial.natDegree :=
    Polynomial.card_rootSet_eq_natDegree p3Polynomial_separable (IsAlgClosed.splits _)
  rw [p3Polynomial_natDegree] at hcard
  simpa using hcard

theorem p3_closedBall_subset_regular_values :
    Metric.closedBall (0 : ℂ) p3Level ⊆
      (p3Polynomial.eval '' {z : ℂ | p3Polynomial.derivative.eval z = 0})ᶜ := by
  rintro w hw ⟨z, hzcrit, rfl⟩
  have hw' : ‖p3Polynomial.eval z‖ ≤ p3Level := by
    simpa [Metric.mem_closedBall] using hw
  have hlevel : p3Level < 1 := by norm_num [p3Level]
  linarith [p3_critical_value_norm_ge_one z hzcrit]

/-- Every component below the first critical level contains a root. -/
theorem p3_exists_root_in_component (z : ℂ)
    (hz : z ∈ sublevelSet p3Polynomial p3Level) :
    ∃ r ∈ p3Polynomial.rootSet ℂ,
      r ∈ connectedComponentIn (sublevelSet p3Polynomial p3Level) z := by
  let D : Set ℂ := Metric.closedBall 0 p3Level
  letI : ContractibleSpace D := by
    dsimp [D]
    exact Metric.contractibleSpace_closedBall (by norm_num [p3Level])
  letI : LocallyPathConnectedSpace D := by
    dsimp [D]
    exact (convex_closedBall (0 : ℂ) p3Level).locallyPathConnectedSpace
  let a0 : D := ⟨p3Polynomial.eval z, by
    have hz' : ‖p3Polynomial.eval z‖ ≤ p3Level := hz
    simpa [D, Metric.mem_closedBall] using hz'⟩
  let inclusion : C(D, ℂ) := ⟨fun w => w.1, continuous_subtype_val⟩
  have hreg : ∀ w : D,
      inclusion w ∈
        (p3Polynomial.eval '' {u : ℂ | p3Polynomial.derivative.eval u = 0})ᶜ := by
    intro w
    apply p3_closedBall_subset_regular_values
    exact w.2
  obtain ⟨F, hF, _⟩ :=
    (Polynomial.isCoveringMapOn_eval p3Polynomial).existsUnique_continuousMap_lifts
      inclusion (a₀ := a0) (e₀ := z) (by rfl) hreg
  have hlift (w : D) : p3Polynomial.eval (F w) = (w : ℂ) := by
    simpa [Function.comp_apply, inclusion] using congrFun hF.2 w
  let w0 : D := ⟨0, by simpa [D, Metric.mem_closedBall] using
    (show (0 : ℝ) ≤ p3Level by norm_num [p3Level])⟩
  let r : ℂ := F w0
  have hrzero : p3Polynomial.eval r = 0 := by
    simpa [r, w0] using hlift w0
  have hrroot : r ∈ p3Polynomial.rootSet ℂ :=
    p3Polynomial_monic.mem_rootSet.mpr hrzero
  have hpre : IsPreconnected (Set.range F) := isPreconnected_range F.continuous
  have hzrange : z ∈ Set.range F := ⟨a0, hF.1⟩
  have hrrange : r ∈ Set.range F := ⟨w0, rfl⟩
  have hFK : Set.range F ⊆ sublevelSet p3Polynomial p3Level := by
    rintro _ ⟨w, rfl⟩
    have hw : ‖(w : ℂ)‖ ≤ p3Level := by
      have hw' := w.2
      change (w : ℂ) ∈ Metric.closedBall 0 p3Level at hw'
      rw [Metric.mem_closedBall, dist_zero_right] at hw'
      exact hw'
    change ‖p3Polynomial.eval (F w)‖ ≤ p3Level
    rw [hlift w]
    exact hw
  exact ⟨r, hrroot, hpre.subset_connectedComponentIn hzrange hFK hrrange⟩

theorem p3_imaginary_axis_avoids (y : ℝ) :
    (y : ℂ) * Complex.I ∉ sublevelSet p3Polynomial p3Level := by
  intro hz
  have hre : (p3Polynomial.eval ((y : ℂ) * Complex.I)).re ≤ p3Level :=
    (Complex.re_le_norm _).trans hz
  have heq : (p3Polynomial.eval ((y : ℂ) * Complex.I)).re = 3 := by
    norm_num [p3Polynomial, pow_succ, Complex.mul_re, Complex.mul_im]
  rw [heq] at hre
  norm_num [p3Level] at hre

theorem p3_right_real_axis_avoids (x : ℝ) (hx : 0 ≤ x) :
    (x : ℂ) ∉ sublevelSet p3Polynomial p3Level := by
  intro hz
  have hre : (p3Polynomial.eval (x : ℂ)).re ≤ p3Level :=
    (Complex.re_le_norm _).trans hz
  have hid : (p3Polynomial.eval (x : ℂ)).re - 1 = (x - 1) ^ 2 * (x + 2) := by
    norm_num [p3Polynomial, pow_succ]
    ring
  have hnonneg : 0 ≤ (x - 1) ^ 2 * (x + 2) := mul_nonneg (sq_nonneg _) (by linarith)
  rw [← hid] at hnonneg
  have hlevel : p3Level < 1 := by norm_num [p3Level]
  linarith

theorem p3LowerAnchor_mem : p3LowerAnchor ∈ sublevelSet p3Polynomial p3Level :=
  (p3Lower_lineA_strict p3LowerAnchor
    (left_mem_segment ℝ p3LowerAnchor p3LowerPointA)).le

theorem p3UpperAnchor_mem :
    star p3LowerAnchor ∈ sublevelSet p3Polynomial p3Level :=
  (p3_mem_star_iff p3LowerAnchor).2 p3LowerAnchor_mem

theorem p3LeftAnchor_mem : p3LeftAnchor ∈ sublevelSet p3Polynomial p3Level := by
  change ‖p3Polynomial.eval p3LeftAnchor‖ ≤ p3Level
  norm_num [p3Polynomial, p3LeftAnchor, p3Level]

theorem p3_component_re_pos {r : ℂ} (hr : r ∈ sublevelSet p3Polynomial p3Level)
    (hre : 0 < r.re) :
    ∀ z ∈ connectedComponentIn (sublevelSet p3Polynomial p3Level) r, 0 < z.re := by
  have h := negative_on_component (S := sublevelSet p3Polynomial p3Level)
    (r := r) (φ := fun z : ℂ => -z.re) (by fun_prop) (by
      intro z hz hzero
      have hzre : z.re = 0 := by linarith
      have hrepr : z = (z.im : ℂ) * Complex.I := by
        apply Complex.ext <;> simp [hzre]
      rw [hrepr] at hz
      exact p3_imaginary_axis_avoids z.im hz) hr (by linarith)
  intro z hz
  linarith [h z hz]

theorem p3_component_re_neg {r : ℂ} (hr : r ∈ sublevelSet p3Polynomial p3Level)
    (hre : r.re < 0) :
    ∀ z ∈ connectedComponentIn (sublevelSet p3Polynomial p3Level) r, z.re < 0 := by
  apply negative_on_component (φ := fun z : ℂ => z.re) (by fun_prop) _ hr hre
  intro z hz hzero
  have hrepr : z = (z.im : ℂ) * Complex.I := by
    apply Complex.ext <;> simp [hzero]
  rw [hrepr] at hz
  exact p3_imaginary_axis_avoids z.im hz

theorem p3_right_component_im_neg {r : ℂ}
    (hr : r ∈ sublevelSet p3Polynomial p3Level) (hre : 0 < r.re) (him : r.im < 0) :
    ∀ z ∈ connectedComponentIn (sublevelSet p3Polynomial p3Level) r, z.im < 0 := by
  let K := sublevelSet p3Polynomial p3Level
  let C := connectedComponentIn K r
  have hreall := p3_component_re_pos hr hre
  have hpos := positive_on_preconnected (S := C) (r := r)
    (φ := fun z : ℂ => -z.im) isPreconnected_connectedComponentIn (by fun_prop) (by
      intro z hz hzero
      have hzK : z ∈ K := connectedComponentIn_subset K r hz
      have hx : 0 ≤ z.re := (hreall z hz).le
      have hzim : z.im = 0 := by linarith
      have hrepr : z = (z.re : ℂ) := by
        apply Complex.ext <;> simp [hzim]
      rw [hrepr] at hzK
      exact p3_right_real_axis_avoids z.re hx hzK)
    (mem_connectedComponentIn hr) (by linarith)
  intro z hz
  linarith [hpos z hz]

theorem p3_three_components_pairwise_distinct :
    let K := sublevelSet p3Polynomial p3Level
    let CL := connectedComponentIn K p3LeftAnchor
    let CD := connectedComponentIn K p3LowerAnchor
    let CU := connectedComponentIn K (star p3LowerAnchor)
    CL ≠ CD ∧ CL ≠ CU ∧ CD ≠ CU := by
  dsimp only
  have hleft := p3_component_re_neg p3LeftAnchor_mem
    (by norm_num [p3LeftAnchor])
  have hlowerRe : 0 < p3LowerAnchor.re := by norm_num [p3LowerAnchor]
  have hlowerIm : p3LowerAnchor.im < 0 := by norm_num [p3LowerAnchor]
  have hlower := p3_right_component_im_neg p3LowerAnchor_mem hlowerRe hlowerIm
  constructor
  · intro heq
    have hmem : p3LowerAnchor ∈ connectedComponentIn
        (sublevelSet p3Polynomial p3Level) p3LeftAnchor := by
      rw [heq]
      exact mem_connectedComponentIn p3LowerAnchor_mem
    linarith [hleft p3LowerAnchor hmem]
  constructor
  · intro heq
    have hmem : star p3LowerAnchor ∈ connectedComponentIn
        (sublevelSet p3Polynomial p3Level) p3LeftAnchor := by
      rw [heq]
      exact mem_connectedComponentIn p3UpperAnchor_mem
    have hre : 0 < (star p3LowerAnchor).re := by norm_num [p3LowerAnchor]
    linarith [hleft (star p3LowerAnchor) hmem]
  · intro heq
    have hmem : star p3LowerAnchor ∈ connectedComponentIn
        (sublevelSet p3Polynomial p3Level) p3LowerAnchor := by
      rw [heq]
      exact mem_connectedComponentIn p3UpperAnchor_mem
    have him : 0 < (star p3LowerAnchor).im := by norm_num [p3LowerAnchor]
    linarith [hlower (star p3LowerAnchor) hmem]

theorem p3_componentsIn_eq_image_rootSet :
    componentsIn (sublevelSet p3Polynomial p3Level) =
      (fun r : ℂ => connectedComponentIn (sublevelSet p3Polynomial p3Level) r) ''
        (↑(p3Polynomial.rootSet ℂ) : Set ℂ) := by
  apply Set.Subset.antisymm
  · rintro t ⟨z, hz, rfl⟩
    obtain ⟨r, hrroot, hrcomp⟩ := p3_exists_root_in_component z hz
    refine ⟨r, hrroot, ?_⟩
    exact (connectedComponentIn_eq hrcomp).symm
  · rintro _ ⟨r, hrroot, rfl⟩
    have hreval : p3Polynomial.eval r = 0 := p3Polynomial_monic.mem_rootSet.mp hrroot
    have hrK : r ∈ sublevelSet p3Polynomial p3Level := by
      change ‖p3Polynomial.eval r‖ ≤ p3Level
      rw [hreval, norm_zero]
      norm_num [p3Level]
    exact ⟨r, hrK, rfl⟩

theorem p3_three_component_set_ncard :
    let K := sublevelSet p3Polynomial p3Level
    ({connectedComponentIn K p3LeftAnchor,
      connectedComponentIn K p3LowerAnchor,
      connectedComponentIn K (star p3LowerAnchor)} : Set (Set ℂ)).ncard = 3 := by
  dsimp only
  let K := sublevelSet p3Polynomial p3Level
  let CL := connectedComponentIn K p3LeftAnchor
  let CD := connectedComponentIn K p3LowerAnchor
  let CU := connectedComponentIn K (star p3LowerAnchor)
  change ({CL, CD, CU} : Set (Set ℂ)).ncard = 3
  obtain ⟨h01, h02, h12⟩ := p3_three_components_pairwise_distinct
  change CL ≠ CD at h01
  change CL ≠ CU at h02
  change CD ≠ CU at h12
  rw [Set.ncard_insert_of_notMem (by simp [h01, h02])]
  rw [Set.ncard_insert_of_notMem (by simp [h12])]
  simp

theorem p3_three_component_set_subset_componentsIn :
    let K := sublevelSet p3Polynomial p3Level
    ({connectedComponentIn K p3LeftAnchor,
      connectedComponentIn K p3LowerAnchor,
      connectedComponentIn K (star p3LowerAnchor)} : Set (Set ℂ)) ⊆ componentsIn K := by
  dsimp only
  simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
  exact ⟨⟨p3LeftAnchor, p3LeftAnchor_mem, rfl⟩,
    ⟨p3LowerAnchor, p3LowerAnchor_mem, rfl⟩,
    ⟨star p3LowerAnchor, p3UpperAnchor_mem, rfl⟩⟩

theorem p3_componentsIn_ncard :
    (componentsIn (sublevelSet p3Polynomial p3Level)).ncard = 3 := by
  have hfin : (componentsIn (sublevelSet p3Polynomial p3Level)).Finite := by
    rw [p3_componentsIn_eq_image_rootSet]
    exact (p3Polynomial.rootSet_finite ℂ).image _
  have hlower : 3 ≤ (componentsIn (sublevelSet p3Polynomial p3Level)).ncard := by
    rw [← p3_three_component_set_ncard]
    exact Set.ncard_le_ncard p3_three_component_set_subset_componentsIn hfin
  have hupper : (componentsIn (sublevelSet p3Polynomial p3Level)).ncard ≤ 3 := by
    rw [p3_componentsIn_eq_image_rootSet]
    calc
      _ ≤ (p3Polynomial.rootSet ℂ).ncard :=
        Set.ncard_image_le (p3Polynomial.rootSet_finite ℂ)
      _ = 3 := p3_rootSet_ncard
  omega

theorem p3_componentsIn_eq_three :
    let K := sublevelSet p3Polynomial p3Level
    componentsIn K =
      {connectedComponentIn K p3LeftAnchor,
        connectedComponentIn K p3LowerAnchor,
        connectedComponentIn K (star p3LowerAnchor)} := by
  dsimp only
  symm
  refine Set.eq_of_subset_of_ncard_le p3_three_component_set_subset_componentsIn ?_
    (ht := ?_)
  · rw [p3_componentsIn_ncard, p3_three_component_set_ncard]
  · rw [p3_componentsIn_eq_image_rootSet]
    exact (p3Polynomial.rootSet_finite ℂ).image _

/-- The exact certificates already force at least two non-convex components. -/
theorem p3_two_le_nonconvex_ncard :
    2 ≤ {t ∈ componentsIn (sublevelSet p3Polynomial p3Level) |
      ¬ Convex ℝ t}.ncard := by
  let K := sublevelSet p3Polynomial p3Level
  let CD := connectedComponentIn K p3LowerAnchor
  let CU := connectedComponentIn K (star p3LowerAnchor)
  let N := {t ∈ componentsIn K | ¬ Convex ℝ t}
  have hpair : ({CD, CU} : Set (Set ℂ)).ncard = 2 := by
    obtain ⟨_, _, hne⟩ := p3_three_components_pairwise_distinct
    change CD ≠ CU at hne
    simp [hne]
  have hpairsub : ({CD, CU} : Set (Set ℂ)) ⊆ N := by
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
    constructor
    · exact ⟨⟨p3LowerAnchor, p3LowerAnchor_mem, rfl⟩, p3Lower_component_not_convex⟩
    · exact ⟨⟨star p3LowerAnchor, p3UpperAnchor_mem, rfl⟩,
        p3Upper_component_not_convex⟩
  have hcomponentsFinite : (componentsIn K).Finite := by
    rw [p3_componentsIn_eq_image_rootSet]
    exact (p3Polynomial.rootSet_finite ℂ).image _
  have hNfinite : N.Finite := hcomponentsFinite.subset (fun _ ht => ht.1)
  change 2 ≤ N.ncard
  rw [← hpair]
  exact Set.ncard_le_ncard hpairsub hNfinite

/-- Once the isolated left component is known convex, the two finite certificates
give the exact non-convex count.  This isolates the sole remaining geometric fact
for the explicit cubic construction. -/
theorem p3_nonconvex_ncard_eq_two
    (hleft : Convex ℝ (connectedComponentIn
      (sublevelSet p3Polynomial p3Level) p3LeftAnchor)) :
    {t ∈ componentsIn (sublevelSet p3Polynomial p3Level) |
      ¬ Convex ℝ t}.ncard = 2 := by
