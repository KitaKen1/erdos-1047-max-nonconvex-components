/-- Quantitative data certifying non-convexity.  The two joining segments have a
strict common margin inside the norm sublevel set, while their midpoint has the
same margin outside.  This is the form needed to preserve the witness under a
uniform perturbation. -/
structure RobustNonconvexCertificate (F : ℂ → ℂ) (c : ℝ) (r a b : ℂ) where
  eps : ℝ
  eps_pos : 0 < eps
  lineA_margin : ∀ z ∈ segment ℝ r a, ‖F z‖ + eps ≤ c
  lineB_margin : ∀ z ∈ segment ℝ r b, ‖F z‖ + eps ≤ c
  midpoint_margin : c + eps ≤ ‖F (midpoint ℝ a b)‖

/-! Real affine transport of a robust certificate.  This is the elementary
local model needed by the quartic gadget: translating by `L` and scaling by a
positive real `s` preserves line segments, while multiplication by `s⁴`
rescales both the level and the quantitative margin. -/
theorem robustNonconvexCertificate_of_real_affine_scaled
    {F : ℂ → ℂ} {c : ℝ} {r a b : ℂ}
    (hcert : RobustNonconvexCertificate F c r a b)
    {L s : ℝ} (hs : 0 < s) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (s : ℂ) ^ 4 * F ((z - (L : ℂ)) / (s : ℂ)))
      (c * s ^ 4)
      ((L : ℂ) + (s : ℂ) * r)
      ((L : ℂ) + (s : ℂ) * a)
      ((L : ℂ) + (s : ℂ) * b)) := by
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hs)
  have hs4 : 0 < s ^ 4 := by positivity
  have hmemA : ∀ {z : ℂ},
      z ∈ segment ℝ ((L : ℂ) + (s : ℂ) * r)
        ((L : ℂ) + (s : ℂ) * a) →
      (z - (L : ℂ)) / (s : ℂ) ∈ segment ℝ r a := by
    intro z hz
    rcases hz with ⟨u, v, hu, hv, huv, hz⟩
    refine ⟨u, v, hu, hv, huv, ?_⟩
    rw [← hz]
    simp only [Complex.real_smul]
    field_simp [hs0]
    have huv' : u + v = 1 := by simpa [add_comm] using huv
    have huvC : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv'
    -- The segment representation is affine-linear in the endpoints.
    linear_combination (- (L : ℂ)) * huvC
  have hmemB : ∀ {z : ℂ},
      z ∈ segment ℝ ((L : ℂ) + (s : ℂ) * r)
        ((L : ℂ) + (s : ℂ) * b) →
      (z - (L : ℂ)) / (s : ℂ) ∈ segment ℝ r b := by
    intro z hz
    rcases hz with ⟨u, v, hu, hv, huv, hz⟩
    refine ⟨u, v, hu, hv, huv, ?_⟩
    rw [← hz]
    simp only [Complex.real_smul]
    field_simp [hs0]
    have huv' : u + v = 1 := by simpa [add_comm] using huv
    have huvC : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv'
    linear_combination (- (L : ℂ)) * huvC
  have hmid :
      ((midpoint ℝ (((L : ℂ) + (s : ℂ) * a))
        ((L : ℂ) + (s : ℂ) * b) - (L : ℂ)) / (s : ℂ)) =
        midpoint ℝ a b := by
    rw [midpoint_eq_smul_add, midpoint_eq_smul_add]
    simp only [Complex.real_smul, invOf_eq_inv]
    field_simp [hs0]
    norm_num
    ring_nf
  refine ⟨⟨hcert.eps * s ^ 4, mul_pos hcert.eps_pos hs4, ?_, ?_, ?_⟩⟩
  · intro z hz
    have hm := hcert.lineA_margin ( (z - (L : ℂ)) / (s : ℂ)) (hmemA hz)
    have hnorm : ‖(s : ℂ) ^ 4 * F ((z - (L : ℂ)) / (s : ℂ))‖ =
        s ^ 4 * ‖F ((z - (L : ℂ)) / (s : ℂ))‖ := by
      rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hs]
    rw [hnorm]
    have hmul := mul_le_mul_of_nonneg_left hm (le_of_lt hs4)
    nlinarith
  · intro z hz
    have hm := hcert.lineB_margin ( (z - (L : ℂ)) / (s : ℂ)) (hmemB hz)
    have hnorm : ‖(s : ℂ) ^ 4 * F ((z - (L : ℂ)) / (s : ℂ))‖ =
        s ^ 4 * ‖F ((z - (L : ℂ)) / (s : ℂ))‖ := by
      rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hs]
    rw [hnorm]
    have hmul := mul_le_mul_of_nonneg_left hm (le_of_lt hs4)
    nlinarith
  · have hm := hcert.midpoint_margin
    have hnorm : ‖(s : ℂ) ^ 4 *
        F ( (midpoint ℝ (((L : ℂ) + (s : ℂ) * a))
          ((L : ℂ) + (s : ℂ) * b) - (L : ℂ)) / (s : ℂ))‖ =
        s ^ 4 * ‖F ( (midpoint ℝ (((L : ℂ) + (s : ℂ) * a))
          ((L : ℂ) + (s : ℂ) * b) - (L : ℂ)) / (s : ℂ))‖ := by
      rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hs]
    rw [hnorm, hmid]
    have hmul := mul_le_mul_of_nonneg_left hm (le_of_lt hs4)
    nlinarith

/-! The quadratic analogue of the preceding affine transport.  New-root charts
    use the factor `(z-L)^2+s^2`, so the geometric scale is `s^2` rather than
    the quartic scale `s^4`. -/
theorem robustNonconvexCertificate_of_real_affine_scaled_sq
    {F : ℂ → ℂ} {c : ℝ} {r a b : ℂ}
    (hcert : RobustNonconvexCertificate F c r a b)
    {L s : ℝ} (hs : 0 < s) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (s : ℂ) ^ 2 * F ((z - (L : ℂ)) / (s : ℂ)))
      (c * s ^ 2)
      ((L : ℂ) + (s : ℂ) * r)
      ((L : ℂ) + (s : ℂ) * a)
      ((L : ℂ) + (s : ℂ) * b)) := by
  have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hs)
  have hs2 : 0 < s ^ 2 := by positivity
  have hmemA : ∀ {z : ℂ},
      z ∈ segment ℝ ((L : ℂ) + (s : ℂ) * r)
        ((L : ℂ) + (s : ℂ) * a) →
      (z - (L : ℂ)) / (s : ℂ) ∈ segment ℝ r a := by
    intro z hz
    rcases hz with ⟨u, v, hu, hv, huv, hz⟩
    refine ⟨u, v, hu, hv, huv, ?_⟩
    rw [← hz]
    simp only [Complex.real_smul]
    field_simp [hs0]
    have huv' : u + v = 1 := by simpa [add_comm] using huv
    have huvC : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv'
    linear_combination (- (L : ℂ)) * huvC
  have hmemB : ∀ {z : ℂ},
      z ∈ segment ℝ ((L : ℂ) + (s : ℂ) * r)
        ((L : ℂ) + (s : ℂ) * b) →
      (z - (L : ℂ)) / (s : ℂ) ∈ segment ℝ r b := by
    intro z hz
    rcases hz with ⟨u, v, hu, hv, huv, hz⟩
    refine ⟨u, v, hu, hv, huv, ?_⟩
    rw [← hz]
    simp only [Complex.real_smul]
    field_simp [hs0]
    have huv' : u + v = 1 := by simpa [add_comm] using huv
    have huvC : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv'
    linear_combination (- (L : ℂ)) * huvC
  have hmid :
      ((midpoint ℝ (((L : ℂ) + (s : ℂ) * a))
        ((L : ℂ) + (s : ℂ) * b) - (L : ℂ)) / (s : ℂ)) =
        midpoint ℝ a b := by
    rw [midpoint_eq_smul_add, midpoint_eq_smul_add]
    simp only [Complex.real_smul, invOf_eq_inv]
    field_simp [hs0]
    norm_num
    ring_nf
  refine ⟨⟨hcert.eps * s ^ 2, mul_pos hcert.eps_pos hs2, ?_, ?_, ?_⟩⟩
  · intro z hz
    have hm := hcert.lineA_margin ((z - (L : ℂ)) / (s : ℂ)) (hmemA hz)
    have hnorm : ‖(s : ℂ) ^ 2 * F ((z - (L : ℂ)) / (s : ℂ))‖ =
        s ^ 2 * ‖F ((z - (L : ℂ)) / (s : ℂ))‖ := by
      rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hs]
    rw [hnorm]
    have hmul := mul_le_mul_of_nonneg_left hm (le_of_lt hs2)
    nlinarith
  · intro z hz
    have hm := hcert.lineB_margin ((z - (L : ℂ)) / (s : ℂ)) (hmemB hz)
    have hnorm : ‖(s : ℂ) ^ 2 * F ((z - (L : ℂ)) / (s : ℂ))‖ =
        s ^ 2 * ‖F ((z - (L : ℂ)) / (s : ℂ))‖ := by
      rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hs]
    rw [hnorm]
    have hmul := mul_le_mul_of_nonneg_left hm (le_of_lt hs2)
    nlinarith
  · have hm := hcert.midpoint_margin
    have hnorm : ‖(s : ℂ) ^ 2 *
        F ((midpoint ℝ (((L : ℂ) + (s : ℂ) * a))
          ((L : ℂ) + (s : ℂ) * b) - (L : ℂ)) / (s : ℂ))‖ =
        s ^ 2 * ‖F ((midpoint ℝ (((L : ℂ) + (s : ℂ) * a))
          ((L : ℂ) + (s : ℂ) * b) - (L : ℂ)) / (s : ℂ))‖ := by
      rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hs]
    rw [hnorm, hmid]
    have hmul := mul_le_mul_of_nonneg_left hm (le_of_lt hs2)
    nlinarith

/-! A robust certificate already contains a complete finite non-convexity
    proof for its own sublevel set.  Keeping this projection explicit avoids
    rebuilding the two segment inclusions every time a transported witness is
    consumed by the cardinality bookkeeping. -/
theorem RobustNonconvexCertificate.not_convex_component
    {F : ℂ → ℂ} {c : ℝ} {r a b : ℂ}
    (hcert : RobustNonconvexCertificate F c r a b) :
    ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖F z‖ ≤ c} r) := by
  apply component_not_convex_of_segments
  · intro z hz
    change ‖F z‖ ≤ c
    have hm := hcert.lineA_margin z hz
    linarith [hcert.eps_pos]
  · intro z hz
    change ‖F z‖ ≤ c
    have hm := hcert.lineB_margin z hz
    linarith [hcert.eps_pos]
  · intro hm
    change ‖F (midpoint ℝ a b)‖ ≤ c at hm
    linarith [hcert.midpoint_margin, hcert.eps_pos]

/-- A robust certificate remains a non-convexity certificate after any function
perturbation smaller than its margin on the two segments and the midpoint. -/
theorem RobustNonconvexCertificate.stable
    {F G : ℂ → ℂ} {c : ℝ} {r a b : ℂ}
    (hcert : RobustNonconvexCertificate F c r a b)
    (hA : ∀ z ∈ segment ℝ r a, ‖G z - F z‖ < hcert.eps)
    (hB : ∀ z ∈ segment ℝ r b, ‖G z - F z‖ < hcert.eps)
    (hM : ‖G (midpoint ℝ a b) - F (midpoint ℝ a b)‖ < hcert.eps) :
    ¬ Convex ℝ (connectedComponentIn {z | ‖G z‖ ≤ c} r) := by
  apply component_not_convex_of_segments
  · intro z hz
    have htriangle : ‖G z‖ ≤ ‖F z‖ + ‖G z - F z‖ := by
      calc
        ‖G z‖ = ‖F z + (G z - F z)‖ := by congr 1 <;> ring
        _ ≤ ‖F z‖ + ‖G z - F z‖ := norm_add_le _ _
    have hclose := hA z hz
    have hmargin := hcert.lineA_margin z hz
    exact le_of_lt (lt_of_le_of_lt htriangle (by linarith))
  · intro z hz
    have htriangle : ‖G z‖ ≤ ‖F z‖ + ‖G z - F z‖ := by
      calc
        ‖G z‖ = ‖F z + (G z - F z)‖ := by congr 1 <;> ring
        _ ≤ ‖F z‖ + ‖G z - F z‖ := norm_add_le _ _
    have hclose := hB z hz
    have hmargin := hcert.lineB_margin z hz
    exact le_of_lt (lt_of_le_of_lt htriangle (by linarith))
  · intro hm
    change ‖G (midpoint ℝ a b)‖ ≤ c at hm
    have htriangle : ‖F (midpoint ℝ a b)‖ ≤
        ‖G (midpoint ℝ a b)‖ + ‖G (midpoint ℝ a b) - F (midpoint ℝ a b)‖ := by
      calc
        ‖F (midpoint ℝ a b)‖ =
            ‖G (midpoint ℝ a b) +
              (F (midpoint ℝ a b) - G (midpoint ℝ a b))‖ := by congr 1 <;> ring
        _ ≤ ‖G (midpoint ℝ a b)‖ +
              ‖F (midpoint ℝ a b) - G (midpoint ℝ a b)‖ := norm_add_le _ _
        _ = ‖G (midpoint ℝ a b)‖ +
              ‖G (midpoint ℝ a b) - F (midpoint ℝ a b)‖ := by rw [norm_sub_rev]
    have hmargin := hcert.midpoint_margin
    linarith

/-! Quantitative stability: a uniform error bounded by `δ < eps` leaves a
    positive-margin robust certificate, with the margin reduced from `eps` to
    `eps - δ`. This stronger form allows a degree-raising induction to carry
    certificates to the next polynomial. -/
theorem RobustNonconvexCertificate.of_uniform_close
    {F G : ℂ → ℂ} {c : ℝ} {r a b : ℂ} {δ : ℝ}
    (hcert : RobustNonconvexCertificate F c r a b)
    (hδ : 0 ≤ δ) (hδlt : δ < hcert.eps)
    (hA : ∀ z ∈ segment ℝ r a, ‖G z - F z‖ ≤ δ)
    (hB : ∀ z ∈ segment ℝ r b, ‖G z - F z‖ ≤ δ)
    (hM : ‖G (midpoint ℝ a b) - F (midpoint ℝ a b)‖ ≤ δ) :
    Nonempty (RobustNonconvexCertificate G c r a b) := by
  refine ⟨⟨hcert.eps - δ, sub_pos.mpr hδlt, ?_, ?_, ?_⟩⟩
  · intro z hz
    have htriangle : ‖G z‖ ≤ ‖F z‖ + ‖G z - F z‖ := by
      calc
        ‖G z‖ = ‖F z + (G z - F z)‖ := by congr 1 <;> ring
        _ ≤ ‖F z‖ + ‖G z - F z‖ := norm_add_le _ _
    have hclose := hA z hz
    have hmargin := hcert.lineA_margin z hz
    linarith
  · intro z hz
    have htriangle : ‖G z‖ ≤ ‖F z‖ + ‖G z - F z‖ := by
      calc
        ‖G z‖ = ‖F z + (G z - F z)‖ := by congr 1 <;> ring
        _ ≤ ‖F z‖ + ‖G z - F z‖ := norm_add_le _ _
    have hclose := hB z hz
    have hmargin := hcert.lineB_margin z hz
    linarith
  · have htriangle : ‖F (midpoint ℝ a b)‖ ≤
        ‖G (midpoint ℝ a b)‖ +
          ‖G (midpoint ℝ a b) - F (midpoint ℝ a b)‖ := by
      calc
        ‖F (midpoint ℝ a b)‖ =
            ‖G (midpoint ℝ a b) +
              (F (midpoint ℝ a b) - G (midpoint ℝ a b))‖ := by congr 1 <;> ring
        _ ≤ ‖G (midpoint ℝ a b)‖ +
              ‖F (midpoint ℝ a b) - G (midpoint ℝ a b)‖ := norm_add_le _ _
        _ = ‖G (midpoint ℝ a b)‖ +
              ‖G (midpoint ℝ a b) - F (midpoint ℝ a b)‖ := by rw [norm_sub_rev]
    have hclose := hM
    have hmargin := hcert.midpoint_margin
    linarith

/-! A positive real scalar rescales a robust certificate without changing its
    anchor geometry.  This small algebraic bridge is useful when a local
    quartic chart is normalized by the large value of the old polynomial. -/
theorem RobustNonconvexCertificate.of_pos_real_scalar
    {F : ℂ → ℂ} {c : ℝ} {r a b : ℂ}
    (hcert : RobustNonconvexCertificate F c r a b)
    {α : ℝ} (hα : 0 < α) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (α : ℂ) * F z) (α * c) r a b) := by
  refine ⟨⟨α * hcert.eps, mul_pos hα hcert.eps_pos, ?_, ?_, ?_⟩⟩
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_right (hcert.lineA_margin z hz)
      (le_of_lt hα)
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hα]
    nlinarith
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_right (hcert.lineB_margin z hz)
      (le_of_lt hα)
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hα]
    nlinarith
  · have hmul := mul_le_mul_of_nonneg_right hcert.midpoint_margin
      (le_of_lt hα)
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hα]
    nlinarith

/-! Local new-root certificate transport.  The analytic input is a robust
    certificate for the normalized model `(1+κw)(w²+1)` and a uniform error
    bound on its compact witness chart.  The conclusion is an actual robust
    certificate for the raised polynomial with quadratic factor `(z-L)^2+s²`;
    no component or root-count assertion is hidden in this adapter. -/
theorem quadratic_raise_new_region_robust_certificate_of_local_close
    {p : ℂ[X]} {L s α c δ : ℝ} {κ : ℂ} {r a b : ℂ}
    (hα : 0 < α) (hs : 0 < s)
    (hbase : RobustNonconvexCertificate
      (fun w : ℂ => ((1 : ℂ) + κ * w) * (w ^ 2 + 1)) c r a b)
    (hδ : 0 ≤ δ) (hδlt : δ < hbase.eps)
    (hA : ∀ w ∈ segment ℝ r a,
      ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) * (w ^ 2 + 1) -
          ((1 : ℂ) + κ * w) * (w ^ 2 + 1)‖ ≤ δ)
    (hB : ∀ w ∈ segment ℝ r b,
      ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) * (w ^ 2 + 1) -
          ((1 : ℂ) + κ * w) * (w ^ 2 + 1)‖ ≤ δ)
    (hM : ‖p.eval ((L : ℂ) + (s : ℂ) * midpoint ℝ a b) / (α : ℂ) *
        (midpoint ℝ a b ^ 2 + 1) -
          ((1 : ℂ) + κ * midpoint ℝ a b) *
            (midpoint ℝ a b ^ 2 + 1)‖ ≤ δ) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ =>
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ) ((s : ℂ) ^ 2)).eval z)
      (α * c * s ^ 2)
      ((L : ℂ) + (s : ℂ) * r)
      ((L : ℂ) + (s : ℂ) * a)
      ((L : ℂ) + (s : ℂ) * b)) := by
  let G : ℂ → ℂ := fun w =>
    p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) * (w ^ 2 + 1)
  have hGA : ∀ w ∈ segment ℝ r a,
      ‖G w - ((1 : ℂ) + κ * w) * (w ^ 2 + 1)‖ ≤ δ := by
    intro w hw
    simpa [G] using hA w hw
  have hGB : ∀ w ∈ segment ℝ r b,
      ‖G w - ((1 : ℂ) + κ * w) * (w ^ 2 + 1)‖ ≤ δ := by
    intro w hw
    simpa [G] using hB w hw
  have hGM : ‖G (midpoint ℝ a b) -
      ((1 : ℂ) + κ * midpoint ℝ a b) * (midpoint ℝ a b ^ 2 + 1)‖ ≤ δ := by
    simpa [G] using hM
  obtain ⟨hG⟩ := RobustNonconvexCertificate.of_uniform_close hbase hδ hδlt
    hGA hGB hGM
  obtain ⟨htrans⟩ := robustNonconvexCertificate_of_real_affine_scaled_sq hG hs
  obtain ⟨hscaled⟩ := RobustNonconvexCertificate.of_pos_real_scalar htrans hα
  refine ⟨?_⟩
  convert hscaled using 1
  · funext z
    have hs0 : (s : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hs)
    have hα0 : (α : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hα)
    have hchart : (L : ℂ) + (s : ℂ) * ((z - (L : ℂ)) / (s : ℂ)) = z := by
      field_simp [hs0]
      ring
    rw [Erdos1047DegreeRaise.raisePolynomial_eval]
    dsimp [G]
    rw [hchart]
    field_simp [hα0, hs0]
  · ring

/-! Rescale the normalized stability statement back to the raised polynomial.
    The new level is `c * ‖L‖²` and the new positive margin is scaled by
    `‖L‖²`. -/
theorem raised_robust_certificate_of_scaled_close
    {p : ℂ[X]} {L d : ℂ} {c : ℝ} {r a b : ℂ} {δ : ℝ}
    (hL : L ≠ 0)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b)
    (hδ : 0 ≤ δ) (hδlt : δ < hcert.eps)
    (hA : ∀ z ∈ segment ℝ r a,
      ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval z / L ^ 2 - p.eval z‖ ≤ δ)
    (hB : ∀ z ∈ segment ℝ r b,
      ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval z / L ^ 2 - p.eval z‖ ≤ δ)
    (hM : ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval
        (midpoint ℝ a b) / L ^ 2 - p.eval (midpoint ℝ a b)‖ ≤ δ) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047DegreeRaise.raisePolynomial p L d).eval z)
      (c * ‖L‖ ^ 2) r a b) := by
  let G : ℂ → ℂ := fun z =>
    (Erdos1047DegreeRaise.raisePolynomial p L d).eval z / L ^ 2
  obtain ⟨hG⟩ := RobustNonconvexCertificate.of_uniform_close hcert hδ hδlt
    (by
      intro z hz
      simpa [G] using hA z hz)
    (by
      intro z hz
      simpa [G] using hB z hz)
    (by simpa [G] using hM)
  let ell2 : ℝ := ‖L‖ ^ 2
  have hell2pos : 0 < ell2 := by
    dsimp [ell2]
    have : 0 < ‖L‖ := norm_pos_iff.mpr hL
    positivity
  have hnorm (z : ℂ) :
      ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval z‖ =
        ell2 * ‖G z‖ := by
    dsimp [G, ell2]
    rw [norm_div, norm_pow]
    field_simp [hL]
  refine ⟨⟨ell2 * hG.eps, mul_pos hell2pos hG.eps_pos, ?_, ?_, ?_⟩⟩
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_left (hG.lineA_margin z hz)
      (le_of_lt hell2pos)
    rw [hnorm z]
    dsimp [ell2]
    nlinarith
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_left (hG.lineB_margin z hz)
      (le_of_lt hell2pos)
    rw [hnorm z]
    dsimp [ell2]
    nlinarith
  · have hmul := mul_le_mul_of_nonneg_left hG.midpoint_margin
      (le_of_lt hell2pos)
    rw [hnorm (midpoint ℝ a b)]
    dsimp [ell2]
    nlinarith

/-! Convenience wrapper using the explicit degree-raising error estimate. -/
theorem raised_robust_certificate_of_uniform_bound
    {p : ℂ[X]} {n : ℕ} {q L : ℂ} {c : ℝ} {r a b : ℂ}
    (hn : 2 ≤ n) (hL : L ≠ 0)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b)
    (R A B ell : ℝ)
    (hRₐ : ∀ z ∈ segment ℝ r a, ‖z‖ ≤ R)
    (hAₐ : ∀ z ∈ segment ℝ r a, ‖p.eval z‖ ≤ A)
    (hRᵦ : ∀ z ∈ segment ℝ r b, ‖z‖ ≤ R)
    (hAᵦ : ∀ z ∈ segment ℝ r b, ‖p.eval z‖ ≤ A)
    (hRₘ : ‖midpoint ℝ a b‖ ≤ R)
    (hAₘ : ‖p.eval (midpoint ℝ a b)‖ ≤ A)
    (hB : ‖q‖ ≤ B) (hell : 0 < ell) (hLell : ell ≤ ‖L‖)
    (hbound : A * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n) < hcert.eps) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047DegreeRaise.raisePolynomial p L
        (Erdos1047DegreeRaise.raiseParameter n q L)).eval z)
      (c * ‖L‖ ^ 2) r a b) := by
  let δ : ℝ := A * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n)
  have hδ : 0 ≤ δ := by
    dsimp [δ]
    have hR0 : 0 ≤ R := (norm_nonneg (midpoint ℝ a b)).trans hRₘ
    have hA0 : 0 ≤ A := (norm_nonneg (p.eval (midpoint ℝ a b))).trans hAₘ
    have hB0 : 0 ≤ B := (norm_nonneg q).trans hB
    positivity
  have hδlt : δ < hcert.eps := by simpa [δ] using hbound
  apply raised_robust_certificate_of_scaled_close (d :=
      Erdos1047DegreeRaise.raiseParameter n q L) hL hcert hδ hδlt
  · intro z hz
    have hle := Erdos1047DegreeRaise.raisePolynomial_scaled_difference_norm_le_on_segment
      p n q L r a R A B ell hn hL hRₐ hAₐ hB hell hLell z hz
    simpa [δ] using hle
  · intro z hz
    have hle := Erdos1047DegreeRaise.raisePolynomial_scaled_difference_norm_le_on_segment
      p n q L r b R A B ell hn hL hRᵦ hAᵦ hB hell hLell z hz
    simpa [δ] using hle
  · have hle := Erdos1047DegreeRaise.raisePolynomial_scaled_difference_norm_le_at_point_of_bounds
      p n q L (midpoint ℝ a b) R A B ell hn hL hRₘ hAₘ hB hell hLell
    simpa [δ] using hle

/-! A common scale transports any family of robust certificates at once.  The
family may be finite or infinite; only uniform segment/value bounds and a
common positive lower bound on the old margins are used.  This is the precise
uniformity interface needed before component-injectivity is addressed. -/
theorem exists_common_scale_raised_robust_certificates
    {ι : Type*} {p : ℂ[X]} {n : ℕ} {q : ℂ} {c eps₀ R A B : ℝ}
    {r a b : ι → ℂ}
    (hn : 2 ≤ n) (hR : 0 ≤ R) (hA : 0 ≤ A) (hB : ‖q‖ ≤ B)
    (heps₀ : 0 < eps₀)
    (hcert : ∀ i, RobustNonconvexCertificate
      (fun z : ℂ => p.eval z) c (r i) (a i) (b i))
    (heps : ∀ i, eps₀ ≤ (hcert i).eps)
    (hRₐ : ∀ i z, z ∈ segment ℝ (r i) (a i) → ‖z‖ ≤ R)
    (hAₐ : ∀ i z, z ∈ segment ℝ (r i) (a i) → ‖p.eval z‖ ≤ A)
    (hRᵦ : ∀ i z, z ∈ segment ℝ (r i) (b i) → ‖z‖ ≤ R)
    (hAᵦ : ∀ i z, z ∈ segment ℝ (r i) (b i) → ‖p.eval z‖ ≤ A)
    (hRₘ : ∀ i, ‖midpoint ℝ (a i) (b i)‖ ≤ R)
    (hAₘ : ∀ i, ‖p.eval (midpoint ℝ (a i) (b i))‖ ≤ A) :
    ∃ L : ℂ, L ≠ 0 ∧ ∀ i, Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047DegreeRaise.raisePolynomial p L
        (Erdos1047DegreeRaise.raiseParameter n q L)).eval z)
      (c * ‖L‖ ^ 2) (r i) (a i) (b i)) := by
  have hB₀ : 0 ≤ B := (norm_nonneg q).trans hB
  obtain ⟨L, hL, hLpos, hbound, hLnorm⟩ :=
    Erdos1047DegreeRaise.exists_real_complex_scale_bound hn hR hA hB₀ heps₀
  refine ⟨L, hL, ?_⟩
  intro i
  have hboundi : A * (2 * (R / L.re) + (R / L.re) ^ 2 + B / L.re ^ n) <
      (hcert i).eps := lt_of_lt_of_le hbound (heps i)
  apply raised_robust_certificate_of_uniform_bound hn hL (hcert i)
    R A B L.re (hRₐ i) (hAₐ i) (hRᵦ i) (hAᵦ i) (hRₘ i) (hAₘ i)
      hB (by positivity) ?_ hboundi
  rw [hLnorm]

/-! The common-scale construction can be made eventual: once the uniform
    margin and segment bounds are fixed, every sufficiently large positive
    real scale transports the whole witness family at once. -/
theorem eventually_common_scale_raised_robust_certificates
    {ι : Type*} {p : ℂ[X]} {n : ℕ} {q : ℂ} {c eps₀ R A B : ℝ}
    {r a b : ι → ℂ}
    (hn : 2 ≤ n) (hR : 0 ≤ R) (hA : 0 ≤ A) (hB : ‖q‖ ≤ B)
    (heps₀ : 0 < eps₀)
    (hcert : ∀ i, RobustNonconvexCertificate
      (fun z : ℂ => p.eval z) c (r i) (a i) (b i))
    (heps : ∀ i, eps₀ ≤ (hcert i).eps)
    (hRₐ : ∀ i z, z ∈ segment ℝ (r i) (a i) → ‖z‖ ≤ R)
    (hAₐ : ∀ i z, z ∈ segment ℝ (r i) (a i) → ‖p.eval z‖ ≤ A)
    (hRᵦ : ∀ i z, z ∈ segment ℝ (r i) (b i) → ‖z‖ ≤ R)
    (hAᵦ : ∀ i z, z ∈ segment ℝ (r i) (b i) → ‖p.eval z‖ ≤ A)
    (hRₘ : ∀ i, ‖midpoint ℝ (a i) (b i)‖ ≤ R)
    (hAₘ : ∀ i, ‖p.eval (midpoint ℝ (a i) (b i))‖ ≤ A) :
    ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L → ∀ i,
      Nonempty (RobustNonconvexCertificate
        (fun z : ℂ => (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
          (Erdos1047DegreeRaise.raiseParameter n q (L : ℂ))).eval z)
        (c * ‖(L : ℂ)‖ ^ 2) (r i) (a i) (b i)) := by
  have hB₀ : 0 ≤ B := (norm_nonneg q).trans hB
  obtain ⟨L₀, hL₀⟩ := Erdos1047DegreeRaise.exists_large_scale_bound
    hn hR hA hB₀ heps₀
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL i
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hLpos)
    have hLnorm : L = ‖(L : ℂ)‖ := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
    have hbound : A * (2 * (R / L) + (R / L) ^ 2 + B / L ^ n) < eps₀ :=
      hL₀ L (le_trans (le_max_left _ _) hL)
    have hboundi : A * (2 * (R / L) + (R / L) ^ 2 + B / L ^ n) <
        (hcert i).eps := lt_of_lt_of_le hbound (heps i)
    apply raised_robust_certificate_of_uniform_bound hn hLne (hcert i)
      R A B L (hRₐ i) (hAₐ i) (hRᵦ i) (hAᵦ i) (hRₘ i) (hAₘ i)
      hB hLpos hLnorm.le hboundi

/-! The same eventual-family statement for a quadratic factor whose normalized
    limit is a positive scalar multiple `β p`.  The factor parameter is now
    allowed to depend on the scale as `((β-1)L²)`; this is the analytic bridge
    for barriers that need a non-small quadratic factor. -/
theorem raised_robust_certificate_of_scaled_close_of_pos_scalar_real
    {p : ℂ[X]} {L : ℝ} {c : ℝ} {r a b : ℂ} {β δ : ℝ}
    (hLpos : 0 < L)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b)
    (hβ : 0 < β) (hδ : 0 ≤ δ) (hδlt : δ < β * hcert.eps)
    (hA : ∀ z ∈ segment ℝ r a,
      ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
          (((β : ℂ) - 1) * (L : ℂ) ^ 2)).eval z / (L : ℂ) ^ 2 -
          (β : ℂ) * p.eval z‖ ≤ δ)
    (hB : ∀ z ∈ segment ℝ r b,
      ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
          (((β : ℂ) - 1) * (L : ℂ) ^ 2)).eval z / (L : ℂ) ^ 2 -
          (β : ℂ) * p.eval z‖ ≤ δ)
    (hM : ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
        (((β : ℂ) - 1) * (L : ℂ) ^ 2)).eval
        (midpoint ℝ a b) / (L : ℂ) ^ 2 -
          (β : ℂ) * p.eval (midpoint ℝ a b)‖ ≤ δ) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ =>
        (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
          (((β : ℂ) - 1) * (L : ℂ) ^ 2)).eval z)
      (β * c * ‖(L : ℂ)‖ ^ 2) r a b) := by
  let hcertβ : RobustNonconvexCertificate
      (fun z : ℂ => (β : ℂ) * p.eval z) (β * c) r a b :=
    { eps := β * hcert.eps
      eps_pos := mul_pos hβ hcert.eps_pos
      lineA_margin := by
        intro z hz
        have hmul := mul_le_mul_of_nonneg_right (hcert.lineA_margin z hz)
          (le_of_lt hβ)
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hβ]
        nlinarith
      lineB_margin := by
        intro z hz
        have hmul := mul_le_mul_of_nonneg_right (hcert.lineB_margin z hz)
          (le_of_lt hβ)
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hβ]
        nlinarith
      midpoint_margin := by
        have hmul := mul_le_mul_of_nonneg_right hcert.midpoint_margin
          (le_of_lt hβ)
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hβ]
        nlinarith }
  let G : ℂ → ℂ := fun z =>
    (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
      (((β : ℂ) - 1) * (L : ℂ) ^ 2)).eval z / (L : ℂ) ^ 2
  obtain ⟨hG⟩ := RobustNonconvexCertificate.of_uniform_close hcertβ hδ
    (by simpa [hcertβ] using hδlt)
    (by intro z hz; simpa [G, hcertβ] using hA z hz)
    (by intro z hz; simpa [G, hcertβ] using hB z hz)
    (by simpa [G, hcertβ] using hM)
  let ell2 : ℝ := ‖(L : ℂ)‖ ^ 2
  have hell2pos : 0 < ell2 := by
    dsimp [ell2]
    have hnormpos : 0 < ‖(L : ℂ)‖ := by
      simpa [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
    positivity
  have hnorm (z : ℂ) :
      ‖(Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
        (((β : ℂ) - 1) * (L : ℂ) ^ 2)).eval z‖ = ell2 * ‖G z‖ := by
    dsimp [G, ell2]
    rw [norm_div, norm_pow]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
    field_simp [ne_of_gt hLpos]
  refine ⟨⟨ell2 * hG.eps, mul_pos hell2pos hG.eps_pos, ?_, ?_, ?_⟩⟩
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_left (hG.lineA_margin z hz)
      (le_of_lt hell2pos)
    rw [hnorm z]
    dsimp [ell2]
    nlinarith
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_left (hG.lineB_margin z hz)
      (le_of_lt hell2pos)
    rw [hnorm z]
    dsimp [ell2]
    nlinarith
  · have hmul := mul_le_mul_of_nonneg_left hG.midpoint_margin
      (le_of_lt hell2pos)
    rw [hnorm (midpoint ℝ a b)]
    dsimp [ell2]
    nlinarith

theorem eventually_common_scale_raised_robust_certificates_of_d_eq_sub_one_mul_sq
    {ι : Type*} {p : ℂ[X]} {c eps₀ R A β : ℝ}
    {r a b : ι → ℂ}
    (hβ : 0 < β) (hR : 0 ≤ R) (hA : 0 ≤ A)
    (heps₀ : 0 < eps₀)
    (hcert : ∀ i, RobustNonconvexCertificate
      (fun z : ℂ => p.eval z) c (r i) (a i) (b i))
    (heps : ∀ i, eps₀ ≤ (hcert i).eps)
    (hRₐ : ∀ i z, z ∈ segment ℝ (r i) (a i) → ‖z‖ ≤ R)
    (hAₐ : ∀ i z, z ∈ segment ℝ (r i) (a i) → ‖p.eval z‖ ≤ A)
    (hRᵦ : ∀ i z, z ∈ segment ℝ (r i) (b i) → ‖z‖ ≤ R)
    (hAᵦ : ∀ i z, z ∈ segment ℝ (r i) (b i) → ‖p.eval z‖ ≤ A)
    (hRₘ : ∀ i, ‖midpoint ℝ (a i) (b i)‖ ≤ R)
    (hAₘ : ∀ i, ‖p.eval (midpoint ℝ (a i) (b i))‖ ≤ A) :
    ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L → ∀ i,
      Nonempty (RobustNonconvexCertificate
        (fun z : ℂ =>
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
            (((β : ℂ) - 1) * (L : ℂ) ^ 2)).eval z)
        (β * c * ‖(L : ℂ)‖ ^ 2) (r i) (a i) (b i)) := by
  have hβeps : 0 < β * eps₀ := mul_pos hβ heps₀
  obtain ⟨L₀, hL₀⟩ := Erdos1047DegreeRaise.exists_large_scale_bound
    (n := 2) (by omega) hR hA (by norm_num : (0 : ℝ) ≤ 0) hβeps
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL i
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hLpos)
    have hLnorm : L = ‖(L : ℂ)‖ := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
    have hLell : L ≤ ‖(L : ℂ)‖ := le_of_eq hLnorm
    let δ : ℝ := A * (2 * (R / L) + (R / L) ^ 2)
    have hδ : 0 ≤ δ := by
      dsimp [δ]
      positivity
    have hbound : A * (2 * (R / L) + (R / L) ^ 2 + 0 / L ^ 2) <
        β * eps₀ := hL₀ L (le_trans (le_max_left _ _) hL)
    have hδlt : δ < β * (hcert i).eps := by
      have hδlt₀ : δ < β * eps₀ := by simpa [δ] using hbound
      exact lt_of_lt_of_le hδlt₀
        (mul_le_mul_of_nonneg_left (heps i) (le_of_lt hβ))
    apply raised_robust_certificate_of_scaled_close_of_pos_scalar_real
      (p := p) (L := L)
      (c := c) (r := r i) (a := a i) (b := b i)
      (β := β) (δ := δ) hLpos (hcert i) hβ hδ hδlt
    · intro z hz
      have hbase :=
        Erdos1047DegreeRaise.raisePolynomial_scaled_difference_norm_le_on_segment_of_d_eq_sub_one_mul_sq
          p (L : ℂ) (β : ℂ) (r i) (a i) R A L hLne
            (hRₐ i) (hAₐ i) hLpos hLell z hz
      simpa [δ] using hbase
    · intro z hz
      have hbase :=
        Erdos1047DegreeRaise.raisePolynomial_scaled_difference_norm_le_on_segment_of_d_eq_sub_one_mul_sq
          p (L : ℂ) (β : ℂ) (r i) (b i) R A L hLne
            (hRᵦ i) (hAᵦ i) hLpos hLell z hz
      simpa [δ] using hbase
    · have hR0 : 0 ≤ R := hR
      have hratio : ‖midpoint ℝ (a i) (b i) / (L : ℂ)‖ ≤ R / L := by
        rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
        exact div_le_div₀ hR0 (hRₘ i) hLpos (le_rfl)
      have hratio_sq : ‖midpoint ℝ (a i) (b i) / (L : ℂ)‖ ^ 2 ≤
          (R / L) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hratio 2
      have hbase :=
        Erdos1047DegreeRaise.raisePolynomial_scaled_difference_norm_le_of_d_eq_sub_one_mul_sq
          p (L : ℂ) (β : ℂ) (midpoint ℝ (a i) (b i)) hLne
      calc
        _ ≤ ‖p.eval (midpoint ℝ (a i) (b i))‖ *
            (2 * ‖midpoint ℝ (a i) (b i) / (L : ℂ)‖ +
              ‖midpoint ℝ (a i) (b i) / (L : ℂ)‖ ^ 2) := hbase
        _ ≤ A * (2 * ‖midpoint ℝ (a i) (b i) / (L : ℂ)‖ +
              ‖midpoint ℝ (a i) (b i) / (L : ℂ)‖ ^ 2) := by
          apply mul_le_mul_of_nonneg_right (hAₘ i)
          positivity
        _ ≤ δ := by
          dsimp [δ]
          have hsum : 2 * ‖midpoint ℝ (a i) (b i) / (L : ℂ)‖ +
                ‖midpoint ℝ (a i) (b i) / (L : ℂ)‖ ^ 2 ≤
              2 * (R / L) + (R / L) ^ 2 := by
            nlinarith [hratio, hratio_sq]
          exact mul_le_mul_of_nonneg_left hsum hA

/-! A scaled degree-raising perturbation preserves any robust non-convexity
certificate once the uniform approximation estimates have been supplied.  The
normalization by `L ^ 2` is removed at the end by an exact norm identity, so
the conclusion is stated directly for the raised polynomial and its rescaled
level. -/
theorem raised_nonconvex_component_of_scaled_close
    {p : ℂ[X]} {L d : ℂ} {c : ℝ} {r a b : ℂ}
    (hL : L ≠ 0)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b)
    (hA : ∀ z ∈ segment ℝ r a,
      ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval z / L ^ 2 - p.eval z‖ <
        hcert.eps)
    (hB : ∀ z ∈ segment ℝ r b,
      ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval z / L ^ 2 - p.eval z‖ <
        hcert.eps)
    (hM : ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval
        (midpoint ℝ a b) / L ^ 2 - p.eval (midpoint ℝ a b)‖ < hcert.eps) :
    ¬ Convex ℝ (connectedComponentIn
      (Erdos1047.sublevelSet (Erdos1047DegreeRaise.raisePolynomial p L d)
        (c * ‖L‖ ^ 2)) r) := by
  let G : ℂ → ℂ := fun z =>
    (Erdos1047DegreeRaise.raisePolynomial p L d).eval z / L ^ 2
  have hstable : ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖G z‖ ≤ c} r) := by
    apply hcert.stable
    · intro z hz
      simpa [G] using hA z hz
    · intro z hz
      simpa [G] using hB z hz
    · simpa [G] using hM
  have hset : Erdos1047.sublevelSet
      (Erdos1047DegreeRaise.raisePolynomial p L d) (c * ‖L‖ ^ 2) =
      {z : ℂ | ‖G z‖ ≤ c} := by
    ext z
    change ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval z‖ ≤
      c * ‖L‖ ^ 2 ↔ ‖G z‖ ≤ c
    rw [norm_div, norm_pow]
    have hq : 0 < ‖L‖ ^ 2 := by positivity
    rw [div_le_iff₀ hq]
  rw [hset]
  exact hstable

/-! A quadratic degree-raise can converge to a positive scalar multiple of the
    old polynomial, not only to the old polynomial itself.  This version is
    useful when the factor is normalized with a non-unit real value (for
    example, choosing `d = L^2` gives the limiting scalar `β = 2`). -/
theorem raised_robust_certificate_of_scaled_close_of_pos_scalar
    {p : ℂ[X]} {L d : ℂ} {c : ℝ} {r a b : ℂ} {β δ : ℝ}
    (hL : L ≠ 0)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b)
    (hβ : 0 < β) (hδ : 0 ≤ δ) (hδlt : δ < β * hcert.eps)
    (hA : ∀ z ∈ segment ℝ r a,
      ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval z / L ^ 2 -
          (β : ℂ) * p.eval z‖ ≤ δ)
    (hB : ∀ z ∈ segment ℝ r b,
      ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval z / L ^ 2 -
          (β : ℂ) * p.eval z‖ ≤ δ)
    (hM : ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval
        (midpoint ℝ a b) / L ^ 2 -
          (β : ℂ) * p.eval (midpoint ℝ a b)‖ ≤ δ) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047DegreeRaise.raisePolynomial p L d).eval z)
      (β * c * ‖L‖ ^ 2) r a b) := by
  let hcertβ : RobustNonconvexCertificate
      (fun z : ℂ => (β : ℂ) * p.eval z) (β * c) r a b :=
    { eps := β * hcert.eps
      eps_pos := mul_pos hβ hcert.eps_pos
      lineA_margin := by
        intro z hz
        have hmul := mul_le_mul_of_nonneg_right (hcert.lineA_margin z hz)
          (le_of_lt hβ)
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hβ]
        nlinarith
      lineB_margin := by
        intro z hz
        have hmul := mul_le_mul_of_nonneg_right (hcert.lineB_margin z hz)
          (le_of_lt hβ)
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hβ]
        nlinarith
      midpoint_margin := by
        have hmul := mul_le_mul_of_nonneg_right hcert.midpoint_margin
          (le_of_lt hβ)
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hβ]
        nlinarith }
  let G : ℂ → ℂ := fun z =>
    (Erdos1047DegreeRaise.raisePolynomial p L d).eval z / L ^ 2
  obtain ⟨hG⟩ := RobustNonconvexCertificate.of_uniform_close hcertβ hδ
    (by simpa [hcertβ] using hδlt)
    (by intro z hz; simpa [G, hcertβ] using hA z hz)
    (by intro z hz; simpa [G, hcertβ] using hB z hz)
    (by simpa [G, hcertβ] using hM)
  let ell2 : ℝ := ‖L‖ ^ 2
  have hell2pos : 0 < ell2 := by
    dsimp [ell2]
    have hnormpos : 0 < ‖L‖ := norm_pos_iff.mpr hL
    positivity
  have hnorm (z : ℂ) :
      ‖(Erdos1047DegreeRaise.raisePolynomial p L d).eval z‖ =
        ell2 * ‖G z‖ := by
    dsimp [G, ell2]
    rw [norm_div, norm_pow]
    field_simp [hL]
  refine ⟨⟨ell2 * hG.eps, mul_pos hell2pos hG.eps_pos, ?_, ?_, ?_⟩⟩
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_left (hG.lineA_margin z hz)
      (le_of_lt hell2pos)
    rw [hnorm z]
    dsimp [ell2]
    nlinarith
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_left (hG.lineB_margin z hz)
      (le_of_lt hell2pos)
    rw [hnorm z]
    dsimp [ell2]
    nlinarith
  · have hmul := mul_le_mul_of_nonneg_left hG.midpoint_margin
      (le_of_lt hell2pos)
    rw [hnorm (midpoint ℝ a b)]
    dsimp [ell2]
    nlinarith

/-! The same stability argument for the quartic gadget.  Near the old
    component the product is normalized by `L⁴`, so the level and certificate
    margin scale by `‖L‖⁴` rather than `‖L‖²`. -/
theorem quartic_raised_robust_certificate_of_scaled_close
    {p : ℂ[X]} {L s : ℂ} {c : ℝ} {r a b : ℂ} {δ : ℝ}
    (hL : L ≠ 0)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b)
    (hδ : 0 ≤ δ) (hδlt : δ < hcert.eps)
    (hA : ∀ z ∈ segment ℝ r a,
      ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z / L ^ 4 -
          p.eval z‖ ≤ δ)
    (hB : ∀ z ∈ segment ℝ r b,
      ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z / L ^ 4 -
          p.eval z‖ ≤ δ)
    (hM : ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval
        (midpoint ℝ a b) / L ^ 4 - p.eval (midpoint ℝ a b)‖ ≤ δ) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z)
      (c * ‖L‖ ^ 4) r a b) := by
  let G : ℂ → ℂ := fun z =>
    (Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z / L ^ 4
  obtain ⟨hG⟩ := RobustNonconvexCertificate.of_uniform_close hcert hδ hδlt
    (by intro z hz; simpa [G] using hA z hz)
    (by intro z hz; simpa [G] using hB z hz)
    (by simpa [G] using hM)
  let ell4 : ℝ := ‖L‖ ^ 4
  have hell4pos : 0 < ell4 := by
    dsimp [ell4]
    have hnormpos : 0 < ‖L‖ := norm_pos_iff.mpr hL
    positivity
  have hnorm (z : ℂ) :
      ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z‖ =
        ell4 * ‖G z‖ := by
    dsimp [G, ell4]
    rw [norm_div, norm_pow]
    field_simp [hL]
  refine ⟨⟨ell4 * hG.eps, mul_pos hell4pos hG.eps_pos, ?_, ?_, ?_⟩⟩
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_left (hG.lineA_margin z hz)
      (le_of_lt hell4pos)
    rw [hnorm z]
    dsimp [ell4]
    nlinarith
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_left (hG.lineB_margin z hz)
      (le_of_lt hell4pos)
    rw [hnorm z]
    dsimp [ell4]
    nlinarith
  · have hmul := mul_le_mul_of_nonneg_left hG.midpoint_margin
      (le_of_lt hell4pos)
    rw [hnorm (midpoint ℝ a b)]
    dsimp [ell4]
    nlinarith

/-! The old-region transport remains valid after a positive real rescaling of
    the base certificate.  This is useful when the quartic chart is normalized
    by a value of the old polynomial that is not exactly one: the common target
    level can then be chosen by matching the scaled old certificate to the
    four-root chart. -/
theorem quartic_raised_robust_certificate_of_scaled_close_of_pos_scalar
    {p : ℂ[X]} {L s : ℂ} {c : ℝ} {r a b : ℂ} {β δ : ℝ}
    (hL : L ≠ 0)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b)
    (hβ : 0 < β) (hδ : 0 ≤ δ) (hδlt : δ < β * hcert.eps)
    (hA : ∀ z ∈ segment ℝ r a,
      ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z / L ^ 4 -
          (β : ℂ) * p.eval z‖ ≤ δ)
    (hB : ∀ z ∈ segment ℝ r b,
      ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z / L ^ 4 -
          (β : ℂ) * p.eval z‖ ≤ δ)
    (hM : ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval
        (midpoint ℝ a b) / L ^ 4 -
          (β : ℂ) * p.eval (midpoint ℝ a b)‖ ≤ δ) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z)
      (β * c * ‖L‖ ^ 4) r a b) := by
  let hcertβ : RobustNonconvexCertificate
      (fun z : ℂ => (β : ℂ) * p.eval z) (β * c) r a b :=
    { eps := β * hcert.eps
      eps_pos := mul_pos hβ hcert.eps_pos
      lineA_margin := by
        intro z hz
        have hmul := mul_le_mul_of_nonneg_right (hcert.lineA_margin z hz)
          (le_of_lt hβ)
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hβ]
        nlinarith
      lineB_margin := by
        intro z hz
        have hmul := mul_le_mul_of_nonneg_right (hcert.lineB_margin z hz)
          (le_of_lt hβ)
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hβ]
        nlinarith
      midpoint_margin := by
        have hmul := mul_le_mul_of_nonneg_right hcert.midpoint_margin
          (le_of_lt hβ)
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hβ]
        nlinarith }
  let G : ℂ → ℂ := fun z =>
    (Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z / L ^ 4
  obtain ⟨hG⟩ := RobustNonconvexCertificate.of_uniform_close hcertβ hδ
    (by simpa [hcertβ] using hδlt)
    (by intro z hz; simpa [G, hcertβ] using hA z hz)
    (by intro z hz; simpa [G, hcertβ] using hB z hz)
    (by simpa [G, hcertβ] using hM)
  let ell4 : ℝ := ‖L‖ ^ 4
  have hell4pos : 0 < ell4 := by
    dsimp [ell4]
    have hnormpos : 0 < ‖L‖ := norm_pos_iff.mpr hL
    positivity
  have hnorm (z : ℂ) :
      ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p L s).eval z‖ =
        ell4 * ‖G z‖ := by
    dsimp [G, ell4]
    rw [norm_div, norm_pow]
    field_simp [hL]
  refine ⟨⟨ell4 * hG.eps, mul_pos hell4pos hG.eps_pos, ?_, ?_, ?_⟩⟩
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_left (hG.lineA_margin z hz)
      (le_of_lt hell4pos)
    rw [hnorm z]
    dsimp [ell4]
    nlinarith
  · intro z hz
    have hmul := mul_le_mul_of_nonneg_left (hG.lineB_margin z hz)
      (le_of_lt hell4pos)
    rw [hnorm z]
    dsimp [ell4]
    nlinarith
  · have hmul := mul_le_mul_of_nonneg_left hG.midpoint_margin
      (le_of_lt hell4pos)
    rw [hnorm (midpoint ℝ a b)]
    dsimp [ell4]
    nlinarith

/-! The preceding theorem is the geometric transport step.  This wrapper
packages the uniform estimate from `Erdos1047DegreeRaise` so that an eventual
degree-raising construction only has to provide elementary bounds on the two
segments and their midpoint. -/
theorem raised_nonconvex_component_of_uniform_bound
    {p : ℂ[X]} {n : ℕ} {q L : ℂ} {c : ℝ} {r a b : ℂ}
    (hn : 2 ≤ n) (hL : L ≠ 0)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b)
    (R A B ell : ℝ)
    (hRₐ : ∀ z ∈ segment ℝ r a, ‖z‖ ≤ R)
    (hAₐ : ∀ z ∈ segment ℝ r a, ‖p.eval z‖ ≤ A)
    (hRᵦ : ∀ z ∈ segment ℝ r b, ‖z‖ ≤ R)
    (hAᵦ : ∀ z ∈ segment ℝ r b, ‖p.eval z‖ ≤ A)
    (hRₘ : ‖midpoint ℝ a b‖ ≤ R)
    (hAₘ : ‖p.eval (midpoint ℝ a b)‖ ≤ A)
    (hB : ‖q‖ ≤ B) (hell : 0 < ell) (hLell : ell ≤ ‖L‖)
    (hbound : A * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n) < hcert.eps) :
    ¬ Convex ℝ (connectedComponentIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p L
          (Erdos1047DegreeRaise.raiseParameter n q L))
        (c * ‖L‖ ^ 2)) r) := by
  refine raised_nonconvex_component_of_scaled_close
    (d := Erdos1047DegreeRaise.raiseParameter n q L) hL hcert ?_ ?_ ?_
  · intro z hz
    have hle := Erdos1047DegreeRaise.raisePolynomial_scaled_difference_norm_le_on_segment
      p n q L r a R A B ell hn hL hRₐ hAₐ hB hell hLell z hz
    exact lt_of_le_of_lt hle hbound
  · intro z hz
    have hle := Erdos1047DegreeRaise.raisePolynomial_scaled_difference_norm_le_on_segment
      p n q L r b R A B ell hn hL hRᵦ hAᵦ hB hell hLell z hz
    exact lt_of_le_of_lt hle hbound
  · have hle := Erdos1047DegreeRaise.raisePolynomial_scaled_difference_norm_le_at_point_of_bounds
      p n q L (midpoint ℝ a b) R A B ell hn hL hRₘ hAₘ hB hell hLell
    exact lt_of_le_of_lt hle hbound

/-! A robust certificate can always be transported along sufficiently large
    positive real scales.  This packages the compact-segment bounds and the
    quantitative scale selection into one eventual statement.  It does not
    assert component separation; that remains the genuinely global part of
    the degree-raising argument. -/
theorem exists_eventual_large_scale_raised_nonconvex_component
    {p : ℂ[X]} {n : ℕ} {q : ℂ} {c : ℝ} {r a b : ℂ}
    (hn : 2 ≤ n)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b) :
    ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ¬ Convex ℝ (connectedComponentIn
        (Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
            (Erdos1047DegreeRaise.raiseParameter n q (L : ℂ)))
          (c * ‖(L : ℂ)‖ ^ 2)) r) := by
  obtain ⟨R, A, hRₐ, hAₐ, hRᵦ, hAᵦ, hRₘ, hAₘ⟩ :=
    Erdos1047DegreeRaise.exists_two_segment_eval_bounds p r a b
  have hR : 0 ≤ R := (norm_nonneg (midpoint ℝ a b)).trans hRₘ
  have hA : 0 ≤ A := (norm_nonneg (p.eval (midpoint ℝ a b))).trans hAₘ
  have hB : 0 ≤ ‖q‖ := norm_nonneg q
  obtain ⟨L₀, hL₀⟩ := Erdos1047DegreeRaise.exists_large_scale_bound
    hn hR hA hB hcert.eps_pos
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hLpos)
    have hLnorm : L = ‖(L : ℂ)‖ := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
    apply raised_nonconvex_component_of_uniform_bound
      hn hLne hcert R A ‖q‖ L
      hRₐ hAₐ hRᵦ hAᵦ hRₘ hAₘ
      (le_rfl) hLpos hLnorm.le
    exact hL₀ L (le_trans (le_max_left _ _) hL)

/-! Compact-set variant of the preceding transport lemma.  This is useful when
    the geometric separator is described by a compact zero set rather than by
    two explicitly bounded line segments: the normalized raised evaluations
    converge uniformly on that compact set, and the robust witness only asks
    for the two segments and their midpoint. -/
theorem exists_eventual_large_scale_raised_nonconvex_component_of_compact
    {p : ℂ[X]} {n : ℕ} {q : ℂ} {c : ℝ} {r a b : ℂ}
    (hn : 2 ≤ n)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b)
    (K : Set ℂ) (hK : IsCompact K)
    (hsegA : segment ℝ r a ⊆ K)
    (hsegB : segment ℝ r b ⊆ K)
    (hmid : midpoint ℝ a b ∈ K) :
    ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ¬ Convex ℝ (connectedComponentIn
        (Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p (L : ℂ)
            (Erdos1047DegreeRaise.raiseParameter n q (L : ℂ)))
          (c * ‖(L : ℂ)‖ ^ 2)) r) := by
  obtain ⟨L₀, hL₀pos, hL₀⟩ := Erdos1047DegreeRaise.exists_uniform_scaled_difference_on_compact
    p n q K hK hn hcert.eps hcert.eps_pos
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hLpos)
    apply raised_nonconvex_component_of_scaled_close hLne hcert
    · intro z hz
      exact hL₀ L (le_trans (le_max_left _ _) hL) z (hsegA hz)
    · intro z hz
      exact hL₀ L (le_trans (le_max_left _ _) hL) z (hsegB hz)
    · exact hL₀ L (le_trans (le_max_left _ _) hL)
        (midpoint ℝ a b) hmid

/-! Quartic analogue of the compact transport lemma.  The factor is normalized
    by `L⁴`; taking half the old certificate margin turns the strict compact
    estimate into the non-strict inequalities consumed by the quartic stability
    theorem.  This proves preservation of an old non-convex witness only. -/
theorem exists_eventual_large_scale_quartic_raised_nonconvex_component_of_compact
    {p : ℂ[X]} {s : ℂ} {c : ℝ} {r a b : ℂ}
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b)
    (K : Set ℂ) (hK : IsCompact K)
    (hsegA : segment ℝ r a ⊆ K)
    (hsegB : segment ℝ r b ⊆ K)
    (hmid : midpoint ℝ a b ∈ K) :
    ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ¬ Convex ℝ (connectedComponentIn
        (Erdos1047.sublevelSet
          (Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) s)
          (c * ‖(L : ℂ)‖ ^ 4)) r) := by
  have hhalf_pos : 0 < hcert.eps / 2 := by linarith [hcert.eps_pos]
  have hhalf_nonneg : 0 ≤ hcert.eps / 2 := le_of_lt hhalf_pos
  have hhalf_lt : hcert.eps / 2 < hcert.eps := by linarith [hcert.eps_pos]
  obtain ⟨L₀, hL₀pos, hL₀⟩ :=
    Erdos1047QuarticRaise.exists_uniform_quarticRaisePolynomial_scaled_difference_on_compact
      p s K hK (hcert.eps / 2) hhalf_pos
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hLpos)
    have hA : ∀ z ∈ segment ℝ r a,
        ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) s).eval z /
            (L : ℂ) ^ 4 - p.eval z‖ ≤ hcert.eps / 2 := by
      intro z hz
      exact (hL₀ L (le_trans (le_max_left _ _) hL) z (hsegA hz)).le
    have hB : ∀ z ∈ segment ℝ r b,
        ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) s).eval z /
            (L : ℂ) ^ 4 - p.eval z‖ ≤ hcert.eps / 2 := by
      intro z hz
      exact (hL₀ L (le_trans (le_max_left _ _) hL) z (hsegB hz)).le
    have hM :
        ‖(Erdos1047QuarticRaise.quarticRaisePolynomial p (L : ℂ) s).eval
            (midpoint ℝ a b) / (L : ℂ) ^ 4 -
          p.eval (midpoint ℝ a b)‖ ≤ hcert.eps / 2 := by
      exact (hL₀ L (le_trans (le_max_left _ _) hL)
        (midpoint ℝ a b) hmid).le
    obtain ⟨hc⟩ := quartic_raised_robust_certificate_of_scaled_close
      hLne hcert hhalf_nonneg hhalf_lt hA hB hM
    simpa [sublevelSet] using hc.not_convex_component

/-! The scale-selection interface is separated from the geometric construction:
    once segment bounds and a positive certificate margin are known, a real
    center scale can be chosen large enough for the uniform perturbation error. -/
theorem exists_real_scale_for_degree_raise
    {n : ℕ} (hn : 2 ≤ n) {R A B eps : ℝ}
    (hR : 0 ≤ R) (hA : 0 ≤ A) (hB : 0 ≤ B) (heps : 0 < eps) :
    ∃ L : ℂ, L ≠ 0 ∧ 0 < L.re ∧
      A * (2 * (R / L.re) + (R / L.re) ^ 2 + B / L.re ^ n) < eps ∧
      L.re = ‖L‖ := by
  exact Erdos1047DegreeRaise.exists_real_complex_scale_bound hn hR hA hB heps

/-! Scale selection with the finite root-avoidance condition included.  The
core theorem chooses a positive real center above both the analytic threshold
and the finitely many forbidden centers. -/
theorem exists_real_scale_for_degree_raise_avoiding_roots
    {p : ℂ[X]} {n : ℕ} {e : ℂ} (hn : 2 ≤ n) (he : e ≠ 0)
    {R A B eps : ℝ} (hR : 0 ≤ R) (hA : 0 ≤ A)
    (hB : ‖e ^ 2‖ ≤ B) (heps : 0 < eps) :
    ∃ L : ℂ, L ≠ 0 ∧ 0 < L.re ∧ L.re = ‖L‖ ∧
      A * (2 * (R / L.re) + (R / L.re) ^ 2 + B / L.re ^ n) < eps ∧
      ∀ z ∈ p.rootSet ℂ, (z - L) ^ 2 + e ^ 2 ≠ 0 := by
  exact Erdos1047DegreeRaise.exists_large_real_center_avoiding_rootSet
    p e he hn hR hA hB heps

/-! The preceding choice also closes the algebraic side of the raising step:
the raised polynomial is separable and has exactly two more distinct roots.
The remaining missing part is geometric component preservation. -/
theorem exists_real_scale_for_degree_raise_separable
    {p : ℂ[X]} {n : ℕ} {e : ℂ} (hn : 2 ≤ n)
    (hp : p.Monic) (hpsep : p.Separable) (he : e ≠ 0)
    {R A B eps : ℝ} (hR : 0 ≤ R) (hA : 0 ≤ A)
    (hB : ‖e ^ 2‖ ≤ B) (heps : 0 < eps) :
    ∃ L : ℂ, L ≠ 0 ∧ 0 < L.re ∧ L.re = ‖L‖ ∧
      A * (2 * (R / L.re) + (R / L.re) ^ 2 + B / L.re ^ n) < eps ∧
      (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).Separable ∧
      ((Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).rootSet ℂ).ncard =
        p.natDegree + 2 := by
  obtain ⟨L, hL, hLpos, hLnorm, hbound, havoid⟩ :=
    exists_real_scale_for_degree_raise_avoiding_roots hn he hR hA hB heps
  have hcop : IsCoprime p (Erdos1047DegreeRaise.raiseFactor L (e ^ 2)) :=
    Erdos1047DegreeRaise.raiseFactor_coprime_of_no_common_root p L (e ^ 2) (by
      intro z hz hfactor
      exact havoid z (hp.mem_rootSet.mpr hz) hfactor)
  have hsep : (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).Separable :=
    Erdos1047DegreeRaise.raisePolynomial_separable p L (e ^ 2) hpsep
      (pow_ne_zero 2 he) hcop
  have hroot := Erdos1047DegreeRaise.raisePolynomial_rootSet_ncard
    p L (e ^ 2) hp hpsep (pow_ne_zero 2 he) hcop
  exact ⟨L, hL, hLpos, hLnorm, hbound, hsep, hroot⟩

theorem exists_large_scale_raised_nonconvex_component
    {p : ℂ[X]} {n : ℕ} {q : ℂ} {c : ℝ} {r a b : ℂ}
    (hn : 2 ≤ n)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b) :
    ∃ L : ℂ, L ≠ 0 ∧
      ¬ Convex ℝ (connectedComponentIn
        (Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p L
            (Erdos1047DegreeRaise.raiseParameter n q L))
          (c * ‖L‖ ^ 2)) r) := by
  obtain ⟨R, A, hRₐ, hAₐ, hRᵦ, hAᵦ, hRₘ, hAₘ⟩ :=
    Erdos1047DegreeRaise.exists_two_segment_eval_bounds p r a b
  have hR : 0 ≤ R := (norm_nonneg (midpoint ℝ a b)).trans hRₘ
  have hA : 0 ≤ A := (norm_nonneg (p.eval (midpoint ℝ a b))).trans hAₘ
  have hB : 0 ≤ ‖q‖ := norm_nonneg q
  obtain ⟨L, hL, hLpos, hbound, hLnorm⟩ :=
    exists_real_scale_for_degree_raise hn hR hA hB hcert.eps_pos
  refine ⟨L, hL, ?_⟩
  apply raised_nonconvex_component_of_uniform_bound hn hL hcert
    R A ‖q‖ (L.re) hRₐ hAₐ hRᵦ hAᵦ hRₘ hAₘ (le_refl _) (by positivity) ?_ hbound
  rw [hLnorm]

/-! The algebraic and geometric interfaces can be combined: a separable base
polynomial with one robust non-convex component raises to a separable polynomial
with exactly two additional roots, while retaining that component certificate.
The theorem still does not assert preservation of the complete component count. -/
theorem exists_large_scale_separable_raised_nonconvex_component
    {p : ℂ[X]} {e : ℂ} {c : ℝ} {r a b : ℂ}
    (hp : p.Monic) (hpsep : p.Separable) (he : e ≠ 0)
    (hcert : RobustNonconvexCertificate (fun z : ℂ => p.eval z) c r a b) :
    ∃ L : ℂ, L ≠ 0 ∧
      (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).Separable ∧
      ((Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).rootSet ℂ).ncard =
        p.natDegree + 2 ∧
      ¬ Convex ℝ (connectedComponentIn
        (Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2))
          (c * ‖L‖ ^ 2)) r) := by
  obtain ⟨R, A, hRₐ, hAₐ, hRᵦ, hAᵦ, hRₘ, hAₘ⟩ :=
    Erdos1047DegreeRaise.exists_two_segment_eval_bounds p r a b
  have hR : 0 ≤ R := (norm_nonneg (midpoint ℝ a b)).trans hRₘ
  have hA : 0 ≤ A := (norm_nonneg (p.eval (midpoint ℝ a b))).trans hAₘ
  have hB : ‖e ^ 2‖ ≤ ‖e ^ 2‖ := le_rfl
  obtain ⟨L, hL, hLpos, hLnorm, hbound, hsep, hroot⟩ :=
    exists_real_scale_for_degree_raise_separable (by omega : 2 ≤ 2) hp hpsep he hR hA hB
      hcert.eps_pos
  have hgeo : ¬ Convex ℝ (connectedComponentIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p L
          (Erdos1047DegreeRaise.raiseParameter 2 (e ^ 2) L))
        (c * ‖L‖ ^ 2)) r) := by
    apply raised_nonconvex_component_of_uniform_bound (q := e ^ 2) (n := 2)
        (by omega : 2 ≤ 2) hL hcert
      R A ‖e ^ 2‖ L.re hRₐ hAₐ hRᵦ hAᵦ hRₘ hAₘ (le_refl _) (by positivity) ?_ hbound
    rw [hLnorm]
  refine ⟨L, hL, hsep, hroot, ?_⟩
  simpa [Erdos1047DegreeRaise.raiseParameter] using hgeo

/-- Pointwise strict inclusion of a compact segment supplies a positive uniform margin. -/
theorem exists_pos_norm_margin_on_segment {F : ℂ → ℂ} {c : ℝ} {r a : ℂ}
    (hF : Continuous F) (hstrict : ∀ z ∈ segment ℝ r a, ‖F z‖ < c) :
    ∃ eps : ℝ, 0 < eps ∧ ∀ z ∈ segment ℝ r a, ‖F z‖ + eps ≤ c := by
  have hcompact : IsCompact (segment ℝ r a) := by
    rw [segment_eq_image_lineMap]
    exact isCompact_Icc.image (by fun_prop)
  have hcontinuous : Continuous (fun z ↦ c - ‖F z‖) := by fun_prop
  obtain ⟨eps, heps, hmargin⟩ := hcompact.exists_forall_le'
    hcontinuous.continuousOn (by
      intro z hz
      have := hstrict z hz
      linarith : ∀ z ∈ segment ℝ r a, 0 < c - ‖F z‖)
  exact ⟨eps, heps, fun z hz ↦ by have := hmargin z hz; linarith⟩

/-- Two strict segment inclusions and one strict midpoint exclusion can always be
combined into a single robust perturbation margin. -/
theorem robustNonconvexCertificate_of_strict
    {F : ℂ → ℂ} {c : ℝ} {r a b : ℂ} (hF : Continuous F)
    (hA : ∀ z ∈ segment ℝ r a, ‖F z‖ < c)
    (hB : ∀ z ∈ segment ℝ r b, ‖F z‖ < c)
    (hM : c < ‖F (midpoint ℝ a b)‖) :
    Nonempty (RobustNonconvexCertificate F c r a b) := by
  obtain ⟨epsA, hepsA, hmarginA⟩ := exists_pos_norm_margin_on_segment hF hA
  obtain ⟨epsB, hepsB, hmarginB⟩ := exists_pos_norm_margin_on_segment hF hB
  let epsM := ‖F (midpoint ℝ a b)‖ - c
  let eps := min epsA (min epsB epsM)
  have hepsM : 0 < epsM := by dsimp [epsM]; linarith
  have heps : 0 < eps := lt_min hepsA (lt_min hepsB hepsM)
  refine ⟨⟨eps, heps, ?_, ?_, ?_⟩⟩
  · intro z hz
    have hepsle := min_le_left epsA (min epsB epsM)
    have hline := hmarginA z hz
    linarith
  · intro z hz
    have hepsle := (min_le_right epsA (min epsB epsM)).trans
      (min_le_left epsB epsM)
    have hline := hmarginB z hz
    linarith
  · have hepsle : eps ≤ epsM :=
      (min_le_right epsA (min epsB epsM)).trans (min_le_right epsB epsM)
    dsimp [epsM] at hepsle
    linarith

/-! An explicit normalized quadratic-chart model certificate.  The split at
    `t = 16/17` is used only for the first segment, where the unnormalized
    degree-six Bernstein coefficients become strictly negative on both pieces. -/
def quadraticLocalModel (w : ℂ) : ℂ :=
  ((1 : ℂ) + (1 / 5 : ℂ) * w) * (w ^ 2 + 1)

def quadraticLocalRoot : ℂ := Complex.I

def quadraticLocalPointA : ℂ :=
  (-1 / 10 : ℂ) - (1 / 25 : ℂ) * Complex.I

def quadraticLocalPointB : ℂ :=
  (7 / 50 : ℂ) + (1 / 4 : ℂ) * Complex.I

theorem quadratic_local_model_certificate :
    Nonempty (RobustNonconvexCertificate quadraticLocalModel
      (99 / 100 : ℝ) quadraticLocalRoot
      quadraticLocalPointA quadraticLocalPointB) := by
  have hlineA : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
      Complex.normSq
        (quadraticLocalModel
          (quadraticLocalRoot + (t : ℂ) *
            (quadraticLocalPointA - quadraticLocalRoot))) <
        (99 / 100 : ℝ) ^ 2 := by
    intro t ht0 ht1
    by_cases hsplit : t ≤ 16 / 17
    · let u : ℝ := t * (17 / 16)
      have hu0 : 0 ≤ u := by dsimp [u]; positivity
      have hu1 : u ≤ 1 := by
        dsimp [u]
        nlinarith
      have hid :
          Complex.normSq
              (quadraticLocalModel
                (quadraticLocalRoot + (t : ℂ) *
                  (quadraticLocalPointA - quadraticLocalRoot))) -
            (99 / 100 : ℝ) ^ 2 =
          (-9801 / 10000 : ℝ) * u ^ 0 * (1-u) ^ 6 +
          (-29403 / 5000 : ℝ) * u ^ 1 * (1-u) ^ 5 +
          (-771555791 / 72250000 : ℝ) * u ^ 2 * (1-u) ^ 4 +
          (-60627342733 / 7676562500 : ℝ) * u ^ 3 * (1-u) ^ 3 +
          (-28225360033087 / 13050156250000 : ℝ) * u ^ 4 * (1-u) ^ 2 +
          (-224217161362923 / 2773158203125000 : ℝ) * u ^ 5 * (1-u) ^ 1 +
          (-2590483658972769 / 2357184472656250000 : ℝ) * u ^ 6 * (1-u) ^ 0 := by
        dsimp [u, quadraticLocalModel, quadraticLocalRoot,
          quadraticLocalPointA]
        norm_num [Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
        ring
      rw [← sub_neg, hid]
      exact Erdos1047CubicLower.bernstein6_neg u _ _ _ _ _ _ _ hu0 hu1
        (by norm_num) (by norm_num) (by norm_num) (by norm_num)
        (by norm_num) (by norm_num) (by norm_num)
    · let u : ℝ := 17 * t - 16
      have hu0 : 0 ≤ u := by
        dsimp [u]
        nlinarith
      have hu1 : u ≤ 1 := by
        dsimp [u]
        nlinarith
      have hid :
          Complex.normSq
              (quadraticLocalModel
                (quadraticLocalRoot + (t : ℂ) *
                  (quadraticLocalPointA - quadraticLocalRoot))) -
            (99 / 100 : ℝ) ^ 2 =
          (-2590483658972769 / 2357184472656250000 : ℝ) * u ^ 0 * (1-u) ^ 6 +
          (-135376371427827 / 69328955078125000 : ℝ) * u ^ 1 * (1-u) ^ 5 +
          (-346730128547 / 1631269531250000 : ℝ) * u ^ 2 * (1-u) ^ 4 +
          (-79043989989 / 23989257812500 : ℝ) * u ^ 3 * (1-u) ^ 3 +
          (-65696827837 / 5644531250000 : ℝ) * u ^ 4 * (1-u) ^ 2 +
          (-18384361439 / 1660156250000 : ℝ) * u ^ 5 * (1-u) ^ 1 +
          (-1316783111 / 390625000000 : ℝ) * u ^ 6 * (1-u) ^ 0 := by
        dsimp [u, quadraticLocalModel, quadraticLocalRoot,
          quadraticLocalPointA]
        norm_num [Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
        ring
      rw [← sub_neg, hid]
      exact Erdos1047CubicLower.bernstein6_neg u _ _ _ _ _ _ _ hu0 hu1
        (by norm_num) (by norm_num) (by norm_num) (by norm_num)
        (by norm_num) (by norm_num) (by norm_num)
  have hlineB : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
      Complex.normSq
        (quadraticLocalModel
          (quadraticLocalRoot + (t : ℂ) *
            (quadraticLocalPointB - quadraticLocalRoot))) <
        (99 / 100 : ℝ) ^ 2 := by
    intro t ht0 ht1
    have hid :
        Complex.normSq
            (quadraticLocalModel
              (quadraticLocalRoot + (t : ℂ) *
                (quadraticLocalPointB - quadraticLocalRoot))) -
          (99 / 100 : ℝ) ^ 2 =
        (-9801 / 10000 : ℝ) * t ^ 0 * (1-t) ^ 6 +
        (-29403 / 5000 : ℝ) * t ^ 1 * (1-t) ^ 5 +
        (-3069991 / 250000 : ℝ) * t ^ 2 * (1-t) ^ 4 +
        (-3669163 / 312500 : ℝ) * t ^ 3 * (1-t) ^ 3 +
        (-1308771777 / 250000000 : ℝ) * t ^ 4 * (1-t) ^ 2 +
        (-22142040671 / 25000000000 : ℝ) * t ^ 5 * (1-t) ^ 1 +
        (-114063968339 / 25000000000000 : ℝ) * t ^ 6 * (1-t) ^ 0 := by
      dsimp [quadraticLocalModel, quadraticLocalRoot,
        quadraticLocalPointB]
      norm_num [Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
      ring
    rw [← sub_neg, hid]
    exact Erdos1047CubicLower.bernstein6_neg t _ _ _ _ _ _ _ ht0 ht1
      (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) (by norm_num)
  have hA : ∀ z ∈ segment ℝ quadraticLocalRoot quadraticLocalPointA,
      ‖quadraticLocalModel z‖ < (99 / 100 : ℝ) :=
    Erdos1047CubicLower.segment_strict_of_parametric_normSq_lt (by norm_num) hlineA
  have hB : ∀ z ∈ segment ℝ quadraticLocalRoot quadraticLocalPointB,
      ‖quadraticLocalModel z‖ < (99 / 100 : ℝ) :=
    Erdos1047CubicLower.segment_strict_of_parametric_normSq_lt (by norm_num) hlineB
  have hM : (99 / 100 : ℝ) <
      ‖quadraticLocalModel
        (midpoint ℝ quadraticLocalPointA quadraticLocalPointB)‖ := by
    have hgt : (99 / 100 : ℝ)^2 < Complex.normSq
        (quadraticLocalModel
          (midpoint ℝ quadraticLocalPointA quadraticLocalPointB)) := by
      norm_num [quadraticLocalModel, quadraticLocalPointA,
        quadraticLocalPointB, midpoint, AffineMap.lineMap_apply_module,
        Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
    rw [Complex.normSq_eq_norm_sq] at hgt
    nlinarith [norm_nonneg (quadraticLocalModel
      (midpoint ℝ quadraticLocalPointA quadraticLocalPointB))]
  apply robustNonconvexCertificate_of_strict
  · change Continuous (fun w : ℂ =>
      ((1 : ℂ) + (1 / 5 : ℂ) * w) * (w ^ 2 + 1))
    fun_prop
  · exact hA
  · exact hB
  · exact hM

/-! The explicit degree-six witness also has a quantitative certificate.  This
    is the first concrete input needed by the analytic degree-raising step:
    the earlier p₆ proof only recorded the non-strict segment inclusions. -/
theorem p6_lineA_strict :
    ∀ z ∈ segment ℝ Erdos1047P6.anchor Erdos1047P6.pointA,
      ‖Erdos1047P6.polynomial.eval z‖ < Erdos1047P6.level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hv1 : v ≤ 1 := by linarith
  have hparam : u • Erdos1047P6.anchor + v • Erdos1047P6.pointA =
      Erdos1047P6.anchor + (v : ℂ) *
        (Erdos1047P6.pointA - Erdos1047P6.anchor) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination Erdos1047P6.anchor * huv'
  rw [hparam]
  exact Erdos1047P6.lineA_norm_lt v hv hv1

theorem p6_lineB_strict :
    ∀ z ∈ segment ℝ Erdos1047P6.anchor Erdos1047P6.pointB,
      ‖Erdos1047P6.polynomial.eval z‖ < Erdos1047P6.level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hv1 : v ≤ 1 := by linarith
  have hparam : u • Erdos1047P6.anchor + v • Erdos1047P6.pointB =
      Erdos1047P6.anchor + (v : ℂ) *
        (Erdos1047P6.pointB - Erdos1047P6.anchor) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination Erdos1047P6.anchor * huv'
  rw [hparam]
  exact Erdos1047P6.lineB_norm_lt v hv hv1

theorem p6_base_robust_certificate :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => Erdos1047P6.polynomial.eval z)
      Erdos1047P6.level Erdos1047P6.anchor
      Erdos1047P6.pointA Erdos1047P6.pointB) := by
  apply robustNonconvexCertificate_of_strict
  · fun_prop
  · exact p6_lineA_strict
  · exact p6_lineB_strict
  · exact Erdos1047P6.midpoint_norm_gt

/-! The quantitative certificate transports through the same symmetries used
    for the six-component separation argument.  Recording the margins (rather
    than only the weak segment inclusions) is important for the later
    degree-raising perturbation: every old non-convex component then has an
    explicit robust witness. -/
theorem p6_mul_omega_pow_robust_certificate (k : ℕ) :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => Erdos1047P6.polynomial.eval z)
      Erdos1047P6.level
      (Erdos1047P6.omega ^ k * Erdos1047P6.anchor)
      (Erdos1047P6.omega ^ k * Erdos1047P6.pointA)
      (Erdos1047P6.omega ^ k * Erdos1047P6.pointB)) := by
  obtain ⟨hcert⟩ := p6_base_robust_certificate
  refine ⟨⟨hcert.eps, hcert.eps_pos, ?_, ?_, ?_⟩⟩
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
    have hmap : u • (Erdos1047P6.omega ^ k * Erdos1047P6.anchor) +
        v • (Erdos1047P6.omega ^ k * Erdos1047P6.pointA) =
        Erdos1047P6.omega ^ k * (u • Erdos1047P6.anchor +
          v • Erdos1047P6.pointA) := by
      rw [Complex.real_smul, Complex.real_smul, Complex.real_smul,
        Complex.real_smul]
      ring
    rw [hmap, Erdos1047P6.polynomial_eval_omega_pow_norm]
    exact hcert.lineA_margin _ ⟨u, v, hu, hv, huv, rfl⟩
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
    have hmap : u • (Erdos1047P6.omega ^ k * Erdos1047P6.anchor) +
        v • (Erdos1047P6.omega ^ k * Erdos1047P6.pointB) =
        Erdos1047P6.omega ^ k * (u • Erdos1047P6.anchor +
          v • Erdos1047P6.pointB) := by
      rw [Complex.real_smul, Complex.real_smul, Complex.real_smul,
        Complex.real_smul]
      ring
    rw [hmap, Erdos1047P6.polynomial_eval_omega_pow_norm]
    exact hcert.lineB_margin _ ⟨u, v, hu, hv, huv, rfl⟩
  · have hmap : midpoint ℝ (Erdos1047P6.omega ^ k * Erdos1047P6.pointA)
        (Erdos1047P6.omega ^ k * Erdos1047P6.pointB) =
        Erdos1047P6.omega ^ k * midpoint ℝ Erdos1047P6.pointA
          Erdos1047P6.pointB := by
      simp [midpoint, AffineMap.lineMap_apply_module]
      ring
    rw [hmap, Erdos1047P6.polynomial_eval_omega_pow_norm]
    exact hcert.midpoint_margin

theorem p6_star_robust_certificate :
    Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => Erdos1047P6.polynomial.eval z)
      Erdos1047P6.level
      (star Erdos1047P6.anchor) (star Erdos1047P6.pointA)
      (star Erdos1047P6.pointB)) := by
  obtain ⟨hcert⟩ := p6_base_robust_certificate
  refine ⟨⟨hcert.eps, hcert.eps_pos, ?_, ?_, ?_⟩⟩
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
    rw [show u • star Erdos1047P6.anchor + v • star Erdos1047P6.pointA =
      star (u • Erdos1047P6.anchor + v • Erdos1047P6.pointA) by simp,
      Erdos1047P6.polynomial_eval_star_norm]
    exact hcert.lineA_margin _ ⟨u, v, hu, hv, huv, rfl⟩
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
