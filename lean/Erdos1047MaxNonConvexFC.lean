/-!
# A subcritical cubic local model

The flat quadratic model cannot supply two distinct nonconvex components.
Here the cubic term is retained.  The anisotropic chart resolves an order `k^4`
indentation at levels strictly below the critical value `1`.
This is a model calculation, not yet a transport theorem for a raised polynomial.
-/

open Polynomial Set

namespace Erdos1047StrictLocalCubicModel

noncomputable section

private theorem abs_sub_bound (a b : ℝ) : |a - b| ≤ |a| + |b| := by
  simpa only [sub_eq_add_neg, abs_neg] using abs_add_le a (-b)

def model (k : ℝ) (z : ℂ) : ℂ := 1 + z ^ 2 + (k : ℂ) * z ^ 3

def chart (k X Y : ℝ) : ℂ := (k * X : ℝ) + (k * X + k ^ 3 * Y : ℝ) * Complex.I

def level (k : ℝ) : ℝ := 1 - k ^ 4 / 65536

def leading (X Y : ℝ) : ℝ := 4 * X * (X ^ 3 - X ^ 2 - Y)

def realMain (X Y : ℝ) : ℝ := -2 * X * Y - 2 * X ^ 3
def realError (k X Y : ℝ) : ℝ := -Y ^ 2 - 6 * X ^ 2 * Y - 3 * k ^ 2 * X * Y ^ 2
def imagMain (X : ℝ) : ℝ := 2 * X ^ 2
def imagError (k X Y : ℝ) : ℝ :=
  2 * X * Y + 2 * X ^ 3 - 3 * k ^ 4 * X * Y ^ 2 - k ^ 6 * Y ^ 3

def remainder (k X Y : ℝ) : ℝ :=
  2 * realError k X Y + 2 * imagMain X * imagError k X Y +
    k ^ 2 * (imagError k X Y) ^ 2 +
    k ^ 2 * (realMain X Y + k ^ 2 * realError k X Y) ^ 2

theorem normSq_chart (k X Y : ℝ) :
    Complex.normSq (model k (chart k X Y)) - 1 =
      k ^ 4 * (leading X Y + k ^ 2 * remainder k X Y) := by
  simp [model, chart, Complex.normSq_apply, Complex.mul_re, Complex.mul_im,
    pow_succ, leading, remainder, realMain, realError,
    imagMain, imagError]
  ring

theorem remainder_abs_le {k X Y : ℝ}
    (hk : |k| ≤ 1) (hX : |X| ≤ 1) (hY : |Y| ≤ 1) :
    |remainder k X Y| ≤ 312 := by
  have hr0 : |realMain X Y| ≤ 4 := by
    calc
      _ ≤ |-2 * X * Y| + |2 * X ^ 3| := abs_sub_bound _ _
      _ = 2 * |X| * |Y| + 2 * |X| ^ 3 := by simp [abs_mul, abs_pow]
      _ ≤ 2 * 1 * 1 + 2 * 1 ^ 3 := by gcongr
      _ = 4 := by norm_num
  have hr2 : |realError k X Y| ≤ 10 := by
    calc
      _ ≤ |-Y ^ 2 - 6 * X ^ 2 * Y| + |3 * k ^ 2 * X * Y ^ 2| := abs_sub_bound _ _
      _ ≤ (|-Y ^ 2| + |6 * X ^ 2 * Y|) + |3 * k ^ 2 * X * Y ^ 2| := by
        gcongr
        exact abs_sub_bound _ _
      _ = |Y| ^ 2 + 6 * |X| ^ 2 * |Y| + 3 * |k| ^ 2 * |X| * |Y| ^ 2 := by
        simp [abs_mul, abs_pow]
      _ ≤ 1 ^ 2 + 6 * 1 ^ 2 * 1 + 3 * 1 ^ 2 * 1 * 1 ^ 2 := by gcongr
      _ = 10 := by norm_num
  have hi0 : |imagMain X| ≤ 2 := by
    calc
      _ = 2 * |X| ^ 2 := by simp [imagMain, abs_mul, abs_pow]
      _ ≤ 2 * 1 ^ 2 := by gcongr
      _ = 2 := by norm_num
  have hi2 : |imagError k X Y| ≤ 8 := by
    calc
      _ ≤ |2 * X * Y + 2 * X ^ 3 - 3 * k ^ 4 * X * Y ^ 2| + |k ^ 6 * Y ^ 3| :=
        abs_sub_bound _ _
      _ ≤ (|2 * X * Y + 2 * X ^ 3| + |3 * k ^ 4 * X * Y ^ 2|) + |k ^ 6 * Y ^ 3| := by
        gcongr
        exact abs_sub_bound _ _
      _ ≤ (|2 * X * Y| + |2 * X ^ 3| + |3 * k ^ 4 * X * Y ^ 2|) + |k ^ 6 * Y ^ 3| := by
        gcongr
        exact abs_add_le _ _
      _ = 2 * |X| * |Y| + 2 * |X| ^ 3 + 3 * |k| ^ 4 * |X| * |Y| ^ 2 +
          |k| ^ 6 * |Y| ^ 3 := by simp [abs_mul, abs_pow]
      _ ≤ 2 * 1 * 1 + 2 * 1 ^ 3 + 3 * 1 ^ 4 * 1 * 1 ^ 2 + 1 ^ 6 * 1 ^ 3 := by gcongr
      _ = 8 := by norm_num
  have hr : |realMain X Y + k ^ 2 * realError k X Y| ≤ 14 := by
    calc
      _ ≤ |realMain X Y| + |k ^ 2 * realError k X Y| := abs_add_le _ _
      _ = |realMain X Y| + |k| ^ 2 * |realError k X Y| := by rw [abs_mul, abs_pow]
      _ ≤ 4 + 1 ^ 2 * 10 := by gcongr
      _ = 14 := by norm_num
  calc
    _ ≤ |2 * realError k X Y + 2 * imagMain X * imagError k X Y +
          k ^ 2 * (imagError k X Y) ^ 2| +
          |k ^ 2 * (realMain X Y + k ^ 2 * realError k X Y) ^ 2| := abs_add_le _ _
    _ ≤ (|2 * realError k X Y + 2 * imagMain X * imagError k X Y| +
          |k ^ 2 * (imagError k X Y) ^ 2|) +
          |k ^ 2 * (realMain X Y + k ^ 2 * realError k X Y) ^ 2| := by
      gcongr
      exact abs_add_le _ _
    _ ≤ (|2 * realError k X Y| + |2 * imagMain X * imagError k X Y| +
          |k ^ 2 * (imagError k X Y) ^ 2|) +
          |k ^ 2 * (realMain X Y + k ^ 2 * realError k X Y) ^ 2| := by
      gcongr
      exact abs_add_le _ _
    _ = 2 * |realError k X Y| + 2 * |imagMain X| * |imagError k X Y| +
        |k| ^ 2 * |imagError k X Y| ^ 2 +
        |k| ^ 2 * |realMain X Y + k ^ 2 * realError k X Y| ^ 2 := by
      simp [abs_mul, abs_pow]
    _ ≤ 2 * 10 + 2 * 2 * 8 + 1 ^ 2 * 8 ^ 2 + 1 ^ 2 * 14 ^ 2 := by gcongr
    _ = 312 := by norm_num

def anchor (k : ℝ) : ℂ := chart k (1 / 8) 0
def pointA (k : ℝ) : ℂ := chart k (1 / 16) (-13 / 4096)
def pointB (k : ℝ) : ℂ := chart k (3 / 16) (-115 / 4096)

theorem leading_lineA_le {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    leading (1 / 8 - t / 16) (-13 * t / 4096) ≤ -1 / 8192 := by
  have h := Erdos1047CubicLower.bernstein6_nonpos t
    (-55/8192) (-237/8192) (-805/16384) (-21/512)
    (-275/16384) (-11/4096) 0 ht0 ht1
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num)
  have hid : leading (1 / 8 - t / 16) (-13 * t / 4096) + 1 / 8192 =
      (-55/8192 : ℝ) * t ^ 0 * (1-t)^6 + (-237/8192 : ℝ) * t * (1-t)^5 +
      (-805/16384 : ℝ) * t^2 * (1-t)^4 + (-21/512 : ℝ) * t^3 * (1-t)^3 +
      (-275/16384 : ℝ) * t^4 * (1-t)^2 + (-11/4096 : ℝ) * t^5 * (1-t) := by
    unfold leading
    ring
  norm_num only [pow_zero, pow_one, zero_mul, add_zero] at h hid
  linarith

theorem leading_lineB_le {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    leading (1 / 8 + t / 16) (-115 * t / 4096) ≤ -1 / 8192 := by
  have h := Erdos1047CubicLower.bernstein6_nonpos t
    (-55/8192) (-295/8192) (-1257/16384) (-167/2048)
    (-715/16384) (-5/512) (-1/4096) ht0 ht1
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num)
  have hid : leading (1 / 8 + t / 16) (-115 * t / 4096) + 1 / 8192 =
      (-55/8192 : ℝ) * t ^ 0 * (1-t)^6 + (-295/8192 : ℝ) * t * (1-t)^5 +
      (-1257/16384 : ℝ) * t^2 * (1-t)^4 + (-167/2048 : ℝ) * t^3 * (1-t)^3 +
      (-715/16384 : ℝ) * t^4 * (1-t)^2 + (-5/512 : ℝ) * t^5 * (1-t) +
      (-1/4096 : ℝ) * t^6 := by
    unfold leading
    ring
  norm_num only [pow_zero, pow_one] at h hid
  linarith

theorem level_bounds {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    0 < level k ∧ level k < 1 := by
  have hk1 : k ≤ 1 := by linarith
  have hk4 : k ^ 4 ≤ 1 := by simpa using pow_le_pow_left₀ hk.le hk1 4
  have hpos : 0 < k ^ 4 := by positivity
  constructor <;> unfold level <;> linarith

theorem small_error {k X Y : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000)
    (hX : |X| ≤ 1) (hY : |Y| ≤ 1) :
    |k ^ 2 * remainder k X Y| < 1 / 65536 := by
  have hsmall : k ^ 2 ≤ (1 / 10000 : ℝ) ^ 2 := pow_le_pow_left₀ hk.le hk' 2
  have hrem := remainder_abs_le (show |k| ≤ 1 by rw [abs_of_pos hk]; linarith) hX hY
  calc
    _ = k ^ 2 * |remainder k X Y| := by rw [abs_mul, abs_of_nonneg (sq_nonneg k)]
    _ ≤ (1 / 10000 : ℝ) ^ 2 * 312 := by gcongr
    _ < 1 / 65536 := by norm_num

theorem normSq_lt_of_leading {k X Y : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000)
    (hX : |X| ≤ 1) (hY : |Y| ≤ 1) (hlead : leading X Y ≤ -1 / 8192) :
    Complex.normSq (model k (chart k X Y)) < (level k) ^ 2 := by
  have he := (abs_lt.mp (small_error hk hk' hX hY)).2
  have hgap : leading X Y + k ^ 2 * remainder k X Y < -2 / 65536 := by linarith
  have hmul := mul_lt_mul_of_pos_left hgap (show 0 < k ^ 4 by positivity)
  have hid := normSq_chart k X Y
  have hs := sq_nonneg (k ^ 4 / 65536)
  unfold level
  nlinarith

/-- The allowed perturbation shrinks like `k^4`; a fixed uniform error is not enough. -/
theorem norm_margin_of_leading {k X Y : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000)
    (hX : |X| ≤ 1) (hY : |Y| ≤ 1) (hlead : leading X Y ≤ -1 / 8192) :
    ‖model k (chart k X Y)‖ + k ^ 4 / 65536 ≤ level k := by
  have he := (abs_lt.mp (small_error hk hk' hX hY)).2
  have hgap : leading X Y + k ^ 2 * remainder k X Y < -4 / 65536 := by linarith
  have hmul := mul_lt_mul_of_pos_left hgap (show 0 < k ^ 4 by positivity)
  have hid := normSq_chart k X Y
  rw [Complex.normSq_eq_norm_sq] at hid
  have hk1 : k ≤ 1 := by linarith
  have hk4 : k ^ 4 ≤ 1 := by simpa using pow_le_pow_left₀ hk.le hk1 4
  have hsq := sq_nonneg (2 * k ^ 4 / 65536)
  have hn := norm_nonneg (model k (chart k X Y))
  have hbound : 0 < 1 - 2 * k ^ 4 / 65536 := by linarith
  have hnorm : ‖model k (chart k X Y)‖ < 1 - 2 * k ^ 4 / 65536 := by nlinarith
  unfold level
  linarith

theorem lineA_normSq {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    Complex.normSq (model k (anchor k + (t : ℂ) * (pointA k - anchor k))) <
      (level k) ^ 2 := by
  have heq : anchor k + (t : ℂ) * (pointA k - anchor k) =
      chart k (1 / 8 - t / 16) (-13 * t / 4096) := by
    apply Complex.ext <;> simp [anchor, pointA, chart, Complex.mul_re, Complex.mul_im] <;> ring
  rw [heq]
  exact normSq_lt_of_leading hk hk'
    (abs_le.mpr ⟨by linarith, by linarith⟩)
    (abs_le.mpr ⟨by linarith, by linarith⟩) (leading_lineA_le ht0 ht1)

theorem lineB_normSq {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    Complex.normSq (model k (anchor k + (t : ℂ) * (pointB k - anchor k))) <
      (level k) ^ 2 := by
  have heq : anchor k + (t : ℂ) * (pointB k - anchor k) =
      chart k (1 / 8 + t / 16) (-115 * t / 4096) := by
    apply Complex.ext <;> simp [anchor, pointB, chart, Complex.mul_re, Complex.mul_im] <;> ring
  rw [heq]
  exact normSq_lt_of_leading hk hk'
    (abs_le.mpr ⟨by linarith, by linarith⟩)
    (abs_le.mpr ⟨by linarith, by linarith⟩) (leading_lineB_le ht0 ht1)

theorem midpoint_norm_gt_one {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    1 < ‖model k (midpoint ℝ (pointA k) (pointB k))‖ := by
  have heq : midpoint ℝ (pointA k) (pointB k) = chart k (1 / 8) (-1 / 64) := by
    rw [midpoint_eq_smul_add]
    apply Complex.ext <;>
      simp [pointA, pointB, chart, Complex.real_smul, Complex.mul_re, Complex.mul_im] <;> ring
  rw [heq]
  have he := (abs_lt.mp (small_error hk hk'
    (X := 1 / 8) (Y := -1 / 64) (by norm_num) (by norm_num))).1
  have hl : leading (1 / 8) (-1 / 64) = 1 / 1024 := by norm_num [leading]
  have hp : 0 < leading (1 / 8) (-1 / 64) +
      k ^ 2 * remainder k (1 / 8) (-1 / 64) := by linarith
  have hid := normSq_chart k (1 / 8) (-1 / 64)
  have hnorm : 1 < Complex.normSq (model k (chart k (1 / 8) (-1 / 64))) := by
    have hmul : 0 < k ^ 4 * (leading (1 / 8) (-1 / 64) +
        k ^ 2 * remainder k (1 / 8) (-1 / 64)) := mul_pos (by positivity) hp
    linarith
  rw [Complex.normSq_eq_norm_sq] at hnorm
  have hb := level_bounds hk hk'
  have hn := norm_nonneg (model k (chart k (1 / 8) (-1 / 64)))
  nlinarith

theorem midpoint_norm_gt {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    level k < ‖model k (midpoint ℝ (pointA k) (pointB k))‖ :=
  (level_bounds hk hk').2.trans (midpoint_norm_gt_one hk hk')

private theorem segment_margin_of_parametric
    {F : ℂ → ℂ} {c eps : ℝ} {r a : ℂ}
    (h : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
      ‖F (r + (t : ℂ) * (a - r))‖ + eps ≤ c) :
    ∀ z ∈ segment ℝ r a, ‖F z‖ + eps ≤ c := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hparam : u • r + v • a = r + (v : ℂ) * (a - r) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination r * huv'
  rw [hparam]
  exact h v hv (by linarith)

def explicitCertificate {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    Erdos1047Proof.RobustNonconvexCertificate (model k) (level k)
      (anchor k) (pointA k) (pointB k) where
  eps := k ^ 4 / 65536
  eps_pos := by positivity
  lineA_margin := by
    apply segment_margin_of_parametric
    intro t ht0 ht1
    have heq : anchor k + (t : ℂ) * (pointA k - anchor k) =
        chart k (1 / 8 - t / 16) (-13 * t / 4096) := by
      apply Complex.ext <;> simp [anchor, pointA, chart, Complex.mul_re, Complex.mul_im] <;> ring
    rw [heq]
    exact norm_margin_of_leading hk hk'
      (abs_le.mpr ⟨by linarith, by linarith⟩)
      (abs_le.mpr ⟨by linarith, by linarith⟩) (leading_lineA_le ht0 ht1)
  lineB_margin := by
    apply segment_margin_of_parametric
    intro t ht0 ht1
    have heq : anchor k + (t : ℂ) * (pointB k - anchor k) =
        chart k (1 / 8 + t / 16) (-115 * t / 4096) := by
      apply Complex.ext <;> simp [anchor, pointB, chart, Complex.mul_re, Complex.mul_im] <;> ring
    rw [heq]
    exact norm_margin_of_leading hk hk'
      (abs_le.mpr ⟨by linarith, by linarith⟩)
      (abs_le.mpr ⟨by linarith, by linarith⟩) (leading_lineB_le ht0 ht1)
  midpoint_margin := by
    have h := midpoint_norm_gt_one hk hk'
    unfold level
    linarith

theorem upper_certificate {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    Nonempty (Erdos1047Proof.RobustNonconvexCertificate (model k) (level k)
      (anchor k) (pointA k) (pointB k)) := ⟨explicitCertificate hk hk'⟩

theorem upper_component_not_convex {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖model k z‖ < level k} (anchor k)) := by
  obtain ⟨hcert⟩ := upper_certificate hk hk'
  exact Erdos1047FCStrictCertificateCore.robust_not_convex_component_strict hcert

#print axioms upper_certificate
#print axioms upper_component_not_convex

theorem model_star (k : ℝ) (z : ℂ) : model k (star z) = star (model k z) := by
  simp [model]

theorem lower_certificate {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    Nonempty (Erdos1047Proof.RobustNonconvexCertificate (model k) (level k)
      (star (anchor k)) (star (pointA k)) (star (pointB k))) :=
  Erdos1047Proof.robustNonconvexCertificate_of_star (model_star k) (upper_certificate hk hk')

theorem lower_component_not_convex {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖model k z‖ < level k} (star (anchor k))) := by
  obtain ⟨hcert⟩ := lower_certificate hk hk'
  exact Erdos1047FCStrictCertificateCore.robust_not_convex_component_strict hcert

theorem model_re (k : ℝ) (z : ℂ) :
    (model k z).re = 1 + z.re ^ 2 - z.im ^ 2 + k * (z.re ^ 3 - 3 * z.re * z.im ^ 2) := by
  simp [model, pow_succ, Complex.mul_re, Complex.mul_im]
  ring

theorem vertical_barrier {k : ℝ} (hk : 0 < k) {z : ℂ}
    (hz : 1 + 2 * k * z.re = 0) : 1 ≤ ‖model k z‖ := by
  have hx : z.re = -1 / (2 * k) := by
    apply (eq_div_iff (by positivity : 2 * k ≠ 0)).mpr
    linarith
  have hid : (model k z).re = 1 + 1 / (8 * k ^ 2) + z.im ^ 2 / 2 := by
    rw [model_re, hx]
    field_simp
    ring
  have hle : 1 ≤ (model k z).re := by
    rw [hid]
    have hinv : 0 ≤ 1 / (8 * k ^ 2) := by positivity
    nlinarith [sq_nonneg z.im]
  exact hle.trans (Complex.re_le_norm _)

theorem real_right_barrier {k : ℝ} {z : ℂ}
    (hx : 0 < 1 + 2 * k * z.re) (hy : z.im = 0) : 1 ≤ ‖model k z‖ := by
  have hcoef : 0 ≤ 1 + k * z.re := by linarith
  have hprod := mul_nonneg (sq_nonneg z.re) hcoef
  have hle : 1 ≤ (model k z).re := by rw [model_re, hy]; nlinarith
  exact hle.trans (Complex.re_le_norm _)

theorem upper_component_im_pos {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    ∀ z ∈ connectedComponentIn {w : ℂ | ‖model k w‖ < level k} (anchor k), 0 < z.im := by
  let S : Set ℂ := {w : ℂ | ‖model k w‖ < level k}
  have hlevel := (level_bounds hk hk').2
  have ha : anchor k ∈ S := by
    have h := Erdos1047CubicLower.segment_strict_of_parametric_normSq_lt
      (level_bounds hk hk').1.le (lineA_normSq hk hk')
    exact h _ (left_mem_segment ℝ _ _)
  have hzero : ∀ z ∈ S, 1 + 2 * k * z.re ≠ 0 := by
    intro z hz heq
    have hb := vertical_barrier hk heq
    change ‖model k z‖ < level k at hz
    linarith
  have hright : ∀ z ∈ connectedComponentIn S (anchor k), 0 < 1 + 2 * k * z.re := by
    apply Erdos1047CubicLower.positive_on_preconnected
      isPreconnected_connectedComponentIn (by fun_prop)
      (fun z hz => hzero z (connectedComponentIn_subset S (anchor k) hz))
      (mem_connectedComponentIn ha)
    simp [anchor, chart, Complex.mul_re]
    positivity
  have himzero : ∀ z ∈ connectedComponentIn S (anchor k), z.im ≠ 0 := by
    intro z hz heq
    have hb := real_right_barrier (hright z hz) heq
    have hm := connectedComponentIn_subset S (anchor k) hz
    change ‖model k z‖ < level k at hm
    linarith
  apply Erdos1047CubicLower.positive_on_preconnected isPreconnected_connectedComponentIn
    Complex.continuous_im himzero (mem_connectedComponentIn ha)
  simp [anchor, chart, Complex.mul_im]
  positivity

theorem components_distinct {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    connectedComponentIn {z : ℂ | ‖model k z‖ < level k} (anchor k) ≠
      connectedComponentIn {z : ℂ | ‖model k z‖ < level k} (star (anchor k)) := by
  intro heq
  obtain ⟨hcert⟩ := lower_certificate hk hk'
  have hm : ‖model k (star (anchor k))‖ < level k := by
    have h := hcert.lineA_margin _ (left_mem_segment ℝ _ _)
    linarith [hcert.eps_pos]
  have hmem : star (anchor k) ∈
      connectedComponentIn {z : ℂ | ‖model k z‖ < level k} (star (anchor k)) :=
    mem_connectedComponentIn hm
  rw [← heq] at hmem
  have him := upper_component_im_pos hk hk' _ hmem
  simp [anchor, chart, Complex.mul_im] at him
  nlinarith

/-- Two genuinely distinct nonconvex components, at a positive subcritical level. -/
theorem two_distinct_nonconvex_components {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    0 < level k ∧ level k < 1 ∧
      ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖model k z‖ < level k} (anchor k)) ∧
      ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖model k z‖ < level k} (star (anchor k))) ∧
      connectedComponentIn {z : ℂ | ‖model k z‖ < level k} (anchor k) ≠
        connectedComponentIn {z : ℂ | ‖model k z‖ < level k} (star (anchor k)) :=
  ⟨(level_bounds hk hk').1, (level_bounds hk hk').2,
    upper_component_not_convex hk hk', lower_component_not_convex hk hk',
    components_distinct hk hk'⟩

#print axioms two_distinct_nonconvex_components

/-- Only local errors at the two segments and the midpoint are needed for nonconvexity.
Separation of components for `G` is a separate obligation. -/
theorem perturbed_upper_component_not_convex {k : ℝ}
    (hk : 0 < k) (hk' : k ≤ 1 / 10000) {G : ℂ → ℂ}
    (hA : ∀ z ∈ segment ℝ (anchor k) (pointA k), ‖G z - model k z‖ < k ^ 4 / 65536)
    (hB : ∀ z ∈ segment ℝ (anchor k) (pointB k), ‖G z - model k z‖ < k ^ 4 / 65536)
    (hM : ‖G (midpoint ℝ (pointA k) (pointB k)) -
      model k (midpoint ℝ (pointA k) (pointB k))‖ < k ^ 4 / 65536) :
    ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖G z‖ < level k} (anchor k)) :=
  Erdos1047FCStrictCertificateCore.robust_certificate_stable_strict
    (explicitCertificate hk hk') hA hB hM

#print axioms explicitCertificate
#print axioms perturbed_upper_component_not_convex

theorem chart_norm_le {k X Y : ℝ} (hk : 0 < k) (hk1 : k ≤ 1)
    (hX : |X| ≤ 1 / 4) (hY : |Y| ≤ 1 / 4) : ‖chart k X Y‖ ≤ k := by
  have hk2 : k ^ 2 ≤ 1 := by simpa using pow_le_pow_left₀ hk.le hk1 2
  have hk3 : k ^ 3 ≤ k := by nlinarith [mul_nonneg hk.le (sub_nonneg.mpr hk2)]
  calc
    _ ≤ ‖((k * X : ℝ) : ℂ)‖ + ‖((k * X + k ^ 3 * Y : ℝ) : ℂ) * Complex.I‖ :=
      norm_add_le _ _
    _ = |k * X| + |k * X + k ^ 3 * Y| := by
      simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I, mul_one, abs_mul]
    _ ≤ |k * X| + (|k * X| + |k ^ 3 * Y|) := by gcongr; exact abs_add_le _ _
    _ = k * |X| + (k * |X| + k ^ 3 * |Y|) := by
      simp [abs_mul, abs_pow, abs_of_pos hk]
    _ ≤ k * (1 / 4) + (k * (1 / 4) + k * (1 / 4)) := by gcongr
    _ ≤ k := by linarith

theorem quartic_remainder_small {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000)
    {G : ℂ → ℂ}
    (hrem : ∀ z : ℂ, ‖z‖ ≤ k → ‖G z - model k z‖ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4)
    {z : ℂ} (hz : ‖z‖ ≤ k) : ‖G z - model k z‖ < k ^ 4 / 65536 := by
  have hk2 : k ^ 2 ≤ (1 / 10000 : ℝ) ^ 2 := pow_le_pow_left₀ hk.le hk' 2
  have hcoef : 1000 * k ^ 2 < 1 / 65536 := by nlinarith
  calc
    _ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4 := hrem z hz
    _ ≤ 1000 * k ^ 2 * k ^ 4 := by gcongr
    _ < (1 / 65536) * k ^ 4 := mul_lt_mul_of_pos_right hcoef (by positivity)
    _ = k ^ 4 / 65536 := by ring

/-- A fourth-order tail of size `O(k^2)` is small enough on the anisotropic witness.
The actual raised-polynomial Taylor bound, and its global separation, remain separate. -/
theorem upper_nonconvex_of_quartic_remainder {k : ℝ}
    (hk : 0 < k) (hk' : k ≤ 1 / 10000) {G : ℂ → ℂ}
    (hrem : ∀ z : ℂ, ‖z‖ ≤ k → ‖G z - model k z‖ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4) :
    ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖G z‖ < level k} (anchor k)) := by
  have hk1 : k ≤ 1 := by linarith
  have hr : anchor k ∈ Metric.closedBall (0 : ℂ) k := by
    simpa [anchor, Metric.mem_closedBall, dist_zero_right] using
      chart_norm_le hk hk1 (X := 1 / 8) (Y := 0) (by norm_num) (by norm_num)
  have ha : pointA k ∈ Metric.closedBall (0 : ℂ) k := by
    simpa [pointA, Metric.mem_closedBall, dist_zero_right] using
      chart_norm_le hk hk1 (X := 1 / 16) (Y := -13 / 4096) (by norm_num) (by norm_num)
  have hb : pointB k ∈ Metric.closedBall (0 : ℂ) k := by
    simpa [pointB, Metric.mem_closedBall, dist_zero_right] using
      chart_norm_le hk hk1 (X := 3 / 16) (Y := -115 / 4096) (by norm_num) (by norm_num)
  have hc := convex_closedBall (0 : ℂ) k
  apply perturbed_upper_component_not_convex hk hk'
  · intro z hz
    apply quartic_remainder_small hk hk' hrem
    simpa [Metric.mem_closedBall, dist_zero_right] using hc.segment_subset hr ha hz
  · intro z hz
    apply quartic_remainder_small hk hk' hrem
    simpa [Metric.mem_closedBall, dist_zero_right] using hc.segment_subset hr hb hz
  · apply quartic_remainder_small hk hk' hrem
    simpa [Metric.mem_closedBall, dist_zero_right] using hc.midpoint_mem ha hb

#print axioms upper_nonconvex_of_quartic_remainder

end
end Erdos1047StrictLocalCubicModel

end

/- Source: Erdos1047StrictGeneralCore.lean; SHA256: b7af5aa46488b25e57afc3b3f490ec2c04437d9f7674a71ee789edc24b9f0cd9 -/
section


/-!
# General strict-sublevel component bound

This file isolates a target-level fact needed by the strict/no-root-count
formulation: every component of a positive-level strict polynomial sublevel
contains a root.  The proof minimizes `‖f‖` on the compact closure of the
component.  The local minimum-modulus theorem then rules out a nonzero minimum.
Unlike the older closed-sublevel argument, no global finiteness hypothesis on
the component family is needed.
-/

open Polynomial
open Set
open scoped Topology

namespace Erdos1047StrictGeneralCore

noncomputable section

theorem strictSublevel_subset_sublevel {f : ℂ[X]} {c : ℝ} :
    Erdos1047.strictSublevelSet f c ⊆ Erdos1047.sublevelSet f c := by
  intro z hz
  change ‖f.eval z‖ < c at hz
  change ‖f.eval z‖ ≤ c
  exact hz.le

theorem sublevelSet_isCompact_of_positive_degree
    {f : ℂ[X]} (hdeg : 0 < f.degree) (c : ℝ) :
    IsCompact (Erdos1047.sublevelSet f c) := by
  have hf : IsProperMap (fun z : ℂ => f.eval z) := f.isProperMap_eval hdeg
  have hpre : IsCompact ((fun z : ℂ => f.eval z) ⁻¹'
      Metric.closedBall (0 : ℂ) c) :=
    hf.isCompact_preimage (isCompact_closedBall (0 : ℂ) c)
  convert hpre using 1
  ext z
  simp [Erdos1047.sublevelSet, Metric.mem_closedBall, dist_zero_right]

theorem strict_component_closure_subset_sublevel
    {f : ℂ[X]} {c : ℝ} (hdeg : 0 < f.degree) {z : ℂ}
    (hz : z ∈ Erdos1047.strictSublevelSet f c) :
    closure (connectedComponentIn (Erdos1047.strictSublevelSet f c) z) ⊆
      Erdos1047.sublevelSet f c := by
  apply closure_minimal
  · exact (connectedComponentIn_subset _ _).trans strictSublevel_subset_sublevel
  · apply isClosed_le
    · exact (continuous_norm.comp f.continuous_aeval)
    · exact continuous_const

theorem mem_component_of_mem_closure
    {S : Set ℂ} {z x : ℂ} (hz : z ∈ S) (hx : x ∈ S)
    (hxc : x ∈ closure (connectedComponentIn S z)) :
    x ∈ connectedComponentIn S z := by
  let Sz : Set ℂ := S
  let pz : Sz := ⟨z, hz⟩
  let px : Sz := ⟨x, hx⟩
  have hclimg : (x : ℂ) ∈ closure
      (Subtype.val '' connectedComponent pz) := by
    rw [← connectedComponentIn_eq_image hz]
    exact hxc
  have hclsub : px ∈ closure (connectedComponent pz) := by
    exact closure_subtype.mpr hclimg
  have hclosed : IsClosed (connectedComponent pz) := isClosed_connectedComponent
  have hmem : px ∈ connectedComponent pz := hclosed.closure_subset hclsub
  change x ∈ connectedComponentIn S z
  rw [connectedComponentIn_eq_image hz]
  exact ⟨px, hmem, rfl⟩

theorem strict_exists_root_in_component
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree) {c : ℝ} (hc : 0 < c)
    (z : ℂ) (hz : z ∈ Erdos1047.strictSublevelSet f c) :
    ∃ r ∈ f.rootSet ℂ,
      r ∈ connectedComponentIn (Erdos1047.strictSublevelSet f c) z := by
  let S : Set ℂ := Erdos1047.strictSublevelSet f c
  let C : Set ℂ := connectedComponentIn S z
  have hKcomp : IsCompact (Erdos1047.sublevelSet f c) :=
    sublevelSet_isCompact_of_positive_degree hdeg c
  have hCclcomp : IsCompact (closure C) := by
    apply hKcomp.of_isClosed_subset isClosed_closure
    exact strict_component_closure_subset_sublevel hdeg hz
  have hCclne : (closure C).Nonempty := by
    exact ⟨z, subset_closure (mem_connectedComponentIn hz)⟩
  have hcont : ContinuousOn (fun w : ℂ => ‖f.eval w‖) (closure C) :=
    (continuous_norm.comp f.continuous_aeval).continuousOn
  obtain ⟨x, hxcl, hmin⟩ := hCclcomp.exists_isMinOn hCclne hcont
  have hzcl : z ∈ closure C := subset_closure (mem_connectedComponentIn hz)
  have hminz : ‖f.eval x‖ ≤ ‖f.eval z‖ := hmin hzcl
  have hzltnorm : ‖f.eval z‖ < c := hz
  have hxlt : ‖f.eval x‖ < c := hminz.trans_lt hzltnorm
  have hxS : x ∈ S := hxlt
  have hxc : x ∈ C := by
    exact mem_component_of_mem_closure hz hxS hxcl
  by_cases hzero : f.eval x = 0
  · exact ⟨x, hf.mem_rootSet.mpr hzero, hxc⟩
  have hSopen : IsOpen S := by
    exact isOpen_lt (continuous_norm.comp f.continuous_aeval) continuous_const
  have hCopen : IsOpen C := by
    exact hSopen.connectedComponentIn
  have hCnhds : C ∈ 𝓝 x := hCopen.mem_nhds hxc
  have hminC : IsMinOn (fun w : ℂ => ‖f.eval w‖) C x := by
    intro y hy
    exact hmin (subset_closure hy)
  have hlocal : IsLocalMin (norm ∘ (fun w : ℂ => f.eval w)) x := by
    have hminC' : IsMinOn (norm ∘ (fun w : ℂ => f.eval w)) C x := by
      simpa [Function.comp_def] using hminC
    exact hminC'.isLocalMin hCnhds
  have hdiff : ∀ᶠ w : ℂ in 𝓝 x,
      DifferentiableAt ℂ (fun w : ℂ => f.eval w) w :=
    Filter.Eventually.of_forall (fun w => f.differentiableAt_aeval)
  rcases Complex.eventually_eq_or_eq_zero_of_isLocalMin_norm hdiff hlocal with heq | hzx
  · exfalso
    have hnot : ¬ (∀ᶠ w : ℂ in 𝓝 x, f.eval w = f.eval x) := by
      intro hconst
      have hfun : (fun w : ℂ => f.eval w) = (fun _ : ℂ => f.eval x) := by
        exact AnalyticOnNhd.eq_of_eventuallyEq
          (analyticOnNhd_id.aeval_polynomial f)
          (show AnalyticOnNhd ℂ (fun _ : ℂ => f.eval x) (Set.univ : Set ℂ) by
            exact analyticOnNhd_const) hconst
      have hpoly : f = Polynomial.C (f.eval x) := by
        apply Polynomial.funext
        intro w
        simpa using congrFun hfun w
      have hnat : f.natDegree = 0 := by
        rw [hpoly, natDegree_C]
      have hdeg_nat : 0 < f.natDegree := by
        rw [degree_eq_natDegree hf.ne_zero] at hdeg
        exact_mod_cast hdeg
      omega
    exact hnot heq
  · exact False.elim (hzero hzx)

theorem strict_componentsIn_eq_image_rootSet
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree) {c : ℝ} (hc : 0 < c) :
    Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) =
      (fun r : ℂ => connectedComponentIn (Erdos1047.strictSublevelSet f c) r) ''
        (↑(f.rootSet ℂ) : Set ℂ) := by
  apply Set.Subset.antisymm
  · rintro t ⟨z, hz, rfl⟩
    obtain ⟨r, hrroot, hrcomp⟩ := strict_exists_root_in_component hf hdeg hc z hz
    refine ⟨r, hrroot, ?_⟩
    exact (connectedComponentIn_eq hrcomp).symm
  · rintro _ ⟨r, hrroot, rfl⟩
    have hreval : f.eval r = 0 := hf.mem_rootSet.mp hrroot
    have hrS : r ∈ Erdos1047.strictSublevelSet f c := by
      change ‖f.eval r‖ < c
      rw [hreval, norm_zero]
      exact hc
    exact ⟨r, hrS, rfl⟩

theorem strict_componentsIn_ncard_le_natDegree
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree) {c : ℝ} (hc : 0 < c) :
    (Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c)).ncard ≤ f.natDegree := by
  rw [strict_componentsIn_eq_image_rootSet hf hdeg hc]
  exact (Set.ncard_image_le (f.rootSet_finite ℂ)).trans (Polynomial.ncard_rootSet_le f ℂ)

theorem strict_nonconvex_ncard_le_natDegree
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree) {c : ℝ} (hc : 0 < c) :
    {t ∈ Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) |
      ¬ Convex ℝ t}.ncard ≤ f.natDegree := by
  have hcompfin :
      (Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c)).Finite := by
    rw [strict_componentsIn_eq_image_rootSet hf hdeg hc]
    exact (f.rootSet_finite ℂ).image _
  have hsub :
      {t ∈ Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) |
        ¬ Convex ℝ t} ⊆
        Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) := by
    intro t ht
    exact ht.1
  exact (Set.ncard_le_ncard hsub hcompfin).trans
    (strict_componentsIn_ncard_le_natDegree hf hdeg hc)

#print axioms strict_exists_root_in_component
#print axioms strict_componentsIn_ncard_le_natDegree
#print axioms strict_nonconvex_ncard_le_natDegree

end
end Erdos1047StrictGeneralCore

end

/- Source: Erdos1047ClosedGeneralCore.lean; SHA256: db0e009838344b9c0e43e9e79955b00abc46b2dede8f1927e303c0e7edf893de -/
section


/-!
# Closed polynomial sublevels: root exhaustion without regular values

A positive closed sublevel is the closure of the corresponding strict sublevel.
The strict sublevel has finitely many rooted components, so every point of its
closure belongs to the closure of one such component.  This proves root
exhaustion even at critical levels, where several strict components may merge.
-/

open Polynomial Set
open scoped Topology

namespace Erdos1047ClosedGeneralCore

noncomputable section

theorem closure_strictSublevelSet
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree)
    {c : ℝ} (hc : 0 < c) :
    closure (Erdos1047.strictSublevelSet f c) = Erdos1047.sublevelSet f c := by
  have hnat : 0 < f.natDegree := by
    rw [degree_eq_natDegree hf.ne_zero] at hdeg
    exact_mod_cast hdeg
  have hop : IsOpenMap (fun z : ℂ => f.eval z) :=
    (Polynomial.isOpenQuotientMap_eval f (Nat.ne_of_gt hnat)).isOpenMap
  have h := hop.preimage_closure_eq_closure_preimage f.continuous_aeval
    (Metric.ball (0 : ℂ) c)
  rw [closure_ball (0 : ℂ) (ne_of_gt hc)] at h
  simpa only [Erdos1047.strictSublevelSet, Erdos1047.sublevelSet,
    Metric.ball, Metric.closedBall, dist_zero_right, Set.preimage_ofPred_eq] using h.symm

theorem closed_exists_root_in_component
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree) {c : ℝ} (hc : 0 < c)
    (z : ℂ) (hz : z ∈ Erdos1047.sublevelSet f c) :
    ∃ r ∈ f.rootSet ℂ,
      r ∈ connectedComponentIn (Erdos1047.sublevelSet f c) z := by
  let U := Erdos1047.strictSublevelSet f c
  have hrootmem : ∀ r ∈ f.rootSet ℂ, r ∈ U := by
    intro r hr
    have hreval : f.eval r = 0 := hf.mem_rootSet.mp hr
    change ‖f.eval r‖ < c
    rw [hreval, norm_zero]
    exact hc
  have hUnion : U = ⋃ r ∈ f.rootSet ℂ, connectedComponentIn U r := by
    ext x
    constructor
    · intro hx
      obtain ⟨r, hr, hrc⟩ :=
        Erdos1047StrictGeneralCore.strict_exists_root_in_component hf hdeg hc x hx
      apply Set.mem_iUnion₂.mpr
      refine ⟨r, hr, ?_⟩
      rw [← connectedComponentIn_eq hrc]
      exact mem_connectedComponentIn hx
    · intro hx
      obtain ⟨r, _, hxr⟩ := Set.mem_iUnion₂.mp hx
      exact connectedComponentIn_subset U r hxr
  have hzcl : z ∈ closure U := by
    rw [closure_strictSublevelSet hf hdeg hc]
    exact hz
  rw [hUnion, (f.rootSet_finite ℂ).closure_biUnion] at hzcl
  obtain ⟨r, hr, hzrc⟩ := Set.mem_iUnion₂.mp hzcl
  refine ⟨r, hr, ?_⟩
  have hsub : closure (connectedComponentIn U r) ⊆ Erdos1047.sublevelSet f c :=
    Erdos1047StrictGeneralCore.strict_component_closure_subset_sublevel hdeg (hrootmem r hr)
  exact isPreconnected_connectedComponentIn.closure.subset_connectedComponentIn hzrc hsub
    (subset_closure (mem_connectedComponentIn (hrootmem r hr)))

theorem closed_componentsIn_eq_image_rootSet
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree) {c : ℝ} (hc : 0 < c) :
    Erdos1047.componentsIn (Erdos1047.sublevelSet f c) =
      (fun r : ℂ => connectedComponentIn (Erdos1047.sublevelSet f c) r) ''
        (f.rootSet ℂ) := by
  apply Set.Subset.antisymm
  · rintro t ⟨z, hz, rfl⟩
    obtain ⟨r, hr, hrc⟩ := closed_exists_root_in_component hf hdeg hc z hz
    exact ⟨r, hr, (connectedComponentIn_eq hrc).symm⟩
  · rintro _ ⟨r, hr, rfl⟩
    refine ⟨r, ?_, rfl⟩
    have hreval : f.eval r = 0 := hf.mem_rootSet.mp hr
    change ‖f.eval r‖ ≤ c
    rw [hreval, norm_zero]
    exact hc.le

theorem closed_componentsIn_finite
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree) {c : ℝ} (hc : 0 < c) :
    (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).Finite := by
  rw [closed_componentsIn_eq_image_rootSet hf hdeg hc]
  exact (f.rootSet_finite ℂ).image _

theorem closed_componentsIn_ncard_le_rootSet
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree) {c : ℝ} (hc : 0 < c) :
    (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard ≤ (f.rootSet ℂ).ncard := by
  rw [closed_componentsIn_eq_image_rootSet hf hdeg hc]
  exact Set.ncard_image_le (f.rootSet_finite ℂ)

theorem closed_componentsIn_ncard_le_natDegree
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree) {c : ℝ} (hc : 0 < c) :
    (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard ≤ f.natDegree :=
  (closed_componentsIn_ncard_le_rootSet hf hdeg hc).trans (Polynomial.ncard_rootSet_le f ℂ)

#print axioms closure_strictSublevelSet
#print axioms closed_exists_root_in_component
#print axioms closed_componentsIn_ncard_le_natDegree

end
end Erdos1047ClosedGeneralCore

end

/- Source: Erdos1047ClosedLevelBridge.lean; SHA256: a44afe9c7c9a45b46902d4d5e7f4720fe462d22d7de6e3d6bba655759c9f3bb9 -/
section


/-!
# From finitely many strict witnesses to a closed-level maximum

Lower the level by less than every certificate's margin.  The certificates
survive, and the new closed sublevel lies inside the old strict sublevel, so
distinct anchor components remain distinct.  Root exhaustion then forces both
the component count and the number of distinct roots to equal the degree.
No regular-value or separability hypothesis is required.
-/

open Polynomial Set Erdos1047 Erdos1047Proof
open Erdos1047ClosedGeneralCore

namespace Erdos1047ClosedLevelBridge

noncomputable section

theorem exists_lower_level_certificate_family
    {n : ℕ} (hn : 0 < n) {F : ℂ → ℂ} {c : ℝ} (hc : 0 < c)
    {r a b : Fin n → ℂ}
    (hcert : ∀ i, Nonempty (RobustNonconvexCertificate F c (r i) (a i) (b i))) :
    ∃ d : ℝ, 0 < d ∧ d < c ∧
      ∀ i, Nonempty (RobustNonconvexCertificate F d (r i) (a i) (b i)) := by
  classical
  let cert := fun i => Classical.choice (hcert i)
  have hne : (Finset.univ : Finset (Fin n)).Nonempty :=
    ⟨⟨0, hn⟩, Finset.mem_univ _⟩
  let ε : ℝ := Finset.univ.inf' hne (fun i => (cert i).eps)
  have hε : 0 < ε := by
    obtain ⟨i, _, hi⟩ := Finset.exists_mem_eq_inf' hne (fun i => (cert i).eps)
    change 0 < Finset.univ.inf' hne (fun i => (cert i).eps)
    rw [hi]
    exact (cert i).eps_pos
  have hεle : ∀ i, ε ≤ (cert i).eps :=
    fun i => Finset.inf'_le _ (Finset.mem_univ i)
  let δ : ℝ := min c ε / 2
  have hδ : 0 < δ := half_pos (lt_min hc hε)
  have hδc : δ < c := by
    have := min_le_left c ε
    dsimp [δ]
    linarith
  have hδε : ∀ i, δ < (cert i).eps := by
    intro i
    have := min_le_right c ε
    have := hεle i
    dsimp [δ]
    linarith
  refine ⟨c - δ, by linarith, by linarith, ?_⟩
  intro i
  refine ⟨{
    eps := (cert i).eps - δ
    eps_pos := sub_pos.mpr (hδε i)
    lineA_margin := ?_
    lineB_margin := ?_
    midpoint_margin := ?_
  }⟩
  · intro z hz
    linarith [(cert i).lineA_margin z hz]
  · intro z hz
    linarith [(cert i).lineB_margin z hz]
  · linarith [(cert i).midpoint_margin]

theorem component_map_injOn_of_subset
    {S T : Set ℂ} (hST : S ⊆ T) {A : Set ℂ}
    (hmem : ∀ z ∈ A, z ∈ S)
    (hT : Set.InjOn (fun z => connectedComponentIn T z) A) :
    Set.InjOn (fun z => connectedComponentIn S z) A := by
  intro r hr s hs hEq
  change connectedComponentIn S r = connectedComponentIn S s at hEq
  apply hT hr hs
  have hsS : s ∈ connectedComponentIn S r := by
    rw [hEq]
    exact mem_connectedComponentIn (hmem s hs)
  exact connectedComponentIn_eq (connectedComponentIn_mono r hST hsS)

theorem exists_lower_level_closed_witness
    {f : ℂ[X]} {n : ℕ} (hf : f.Monic) (hdeg : f.natDegree = n) (hn : 0 < n)
    {c : ℝ} (hc : 0 < c) {r a b : Fin n → ℂ}
    (hrinj : Function.Injective r)
    (hcert : ∀ i, Nonempty (RobustNonconvexCertificate
      (fun z => f.eval z) c (r i) (a i) (b i)))
    (hinj : Set.InjOn (fun z => connectedComponentIn (strictSublevelSet f c) z)
      (Set.range r)) :
    ∃ d : ℝ, 0 < d ∧ d < c ∧
      (componentsIn (sublevelSet f d)).ncard = n ∧
      (f.rootSet ℂ).ncard = n ∧
      {t ∈ componentsIn (sublevelSet f d) | ¬ Convex ℝ t}.ncard = n := by
  obtain ⟨d, hd, hdc, hdcert⟩ := exists_lower_level_certificate_family hn hc hcert
  have hdegree : 0 < f.degree := by
    rw [degree_eq_natDegree hf.ne_zero, hdeg]
    exact_mod_cast hn
  have hmem : ∀ z ∈ Set.range r, z ∈ sublevelSet f d := by
    rintro _ ⟨i, rfl⟩
    obtain ⟨hi⟩ := hdcert i
    have hm := hi.lineA_margin (r i) (left_mem_segment ℝ (r i) (a i))
    change ‖f.eval (r i)‖ ≤ d
    linarith [hi.eps_pos]
  have hsub : sublevelSet f d ⊆ strictSublevelSet f c := by
    intro z hz
    exact lt_of_le_of_lt hz hdc
  have hclosedInj := component_map_injOn_of_subset hsub hmem hinj
  have hnc : ∀ z ∈ Set.range r,
      ¬ Convex ℝ (connectedComponentIn (sublevelSet f d) z) := by
    rintro _ ⟨i, rfl⟩
    exact (Classical.choice (hdcert i)).not_convex_component
  have hcard : (Set.range r).ncard = n := by
    simpa using Set.ncard_range_of_injective hrinj
  have hfin := closed_componentsIn_finite hf hdegree hd
  have hlow := nonconvex_ncard_ge_of_finite_witnesses
    (Set.finite_range r) hcard hmem hclosedInj hnc hfin
  have hnc_le : {t ∈ componentsIn (sublevelSet f d) | ¬ Convex ℝ t}.ncard ≤
      (componentsIn (sublevelSet f d)).ncard :=
    Set.ncard_le_ncard (fun _ ht => ht.1) hfin
  have hcomp_le := closed_componentsIn_ncard_le_rootSet hf hdegree hd
  have hroot_le : (f.rootSet ℂ).ncard ≤ n := by
    simpa only [hdeg] using Polynomial.ncard_rootSet_le f ℂ
  exact ⟨d, hd, hdc, by omega, by omega, by omega⟩

theorem closed_attainable_of_strict_certificate_family
    {f : ℂ[X]} {n : ℕ} (hf : f.Monic) (hdeg : f.natDegree = n) (hn : 0 < n)
    {c : ℝ} (hc : 0 < c) {r a b : Fin n → ℂ}
    (hrinj : Function.Injective r)
    (hcert : ∀ i, Nonempty (RobustNonconvexCertificate
      (fun z => f.eval z) c (r i) (a i) (b i)))
    (hinj : Set.InjOn (fun z => connectedComponentIn (strictSublevelSet f c) z)
      (Set.range r)) :
    n ∈ attainableNonConvexCounts n := by
  obtain ⟨d, hd, _, hcomp, hroot, hnc⟩ :=
    exists_lower_level_closed_witness hf hdeg hn hc hrinj hcert hinj
  exact ⟨f, d, hf, hdeg, hd, hcomp.trans hroot.symm, hnc⟩

#print axioms exists_lower_level_certificate_family
#print axioms exists_lower_level_closed_witness
#print axioms closed_attainable_of_strict_certificate_family

end
end Erdos1047ClosedLevelBridge

