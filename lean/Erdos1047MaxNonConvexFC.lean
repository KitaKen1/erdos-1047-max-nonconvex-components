/- Source: Erdos1047StrictQuadraticCore.lean; SHA256: 51468f3b3c7af75de77d3915ba84562f7d7d5489b07bb09f5ac10c098c58ec5a -/
section


/-!
# Strict quadratic normal form

This core isolates the easy branch of the current strict target.  Above the
critical level, a monic quadratic strict sublevel set is star-convex about its
critical point, hence connected.  The strict inequality is important: the
assumption is `‖q‖ < c`, not merely `‖q‖ ≤ c`, because the critical point must
itself belong to the strict set.
-/

open Polynomial
open Set

namespace Erdos1047StrictQuadratic

noncomputable section

def centeredStrictSublevel (q : ℂ) (c : ℝ) : Set ℂ :=
  {z | ‖z ^ 2 + q‖ < c}

theorem centeredStrictSublevel_starConvex (q : ℂ) (c : ℝ)
    (hq : ‖q‖ < c) :
    StarConvex ℝ 0 (centeredStrictSublevel q c) := by
  intro z hz a b ha hb hab
  change ‖(a • (0 : ℂ) + b • z) ^ 2 + q‖ < c
  rw [smul_zero, zero_add]
  have hb1 : b ≤ 1 := by linarith
  have hb2 : 0 ≤ b ^ 2 := sq_nonneg b
  have hb2one : b ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg ha (sub_nonneg.mpr hb1)]
  have hid : (b • z) ^ 2 + q =
      (b ^ 2) • (z ^ 2 + q) + (1 - b ^ 2) • q := by
    simp only [Complex.real_smul]
    push_cast
    ring
  rw [hid]
  calc
    ‖(b ^ 2) • (z ^ 2 + q) + (1 - b ^ 2) • q‖ ≤
        ‖(b ^ 2) • (z ^ 2 + q)‖ + ‖(1 - b ^ 2) • q‖ := norm_add_le _ _
    _ = b ^ 2 * ‖z ^ 2 + q‖ + (1 - b ^ 2) * ‖q‖ := by
      rw [norm_smul, norm_smul]
      simp [abs_of_nonneg hb2, abs_of_nonneg (sub_nonneg.mpr hb2one)]
    _ < b ^ 2 * c + (1 - b ^ 2) * c := by
      by_cases hb0 : b ^ 2 = 0
      · have hfirst : b ^ 2 * ‖z ^ 2 + q‖ ≤ b ^ 2 * c :=
          mul_le_mul_of_nonneg_left hz.le hb2
        have hsecond : (1 - b ^ 2) * ‖q‖ < (1 - b ^ 2) * c := by
          rw [hb0]
          simpa using hq
        exact add_lt_add_of_le_of_lt hfirst hsecond
      · have hbpos : 0 < b ^ 2 := lt_of_le_of_ne hb2 (Ne.symm hb0)
        have hfirst : b ^ 2 * ‖z ^ 2 + q‖ < b ^ 2 * c :=
          mul_lt_mul_of_pos_left hz hbpos
        have hsecond : (1 - b ^ 2) * ‖q‖ ≤ (1 - b ^ 2) * c :=
          mul_le_mul_of_nonneg_left hq.le (sub_nonneg.mpr hb2one)
        exact add_lt_add_of_lt_of_le hfirst hsecond
    _ = c := by ring

theorem centeredStrictSublevel_nonempty (q : ℂ) (c : ℝ) (hq : ‖q‖ < c) :
    (centeredStrictSublevel q c).Nonempty := by
  refine ⟨0, ?_⟩
  change ‖(0 : ℂ) ^ 2 + q‖ < c
  simpa using hq

theorem centeredStrictSublevel_isPreconnected (q : ℂ) (c : ℝ)
    (hq : ‖q‖ < c) :
    IsPreconnected (centeredStrictSublevel q c) :=
  (((centeredStrictSublevel_starConvex q c hq).isPathConnected
    (by
      change ‖(0 : ℂ) ^ 2 + q‖ < c
      simpa using hq)).isConnected).isPreconnected

def center (f : ℂ[X]) : ℂ := -(f.coeff 1) / 2

def criticalValue (f : ℂ[X]) : ℂ :=
  f.coeff 0 - (f.coeff 1) ^ 2 / 4

theorem monic_quadratic_eq (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) :
    f = X ^ 2 + C (f.coeff 1) * X + C (f.coeff 0) := by
  conv_lhs =>
    rw [f.as_sum_range_C_mul_X_pow, hdeg, Finset.sum_range_succ,
      Finset.sum_range_succ, Finset.sum_range_one, ← hdeg,
      hf.coeff_natDegree, hdeg]
  simp only [C_1]
  ring

theorem monic_quadratic_eval_center_add (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (z : ℂ) :
    f.eval (center f + z) = z ^ 2 + criticalValue f := by
  rw [monic_quadratic_eq f hf hdeg]
  simp [center, criticalValue]
  ring

theorem monic_quadratic_strictSublevel_eq (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) :
    Erdos1047.strictSublevelSet f c =
      (fun z => center f + z) '' centeredStrictSublevel (criticalValue f) c := by
  ext z
  constructor
  · intro hz
    change ‖f.eval z‖ < c at hz
    refine ⟨z - center f, ?_, by ring⟩
    change ‖(z - center f) ^ 2 + criticalValue f‖ < c
    rw [← monic_quadratic_eval_center_add f hf hdeg (z - center f)]
    simpa only [add_sub_cancel] using hz
  · rintro ⟨w, hw, rfl⟩
    change ‖w ^ 2 + criticalValue f‖ < c at hw
    change ‖f.eval (center f + w)‖ < c
    rw [monic_quadratic_eval_center_add f hf hdeg]
    exact hw

theorem monic_quadratic_strictSublevel_starConvex (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ)
    (hc : ‖criticalValue f‖ < c) :
    StarConvex ℝ (center f) (Erdos1047.strictSublevelSet f c) := by
  rw [monic_quadratic_strictSublevel_eq f hf hdeg c]
  simpa using
    (centeredStrictSublevel_starConvex (criticalValue f) c hc).add_left
      (center f)

theorem monic_quadratic_center_mem_strictSublevel (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ)
    (hc : ‖criticalValue f‖ < c) :
    center f ∈ Erdos1047.strictSublevelSet f c := by
  change ‖f.eval (center f)‖ < c
  have he := monic_quadratic_eval_center_add f hf hdeg 0
  have heval : f.eval (center f) = criticalValue f := by simpa using he
  rw [heval]
  exact hc

theorem monic_quadratic_strictSublevel_isPreconnected (f : ℂ[X])
    (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ)
    (hc : ‖criticalValue f‖ < c) :
    IsPreconnected (Erdos1047.strictSublevelSet f c) := by
  exact (((monic_quadratic_strictSublevel_starConvex f hf hdeg c hc).isPathConnected
    (monic_quadratic_center_mem_strictSublevel f hf hdeg c hc)).isConnected).isPreconnected

theorem componentsIn_eq_singleton_of_isPreconnected {S : Set ℂ}
    (hS : IsPreconnected S) (hne : S.Nonempty) :
    Erdos1047.componentsIn S = {S} := by
  ext t
  constructor
  · rintro ⟨z, hz, rfl⟩
    simpa using hS.connectedComponentIn hz
  · intro ht
    obtain ⟨z, hz⟩ := hne
    exact ⟨z, hz, (Set.mem_singleton_iff.mp ht).trans
      (hS.connectedComponentIn hz).symm⟩

theorem monic_quadratic_strictSublevel_components_ncard_eq_one
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ)
    (hc : ‖criticalValue f‖ < c) :
    (Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c)).ncard = 1 := by
  rw [componentsIn_eq_singleton_of_isPreconnected
    (monic_quadratic_strictSublevel_isPreconnected f hf hdeg c hc)
    ⟨center f, monic_quadratic_center_mem_strictSublevel f hf hdeg c hc⟩]
  simp

theorem monic_quadratic_strictSublevel_nonconvex_ncard_le_one
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ)
    (hc : ‖criticalValue f‖ < c) :
    {t ∈ Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) |
      ¬ Convex ℝ t}.ncard ≤ 1 := by
  have hcomp : Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) =
      {Erdos1047.strictSublevelSet f c} := by
    exact componentsIn_eq_singleton_of_isPreconnected
      (monic_quadratic_strictSublevel_isPreconnected f hf hdeg c hc)
      ⟨center f, monic_quadratic_center_mem_strictSublevel f hf hdeg c hc⟩
  rw [hcomp]
  rw [Set.ncard_le_one]
  intro a ha b hb
  exact ha.1.trans hb.1.symm

#print axioms monic_quadratic_strictSublevel_starConvex
#print axioms monic_quadratic_strictSublevel_components_ncard_eq_one
#print axioms monic_quadratic_strictSublevel_nonconvex_ncard_le_one

end
end Erdos1047StrictQuadratic

end

/- Source: Erdos1047StrictCassiniCore.lean; SHA256: f2effd5aa884dbc1d97f83193e91463c0a7d5742e70db5ae43f860d26e52550d -/
section


/-!
# Strict subcritical Cassini components

The closed Cassini core already contains the derivative and curvature
calculation for the two lobes.  This file transfers that calculation to the
strict inequality `‖z^2 - 1‖ < ρ` for `0 < ρ < 1`.  The critical equality
`ρ = 1` is deliberately not silently included: its cusp is a separate case.
-/

open Polynomial
open Set

namespace Erdos1047StrictCassini

noncomputable section

open Erdos1047Quadratic

def strictCassiniSublevel (ρ : ℝ) : Set ℂ :=
  {z | ‖z ^ 2 - 1‖ < ρ}

def strictCassiniRightSublevel (ρ : ℝ) : Set ℂ :=
  {z | ‖z ^ 2 - 1‖ < ρ ∧ 0 ≤ z.re}

def strictCassiniLeftSublevel (ρ : ℝ) : Set ℂ :=
  {z | ‖z ^ 2 - 1‖ < ρ ∧ z.re ≤ 0}

def strictCassiniBand (ρ : ℝ) : Set ℂ :=
  {z | z.im ∈ Set.Ioo (-ρ / 2) (ρ / 2) ∧
    cassiniLower ρ z.im < z.re ∧ z.re < cassiniUpper ρ z.im}

theorem strictCassini_normSq_sub_one_lt_iff {ρ : ℝ} (hρ : 0 ≤ ρ) (z : ℂ) :
    ‖z ^ 2 - 1‖ < ρ ↔
      Complex.normSq (z ^ 2 - 1) < ρ ^ 2 := by
  rw [Complex.normSq_eq_norm_sq, sq_lt_sq₀ (norm_nonneg _) hρ]

theorem strictCassini_re_ne_zero {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ ≤ 1)
    {z : ℂ} (hz : z ∈ strictCassiniSublevel ρ) : z.re ≠ 0 := by
  intro hre
  have hnormSq : Complex.normSq (z ^ 2 - 1) < ρ ^ 2 :=
    (strictCassini_normSq_sub_one_lt_iff hρ.le z).mp hz
  rw [cassini_normSq_sub_one, hre] at hnormSq
  have hρsq : ρ ^ 2 ≤ 1 := by nlinarith
  nlinarith [sq_nonneg (z.im ^ 2), sq_nonneg (z.im ^ 2 + 1)]

theorem strictCassiniRightSublevel_eq_band {ρ : ℝ} (hρ : 0 < ρ)
    (hρ1 : ρ < 1) :
    strictCassiniRightSublevel ρ = strictCassiniBand ρ := by
  ext z
  constructor
  · rintro ⟨hnorm, hx⟩
    have hnormSq : (z.re ^ 2 + z.im ^ 2 - 1) ^ 2 + 4 * z.im ^ 2 < ρ ^ 2 := by
      rw [← cassini_normSq_sub_one]
      exact (strictCassini_normSq_sub_one_lt_iff hρ.le z).mp hnorm
    have hySq : z.im ^ 2 < (ρ / 2) ^ 2 := by
      nlinarith [sq_nonneg (z.re ^ 2 + z.im ^ 2 - 1)]
    have hyAbs : |z.im| < ρ / 2 := by
      apply (sq_lt_sq₀ (abs_nonneg _) (by linarith)).mp
      simpa only [sq_abs] using hySq
    have hy : z.im ∈ Set.Ioo (-ρ / 2) (ρ / 2) := by
      constructor <;> linarith [(abs_lt.mp hyAbs).1, (abs_lt.mp hyAbs).2]
    have hdsq : cassiniDelta ρ z.im ^ 2 = ρ ^ 2 - 4 * z.im ^ 2 := by
      rw [cassiniDelta, Real.sq_sqrt (cassini_radicand_pos hρ hy).le]
    have hsSq : (z.re ^ 2 + z.im ^ 2 - 1) ^ 2 < cassiniDelta ρ z.im ^ 2 := by
      nlinarith
    have hd0 : 0 ≤ cassiniDelta ρ z.im := Real.sqrt_nonneg _
    have hsAbs : |z.re ^ 2 + z.im ^ 2 - 1| < cassiniDelta ρ z.im := by
      apply (sq_lt_sq₀ (abs_nonneg _) hd0).mp
      simpa only [sq_abs] using hsSq
    have hs := abs_lt.mp hsAbs
    have hycc : z.im ∈ Set.Icc (-ρ / 2) (ρ / 2) :=
      ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    have hLsq := cassiniLower_sq hρ.le hρ1.le hycc
    have hUsq := cassiniUpper_sq hρ.le hρ1.le hycc
    have hL0 : 0 ≤ cassiniLower ρ z.im := by
      rw [cassiniLower]
      exact Real.sqrt_nonneg _
    have hU0 : 0 ≤ cassiniUpper ρ z.im := by
      rw [cassiniUpper]
      exact Real.sqrt_nonneg _
    have hL : cassiniLower ρ z.im < z.re := by
      apply (sq_lt_sq₀ hL0 hx).mp
      rw [hLsq]
      nlinarith [hs.1]
    have hU : z.re < cassiniUpper ρ z.im := by
      apply (sq_lt_sq₀ hx hU0).mp
      rw [hUsq]
      nlinarith [hs.2]
    exact ⟨hy, hL, hU⟩
  · rintro ⟨hy, hL, hU⟩
    have hL0 : 0 ≤ cassiniLower ρ z.im := by
      rw [cassiniLower]
      exact Real.sqrt_nonneg _
    have hU0 : 0 ≤ cassiniUpper ρ z.im := by
      rw [cassiniUpper]
      exact Real.sqrt_nonneg _
    have hx : 0 < z.re := lt_of_le_of_lt hL0 hL
    have hycc : z.im ∈ Set.Icc (-ρ / 2) (ρ / 2) :=
      ⟨le_of_lt hy.1, le_of_lt hy.2⟩
    have hLsq := cassiniLower_sq hρ.le hρ1.le hycc
    have hUsq := cassiniUpper_sq hρ.le hρ1.le hycc
    have hsLower : -cassiniDelta ρ z.im < z.re ^ 2 + z.im ^ 2 - 1 := by
      have hs := (sq_lt_sq₀ hL0 hx.le).mpr hL
      rw [hLsq] at hs
      nlinarith
    have hsUpper : z.re ^ 2 + z.im ^ 2 - 1 < cassiniDelta ρ z.im := by
      have hs := (sq_lt_sq₀ hx.le hU0).mpr hU
      rw [hUsq] at hs
      nlinarith
    have hsSq : (z.re ^ 2 + z.im ^ 2 - 1) ^ 2 < cassiniDelta ρ z.im ^ 2 :=
      sq_lt_sq' hsLower hsUpper
    have hdeltaSq : cassiniDelta ρ z.im ^ 2 = ρ ^ 2 - 4 * z.im ^ 2 := by
      rw [cassiniDelta, Real.sq_sqrt (cassiniRadicand_nonneg hρ.le hycc)]
    refine ⟨(strictCassini_normSq_sub_one_lt_iff hρ.le z).mpr ?_, hx.le⟩
    rw [cassini_normSq_sub_one]
    nlinarith

theorem strictCassiniRightSublevel_convex {ρ : ℝ} (hρ : 0 < ρ)
    (hρ1 : ρ < 1) : Convex ℝ (strictCassiniRightSublevel ρ) := by
  rw [strictCassiniRightSublevel_eq_band hρ hρ1]
  intro z hz w hw a b ha hb hab
  have him : (a • z + b • w).im = a * z.im + b * w.im := by simp
  have hre : (a • z + b • w).re = a * z.re + b * w.re := by simp
  have hD : a * z.im + b * w.im ∈ Set.Ioo (-ρ / 2) (ρ / 2) := by
    simpa only [smul_eq_mul] using
      convex_Ioo (-ρ / 2) (ρ / 2) hz.1 hw.1 ha hb hab
  have hzcc : z.im ∈ Set.Icc (-ρ / 2) (ρ / 2) :=
    ⟨le_of_lt hz.1.1, le_of_lt hz.1.2⟩
  have hwcc : w.im ∈ Set.Icc (-ρ / 2) (ρ / 2) :=
    ⟨le_of_lt hw.1.1, le_of_lt hw.1.2⟩
  have hlower := (cassiniLower_convexOn hρ hρ1).2 hzcc hwcc ha hb hab
  have hupper := (cassiniUpper_concaveOn hρ.le hρ1.le).2 hzcc hwcc ha hb hab
  simp only [smul_eq_mul] at hlower hupper
  have hlowmix : a * cassiniLower ρ z.im + b * cassiniLower ρ w.im <
      a * z.re + b * w.re := by
    by_cases ha0 : a = 0
    · have hb1 : b = 1 := by linarith
      rw [ha0, hb1]
      simpa using hw.2.1
    · by_cases hb0 : b = 0
      · have ha1 : a = 1 := by linarith
        rw [hb0, ha1]
        simp
        simpa using hz.2.1
      · exact add_lt_add
          (mul_lt_mul_of_pos_left hz.2.1 (lt_of_le_of_ne ha (Ne.symm ha0)))
          (mul_lt_mul_of_pos_left hw.2.1 (lt_of_le_of_ne hb (Ne.symm hb0)))
  have huprmix : a * z.re + b * w.re <
      a * cassiniUpper ρ z.im + b * cassiniUpper ρ w.im := by
    by_cases ha0 : a = 0
    · have hb1 : b = 1 := by linarith
      rw [ha0, hb1]
      simpa using hw.2.2
    · by_cases hb0 : b = 0
      · have ha1 : a = 1 := by linarith
        rw [hb0, ha1]
        simp
        simpa using hz.2.2
      · exact add_lt_add
          (mul_lt_mul_of_pos_left hz.2.2 (lt_of_le_of_ne ha (Ne.symm ha0)))
          (mul_lt_mul_of_pos_left hw.2.2 (lt_of_le_of_ne hb (Ne.symm hb0)))
  change (a • z + b • w).im ∈ Set.Ioo (-ρ / 2) (ρ / 2) ∧
    cassiniLower ρ (a • z + b • w).im < (a • z + b • w).re ∧
    (a • z + b • w).re < cassiniUpper ρ (a • z + b • w).im
  rw [him, hre]
  refine ⟨hD, ?_, ?_⟩
  · exact lt_of_le_of_lt hlower hlowmix
  · exact lt_of_lt_of_le huprmix hupper

/- The equality case `ρ = 1` is obtained as a directed union of the
   subcritical right lobes.  This avoids differentiating the cusp of the lower
   boundary at the origin. -/
theorem strictCassiniRightSublevel_convex_one :
    Convex ℝ (strictCassiniRightSublevel 1) := by
  intro z hz w hw a b ha hb hab
  let ρ : ℝ :=
    (max ‖z ^ 2 - 1‖ ‖w ^ 2 - 1‖ + 1) / 2
  have hzlt : ‖z ^ 2 - 1‖ < 1 := hz.1
  have hwlt : ‖w ^ 2 - 1‖ < 1 := hw.1
  have hm0 : 0 ≤ max ‖z ^ 2 - 1‖ ‖w ^ 2 - 1‖ :=
    le_trans (norm_nonneg _) (le_max_left _ _)
  have hρ : 0 < ρ := by
    dsimp [ρ]
    nlinarith
  have hρ1 : ρ < 1 := by
    have hmz : ‖z ^ 2 - 1‖ ≤ max ‖z ^ 2 - 1‖ ‖w ^ 2 - 1‖ := le_max_left _ _
    have hmw : ‖w ^ 2 - 1‖ ≤ max ‖z ^ 2 - 1‖ ‖w ^ 2 - 1‖ := le_max_right _ _
    have hm_lt : max ‖z ^ 2 - 1‖ ‖w ^ 2 - 1‖ < 1 := max_lt hzlt hwlt
    dsimp [ρ]
    nlinarith [hm_lt]
  have hzρ : z ∈ strictCassiniRightSublevel ρ := by
    refine ⟨?_, hz.2⟩
    dsimp [ρ]
    have hmz : ‖z ^ 2 - 1‖ ≤ max ‖z ^ 2 - 1‖ ‖w ^ 2 - 1‖ := le_max_left _ _
    nlinarith
  have hwρ : w ∈ strictCassiniRightSublevel ρ := by
    refine ⟨?_, hw.2⟩
    dsimp [ρ]
    have hmw : ‖w ^ 2 - 1‖ ≤ max ‖z ^ 2 - 1‖ ‖w ^ 2 - 1‖ := le_max_right _ _
    nlinarith
  have hseg := strictCassiniRightSublevel_convex hρ hρ1 hzρ hwρ ha hb hab
  change ‖(a • z + b • w) ^ 2 - 1‖ < 1 ∧
    0 ≤ (a • z + b • w).re
  exact ⟨lt_trans hseg.1 (by linarith), hseg.2⟩

theorem strictCassiniLeftSublevel_eq_neg_right' (ρ : ℝ) :
    strictCassiniLeftSublevel ρ = -(strictCassiniRightSublevel ρ) := by
  ext z
  constructor
  · rintro ⟨hz, hre⟩
    rw [Set.mem_neg]
    refine ⟨?_, ?_⟩
    · simpa only [neg_sq, neg_sub, norm_neg] using hz
    · simpa using hre
  · intro hz
    rw [Set.mem_neg] at hz
    rcases hz with ⟨hnorm, hre⟩
    refine ⟨?_, ?_⟩
    · simpa only [neg_sq, neg_sub, norm_neg] using hnorm
    · simpa using hre

theorem strictCassiniLeftSublevel_convex_one :
    Convex ℝ (strictCassiniLeftSublevel 1) := by
  rw [strictCassiniLeftSublevel_eq_neg_right']
  exact strictCassiniRightSublevel_convex_one.neg

theorem strictCassiniRightSublevel_convex_of_le_one {ρ : ℝ} (hρ : 0 < ρ)
    (hρ1 : ρ ≤ 1) : Convex ℝ (strictCassiniRightSublevel ρ) := by
  by_cases hlt : ρ < 1
  · exact strictCassiniRightSublevel_convex hρ hlt
  · have heq : ρ = 1 := le_antisymm hρ1 (le_of_not_gt hlt)
    simpa [heq] using strictCassiniRightSublevel_convex_one

theorem strictCassiniLeftSublevel_convex_of_le_one {ρ : ℝ} (hρ : 0 < ρ)
    (hρ1 : ρ ≤ 1) : Convex ℝ (strictCassiniLeftSublevel ρ) := by
  rw [strictCassiniLeftSublevel_eq_neg_right']
  exact (strictCassiniRightSublevel_convex_of_le_one hρ hρ1).neg

theorem strictCassini_component_convex_of_le_one {ρ : ℝ} (hρ : 0 < ρ)
    (hρ1 : ρ ≤ 1) {z : ℂ} (hz : z ∈ strictCassiniSublevel ρ) :
    Convex ℝ (connectedComponentIn (strictCassiniSublevel ρ) z) := by
  rcases lt_or_gt_of_ne (strictCassini_re_ne_zero hρ hρ1 hz) with hzneg | hzpos
  · have hzleft : z ∈ strictCassiniLeftSublevel ρ := ⟨hz, hzneg.le⟩
    have hstay : ∀ w ∈ connectedComponentIn (strictCassiniSublevel ρ) z, w.re < 0 := by
      apply Erdos1047Quadratic.negative_on_component
        (φ := fun w : ℂ => w.re) (by fun_prop) _ hz hzneg
      intro w hw
      exact strictCassini_re_ne_zero hρ hρ1 hw
    have heq : connectedComponentIn (strictCassiniSublevel ρ) z =
        strictCassiniLeftSublevel ρ := by
      apply Set.Subset.antisymm
      · intro w hw
        have hwS : w ∈ strictCassiniSublevel ρ :=
          connectedComponentIn_subset (strictCassiniSublevel ρ) z hw
        exact ⟨hwS, (hstay w hw).le⟩
      · exact ((strictCassiniLeftSublevel_convex_of_le_one hρ hρ1).isPreconnected).subset_connectedComponentIn
          hzleft (fun w hw => hw.1)
    rw [heq]
    exact strictCassiniLeftSublevel_convex_of_le_one hρ hρ1
  · have hzright : z ∈ strictCassiniRightSublevel ρ := ⟨hz, hzpos.le⟩
    have hstay : ∀ w ∈ connectedComponentIn (strictCassiniSublevel ρ) z, 0 < w.re := by
      have h := Erdos1047Quadratic.negative_on_component
        (S := strictCassiniSublevel ρ) (r := z) (φ := fun w : ℂ => -w.re)
        (by fun_prop) (fun w hw hzero =>
          strictCassini_re_ne_zero hρ hρ1 hw (by linarith)) hz (by linarith)
      intro w hw
      linarith [h w hw]
    have heq : connectedComponentIn (strictCassiniSublevel ρ) z =
        strictCassiniRightSublevel ρ := by
      apply Set.Subset.antisymm
      · intro w hw
        have hwS : w ∈ strictCassiniSublevel ρ :=
          connectedComponentIn_subset (strictCassiniSublevel ρ) z hw
        exact ⟨hwS, (hstay w hw).le⟩
      · exact ((strictCassiniRightSublevel_convex_of_le_one hρ hρ1).isPreconnected).subset_connectedComponentIn
          hzright (fun w hw => hw.1)
    rw [heq]
    exact strictCassiniRightSublevel_convex_of_le_one hρ hρ1

theorem strictCassini_components_convex_of_le_one {ρ : ℝ} (hρ : 0 < ρ)
    (hρ1 : ρ ≤ 1) :
    ∀ t ∈ {t : Set ℂ | ∃ z ∈ strictCassiniSublevel ρ,
      t = connectedComponentIn (strictCassiniSublevel ρ) z}, Convex ℝ t := by
  rintro _ ⟨z, hz, rfl⟩
  exact strictCassini_component_convex_of_le_one hρ hρ1 hz

theorem strictCassiniLeftSublevel_eq_neg_right (ρ : ℝ) :
    strictCassiniLeftSublevel ρ = -(strictCassiniRightSublevel ρ) := by
  ext z
  constructor
  · rintro ⟨hz, hre⟩
    rw [Set.mem_neg]
    refine ⟨?_, ?_⟩
    · simpa only [neg_sq, neg_sub, norm_neg] using hz
    · simpa using hre
  · intro hz
    rw [Set.mem_neg] at hz
    rcases hz with ⟨hnorm, hre⟩
    refine ⟨?_, ?_⟩
    · simpa only [neg_sq, neg_sub, norm_neg] using hnorm
    · simpa using hre

theorem strictCassiniLeftSublevel_convex {ρ : ℝ} (hρ : 0 < ρ)
    (hρ1 : ρ < 1) : Convex ℝ (strictCassiniLeftSublevel ρ) := by
  rw [strictCassiniLeftSublevel_eq_neg_right]
  exact (strictCassiniRightSublevel_convex hρ hρ1).neg

theorem strictCassini_component_convex {ρ : ℝ} (hρ : 0 < ρ)
    (hρ1 : ρ < 1) {z : ℂ} (hz : z ∈ strictCassiniSublevel ρ) :
    Convex ℝ (connectedComponentIn (strictCassiniSublevel ρ) z) := by
  rcases lt_or_gt_of_ne (strictCassini_re_ne_zero hρ hρ1.le hz) with hzneg | hzpos
  · have hzleft : z ∈ strictCassiniLeftSublevel ρ := ⟨hz, hzneg.le⟩
    have hstay : ∀ w ∈ connectedComponentIn (strictCassiniSublevel ρ) z, w.re < 0 := by
      apply negative_on_component (φ := fun w : ℂ => w.re) (by fun_prop) _ hz hzneg
      intro w hw
      exact strictCassini_re_ne_zero hρ hρ1.le hw
    have heq : connectedComponentIn (strictCassiniSublevel ρ) z =
        strictCassiniLeftSublevel ρ := by
      apply Set.Subset.antisymm
      · intro w hw
        have hwS : w ∈ strictCassiniSublevel ρ :=
          connectedComponentIn_subset (strictCassiniSublevel ρ) z hw
        exact ⟨hwS, (hstay w hw).le⟩
      · exact ((strictCassiniLeftSublevel_convex hρ hρ1).isPreconnected).subset_connectedComponentIn
          hzleft (fun w hw => hw.1)
    rw [heq]
    exact strictCassiniLeftSublevel_convex hρ hρ1
  · have hzright : z ∈ strictCassiniRightSublevel ρ := ⟨hz, hzpos.le⟩
    have hstay : ∀ w ∈ connectedComponentIn (strictCassiniSublevel ρ) z, 0 < w.re := by
      have h := negative_on_component
        (S := strictCassiniSublevel ρ) (r := z) (φ := fun w : ℂ => -w.re)
        (by fun_prop) (fun w hw hzero =>
          strictCassini_re_ne_zero hρ hρ1.le hw (by linarith)) hz (by linarith)
      intro w hw
      linarith [h w hw]
    have heq : connectedComponentIn (strictCassiniSublevel ρ) z =
        strictCassiniRightSublevel ρ := by
      apply Set.Subset.antisymm
      · intro w hw
        have hwS : w ∈ strictCassiniSublevel ρ :=
          connectedComponentIn_subset (strictCassiniSublevel ρ) z hw
        exact ⟨hwS, (hstay w hw).le⟩
      · exact ((strictCassiniRightSublevel_convex hρ hρ1).isPreconnected).subset_connectedComponentIn
          hzright (fun w hw => hw.1)
    rw [heq]
    exact strictCassiniRightSublevel_convex hρ hρ1

theorem strictCassini_components_convex {ρ : ℝ} (hρ : 0 < ρ)
    (hρ1 : ρ < 1) :
    ∀ t ∈ {t : Set ℂ | ∃ z ∈ strictCassiniSublevel ρ,
      t = connectedComponentIn (strictCassiniSublevel ρ) z}, Convex ℝ t := by
  rintro _ ⟨z, hz, rfl⟩
  exact strictCassini_component_convex hρ hρ1 hz

#print axioms strictCassiniRightSublevel_convex
#print axioms strictCassini_component_convex
#print axioms strictCassiniRightSublevel_convex_one
#print axioms strictCassini_component_convex_of_le_one

end
end Erdos1047StrictCassini

