/-!
# Even-degree algebraic family for Erdős #1047

This file records the algebraic part of the paper's proposed even-degree family

`p_(2m)(z) = (z^m - 1)^2 + 1`.

It deliberately does not assert the geometric component count or non-convexity:
those are the analytic/topological obligations still needed for the global target.
The lemmas here are kernel-checked and provide the exact polynomial, factorisation,
degree, derivative, root, and critical-value interfaces for that later work.
-/

open Polynomial

namespace Erdos1047EvenFamily

noncomputable section

/-- The even-degree family from the paper-level construction. -/
def evenFamilyPolynomial (m : ℕ) : ℂ[X] :=
  (X ^ m - C (1 : ℂ)) ^ 2 + C (1 : ℂ)

theorem evenFamily_eval (m : ℕ) (z : ℂ) :
    (evenFamilyPolynomial m).eval z = (z ^ m - 1) ^ 2 + 1 := by
  simp [evenFamilyPolynomial]

theorem evenFamily_monic (m : ℕ) (hm : 0 < m) :
    (evenFamilyPolynomial m).Monic := by
  unfold evenFamilyPolynomial
  have hsub : (C (1 : ℂ) : ℂ[X]).degree < (X ^ m : ℂ[X]).degree := by
    rw [degree_C (by norm_num), degree_X_pow]
    exact_mod_cast hm
  have hpow : (X ^ m - C (1 : ℂ)).Monic :=
    (monic_X_pow m).sub_of_left hsub
  have hsq : ((X ^ m - C (1 : ℂ)) ^ 2 : ℂ[X]).Monic := hpow.pow 2
  apply hsq.add_of_left
  rw [degree_C (by norm_num), degree_pow]
  have hbase_deg : (X ^ m - C (1 : ℂ)).degree = (m : WithBot ℕ) := by
    rw [degree_sub_eq_left_of_degree_lt hsub, degree_X_pow]
  rw [hbase_deg]
  have hm' : (0 : WithBot ℕ) < (m : WithBot ℕ) := by exact_mod_cast hm
  simpa using (nsmul_pos hm' (by norm_num : (2 : ℕ) ≠ 0))

theorem evenFamily_natDegree (m : ℕ) (hm : 0 < m) :
    (evenFamilyPolynomial m).natDegree = 2 * m := by
  unfold evenFamilyPolynomial
  have hsub : (C (1 : ℂ) : ℂ[X]).natDegree < (X ^ m : ℂ[X]).natDegree := by
    rw [natDegree_C, natDegree_X_pow]
    exact hm
  have hpow : (X ^ m - C (1 : ℂ)).Monic := by
    apply (monic_X_pow m).sub_of_left
    rw [degree_C (by norm_num), degree_X_pow]
    exact_mod_cast hm
  have hbase_nd : (X ^ m - C (1 : ℂ)).natDegree = m := by
    rw [natDegree_sub_eq_left_of_natDegree_lt hsub, natDegree_X_pow]
  have hsubpow : (C (1 : ℂ) : ℂ[X]).natDegree <
      ((X ^ m - C (1 : ℂ)) ^ 2).natDegree := by
    rw [natDegree_pow, hbase_nd, natDegree_C]
    omega
  rw [natDegree_add_eq_left_of_natDegree_lt hsubpow]
  rw [natDegree_pow, hbase_nd]

theorem evenFamily_derivative (m : ℕ) :
    (evenFamilyPolynomial m).derivative =
      C (2 * m : ℂ) * X ^ (m - 1) * (X ^ m - C (1 : ℂ)) := by
  unfold evenFamilyPolynomial
  rw [derivative_add, derivative_pow, derivative_sub, derivative_pow, derivative_C]
  simp
  ring

theorem evenFamily_factorization (m : ℕ) :
    evenFamilyPolynomial m =
      (X ^ m - C (1 + Complex.I)) * (X ^ m - C (1 - Complex.I)) := by
  apply Polynomial.funext
  intro z
  simp [evenFamilyPolynomial, pow_two]
  ring_nf
  rw [Complex.I_sq]
  ring

theorem evenFamily_root_iff (m : ℕ) (z : ℂ) :
    (evenFamilyPolynomial m).eval z = 0 ↔
      z ^ m = 1 + Complex.I ∨ z ^ m = 1 - Complex.I := by
  rw [evenFamily_factorization, eval_mul]
  simp only [eval_sub, eval_pow, eval_X, eval_C, mul_eq_zero]
  constructor
  · intro h
    rcases h with h | h
    · left
      exact sub_eq_zero.mp h
    · right
      exact sub_eq_zero.mp h
  · intro h
    rcases h with h | h
    · left
      exact sub_eq_zero.mpr h
    · right
      exact sub_eq_zero.mpr h

theorem evenFamily_mem_rootSet_iff
    {m : ℕ} (hm : 0 < m) (z : ℂ) :
    z ∈ (evenFamilyPolynomial m).rootSet ℂ ↔
      z ^ m = 1 + Complex.I ∨ z ^ m = 1 - Complex.I := by
  rw [(evenFamily_monic m hm).mem_rootSet]
  exact evenFamily_root_iff m z

/-! Multiplication by an `m`-th root of unity is an exact symmetry of the
    even family.  These pointwise identities are the algebraic input for
    transporting angular separator certificates between the `2m` roots. -/
theorem evenFamily_eval_mul_root_of_unity {m : ℕ} {u z : ℂ}
    (hu : u ^ m = 1) :
    (evenFamilyPolynomial m).eval (u * z) =
      (evenFamilyPolynomial m).eval z := by
  rw [evenFamily_eval, evenFamily_eval, mul_pow, hu]
  ring

theorem evenFamily_norm_eval_mul_root_of_unity {m : ℕ} {u z : ℂ}
    (hu : u ^ m = 1) :
    ‖(evenFamilyPolynomial m).eval (u * z)‖ =
      ‖(evenFamilyPolynomial m).eval z‖ := by
  rw [evenFamily_eval_mul_root_of_unity hu]

theorem evenFamily_eval_star (m : ℕ) (z : ℂ) :
    (evenFamilyPolynomial m).eval (star z) =
      star ((evenFamilyPolynomial m).eval z) := by
  rw [evenFamily_eval, evenFamily_eval]
  simp

theorem evenFamily_norm_eval_star (m : ℕ) (z : ℂ) :
    ‖(evenFamilyPolynomial m).eval (star z)‖ =
      ‖(evenFamilyPolynomial m).eval z‖ := by
  rw [evenFamily_eval_star]
  exact norm_star _

theorem evenFamily_star_mem_rootSet {m : ℕ} (hm : 0 < m) {z : ℂ}
    (hz : z ∈ (evenFamilyPolynomial m).rootSet ℂ) :
    star z ∈ (evenFamilyPolynomial m).rootSet ℂ := by
  rw [evenFamily_mem_rootSet_iff hm] at hz ⊢
  rcases hz with hz | hz
  · right
    have hstar := congrArg (starRingEnd ℂ) hz
    simpa [sub_eq_add_neg] using hstar
  · left
    have hstar := congrArg (starRingEnd ℂ) hz
    simpa [sub_eq_add_neg] using hstar

theorem evenFamily_root_ne_zero {m : ℕ} (hm : 0 < m) {z : ℂ}
    (hz : z ∈ (evenFamilyPolynomial m).rootSet ℂ) : z ≠ 0 := by
  intro hz0
  subst z
  rw [evenFamily_mem_rootSet_iff hm] at hz
  have hm0 : m ≠ 0 := Nat.ne_of_gt hm
  rcases hz with hz | hz
  · rw [zero_pow hm0] at hz
    have hi := congrArg Complex.im hz
    norm_num at hi
  · rw [zero_pow hm0] at hz
    have hi := congrArg Complex.im hz
    norm_num at hi

/-! All roots of the even family lie on one circle.  This elementary metric
    fact is useful for the angular-separation argument: the two branches differ
    only by their argument, not by their radius. -/
theorem evenFamily_root_norm_pow_eq_sqrt_two {m : ℕ} (hm : 0 < m) {z : ℂ}
    (hz : z ∈ (evenFamilyPolynomial m).rootSet ℂ) :
    ‖z‖ ^ m = Real.sqrt 2 := by
  rw [evenFamily_mem_rootSet_iff hm] at hz
  rcases hz with hz | hz
  · rw [← Complex.norm_pow, hz]
    have hsq : Complex.normSq (1 + Complex.I) = (2 : ℝ) := by
      norm_num [Complex.normSq_apply]
    rw [Complex.normSq_eq_norm_sq] at hsq
    have hsqrt : (Real.sqrt 2) ^ 2 = (2 : ℝ) := by
      norm_num
    have hsqrt_nonneg : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg _
    nlinarith [norm_nonneg (1 + Complex.I)]
  · rw [← Complex.norm_pow, hz]
    have hsq : Complex.normSq (1 - Complex.I) = (2 : ℝ) := by
      norm_num [Complex.normSq_apply]
    rw [Complex.normSq_eq_norm_sq] at hsq
    have hsqrt : (Real.sqrt 2) ^ 2 = (2 : ℝ) := by
      norm_num
    have hsqrt_nonneg : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg _
    nlinarith [norm_nonneg (1 - Complex.I)]

theorem evenFamily_roots_have_equal_norm {m : ℕ} (hm : 0 < m)
    {z r : ℂ}
    (hz : z ∈ (evenFamilyPolynomial m).rootSet ℂ)
    (hr : r ∈ (evenFamilyPolynomial m).rootSet ℂ) :
    ‖z‖ = ‖r‖ := by
  have hzpow := evenFamily_root_norm_pow_eq_sqrt_two hm hz
  have hrpow := evenFamily_root_norm_pow_eq_sqrt_two hm hr
  have hnonz : 0 ≤ ‖z‖ := norm_nonneg _
  have hnonr : 0 ≤ ‖r‖ := norm_nonneg _
  have hpow : ‖z‖ ^ m = ‖r‖ ^ m := hzpow.trans hrpow.symm
  exact (pow_left_inj₀ hnonz hnonr (Nat.ne_of_gt hm)).mp hpow

/-! A principal logarithmic `m`-th root.  On the slit plane this is the
    canonical branch used to lift the two output components of the map
    `z ↦ (z^m - 1)^2 + 1`.  The power identity is global away from zero; later
    geometric lemmas only need to prove that their arguments stay in the slit
    plane (or, more concretely, in the open right half-plane). -/
def principalRoot (m : ℕ) (z : ℂ) : ℂ :=
  Complex.exp (Complex.log z / (m : ℂ))

theorem principalRoot_pow {m : ℕ} (hm : 0 < m) {z : ℂ} (hz : z ≠ 0) :
    (principalRoot m z) ^ m = z := by
  unfold principalRoot
  rw [← Complex.exp_nat_mul]
  have hm0 : (m : ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hm)
  field_simp [hm0]
  exact Complex.exp_log hz

theorem principalRoot_ne_zero (m : ℕ) (z : ℂ) :
    principalRoot m z ≠ 0 := by
  unfold principalRoot
  exact Complex.exp_ne_zero _

theorem principalRoot_re_pos_of_re_pos {m : ℕ} (hm : 0 < m) {z : ℂ}
    (hzre : 0 < z.re) :
    0 < (principalRoot m z).re := by
  have hz0 : z ≠ 0 := by
    intro hz
    rw [hz] at hzre
    norm_num at hzre
  have harg : |z.arg| < Real.pi / 2 :=
    (Complex.abs_arg_lt_pi_div_two_iff).2 (Or.inl hzre)
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have harglo : -(Real.pi / 2) < z.arg := (abs_lt.mp harg).1
  have harghi : z.arg < Real.pi / 2 := (abs_lt.mp harg).2
  have hlogim : (Complex.log z).im = z.arg := by
    exact Complex.log_im z
  have hrootim :
      -(Real.pi / 2) < (Complex.log z / (m : ℂ)).im ∧
        (Complex.log z / (m : ℂ)).im < Real.pi / 2 := by
    rw [Complex.div_im, hlogim]
    have hmRne : (m : ℝ) ≠ 0 := ne_of_gt hmR
    norm_num [Complex.normSq_apply]
    have hfrac : z.arg * (m : ℝ) / ((m : ℝ) * (m : ℝ)) = z.arg / (m : ℝ) := by
      field_simp [hmRne]
    rw [hfrac]
    have hmRone : (1 : ℝ) ≤ m := by
      exact_mod_cast (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hm))
    constructor
    · apply (lt_div_iff₀ hmR).2
      nlinarith [Real.pi_pos]
    · apply (div_lt_iff₀ hmR).2
      nlinarith [Real.pi_pos]
  unfold principalRoot
  rw [Complex.exp_re]
  have hcos : 0 < Real.cos (Complex.log z / (m : ℂ)).im :=
    Real.cos_pos_of_mem_Ioo hrootim
  exact mul_pos (Real.exp_pos _) hcos

theorem principalRoot_continuousOn_slitPlane {m : ℕ} (hm : 0 < m) :
    ContinuousOn (principalRoot m) Complex.slitPlane := by
  intro z hz
  have hlog : ContinuousAt Complex.log z := continuousAt_clog hz
  have hm0 : (m : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt hm)
  have hdiv : ContinuousAt (fun w : ℂ => Complex.log w / (m : ℂ)) z :=
    hlog.div continuousAt_const hm0
  exact (Complex.continuous_exp.continuousAt.comp hdiv).continuousWithinAt

theorem principalRoot_injOn_slitPlane {m : ℕ} (hm : 0 < m) :
    Set.InjOn (principalRoot m) Complex.slitPlane := by
  intro a ha b hb hab
  have hpa := principalRoot_pow hm (Complex.slitPlane_ne_zero ha)
  have hpb := principalRoot_pow hm (Complex.slitPlane_ne_zero hb)
  calc
    a = (principalRoot m a) ^ m := hpa.symm
    _ = (principalRoot m b) ^ m := by rw [hab]
    _ = b := hpb

theorem principalRoot_im_pos_of_im_pos {m : ℕ} (hm : 0 < m) {z : ℂ}
    (hz_im : 0 < z.im) :
    0 < (principalRoot m z).im := by
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hargpos : 0 < z.arg := by
    have hargnonneg : 0 ≤ z.arg := (Complex.arg_nonneg_iff).2 hz_im.le
    have hargne : z.arg ≠ 0 := by
      intro hzero
      have hzchar := (Complex.arg_eq_zero_iff).1 hzero
      linarith
    exact lt_of_le_of_ne hargnonneg (Ne.symm hargne)
  have hargltpi : z.arg < Real.pi :=
    (Complex.arg_lt_pi_iff).2 (Or.inr (ne_of_gt hz_im))
  have hrootim :
      0 < (Complex.log z / (m : ℂ)).im ∧
        (Complex.log z / (m : ℂ)).im < Real.pi := by
    rw [Complex.div_im, Complex.log_im]
    norm_num [Complex.normSq_apply]
    have hmRne : (m : ℝ) ≠ 0 := ne_of_gt hmR
    have hfrac : z.arg * (m : ℝ) / ((m : ℝ) * (m : ℝ)) = z.arg / (m : ℝ) := by
      field_simp [hmRne]
    rw [hfrac]
    have hmRone : (1 : ℝ) ≤ m := by
      exact_mod_cast (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hm))
    constructor
    · exact div_pos hargpos hmR
    · apply (div_lt_iff₀ hmR).2
      nlinarith
  unfold principalRoot
  rw [Complex.exp_im]
  exact mul_pos (Real.exp_pos _) (Real.sin_pos_of_pos_of_lt_pi hrootim.1 hrootim.2)

theorem principalRoot_re_pos_of_im_pos_of_two_le {m : ℕ} (hm : 2 ≤ m)
    {z : ℂ} (hz_im : 0 < z.im) :
    0 < (principalRoot m z).re := by
  have hmpos : (0 : ℝ) < m := by exact_mod_cast (show 0 < m by omega)
  have hmRtwo : (2 : ℝ) ≤ m := by exact_mod_cast hm
  have hargpos : 0 < z.arg := by
    have hargnonneg : 0 ≤ z.arg := (Complex.arg_nonneg_iff).2 hz_im.le
    have hargne : z.arg ≠ 0 := by
      intro hzero
      have hzchar := (Complex.arg_eq_zero_iff).1 hzero
      linarith
    exact lt_of_le_of_ne hargnonneg (Ne.symm hargne)
  have hargltpi : z.arg < Real.pi :=
    (Complex.arg_lt_pi_iff).2 (Or.inr (ne_of_gt hz_im))
  have hrootim :
      -(Real.pi / 2) < (Complex.log z / (m : ℂ)).im ∧
        (Complex.log z / (m : ℂ)).im < Real.pi / 2 := by
    rw [Complex.div_im, Complex.log_im]
    norm_num [Complex.normSq_apply]
    have hmRne : (m : ℝ) ≠ 0 := ne_of_gt hmpos
    have hfrac : z.arg * (m : ℝ) / ((m : ℝ) * (m : ℝ)) = z.arg / (m : ℝ) := by
      field_simp [hmRne]
    rw [hfrac]
    constructor
    · have hpos : 0 < z.arg / (m : ℝ) := div_pos hargpos hmpos
      nlinarith [Real.pi_pos]
    · apply (div_lt_iff₀ hmpos).2
      nlinarith
  unfold principalRoot
  rw [Complex.exp_re]
  exact mul_pos (Real.exp_pos _)
    (Real.cos_pos_of_mem_Ioo hrootim)

theorem principalRoot_re_pos_of_im_neg_of_two_le {m : ℕ} (hm : 2 ≤ m)
    {z : ℂ} (hz_im : z.im < 0) :
    0 < (principalRoot m z).re := by
  have hmpos : (0 : ℝ) < m := by exact_mod_cast (show 0 < m by omega)
  have hmRtwo : (2 : ℝ) ≤ m := by exact_mod_cast hm
  have hargneg : z.arg < 0 := (Complex.arg_neg_iff).2 hz_im
  have harggtnegpi : -(Real.pi) < z.arg := Complex.neg_pi_lt_arg z
  have hrootim :
      -(Real.pi / 2) < (Complex.log z / (m : ℂ)).im ∧
        (Complex.log z / (m : ℂ)).im < Real.pi / 2 := by
    rw [Complex.div_im, Complex.log_im]
    norm_num [Complex.normSq_apply]
    have hmRne : (m : ℝ) ≠ 0 := ne_of_gt hmpos
    have hfrac : z.arg * (m : ℝ) / ((m : ℝ) * (m : ℝ)) = z.arg / (m : ℝ) := by
      field_simp [hmRne]
    rw [hfrac]
    constructor
    · apply (lt_div_iff₀ hmpos).2
      nlinarith [Real.pi_pos]
    · have hneg : z.arg / (m : ℝ) < 0 := div_neg_of_neg_of_pos hargneg hmpos
      nlinarith [Real.pi_pos, hneg]
  unfold principalRoot
  rw [Complex.exp_re]
  exact mul_pos (Real.exp_pos _)
    (Real.cos_pos_of_mem_Ioo hrootim)

theorem principalRoot_im_neg_of_im_neg {m : ℕ} (hm : 0 < m) {z : ℂ}
    (hz_im : z.im < 0) :
    (principalRoot m z).im < 0 := by
  have hmpos : (0 : ℝ) < m := by exact_mod_cast hm
  have hargneg : z.arg < 0 := (Complex.arg_neg_iff).2 hz_im
  have harggtnegpi : -(Real.pi) < z.arg := Complex.neg_pi_lt_arg z
  have hrootim :
      -(Real.pi) < (Complex.log z / (m : ℂ)).im ∧
        (Complex.log z / (m : ℂ)).im < 0 := by
    rw [Complex.div_im, Complex.log_im]
    norm_num [Complex.normSq_apply]
    have hmRne : (m : ℝ) ≠ 0 := ne_of_gt hmpos
    have hfrac : z.arg * (m : ℝ) / ((m : ℝ) * (m : ℝ)) = z.arg / (m : ℝ) := by
      field_simp [hmRne]
    rw [hfrac]
    have hmRone : (1 : ℝ) ≤ m := by
      exact_mod_cast (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hm))
    constructor
    · apply (lt_div_iff₀ hmpos).2
      nlinarith [Real.pi_pos]
    · exact div_neg_of_neg_of_pos hargneg hmpos
  unfold principalRoot
  rw [Complex.exp_im]
  exact mul_neg_of_pos_of_neg (Real.exp_pos _)
    (Real.sin_neg_of_neg_of_neg_pi_lt hrootim.2 hrootim.1)

theorem evenFamily_eval_principalRoot_square {m : ℕ} (hm : 0 < m)
    {z : ℂ} (hz : z ≠ 0) :
    (evenFamilyPolynomial m).eval (principalRoot m (z ^ 2)) =
      (z ^ 2 - 1) ^ 2 + 1 := by
  rw [evenFamily_eval, principalRoot_pow hm (pow_ne_zero 2 hz)]

theorem evenFamily_root_ratio_pow_eq_one {m : ℕ} (hm : 0 < m)
    {z r : ℂ} (hz : z ∈ (evenFamilyPolynomial m).rootSet ℂ)
    (hr : r ∈ (evenFamilyPolynomial m).rootSet ℂ)
    (hpow : z ^ m = r ^ m) :
    (z / r) ^ m = 1 := by
  have hr0 : r ≠ 0 := evenFamily_root_ne_zero hm hr
  rw [div_pow, hpow]
  field_simp [hr0]

theorem evenFamily_root_eq_mul_root_unity {m : ℕ} (hm : 0 < m)
    {z r : ℂ} (hz : z ∈ (evenFamilyPolynomial m).rootSet ℂ)
    (hr : r ∈ (evenFamilyPolynomial m).rootSet ℂ)
    (hpow : z ^ m = r ^ m) :
    ∃ u : ℂ, u ^ m = 1 ∧ z = u * r := by
  have hr0 : r ≠ 0 := evenFamily_root_ne_zero hm hr
  refine ⟨z / r, evenFamily_root_ratio_pow_eq_one hm hz hr hpow, ?_⟩
  field_simp [hr0]

/-! A root of the even family belongs to one of the two rotational orbits of
    any fixed root on the `1+i` branch.  This is the finite-group reduction
    used to avoid duplicating non-convex certificates at all `2m` roots. -/
theorem evenFamily_root_orbit_representation {m : ℕ} (hm : 0 < m)
    {r z : ℂ} (hr : r ∈ (evenFamilyPolynomial m).rootSet ℂ)
    (hrplus : r ^ m = 1 + Complex.I)
    (hz : z ∈ (evenFamilyPolynomial m).rootSet ℂ) :
      (∃ u : ℂ, u ^ m = 1 ∧ z = u * r) ∨
      (∃ u : ℂ, u ^ m = 1 ∧ z = u * star r) := by
  have hzroot := hz
  rw [evenFamily_mem_rootSet_iff hm] at hz
  rcases hz with hzplus | hzminus
  · left
    exact evenFamily_root_eq_mul_root_unity hm hzroot hr (by rw [hzplus, hrplus])
  · right
    have hrstar : star r ∈ (evenFamilyPolynomial m).rootSet ℂ :=
      evenFamily_star_mem_rootSet hm hr
    have hrstarpow : (star r) ^ m = 1 - Complex.I := by
      have hstar := congrArg (starRingEnd ℂ) hrplus
      simpa [sub_eq_add_neg] using hstar
    exact evenFamily_root_eq_mul_root_unity hm hzroot hrstar
      (by rw [hzminus, hrstarpow])

theorem evenFamily_mul_root_of_unity_mem_rootSet
    {m : ℕ} (hm : 0 < m) {u z : ℂ}
    (hu : u ^ m = 1) (hz : z ∈ (evenFamilyPolynomial m).rootSet ℂ) :
    u * z ∈ (evenFamilyPolynomial m).rootSet ℂ := by
  apply (evenFamily_monic m hm).mem_rootSet.mpr
  have hval : (evenFamilyPolynomial m).eval (u * z) = 0 := by
    rw [evenFamily_eval_mul_root_of_unity hu]
    exact (evenFamily_monic m hm).mem_rootSet.mp hz
  simpa [aeval_def] using hval

theorem evenFamily_root_unity_ne_zero {m : ℕ} (hm : 0 < m) {u : ℂ}
    (hu : u ^ m = 1) : u ≠ 0 := by
  intro hzero
  subst u
  have hm0 : m ≠ 0 := Nat.ne_of_gt hm
  rw [zero_pow hm0] at hu
  norm_num at hu

/-! Multiplication by a root of unity transports connected components.  The
    statement is kept for an arbitrary set `S`; the polynomial-specific
    sublevel-set invariance is supplied separately below. -/
theorem mul_image_connectedComponentIn_eq {m : ℕ} {u : ℂ}
    (hm : 0 < m) (hu : u ^ m = 1) {S : Set ℂ} {x : ℂ} (hx : x ∈ S) :
    (fun z : ℂ => u * z) '' connectedComponentIn S x =
      connectedComponentIn ((fun z : ℂ => u * z) '' S) (u * x) := by
  let e : ℂ ≃ₜ ℂ := Homeomorph.mulLeft₀ u (evenFamily_root_unity_ne_zero hm hu)
  have he : (e : ℂ → ℂ) = (fun z : ℂ => u * z) := by
    funext z
    rfl
  simpa only [he] using (Homeomorph.image_connectedComponentIn e hx)

theorem evenFamily_image_sublevelSet_eq {m : ℕ} {u : ℂ}
    (hm : 0 < m) (hu : u ^ m = 1) {c : ℝ} :
    (fun z : ℂ => u * z) ''
        {z : ℂ | ‖(evenFamilyPolynomial m).eval z‖ ≤ c} =
      {z : ℂ | ‖(evenFamilyPolynomial m).eval z‖ ≤ c} := by
  ext w
  constructor
  · rintro ⟨z, hz, rfl⟩
    change ‖(evenFamilyPolynomial m).eval (u * z)‖ ≤ c
    rw [evenFamily_norm_eval_mul_root_of_unity hu]
    exact hz
  · intro hw
    have hu0 : u ≠ 0 := evenFamily_root_unity_ne_zero hm hu
    have huv : (u⁻¹) ^ m = 1 := by
      rw [inv_pow, hu, inv_one]
    refine ⟨u⁻¹ * w, ?_, ?_⟩
    · change ‖(evenFamilyPolynomial m).eval (u⁻¹ * w)‖ ≤ c
      rw [evenFamily_norm_eval_mul_root_of_unity huv]
      exact hw
    · field_simp [hu0]

theorem evenFamily_mul_root_unity_connectedComponentIn_eq
    {m : ℕ} (hm : 0 < m) {u : ℂ} (hu : u ^ m = 1)
    {c : ℝ} {x : ℂ}
    (hx : x ∈ {z : ℂ | ‖(evenFamilyPolynomial m).eval z‖ ≤ c}) :
    (fun z : ℂ => u * z) ''
        connectedComponentIn
          {z : ℂ | ‖(evenFamilyPolynomial m).eval z‖ ≤ c} x =
      connectedComponentIn
        {z : ℂ | ‖(evenFamilyPolynomial m).eval z‖ ≤ c} (u * x) := by
  rw [mul_image_connectedComponentIn_eq hm hu hx]
  rw [evenFamily_image_sublevelSet_eq hm hu]

theorem evenFamily_critical_eval {m : ℕ} {s : ℂ} (hs : s ^ m = 1) :
    (evenFamilyPolynomial m).eval s = 1 := by
  rw [evenFamily_eval, hs]
  norm_num

theorem evenFamily_critical_derivative_eval {m : ℕ} {s : ℂ} (hs : s ^ m = 1) :
    (evenFamilyPolynomial m).derivative.eval s = 0 := by
  rw [evenFamily_derivative]
  simp [hs]

/-! Every critical point of the even family has one of the two explicit
    critical values `1` and `2`.  The zero branch needs a separate check when
    `m = 1`; for `m ≥ 2`, the factor `z^(m-1)` vanishes only at `z = 0`. -/
theorem evenFamily_critical_eval_eq_one_or_two
    {m : ℕ} (hm : 0 < m) {z : ℂ}
    (hz : (evenFamilyPolynomial m).derivative.eval z = 0) :
    (evenFamilyPolynomial m).eval z = 1 ∨
      (evenFamilyPolynomial m).eval z = 2 := by
  rw [evenFamily_derivative] at hz
  simp only [eval_mul, eval_C, eval_X, eval_sub, eval_pow] at hz
  have hconst : (2 * (m : ℂ)) ≠ 0 := by
    exact_mod_cast (show 2 * m ≠ 0 by omega)
  rcases mul_eq_zero.mp hz with hleft | hfactor
  · rcases mul_eq_zero.mp hleft with hconst' | hpow
    · exact (hconst hconst').elim
    · by_cases hm1 : m = 1
      · subst m
        norm_num at hpow
      · have hm1pos : m - 1 ≠ 0 := by omega
        have hz0 : z = 0 := (pow_eq_zero_iff hm1pos).mp hpow
        right
        rw [hz0]
        rw [evenFamily_eval]
        have hm0 : m ≠ 0 := by omega
        simp [zero_pow hm0]
        norm_num

  · left
    have hzm : z ^ m = 1 := sub_eq_zero.mp hfactor
    rw [evenFamily_eval, hzm]
    norm_num

/-! Any origin line on which `z ^ m` is real is outside the sublevel set below
the critical level `1`.  This is the analytic barrier needed for the angular
sector decomposition of the even family; it is stated independently of any
choice of roots or coordinates. -/
theorem evenFamily_norm_ge_one_of_pow_im_zero
    {m : ℕ} {z : ℂ} (hz : (z ^ m).im = 0) :
    1 ≤ ‖(evenFamilyPolynomial m).eval z‖ := by
  rw [evenFamily_eval]
  have hreal : z ^ m = ((z ^ m).re : ℂ) := by
    apply Complex.ext
    · simp
    · simpa [hz]
  rw [hreal]
  let x : ℝ := (z ^ m).re - 1
  have hx : 0 ≤ x ^ 2 + 1 := by
    nlinarith [sq_nonneg x]
  have hrewrite : ((((z ^ m).re : ℂ) - 1) ^ 2 + 1 : ℂ) =
      ((x ^ 2 + 1 : ℝ) : ℂ) := by
    dsimp [x]
    norm_num
  rw [hrewrite, Complex.norm_real, Real.norm_of_nonneg hx]
  nlinarith

theorem evenFamily_norm_ge_two_of_pow_re_zero
    {m : ℕ} {z : ℂ} (hz : (z ^ m).re = 0) :
    2 ≤ ‖(evenFamilyPolynomial m).eval z‖ := by
  rw [evenFamily_eval]
  have hpow : z ^ m = ((z ^ m).im : ℂ) * Complex.I := by
    apply Complex.ext
    · simp [hz]
    · simp
  rw [hpow]
  have hnormsq :
      Complex.normSq ((((z ^ m).im : ℂ) * Complex.I - 1) ^ 2 + 1) =
        (z ^ m).im ^ 4 + 4 := by
    norm_num [Complex.normSq_apply, Complex.mul_re, Complex.mul_im,
      Complex.I_sq, Complex.I_re, Complex.I_im, pow_two]
    ring_nf
  have hsq :
      (4 : ℝ) ≤ ‖((((z ^ m).im : ℂ) * Complex.I - 1) ^ 2 + 1)‖ ^ 2 := by
    rw [← Complex.normSq_eq_norm_sq]
    rw [hnormsq]
    nlinarith [sq_nonneg ((z ^ m).im ^ 2)]
  nlinarith [norm_nonneg ((((z ^ m).im : ℂ) * Complex.I - 1) ^ 2 + 1)]

/-! The preceding pointwise barrier is stable along every real line through the
origin whose direction has real `m`-th power. -/
theorem evenFamily_norm_ge_one_of_real_line_direction
    {m : ℕ} {u : ℂ} (hu : (u ^ m).im = 0) (t : ℝ) :
    1 ≤ ‖(evenFamilyPolynomial m).eval ((t : ℂ) * u)‖ := by
  apply evenFamily_norm_ge_one_of_pow_im_zero
  rw [mul_pow]
  have ht : (((t : ℂ) ^ m).im = 0) := by
    clear hu
    induction m with
    | zero => simp
    | succ m ih =>
        rw [pow_succ]
        simp [Complex.mul_im, ih]
  simp [Complex.mul_im, hu, ht]

theorem evenFamily_second_derivative_eval {m : ℕ} {s : ℂ}
    (hm : 2 ≤ m) (hs : s ^ m = 1) :
    (evenFamilyPolynomial m).derivative.derivative.eval s =
      (2 * m : ℂ) * m * s ^ (2 * m - 2) := by
  rw [evenFamily_derivative, derivative_mul, derivative_mul, derivative_C,
    derivative_pow, derivative_sub, derivative_pow, derivative_C]
  simp only [eval_add, eval_mul, eval_C, eval_X, eval_sub, eval_pow]
  rw [hs]
  simp only [sub_self, mul_zero]
  norm_num
  have hpow : s ^ (m - 1) * s ^ (m - 1) = s ^ (2 * m - 2) := by
    rw [← pow_add]
    congr 1
    omega
  calc
    2 * (m : ℂ) * s ^ (m - 1) * ((m : ℂ) * s ^ (m - 1)) =
        2 * (m : ℂ) * (m : ℂ) * (s ^ (m - 1) * s ^ (m - 1)) := by ring
    _ = 2 * (m : ℂ) * (m : ℂ) * s ^ (2 * m - 2) := by rw [hpow]

theorem evenFamily_separable (m : ℕ) (hm : 0 < m) :
    (evenFamilyPolynomial m).Separable := by
  rw [evenFamily_factorization]
  have hsep_plus : (X ^ m - C (1 + Complex.I : ℂ)).Separable :=
    Polynomial.separable_X_pow_sub_C (F := ℂ) (n := m) (1 + Complex.I)
      (by
        have hm0 : (m : ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hm)
        exact hm0) (by
        intro h
        have hr := congrArg Complex.re h
        norm_num at hr)
  have hsep_minus : (X ^ m - C (1 - Complex.I : ℂ)).Separable :=
    Polynomial.separable_X_pow_sub_C (F := ℂ) (n := m) (1 - Complex.I)
      (by
        have hm0 : (m : ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hm)
        exact hm0) (by
        intro h
        have hr := congrArg Complex.re h
        norm_num at hr)
  apply hsep_plus.mul hsep_minus
  rw [Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed (k := ℂ)
    ℂ (X ^ m - C (1 + Complex.I)) (X ^ m - C (1 - Complex.I))]
  intro z
  by_cases h : (X ^ m - C (1 + Complex.I : ℂ)).eval z = 0
  · right
    intro h'
    have h1raw : z ^ m - (1 + Complex.I) = 0 := by simpa using h
    have h1 : z ^ m = 1 + Complex.I := sub_eq_zero.mp h1raw
    have h'poly : (X ^ m - C (1 - Complex.I : ℂ)).eval z = 0 := by
      simpa [aeval_def] using h'
    have h2raw : z ^ m - (1 - Complex.I) = 0 := by simpa using h'poly
    have h2 : z ^ m = 1 - Complex.I := sub_eq_zero.mp h2raw
    have hc : (1 + Complex.I : ℂ) = 1 - Complex.I := h1.symm.trans h2
    have hi := congrArg Complex.im hc
    norm_num at hi
  · left
    simpa [aeval_def] using h

theorem evenFamily_third_derivative_eval {m : ℕ} {s : ℂ}
    (hm : 2 ≤ m) (hs : s ^ m = 1) :
    (evenFamilyPolynomial m).derivative.derivative.derivative.eval s =
      (6 * (m : ℂ) ^ 2 * (m - 1 : ℂ)) * s ^ (2 * m - 3) := by
  rw [evenFamily_derivative]
  simp only [derivative_mul, derivative_add, derivative_sub, derivative_pow,
    derivative_C, eval_add, eval_mul, eval_C, eval_X, eval_sub, eval_pow]
  rw [hs]
  simp only [sub_self, mul_zero]
  norm_num
  ring_nf
  have hpow : s ^ (m - 1 - 1) * s ^ (m - 1) = s ^ (2 * m - 3) := by
    rw [← pow_add]
    congr 1
    omega
  calc
    ↑m ^ 2 * ↑(m - 1) * s ^ (m - 1 - 1) * s ^ (m - 1) * 6 =
        6 * ↑m ^ 2 * ↑(m - 1) *
          (s ^ (m - 1 - 1) * s ^ (m - 1)) := by ring
    _ = 6 * ↑m ^ 2 * ↑(m - 1) * s ^ (2 * m - 3) := by rw [hpow]
    _ = -(↑m ^ 2 * s ^ (m * 2 - 3) * 6) +
