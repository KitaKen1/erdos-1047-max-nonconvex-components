section


/-!
# Finite old-witness preservation for general balanced raising

The finite real-polynomial witness package is an invariant for the proposed
`n → n+2` construction.  It already implies the original closed-level target.
Uniform approximation preserves all its certificates at once, even when the
normalized target level varies and converges to the old level.

This file does not assert that old components remain separated after raising,
or that two new nonconvex components have been constructed.
-/

open Polynomial Set Filter Erdos1047 Erdos1047Proof
open Erdos1047BalancedRaise Erdos1047ClosedLevelBridge
open scoped Topology

namespace Erdos1047BalancedCertificates

noncomputable section

structure RealWitnessFamily (n : ℕ) where
  polynomial : ℝ[X]
  monic : polynomial.Monic
  degree : polynomial.natDegree = n
  level : ℝ
  level_pos : 0 < level
  anchor : Fin n → ℂ
  pointA : Fin n → ℂ
  pointB : Fin n → ℂ
  anchor_injective : Function.Injective anchor
  certificate : ∀ i, RobustNonconvexCertificate
    (fun z => (complexify polynomial).eval z) level (anchor i) (pointA i) (pointB i)
  component_injective : Set.InjOn
    (fun z => connectedComponentIn (strictSublevelSet (complexify polynomial) level) z)
    (Set.range anchor)

theorem RealWitnessFamily.closed_attainable {n : ℕ}
    (w : RealWitnessFamily n) (hn : 0 < n) : n ∈ attainableNonConvexCounts n := by
  apply closed_attainable_of_strict_certificate_family
    (show (complexify w.polynomial).Monic from w.monic.map _) _ hn w.level_pos
    w.anchor_injective (fun i => ⟨w.certificate i⟩) w.component_injective
  rw [complexify, natDegree_map_eq_of_injective (algebraMap ℝ ℂ).injective]
  exact w.degree

theorem RealWitnessFamily.exists_lower_level {n : ℕ}
    (w : RealWitnessFamily n) (hn : 0 < n) :
    ∃ v : RealWitnessFamily n, v.polynomial = w.polynomial ∧
      v.anchor = w.anchor ∧ v.level < w.level := by
  obtain ⟨d, hd, hdc, hcert⟩ := exists_lower_level_certificate_family hn w.level_pos
    (fun i => (show Nonempty (RobustNonconvexCertificate
      (fun z => (complexify w.polynomial).eval z) w.level
      (w.anchor i) (w.pointA i) (w.pointB i)) from ⟨w.certificate i⟩))
  let cert := fun i => Classical.choice (hcert i)
  have hmem : ∀ z ∈ Set.range w.anchor,
      z ∈ strictSublevelSet (complexify w.polynomial) d := by
    rintro _ ⟨i, rfl⟩
    have hm := (cert i).lineA_margin (w.anchor i)
      (left_mem_segment ℝ (w.anchor i) (w.pointA i))
    change ‖(complexify w.polynomial).eval (w.anchor i)‖ < d
    linarith [(cert i).eps_pos]
  have hsub : strictSublevelSet (complexify w.polynomial) d ⊆
      strictSublevelSet (complexify w.polynomial) w.level := by
    intro z hz
    exact lt_trans hz hdc
  exact ⟨{
    polynomial := w.polynomial
    monic := w.monic
    degree := w.degree
    level := d
    level_pos := hd
    anchor := w.anchor
    pointA := w.pointA
    pointB := w.pointB
    anchor_injective := w.anchor_injective
    certificate := cert
    component_injective := component_map_injOn_of_subset hsub hmem w.component_injective
  }, rfl, rfl, hdc⟩

theorem certificate_of_small_function_and_level_error
    {F G : ℂ → ℂ} {c d : ℝ} {r a b : ℂ}
    (hcert : RobustNonconvexCertificate F c r a b)
    (hlevel : |d - c| ≤ hcert.eps / 4)
    (hA : ∀ z ∈ segment ℝ r a, ‖G z - F z‖ ≤ hcert.eps / 4)
    (hB : ∀ z ∈ segment ℝ r b, ‖G z - F z‖ ≤ hcert.eps / 4)
    (hM : ‖G (midpoint ℝ a b) - F (midpoint ℝ a b)‖ ≤ hcert.eps / 4) :
    Nonempty (RobustNonconvexCertificate G d r a b) := by
  have hlevels := abs_le.mp hlevel
  have hupper (z : ℂ) : ‖G z‖ ≤ ‖F z‖ + ‖G z - F z‖ := by
    calc
      ‖G z‖ = ‖F z + (G z - F z)‖ := by congr 1; ring
      _ ≤ _ := norm_add_le _ _
  refine ⟨{
    eps := hcert.eps / 2
    eps_pos := half_pos hcert.eps_pos
    lineA_margin := ?_
    lineB_margin := ?_
    midpoint_margin := ?_
  }⟩
  · intro z hz
    linarith [hupper z, hA z hz, hcert.lineA_margin z hz]
  · intro z hz
    linarith [hupper z, hB z hz, hcert.lineB_margin z hz]
  · have hlower : ‖F (midpoint ℝ a b)‖ ≤ ‖G (midpoint ℝ a b)‖ +
        ‖G (midpoint ℝ a b) - F (midpoint ℝ a b)‖ := by
      calc
        _ = ‖G (midpoint ℝ a b) +
            (F (midpoint ℝ a b) - G (midpoint ℝ a b))‖ := by congr 1; ring
        _ ≤ ‖G (midpoint ℝ a b)‖ +
            ‖F (midpoint ℝ a b) - G (midpoint ℝ a b)‖ := norm_add_le _ _
        _ = _ := by rw [norm_sub_rev]
    linarith [hcert.midpoint_margin]

theorem eventually_preserves_certificate
    {p : ℝ[X]} (hp : p.Monic) (hdeg : 2 < p.natDegree)
    (b : ℝ) {c : ℝ} {r a d : ℂ}
    (hcert : RobustNonconvexCertificate (fun z => (complexify p).eval z) c r a d)
    {level : ℝ → ℝ} (hlevel : Tendsto level atTop (𝓝 c)) :
    ∀ᶠ L : ℝ in atTop, Nonempty (RobustNonconvexCertificate
      (fun z => (raised p b L).eval z) (L ^ 2 * level L) r a d) := by
  have hseg (x y : ℂ) : IsCompact (segment ℝ x y) := by
    rw [segment_eq_image_lineMap]
    exact isCompact_Icc.image (by fun_prop)
  let K : Set ℂ := (segment ℝ r a ∪ segment ℝ r d) ∪ {midpoint ℝ a d}
  have hK : IsCompact K := ((hseg r a).union (hseg r d)).union isCompact_singleton
  have hclose := eventually_uniform_scaled_close_on_compact hp hdeg b hK
    (show 0 < hcert.eps / 4 by linarith [hcert.eps_pos])
  have hlevelclose : ∀ᶠ L : ℝ in atTop, |level L - c| < hcert.eps / 4 := by
    have hlim : Tendsto (fun L => |level L - c|) atTop (𝓝 0) := by
      simpa using (hlevel.sub_const c).abs
    exact hlim.eventually_lt_const (by linarith [hcert.eps_pos])
  filter_upwards [eventually_gt_atTop (0 : ℝ), hclose, hlevelclose] with L hL hfun hlev
  obtain ⟨hsmall⟩ := certificate_of_small_function_and_level_error
    (G := fun z => (raised p b L).eval z / (L : ℂ) ^ 2) hcert hlev.le
    (fun z hz => (hfun z (Or.inl (Or.inl hz))).le)
    (fun z hz => (hfun z (Or.inl (Or.inr hz))).le)
    (hfun _ (Or.inr (Set.mem_singleton _))).le
  have hLsq : 0 < L ^ 2 := sq_pos_of_pos hL
  obtain ⟨hscaled⟩ := hsmall.of_pos_real_scalar hLsq
  refine ⟨?_⟩
  convert hscaled using 1
  funext z
  have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hL)
  push_cast
  field_simp

theorem eventually_preserves_finite_certificate_family
    {ι : Type*} [Finite ι] {p : ℝ[X]} (hp : p.Monic) (hdeg : 2 < p.natDegree)
    (b : ℝ) {c : ℝ} {r a d : ι → ℂ}
    (hcert : ∀ i, Nonempty (RobustNonconvexCertificate
      (fun z => (complexify p).eval z) c (r i) (a i) (d i)))
    {level : ℝ → ℝ} (hlevel : Tendsto level atTop (𝓝 c)) :
    ∀ᶠ L : ℝ in atTop, ∀ i, Nonempty (RobustNonconvexCertificate
      (fun z => (raised p b L).eval z) (L ^ 2 * level L) (r i) (a i) (d i)) := by
  apply Filter.eventually_all.mpr
  intro i
  exact eventually_preserves_certificate hp hdeg b (Classical.choice (hcert i)) hlevel

theorem RealWitnessFamily.eventually_preserves_old_certificates
    {n : ℕ} (w : RealWitnessFamily n) (hn : 2 < n)
    {level : ℝ → ℝ} (hlevel : Tendsto level atTop (𝓝 w.level)) :
    ∀ᶠ L : ℝ in atTop, ∀ i, Nonempty (RobustNonconvexCertificate
      (fun z => (raised w.polynomial w.level L).eval z)
      (L ^ 2 * level L) (w.anchor i) (w.pointA i) (w.pointB i)) := by
  apply eventually_preserves_finite_certificate_family w.monic
    (by simpa only [w.degree] using hn) w.level (fun i => ⟨w.certificate i⟩) hlevel

#print axioms RealWitnessFamily.closed_attainable
#print axioms RealWitnessFamily.exists_lower_level
#print axioms eventually_preserves_finite_certificate_family
/-- info: 'Erdos1047BalancedCertificates.RealWitnessFamily.eventually_preserves_old_certificates' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms RealWitnessFamily.eventually_preserves_old_certificates

end
end Erdos1047BalancedCertificates

end

