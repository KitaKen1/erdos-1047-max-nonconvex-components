the sum of the two roots has real part below `-2`, while the root equation
forces `Re B < 0`. -/
theorem not_two_roots_re_lt_neg_one
    {B r s : ℂ}
    (hB : 0 ≤ B.re)
    (hr : r ^ 3 - 3 * r + B = 0)
    (hs : s ^ 3 - 3 * s + B = 0)
    (hrs : r ≠ s)
    (hrleft : r.re < -1) (hsleft : s.re < -1) : False := by
  have hpair : r ^ 2 + r * s + s ^ 2 - 3 = 0 := by
    have hdiff : (r - s) * (r ^ 2 + r * s + s ^ 2 - 3) = 0 := by
      calc
        (r - s) * (r ^ 2 + r * s + s ^ 2 - 3) =
            (r ^ 3 - 3 * r + B) - (s ^ 3 - 3 * s + B) := by ring
        _ = 0 := by rw [hr, hs]; ring
    exact (mul_eq_zero.mp hdiff).resolve_left (sub_ne_zero.mpr hrs)
  have hBprod : B = r * s * (r + s) := by
    linear_combination hr - r * hpair
  have hBsum : B = (r + s) ^ 3 - 3 * (r + s) := by
    calc
      B = r * s * (r + s) := hBprod
      _ = (r + s) ^ 3 - 3 * (r + s) := by
        linear_combination -(r + s) * hpair
  let a : ℝ := (r + s).re
  let b : ℝ := (r + s).im
  let p : ℝ := (r - s).re
  let q : ℝ := (r - s).im
  have ha : a < -2 := by
    dsimp [a]
    norm_num [Complex.add_re]
    linarith
  have hpbound : p ^ 2 < (a + 2) ^ 2 := by
    have hp1 : p < -a - 2 := by
      dsimp [p, a]
      norm_num [Complex.sub_re, Complex.add_re]
      linarith
    have hp2 : -p < -a - 2 := by
      dsimp [p, a]
      norm_num [Complex.sub_re, Complex.add_re]
      linarith
    have hpos1 : 0 < -a - 2 - p := by linarith
    have hpos2 : 0 < -a - 2 + p := by linarith
    have hprod : 0 < (-a - 2 - p) * (-a - 2 + p) := mul_pos hpos1 hpos2
    nlinarith
  have hD : 0 < a ^ 2 - 3 * b ^ 2 - 3 := by
    have hDsq : (p ^ 2 + 3 * a ^ 2) * (a ^ 2 - 3 * b ^ 2 - 3) =
        (a ^ 2 - p ^ 2) * (p ^ 2 + 3 * a ^ 2 - 9) := by
      have hDrel : (r - s) ^ 2 = 3 * (4 - (r + s) ^ 2) := by
        linear_combination 4 * hpair
      have hreal : p ^ 2 - q ^ 2 = 12 - 3 * a ^ 2 + 3 * b ^ 2 := by
        have := congrArg Complex.re hDrel
        calc
          p ^ 2 - q ^ 2 = ((r - s) ^ 2).re := by
            dsimp [p, q]
            norm_num [pow_two, Complex.mul_re, Complex.mul_im, Complex.sub_re,
              Complex.sub_im]
          _ = (3 * (4 - (r + s) ^ 2)).re := this
          _ = 12 - 3 * a ^ 2 + 3 * b ^ 2 := by
            dsimp [a, b]
            norm_num [pow_two, Complex.mul_re, Complex.mul_im, Complex.sub_re,
              Complex.sub_im, Complex.add_re, Complex.add_im]
            ring
      have himag : p * q = -3 * a * b := by
        have := congrArg Complex.im hDrel
        have htwice : 2 * (p * q) = ((r - s) ^ 2).im := by
          dsimp [p, q]
          norm_num [pow_two, Complex.mul_re, Complex.mul_im, Complex.sub_re,
            Complex.sub_im]
          ring
        have hright : (3 * (4 - (r + s) ^ 2)).im = 2 * (-3 * a * b) := by
          dsimp [a, b]
          norm_num [pow_two, Complex.mul_re, Complex.mul_im, Complex.sub_re,
            Complex.sub_im, Complex.add_re, Complex.add_im]
          ring
        have hEq : 2 * (p * q) = 2 * (-3 * a * b) :=
          htwice.trans (this.trans hright)
        linarith
      have hpq : p ^ 2 * q ^ 2 = 9 * a ^ 2 * b ^ 2 := by
        have hsq := congrArg (fun x : ℝ => x ^ 2) himag
        calc
          p ^ 2 * q ^ 2 = (p * q) ^ 2 := by ring
          _ = (-3 * a * b) ^ 2 := hsq
          _ = 9 * a ^ 2 * b ^ 2 := by ring
      linear_combination p ^ 2 * hreal + hpq
    have ha2 : 4 < a ^ 2 := by nlinarith [ha]
    have hleft : 0 < a ^ 2 - p ^ 2 := by
      nlinarith [hpbound, ha]
    have hright : 0 < p ^ 2 + 3 * a ^ 2 - 9 := by
      nlinarith [ha2, sq_nonneg p]
    have hprod : 0 < (a ^ 2 - p ^ 2) * (p ^ 2 + 3 * a ^ 2 - 9) :=
      mul_pos hleft hright
    have hden : 0 < p ^ 2 + 3 * a ^ 2 := by
      nlinarith [ha2, sq_nonneg p]
    have hprod' : 0 < (p ^ 2 + 3 * a ^ 2) * (a ^ 2 - 3 * b ^ 2 - 3) := by
      rw [hDsq]
      exact hprod
    nlinarith
  have hBreal : B.re = a * (a ^ 2 - 3 * b ^ 2 - 3) := by
    have := congrArg Complex.re hBsum
    calc
      B.re = ((r + s) ^ 3 - 3 * (r + s)).re := this
      _ = a * (a ^ 2 - 3 * b ^ 2 - 3) := by
        dsimp [a, b]
        norm_num [pow_succ, Complex.mul_re, Complex.mul_im, Complex.add_re,
          Complex.add_im]
        ring_nf
  have hBneg : B.re < 0 := by
    rw [hBreal]
    exact mul_neg_of_neg_of_pos (by linarith [ha]) hD
  linarith

end
end Erdos1047CubicRootChord

end

/- Source: Erdos1047DegreeRaiseCore.lean; SHA256: ade4e4c3878b55dc009ddb0b5a0a3deb5189245352770cf2e4130321975c71ba -/
section


/-! Algebraic interface for the degree-raising perturbation used in the
    `n → n + 2` construction.  The analytic estimates and component preservation
    are deliberately not hidden behind this file. -/

open Polynomial
open Filter Topology
open scoped BigOperators

namespace Erdos1047DegreeRaise

noncomputable section

def raiseFactor (L d : ℂ) : ℂ[X] := (X - C L) ^ 2 + C d

def raisePolynomial (p : ℂ[X]) (L d : ℂ) : ℂ[X] := p * raiseFactor L d

/- The perturbation parameter used in the paper-level `n → n+2` step.  It is
   written with a nonnegative natural exponent so that its Lean meaning is
   unambiguous; for `n ≥ 2` this is exactly `c L^(2-n)`. -/
def raiseParameter (n : ℕ) (c L : ℂ) : ℂ := c / L ^ (n - 2)

theorem raiseFactor_monic (L d : ℂ) : (raiseFactor L d).Monic := by
  unfold raiseFactor
  monicity!

theorem raiseFactor_natDegree (L d : ℂ) : (raiseFactor L d).natDegree = 2 := by
  unfold raiseFactor
  compute_degree!

theorem raisePolynomial_monic (p : ℂ[X]) (L d : ℂ) (hp : p.Monic) :
    (raisePolynomial p L d).Monic := by
  unfold raisePolynomial
  exact hp.mul (raiseFactor_monic L d)

theorem raisePolynomial_natDegree (p : ℂ[X]) (L d : ℂ)
    (hp : p.Monic) :
    (raisePolynomial p L d).natDegree = p.natDegree + 2 := by
  unfold raisePolynomial
  rw [natDegree_mul hp.ne_zero (raiseFactor_monic L d).ne_zero,
    raiseFactor_natDegree]

theorem raiseFactor_eval (L d z : ℂ) :
    (raiseFactor L d).eval z = (z - L) ^ 2 + d := by
  norm_num [raiseFactor]

/-! Elementary barrier estimates for a quadratic factor with real center and
    real height.  On the vertical line through `L/2`, the factor has squared
    norm at least `(L*E)^2`; on a horizontal line of height `a`, it has squared
    norm at least `(E^2-a^2)^2`.  These estimates are the algebraic part of
    the old/new component separation argument. -/
theorem raiseFactor_normSq_on_vertical (L E y : ℝ) :
    (L * E) ^ 2 ≤ Complex.normSq
      (((L / 2 : ℂ) + (y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
  norm_num [Complex.normSq_apply, Complex.mul_re, Complex.mul_im, pow_succ]
  nlinarith [sq_nonneg (y ^ 2 - E ^ 2 + L ^ 2 / 4)]

/-! A fixed vertical-line variant used when an old component separator is not
the new center line.  If the height satisfies `E² ≤ (L-a)²`, the quadratic
factor has squared norm at least `(L-a)^4` on `Re z = a`, uniformly in `Im z`.
This is the elementary estimate behind persistence of old coordinate barriers
under a sufficiently distant degree raise. -/
theorem raiseFactor_normSq_on_vertical_fixed_line
    (L E a y : ℝ) (hE : E ^ 2 ≤ (L - a) ^ 2) :
    (L - a) ^ 4 ≤ Complex.normSq
      (((a : ℂ) + (y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
  norm_num [Complex.normSq_apply, Complex.mul_re, Complex.mul_im, pow_succ]
  nlinarith [sq_nonneg (y ^ 2), mul_nonneg (sub_nonneg.mpr hE) (sq_nonneg y)]

theorem raiseFactor_normSq_on_horizontal (L E a x : ℝ) :
    (E ^ 2 - a ^ 2) ^ 2 ≤ Complex.normSq
      (((x : ℂ) + (a : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
  norm_num [Complex.normSq_apply, Complex.mul_re, Complex.mul_im, pow_succ]
  nlinarith [sq_nonneg ((x - L) ^ 2),
    sq_nonneg ((x - L) ^ 2 + E ^ 2 - a ^ 2)]

/-!
The following norm-form corollaries are convenient at the geometric boundary.
They turn the norm-square estimates above into the exact inequalities consumed
by the component-separator API, while keeping the real-square hypothesis
explicit.  No analytic minimum-modulus argument is involved.
-/

theorem real_square_factor_norm_ge_on_imaginary_axis
    {L E : ℝ} (hE : E ^ 2 ≤ L ^ 2) :
    ∀ y : ℝ, L ^ 2 ≤
      ‖(((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2)‖ := by
  intro y
  have hsq : L ^ 4 ≤ Complex.normSq
      (((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
    simpa using raiseFactor_normSq_on_vertical_fixed_line L E 0 y (by
      simpa using hE)
  have hsq' : L ^ 4 ≤
      ‖(((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2)‖ ^ 2 := by
    simpa [Complex.normSq_eq_norm_sq] using hsq
  have hnon : 0 ≤
      ‖(((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2)‖ := norm_nonneg _
  nlinarith [sq_nonneg L]

theorem real_square_factor_norm_ge_on_horizontal
    {L E a : ℝ} (hEa : 0 ≤ E ^ 2 - a ^ 2) :
    ∀ x : ℝ, E ^ 2 - a ^ 2 ≤
      ‖(((x : ℂ) + (a : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2)‖ := by
  intro x
  have hsq : (E ^ 2 - a ^ 2) ^ 2 ≤ Complex.normSq
      (((x : ℂ) + (a : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2) := by
    simpa using raiseFactor_normSq_on_horizontal L E a x
  have hsq' : (E ^ 2 - a ^ 2) ^ 2 ≤
      ‖(((x : ℂ) + (a : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2)‖ ^ 2 := by
    simpa [Complex.normSq_eq_norm_sq] using hsq
  have hnon : 0 ≤
      ‖(((x : ℂ) + (a : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2)‖ := norm_nonneg _
  nlinarith

theorem real_square_factor_norm_ge_on_left_halfline
    {L E a : ℝ} (hL : 0 ≤ L) (hLa : a ^ 2 ≤ L ^ 2) :
    ∀ x : ℝ, x ≤ 0 → L ^ 2 - a ^ 2 ≤
      ‖(((x : ℂ) + (a : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2)‖ := by
  intro x hx
  have hsqx : 0 ≤ x ^ 2 := sq_nonneg x
  have hprod : x * L ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hx hL
  have hsq : L ^ 2 ≤ (x - L) ^ 2 := by
    nlinarith
  have hreal : L ^ 2 - a ^ 2 ≤
      ((((x : ℂ) + (a : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (E : ℂ) ^ 2).re) := by
    norm_num [Complex.sub_re, Complex.sub_im, Complex.mul_re,
      Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im, pow_two]
    nlinarith [sq_nonneg E]
  exact le_trans hreal (Complex.re_le_norm _)

/-! The preceding barrier estimates are often used with a genuinely smaller
    real quadratic constant than `L²`.  The following two variants expose the
    exact hypotheses needed in that situation, instead of pretending that the
    constant is a square of the center scale. -/
theorem real_factor_norm_ge_on_imaginary_axis_of_nonneg_le
    {L d : ℝ} (hd : 0 ≤ d) (hdL : d ≤ L ^ 2) :
    ∀ y : ℝ, L ^ 2 ≤
      ‖(((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (d : ℂ))‖ := by
  intro y
  have hsq : L ^ 4 ≤ Complex.normSq
      (((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (d : ℂ)) := by
    norm_num [Complex.normSq_apply, Complex.mul_re, Complex.mul_im,
      Complex.sub_re, Complex.sub_im, Complex.add_re, Complex.add_im,
      Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im,
      pow_two]
    nlinarith [sq_nonneg (y ^ 2), mul_nonneg (sub_nonneg.mpr hdL) (sq_nonneg y)]
  have hsq' : L ^ 4 ≤
      ‖(((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (d : ℂ))‖ ^ 2 := by
    simpa [Complex.normSq_eq_norm_sq] using hsq
  have hnon : 0 ≤
      ‖(((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (d : ℂ))‖ := norm_nonneg _
  nlinarith [sq_nonneg L]

theorem real_factor_norm_ge_on_left_halfline_of_nonneg
    {L d a : ℝ} (hL : 0 ≤ L) (hLa : a ^ 2 ≤ L ^ 2) (hd : 0 ≤ d) :
    ∀ x : ℝ, x ≤ 0 → L ^ 2 - a ^ 2 ≤
      ‖(((x : ℂ) + (a : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (d : ℂ))‖ := by
  intro x hx
  have hsqx : 0 ≤ x ^ 2 := sq_nonneg x
  have hprod : x * L ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hx hL
  have hsq : L ^ 2 ≤ (x - L) ^ 2 := by
    nlinarith
  have hreal : L ^ 2 - a ^ 2 ≤
      ((((x : ℂ) + (a : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (d : ℂ)).re) := by
    norm_num [Complex.sub_re, Complex.sub_im, Complex.mul_re,
      Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im, Complex.add_re, Complex.add_im, pow_two]
    nlinarith [hd]
  exact le_trans hreal (Complex.re_le_norm _)

theorem raiseFactor_separable_of_ne_zero {L d : ℂ} (hd : d ≠ 0) :
    (raiseFactor L d).Separable := by
  rw [Polynomial.separable_def']
  refine ⟨C d⁻¹, -C ((2 * d)⁻¹) * (X - C L), ?_⟩
  apply Polynomial.funext
  intro z
  simp [raiseFactor, derivative_add, derivative_X_sub_C_sq, derivative_C]
  field_simp [hd]
  ring

theorem raiseFactor_rootSet_ncard_of_ne_zero {L d : ℂ} (hd : d ≠ 0) :
    ((raiseFactor L d).rootSet ℂ).ncard = 2 := by
  have hcard : Fintype.card ((raiseFactor L d).rootSet ℂ) =
      (raiseFactor L d).natDegree :=
    Polynomial.card_rootSet_eq_natDegree (raiseFactor_separable_of_ne_zero hd)
      (IsAlgClosed.splits _)
  simpa [raiseFactor_natDegree] using hcard

theorem raiseFactor_coprime_of_no_common_root
    (p : ℂ[X]) (L d : ℂ)
    (hno : ∀ z : ℂ, p.eval z = 0 → (z - L) ^ 2 + d ≠ 0) :
    IsCoprime p (raiseFactor L d) := by
  rw [Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed (k := ℂ)
    ℂ p (raiseFactor L d)]
  change ∀ z : ℂ, p.eval z ≠ 0 ∨ (raiseFactor L d).eval z ≠ 0
  intro z
  by_cases hpz : p.eval z = 0
  · right
    intro hq
    exact hno z hpz (by simpa [raiseFactor_eval] using hq)
  · exact Or.inl hpz

theorem raisePolynomial_separable
    (p : ℂ[X]) (L d : ℂ) (hp : p.Separable) (hd : d ≠ 0)
    (hcop : IsCoprime p (raiseFactor L d)) :
    (raisePolynomial p L d).Separable := by
  unfold raisePolynomial
  exact hp.mul (raiseFactor_separable_of_ne_zero hd) hcop

theorem raisePolynomial_rootSet_ncard
    (p : ℂ[X]) (L d : ℂ) (hp : p.Monic) (hpsep : p.Separable)
    (hd : d ≠ 0) (hcop : IsCoprime p (raiseFactor L d)) :
    ((raisePolynomial p L d).rootSet ℂ).ncard = p.natDegree + 2 := by
  have hsep : (raisePolynomial p L d).Separable :=
    raisePolynomial_separable p L d hpsep hd hcop
  have hcard : Fintype.card ((raisePolynomial p L d).rootSet ℂ) =
      (raisePolynomial p L d).natDegree :=
    Polynomial.card_rootSet_eq_natDegree hsep (IsAlgClosed.splits _)
  simpa [raisePolynomial_natDegree p L d hp] using hcard

theorem raisePolynomial_rootSet_ncard_eq_add_two
    (p : ℂ[X]) (L d : ℂ) (hp : p.Monic) (hpsep : p.Separable)
    (hd : d ≠ 0) (hcop : IsCoprime p (raiseFactor L d)) :
    ((raisePolynomial p L d).rootSet ℂ).ncard = (p.rootSet ℂ).ncard + 2 := by
  rw [raisePolynomial_rootSet_ncard p L d hp hpsep hd hcop]
  have hcard : Fintype.card (p.rootSet ℂ) = p.natDegree :=
    Polynomial.card_rootSet_eq_natDegree hpsep (IsAlgClosed.splits _)
  have hcard' : (p.rootSet ℂ).ncard = p.natDegree := by
    simpa using hcard
  rw [hcard']

theorem raisePolynomial_eval (p : ℂ[X]) (L d z : ℂ) :
    (raisePolynomial p L d).eval z =
      p.eval z * ((z - L) ^ 2 + d) := by
  unfold raisePolynomial
  rw [eval_mul, raiseFactor_eval]

/-! Local coordinate for the two new roots.  Writing `z = L + e * u` and
    choosing the quadratic height `d = e^2` turns the new factor into the
    exact model `e^2 (u^2 + 1)`.  This is the algebraic normalization used by
    the degree-raising paper proof; it avoids introducing square roots or
    asymptotic notation in the subsequent critical-point calculation. -/
theorem raisePolynomial_eval_center_add_mul
    (p : ℂ[X]) (L e u : ℂ) :
    (raisePolynomial p L (e ^ 2)).eval (L + e * u) =
      p.eval (L + e * u) * e ^ 2 * (u ^ 2 + 1) := by
  rw [raisePolynomial_eval]
  ring

/-! The corresponding factor identity is exposed separately so that later
    estimates can rewrite the quadratic term without unfolding the whole
    polynomial product. -/
theorem raiseFactor_eval_center_add_mul
    (L e u : ℂ) :
    (raiseFactor L (e ^ 2)).eval (L + e * u) = e ^ 2 * (u ^ 2 + 1) := by
  rw [raiseFactor_eval]
  ring

/-! The two model roots are obtained by taking `u = ± I`.  Keeping this as an
    explicit lemma makes the root-location part of the raising argument a
    one-line algebraic rewrite. -/
theorem raisePolynomial_eval_center_add_mul_I
    (p : ℂ[X]) (L e : ℂ) :
    (raisePolynomial p L (e ^ 2)).eval (L + e * Complex.I) = 0 := by
  rw [raisePolynomial_eval_center_add_mul]
  simp [Complex.I_sq]

theorem raisePolynomial_eval_center_sub_mul_I
    (p : ℂ[X]) (L e : ℂ) :
    (raisePolynomial p L (e ^ 2)).eval (L - e * Complex.I) = 0 := by
  rw [show L - e * Complex.I = L + e * (-Complex.I) by ring,
    raisePolynomial_eval_center_add_mul]
  simp [Complex.I_sq]

/-! The derivative in the same local chart.  This identity is the exact
    critical-point equation for the raised polynomial; later geometric
    arguments may use it without unfolding the product or the quadratic
    factor. -/
theorem raisePolynomial_derivative_eval_center_add_mul
    (p : ℂ[X]) (L e u : ℂ) :
    (raisePolynomial p L (e ^ 2)).derivative.eval (L + e * u) =
      p.derivative.eval (L + e * u) * e ^ 2 * (u ^ 2 + 1) +
        p.eval (L + e * u) * (2 * e * u) := by
  unfold raisePolynomial
  rw [derivative_mul, eval_add, eval_mul, eval_mul]
  have hQ : (raiseFactor L (e ^ 2)).derivative = C 2 * (X - C L) := by
    unfold raiseFactor
    rw [derivative_add, derivative_pow, derivative_X_sub_C, derivative_C]
    simp
  rw [hQ]
  norm_num [raiseFactor_eval, eval_C, eval_X, eval_sub, pow_two]
  ring

/-! A reference polynomial with the same degree as the raised polynomial.  It
    keeps the old roots and sends the double root at `L` to a nearby pair when
    the small parameter `d` is switched on.  This is the coefficient-level
    interface to Mathlib's continuity-of-roots theorem. -/
def referenceRaisePolynomial (p : ℂ[X]) (L : ℂ) : ℂ[X] :=
  p * (X - C L) ^ 2

theorem referenceRaisePolynomial_monic (p : ℂ[X]) (L : ℂ) (hp : p.Monic) :
    (referenceRaisePolynomial p L).Monic := by
  unfold referenceRaisePolynomial
  exact hp.mul ((monic_X_sub_C L).pow 2)

theorem referenceRaisePolynomial_natDegree (p : ℂ[X]) (L : ℂ)
    (hp : p.Monic) :
    (referenceRaisePolynomial p L).natDegree = p.natDegree + 2 := by
  unfold referenceRaisePolynomial
  rw [natDegree_mul hp.ne_zero ((monic_X_sub_C L).pow 2).ne_zero,
    natDegree_pow, natDegree_X_sub_C]

theorem referenceRaisePolynomial_eval (p : ℂ[X]) (L z : ℂ) :
    (referenceRaisePolynomial p L).eval z = p.eval z * (z - L) ^ 2 := by
  unfold referenceRaisePolynomial
  rw [eval_mul]
  simp

theorem referenceRaisePolynomial_eq_raisePolynomial_sub
    (p : ℂ[X]) (L d : ℂ) :
    referenceRaisePolynomial p L = raisePolynomial p L d - C d * p := by
  unfold referenceRaisePolynomial raisePolynomial raiseFactor
  ring

theorem raisePolynomial_coeff_sub_reference
    (p : ℂ[X]) (L d : ℂ) (i : ℕ) :
    (raisePolynomial p L d).coeff i - (referenceRaisePolynomial p L).coeff i =
      d * p.coeff i := by
  rw [referenceRaisePolynomial_eq_raisePolynomial_sub]
  simp only [coeff_sub, coeff_C_mul]
  ring

theorem raisePolynomial_coeff_sub_reference_norm_lt
    (p : ℂ[X]) (L d : ℂ) (A ε : ℝ)
    (hA : ∀ i : ℕ, ‖p.coeff i‖ ≤ A)
    (hd : ‖d‖ * A < ε) (i : ℕ) :
    ‖(raisePolynomial p L d).coeff i -
      (referenceRaisePolynomial p L).coeff i‖ < ε := by
  rw [raisePolynomial_coeff_sub_reference]
  calc
    ‖d * p.coeff i‖ = ‖d‖ * ‖p.coeff i‖ := norm_mul _ _
    _ ≤ ‖d‖ * A := mul_le_mul_of_nonneg_left (hA i) (norm_nonneg _)
    _ < ε := hd

/-! For a genuinely positive degree-raising exponent, the coefficient
    perturbation from the double-root reference tends uniformly to zero over
    all coefficients.  This is the quantitative scale-selection wrapper for
    the root-continuity theorem below. -/
theorem exists_pos_scale_coeff_close_to_reference
    {p : ℂ[X]} {n : ℕ} {q : ℂ} (hn : 3 ≤ n)
    {A ε : ℝ} (hA : ∀ i : ℕ, ‖p.coeff i‖ ≤ A) (hε : 0 < ε) :
    ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L → ∀ i : ℕ,
      ‖(raisePolynomial p (L : ℂ)
          (raiseParameter n q (L : ℂ))).coeff i -
        (referenceRaisePolynomial p (L : ℂ)).coeff i‖ < ε := by
  have hnexp : 0 < n - 2 := by omega
  have hpow : Tendsto (fun L : ℝ => L ^ (n - 2)) atTop atTop :=
    tendsto_pow_atTop hnexp.ne'
  have hqdiv : Tendsto (fun L : ℝ => ‖q‖ / L ^ (n - 2)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop hpow
  have hscaled : Tendsto (fun L : ℝ =>
      A * (‖q‖ / L ^ (n - 2))) atTop (𝓝 0) := by
    simpa [mul_comm] using hqdiv.const_mul A
  obtain ⟨L₀, hL₀⟩ := eventually_atTop.1 (hscaled.eventually_lt_const hε)
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL i
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by
      exact_mod_cast (ne_of_gt hLpos)
    have hLnorm : ‖(L : ℂ)‖ = L := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
    have hdenom : ‖(L : ℂ) ^ (n - 2)‖ = L ^ (n - 2) := by
      rw [norm_pow, hLnorm]
    have hd : ‖raiseParameter n q (L : ℂ)‖ * A < ε := by
      have hbound : A * (‖q‖ / L ^ (n - 2)) < ε :=
        hL₀ L (le_trans (le_max_left _ _) hL)
      rw [raiseParameter, norm_div, hdenom]
      nlinarith
    exact raisePolynomial_coeff_sub_reference_norm_lt p (L : ℂ)
      (raiseParameter n q (L : ℂ)) A ε hA hd i

theorem referenceRaisePolynomial_root_of_old_root
    (p : ℂ[X]) (L : ℂ) {a : ℂ} (ha : p.eval a = 0) :
    (referenceRaisePolynomial p L).eval a = 0 := by
  rw [referenceRaisePolynomial_eval, ha, zero_mul]

/-! If the coefficients of the active raised polynomial are close to the
    reference coefficients, every old root has an active root nearby.  The
    bound is exactly Mathlib's quantitative continuity-of-roots estimate; no
    Rouché or component claim is hidden here. -/
theorem exists_raised_root_near_old_root_of_coeff_close
    {p : ℂ[X]} {L d : ℂ} {ε : ℝ}
    (hp : p.Monic) {a : ℂ} (ha : p.eval a = 0) (hε : 0 < ε)
    (hcoeff : ∀ i : ℕ, ‖(raisePolynomial p L d).coeff i -
      (referenceRaisePolynomial p L).coeff i‖ < ε) :
    ∃ b ∈ (raisePolynomial p L d).roots,
      ‖a - b‖ < (((p.natDegree + 2 + 1 : ℕ) : ℝ) * ε) ^
        ((p.natDegree + 2 : ℕ) : ℝ)⁻¹ * max ‖a‖ 1 := by
  have hgm : (raisePolynomial p L d).Monic :=
    raisePolynomial_monic p L d hp
  have hfm : (referenceRaisePolynomial p L).Monic :=
    referenceRaisePolynomial_monic p L hp
  have hdeg : (raisePolynomial p L d).natDegree =
      (referenceRaisePolynomial p L).natDegree := by
    rw [raisePolynomial_natDegree p L d hp,
      referenceRaisePolynomial_natDegree p L hp]
  have hroot : (referenceRaisePolynomial p L).eval a = 0 :=
    referenceRaisePolynomial_root_of_old_root p L ha
  obtain ⟨b, hb, hdist⟩ :=
    Polynomial.exists_roots_norm_sub_lt_of_norm_coeff_sub_lt
      (f := referenceRaisePolynomial p L) (g := raisePolynomial p L d)
      hε hroot hfm hgm hdeg hcoeff (IsAlgClosed.splits _)
  refine ⟨b, hb, ?_⟩
  rw [referenceRaisePolynomial_natDegree p L hp] at hdist
  simpa [Nat.cast_add, Nat.cast_one, add_assoc, add_comm, add_left_comm] using hdist

/-! Uniformly applying the preceding estimate to the finite old root set gives
    a single positive scale threshold and a nearby raised root for every old
    root.  This is still only a root-location statement: injectivity and
    connected-component preservation are deliberately left to the geometric
    part of the degree-raising proof. -/
theorem exists_pos_scale_raised_root_near_all_old_roots
    {p : ℂ[X]} {n : ℕ} {q : ℂ} (hp : p.Monic) (hn : 3 ≤ n)
    {A ε : ℝ} (hA : ∀ i : ℕ, ‖p.coeff i‖ ≤ A) (hε : 0 < ε) :
    ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ∀ a ∈ (p.rootSet ℂ),
        ∃ b ∈ (raisePolynomial p (L : ℂ)
            (raiseParameter n q (L : ℂ))).roots,
          ‖a - b‖ < (((p.natDegree + 2 + 1 : ℕ) : ℝ) * ε) ^
            ((p.natDegree + 2 : ℕ) : ℝ)⁻¹ * max ‖a‖ 1 := by
  obtain ⟨L₀, hL₀, hclose⟩ :=
    exists_pos_scale_coeff_close_to_reference hn hA hε
  refine ⟨L₀, hL₀, ?_⟩
  intro L hL a ha
  exact exists_raised_root_near_old_root_of_coeff_close hp
    (hp.mem_rootSet.mp ha) hε (hclose L hL)

/-! Every polynomial has a finite coefficient norm bound.  Combining this
    elementary support bound with the previous scale selector removes the
    auxiliary bound `A` from the root-tracking interface. -/
theorem exists_coeff_norm_bound (p : ℂ[X]) :
    ∃ A : ℝ, ∀ i : ℕ, ‖p.coeff i‖ ≤ A := by
  classical
  refine ⟨p.support.sum (fun j => ‖p.coeff j‖), ?_⟩
  intro i
  by_cases hi : i ∈ p.support
  · exact Finset.single_le_sum (fun j _ => norm_nonneg (p.coeff j)) hi
  · have hzero : p.coeff i = 0 := by
      by_contra hne
      exact hi (mem_support_iff.mpr hne)
    simpa [hzero] using
      (Finset.sum_nonneg (fun j _ => norm_nonneg (p.coeff j)) :
        0 ≤ p.support.sum (fun j => ‖p.coeff j‖))

theorem exists_pos_scale_raised_root_near_all_old_roots_of_bound
    {p : ℂ[X]} {n : ℕ} {q : ℂ} (hp : p.Monic) (hn : 3 ≤ n)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ∀ a ∈ (p.rootSet ℂ),
        ∃ b ∈ (raisePolynomial p (L : ℂ)
            (raiseParameter n q (L : ℂ))).roots,
          ‖a - b‖ < (((p.natDegree + 2 + 1 : ℕ) : ℝ) * ε) ^
            ((p.natDegree + 2 : ℕ) : ℝ)⁻¹ * max ‖a‖ 1 := by
  obtain ⟨A, hA⟩ := exists_coeff_norm_bound p
  exact exists_pos_scale_raised_root_near_all_old_roots hp hn hA hε

/-! Exact product-rule formulas for the first three local Taylor coefficients of
the raised polynomial.  These are the algebraic part of the new-branch
curvature calculation; no asymptotic or root-location claim is made here. -/
theorem raisePolynomial_derivative_eval (p : ℂ[X]) (L d z : ℂ) :
    (raisePolynomial p L d).derivative.eval z =
      p.derivative.eval z * ((z - L) ^ 2 + d) +
        p.eval z * (2 * (z - L)) := by
  have hQ : (raiseFactor L d).derivative = C 2 * (X - C L) := by
    unfold raiseFactor
    rw [derivative_add, derivative_X_sub_C_sq, derivative_C]
    simp
  unfold raisePolynomial
  rw [derivative_mul, eval_add, eval_mul, eval_mul, hQ, raiseFactor_eval]
  norm_num [eval_mul, eval_C, eval_X, eval_sub, eval_add, pow_two] <;> ring

theorem raisePolynomial_second_derivative_eval (p : ℂ[X]) (L d z : ℂ) :
    (raisePolynomial p L d).derivative.derivative.eval z / 2 =
      p.derivative.derivative.eval z / 2 * ((z - L) ^ 2 + d) +
        p.derivative.eval z * (2 * (z - L)) + p.eval z := by
  have hQ : (raiseFactor L d).derivative = C 2 * (X - C L) := by
    unfold raiseFactor
    rw [derivative_add, derivative_X_sub_C_sq, derivative_C]
    simp
  have hQ2 : (raiseFactor L d).derivative.derivative = C 2 := by
    rw [hQ, derivative_C_mul, derivative_X_sub_C]
    simp
  have hP1 : (raisePolynomial p L d).derivative =
      p.derivative * raiseFactor L d + p * (raiseFactor L d).derivative := by
    unfold raisePolynomial
    rw [derivative_mul]
  have hP2 : (raisePolynomial p L d).derivative.derivative =
      p.derivative.derivative * raiseFactor L d +
        p.derivative * (raiseFactor L d).derivative +
        p.derivative * (raiseFactor L d).derivative +
        p * (raiseFactor L d).derivative.derivative := by
    rw [hP1, derivative_add, derivative_mul, derivative_mul, hQ]
    rw [derivative_C_mul, derivative_X_sub_C]
    ring
  rw [hP2]
  simp only [eval_add, eval_mul]
  simp [hQ, hQ2, raiseFactor_eval, derivative_C_mul, derivative_X_sub_C,
    eval_C, eval_X, eval_sub, pow_two] <;> ring

theorem raisePolynomial_third_derivative_eval (p : ℂ[X]) (L d z : ℂ) :
    (raisePolynomial p L d).derivative.derivative.derivative.eval z / 6 =
      p.derivative.derivative.derivative.eval z / 6 * ((z - L) ^ 2 + d) +
        p.derivative.derivative.eval z * (z - L) +
        p.derivative.eval z := by
  have hQ : (raiseFactor L d).derivative = C 2 * (X - C L) := by
    unfold raiseFactor
    rw [derivative_add, derivative_X_sub_C_sq, derivative_C]
    simp
  have hQ2 : (raiseFactor L d).derivative.derivative = C 2 := by
    rw [hQ, derivative_C_mul, derivative_X_sub_C]
    simp
  have hQ3 : (raiseFactor L d).derivative.derivative.derivative = 0 := by
    rw [hQ2, derivative_C]
  have hP1 : (raisePolynomial p L d).derivative =
      p.derivative * raiseFactor L d + p * (raiseFactor L d).derivative := by
    unfold raisePolynomial
    rw [derivative_mul]
  have hP2 : (raisePolynomial p L d).derivative.derivative =
      p.derivative.derivative * raiseFactor L d +
        p.derivative * (raiseFactor L d).derivative +
        p.derivative * (raiseFactor L d).derivative +
        p * (raiseFactor L d).derivative.derivative := by
    rw [hP1, derivative_add, derivative_mul, derivative_mul, hQ]
    rw [derivative_C_mul, derivative_X_sub_C]
    ring
  have hP3 : (raisePolynomial p L d).derivative.derivative.derivative =
      p.derivative.derivative.derivative * raiseFactor L d +
        p.derivative.derivative * (raiseFactor L d).derivative +
        p.derivative.derivative * (raiseFactor L d).derivative +
        p.derivative.derivative * (raiseFactor L d).derivative +
        p.derivative * (raiseFactor L d).derivative.derivative +
        p.derivative * (raiseFactor L d).derivative.derivative +
        p.derivative * (raiseFactor L d).derivative.derivative +
        p * (raiseFactor L d).derivative.derivative.derivative := by
    rw [hP2]
    simp [derivative_add, derivative_mul, hQ, hQ2, hQ3,
      derivative_C_mul, derivative_X_sub_C] <;> ring
  rw [hP3]
  simp only [eval_add, eval_mul]
  simp [hQ, hQ2, hQ3, raiseFactor_eval, derivative_C_mul, derivative_X_sub_C,
    eval_C, eval_X, eval_sub, pow_two] <;> ring

/-! The second- and third-derivative formulas in the same local chart.  These
    are immediate substitutions into the global product-rule identities, but
    exposing them here keeps later curvature calculations purely algebraic. -/
theorem raisePolynomial_second_derivative_eval_center_add_mul
    (p : ℂ[X]) (L e u : ℂ) :
    (raisePolynomial p L (e ^ 2)).derivative.derivative.eval (L + e * u) / 2 =
      p.derivative.derivative.eval (L + e * u) / 2 * e ^ 2 * (u ^ 2 + 1) +
        p.derivative.eval (L + e * u) * (2 * e * u) +
          p.eval (L + e * u) := by
  rw [raisePolynomial_second_derivative_eval]
  ring

theorem raisePolynomial_third_derivative_eval_center_add_mul
    (p : ℂ[X]) (L e u : ℂ) :
    (raisePolynomial p L (e ^ 2)).derivative.derivative.derivative.eval
        (L + e * u) / 6 =
      p.derivative.derivative.derivative.eval (L + e * u) / 6 *
          e ^ 2 * (u ^ 2 + 1) +
        p.derivative.derivative.eval (L + e * u) * (e * u) +
          p.derivative.eval (L + e * u) := by
  rw [raisePolynomial_third_derivative_eval]
  ring

theorem raisePolynomial_scaled_eval (p : ℂ[X]) (L d z : ℂ) (hL : L ≠ 0) :
    (raisePolynomial p L d).eval z / L ^ 2 =
      p.eval z * ((1 - z / L) ^ 2 + d / L ^ 2) := by
  rw [raisePolynomial_eval]
  field_simp [hL]
  ring

theorem raisePolynomial_scaled_eval_sub_original (p : ℂ[X]) (L d z : ℂ)
    (hL : L ≠ 0) :
    (raisePolynomial p L d).eval z / L ^ 2 - p.eval z =
      p.eval z * ((1 - z / L) ^ 2 + d / L ^ 2 - 1) := by
  rw [raisePolynomial_scaled_eval p L d z hL]
  ring

/-! If the quadratic factor is chosen with `d = (β-1)L²`, the normalized
    raised polynomial converges to the scalar multiple `β p`.  Keeping this
    identity separate from the usual `d = q/L^(n-2)` specialization makes
    non-unit limiting scalars available for geometric level matching. -/
theorem raisePolynomial_scaled_eval_of_d_eq_sub_one_mul_sq
    (p : ℂ[X]) (L β z : ℂ) (hL : L ≠ 0) :
    (raisePolynomial p L ((β - 1) * L ^ 2)).eval z / L ^ 2 =
      p.eval z * (β - 2 * (z / L) + (z / L) ^ 2) := by
  rw [raisePolynomial_scaled_eval p L ((β - 1) * L ^ 2) z hL]
  field_simp [hL]
  ring

theorem raisePolynomial_scaled_difference_norm_le_of_d_eq_sub_one_mul_sq
    (p : ℂ[X]) (L β z : ℂ) (hL : L ≠ 0) :
    ‖(raisePolynomial p L ((β - 1) * L ^ 2)).eval z / L ^ 2 -
        (β : ℂ) * p.eval z‖ ≤
      ‖p.eval z‖ * (2 * ‖z / L‖ + ‖z / L‖ ^ 2) := by
  have heq :
      (raisePolynomial p L ((β - 1) * L ^ 2)).eval z / L ^ 2 -
          (β : ℂ) * p.eval z =
        p.eval z * (-2 * (z / L) + (z / L) ^ 2) := by
    rw [raisePolynomial_scaled_eval_of_d_eq_sub_one_mul_sq p L β z hL]
    ring
  rw [heq, norm_mul]
  apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
  calc
    ‖-2 * (z / L) + (z / L) ^ 2‖ ≤
        ‖-2 * (z / L)‖ + ‖(z / L) ^ 2‖ := norm_add_le _ _
    _ = 2 * ‖z / L‖ + ‖z / L‖ ^ 2 := by
      simp [norm_neg, norm_pow]

theorem raisePolynomial_scaled_difference_norm_le_on_segment_of_d_eq_sub_one_mul_sq
    (p : ℂ[X]) (L β r a : ℂ) (R A ell : ℝ) (hL : L ≠ 0)
    (hR : ∀ z ∈ segment ℝ r a, ‖z‖ ≤ R)
    (hA : ∀ z ∈ segment ℝ r a, ‖p.eval z‖ ≤ A)
    (hell : 0 < ell) (hLell : ell ≤ ‖L‖) :
    ∀ z ∈ segment ℝ r a,
      ‖(raisePolynomial p L ((β - 1) * L ^ 2)).eval z / L ^ 2 -
          (β : ℂ) * p.eval z‖ ≤
        A * (2 * (R / ell) + (R / ell) ^ 2) := by
  intro z hz
  have hR0 : 0 ≤ R := (norm_nonneg z).trans (hR z hz)
  have hLpos : 0 < ‖L‖ := norm_pos_iff.mpr hL
  have hratio : ‖z / L‖ ≤ R / ‖L‖ := by
    rw [norm_div]
    change ‖z‖ / ‖L‖ ≤ R / ‖L‖
    exact div_le_div_of_nonneg_right (hR z hz) hLpos.le
  have hratio' : ‖z / L‖ ≤ R / ell := by
    calc
      ‖z / L‖ ≤ R / ‖L‖ := hratio
      _ ≤ R / ell := by
        exact div_le_div_of_nonneg_left hR0 hell hLell
  have hratio_sq : ‖z / L‖ ^ 2 ≤ (R / ell) ^ 2 :=
    pow_le_pow_left₀ (norm_nonneg _) hratio' 2
  have hbase := raisePolynomial_scaled_difference_norm_le_of_d_eq_sub_one_mul_sq
    p L β z hL
  have hfactor : 0 ≤ 2 * ‖z / L‖ + ‖z / L‖ ^ 2 := by positivity
  calc
    _ ≤ ‖p.eval z‖ * (2 * ‖z / L‖ + ‖z / L‖ ^ 2) := hbase
    _ ≤ A * (2 * ‖z / L‖ + ‖z / L‖ ^ 2) :=
      mul_le_mul_of_nonneg_right (hA z hz) hfactor
    _ ≤ A * (2 * (R / ell) + (R / ell) ^ 2) := by
      have hsum : 2 * ‖z / L‖ + ‖z / L‖ ^ 2 ≤ 2 * (R / ell) + (R / ell) ^ 2 := by
        nlinarith [hratio', hratio_sq]
      have hA0 : 0 ≤ A := (norm_nonneg (p.eval z)).trans (hA z hz)
      exact mul_le_mul_of_nonneg_left hsum hA0

/-! The same scalar-normalized quadratic perturbation converges uniformly on
    an arbitrary compact chart.  This is the compact analytic input for a
    local new-component argument: unlike the finite-segment transport below,
    the statement does not prescribe the shape of the chart. -/
theorem exists_uniform_scaled_difference_of_d_eq_sub_one_mul_sq_on_compact
    (p : ℂ[X]) (β : ℂ) (K : Set ℂ) (hK : IsCompact K) :
    ∀ ε : ℝ, 0 < ε → ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ∀ z ∈ K,
        ‖(raisePolynomial p (L : ℂ) ((β - 1) * (L : ℂ) ^ 2)).eval z /
            (L : ℂ) ^ 2 - β * p.eval z‖ < ε := by
  intro ε hε
  obtain ⟨R, hR⟩ := hK.exists_bound_of_continuousOn
    (continuous_id : Continuous (fun z : ℂ => z)).continuousOn
  obtain ⟨A, hA⟩ := hK.exists_bound_of_continuousOn p.continuous.continuousOn
  have hRdiv : Tendsto (fun L : ℝ => R / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => R / L) atTop (𝓝 0))
  have hRdiv2 : Tendsto (fun L : ℝ => (R / L) ^ 2) atTop (𝓝 0) := by
    simpa using hRdiv.pow 2
  have hsum : Tendsto (fun L : ℝ =>
      A * (2 * (R / L) + (R / L) ^ 2)) atTop (𝓝 0) := by
    have hadd : Tendsto (fun L : ℝ =>
        2 * (R / L) + (R / L) ^ 2) atTop (𝓝 0) := by
      simpa using (hRdiv.const_mul 2).add hRdiv2
    simpa using hadd.const_mul A
  obtain ⟨L₀, hL₀⟩ := eventually_atTop.1 (hsum.eventually_lt_const hε)
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL z hz
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hLpos)
    have hLnorm : L = ‖(L : ℂ)‖ := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
    have hR0 : 0 ≤ R := (norm_nonneg z).trans (hR z hz)
    have hA0 : 0 ≤ A := (norm_nonneg (p.eval z)).trans (hA z hz)
    have hratio : ‖z / (L : ℂ)‖ ≤ R / L := by
      rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
      exact div_le_div₀ hR0 (hR z hz) hLpos (le_rfl)
    have hratio_sq : ‖z / (L : ℂ)‖ ^ 2 ≤ (R / L) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) hratio 2
    have hbase := raisePolynomial_scaled_difference_norm_le_of_d_eq_sub_one_mul_sq
      p (L : ℂ) β z hLne
    have hfactor : 0 ≤ 2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 := by
      positivity
    have hpoint :
        ‖(raisePolynomial p (L : ℂ) ((β - 1) * (L : ℂ) ^ 2)).eval z /
            (L : ℂ) ^ 2 - β * p.eval z‖ ≤
          A * (2 * (R / L) + (R / L) ^ 2) := by
      calc
        _ ≤ ‖p.eval z‖ *
            (2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2) := hbase
        _ ≤ A * (2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2) :=
          mul_le_mul_of_nonneg_right (hA z hz) hfactor
        _ ≤ A * (2 * (R / L) + (R / L) ^ 2) := by
          have hsum' : 2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 ≤
              2 * (R / L) + (R / L) ^ 2 := by
            nlinarith [hratio, hratio_sq]
          exact mul_le_mul_of_nonneg_left hsum' hA0
    exact lt_of_le_of_lt hpoint
      (hL₀ L (le_trans (le_max_left _ _) hL))

/-! A local-chart front-end: if a polynomial takes a positive real value at a
    real centre, then its normalized value is uniformly close to `1` on any
    fixed compact chart after shrinking the real chart scale.  This is the
    continuity/compactness part of the quartic new-component construction; no
    root or component claim is hidden in this lemma. -/
theorem exists_pos_real_local_scale_close_on_compact
    (p : ℂ[X]) {L α : ℝ} (hα : 0 < α)
    (hL : p.eval (L : ℂ) = (α : ℂ)) (K : Set ℂ) (hK : IsCompact K) :
    ∀ η : ℝ, 0 < η → ∃ s : ℝ, 0 < s ∧ ∀ w ∈ K,
      ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) - 1‖ < η := by
  intro η hη
  have hε : 0 < α * η := mul_pos hα hη
  have hf : ContinuousAt (fun z : ℂ => p.eval z) (L : ℂ) :=
    p.continuous.continuousAt
  obtain ⟨δ, hδp, hδ⟩ := Metric.continuousAt_iff.mp hf _
    (norm_pos_iff.mpr (ne_of_gt hε))
  obtain ⟨R, hR⟩ := hK.exists_bound_of_continuousOn
    (continuous_id : Continuous (fun z : ℂ => z)).continuousOn
  let R₁ : ℝ := max R 1
  have hR₁pos : 0 < R₁ := by
    exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  let s : ℝ := min 1 (δ / (2 * R₁))
  have hspos : 0 < s := by
    dsimp [s]
    exact lt_min zero_lt_one (div_pos hδp (by positivity))
  refine ⟨s, hspos, ?_⟩
  intro w hw
  have hR0 : 0 ≤ R := (norm_nonneg w).trans (hR w hw)
  have hRw : ‖w‖ ≤ R₁ := (hR w hw).trans (le_max_left _ _)
  have hsbound : s ≤ δ / (2 * R₁) := by
    dsimp [s]
    exact min_le_right _ _
  have hdist : dist ((L : ℂ) + (s : ℂ) * w) (L : ℂ) < δ := by
    rw [dist_eq_norm]
    calc
      ‖(L : ℂ) + (s : ℂ) * w - (L : ℂ)‖ = ‖(s : ℂ) * w‖ := by
        congr 1
        ring
      _ = s * ‖w‖ := by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hspos]
      _ ≤ s * R₁ := mul_le_mul_of_nonneg_left hRw (le_of_lt hspos)
      _ ≤ (δ / (2 * R₁)) * R₁ := by
        exact mul_le_mul_of_nonneg_right hsbound (le_of_lt hR₁pos)
      _ = δ / 2 := by
        field_simp [ne_of_gt hR₁pos]
      _ < δ := by linarith
  have hclose := hδ (x := (L : ℂ) + (s : ℂ) * w) hdist
  have hclose' : ‖p.eval ((L : ℂ) + (s : ℂ) * w) - (α : ℂ)‖ < α * η := by
    simpa only [dist_eq_norm, hL, Real.norm_eq_abs, abs_of_pos hε] using hclose
  have hα0 : (α : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hα)
  calc
    ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) - 1‖ =
        ‖(p.eval ((L : ℂ) + (s : ℂ) * w) - (α : ℂ)) / (α : ℂ)‖ := by
          congr 1
          field_simp [hα0]
    _ = ‖p.eval ((L : ℂ) + (s : ℂ) * w) - (α : ℂ)‖ / α := by
          rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hα]
    _ < η := by
      apply (div_lt_iff₀ hα).2
      simpa [mul_comm] using hclose'

/-! Uniform-in-scale strengthening of the compact local chart.  The preceding
    theorem gives one admissible scale; this version records a positive
    threshold below which every scale works.  This is the form needed when a
    separate level equation prescribes `s²`. -/
theorem exists_pos_real_local_scale_threshold_close_on_compact
    (p : ℂ[X]) {L α : ℝ} (hα : 0 < α)
    (hL : p.eval (L : ℂ) = (α : ℂ)) (K : Set ℂ) (hK : IsCompact K) :
    ∀ η : ℝ, 0 < η → ∃ s₀ : ℝ, 0 < s₀ ∧
      ∀ s : ℝ, 0 < s → s ≤ s₀ → ∀ w ∈ K,
        ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) - 1‖ < η := by
  intro η hη
  have hε : 0 < α * η := mul_pos hα hη
  have hf : ContinuousAt (fun z : ℂ => p.eval z) (L : ℂ) :=
    p.continuous.continuousAt
  obtain ⟨δ, hδp, hδ⟩ := Metric.continuousAt_iff.mp hf _
    (norm_pos_iff.mpr (ne_of_gt hε))
  obtain ⟨R, hR⟩ := hK.exists_bound_of_continuousOn
    (continuous_id : Continuous (fun z : ℂ => z)).continuousOn
  let R₁ : ℝ := max R 1
  have hR₁pos : 0 < R₁ := by
    exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  let s₀ : ℝ := min 1 (δ / (2 * R₁))
  have hs₀pos : 0 < s₀ := by
    dsimp [s₀]
    exact lt_min zero_lt_one (div_pos hδp (by positivity))
  refine ⟨s₀, hs₀pos, ?_⟩
  intro s hs hsbound w hw
  have hRw : ‖w‖ ≤ R₁ := (hR w hw).trans (le_max_left _ _)
  have hdist : dist ((L : ℂ) + (s : ℂ) * w) (L : ℂ) < δ := by
    rw [dist_eq_norm]
    calc
      ‖(L : ℂ) + (s : ℂ) * w - (L : ℂ)‖ = ‖(s : ℂ) * w‖ := by
        congr 1
        ring
      _ = s * ‖w‖ := by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hs]
      _ ≤ s * R₁ := mul_le_mul_of_nonneg_left hRw (le_of_lt hs)
      _ ≤ (δ / (2 * R₁)) * R₁ := by
        have hsbound' : s ≤ δ / (2 * R₁) := by
          exact le_trans hsbound (by
            dsimp [s₀]
            exact min_le_right _ _)
        exact mul_le_mul_of_nonneg_right hsbound' (le_of_lt hR₁pos)
      _ = δ / 2 := by
        field_simp [ne_of_gt hR₁pos]
      _ < δ := by linarith
  have hclose := hδ (x := (L : ℂ) + (s : ℂ) * w) hdist
  have hclose' : ‖p.eval ((L : ℂ) + (s : ℂ) * w) - (α : ℂ)‖ < α * η := by
    simpa only [dist_eq_norm, hL, Real.norm_eq_abs, abs_of_pos hε] using hclose
  have hα0 : (α : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hα)
  calc
    ‖p.eval ((L : ℂ) + (s : ℂ) * w) / (α : ℂ) - 1‖ =
        ‖(p.eval ((L : ℂ) + (s : ℂ) * w) - (α : ℂ)) / (α : ℂ)‖ := by
          congr 1
          field_simp [hα0]
    _ = ‖p.eval ((L : ℂ) + (s : ℂ) * w) - (α : ℂ)‖ / α := by
          rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hα]
    _ < η := by
      apply (div_lt_iff₀ hα).2
      simpa [mul_comm] using hclose'

theorem raiseParameter_ne_zero {n : ℕ} {c L : ℂ}
    (hc : c ≠ 0) (hL : L ≠ 0) : raiseParameter n c L ≠ 0 := by
  unfold raiseParameter
  exact div_ne_zero hc (pow_ne_zero _ hL)

theorem raisePolynomial_scaled_eval_raiseParameter
    (p : ℂ[X]) (n : ℕ) (c L z : ℂ)
    (hn : 2 ≤ n) (hL : L ≠ 0) :
    (raisePolynomial p L (raiseParameter n c L)).eval z / L ^ 2 =
      p.eval z * ((1 - z / L) ^ 2 + c / L ^ n) := by
  rw [raisePolynomial_scaled_eval p L (raiseParameter n c L) z hL]
  unfold raiseParameter
  have hdiv : (c / L ^ (n - 2)) / L ^ 2 = c / L ^ n := by
    rw [div_div, ← pow_add, Nat.sub_add_cancel hn]
  rw [hdiv]

theorem raisePolynomial_scaled_difference
    (p : ℂ[X]) (n : ℕ) (c L z : ℂ)
    (hn : 2 ≤ n) (hL : L ≠ 0) :
    (raisePolynomial p L (raiseParameter n c L)).eval z / L ^ 2 - p.eval z =
      p.eval z * (-2 * (z / L) + (z / L) ^ 2 + c / L ^ n) := by
  rw [raisePolynomial_scaled_eval_raiseParameter p n c L z hn hL]
  ring

theorem raisePolynomial_scaled_difference_norm_le
    (p : ℂ[X]) (n : ℕ) (c L z : ℂ)
  (hn : 2 ≤ n) (hL : L ≠ 0) :
    ‖(raisePolynomial p L (raiseParameter n c L)).eval z / L ^ 2 - p.eval z‖ ≤
      ‖p.eval z‖ * (2 * ‖z / L‖ + ‖z / L‖ ^ 2 + ‖c / L ^ n‖) := by
  rw [raisePolynomial_scaled_difference p n c L z hn hL, norm_mul]
  apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
  calc
    ‖-2 * (z / L) + (z / L) ^ 2 + c / L ^ n‖ ≤
        ‖-2 * (z / L) + (z / L) ^ 2‖ + ‖c / L ^ n‖ :=
      norm_add_le (-2 * (z / L) + (z / L) ^ 2) (c / L ^ n)
    _ ≤ (‖-2 * (z / L)‖ + ‖(z / L) ^ 2‖) + ‖c / L ^ n‖ := by
      exact add_le_add (norm_add_le (-2 * (z / L)) ((z / L) ^ 2)) (le_refl _)
    _ = 2 * ‖z / L‖ + ‖z / L‖ ^ 2 + ‖c / L ^ n‖ := by
      simp [norm_neg, norm_pow]

/-! At every fixed point, the scaled degree-raising perturbation converges back
    to the original polynomial along positive real scales.  This is the
    pointwise `L → +∞` analytic input behind the later compact-segment and
    inverse-branch arguments; the proof uses only the quantitative norm bound
    above and the elementary real limits of `1/L` and `1/L^n`. -/
theorem tendsto_raisePolynomial_scaled_difference_norm_atTop
    (p : ℂ[X]) (n : ℕ) (q z : ℂ) (hn : 2 ≤ n) :
    Tendsto (fun L : ℝ =>
      ‖(raisePolynomial p (L : ℂ) (raiseParameter n q (L : ℂ))).eval z /
          (L : ℂ) ^ 2 - p.eval z‖) atTop (𝓝 0) := by
  have hLpos : ∀ᶠ L : ℝ in atTop, 0 < L := eventually_gt_atTop (0 : ℝ)
  have hLne : ∀ᶠ L : ℝ in atTop, L ≠ 0 := hLpos.mono fun L hL => ne_of_gt hL
  have hdiv : Tendsto (fun L : ℝ => ‖z‖ / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => ‖z‖ / L) atTop (𝓝 0))
  have hdivc : Tendsto (fun L : ℝ => ‖z / (L : ℂ)‖) atTop (𝓝 0) := by
    apply Tendsto.congr' ?_ hdiv
    filter_upwards [hLpos] with L hL
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
  have hdivc2 : Tendsto (fun L : ℝ => ‖z / (L : ℂ)‖ ^ 2) atTop (𝓝 0) := by
    simpa using hdivc.pow 2
  have hpow : Tendsto (fun L : ℝ => ‖(L : ℂ)‖ ^ n) atTop atTop := by
    refine (tendsto_pow_atTop (α := ℝ) (show n ≠ 0 by omega)).congr' ?_
    filter_upwards [hLpos] with L hL
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
  have hqdiv : Tendsto (fun L : ℝ => ‖q‖ / ‖(L : ℂ)‖ ^ n) atTop (𝓝 0) := by
    exact (tendsto_const_nhds.div_atTop hpow)
  have hqdivc : Tendsto (fun L : ℝ => ‖q / (L : ℂ) ^ n‖) atTop (𝓝 0) := by
    apply Tendsto.congr' ?_ hqdiv
    filter_upwards [hLpos] with L hL
    rw [norm_div, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
  have hsum : Tendsto (fun L : ℝ =>
      ‖z / (L : ℂ)‖ * 2 + ‖z / (L : ℂ)‖ ^ 2 +
        ‖q / (L : ℂ) ^ n‖) atTop (𝓝 0) := by
    simpa [add_assoc, mul_comm, mul_left_comm, mul_assoc] using
      (hdivc.const_mul 2).add (hdivc2.add hqdivc)
  have hbound : ∀ᶠ L : ℝ in atTop,
      ‖(raisePolynomial p (L : ℂ) (raiseParameter n q (L : ℂ))).eval z /
          (L : ℂ) ^ 2 - p.eval z‖ ≤
        ‖p.eval z‖ * (2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
          ‖q / (L : ℂ) ^ n‖) := by
    filter_upwards [hLne] with L hL
    exact (raisePolynomial_scaled_difference_norm_le p n q (L : ℂ) z hn
      (by exact_mod_cast hL))
  have hsum' : Tendsto (fun L : ℝ =>
      ‖p.eval z‖ * (2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
        ‖q / (L : ℂ) ^ n‖)) atTop (𝓝 0) := by
    simpa [mul_add, add_assoc, mul_comm, mul_left_comm, mul_assoc] using
      hsum.const_mul ‖p.eval z‖
  exact squeeze_zero' (Eventually.of_forall fun L => norm_nonneg _) hbound hsum'

/-! The first-derivative analogue of the preceding convergence statement.  It
    is the compact-coordinate input needed when transporting boundary
    curvature to an old inverse branch.  The identity is kept explicit so
    later estimates can use the same three vanishing scale terms as for the
    polynomial values. -/
theorem raisePolynomial_scaled_derivative_difference
    (p : ℂ[X]) (n : ℕ) (q L z : ℂ)
    (hn : 2 ≤ n) (hL : L ≠ 0) :
    (raisePolynomial p L (raiseParameter n q L)).derivative.eval z / L ^ 2 -
        p.derivative.eval z =
      p.derivative.eval z * (-2 * (z / L) + (z / L) ^ 2 + q / L ^ n) -
        2 * p.eval z / L + 2 * p.eval z * z / L ^ 2 := by
  rw [raisePolynomial_derivative_eval]
  unfold raiseParameter
  have hpow : L ^ n = L ^ 2 * L ^ (n - 2) := by
    rw [← pow_add]
    congr 1
    omega
  rw [hpow]
  field_simp [hL]
  ring

theorem tendsto_raisePolynomial_scaled_derivative_difference_norm_atTop
    (p : ℂ[X]) (n : ℕ) (q z : ℂ) (hn : 2 ≤ n) :
    Tendsto (fun L : ℝ =>
      ‖(raisePolynomial p (L : ℂ)
          (raiseParameter n q (L : ℂ))).derivative.eval z /
          (L : ℂ) ^ 2 - p.derivative.eval z‖) atTop (𝓝 0) := by
  have hLpos : ∀ᶠ L : ℝ in atTop, 0 < L := eventually_gt_atTop (0 : ℝ)
  have hLne : ∀ᶠ L : ℝ in atTop, L ≠ 0 := hLpos.mono fun L hL => ne_of_gt hL
  have hdiv : Tendsto (fun L : ℝ => ‖z‖ / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => ‖z‖ / L) atTop (𝓝 0))
  have hdivc : Tendsto (fun L : ℝ => ‖z / (L : ℂ)‖) atTop (𝓝 0) := by
    apply Tendsto.congr' ?_ hdiv
    filter_upwards [hLpos] with L hL
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
  have hdivc2 : Tendsto (fun L : ℝ => ‖z / (L : ℂ)‖ ^ 2) atTop (𝓝 0) := by
    simpa using hdivc.pow 2
  have hpow : Tendsto (fun L : ℝ => ‖(L : ℂ)‖ ^ n) atTop atTop := by
    refine (tendsto_pow_atTop (α := ℝ) (show n ≠ 0 by omega)).congr' ?_
    filter_upwards [hLpos] with L hL
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
  have hqdiv : Tendsto (fun L : ℝ => ‖q‖ / ‖(L : ℂ)‖ ^ n) atTop (𝓝 0) := by
    exact (tendsto_const_nhds.div_atTop hpow)
  have hqdivc : Tendsto (fun L : ℝ => ‖q / (L : ℂ) ^ n‖) atTop (𝓝 0) := by
    apply Tendsto.congr' ?_ hqdiv
    filter_upwards [hLpos] with L hL
    rw [norm_div, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
  have hlinv : Tendsto (fun L : ℝ => (2 : ℝ) * ‖p.eval z‖ / L)
      atTop (𝓝 0) := by
    simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using
      (tendsto_const_nhds.div_atTop tendsto_id :
        Tendsto (fun L : ℝ => (2 : ℝ) * ‖p.eval z‖ / L) atTop (𝓝 0))
  have hquad : Tendsto (fun L : ℝ =>
      (2 : ℝ) * ‖p.eval z‖ * ‖z‖ / L ^ 2) atTop (𝓝 0) := by
    have hpow2 : Tendsto (fun L : ℝ => L ^ 2) atTop atTop :=
      tendsto_pow_atTop (show (2 : ℕ) ≠ 0 by omega)
    simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using
      (tendsto_const_nhds.div_atTop hpow2 :
        Tendsto (fun L : ℝ =>
          (2 : ℝ) * ‖p.eval z‖ * ‖z‖ / L ^ 2) atTop (𝓝 0))
  have hsum : Tendsto (fun L : ℝ =>
      ‖p.derivative.eval z‖ *
          (2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
            ‖q / (L : ℂ) ^ n‖) +
        2 * ‖p.eval z‖ / L + 2 * ‖p.eval z‖ * ‖z‖ / L ^ 2) atTop (𝓝 0) := by
    have hinner : Tendsto (fun L : ℝ =>
        2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
          ‖q / (L : ℂ) ^ n‖) atTop (𝓝 0) := by
      simpa [add_assoc, mul_comm, mul_left_comm, mul_assoc] using
        (hdivc.const_mul 2).add (hdivc2.add hqdivc)
    have houter : Tendsto (fun L : ℝ =>
        ‖p.derivative.eval z‖ *
          (2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
            ‖q / (L : ℂ) ^ n‖)) atTop (𝓝 0) := by
      simpa [mul_comm, mul_left_comm, mul_assoc] using
        hinner.const_mul ‖p.derivative.eval z‖
    simpa using (houter.add hlinv).add hquad
  have hbound : ∀ᶠ L : ℝ in atTop,
      ‖(raisePolynomial p (L : ℂ)
          (raiseParameter n q (L : ℂ))).derivative.eval z /
          (L : ℂ) ^ 2 - p.derivative.eval z‖ ≤
        ‖p.derivative.eval z‖ *
            (2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
              ‖q / (L : ℂ) ^ n‖) +
          2 * ‖p.eval z‖ / L + 2 * ‖p.eval z‖ * ‖z‖ / L ^ 2 := by
    filter_upwards [hLpos, hLne] with L hLp hL
    rw [raisePolynomial_scaled_derivative_difference p n q (L : ℂ) z hn
      (by exact_mod_cast hL)]
    calc
      ‖p.derivative.eval z *
          (-2 * (z / (L : ℂ)) + (z / (L : ℂ)) ^ 2 +
            q / (L : ℂ) ^ n) - 2 * p.eval z / (L : ℂ) +
              2 * p.eval z * z / (L : ℂ) ^ 2‖ ≤
          ‖p.derivative.eval z‖ *
              ‖-2 * (z / (L : ℂ)) + (z / (L : ℂ)) ^ 2 +
                q / (L : ℂ) ^ n‖ +
            ‖2 * p.eval z / (L : ℂ)‖ +
            ‖2 * p.eval z * z / (L : ℂ) ^ 2‖ := by
        calc
          _ ≤ ‖p.derivative.eval z *
                (-2 * (z / (L : ℂ)) + (z / (L : ℂ)) ^ 2 +
                  q / (L : ℂ) ^ n) - 2 * p.eval z / (L : ℂ)‖ +
              ‖2 * p.eval z * z / (L : ℂ) ^ 2‖ := norm_add_le _ _
          _ ≤ (‖p.derivative.eval z‖ *
                ‖-2 * (z / (L : ℂ)) + (z / (L : ℂ)) ^ 2 +
                  q / (L : ℂ) ^ n‖ +
              ‖2 * p.eval z / (L : ℂ)‖) +
              ‖2 * p.eval z * z / (L : ℂ) ^ 2‖ := by
            exact add_le_add
              ((norm_sub_le
                (p.derivative.eval z *
                  (-2 * (z / (L : ℂ)) + (z / (L : ℂ)) ^ 2 +
                    q / (L : ℂ) ^ n))
                (2 * p.eval z / (L : ℂ))).trans_eq (by rw [norm_mul]))
              (le_refl _)
      _ ≤ ‖p.derivative.eval z‖ *
            (2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
              ‖q / (L : ℂ) ^ n‖) +
          2 * ‖p.eval z‖ / L + 2 * ‖p.eval z‖ * ‖z‖ / L ^ 2 := by
        have htri := norm_add_le
          (-2 * (z / (L : ℂ)) + (z / (L : ℂ)) ^ 2)
          (q / (L : ℂ) ^ n)
        have htri' := norm_add_le (-2 * (z / (L : ℂ)))
          ((z / (L : ℂ)) ^ 2)
        have hinner :
            ‖-2 * (z / (L : ℂ)) + (z / (L : ℂ)) ^ 2 +
                q / (L : ℂ) ^ n‖ ≤
              2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
                ‖q / (L : ℂ) ^ n‖ := by
          calc
            _ ≤ ‖-2 * (z / (L : ℂ)) + (z / (L : ℂ)) ^ 2‖ +
                ‖q / (L : ℂ) ^ n‖ := htri
            _ ≤ (‖-2 * (z / (L : ℂ))‖ +
                ‖(z / (L : ℂ)) ^ 2‖) + ‖q / (L : ℂ) ^ n‖ := by
              exact add_le_add htri' (le_refl _)
            _ = 2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
                ‖q / (L : ℂ) ^ n‖ := by
              rw [norm_mul, norm_pow]
              norm_num [norm_neg]
        have hLnorm : ‖(L : ℂ)‖ = L := by
          rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLp]
        have hlast : ‖2 * p.eval z / (L : ℂ)‖ = 2 * ‖p.eval z‖ / L := by
          rw [norm_div, norm_mul, hLnorm]
          norm_num
        have hlast2 : ‖2 * p.eval z * z / (L : ℂ) ^ 2‖ =
            2 * ‖p.eval z‖ * ‖z‖ / L ^ 2 := by
          rw [norm_div, norm_mul, norm_mul, norm_pow, hLnorm]
          norm_num
        have hfirst := mul_le_mul_of_nonneg_left hinner
          (norm_nonneg (p.derivative.eval z))
        have hsumle :
            (‖p.derivative.eval z‖ *
                ‖-2 * (z / (L : ℂ)) + (z / (L : ℂ)) ^ 2 +
                  q / (L : ℂ) ^ n‖ +
              ‖2 * p.eval z / (L : ℂ)‖) +
              ‖2 * p.eval z * z / (L : ℂ) ^ 2‖ ≤
            (‖p.derivative.eval z‖ *
                (2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
                  ‖q / (L : ℂ) ^ n‖) +
              ‖2 * p.eval z / (L : ℂ)‖) +
              ‖2 * p.eval z * z / (L : ℂ) ^ 2‖ := by
          exact add_le_add (add_le_add hfirst (le_refl _)) (le_refl _)
        calc
          _ ≤ (‖p.derivative.eval z‖ *
                (2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
                  ‖q / (L : ℂ) ^ n‖) +
              ‖2 * p.eval z / (L : ℂ)‖) +
              ‖2 * p.eval z * z / (L : ℂ) ^ 2‖ := hsumle
          _ = ‖p.derivative.eval z‖ *
                (2 * ‖z / (L : ℂ)‖ + ‖z / (L : ℂ)‖ ^ 2 +
                  ‖q / (L : ℂ) ^ n‖) +
              2 * ‖p.eval z‖ / L + 2 * ‖p.eval z‖ * ‖z‖ / L ^ 2 := by
            rw [hlast, hlast2]
  exact squeeze_zero' (Eventually.of_forall fun L => norm_nonneg _) hbound hsum

/-! A quantitative compact-set version of the derivative estimate.  This is
    the form consumed by a uniform inverse-branch argument: the old value and
    derivative are bounded on a compact set, while the scale denominator is
    bounded below by `ell`. -/
theorem raisePolynomial_scaled_derivative_difference_norm_le_of_bounds
    (p : ℂ[X]) (n : ℕ) (q L z : ℂ) (S : Set ℂ)
    (R A A₁ B ell : ℝ) (hn : 2 ≤ n) (hL : L ≠ 0)
    (hR : ∀ w ∈ S, ‖w‖ ≤ R)
    (hA : ∀ w ∈ S, ‖p.eval w‖ ≤ A)
    (hA₁ : ∀ w ∈ S, ‖p.derivative.eval w‖ ≤ A₁)
    (hB : ‖q‖ ≤ B) (hell : 0 < ell) (hLell : ell ≤ ‖L‖)
    (hz : z ∈ S) :
    ‖(raisePolynomial p L (raiseParameter n q L)).derivative.eval z / L ^ 2 -
        p.derivative.eval z‖ ≤
      A₁ * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n) +
        2 * A / ell + 2 * A * R / ell ^ 2 := by
  have hR0 : 0 ≤ R := (norm_nonneg z).trans (hR z hz)
  have hA0 : 0 ≤ A := (norm_nonneg (p.eval z)).trans (hA z hz)
  have hA₁0 : 0 ≤ A₁ := (norm_nonneg (p.derivative.eval z)).trans (hA₁ z hz)
  have hB0 : 0 ≤ B := (norm_nonneg q).trans hB
  have hratio : ‖z / L‖ ≤ R / ell := by
    rw [norm_div]
    exact div_le_div₀ hR0 (hR z hz) hell hLell
  have hratio_sq : ‖z / L‖ ^ 2 ≤ (R / ell) ^ 2 :=
    pow_le_pow_left₀ (norm_nonneg _) hratio 2
  have hqratio : ‖q / L ^ n‖ ≤ B / ell ^ n := by
    rw [norm_div, norm_pow]
    have hpow : ell ^ n ≤ ‖L‖ ^ n :=
      pow_le_pow_left₀ (le_of_lt hell) hLell n
    exact div_le_div₀ hB0 hB (by positivity) hpow
  have hterm :
      ‖-2 * (z / L) + (z / L) ^ 2 + q / L ^ n‖ ≤
        2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n := by
    have htri := norm_add_le
      (-2 * (z / L) + (z / L) ^ 2) (q / L ^ n)
    have htri' := norm_add_le (-2 * (z / L)) ((z / L) ^ 2)
    calc
      _ ≤ ‖-2 * (z / L) + (z / L) ^ 2‖ + ‖q / L ^ n‖ := htri
      _ ≤ (‖-2 * (z / L)‖ + ‖(z / L) ^ 2‖) + ‖q / L ^ n‖ := by
        exact add_le_add htri' (le_refl _)
      _ = 2 * ‖z / L‖ + ‖z / L‖ ^ 2 + ‖q / L ^ n‖ := by
        rw [norm_mul, norm_pow]
        norm_num [norm_neg]
      _ ≤ 2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n := by
        have hRdiv : 0 ≤ R / ell := div_nonneg hR0 hell.le
        have hBdiv : 0 ≤ B / ell ^ n := div_nonneg hB0 (by positivity)
        nlinarith
  have hbase :
      ‖(raisePolynomial p L (raiseParameter n q L)).derivative.eval z / L ^ 2 -
          p.derivative.eval z‖ ≤
        ‖p.derivative.eval z‖ * ‖-2 * (z / L) + (z / L) ^ 2 + q / L ^ n‖ +
          ‖2 * p.eval z / L‖ + ‖2 * p.eval z * z / L ^ 2‖ := by
    rw [raisePolynomial_scaled_derivative_difference p n q L z hn hL]
    calc
      ‖p.derivative.eval z *
          (-2 * (z / L) + (z / L) ^ 2 + q / L ^ n) -
            2 * p.eval z / L + 2 * p.eval z * z / L ^ 2‖ ≤
          ‖p.derivative.eval z *
              (-2 * (z / L) + (z / L) ^ 2 + q / L ^ n) -
            2 * p.eval z / L‖ + ‖2 * p.eval z * z / L ^ 2‖ := norm_add_le _ _
      _ ≤ (‖p.derivative.eval z‖ *
            ‖-2 * (z / L) + (z / L) ^ 2 + q / L ^ n‖ +
          ‖2 * p.eval z / L‖) + ‖2 * p.eval z * z / L ^ 2‖ := by
        exact add_le_add
          ((norm_sub_le
            (p.derivative.eval z *
              (-2 * (z / L) + (z / L) ^ 2 + q / L ^ n))
            (2 * p.eval z / L)).trans_eq (by rw [norm_mul]))
          (le_refl _)
  have hlin : ‖2 * p.eval z / L‖ ≤ 2 * A / ell := by
    rw [norm_div, norm_mul]
    have hbase : ‖p.eval z‖ / ‖L‖ ≤ A / ell := by
      exact div_le_div₀ (by positivity) (hA z hz) (by positivity) hLell
    have htwo : ‖(2 : ℂ)‖ = (2 : ℝ) := by norm_num
    rw [htwo]
    have hmul := mul_le_mul_of_nonneg_left hbase (by norm_num : (0 : ℝ) ≤ 2)
    calc
      2 * ‖p.eval z‖ / ‖L‖ = 2 * (‖p.eval z‖ / ‖L‖) := by ring
      _ ≤ 2 * (A / ell) := hmul
      _ = 2 * A / ell := by ring
  have hquad : ‖2 * p.eval z * z / L ^ 2‖ ≤
      2 * A * R / ell ^ 2 := by
    rw [norm_div, norm_mul, norm_mul, norm_pow]
    have hnum : 2 * ‖p.eval z‖ * ‖z‖ ≤ 2 * A * R := by
      have hmul : ‖p.eval z‖ * ‖z‖ ≤ A * R :=
        mul_le_mul (hA z hz) (hR z hz) (norm_nonneg z) hA0
      nlinarith
    have hnum' : ‖(2 : ℂ)‖ * ‖p.eval z‖ * ‖z‖ ≤ 2 * A * R := by
      norm_num
      exact hnum
    have hden : ell ^ 2 ≤ ‖L‖ ^ 2 := pow_le_pow_left₀ hell.le hLell 2
    exact div_le_div₀ (by positivity) hnum' (by positivity) hden
  calc
    _ ≤ ‖p.derivative.eval z‖ *
          ‖-2 * (z / L) + (z / L) ^ 2 + q / L ^ n‖ +
        ‖2 * p.eval z / L‖ + ‖2 * p.eval z * z / L ^ 2‖ := hbase
    _ ≤ A₁ * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n) +
        2 * A / ell + 2 * A * R / ell ^ 2 := by
      have hfirst := mul_le_mul (hA₁ z hz) hterm (norm_nonneg _) 
        (by
          have hRdiv : 0 ≤ R / ell := div_nonneg hR0 hell.le
          have hBdiv : 0 ≤ B / ell ^ n := div_nonneg hB0 (by positivity)
          positivity)
      nlinarith [hfirst, hlin, hquad]

theorem raisePolynomial_scaled_derivative_difference_norm_le_on_segment
    (p : ℂ[X]) (n : ℕ) (q L r a : ℂ)
    (R A A₁ B ell : ℝ) (hn : 2 ≤ n) (hL : L ≠ 0)
    (hR : ∀ z ∈ segment ℝ r a, ‖z‖ ≤ R)
    (hA : ∀ z ∈ segment ℝ r a, ‖p.eval z‖ ≤ A)
    (hA₁ : ∀ z ∈ segment ℝ r a, ‖p.derivative.eval z‖ ≤ A₁)
    (hB : ‖q‖ ≤ B) (hell : 0 < ell) (hLell : ell ≤ ‖L‖) :
    ∀ z ∈ segment ℝ r a,
      ‖(raisePolynomial p L (raiseParameter n q L)).derivative.eval z / L ^ 2 -
          p.derivative.eval z‖ ≤
        A₁ * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n) +
          2 * A / ell + 2 * A * R / ell ^ 2 := by
  intro z hz
  exact raisePolynomial_scaled_derivative_difference_norm_le_of_bounds p n q L z
    (segment ℝ r a) R A A₁ B ell hn hL hR hA hA₁ hB hell hLell hz

theorem raisePolynomial_scaled_difference_norm_le_of_bounds
    (p : ℂ[X]) (n : ℕ) (q L z : ℂ) (S : Set ℂ)
    (R A B ell : ℝ) (hn : 2 ≤ n) (hL : L ≠ 0)
    (hR : ∀ w ∈ S, ‖w‖ ≤ R) (hA : ∀ w ∈ S, ‖p.eval w‖ ≤ A)
    (hB : ‖q‖ ≤ B) (hell : 0 < ell) (hLell : ell ≤ ‖L‖)
    (hz : z ∈ S) :
    ‖(raisePolynomial p L (raiseParameter n q L)).eval z / L ^ 2 - p.eval z‖ ≤
      A * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n) := by
  have hR0 : 0 ≤ R := (norm_nonneg z).trans (hR z hz)
  have hB0 : 0 ≤ B := (norm_nonneg q).trans hB
  have hratio : ‖z / L‖ ≤ R / ell := by
    rw [norm_div]
    exact div_le_div₀ hR0 (hR z hz) hell hLell
  have hratio_sq : ‖z / L‖ ^ 2 ≤ (R / ell) ^ 2 :=
    pow_le_pow_left₀ (norm_nonneg _) hratio 2
  have hqratio : ‖q / L ^ n‖ ≤ B / ell ^ n := by
    rw [norm_div, norm_pow]
    have hpow : ell ^ n ≤ ‖L‖ ^ n :=
      pow_le_pow_left₀ (le_of_lt hell) hLell n
    exact div_le_div₀ hB0 hB
      (by positivity) hpow
  have hsum : 2 * ‖z / L‖ + ‖z / L‖ ^ 2 + ‖q / L ^ n‖ ≤
      2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n := by
    nlinarith
  have hbase := raisePolynomial_scaled_difference_norm_le p n q L z hn hL
  calc
    _ ≤ ‖p.eval z‖ * (2 * ‖z / L‖ + ‖z / L‖ ^ 2 + ‖q / L ^ n‖) := hbase
    _ ≤ ‖p.eval z‖ * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n) := by
      exact mul_le_mul_of_nonneg_left hsum (norm_nonneg _)
    _ ≤ A * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n) := by
      have hRdiv : 0 ≤ R / ell := div_nonneg hR0 hell.le
      have hBdiv : 0 ≤ B / ell ^ n := div_nonneg hB0 (by positivity)
      have hfactor : 0 ≤ 2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n := by
        positivity
      exact mul_le_mul_of_nonneg_right (hA z hz) hfactor

theorem raisePolynomial_scaled_difference_norm_le_on_segment
    (p : ℂ[X]) (n : ℕ) (q L r a : ℂ)
    (R A B ell : ℝ) (hn : 2 ≤ n) (hL : L ≠ 0)
    (hR : ∀ z ∈ segment ℝ r a, ‖z‖ ≤ R)
    (hA : ∀ z ∈ segment ℝ r a, ‖p.eval z‖ ≤ A)
    (hB : ‖q‖ ≤ B) (hell : 0 < ell) (hLell : ell ≤ ‖L‖) :
    ∀ z ∈ segment ℝ r a,
      ‖(raisePolynomial p L (raiseParameter n q L)).eval z / L ^ 2 - p.eval z‖ ≤
        A * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n) := by
  intro z hz
  exact raisePolynomial_scaled_difference_norm_le_of_bounds p n q L z
    (segment ℝ r a) R A B ell hn hL hR hA hB hell hLell hz

theorem raisePolynomial_scaled_difference_norm_le_at_point_of_bounds
    (p : ℂ[X]) (n : ℕ) (q L z : ℂ)
    (R A B ell : ℝ) (hn : 2 ≤ n) (hL : L ≠ 0)
    (hR : ‖z‖ ≤ R) (hA : ‖p.eval z‖ ≤ A)
    (hB : ‖q‖ ≤ B) (hell : 0 < ell) (hLell : ell ≤ ‖L‖) :
    ‖(raisePolynomial p L (raiseParameter n q L)).eval z / L ^ 2 - p.eval z‖ ≤
      A * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n) := by
  apply raisePolynomial_scaled_difference_norm_le_of_bounds p n q L z
    ({z} : Set ℂ) R A B ell hn hL
      (by
        intro w hw
        rcases Set.mem_singleton_iff.mp hw with rfl
        exact hR)
      (by
        intro w hw
        rcases Set.mem_singleton_iff.mp hw with rfl
        exact hA)
      hB hell hLell
      (Set.mem_singleton z)

theorem norm_le_max_on_segment {r a z : ℂ}
    (hz : z ∈ segment ℝ r a) : ‖z‖ ≤ max ‖r‖ ‖a‖ := by
  simpa using ((convexOn_norm (convex_segment r a)).le_max_of_mem_segment
    (left_mem_segment ℝ r a) (right_mem_segment ℝ r a) hz)

theorem exists_norm_bound_on_segment {F : ℂ → ℂ} {r a : ℂ}
    (hF : Continuous F) :
    ∃ A : ℝ, ∀ z ∈ segment ℝ r a, ‖F z‖ ≤ A := by
  have hcompact : IsCompact (segment ℝ r a) := by
    rw [segment_eq_image_lineMap]
    exact isCompact_Icc.image (by fun_prop)
  exact hcompact.exists_bound_of_continuousOn hF.continuousOn

theorem exists_segment_eval_bounds (p : ℂ[X]) (r a : ℂ) :
    ∃ R A : ℝ,
      (∀ z ∈ segment ℝ r a, ‖z‖ ≤ R) ∧
      (∀ z ∈ segment ℝ r a, ‖p.eval z‖ ≤ A) := by
  obtain ⟨A, hA⟩ := exists_norm_bound_on_segment p.continuous
  refine ⟨max ‖r‖ ‖a‖, A, ?_, hA⟩
  intro z hz
  exact norm_le_max_on_segment hz

theorem exists_two_segment_eval_bounds (p : ℂ[X]) (r a b : ℂ) :
    ∃ R A : ℝ,
      (∀ z ∈ segment ℝ r a, ‖z‖ ≤ R) ∧
      (∀ z ∈ segment ℝ r a, ‖p.eval z‖ ≤ A) ∧
      (∀ z ∈ segment ℝ r b, ‖z‖ ≤ R) ∧
      (∀ z ∈ segment ℝ r b, ‖p.eval z‖ ≤ A) ∧
      ‖midpoint ℝ a b‖ ≤ R ∧
      ‖p.eval (midpoint ℝ a b)‖ ≤ A := by
  obtain ⟨Ra, Aa, hRa, hAa⟩ := exists_segment_eval_bounds p r a
  obtain ⟨Rb, Ab, hRb, hAb⟩ := exists_segment_eval_bounds p r b
  let m := midpoint ℝ a b
  let R := max Ra (max Rb ‖m‖)
  let A := max Aa (max Ab ‖p.eval m‖)
  refine ⟨R, A, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro z hz
    exact le_trans (hRa z hz) (le_max_left _ _)
  · intro z hz
    exact le_trans (hAa z hz) (le_max_left _ _)
  · intro z hz
    exact le_trans (hRb z hz) (le_trans (le_max_left _ _) (le_max_right _ _))
  · intro z hz
    exact le_trans (hAb z hz) (le_trans (le_max_left _ _) (le_max_right _ _))
  · exact le_trans (le_max_right _ _) (le_max_right _ _)
  · exact le_trans (le_max_right _ _) (le_max_right _ _)

/-! The derivative estimate also becomes uniform on a compact segment after
    choosing one sufficiently large positive real scale.  This is the precise
    C¹-transport interface for an eventual inverse-branch argument. -/
theorem exists_uniform_scaled_derivative_difference_on_segment
    (p : ℂ[X]) (n : ℕ) (q r a : ℂ) (hn : 2 ≤ n) :
    ∀ ε : ℝ, 0 < ε → ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ∀ z ∈ segment ℝ r a,
        ‖(raisePolynomial p (L : ℂ) (raiseParameter n q (L : ℂ))).derivative.eval z /
            (L : ℂ) ^ 2 - p.derivative.eval z‖ < ε := by
  intro ε hε
  obtain ⟨R, A, hR, hA⟩ := exists_segment_eval_bounds p r a
  obtain ⟨A₁, hA₁⟩ := exists_norm_bound_on_segment p.derivative.continuous
    (r := r) (a := a)
  have hRdiv : Tendsto (fun L : ℝ => R / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => R / L) atTop (𝓝 0))
  have hRdiv2 : Tendsto (fun L : ℝ => (R / L) ^ 2) atTop (𝓝 0) := by
    simpa using hRdiv.pow 2
  have hpow : Tendsto (fun L : ℝ => L ^ n) atTop atTop :=
    tendsto_pow_atTop (show n ≠ 0 by omega)
  have hqdiv : Tendsto (fun L : ℝ => ‖q‖ / L ^ n) atTop (𝓝 0) := by
    exact tendsto_const_nhds.div_atTop hpow
  have hL2 : Tendsto (fun L : ℝ => L ^ 2) atTop atTop :=
    tendsto_pow_atTop (show (2 : ℕ) ≠ 0 by omega)
  have hRquad : Tendsto (fun L : ℝ => R / L ^ 2) atTop (𝓝 0) := by
    exact tendsto_const_nhds.div_atTop hL2
  have hlin : Tendsto (fun L : ℝ => (2 : ℝ) * A / L) atTop (𝓝 0) := by
    simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using
      (tendsto_const_nhds.div_atTop tendsto_id :
        Tendsto (fun L : ℝ => (2 : ℝ) * A / L) atTop (𝓝 0))
  have hquad : Tendsto (fun L : ℝ => (2 : ℝ) * A * R / L ^ 2)
      atTop (𝓝 0) := by
    simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using
      (tendsto_const_nhds.div_atTop hL2 :
        Tendsto (fun L : ℝ => (2 : ℝ) * A * R / L ^ 2) atTop (𝓝 0))
  have hinner : Tendsto (fun L : ℝ =>
      2 * (R / L) + (R / L) ^ 2 + ‖q‖ / L ^ n) atTop (𝓝 0) := by
    simpa [add_assoc] using (hRdiv.const_mul 2).add (hRdiv2.add hqdiv)
  have hfirst : Tendsto (fun L : ℝ =>
      A₁ * (2 * (R / L) + (R / L) ^ 2 + ‖q‖ / L ^ n)) atTop (𝓝 0) := by
    simpa using hinner.const_mul A₁
  have hsum : Tendsto (fun L : ℝ =>
      A₁ * (2 * (R / L) + (R / L) ^ 2 + ‖q‖ / L ^ n) +
        2 * A / L + 2 * A * R / L ^ 2) atTop (𝓝 0) := by
    simpa [add_assoc] using (hfirst.add hlin).add hquad
  obtain ⟨L₀, hL₀⟩ := eventually_atTop.1 (hsum.eventually_lt_const hε)
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL z hz
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hLpos)
    have hLnorm : L = ‖(L : ℂ)‖ := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
    have hbound := raisePolynomial_scaled_derivative_difference_norm_le_on_segment
      p n q (L : ℂ) r a R A A₁ ‖q‖ L hn hLne hR hA hA₁ le_rfl hLpos hLnorm.le
    exact lt_of_le_of_lt (hbound z hz)
      (hL₀ L (le_trans (le_max_left _ _) hL))

theorem exists_uniform_scaled_derivative_difference_on_two_segments
    (p : ℂ[X]) (n : ℕ) (q r a b : ℂ) (hn : 2 ≤ n) :
    ∀ ε : ℝ, 0 < ε → ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      (∀ z ∈ segment ℝ r a,
        ‖(raisePolynomial p (L : ℂ) (raiseParameter n q (L : ℂ))).derivative.eval z /
            (L : ℂ) ^ 2 - p.derivative.eval z‖ < ε) ∧
      (∀ z ∈ segment ℝ r b,
        ‖(raisePolynomial p (L : ℂ) (raiseParameter n q (L : ℂ))).derivative.eval z /
            (L : ℂ) ^ 2 - p.derivative.eval z‖ < ε) := by
  intro ε hε
  obtain ⟨La, hLa, ha⟩ := exists_uniform_scaled_derivative_difference_on_segment
    p n q r a hn ε hε
  obtain ⟨Lb, hLb, hb⟩ := exists_uniform_scaled_derivative_difference_on_segment
    p n q r b hn ε hε
  let L₀ : ℝ := max La Lb
  refine ⟨L₀, ?_, ?_⟩
  · exact lt_of_lt_of_le hLa (le_max_left _ _)
  · intro L hL
    constructor
    · exact ha L (le_trans (le_max_left _ _) hL)
    · exact hb L (le_trans (le_max_right _ _) hL)

/-! Uniform version on a compact segment.  The scale is chosen first, and
    then the same bound applies to every point of the segment.  This is the
    precise compact-uniform estimate needed before invoking Rouché on old
    inverse branches. -/
theorem exists_uniform_scaled_difference_on_segment
    (p : ℂ[X]) (n : ℕ) (q r a : ℂ) (hn : 2 ≤ n) :
    ∀ ε : ℝ, 0 < ε → ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ∀ z ∈ segment ℝ r a,
        ‖(raisePolynomial p (L : ℂ) (raiseParameter n q (L : ℂ))).eval z /
            (L : ℂ) ^ 2 - p.eval z‖ < ε := by
  intro ε hε
  obtain ⟨R, A, hR, hA⟩ := exists_segment_eval_bounds p r a
  have hRdiv : Tendsto (fun L : ℝ => R / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => R / L) atTop (𝓝 0))
  have hRdiv2 : Tendsto (fun L : ℝ => (R / L) ^ 2) atTop (𝓝 0) := by
    simpa using hRdiv.pow 2
  have hpow : Tendsto (fun L : ℝ => L ^ n) atTop atTop :=
    tendsto_pow_atTop (show n ≠ 0 by omega)
  have hqdiv : Tendsto (fun L : ℝ => ‖q‖ / L ^ n) atTop (𝓝 0) := by
    exact tendsto_const_nhds.div_atTop hpow
  have hsum : Tendsto (fun L : ℝ =>
      A * (2 * (R / L) + (R / L) ^ 2 + ‖q‖ / L ^ n)) atTop (𝓝 0) := by
    have hadd : Tendsto (fun L : ℝ =>
        2 * (R / L) + (R / L) ^ 2 + ‖q‖ / L ^ n) atTop (𝓝 0) := by
      simpa [add_assoc] using (hRdiv.const_mul 2).add (hRdiv2.add hqdiv)
    simpa using hadd.const_mul A
  obtain ⟨L₀, hL₀⟩ := eventually_atTop.1 (hsum.eventually_lt_const hε)
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL z hz
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hLpos)
    have hLnorm : L = ‖(L : ℂ)‖ := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
    have hbound := raisePolynomial_scaled_difference_norm_le_on_segment
      p n q (L : ℂ) r a R A ‖q‖ L hn hLne hR hA le_rfl hLpos hLnorm.le
    exact lt_of_le_of_lt (hbound z hz)
      (hL₀ L (le_trans (le_max_left _ _) hL))

/-! The same value estimate is uniform on an arbitrary compact set.  This is
    the form needed for metric/Urysohn separators whose zero set is compact,
    rather than a finite union of prescribed line segments. -/
theorem exists_uniform_scaled_difference_on_compact
    (p : ℂ[X]) (n : ℕ) (q : ℂ) (K : Set ℂ) (hK : IsCompact K)
    (hn : 2 ≤ n) :
    ∀ ε : ℝ, 0 < ε → ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ∀ z ∈ K,
        ‖(raisePolynomial p (L : ℂ) (raiseParameter n q (L : ℂ))).eval z /
            (L : ℂ) ^ 2 - p.eval z‖ < ε := by
  intro ε hε
  obtain ⟨R, hR⟩ := hK.exists_bound_of_continuousOn
    (continuous_id : Continuous (fun z : ℂ => z)).continuousOn
  obtain ⟨A, hA⟩ := hK.exists_bound_of_continuousOn p.continuous.continuousOn
  have hRdiv : Tendsto (fun L : ℝ => R / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => R / L) atTop (𝓝 0))
  have hRdiv2 : Tendsto (fun L : ℝ => (R / L) ^ 2) atTop (𝓝 0) := by
    simpa using hRdiv.pow 2
  have hpow : Tendsto (fun L : ℝ => L ^ n) atTop atTop :=
    tendsto_pow_atTop (show n ≠ 0 by omega)
  have hqdiv : Tendsto (fun L : ℝ => ‖q‖ / L ^ n) atTop (𝓝 0) := by
    exact tendsto_const_nhds.div_atTop hpow
  have hsum : Tendsto (fun L : ℝ =>
      A * (2 * (R / L) + (R / L) ^ 2 + ‖q‖ / L ^ n)) atTop (𝓝 0) := by
    have hadd : Tendsto (fun L : ℝ =>
        2 * (R / L) + (R / L) ^ 2 + ‖q‖ / L ^ n) atTop (𝓝 0) := by
      simpa [add_assoc] using (hRdiv.const_mul 2).add (hRdiv2.add hqdiv)
    simpa using hadd.const_mul A
  obtain ⟨L₀, hL₀⟩ := eventually_atTop.1 (hsum.eventually_lt_const hε)
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL z hz
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hLpos)
    have hLnorm : L = ‖(L : ℂ)‖ := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
    have hbound := raisePolynomial_scaled_difference_norm_le_of_bounds
      p n q (L : ℂ) z K R A ‖q‖ L hn hLne hR hA le_rfl hLpos hLnorm.le hz
    exact lt_of_le_of_lt (hbound)
      (hL₀ L (le_trans (le_max_left _ _) hL))

theorem exists_pos_norm_margin_on_compact
    {F : ℂ → ℂ} {c : ℝ} {K : Set ℂ}
    (hF : Continuous F) (hK : IsCompact K)
    (hstrict : ∀ z ∈ K, c < ‖F z‖) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ z ∈ K, c + ε ≤ ‖F z‖ := by
  have hcontinuous : Continuous (fun z ↦ ‖F z‖ - c) := by fun_prop
  obtain ⟨ε, hε, hmargin⟩ := hK.exists_forall_le'
    (a := 0) hcontinuous.continuousOn (by
      intro z hz
      have h := hstrict z hz
      linarith)
  exact ⟨ε, hε, fun z hz ↦ by have := hmargin z hz; linarith⟩

/-! A compact positive margin survives a uniformly smaller perturbation. -/
theorem norm_gt_of_uniform_close_of_margin
    {F G : ℂ → ℂ} {c ε : ℝ} {K : Set ℂ}
    (hmargin : ∀ z ∈ K, c + ε ≤ ‖F z‖)
    (hclose : ∀ z ∈ K, ‖G z - F z‖ < ε) :
    ∀ z ∈ K, c < ‖G z‖ := by
  intro z hz
  have htri : ‖F z‖ ≤ ‖G z‖ + ‖G z - F z‖ := by
    calc
      ‖F z‖ = ‖G z - (G z - F z)‖ := by congr 1 <;> ring
      _ ≤ ‖G z‖ + ‖G z - F z‖ := norm_sub_le _ _
  have hm := hmargin z hz
  have hd := hclose z hz
  linarith

theorem exists_large_scale_bound
    {n : ℕ} (hn : 2 ≤ n) {R A B eps : ℝ}
    (hR : 0 ≤ R) (hA : 0 ≤ A) (hB : 0 ≤ B) (heps : 0 < eps) :
    ∃ L₀ : ℝ, ∀ L : ℝ, L₀ ≤ L →
      A * (2 * (R / L) + (R / L) ^ 2 + B / L ^ n) < eps := by
  have hL : Tendsto (fun L : ℝ => L) atTop atTop := tendsto_id
  have hRdiv : Tendsto (fun L : ℝ => R / L) atTop (𝓝 0) :=
    (tendsto_const_nhds : Tendsto (fun _ : ℝ => R) atTop (𝓝 R)).div_atTop hL
  have hRdiv2 : Tendsto (fun L : ℝ => (R / L) ^ 2) atTop (𝓝 0) := by
    simpa using hRdiv.pow 2
  have hpow : Tendsto (fun L : ℝ => L ^ n) atTop atTop :=
    tendsto_pow_atTop (by omega)
  have hBdiv : Tendsto (fun L : ℝ => B / L ^ n) atTop (𝓝 0) :=
    (tendsto_const_nhds : Tendsto (fun _ : ℝ => B) atTop (𝓝 B)).div_atTop hpow
  have hsum : Tendsto
      (fun L : ℝ => 2 * (R / L) + (R / L) ^ 2 + B / L ^ n) atTop (𝓝 0) := by
    have hfirst := hRdiv.const_mul 2
    have hrest := hRdiv2.add hBdiv
    have hadd := hfirst.add hrest
    simpa [add_assoc] using hadd
  have hlim : Tendsto
      (fun L : ℝ => A * (2 * (R / L) + (R / L) ^ 2 + B / L ^ n)) atTop (𝓝 0) := by
    simpa using hsum.const_mul A
  rcases eventually_atTop.1 (hlim.eventually_lt_const heps) with ⟨L₀, hL₀⟩
  exact ⟨L₀, hL₀⟩

theorem exists_pos_large_scale_bound
    {n : ℕ} (hn : 2 ≤ n) {R A B eps : ℝ}
    (hR : 0 ≤ R) (hA : 0 ≤ A) (hB : 0 ≤ B) (heps : 0 < eps) :
    ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      A * (2 * (R / L) + (R / L) ^ 2 + B / L ^ n) < eps := by
  obtain ⟨L₀, hL₀⟩ := exists_large_scale_bound hn hR hA hB heps
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL
    exact hL₀ L (le_trans (le_max_left _ _) hL)

theorem exists_real_complex_scale_bound
    {n : ℕ} (hn : 2 ≤ n) {R A B eps : ℝ}
    (hR : 0 ≤ R) (hA : 0 ≤ A) (hB : 0 ≤ B) (heps : 0 < eps) :
    ∃ L : ℂ, L ≠ 0 ∧ 0 < L.re ∧
      A * (2 * (R / L.re) + (R / L.re) ^ 2 + B / L.re ^ n) < eps ∧
      L.re = ‖L‖ := by
  obtain ⟨L₀, hL₀pos, hL₀⟩ := exists_pos_large_scale_bound hn hR hA hB heps
  let L : ℂ := L₀
  refine ⟨L, ?_, ?_, ?_, ?_⟩
  · dsimp [L]
    exact_mod_cast ne_of_gt hL₀pos
  · dsimp [L]
    exact hL₀pos
  · dsimp [L]
    simpa using hL₀ L₀ (le_refl _)
  · dsimp [L]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL₀pos]

theorem raisePolynomial_scaled_difference_norm_le_on_two_segments
    (p : ℂ[X]) (n : ℕ) (q L r a b : ℂ)
    (R A B ell : ℝ) (hn : 2 ≤ n) (hL : L ≠ 0)
    (hRₐ : ∀ z ∈ segment ℝ r a, ‖z‖ ≤ R)
    (hAₐ : ∀ z ∈ segment ℝ r a, ‖p.eval z‖ ≤ A)
    (hRᵦ : ∀ z ∈ segment ℝ r b, ‖z‖ ≤ R)
    (hAᵦ : ∀ z ∈ segment ℝ r b, ‖p.eval z‖ ≤ A)
    (hB : ‖q‖ ≤ B) (hell : 0 < ell) (hLell : ell ≤ ‖L‖) :
    (∀ z ∈ segment ℝ r a,
      ‖(raisePolynomial p L (raiseParameter n q L)).eval z / L ^ 2 - p.eval z‖ ≤
        A * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n)) ∧
    (∀ z ∈ segment ℝ r b,
      ‖(raisePolynomial p L (raiseParameter n q L)).eval z / L ^ 2 - p.eval z‖ ≤
        A * (2 * (R / ell) + (R / ell) ^ 2 + B / ell ^ n)) := by
  constructor
  · exact raisePolynomial_scaled_difference_norm_le_on_segment p n q L r a
      R A B ell hn hL hRₐ hAₐ hB hell hLell
  · exact raisePolynomial_scaled_difference_norm_le_on_segment p n q L r b
      R A B ell hn hL hRᵦ hAᵦ hB hell hLell

theorem raiseFactor_root_iff (L d z : ℂ) :
    (raiseFactor L d).eval z = 0 ↔ (z - L) ^ 2 = -d := by
  rw [raiseFactor_eval]
  constructor <;> intro h
  · linear_combination h
  · linear_combination h

theorem raiseFactor_eval_center_add_mul_I (L e : ℂ) :
    (raiseFactor L (e ^ 2)).eval (L + e * Complex.I) = 0 := by
  rw [raiseFactor_eval]
  ring_nf
  rw [Complex.I_sq]
  ring

theorem raiseFactor_eval_center_sub_mul_I (L e : ℂ) :
    (raiseFactor L (e ^ 2)).eval (L - e * Complex.I) = 0 := by
  rw [raiseFactor_eval]
  ring_nf
  rw [Complex.I_sq]
  ring

theorem raiseFactor_rootSet_eq_two (L e : ℂ) (he : e ≠ 0) :
    (raiseFactor L (e ^ 2)).rootSet ℂ =
      ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) := by
  ext z
  constructor
  · intro hz
    have hz0 : (raiseFactor L (e ^ 2)).eval z = 0 :=
      (raiseFactor_monic L (e ^ 2)).mem_rootSet.mp hz
    have hsq : (z - L) ^ 2 = (e * Complex.I) ^ 2 := by
      have hsq' : (z - L) ^ 2 = -(e ^ 2) :=
        (raiseFactor_root_iff L (e ^ 2) z).mp hz0
      calc
        (z - L) ^ 2 = -(e ^ 2) := hsq'
        _ = (e * Complex.I) ^ 2 := by
          rw [mul_pow, Complex.I_sq]
          ring
    rcases eq_or_eq_neg_of_sq_eq_sq (z - L) (e * Complex.I) hsq with h | h
    · left
      linear_combination h
    · have h' : z = L - e * Complex.I := by
        linear_combination h
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using
        (Or.inr h' : z = L + e * Complex.I ∨ z = L - e * Complex.I)
  · intro hz
    have hz' : z = L + e * Complex.I ∨ z = L - e * Complex.I := by
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hz
    rcases hz' with hz | hz
    · subst z
      apply (raiseFactor_monic L (e ^ 2)).mem_rootSet.mpr
      have heval : (raiseFactor L (e ^ 2)).eval (L + e * Complex.I) = 0 := by
        rw [raiseFactor_eval]
        ring_nf
        rw [Complex.I_sq]
        ring
      simpa [aeval_def] using heval
    · subst z
      apply (raiseFactor_monic L (e ^ 2)).mem_rootSet.mpr
      have heval : (raiseFactor L (e ^ 2)).eval (L - e * Complex.I) = 0 := by
        rw [raiseFactor_eval]
        ring_nf
        rw [Complex.I_sq]
        ring
      simpa [aeval_def] using heval

theorem raiseFactor_rootSet_ncard_eq_two (L e : ℂ) (he : e ≠ 0) :
    ((raiseFactor L (e ^ 2)).rootSet ℂ).ncard = 2 := by
  rw [raiseFactor_rootSet_eq_two L e he]
  have hne : L + e * Complex.I ≠ L - e * Complex.I := by
    intro h
    have hzero : (2 : ℂ) * e * Complex.I = 0 := by
      linear_combination h
    have hzero' : e * Complex.I = 0 := by
      apply mul_left_cancel₀ (show (2 : ℂ) ≠ 0 by norm_num)
      simpa [mul_assoc] using hzero
    rcases mul_eq_zero.mp hzero' with he' | hI
    · exact he he'
    · exact Complex.I_ne_zero hI
  simp [hne]

/- The product root set splits into the old roots and the two new factor roots.
   This set identity does not yet assert disjointness; disjointness is supplied
   separately by the coprimality hypothesis in the separability/root-count
   theorem above.  Keeping the identity unconditional makes it usable for the
   later component-preservation argument. -/
theorem raisePolynomial_rootSet_eq_union
    (p : ℂ[X]) (L e : ℂ) (hp : p.Monic) (he : e ≠ 0) :
    (raisePolynomial p L (e ^ 2)).rootSet ℂ =
      p.rootSet ℂ ∪ ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) := by
  ext z
  constructor
  · intro hz
    have hz0 : (raisePolynomial p L (e ^ 2)).eval z = 0 :=
      (raisePolynomial_monic p L (e ^ 2) hp).mem_rootSet.mp hz
    rw [raisePolynomial_eval] at hz0
    rcases mul_eq_zero.mp hz0 with hpz | hqz
    · exact Or.inl (hp.mem_rootSet.mpr hpz)
    · right
      have hqroot : z ∈ (raiseFactor L (e ^ 2)).rootSet ℂ := by
        apply (raiseFactor_monic L (e ^ 2)).mem_rootSet.mpr
        simpa [raiseFactor_eval] using hqz
      rw [raiseFactor_rootSet_eq_two L e he] at hqroot
      exact hqroot
  · intro hz
    rcases hz with hpz | hqz
    · apply (raisePolynomial_monic p L (e ^ 2) hp).mem_rootSet.mpr
      have heval : (raisePolynomial p L (e ^ 2)).eval z = 0 := by
        rw [raisePolynomial_eval]
        exact mul_eq_zero.mpr (Or.inl (hp.mem_rootSet.mp hpz))
      simpa [aeval_def] using heval
    · apply (raisePolynomial_monic p L (e ^ 2) hp).mem_rootSet.mpr
      have hqroot : z ∈ (raiseFactor L (e ^ 2)).rootSet ℂ := by
        rw [raiseFactor_rootSet_eq_two L e he]
        exact hqz
      have heval : (raisePolynomial p L (e ^ 2)).eval z = 0 := by
        rw [raisePolynomial_eval]
        have hqeval : (raiseFactor L (e ^ 2)).eval z = 0 := by
          simpa [aeval_def] using
            ((raiseFactor_monic L (e ^ 2)).mem_rootSet.mp hqroot)
        exact mul_eq_zero.mpr (Or.inr
          (by simpa [raiseFactor_eval] using hqeval))
      simpa [aeval_def] using heval

/-! Coprimality is stronger than the root-count statement: it gives the
    explicit disjointness needed when an old component family is combined
    with the two new roots.  We keep this as a set-level lemma so later
    component arguments do not have to reopen the polynomial gcd proof. -/
theorem raisePolynomial_old_new_rootSet_disjoint
    (p : ℂ[X]) (L e : ℂ) (hp : p.Monic) (he : e ≠ 0)
    (hcop : IsCoprime p (raiseFactor L (e ^ 2))) :
    Disjoint (↑(p.rootSet ℂ) : Set ℂ)
      ({L + e * Complex.I, L - e * Complex.I} : Set ℂ) := by
  rw [Set.disjoint_left]
  intro z hzold hznew
  have hzold' : p.eval z = 0 := hp.mem_rootSet.mp hzold
  have hzfactor : (raiseFactor L (e ^ 2)).eval z = 0 := by
    have hznew' : z = L + e * Complex.I ∨ z = L - e * Complex.I := by
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hznew
    rcases hznew' with rfl | rfl
    · exact raiseFactor_eval_center_add_mul_I L e
    · exact raiseFactor_eval_center_sub_mul_I L e
  have hne : p.eval z ≠ 0 ∨ (raiseFactor L (e ^ 2)).eval z ≠ 0 := by
    have hne' := (Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed
      (k := ℂ) ℂ p (raiseFactor L (e ^ 2))).mp hcop z
    simpa [aeval_def] using hne'
  have hnot : ¬p.eval z ≠ 0 := by
    intro h
    exact h hzold'
  exact (hne.resolve_left hnot) hzfactor

theorem raisePolynomial_rootSet_union_ncard
    (p : ℂ[X]) (L e : ℂ) (hp : p.Monic) (hpsep : p.Separable)
    (he : e ≠ 0) (hcop : IsCoprime p (raiseFactor L (e ^ 2))) :
    ((↑(p.rootSet ℂ) : Set ℂ) ∪
      ({L + e * Complex.I, L - e * Complex.I} : Set ℂ)).ncard =
      p.natDegree + 2 := by
  rw [← raisePolynomial_rootSet_eq_union p L e hp he]
  exact raisePolynomial_rootSet_ncard p L (e ^ 2) hp hpsep
    (pow_ne_zero 2 he) hcop

theorem raisePolynomial_root_of_original_root
    (p : ℂ[X]) (L e z : ℂ) (hp : p.Monic)
    (hz : z ∈ p.rootSet ℂ) :
    (raisePolynomial p L (e ^ 2)).eval z = 0 := by
  rw [raisePolynomial_eval]
  exact mul_eq_zero.mpr (Or.inl (hp.mem_rootSet.mp hz))

theorem raisePolynomial_root_of_factor_root
    (p : ℂ[X]) (L d z : ℂ)
    (hz : (raiseFactor L d).eval z = 0) :
    (raisePolynomial p L d).eval z = 0 := by
  have hz' : (z - L) ^ 2 + d = 0 := by
    simpa [raiseFactor_eval] using hz
  rw [raisePolynomial_eval, hz', mul_zero]

/-! A finite-avoidance lemma for the degree-raising center.  The bad centers
are the two translates of the old root set by `± e * I`; choosing outside this
finite set guarantees that the new quadratic factor has no common root with
the old polynomial. -/
theorem exists_center_avoiding_rootSet
    (p : ℂ[X]) (e : ℂ) (he : e ≠ 0) :
    ∃ L : ℂ, ∀ z ∈ p.rootSet ℂ, (z - L) ^ 2 + e ^ 2 ≠ 0 := by
  let bad : Set ℂ :=
    (fun z : ℂ => z + e * Complex.I) '' (↑(p.rootSet ℂ) : Set ℂ) ∪
      (fun z : ℂ => z - e * Complex.I) '' (↑(p.rootSet ℂ) : Set ℂ)
  have hbad : bad.Finite := by
    dsimp [bad]
    exact (p.rootSet_finite ℂ).image _ |>.union ((p.rootSet_finite ℂ).image _)
  obtain ⟨L, hL⟩ := hbad.exists_notMem
  refine ⟨L, ?_⟩
  intro z hz hzero
  have hsq : (z - L) ^ 2 = (e * Complex.I) ^ 2 := by
    calc
      (z - L) ^ 2 = -(e ^ 2) := by linear_combination hzero
      _ = (e * Complex.I) ^ 2 := by
        rw [mul_pow, Complex.I_sq]
        ring
  rcases eq_or_eq_neg_of_sq_eq_sq (z - L) (e * Complex.I) hsq with h | h
  · apply hL
    right
    refine ⟨z, hz, ?_⟩
    linear_combination h
  · apply hL
    left
    refine ⟨z, hz, ?_⟩
    linear_combination h

/-! The finite-avoidance argument can be combined with the asymptotic scale
bound without losing the useful choice of a positive real center.  This is
the form needed by the later geometric degree-raising construction: a large
real center is chosen above all forbidden centers, so the quadratic factor is
coprime to the old polynomial and the uniform perturbation estimate still
holds. -/
theorem exists_large_real_center_avoiding_rootSet
    (p : ℂ[X]) (e : ℂ) (he : e ≠ 0)
    {n : ℕ} (hn : 2 ≤ n) {R A B eps : ℝ}
    (hR : 0 ≤ R) (hA : 0 ≤ A) (hB : ‖e ^ 2‖ ≤ B) (heps : 0 < eps) :
    ∃ L : ℂ, L ≠ 0 ∧ 0 < L.re ∧ L.re = ‖L‖ ∧
      A * (2 * (R / L.re) + (R / L.re) ^ 2 + B / L.re ^ n) < eps ∧
      ∀ z ∈ p.rootSet ℂ, (z - L) ^ 2 + e ^ 2 ≠ 0 := by
  have hB0 : 0 ≤ B := (norm_nonneg (e ^ 2)).trans hB
  obtain ⟨L₀, hL₀pos, hL₀⟩ :=
    exists_pos_large_scale_bound hn hR hA hB0 heps
  let bad : Set ℂ :=
    (fun z : ℂ => z + e * Complex.I) '' (↑(p.rootSet ℂ) : Set ℂ) ∪
      (fun z : ℂ => z - e * Complex.I) '' (↑(p.rootSet ℂ) : Set ℂ)
  have hbad : bad.Finite := by
    dsimp [bad]
    exact (p.rootSet_finite ℂ).image _ |>.union ((p.rootSet_finite ℂ).image _)
  let badRe : Set ℝ := (fun z : ℂ => z.re) '' bad
  have hbadRe : badRe.Finite := hbad.image _
  rcases hbadRe.bddAbove with ⟨U, hU⟩
  obtain ⟨N, hN⟩ := exists_nat_gt (max L₀ (max U 0))
  let Lr : ℝ := N
  let L : ℂ := Lr
  have hLN : max L₀ (max U 0) < Lr := by
    simpa [Lr] using hN
  have hLpos : 0 < Lr := by
    have hzero : (0 : ℝ) ≤ max L₀ (max U 0) :=
      le_trans (le_max_right U 0) (le_max_right L₀ (max U 0))
    exact lt_of_le_of_lt hzero hLN
  have hLlarge : L₀ ≤ Lr := le_trans (le_max_left L₀ (max U 0)) hLN.le
  have hLnotbad : L ∉ bad := by
    intro hLbad
    have hLbadRe : Lr ∈ badRe := ⟨L, hLbad, by rfl⟩
    have hupper : Lr ≤ U := hU hLbadRe
    have hUmax : U ≤ max L₀ (max U 0) :=
      le_trans (le_max_left U 0) (le_max_right L₀ (max U 0))
    linarith [hLN, hupper, hUmax]
  refine ⟨L, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp [L]
    exact_mod_cast (ne_of_gt hLpos)
  · dsimp [L]
    exact hLpos
  · dsimp [L]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
  · dsimp [L]
    exact hL₀ Lr hLlarge
  · intro z hz hzero
    have hsq : (z - L) ^ 2 = (e * Complex.I) ^ 2 := by
      calc
        (z - L) ^ 2 = -(e ^ 2) := by linear_combination hzero
        _ = (e * Complex.I) ^ 2 := by
          rw [mul_pow, Complex.I_sq]
          ring
    rcases eq_or_eq_neg_of_sq_eq_sq (z - L) (e * Complex.I) hsq with h | h
    · apply hLnotbad
      right
      refine ⟨z, hz, ?_⟩
      linear_combination h
    · apply hLnotbad
      left
      refine ⟨z, hz, ?_⟩
      linear_combination h

theorem exists_raise_center_with_root_count
    (p : ℂ[X]) (e : ℂ) (hp : p.Monic) (hpsep : p.Separable) (he : e ≠ 0) :
    ∃ L : ℂ,
      ((raisePolynomial p L (e ^ 2)).rootSet ℂ).ncard =
        (p.rootSet ℂ).ncard + 2 := by
  obtain ⟨L, hL⟩ := exists_center_avoiding_rootSet p e he
  have hcop : IsCoprime p (raiseFactor L (e ^ 2)) :=
    raiseFactor_coprime_of_no_common_root p L (e ^ 2) (by
      intro z hz hfactor
      exact hL z (hp.mem_rootSet.mpr hz) hfactor)
  exact ⟨L, raisePolynomial_rootSet_ncard_eq_add_two p L (e ^ 2)
    hp hpsep (pow_ne_zero 2 he) hcop⟩

/-! A monic polynomial admits a useful explicit lower bound on any coordinate
    line.  Factorising into the multiset of complex roots, each factor on
    `Re z = a` has norm at least the absolute horizontal distance from that
    root.  The analogous statement for horizontal lines is obtained by
    swapping `re` and `im` in the caller.  This avoids an analytic minimum-
    modulus argument and is therefore particularly suitable for the finite
    separator tables in the degree-raising proof. -/
theorem monic_eval_norm_ge_prod_root_real_distance
    (p : ℂ[X]) (hp : p.Monic) (a y : ℝ) :
    (p.roots.map (fun r => |a - r.re|)).prod ≤
      ‖p.eval ((a : ℂ) + (y : ℂ) * Complex.I)‖ := by
  rw [(IsAlgClosed.splits p).eval_eq_prod_roots_of_monic hp]
  have hnorm : ∀ s : Multiset ℂ, ‖s.prod‖ = (s.map norm).prod := by
    intro s
    induction s using Multiset.induction_on with
    | empty => simp
    | @cons x s ih => simp [ih]
  rw [hnorm]
  simp only [Multiset.map_map]
  have hfactor :
      ∀ r : ℂ, |a - r.re| ≤ ‖(a : ℂ) + (y : ℂ) * Complex.I - r‖ := by
    intro r
    rw [Complex.norm_def]
    have him : (((a : ℂ) + (y : ℂ) * Complex.I - r).im) ^ 2 ≥ 0 :=
      sq_nonneg _
    rw [Real.le_sqrt (abs_nonneg _) (Complex.normSq_nonneg _)]
    rw [sq_abs]
    norm_num [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
      Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im]
    nlinarith
  have hprod : ∀ s : Multiset ℂ,
      (s.map (fun r => |a - r.re|)).prod ≤
        (s.map (fun r => ‖(a : ℂ) + (y : ℂ) * Complex.I - r‖)).prod := by
    intro s
    induction s using Multiset.induction_on with
    | empty => simp
    | @cons r s ih =>
      simp only [Multiset.map_cons, Multiset.prod_cons]
      have htail : 0 ≤ (s.map (fun r => |a - r.re|)).prod :=
        Multiset.prod_nonneg (by
          intro x hx
          rcases Multiset.mem_map.1 hx with ⟨r, hr, rfl⟩
          exact abs_nonneg _)
      exact mul_le_mul (hfactor r) ih htail (norm_nonneg _)
  exact hprod p.roots

theorem monic_root_distance_prod_pos_of_line_avoids_roots
    (p : ℂ[X]) (a : ℝ)
    (hroot : ∀ r ∈ p.roots, r.re ≠ a) :
    0 < (p.roots.map (fun r => |a - r.re|)).prod := by
  apply Multiset.prod_pos
  intro x hx
  rcases Multiset.mem_map.1 hx with ⟨r, hr, rfl⟩
  exact abs_pos.mpr (sub_ne_zero.mpr (Ne.symm (hroot r hr)))

theorem monic_root_im_distance_prod_pos_of_line_avoids_roots
    (p : ℂ[X]) (a : ℝ)
    (hroot : ∀ r ∈ p.roots, r.im ≠ a) :
    0 < (p.roots.map (fun r => |a - r.im|)).prod := by
  apply Multiset.prod_pos
  intro x hx
  rcases Multiset.mem_map.1 hx with ⟨r, hr, rfl⟩
  exact abs_pos.mpr (sub_ne_zero.mpr (Ne.symm (hroot r hr)))

theorem monic_eval_norm_gt_of_root_distance
    (p : ℂ[X]) (hp : p.Monic) (a c : ℝ)
    (hroot : ∀ r ∈ p.roots, r.re ≠ a)
    (hc : c < (p.roots.map (fun r => |a - r.re|)).prod) :
    ∀ y : ℝ, c < ‖p.eval ((a : ℂ) + (y : ℂ) * Complex.I)‖ := by
  intro y
  exact lt_of_lt_of_le hc (monic_eval_norm_ge_prod_root_real_distance p hp a y)

theorem monic_eval_norm_ge_prod_root_im_distance
    (p : ℂ[X]) (hp : p.Monic) (x a : ℝ) :
    (p.roots.map (fun r => |a - r.im|)).prod ≤
      ‖p.eval ((x : ℂ) + (a : ℂ) * Complex.I)‖ := by
  rw [(IsAlgClosed.splits p).eval_eq_prod_roots_of_monic hp]
  have hnorm : ∀ s : Multiset ℂ, ‖s.prod‖ = (s.map norm).prod := by
    intro s
    induction s using Multiset.induction_on with
    | empty => simp
    | @cons y s ih => simp [ih]
  rw [hnorm]
  simp only [Multiset.map_map]
  have hfactor :
      ∀ r : ℂ, |a - r.im| ≤ ‖(x : ℂ) + (a : ℂ) * Complex.I - r‖ := by
    intro r
    rw [Complex.norm_def]
    have hre : (((x : ℂ) + (a : ℂ) * Complex.I - r).re) ^ 2 ≥ 0 :=
      sq_nonneg _
    rw [Real.le_sqrt (abs_nonneg _) (Complex.normSq_nonneg _)]
    rw [sq_abs]
    norm_num [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
      Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im]
    nlinarith
  have hprod : ∀ s : Multiset ℂ,
      (s.map (fun r => |a - r.im|)).prod ≤
        (s.map (fun r => ‖(x : ℂ) + (a : ℂ) * Complex.I - r‖)).prod := by
    intro s
    induction s using Multiset.induction_on with
    | empty => simp
    | @cons r s ih =>
      simp only [Multiset.map_cons, Multiset.prod_cons]
      have htail : 0 ≤ (s.map (fun r => |a - r.im|)).prod :=
        Multiset.prod_nonneg (by
          intro y hy
          rcases Multiset.mem_map.1 hy with ⟨r, hr, rfl⟩
          exact abs_nonneg _)
      exact mul_le_mul (hfactor r) ih htail (norm_nonneg _)
  exact hprod p.roots

theorem monic_eval_norm_gt_of_root_im_distance
    (p : ℂ[X]) (hp : p.Monic) (a c : ℝ)
    (hroot : ∀ r ∈ p.roots, r.im ≠ a)
    (hc : c < (p.roots.map (fun r => |a - r.im|)).prod) :
    ∀ x : ℝ, c < ‖p.eval ((x : ℂ) + (a : ℂ) * Complex.I)‖ := by
  intro x
  exact lt_of_lt_of_le hc (monic_eval_norm_ge_prod_root_im_distance p hp x a)

