checking that the displayed points are critical. -/
theorem p5_derivative_eval_zero_iff (z : ℂ) :
    p5Polynomial.derivative.eval z = 0 ↔
      z = 0 ∨ z = 1 ∨ z = p5SPlus ∨ z = p5SMinus := by
  rw [p5Polynomial_derivative]
  simp only [eval_mul, eval_C, eval_X, eval_sub, eval_one, eval_add, eval_pow]
  rw [show z ^ 2 + (5 / 2 : ℂ) * z + 29 / 16 =
      (z - p5SPlus) * (z - p5SMinus) by
    dsimp [p5SPlus, p5SMinus]
    ring_nf
    rw [Complex.I_sq]
    ring]
  simp only [mul_eq_zero]
  norm_num
  simp only [sub_eq_zero]
  tauto

