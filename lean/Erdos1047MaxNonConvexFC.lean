section


/-!
# Quartic gadget for degree raising in Erdős #1047

The quadratic degree-raising factor has a genuinely analytic new-branch
obligation: an isolated quadratic lemniscate does not provide two non-convex
components.  This file records an algebraic alternative based on the already
checked quartic gadget

`((z^2 - s^2)^2 + s^4)`,

which is a translate/scale of `p₄(w)=(w²-1)²+1`.  The geometric transport of
the four non-convex certificates is deliberately not asserted here; this core
only supplies monicity, degree, separability, the four roots, and the product
bookkeeping needed by a future `n → n+4` step.
-/

open Polynomial
open Filter
open Topology

namespace Erdos1047QuarticRaise

noncomputable section

/-- A translated and scaled copy of the quartic `p₄` gadget. -/
def quarticRaiseFactor (L s : ℂ) : ℂ[X] :=
  ((X - C L) ^ 2 - C (s ^ 2)) ^ 2 + C (s ^ 4)

theorem quarticRaiseFactor_eval (L s z : ℂ) :
    (quarticRaiseFactor L s).eval z =
      ((z - L) ^ 2 - s ^ 2) ^ 2 + s ^ 4 := by
  simp [quarticRaiseFactor]

theorem quarticRaiseFactor_expanded (L s : ℂ) :
    quarticRaiseFactor L s =
      (X - C L) ^ 4 - C (2 * s ^ 2) * (X - C L) ^ 2 + C (2 * s ^ 4) := by
  apply Polynomial.funext
  intro z
  simp [quarticRaiseFactor, pow_two]
  ring

theorem quarticRaiseFactor_monic (L s : ℂ) :
    (quarticRaiseFactor L s).Monic := by
  have hw : (X - C L : ℂ[X]).Monic := monic_X_sub_C L
  have hdegconst : (C (s ^ 2) : ℂ[X]).degree <
      ((X - C L : ℂ[X]) ^ 2).degree := by
    calc
      (C (s ^ 2) : ℂ[X]).degree < (1 : WithBot ℕ) := degree_C_lt
      _ < ((X - C L : ℂ[X]) ^ 2).degree := by
        rw [degree_pow, degree_X_sub_C]
        norm_num
  have hbase : ((X - C L : ℂ[X]) ^ 2 - C (s ^ 2)).Monic :=
    (hw.pow 2).sub_of_left hdegconst
  have hbaseDeg : ((X - C L : ℂ[X]) ^ 2 - C (s ^ 2)).degree =
      (2 : WithBot ℕ) := degree_sub_eq_left_of_degree_lt hdegconst |>.trans (by
        rw [degree_pow, degree_X_sub_C]
        norm_num)
  have hdegconst2 : (C (s ^ 4) : ℂ[X]).degree <
      (((X - C L : ℂ[X]) ^ 2 - C (s ^ 2)) ^ 2).degree := by
    calc
      (C (s ^ 4) : ℂ[X]).degree < (1 : WithBot ℕ) := degree_C_lt
      _ < (((X - C L : ℂ[X]) ^ 2 - C (s ^ 2)) ^ 2).degree := by
        rw [degree_pow, hbaseDeg]
        norm_num
  exact hbase.pow 2 |>.add_of_left hdegconst2

theorem quarticRaiseFactor_natDegree (L s : ℂ) :
    (quarticRaiseFactor L s).natDegree = 4 := by
  unfold quarticRaiseFactor
  compute_degree!

theorem quarticRaiseFactor_derivative (L s : ℂ) :
    (quarticRaiseFactor L s).derivative =
      C 4 * (X - C L) ^ 3 - C (4 * s ^ 2) * (X - C L) := by
  apply Polynomial.funext
  intro z
  simp [quarticRaiseFactor, derivative_sub, derivative_add, derivative_pow,
    derivative_X_sub_C, derivative_C, derivative_X]
  ring

/-! A Bézout identity for the translated quartic.  Put `t=s²`; then
`q=(w²-t)²+t²` and `q'=4w(w²-t)`.  The displayed identity

`4(t+w²)q - w³ q' = 8 t³`

is checked by `ring`; division by `t³` is legal when `s ≠ 0`. -/
theorem quarticRaiseFactor_separable {L s : ℂ} (hs : s ≠ 0) :
    (quarticRaiseFactor L s).Separable := by
  rw [Polynomial.separable_def']
  let t : ℂ := s ^ 2
  let w : ℂ[X] := X - C L
  let q : ℂ[X] := quarticRaiseFactor L s
  let A : ℂ[X] := C ((2 * t ^ 3)⁻¹) * (C t + w ^ 2)
  let B : ℂ[X] := -C ((8 * t ^ 3)⁻¹) * w ^ 3
  refine ⟨A, B, ?_⟩
  apply Polynomial.funext
  intro z
  have ht : t ≠ 0 := pow_ne_zero 2 hs
  have hq : q.eval z = ((z - L) ^ 2 - s ^ 2) ^ 2 + s ^ 4 := by
    dsimp [q]
    exact quarticRaiseFactor_eval L s z
  have hw : w.eval z = z - L := by simp [w]
  have hderiv : q.derivative.eval z =
      4 * (z - L) ^ 3 - 4 * s ^ 2 * (z - L) := by
    dsimp [q]
    rw [quarticRaiseFactor_derivative]
    simp
  dsimp [A, B]
  simp only [eval_add, eval_mul, eval_C, eval_pow, eval_sub, eval_neg, eval_one,
    eval_zero]
  rw [hq, hderiv, hw]
  dsimp [t] at ht ⊢
  field_simp [ht]
  ring_nf

theorem quarticRaiseFactor_factorization {L s : ℂ} :
    quarticRaiseFactor L s =
      ((X - C L) ^ 2 - C ((1 + Complex.I) * s ^ 2)) *
        ((X - C L) ^ 2 - C ((1 - Complex.I) * s ^ 2)) := by
  apply Polynomial.funext
  intro z
  simp [quarticRaiseFactor, pow_two]
  ring_nf
  simp [Complex.I_sq]
  ring

theorem quarticRaiseFactor_root_iff {L s z : ℂ} :
    (quarticRaiseFactor L s).eval z = 0 ↔
      (z - L) ^ 2 = (1 + Complex.I) * s ^ 2 ∨
      (z - L) ^ 2 = (1 - Complex.I) * s ^ 2 := by
  rw [quarticRaiseFactor_factorization, eval_mul]
  simp only [eval_sub, eval_pow, eval_X, eval_C, mul_eq_zero]
  constructor
  · intro h
    rcases h with h | h
    · left
      exact sub_eq_zero.mp h
    · right
      exact sub_eq_zero.mp h
  · intro h
    rcases h with h | h
    · left
      exact sub_eq_zero.mpr h
    · right
      exact sub_eq_zero.mpr h

theorem quarticRaiseFactor_rootSet_ncard {L s : ℂ} (hs : s ≠ 0) :
    ((quarticRaiseFactor L s).rootSet ℂ).ncard = 4 := by
  have hcard : Fintype.card ((quarticRaiseFactor L s).rootSet ℂ) =
      (quarticRaiseFactor L s).natDegree :=
    Polynomial.card_rootSet_eq_natDegree (quarticRaiseFactor_separable hs)
      (IsAlgClosed.splits _)
  simpa [quarticRaiseFactor_natDegree] using hcard

theorem quarticRaiseFactor_coprime_of_no_common_root
    (p : ℂ[X]) (L s : ℂ)
    (hno : ∀ z : ℂ, p.eval z = 0 →
      ((z - L) ^ 2 - s ^ 2) ^ 2 + s ^ 4 ≠ 0) :
    IsCoprime p (quarticRaiseFactor L s) := by
  rw [Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed (k := ℂ)
    ℂ p (quarticRaiseFactor L s)]
  change ∀ z : ℂ, p.eval z ≠ 0 ∨ (quarticRaiseFactor L s).eval z ≠ 0
  intro z
  by_cases hpz : p.eval z = 0
  · right
    intro hq
    exact hno z hpz (by simpa [quarticRaiseFactor_eval] using hq)
  · exact Or.inl hpz

def quarticRaisePolynomial (p : ℂ[X]) (L s : ℂ) : ℂ[X] :=
  p * quarticRaiseFactor L s

theorem quarticRaisePolynomial_monic (p : ℂ[X]) (L s : ℂ) (hp : p.Monic) :
    (quarticRaisePolynomial p L s).Monic := by
  unfold quarticRaisePolynomial
  exact hp.mul (quarticRaiseFactor_monic L s)

theorem quarticRaisePolynomial_natDegree (p : ℂ[X]) (L s : ℂ) (hp : p.Monic) :
    (quarticRaisePolynomial p L s).natDegree = p.natDegree + 4 := by
  unfold quarticRaisePolynomial
  rw [natDegree_mul hp.ne_zero (quarticRaiseFactor_monic L s).ne_zero,
    quarticRaiseFactor_natDegree]

theorem quarticRaisePolynomial_separable
    (p : ℂ[X]) (L s : ℂ) (hp : p.Separable) (hs : s ≠ 0)
    (hcop : IsCoprime p (quarticRaiseFactor L s)) :
    (quarticRaisePolynomial p L s).Separable := by
  unfold quarticRaisePolynomial
  exact hp.mul (quarticRaiseFactor_separable hs) hcop

theorem quarticRaisePolynomial_rootSet_ncard
    (p : ℂ[X]) (L s : ℂ) (hp : p.Monic) (hpsep : p.Separable)
    (hs : s ≠ 0) (hcop : IsCoprime p (quarticRaiseFactor L s)) :
    ((quarticRaisePolynomial p L s).rootSet ℂ).ncard = p.natDegree + 4 := by
  have hsep : (quarticRaisePolynomial p L s).Separable :=
    quarticRaisePolynomial_separable p L s hpsep hs hcop
  have hcard : Fintype.card ((quarticRaisePolynomial p L s).rootSet ℂ) =
      (quarticRaisePolynomial p L s).natDegree :=
    Polynomial.card_rootSet_eq_natDegree hsep (IsAlgClosed.splits _)
  simpa [quarticRaisePolynomial_natDegree p L s hp] using hcard

/-! Evaluation and normalization identities for the product with an old
    polynomial.  These are the algebraic starting point for a future
    `n → n+4` perturbation estimate; no component statement is hidden here. -/
theorem quarticRaisePolynomial_eval (p : ℂ[X]) (L s z : ℂ) :
    (quarticRaisePolynomial p L s).eval z =
      p.eval z * (((z - L) ^ 2 - s ^ 2) ^ 2 + s ^ 4) := by
  unfold quarticRaisePolynomial
  rw [eval_mul, quarticRaiseFactor_eval]

theorem quarticRaisePolynomial_scaled_eval
    (p : ℂ[X]) (L s z : ℂ) (hL : L ≠ 0) :
    (quarticRaisePolynomial p L s).eval z / L ^ 4 =
      p.eval z * (((1 - z / L) ^ 2 - (s / L) ^ 2) ^ 2 + (s / L) ^ 4) := by
  rw [quarticRaisePolynomial_eval]
  field_simp [hL]
  ring

theorem quarticRaisePolynomial_scaled_eval_sub_original
    (p : ℂ[X]) (L s z : ℂ) (hL : L ≠ 0) :
    (quarticRaisePolynomial p L s).eval z / L ^ 4 - p.eval z =
      p.eval z * ((((1 - z / L) ^ 2 - (s / L) ^ 2) ^ 2 +
        (s / L) ^ 4) - 1) := by
  rw [quarticRaisePolynomial_scaled_eval p L s z hL]
  ring

/-! A concrete uniform perturbation bound for the normalized quartic product.
    This is the first analytic estimate needed to preserve old witnesses when
    the quartic gadget is placed far from the old root cluster. -/
theorem quarticRaisePolynomial_scaled_difference_norm_le
    (p : ℂ[X]) (L s z : ℂ) (hL : L ≠ 0) :
    ‖(quarticRaisePolynomial p L s).eval z / L ^ 4 - p.eval z‖ ≤
      ‖p.eval z‖ *
        (4 * ‖z / L‖ + 6 * ‖z / L‖ ^ 2 + 4 * ‖z / L‖ ^ 3 +
          ‖z / L‖ ^ 4 + 2 * ‖s / L‖ ^ 2 +
          4 * ‖z / L‖ * ‖s / L‖ ^ 2 +
          2 * ‖z / L‖ ^ 2 * ‖s / L‖ ^ 2 + 2 * ‖s / L‖ ^ 4) := by
  rw [quarticRaisePolynomial_scaled_eval_sub_original p L s z hL]
  rw [norm_mul]
  apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
  let u : ℂ := z / L
  let v : ℂ := s / L
  have hexpand : (((1 - u) ^ 2 - v ^ 2) ^ 2 + v ^ 4) - 1 =
      -4 * u + 6 * u ^ 2 - 4 * u ^ 3 + u ^ 4 - 2 * v ^ 2 +
        4 * u * v ^ 2 - 2 * u ^ 2 * v ^ 2 + 2 * v ^ 4 := by ring
  change ‖(((1 - u) ^ 2 - v ^ 2) ^ 2 + v ^ 4) - 1‖ ≤ _
  rw [hexpand]
  have hnorm :
      ‖-4 * u + 6 * u ^ 2 - 4 * u ^ 3 + u ^ 4 - 2 * v ^ 2 +
        4 * u * v ^ 2 - 2 * u ^ 2 * v ^ 2 + 2 * v ^ 4‖ ≤
      ‖-4 * u‖ + ‖6 * u ^ 2‖ + ‖-4 * u ^ 3‖ + ‖u ^ 4‖ +
        ‖-2 * v ^ 2‖ + ‖4 * u * v ^ 2‖ + ‖-2 * u ^ 2 * v ^ 2‖ + ‖2 * v ^ 4‖ := by
    let t : Fin 8 → ℂ := ![-4*u, 6*u^2, -4*u^3, u^4, -2*v^2,
      4*u*v^2, -2*u^2*v^2, 2*v^4]
    have h := norm_sum_le (Finset.univ : Finset (Fin 8)) t
    simpa [t, Fin.sum_univ_succ, sub_eq_add_neg, add_assoc] using h
  calc
    _ ≤ ‖-4 * u‖ + ‖6 * u ^ 2‖ + ‖-4 * u ^ 3‖ + ‖u ^ 4‖ +
        ‖-2 * v ^ 2‖ + ‖4 * u * v ^ 2‖ + ‖-2 * u ^ 2 * v ^ 2‖ + ‖2 * v ^ 4‖ := hnorm
    _ = 4 * ‖u‖ + 6 * ‖u‖ ^ 2 + 4 * ‖u‖ ^ 3 + ‖u‖ ^ 4 +
        2 * ‖v‖ ^ 2 + 4 * ‖u‖ * ‖v‖ ^ 2 +
        2 * ‖u‖ ^ 2 * ‖v‖ ^ 2 + 2 * ‖v‖ ^ 4 := by
      norm_num [norm_mul, norm_pow, norm_neg]
    _ = 4 * ‖z / L‖ + 6 * ‖z / L‖ ^ 2 + 4 * ‖z / L‖ ^ 3 +
        ‖z / L‖ ^ 4 + 2 * ‖s / L‖ ^ 2 +
        4 * ‖z / L‖ * ‖s / L‖ ^ 2 +
        2 * ‖z / L‖ ^ 2 * ‖s / L‖ ^ 2 + 2 * ‖s / L‖ ^ 4 := by
      rfl

/-! Pointwise convergence of the normalized quartic product on positive real
    scales.  Together with compactness, this is the analytic limit used to
    choose one large translation scale for a finite family of old witnesses. -/
theorem tendsto_quarticRaisePolynomial_scaled_difference_norm_atTop
    (p : ℂ[X]) (s z : ℂ) :
    Tendsto (fun L : ℝ =>
      ‖(quarticRaisePolynomial p (L : ℂ) s).eval z /
          (L : ℂ) ^ 4 - p.eval z‖) atTop (𝓝 0) := by
  have hLpos : ∀ᶠ L : ℝ in atTop, 0 < L := eventually_gt_atTop (0 : ℝ)
  have hLne : ∀ᶠ L : ℝ in atTop, L ≠ 0 := hLpos.mono fun L hL => ne_of_gt hL
  have hdivz : Tendsto (fun L : ℝ => ‖z‖ / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => ‖z‖ / L) atTop (𝓝 0))
  have hdivs : Tendsto (fun L : ℝ => ‖s‖ / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => ‖s‖ / L) atTop (𝓝 0))
  have huc : Tendsto (fun L : ℝ => ‖z / (L : ℂ)‖) atTop (𝓝 0) := by
    apply Tendsto.congr' ?_ hdivz
    filter_upwards [hLpos] with L hL
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
  have hvc : Tendsto (fun L : ℝ => ‖s / (L : ℂ)‖) atTop (𝓝 0) := by
    apply Tendsto.congr' ?_ hdivs
    filter_upwards [hLpos] with L hL
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
  have hu2 : Tendsto (fun L : ℝ => ‖z / (L : ℂ)‖ ^ 2) atTop (𝓝 0) := by
    simpa using huc.pow 2
  have hu3 : Tendsto (fun L : ℝ => ‖z / (L : ℂ)‖ ^ 3) atTop (𝓝 0) := by
    simpa using huc.pow 3
  have hu4 : Tendsto (fun L : ℝ => ‖z / (L : ℂ)‖ ^ 4) atTop (𝓝 0) := by
    simpa using huc.pow 4
  have hv2 : Tendsto (fun L : ℝ => ‖s / (L : ℂ)‖ ^ 2) atTop (𝓝 0) := by
    simpa using hvc.pow 2
  have hv4 : Tendsto (fun L : ℝ => ‖s / (L : ℂ)‖ ^ 4) atTop (𝓝 0) := by
    simpa using hvc.pow 4
  have huv2 : Tendsto (fun L : ℝ =>
      ‖z / (L : ℂ)‖ * ‖s / (L : ℂ)‖ ^ 2) atTop (𝓝 0) := by
    simpa using huc.mul hv2
  have hu2v2 : Tendsto (fun L : ℝ =>
      ‖z / (L : ℂ)‖ ^ 2 * ‖s / (L : ℂ)‖ ^ 2) atTop (𝓝 0) := by
    simpa using hu2.mul hv2
  have hsum : Tendsto (fun L : ℝ =>
      4 * ‖z / (L : ℂ)‖ + 6 * ‖z / (L : ℂ)‖ ^ 2 +
        4 * ‖z / (L : ℂ)‖ ^ 3 + ‖z / (L : ℂ)‖ ^ 4 +
        2 * ‖s / (L : ℂ)‖ ^ 2 +
        4 * ‖z / (L : ℂ)‖ * ‖s / (L : ℂ)‖ ^ 2 +
        2 * ‖z / (L : ℂ)‖ ^ 2 * ‖s / (L : ℂ)‖ ^ 2 +
        2 * ‖s / (L : ℂ)‖ ^ 4) atTop (𝓝 0) := by
    have h0 := huc.const_mul 4
    have h1 := hu2.const_mul 6
    have h2 := hu3.const_mul 4
    have h3 := hu4
    have h4 := hv2.const_mul 2
    have h5 := huv2.const_mul 4
    have h6 := hu2v2.const_mul 2
    have h7 := hv4.const_mul 2
    have h01 := h0.add h1
    have h012 := h01.add h2
    have h0123 := h012.add h3
    have h01234 := h0123.add h4
    have h012345 := h01234.add h5
    have h0123456 := h012345.add h6
    have h01234567 := h0123456.add h7
    simpa [add_assoc, mul_comm, mul_left_comm, mul_assoc] using
      h01234567
  have hbound : ∀ᶠ L : ℝ in atTop,
      ‖(quarticRaisePolynomial p (L : ℂ) s).eval z /
          (L : ℂ) ^ 4 - p.eval z‖ ≤
        ‖p.eval z‖ *
          (4 * ‖z / (L : ℂ)‖ + 6 * ‖z / (L : ℂ)‖ ^ 2 +
            4 * ‖z / (L : ℂ)‖ ^ 3 + ‖z / (L : ℂ)‖ ^ 4 +
            2 * ‖s / (L : ℂ)‖ ^ 2 +
            4 * ‖z / (L : ℂ)‖ * ‖s / (L : ℂ)‖ ^ 2 +
            2 * ‖z / (L : ℂ)‖ ^ 2 * ‖s / (L : ℂ)‖ ^ 2 +
            2 * ‖s / (L : ℂ)‖ ^ 4) := by
    filter_upwards [hLne] with L hL
    exact quarticRaisePolynomial_scaled_difference_norm_le p (L : ℂ) s z
      (by exact_mod_cast hL)
  have hsum' : Tendsto (fun L : ℝ =>
      ‖p.eval z‖ *
        (4 * ‖z / (L : ℂ)‖ + 6 * ‖z / (L : ℂ)‖ ^ 2 +
          4 * ‖z / (L : ℂ)‖ ^ 3 + ‖z / (L : ℂ)‖ ^ 4 +
          2 * ‖s / (L : ℂ)‖ ^ 2 +
          4 * ‖z / (L : ℂ)‖ * ‖s / (L : ℂ)‖ ^ 2 +
          2 * ‖z / (L : ℂ)‖ ^ 2 * ‖s / (L : ℂ)‖ ^ 2 +
          2 * ‖s / (L : ℂ)‖ ^ 4)) atTop (𝓝 0) := by
    simpa [mul_add, add_assoc, mul_comm, mul_left_comm, mul_assoc] using
      hsum.const_mul ‖p.eval z‖
  exact squeeze_zero' (Eventually.of_forall fun L => norm_nonneg _) hbound hsum'

/-! Uniform version on a compact set.  The explicit eight-term estimate is
    combined with compact bounds for `z` and `p.eval z`; this supplies the
    scale choice needed to preserve finitely many old component witnesses. -/
theorem exists_uniform_quarticRaisePolynomial_scaled_difference_on_compact
    (p : ℂ[X]) (s : ℂ) (K : Set ℂ) (hK : IsCompact K) :
    ∀ ε : ℝ, 0 < ε → ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ∀ z ∈ K,
        ‖(quarticRaisePolynomial p (L : ℂ) s).eval z /
            (L : ℂ) ^ 4 - p.eval z‖ < ε := by
  intro ε hε
  obtain ⟨R, hR⟩ := hK.exists_bound_of_continuousOn
    (continuous_id : Continuous (fun z : ℂ => z)).continuousOn
  obtain ⟨A, hA⟩ := hK.exists_bound_of_continuousOn p.continuous.continuousOn
  have hRdiv : Tendsto (fun L : ℝ => R / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => R / L) atTop (𝓝 0))
  have hSdiv : Tendsto (fun L : ℝ => ‖s‖ / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => ‖s‖ / L) atTop (𝓝 0))
  have hR2 : Tendsto (fun L : ℝ => (R / L) ^ 2) atTop (𝓝 0) := by
    simpa using hRdiv.pow 2
  have hR3 : Tendsto (fun L : ℝ => (R / L) ^ 3) atTop (𝓝 0) := by
    simpa using hRdiv.pow 3
  have hR4 : Tendsto (fun L : ℝ => (R / L) ^ 4) atTop (𝓝 0) := by
    simpa using hRdiv.pow 4
  have hS2 : Tendsto (fun L : ℝ => (‖s‖ / L) ^ 2) atTop (𝓝 0) := by
    simpa using hSdiv.pow 2
  have hS4 : Tendsto (fun L : ℝ => (‖s‖ / L) ^ 4) atTop (𝓝 0) := by
    simpa using hSdiv.pow 4
  have hRS2 : Tendsto (fun L : ℝ =>
      (R / L) * (‖s‖ / L) ^ 2) atTop (𝓝 0) := by
    simpa using hRdiv.mul hS2
  have hR2S2 : Tendsto (fun L : ℝ =>
      (R / L) ^ 2 * (‖s‖ / L) ^ 2) atTop (𝓝 0) := by
    simpa using hR2.mul hS2
  have hsum : Tendsto (fun L : ℝ =>
      A * (4 * (R / L) + 6 * (R / L) ^ 2 + 4 * (R / L) ^ 3 +
        (R / L) ^ 4 + 2 * (‖s‖ / L) ^ 2 +
        4 * (R / L) * (‖s‖ / L) ^ 2 +
        2 * (R / L) ^ 2 * (‖s‖ / L) ^ 2 +
        2 * (‖s‖ / L) ^ 4)) atTop (𝓝 0) := by
    have h0 := hRdiv.const_mul 4
    have h1 := hR2.const_mul 6
    have h2 := hR3.const_mul 4
    have h3 := hR4
    have h4 := hS2.const_mul 2
    have h5 := hRS2.const_mul 4
    have h6 := hR2S2.const_mul 2
    have h7 := hS4.const_mul 2
    have h01 := h0.add h1
    have h012 := h01.add h2
    have h0123 := h012.add h3
    have h01234 := h0123.add h4
    have h012345 := h01234.add h5
    have h0123456 := h012345.add h6
    have h01234567 := h0123456.add h7
    simpa [add_assoc, mul_comm, mul_left_comm, mul_assoc] using
      h01234567.const_mul A
  obtain ⟨L₀, hL₀⟩ := eventually_atTop.1 (hsum.eventually_lt_const hε)
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL z hz
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hLpos)
    have hzdiv : ‖z / (L : ℂ)‖ ≤ R / L := by
      rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
      exact div_le_div_of_nonneg_right (hR z hz)
        (le_of_lt hLpos)
    have hsdiv : ‖s / (L : ℂ)‖ = ‖s‖ / L := by
      rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
    have hRnonneg : 0 ≤ R := le_trans (norm_nonneg z) (hR z hz)
    have hA_nonneg : 0 ≤ A := le_trans (norm_nonneg (p.eval z)) (hA z hz)
    have hterms :
        4 * ‖z / (L : ℂ)‖ + 6 * ‖z / (L : ℂ)‖ ^ 2 +
            4 * ‖z / (L : ℂ)‖ ^ 3 + ‖z / (L : ℂ)‖ ^ 4 +
            2 * ‖s / (L : ℂ)‖ ^ 2 +
            4 * ‖z / (L : ℂ)‖ * ‖s / (L : ℂ)‖ ^ 2 +
            2 * ‖z / (L : ℂ)‖ ^ 2 * ‖s / (L : ℂ)‖ ^ 2 +
            2 * ‖s / (L : ℂ)‖ ^ 4 ≤
          4 * (R / L) + 6 * (R / L) ^ 2 + 4 * (R / L) ^ 3 +
            (R / L) ^ 4 + 2 * (‖s‖ / L) ^ 2 +
            4 * (R / L) * (‖s‖ / L) ^ 2 +
            2 * (R / L) ^ 2 * (‖s‖ / L) ^ 2 +
            2 * (‖s‖ / L) ^ 4 := by
      rw [hsdiv]
      have hRdiv_nonneg : 0 ≤ R / L := div_nonneg hRnonneg (le_of_lt hLpos)
      gcongr
    have hbound := quarticRaisePolynomial_scaled_difference_norm_le
      p (L : ℂ) s z hLne
    have hmul :
        ‖p.eval z‖ *
            (4 * ‖z / (L : ℂ)‖ + 6 * ‖z / (L : ℂ)‖ ^ 2 +
              4 * ‖z / (L : ℂ)‖ ^ 3 + ‖z / (L : ℂ)‖ ^ 4 +
              2 * ‖s / (L : ℂ)‖ ^ 2 +
              4 * ‖z / (L : ℂ)‖ * ‖s / (L : ℂ)‖ ^ 2 +
              2 * ‖z / (L : ℂ)‖ ^ 2 * ‖s / (L : ℂ)‖ ^ 2 +
              2 * ‖s / (L : ℂ)‖ ^ 4) ≤
          A * (4 * (R / L) + 6 * (R / L) ^ 2 + 4 * (R / L) ^ 3 +
            (R / L) ^ 4 + 2 * (‖s‖ / L) ^ 2 +
            4 * (R / L) * (‖s‖ / L) ^ 2 +
            2 * (R / L) ^ 2 * (‖s‖ / L) ^ 2 +
            2 * (‖s‖ / L) ^ 4) := by
      exact mul_le_mul (hA z hz) hterms
        (by positivity) hA_nonneg
    exact lt_of_le_of_lt (hbound.trans hmul)
      (hL₀ L (le_trans (le_max_left _ _) hL))

/-! A version uniform in the quartic scale.  This is needed when the
    translation parameter is chosen first (to preserve old components) and
    the local chart scale is then chosen from a bounded interval. -/
theorem exists_uniform_quarticRaisePolynomial_scaled_difference_on_compact_of_norm_le
    (p : ℂ[X]) (K : Set ℂ) (hK : IsCompact K) (S : ℝ) (hS : 0 ≤ S) :
    ∀ ε : ℝ, 0 < ε → ∃ L₀ : ℝ, 0 < L₀ ∧ ∀ L : ℝ, L₀ ≤ L →
      ∀ s : ℂ, ‖s‖ ≤ S → ∀ z ∈ K,
        ‖(quarticRaisePolynomial p (L : ℂ) s).eval z /
            (L : ℂ) ^ 4 - p.eval z‖ < ε := by
  intro ε hε
  obtain ⟨R, hR⟩ := hK.exists_bound_of_continuousOn
    (continuous_id : Continuous (fun z : ℂ => z)).continuousOn
  obtain ⟨A, hA⟩ := hK.exists_bound_of_continuousOn p.continuous.continuousOn
  have hRdiv : Tendsto (fun L : ℝ => R / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => R / L) atTop (𝓝 0))
  have hSdiv : Tendsto (fun L : ℝ => S / L) atTop (𝓝 0) := by
    simpa using (tendsto_const_nhds.div_atTop tendsto_id :
      Tendsto (fun L : ℝ => S / L) atTop (𝓝 0))
  have hR2 : Tendsto (fun L : ℝ => (R / L) ^ 2) atTop (𝓝 0) := by
    simpa using hRdiv.pow 2
  have hR3 : Tendsto (fun L : ℝ => (R / L) ^ 3) atTop (𝓝 0) := by
    simpa using hRdiv.pow 3
  have hR4 : Tendsto (fun L : ℝ => (R / L) ^ 4) atTop (𝓝 0) := by
    simpa using hRdiv.pow 4
  have hS2 : Tendsto (fun L : ℝ => (S / L) ^ 2) atTop (𝓝 0) := by
    simpa using hSdiv.pow 2
  have hS4 : Tendsto (fun L : ℝ => (S / L) ^ 4) atTop (𝓝 0) := by
    simpa using hSdiv.pow 4
  have hRS2 : Tendsto (fun L : ℝ =>
      (R / L) * (S / L) ^ 2) atTop (𝓝 0) := by
    simpa using hRdiv.mul hS2
  have hR2S2 : Tendsto (fun L : ℝ =>
      (R / L) ^ 2 * (S / L) ^ 2) atTop (𝓝 0) := by
    simpa using hR2.mul hS2
  have hsum : Tendsto (fun L : ℝ =>
      A * (4 * (R / L) + 6 * (R / L) ^ 2 + 4 * (R / L) ^ 3 +
        (R / L) ^ 4 + 2 * (S / L) ^ 2 +
        4 * (R / L) * (S / L) ^ 2 +
        2 * (R / L) ^ 2 * (S / L) ^ 2 + 2 * (S / L) ^ 4)) atTop (𝓝 0) := by
    have h0 := hRdiv.const_mul 4
    have h1 := hR2.const_mul 6
    have h2 := hR3.const_mul 4
    have h3 := hR4
    have h4 := hS2.const_mul 2
    have h5 := hRS2.const_mul 4
    have h6 := hR2S2.const_mul 2
    have h7 := hS4.const_mul 2
    have h01 := h0.add h1
    have h012 := h01.add h2
    have h0123 := h012.add h3
    have h01234 := h0123.add h4
    have h012345 := h01234.add h5
    have h0123456 := h012345.add h6
    have h01234567 := h0123456.add h7
    simpa [add_assoc, mul_comm, mul_left_comm, mul_assoc] using
      h01234567.const_mul A
  obtain ⟨L₀, hL₀⟩ := eventually_atTop.1 (hsum.eventually_lt_const hε)
  let L₁ : ℝ := max L₀ 1
  refine ⟨L₁, ?_, ?_⟩
  · exact lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  · intro L hL s hs z hz
    have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one
      (le_trans (le_max_right _ _) hL)
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hLpos)
    have hzdiv : ‖z / (L : ℂ)‖ ≤ R / L := by
      rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
      exact div_le_div_of_nonneg_right (hR z hz)
        (le_of_lt hLpos)
    have hsdiv : ‖s / (L : ℂ)‖ ≤ S / L := by
      rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hLpos]
      exact div_le_div_of_nonneg_right hs (le_of_lt hLpos)
    have hRnonneg : 0 ≤ R := le_trans (norm_nonneg z) (hR z hz)
    have hRdiv_nonneg : 0 ≤ R / L := div_nonneg hRnonneg (le_of_lt hLpos)
    have hSdiv_nonneg : 0 ≤ S / L := div_nonneg hS (le_of_lt hLpos)
    have hA_nonneg : 0 ≤ A := le_trans (norm_nonneg (p.eval z)) (hA z hz)
    have hterms :
        4 * ‖z / (L : ℂ)‖ + 6 * ‖z / (L : ℂ)‖ ^ 2 +
            4 * ‖z / (L : ℂ)‖ ^ 3 + ‖z / (L : ℂ)‖ ^ 4 +
            2 * ‖s / (L : ℂ)‖ ^ 2 +
            4 * ‖z / (L : ℂ)‖ * ‖s / (L : ℂ)‖ ^ 2 +
            2 * ‖z / (L : ℂ)‖ ^ 2 * ‖s / (L : ℂ)‖ ^ 2 +
            2 * ‖s / (L : ℂ)‖ ^ 4 ≤
          4 * (R / L) + 6 * (R / L) ^ 2 + 4 * (R / L) ^ 3 +
            (R / L) ^ 4 + 2 * (S / L) ^ 2 +
            4 * (R / L) * (S / L) ^ 2 +
            2 * (R / L) ^ 2 * (S / L) ^ 2 + 2 * (S / L) ^ 4 := by
      gcongr
    have hbound := quarticRaisePolynomial_scaled_difference_norm_le
      p (L : ℂ) s z hLne
    have hmul :
        ‖p.eval z‖ *
            (4 * ‖z / (L : ℂ)‖ + 6 * ‖z / (L : ℂ)‖ ^ 2 +
              4 * ‖z / (L : ℂ)‖ ^ 3 + ‖z / (L : ℂ)‖ ^ 4 +
              2 * ‖s / (L : ℂ)‖ ^ 2 +
              4 * ‖z / (L : ℂ)‖ * ‖s / (L : ℂ)‖ ^ 2 +
              2 * ‖z / (L : ℂ)‖ ^ 2 * ‖s / (L : ℂ)‖ ^ 2 +
              2 * ‖s / (L : ℂ)‖ ^ 4) ≤
          A * (4 * (R / L) + 6 * (R / L) ^ 2 + 4 * (R / L) ^ 3 +
            (R / L) ^ 4 + 2 * (S / L) ^ 2 +
            4 * (R / L) * (S / L) ^ 2 +
            2 * (R / L) ^ 2 * (S / L) ^ 2 + 2 * (S / L) ^ 4) := by
      exact mul_le_mul (hA z hz) hterms
        (by positivity) hA_nonneg
    exact lt_of_le_of_lt (hbound.trans hmul)
      (hL₀ L (le_trans (le_max_left _ _) hL))

end
