theorem lineA_norm_lt (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    ‖polynomial.eval (anchor + (t : ℂ) * (pointA - anchor))‖ < level := by
  have hs := lineA_normSq t ht0 ht1
  rw [Complex.normSq_eq_norm_sq] at hs
  have hc : 0 ≤ level := by norm_num [level]
  nlinarith [norm_nonneg
    (polynomial.eval (anchor + (t : ℂ) * (pointA - anchor)))]

theorem lineB_norm_lt (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    ‖polynomial.eval (anchor + (t : ℂ) * (pointB - anchor))‖ < level := by
