def leftWedge (z : ℂ) : Prop :=
  z.re < 0 ∧ Real.sqrt 3 * z.im < -z.re ∧ -Real.sqrt 3 * z.im < -z.re

theorem leftWedge_convex : Convex ℝ {z : ℂ | leftWedge z} := by
  intro z hz w hw a b ha hb hab
  change leftWedge (a • z + b • w)
  change z.re < 0 ∧ Real.sqrt 3 * z.im < -z.re ∧
    -Real.sqrt 3 * z.im < -z.re at hz
  change w.re < 0 ∧ Real.sqrt 3 * w.im < -w.re ∧
    -Real.sqrt 3 * w.im < -w.re at hw
  have hneg : ∀ {u v : ℝ}, u < 0 → v < 0 → a * u + b * v < 0 := by
    intro u v hu hv
    by_cases ha0 : a = 0
    · have hb1 : b = 1 := by linarith
      simp [ha0, hb1, hv]
    · have ha' : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
      have hA := mul_lt_mul_of_pos_left hu ha'
      have hB := mul_le_mul_of_nonneg_left hv.le hb
      linarith
  have hz1 : Real.sqrt 3 * z.im + z.re < 0 := by linarith [hz.2.1]
  have hw1 : Real.sqrt 3 * w.im + w.re < 0 := by linarith [hw.2.1]
  have hz2 : -Real.sqrt 3 * z.im + z.re < 0 := by linarith [hz.2.2]
  have hw2 : -Real.sqrt 3 * w.im + w.re < 0 := by linarith [hw.2.2]
  have h0 := hneg hz.1 hw.1
  have h1 := hneg hz1 hw1
  have h2 := hneg hz2 hw2
  have h0' : (a • z + b • w).re < 0 := by
    simpa only [Complex.add_re, Complex.real_smul, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, add_zero] using h0
  have h1' : Real.sqrt 3 * (a • z + b • w).im <
      -(a • z + b • w).re := by
    simp only [Complex.add_re, Complex.add_im, Complex.real_smul, Complex.mul_re,
      Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
      add_zero]
    nlinarith [h1]
  have h2' : -Real.sqrt 3 * (a • z + b • w).im <
      -(a • z + b • w).re := by
    simp only [Complex.add_re, Complex.add_im, Complex.real_smul, Complex.mul_re,
      Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
      add_zero]
    nlinarith [h2]
  exact ⟨h0', h1', h2'⟩

theorem leftWedge_zero_not_mem {z : ℂ} (hz : leftWedge z) : z ≠ 0 := by
  intro h
  subst z
  simp [leftWedge] at hz

theorem cube_re_neg_of_leftWedge {z : ℂ} (hz : leftWedge z) :
    (z ^ 3).re < 0 := by
  rcases hz with ⟨hx, hup, hlo⟩
  have hs : 0 < Real.sqrt 3 := Real.sqrt_pos.2 (by norm_num)
  have hlo' : -(-z.re) < Real.sqrt 3 * z.im := by linarith
  have habs : |Real.sqrt 3 * z.im| < -z.re := (abs_lt.mpr ⟨hlo', hup⟩)
  have hsq_abs : |Real.sqrt 3 * z.im| ^ 2 < (-z.re) ^ 2 := by
    exact (sq_lt_sq₀ (abs_nonneg _) (by linarith)).mpr habs
  have hsq : (Real.sqrt 3 * z.im) ^ 2 < (-z.re) ^ 2 := by
    simpa only [sq_abs] using hsq_abs
  have hs2 : (Real.sqrt 3) ^ 2 = (3 : ℝ) := by
    norm_num
  have hquad : 3 * z.im ^ 2 < z.re ^ 2 := by
    nlinarith [hs2]
  norm_num [Complex.mul_re, Complex.mul_im, pow_succ]
  nlinarith

theorem pure_cubic_ratio_pos {b : ℝ} (hb : 0 < b) {z : ℂ}
    (hz : leftWedge z) :
    0 < (1 - (z ^ 3 + (b : ℂ)) * (6 * z) /
      (3 * z ^ 2) ^ 2).re := by
  have hz0 : z ≠ 0 := leftWedge_zero_not_mem hz
  have hz3 : (z ^ 3).re < 0 := cube_re_neg_of_leftWedge hz
  have hsq : z ^ 2 ≠ 0 := pow_ne_zero 2 hz0
  have hratio :
      1 - (z ^ 3 + (b : ℂ)) * (6 * z) /
        (3 * z ^ 2) ^ 2 =
      (1 / 3 : ℂ) - (2 / 3 : ℂ) * (b : ℂ) / z ^ 3 := by
    field_simp [hz0, hsq]
    ring
  rw [hratio]
  have hdiv : ((b : ℂ) / z ^ 3).re < 0 := by
    rw [Complex.div_re]
    have hnorm : 0 < Complex.normSq (z ^ 3) :=
      Complex.normSq_pos.mpr (pow_ne_zero 3 hz0)
    have hnum : (b : ℂ).re * (z ^ 3).re + (b : ℂ).im * (z ^ 3).im < 0 := by
      norm_num
      exact mul_neg_of_pos_of_neg hb hz3
    rw [← add_div]
    exact div_neg_of_neg_of_pos hnum hnorm
  have hreal :
      ((1 / 3 : ℂ) - (2 / 3 : ℂ) * (b : ℂ) / z ^ 3).re =
        1 / 3 - (2 / 3 : ℝ) * ((b : ℂ) / z ^ 3).re := by
    have hassoc : (2 / 3 : ℂ) * (b : ℂ) / z ^ 3 =
        (2 / 3 : ℂ) * ((b : ℂ) / z ^ 3) := by ring
    rw [hassoc]
    have hscalar : (2 / 3 : ℂ) = ((2 / 3 : ℝ) : ℂ) := by norm_num
    rw [hscalar]
    rw [← Complex.real_smul]
    norm_num [Complex.sub_re]
  rw [hreal]
  nlinarith

/-! The pure-cubic branch has the same one-dimensional calculus as the centered
    branch, but with the linear term removed.  We keep this calculation in a
    separate core so that the component argument does not depend on any
    analytic inverse-function machinery. -/

def pureCubicValue (b : ℝ) (z : ℂ) : ℂ := z ^ 3 + b

def pureSublevel (b c : ℝ) : Set ℂ :=
  {z : ℂ | ‖pureCubicValue b z‖ ≤ c}

/-! The three boundary lines of the left wedge are mapped by the cube to the
    imaginary axis.  Hence a positive real constant term gives a sharp
    boundary barrier: the norm is at least `b`. -/
theorem pure_boundary_normSq_ge {b : ℝ} {z : ℂ} (hb : 0 ≤ b)
    (hline : z.re = 0 ∨ Real.sqrt 3 * z.im + z.re = 0 ∨
      -Real.sqrt 3 * z.im + z.re = 0) :
    b ^ 2 ≤ Complex.normSq (pureCubicValue b z) := by
  have hs2 : (Real.sqrt 3) ^ 2 = (3 : ℝ) := by norm_num
  have hre_formula : (z ^ 3).re = z.re * (z.re ^ 2 - 3 * z.im ^ 2) := by
    norm_num [pow_succ, Complex.mul_re, Complex.mul_im]
    ring
  rcases hline with h0 | h1 | h2
  · have hre : (z ^ 3).re = 0 := by rw [hre_formula, h0]; ring
    rw [Complex.normSq_apply]
    norm_num [pureCubicValue, Complex.add_re, Complex.add_im, hre]
    nlinarith [sq_nonneg (z ^ 3).im]
  · have hlin : Real.sqrt 3 * z.im = -z.re := by linarith
    have hsqrel := congrArg (fun q : ℝ => q ^ 2) hlin
    have hsq' : z.re ^ 2 = 3 * z.im ^ 2 := by
      calc
        z.re ^ 2 = (-z.re) ^ 2 := by ring
        _ = (Real.sqrt 3 * z.im) ^ 2 := hsqrel.symm
        _ = (Real.sqrt 3) ^ 2 * z.im ^ 2 := by ring
        _ = 3 * z.im ^ 2 := by rw [hs2]
    have hre : (z ^ 3).re = 0 := by rw [hre_formula, hsq']; ring
    rw [Complex.normSq_apply]
    norm_num [pureCubicValue, Complex.add_re, Complex.add_im, hre]
    nlinarith [sq_nonneg (z ^ 3).im]
  · have hlin : -Real.sqrt 3 * z.im = -z.re := by linarith
    have hsqrel := congrArg (fun q : ℝ => q ^ 2) hlin
    have hsq' : z.re ^ 2 = 3 * z.im ^ 2 := by
      calc
        z.re ^ 2 = (-z.re) ^ 2 := by ring
        _ = (-Real.sqrt 3 * z.im) ^ 2 := hsqrel.symm
        _ = (Real.sqrt 3) ^ 2 * z.im ^ 2 := by ring
        _ = 3 * z.im ^ 2 := by rw [hs2]
    have hre : (z ^ 3).re = 0 := by rw [hre_formula, hsq']; ring
    rw [Complex.normSq_apply]
    norm_num [pureCubicValue, Complex.add_re, Complex.add_im, hre]
    nlinarith [sq_nonneg (z ^ 3).im]

theorem pure_boundary_avoids {b c : ℝ} (hb : 0 < b) (hc : 0 ≤ c) (hcb : c < b)
    {z : ℂ} (hline : z.re = 0 ∨ Real.sqrt 3 * z.im + z.re = 0 ∨
      -Real.sqrt 3 * z.im + z.re = 0) :
    z ∉ pureSublevel b c := by
  intro hz
  have hnorm : ‖pureCubicValue b z‖ ≤ c := hz
  have hsq : Complex.normSq (pureCubicValue b z) ≤ c ^ 2 := by
    rw [Complex.normSq_eq_norm_sq]
    exact pow_le_pow_left₀ (norm_nonneg _) hnorm 2
  have hge := pure_boundary_normSq_ge hb.le hline
  rw [Complex.normSq_eq_norm_sq] at hge hsq
  have hcb2 : c ^ 2 < b ^ 2 := by
    have hpos : 0 < (b - c) * (b + c) :=
      mul_pos (sub_pos.mpr hcb) (add_pos_of_pos_of_nonneg hb hc)
    nlinarith
  nlinarith

theorem negative_on_component {S : Set ℂ} {r : ℂ} {φ : ℂ → ℝ}
    (hφ : Continuous φ) (hzero : ∀ z ∈ S, φ z ≠ 0) (hr : r ∈ S) (hneg : φ r < 0) :
    ∀ z ∈ connectedComponentIn S r, φ z < 0 := by
  intro z hz
  by_contra hnonneg
  obtain ⟨w, hw, hwzero⟩ :=
    isPreconnected_connectedComponentIn.intermediate_value
      (mem_connectedComponentIn hr) hz hφ.continuousOn
      (show (0 : ℝ) ∈ Set.Icc (φ r) (φ z) from ⟨hneg.le, le_of_not_gt hnonneg⟩)
  exact hzero w (connectedComponentIn_subset S r hw) hwzero

theorem pure_component_stays_leftWedge {b c : ℝ} (hb : 0 < b) (hc : 0 ≤ c)
    (hcb : c < b) {r : ℂ} (hr : r ∈ pureSublevel b c) (hrw : leftWedge r) :
    ∀ z ∈ connectedComponentIn (pureSublevel b c) r, leftWedge z := by
  have hzero0 : ∀ z ∈ pureSublevel b c, z.re ≠ 0 := by
    intro z hz hline
    exact pure_boundary_avoids hb hc hcb (Or.inl hline) hz
  have hzero1 : ∀ z ∈ pureSublevel b c,
      Real.sqrt 3 * z.im + z.re ≠ 0 := by
    intro z hz hline
    exact pure_boundary_avoids hb hc hcb (Or.inr (Or.inl hline)) hz
  have hzero2 : ∀ z ∈ pureSublevel b c,
      -Real.sqrt 3 * z.im + z.re ≠ 0 := by
    intro z hz hline
    exact pure_boundary_avoids hb hc hcb (Or.inr (Or.inr hline)) hz
  intro z hz
  have hx := negative_on_component (S := pureSublevel b c) (r := r)
    (φ := fun w : ℂ => w.re) (by fun_prop) hzero0 hr hrw.1 z hz
  have hu := negative_on_component (S := pureSublevel b c) (r := r)
    (φ := fun w : ℂ => Real.sqrt 3 * w.im + w.re) (by fun_prop) hzero1 hr
    (by linarith [hrw.2.1]) z hz
  have hlo := negative_on_component (S := pureSublevel b c) (r := r)
    (φ := fun w : ℂ => -Real.sqrt 3 * w.im + w.re) (by fun_prop) hzero2 hr
    (by linarith [hrw.2.2]) z hz
  exact ⟨hx, by linarith, by linarith⟩

def pureRealPart (b : ℝ) (z : ℂ) : ℝ :=
  z.re ^ 3 - 3 * z.re * z.im ^ 2 + b

def pureImagPart (z : ℂ) : ℝ :=
  3 * z.re ^ 2 * z.im - z.im ^ 3

def pureRealFirst (z v : ℂ) : ℝ :=
  3 * z.re ^ 2 * v.re - 3 * v.re * z.im ^ 2 -
    6 * z.re * z.im * v.im

def pureImagFirst (z v : ℂ) : ℝ :=
  6 * z.re * v.re * z.im + 3 * z.re ^ 2 * v.im -
    3 * z.im ^ 2 * v.im

def pureRealSecond (z v : ℂ) : ℝ :=
  6 * z.re * v.re ^ 2 - 12 * v.re * z.im * v.im -
    6 * z.re * v.im ^ 2

def pureImagSecond (z v : ℂ) : ℝ :=
  6 * v.re ^ 2 * z.im + 12 * z.re * v.re * v.im -
    6 * z.im * v.im ^ 2

def pureNormSq (b : ℝ) (z : ℂ) : ℝ :=
  pureRealPart b z ^ 2 + pureImagPart z ^ 2

def pureNormSqFirst (b : ℝ) (z v : ℂ) : ℝ :=
  2 * (pureRealPart b z * pureRealFirst z v +
    pureImagPart z * pureImagFirst z v)

def pureNormSqSecond (b : ℝ) (z v : ℂ) : ℝ :=
  2 * (pureRealFirst z v ^ 2 + pureImagFirst z v ^ 2 +
    pureRealPart b z * pureRealSecond z v +
    pureImagPart z * pureImagSecond z v)

theorem pureNormSq_eq (b : ℝ) (z : ℂ) :
    pureNormSq b z = Complex.normSq (pureCubicValue b z) := by
  norm_num [pureNormSq, pureRealPart, pureImagPart, pureCubicValue,
    Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
  ring

theorem pureRealPart_line_hasDerivAt (b : ℝ) (z v : ℂ) (t : ℝ) :
    HasDerivAt
      (fun s : ℝ => pureRealPart b (z + (s : ℂ) * v))
      (pureRealFirst (z + (t : ℂ) * v) v) t := by
  have hx := Erdos1047CubicBarrier.line_re_hasDerivAt z v t
  have hy := Erdos1047CubicBarrier.line_im_hasDerivAt z v t
  have hraw := ((hx.pow 3).sub ((hx.mul (hy.pow 2)).const_mul 3)).const_add b
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [pureRealPart, pow_succ]
    ring
  · simp [pureRealFirst, pow_succ]
    ring

theorem pureImagPart_line_hasDerivAt (z v : ℂ) (t : ℝ) :
    HasDerivAt
      (fun s : ℝ => pureImagPart (z + (s : ℂ) * v))
      (pureImagFirst (z + (t : ℂ) * v) v) t := by
  have hx := Erdos1047CubicBarrier.line_re_hasDerivAt z v t
  have hy := Erdos1047CubicBarrier.line_im_hasDerivAt z v t
  have hraw := (((hx.pow 2).mul hy).const_mul 3).sub (hy.pow 3)
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [pureImagPart, pow_succ]
    ring
  · simp [pureImagFirst, pow_succ]
    ring

theorem pureRealFirst_line_hasDerivAt (z v : ℂ) (t : ℝ) :
    HasDerivAt
      (fun s : ℝ => pureRealFirst (z + (s : ℂ) * v) v)
      (pureRealSecond (z + (t : ℂ) * v) v) t := by
  have hx := Erdos1047CubicBarrier.line_re_hasDerivAt z v t
  have hy := Erdos1047CubicBarrier.line_im_hasDerivAt z v t
  have hraw := (((hx.pow 2).const_mul (3 * v.re)).sub
    ((hy.pow 2).const_mul (3 * v.re))).sub
    ((hx.mul hy).const_mul (6 * v.im))
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [pureRealFirst, pow_succ]
    ring
  · simp [pureRealSecond, pow_succ]
    ring

theorem pureImagFirst_line_hasDerivAt (z v : ℂ) (t : ℝ) :
    HasDerivAt
      (fun s : ℝ => pureImagFirst (z + (s : ℂ) * v) v)
      (pureImagSecond (z + (t : ℂ) * v) v) t := by
  have hx := Erdos1047CubicBarrier.line_re_hasDerivAt z v t
  have hy := Erdos1047CubicBarrier.line_im_hasDerivAt z v t
  have hraw := ((((hx.mul hy).const_mul (6 * v.re)).add
    ((hx.pow 2).const_mul (3 * v.im))).sub
    ((hy.pow 2).const_mul (3 * v.im)))
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [pureImagFirst, pow_succ]
    ring
  · simp [pureImagSecond, pow_succ]
    ring

theorem pureNormSq_line_hasDerivAt (b : ℝ) (z v : ℂ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => pureNormSq b (z + (s : ℂ) * v))
      (pureNormSqFirst b (z + (t : ℂ) * v) v) t := by
  have hr := pureRealPart_line_hasDerivAt b z v t
  have hi := pureImagPart_line_hasDerivAt z v t
  have hraw := (hr.pow 2).add (hi.pow 2)
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [pureNormSq]
  · simp [pureNormSqFirst, pow_succ]
    ring

theorem pureNormSqFirst_line_hasDerivAt (b : ℝ) (z v : ℂ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => pureNormSqFirst b (z + (s : ℂ) * v) v)
      (pureNormSqSecond b (z + (t : ℂ) * v) v) t := by
  have hr := pureRealPart_line_hasDerivAt b z v t
  have hi := pureImagPart_line_hasDerivAt z v t
  have hr1 := pureRealFirst_line_hasDerivAt z v t
  have hi1 := pureImagFirst_line_hasDerivAt z v t
  have hraw := ((hr.mul hr1).const_mul 2).add ((hi.mul hi1).const_mul 2)
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [pureNormSqFirst]
    ring
  · simp [pureNormSqSecond, pow_succ]
    ring

theorem pureNormSqFirst_eq (b : ℝ) (z v : ℂ) :
    pureNormSqFirst b z v =
      2 * (star (pureCubicValue b z) * (3 * z ^ 2) * v).re := by
  simp only [pureNormSqFirst, pureRealPart, pureImagPart, pureRealFirst,
    pureImagFirst, pureCubicValue]
  simp only [Complex.mul_re, Complex.mul_im, Complex.conj_re, Complex.conj_im]
  norm_num [pow_succ]
  ring

theorem pureNormSqSecond_eq (b : ℝ) (z v : ℂ) :
    pureNormSqSecond b z v =
      2 * (Complex.normSq (3 * z ^ 2) * Complex.normSq v +
        (star (pureCubicValue b z) * (6 * z) * v ^ 2).re) := by
  norm_num [pureNormSqSecond, pureRealPart, pureImagPart, pureRealFirst,
    pureImagFirst, pureRealSecond, pureImagSecond, pureCubicValue,
    Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
  ring

theorem pureNormSqSecond_pos_of_ratio
    {b : ℝ} {z v : ℂ} (hpd : 3 * z ^ 2 ≠ 0) (hv : v ≠ 0)
    (hfirst : pureNormSqFirst b z v = 0)
    (hq : 0 < (1 - pureCubicValue b z * (6 * z) /
      (3 * z ^ 2) ^ 2).re) :
    0 < pureNormSqSecond b z v := by
  by_cases hp : pureCubicValue b z = 0
  · rw [pureNormSqSecond_eq, hp]
    have hpdpos : 0 < Complex.normSq (3 * z ^ 2) :=
      Complex.normSq_pos.mpr hpd
    have hvpos : 0 < Complex.normSq v := Complex.normSq_pos.mpr hv
    have hpos : 0 < 2 * (Complex.normSq (3 * z ^ 2) * Complex.normSq v) :=
      mul_pos (by norm_num) (mul_pos hpdpos hvpos)
    simpa using hpos
  · rw [pureNormSqSecond_eq]
    apply Erdos1047CubicBarrier.stationary_second_pos_of_ratio hpd hp hv ?_ hq
    rw [pureNormSqFirst_eq] at hfirst
    linarith

theorem pure_line_no_local_max
    (b : ℝ) (z v : ℂ) (t : ℝ)
    (hpd : 3 * (z + (t : ℂ) * v) ^ 2 ≠ 0) (hv : v ≠ 0)
    (hq : 0 < (1 - pureCubicValue b (z + (t : ℂ) * v) *
      (6 * (z + (t : ℂ) * v)) /
        (3 * (z + (t : ℂ) * v) ^ 2) ^ 2).re) :
    ¬ IsLocalMax (fun s : ℝ => pureNormSq b (z + (s : ℂ) * v)) t := by
  let f : ℝ → ℝ := fun s => pureNormSq b (z + (s : ℂ) * v)
  let g : ℝ → ℝ := fun s => pureNormSqFirst b (z + (s : ℂ) * v) v
  have hf : ∀ s : ℝ, HasDerivAt f (g s) s := by
    intro s
    exact pureNormSq_line_hasDerivAt b z v s
  have hg : HasDerivAt g (pureNormSqSecond b
      (z + (t : ℂ) * v) v) t := by
    exact pureNormSqFirst_line_hasDerivAt b z v t
  have hderiv : deriv f = g := by
    funext s
    exact (hf s).deriv
  intro hmax
  have hfirst : pureNormSqFirst b (z + (t : ℂ) * v) v = 0 := by
    have hzero := hmax.deriv_eq_zero
    rw [hderiv] at hzero
    exact hzero
  have hsecond : 0 < deriv (deriv f) t := by
    rw [hderiv, hg.deriv]
    exact pureNormSqSecond_pos_of_ratio hpd hv hfirst hq
  exact (Erdos1047CubicBarrier.not_isLocalMax_of_deriv_deriv_pos
    (hf t).continuousAt hsecond (by rw [hderiv]; exact hfirst)) hmax

theorem pure_segment_normSq_le_max_endpoints
    (b : ℝ) (z v : ℂ) (hv : v ≠ 0)
    (hpd : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
      3 * (z + (t : ℂ) * v) ^ 2 ≠ 0)
    (hq : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
      0 < (1 - pureCubicValue b (z + (t : ℂ) * v) *
        (6 * (z + (t : ℂ) * v)) /
          (3 * (z + (t : ℂ) * v) ^ 2) ^ 2).re) :
    ∀ t ∈ Set.Icc (0 : ℝ) 1,
      pureNormSq b (z + (t : ℂ) * v) ≤
        max (pureNormSq b z) (pureNormSq b (z + v)) := by
  let f : ℝ → ℝ := fun s => pureNormSq b (z + (s : ℂ) * v)
  have hfcont : ContinuousOn f (Set.Icc (0 : ℝ) 1) := by
    dsimp [f]
    unfold pureNormSq pureRealPart pureImagPart
    fun_prop
  have hno : ∀ t ∈ Set.Ioo (0 : ℝ) 1, ¬ IsLocalMax f t := by
    intro t ht
    apply pure_line_no_local_max b z v t
    · exact hpd t ht
    · exact hv
    · exact hq t ht
  have hmax := Erdos1047CubicBarrier.le_max_endpoints_of_no_isLocalMax
    (f := f) (by norm_num : (0 : ℝ) < 1) hfcont hno
  intro t ht
  simpa [f] using hmax t ht

/-! Combining the wedge barrier with the segment calculus gives a complete
    conditional convexity theorem for the pure-cubic branch.  The remaining
    normalized-cubic argument therefore only has to handle the two-critical
    point branch. -/
theorem pure_component_convex_of_subcritical
    {b c : ℝ} (hb : 0 < b) (hc : 0 ≤ c) (hcb : c < b) {r : ℂ}
    (hr : r ∈ pureSublevel b c) (hrw : leftWedge r) :
    Convex ℝ (connectedComponentIn (pureSublevel b c) r) := by
  let K : Set ℂ := pureSublevel b c
  let C : Set ℂ := connectedComponentIn K r
  have hregion : ∀ z ∈ C, leftWedge z := by
    intro z hz
    exact pure_component_stays_leftWedge hb hc hcb hr hrw z hz
  apply Erdos1047CubicBarrier.convex_connectedComponentIn_of_segment_subset K r
  intro x y hx hy
  rintro w ⟨a, b', ha, hb', hab, rfl⟩
  have hparam : a • x + b' • y = x + (b' : ℂ) * (y - x) := by
    rw [Complex.real_smul, Complex.real_smul]
    have hab' : (a : ℂ) + (b' : ℂ) = 1 := by exact_mod_cast hab
    linear_combination x * hab'
  rw [hparam]
  by_cases hv : y - x = 0
  · have hxy : y = x := sub_eq_zero.mp hv
    rw [hxy, sub_self, mul_zero, add_zero]
    exact connectedComponentIn_subset K r hx
  · have hline_region : ∀ t ∈ Set.Icc (0 : ℝ) 1,
        leftWedge (x + (t : ℂ) * (y - x)) := by
      intro t ht
      have hconv := leftWedge_convex (hregion x hx) (hregion y hy)
        (sub_nonneg.mpr ht.2) ht.1 (by ring : (1 - t) + t = 1)
      have heq : x + (t : ℂ) * (y - x) = (1 - t) • x + t • y := by
        apply Complex.ext <;>
          norm_num [Complex.real_smul, Complex.mul_re, Complex.mul_im] <;> ring
      rw [heq]
      exact hconv
    have hpd : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
        3 * (x + (t : ℂ) * (y - x)) ^ 2 ≠ 0 := by
      intro t ht
      have hzw := leftWedge_zero_not_mem (hline_region t ⟨ht.1.le, ht.2.le⟩)
      exact mul_ne_zero (by norm_num) (pow_ne_zero 2 hzw)
    have hq : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
        0 < (1 - pureCubicValue b (x + (t : ℂ) * (y - x)) *
          (6 * (x + (t : ℂ) * (y - x))) /
            (3 * (x + (t : ℂ) * (y - x)) ^ 2) ^ 2).re := by
      intro t ht
      exact pure_cubic_ratio_pos hb (hline_region t ⟨ht.1.le, ht.2.le⟩)
    have hseg := pure_segment_normSq_le_max_endpoints b x (y - x) hv hpd hq
    have hxK : ‖pureCubicValue b x‖ ≤ c := by
      simpa [K, pureSublevel] using (connectedComponentIn_subset K r hx)
    have hyK : ‖pureCubicValue b y‖ ≤ c := by
      simpa [K, pureSublevel] using (connectedComponentIn_subset K r hy)
    have hxSq : pureNormSq b x ≤ c ^ 2 := by
      rw [pureNormSq_eq, Complex.normSq_eq_norm_sq]
      exact pow_le_pow_left₀ (norm_nonneg _) hxK 2
    have hySq : pureNormSq b (x + (y - x)) ≤ c ^ 2 := by
      rw [show x + (y - x) = y by ring]
      rw [pureNormSq_eq, Complex.normSq_eq_norm_sq]
      exact pow_le_pow_left₀ (norm_nonneg _) hyK 2
    have hbound : pureNormSq b (x + (b' : ℂ) * (y - x)) ≤ c ^ 2 := by
      exact le_trans (hseg b' ⟨hb', by linarith⟩) (max_le hxSq hySq)
    have hnormsq : Complex.normSq
        (pureCubicValue b (x + (b' : ℂ) * (y - x))) ≤ c ^ 2 := by
      simpa [pureNormSq_eq] using hbound
    have hnorm : ‖pureCubicValue b (x + (b' : ℂ) * (y - x))‖ ≤ c := by
      rw [Complex.normSq_eq_norm_sq] at hnormsq
      nlinarith [norm_nonneg (pureCubicValue b (x + (b' : ℂ) * (y - x)))]
    simpa [K, pureSublevel] using hnorm

/-! Above the critical level the pure branch has a particularly simple global
    geometry.  The value at the origin is `b`; along every ray the cubic value
    is a convex combination of its value at the endpoint and `b`.  Thus the
    whole sublevel is star-convex at the origin whenever `c ≥ b`. -/
theorem pureSublevel_starConvex_of_le {b c : ℝ} (hb : 0 ≤ b) (hbc : b ≤ c) :
    StarConvex ℝ 0 (pureSublevel b c) := by
  intro z hz a t ha ht hat
  change ‖pureCubicValue b (a • (0 : ℂ) + t • z)‖ ≤ c
  rw [smul_zero, zero_add]
  change ‖pureCubicValue b z‖ ≤ c at hz
  have ht1 : t ≤ 1 := by linarith
  have ht3 : 0 ≤ t ^ 3 := pow_nonneg ht _
  have ht31 : t ^ 3 ≤ 1 := by
    nlinarith [sq_nonneg t, mul_nonneg ht (sub_nonneg.mpr ht1)]
  have hid : pureCubicValue b (t • z) =
      (t ^ 3 : ℂ) * pureCubicValue b z + (1 - t ^ 3 : ℂ) * (b : ℂ) := by
    simp [pureCubicValue, Complex.real_smul]
    ring
  rw [hid]
  calc
    ‖(t ^ 3 : ℂ) * pureCubicValue b z +
        (1 - t ^ 3 : ℂ) * (b : ℂ)‖ ≤
        ‖(t ^ 3 : ℂ) * pureCubicValue b z‖ +
          ‖(1 - t ^ 3 : ℂ) * (b : ℂ)‖ := norm_add_le _ _
    _ = t ^ 3 * ‖pureCubicValue b z‖ + (1 - t ^ 3) * b := by
      rw [norm_mul, norm_mul]
      have hcast0 : (t : ℂ) ^ 3 = ((t ^ 3 : ℝ) : ℂ) := by
        norm_num
      have hcast1 : (1 : ℂ) - ((t ^ 3 : ℝ) : ℂ) =
          ((1 - t ^ 3 : ℝ) : ℂ) := by
        norm_num
      rw [hcast0, hcast1]
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ht3]
      rw [Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (sub_nonneg.mpr ht31)]
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hb]
    _ ≤ t ^ 3 * c + (1 - t ^ 3) * c := by
      gcongr
    _ = c := by ring

theorem pure_one_left_anchor_mem {c : ℝ} (hc : 0 ≤ c) :
    (-1 : ℂ) ∈ pureSublevel 1 c := by
  change ‖pureCubicValue 1 (-1 : ℂ)‖ ≤ c
  norm_num [pureCubicValue]
  exact hc

theorem pure_one_left_component_convex_of_subcritical {c : ℝ}
    (hc : 0 ≤ c) (hcb : c < 1) :
    Convex ℝ (connectedComponentIn (pureSublevel 1 c) (-1 : ℂ)) := by
  apply pure_component_convex_of_subcritical (b := 1) (c := c)
    (by norm_num) hc hcb
  · exact pure_one_left_anchor_mem hc
  · norm_num [leftWedge]

end

end Erdos1047PureCubic

