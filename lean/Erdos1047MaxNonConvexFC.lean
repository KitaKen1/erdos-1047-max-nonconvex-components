      norm_num [Complex.real_smul, Complex.mul_re, Complex.mul_im] <;> ring
  rw [← heq]
  simpa [g, v] using hineq

def p3LeftSublevel : Set ℂ :=
  {z ∈ p3LeftStrip | p3NormSqFormula z ≤ p3Level ^ 2}

theorem p3LeftSublevel_convex : Convex ℝ p3LeftSublevel := by
  exact p3NormSqFormula_convexOn_strip.convex_le (p3Level ^ 2)

theorem p3LeftAnchor_mem_sublevel : p3LeftAnchor ∈ p3LeftSublevel := by
  constructor
  · change (-9 / 4 : ℝ) ≤ p3LeftAnchor.re ∧ p3LeftAnchor.re ≤ -39 / 20
    norm_num [p3LeftAnchor]
  · rw [p3NormSqFormula_eq, Complex.normSq_eq_norm_sq]
    have hk := p3LeftAnchor_mem
    change ‖p3Polynomial.eval p3LeftAnchor‖ ≤ p3Level at hk
    have hn := norm_nonneg (p3Polynomial.eval p3LeftAnchor)
    have hc : 0 ≤ p3Level := by norm_num [p3Level]
    nlinarith

theorem p3LeftSublevel_subset_full :
    p3LeftSublevel ⊆ sublevelSet p3Polynomial p3Level := by
  rintro z ⟨_, hsq⟩
  change ‖p3Polynomial.eval z‖ ≤ p3Level
  rw [p3NormSqFormula_eq, Complex.normSq_eq_norm_sq] at hsq
  exact (sq_le_sq₀ (norm_nonneg _) (by norm_num [p3Level])).mp hsq

theorem p3_left_component_eq_sublevel :
    connectedComponentIn (sublevelSet p3Polynomial p3Level) p3LeftAnchor =
      p3LeftSublevel := by
  apply Set.Subset.antisymm
  · intro z hz
    constructor
    · exact p3_left_component_subset_strip hz
    · rw [p3NormSqFormula_eq, Complex.normSq_eq_norm_sq]
      have hzK := connectedComponentIn_subset
        (sublevelSet p3Polynomial p3Level) p3LeftAnchor hz
      change ‖p3Polynomial.eval z‖ ≤ p3Level at hzK
      have hn := norm_nonneg (p3Polynomial.eval z)
      have hc : 0 ≤ p3Level := by norm_num [p3Level]
      nlinarith
  · exact p3LeftSublevel_convex.isPreconnected.subset_connectedComponentIn
      p3LeftAnchor_mem_sublevel p3LeftSublevel_subset_full

theorem p3Left_component_convex :
    Convex ℝ (connectedComponentIn
      (sublevelSet p3Polynomial p3Level) p3LeftAnchor) := by
  rw [p3_left_component_eq_sublevel]
  exact p3LeftSublevel_convex

/-- The explicit cubic has exactly two non-convex components. -/
theorem p3_nonconvex_ncard_eq_two_exact :
    {t ∈ componentsIn (sublevelSet p3Polynomial p3Level) |
      ¬ Convex ℝ t}.ncard = 2 :=
  p3_nonconvex_ncard_eq_two p3Left_component_convex

end

