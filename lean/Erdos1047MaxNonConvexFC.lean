    (polynomial.eval (anchor + (t : ℂ) * (pointB - anchor)))]

theorem midpoint_norm_gt :
    level < ‖polynomial.eval (midpoint ℝ pointA pointB)‖ := by
  have hgt : level ^ 2 <
