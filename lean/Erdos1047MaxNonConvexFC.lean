/-!
# Strict quadratic audit for the current Formal Conjectures target

This file is deliberately independent of the closed-sublevel, root-count
formalization in `Erdos1047MaxNonConvexFC`.  It records an exact witness for
the *current* upstream target, whose set is `strictSublevelSet` and whose
definition has no component-count hypothesis.
-/

open Polynomial
open Set

namespace Erdos1047StrictQuadraticAudit

noncomputable section

def polynomial : ℂ[X] := X ^ 2 - 1
def level : ℝ := 6 / 5
def anchor : ℂ := 0
def pointA : ℂ := 1 + Complex.I / 2
def pointB : ℂ := -1 + Complex.I / 2

theorem polynomial_monic : polynomial.Monic := by
  change (X ^ 2 - C (1 : ℂ)).Monic
  apply (monic_X_pow 2).sub_of_left
  rw [degree_C (by norm_num), degree_X_pow]
  norm_num

theorem polynomial_degree : polynomial.natDegree = 2 := by
  change (X ^ 2 - C (1 : ℂ)).natDegree = 2
  have hsub : (C (1 : ℂ) : ℂ[X]).natDegree < (X ^ 2 : ℂ[X]).natDegree := by
    rw [natDegree_C, natDegree_X_pow]
    norm_num
  rw [natDegree_sub_eq_left_of_natDegree_lt hsub, natDegree_X_pow]

private theorem parametric_normSq (t : ℝ) :
    Complex.normSq (polynomial.eval ((t : ℂ) * pointA)) =
      25 / 16 * t ^ 4 - 3 / 2 * t ^ 2 + 1 := by
  norm_num [polynomial, pointA, Complex.normSq, pow_succ,
    Complex.mul_re, Complex.mul_im, Complex.sub_re, Complex.sub_im]
  ring

private theorem parametric_normSq_B (t : ℝ) :
    Complex.normSq (polynomial.eval ((t : ℂ) * pointB)) =
      25 / 16 * t ^ 4 - 3 / 2 * t ^ 2 + 1 := by
  norm_num [polynomial, pointB, Complex.normSq, pow_succ,
    Complex.mul_re, Complex.mul_im, Complex.sub_re, Complex.sub_im]
  ring

private theorem parametric_bound (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    25 / 16 * t ^ 4 - 3 / 2 * t ^ 2 + 1 < level ^ 2 := by
  have hsq : t ^ 2 ≤ 1 := by nlinarith [sq_nonneg (1 - t), sq_nonneg t]
  have hfour : t ^ 4 ≤ t ^ 2 := by
    nlinarith [mul_nonneg (sq_nonneg t) (sub_nonneg.mpr hsq)]
  norm_num [level]
  nlinarith

theorem lineA_strict :
    ∀ z ∈ segment ℝ anchor pointA,
      z ∈ Erdos1047.strictSublevelSet polynomial level := by
  intro z hz
  change ‖polynomial.eval z‖ < level
  have hseg := Erdos1047CubicLower.segment_strict_of_parametric_normSq_lt
    (F := fun w : ℂ => polynomial.eval w) (c := level)
    (r := anchor) (a := pointA) (by norm_num [level]) (by
      intro t ht0 ht1
      simpa [anchor] using (show
        Complex.normSq (polynomial.eval ((t : ℂ) * pointA)) < level ^ 2 from by
          rw [parametric_normSq]
          exact parametric_bound t ht0 ht1))
  exact hseg z hz

theorem lineB_strict :
    ∀ z ∈ segment ℝ anchor pointB,
      z ∈ Erdos1047.strictSublevelSet polynomial level := by
  intro z hz
  change ‖polynomial.eval z‖ < level
  have hseg := Erdos1047CubicLower.segment_strict_of_parametric_normSq_lt
    (F := fun w : ℂ => polynomial.eval w) (c := level)
    (r := anchor) (a := pointB) (by norm_num [level]) (by
      intro t ht0 ht1
      simpa [anchor] using (show
        Complex.normSq (polynomial.eval ((t : ℂ) * pointB)) < level ^ 2 from by
          rw [parametric_normSq_B]
          exact parametric_bound t ht0 ht1))
  exact hseg z hz

theorem midpoint_outside :
    midpoint ℝ pointA pointB ∉ Erdos1047.strictSublevelSet polynomial level := by
  change ¬ ‖polynomial.eval (midpoint ℝ pointA pointB)‖ < level
  have hsq : level ^ 2 <
      Complex.normSq (polynomial.eval (midpoint ℝ pointA pointB)) := by
    norm_num [level, polynomial, pointA, pointB, midpoint,
      AffineMap.lineMap_apply_module, Complex.normSq, pow_succ,
      Complex.mul_re, Complex.mul_im, Complex.sub_re, Complex.sub_im]
  rw [Complex.normSq_eq_norm_sq] at hsq
  have hc : 0 ≤ level := by norm_num [level]
  nlinarith [norm_nonneg (polynomial.eval (midpoint ℝ pointA pointB))]

private theorem strict_starConvex :
    StarConvex ℝ anchor (Erdos1047.strictSublevelSet polynomial level) := by
  intro z hz a b ha hb hab
  change ‖polynomial.eval (a • anchor + b • z)‖ < level
  have hb1 : b ≤ 1 := by linarith
  have hb2 : 0 ≤ b ^ 2 := sq_nonneg b
  have hb2one : b ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg ha (sub_nonneg.mpr hb1)]
  have hz' : ‖polynomial.eval z‖ < level := hz
  have hq : ‖polynomial.eval anchor‖ < level := by
    norm_num [polynomial, anchor, level]
  have hid : polynomial.eval (a • anchor + b • z) =
      (b ^ 2 : ℂ) * polynomial.eval z +
        ((1 - b ^ 2 : ℝ) : ℂ) * polynomial.eval anchor := by
    rw [Complex.real_smul, Complex.real_smul]
    simp [polynomial, anchor]
    push_cast
    ring
  rw [hid]
  have htriangle :
      ‖(b ^ 2 : ℂ) * polynomial.eval z +
          ((1 - b ^ 2 : ℝ) : ℂ) * polynomial.eval anchor‖ ≤
        b ^ 2 * ‖polynomial.eval z‖ +
          (1 - b ^ 2) * ‖polynomial.eval anchor‖ := by
    calc
      ‖(b ^ 2 : ℂ) * polynomial.eval z +
          ((1 - b ^ 2 : ℝ) : ℂ) * polynomial.eval anchor‖ ≤
        ‖(b ^ 2 : ℂ) * polynomial.eval z‖ +
          ‖((1 - b ^ 2 : ℝ) : ℂ) * polynomial.eval anchor‖ := norm_add_le _ _
      _ = b ^ 2 * ‖polynomial.eval z‖ +
          (1 - b ^ 2) * ‖polynomial.eval anchor‖ := by
        rw [norm_mul, norm_mul, norm_pow, Complex.norm_real, Complex.norm_real]
        simp [abs_of_nonneg hb2, abs_of_nonneg (sub_nonneg.mpr hb2one)]
  have hweighted :
      b ^ 2 * ‖polynomial.eval z‖ +
          (1 - b ^ 2) * ‖polynomial.eval anchor‖ < level := by
    by_cases hs : b ^ 2 = 1
    · rw [hs]
      norm_num
      exact hz'
    · have hslt : b ^ 2 < 1 := lt_of_le_of_ne hb2one hs
      have hfirst : b ^ 2 * ‖polynomial.eval z‖ ≤ b ^ 2 * level :=
        mul_le_mul_of_nonneg_left hz'.le hb2
      have hsecond : (1 - b ^ 2) * ‖polynomial.eval anchor‖ <
          (1 - b ^ 2) * level := by
        exact mul_lt_mul_of_pos_left hq (sub_pos.mpr hslt)
      nlinarith
  exact lt_of_le_of_lt htriangle hweighted

private theorem strict_isPreconnected :
    IsPreconnected (Erdos1047.strictSublevelSet polynomial level) := by
  have hanchor : anchor ∈ Erdos1047.strictSublevelSet polynomial level := by
    change ‖polynomial.eval anchor‖ < level
    norm_num [polynomial, anchor, level]
  exact (strict_starConvex.isPathConnected hanchor).isConnected.isPreconnected

private theorem strict_components_eq_singleton :
    Erdos1047.componentsIn
      (Erdos1047.strictSublevelSet polynomial level) =
        {Erdos1047.strictSublevelSet polynomial level} := by
  rw [Erdos1047.componentsIn]
  ext t
  constructor
  · rintro ⟨z, hz, rfl⟩
    exact Set.mem_singleton_iff.mpr
      (strict_isPreconnected.connectedComponentIn hz)
  · intro ht
    have hanchor : anchor ∈ Erdos1047.strictSublevelSet polynomial level := by
      change ‖polynomial.eval anchor‖ < level
      norm_num [polynomial, anchor, level]
    refine ⟨anchor, hanchor, ?_⟩
    exact (Set.mem_singleton_iff.mp ht).trans
      (strict_isPreconnected.connectedComponentIn hanchor).symm

private theorem strict_components_ncard :
    (Erdos1047.componentsIn
      (Erdos1047.strictSublevelSet polynomial level)).ncard = 1 := by
  rw [strict_components_eq_singleton]
  simp

theorem component_not_convex :
    ¬ Convex ℝ (connectedComponentIn
      (Erdos1047.strictSublevelSet polynomial level) anchor) := by
  apply Erdos1047CubicLower.component_not_convex_of_segments
  · exact lineA_strict
  · exact lineB_strict
  · exact midpoint_outside

theorem strict_quadratic_nonconvex_component_exists :
    ∃ t ∈ Erdos1047.componentsIn
      (Erdos1047.strictSublevelSet polynomial level), ¬ Convex ℝ t := by
  refine ⟨connectedComponentIn
    (Erdos1047.strictSublevelSet polynomial level) anchor, ?_, component_not_convex⟩
  exact ⟨anchor, by
    change ‖polynomial.eval anchor‖ < level
    norm_num [polynomial, anchor, level], rfl⟩

theorem strict_quadratic_attains_one :
    1 ∈ {k : ℕ | ∃ (f : ℂ[X]) (c : ℝ), f.Monic ∧ f.natDegree = 2 ∧ 0 < c ∧
      {t ∈ Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) |
        ¬ Convex ℝ t}.ncard = k} := by
  refine ⟨polynomial, level, ?_, ?_, ?_, ?_⟩
  · exact polynomial_monic
  · exact polynomial_degree
  · norm_num [level]
  · have hcomp : connectedComponentIn
        (Erdos1047.strictSublevelSet polynomial level) anchor =
        Erdos1047.strictSublevelSet polynomial level := by
      exact strict_isPreconnected.connectedComponentIn (by
        change ‖polynomial.eval anchor‖ < level
        norm_num [polynomial, anchor, level])
    have hnc : ¬ Convex ℝ (Erdos1047.strictSublevelSet polynomial level) := by
      rw [← hcomp]
      exact component_not_convex
    have hncset :
        {t ∈ Erdos1047.componentsIn
          (Erdos1047.strictSublevelSet polynomial level) | ¬ Convex ℝ t} =
            {Erdos1047.strictSublevelSet polynomial level} := by
      rw [strict_components_eq_singleton]
      ext t
      simp only [Set.mem_setOf_eq, Set.mem_singleton_iff]
      constructor
      · intro h
        exact h.1
      · intro h
        subst t
        exact ⟨rfl, hnc⟩
    rw [hncset]
    simp

#print axioms strict_quadratic_nonconvex_component_exists
#print axioms strict_quadratic_attains_one

end
end Erdos1047StrictQuadraticAudit

end

