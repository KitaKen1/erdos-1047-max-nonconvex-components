      (powerLinearPolynomial n).Separable ∧
      ((powerLinearPolynomial n).rootSet ℂ).ncard = n := by
  exact ⟨Erdos1047PowerLinear.monic hn,
    Erdos1047PowerLinear.natDegree hn,
    Erdos1047PowerLinear.separable hn,
    Erdos1047PowerLinear.rootSet_ncard hn⟩

theorem powerLinearPolynomial_mem_rootSet_iff {n : ℕ} (hn : 2 ≤ n) (z : ℂ) :
    z ∈ (powerLinearPolynomial n).rootSet ℂ ↔
      z = 0 ∨ z ^ (n - 1) = (n : ℂ) := by
  simpa [powerLinearPolynomial] using
