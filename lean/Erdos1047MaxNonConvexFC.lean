open Polynomial
open Filter Topology Set
open Erdos1047
open Erdos1047PureCubic

namespace Erdos1047PureCubicUpper
noncomputable section

def pureValueSublevel (B : ℂ) (c : ℝ) : Set ℂ :=
  {z : ℂ | ‖z ^ 3 + B‖ ≤ c}

theorem pure_affine_component_convex
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3)
    (hlin : Erdos1047CubicNormalize.cubicLinear f = 0)
    {a B : ℂ} (ha : a ≠ 0) (hB : a ^ 3 = B)
    (hBf : Erdos1047CubicNormalize.cubicConstant f = B)
    {c : ℝ} (hc : 0 < c) (hsub : c / ‖a‖ ^ 3 < 1) :
    ∃ t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c), Convex ℝ t := by
  let S : Set ℂ := pureSublevel 1 (c / ‖a‖ ^ 3)
  let K : Set ℂ := Erdos1047.sublevelSet f c
  let center : ℂ := Erdos1047CubicNormalize.cubicCenter f
  have hapos : 0 < ‖a‖ ^ 3 := by positivity
  have hc' : 0 ≤ c / ‖a‖ ^ 3 := by positivity
  have hanchor : (-1 : ℂ) ∈ S := by
    exact pure_one_left_anchor_mem hc'
  have heval : ∀ z : ℂ, f.eval (center + a * z) =
      a ^ 3 * (z ^ 3 + (1 : ℂ)) := by
    intro z
    rw [show center = Erdos1047CubicNormalize.cubicCenter f by rfl]
    rw [Erdos1047CubicNormalize.monic_cubic_eval_center_add f hf hdeg]
    rw [hlin, hBf, ← hB]
    rw [mul_pow]
    ring
  have himage : (fun z : ℂ => center + a * z) '' S = K := by
    ext w
    constructor
    · rintro ⟨z, hz, rfl⟩
      change ‖f.eval (center + a * z)‖ ≤ c
      rw [heval, norm_mul, norm_pow]
      change ‖z ^ 3 + (1 : ℂ)‖ ≤ c / ‖a‖ ^ 3 at hz
      calc
        ‖a‖ ^ 3 * ‖z ^ 3 + (1 : ℂ)‖ ≤
            ‖a‖ ^ 3 * (c / ‖a‖ ^ 3) :=
          mul_le_mul_of_nonneg_left hz (by positivity)
        _ = c := by field_simp
    · intro hw
      change ‖f.eval w‖ ≤ c at hw
      let z : ℂ := (w - center) / a
      have hmap : center + a * z = w := by
        dsimp [z]
        field_simp [ha]
        ring
      have heq : a ^ 3 * (z ^ 3 + (1 : ℂ)) = f.eval w := by
        rw [← hmap, heval]
      refine ⟨z, ?_, hmap⟩
      change ‖z ^ 3 + (1 : ℂ)‖ ≤ c / ‖a‖ ^ 3
      apply (le_div_iff₀ hapos).2
      calc
        ‖z ^ 3 + (1 : ℂ)‖ * ‖a‖ ^ 3 =
            ‖a‖ ^ 3 * ‖z ^ 3 + (1 : ℂ)‖ := mul_comm _ _
        _ = ‖f.eval w‖ := by rw [← heq, norm_mul, norm_pow]
        _ ≤ c := hw
  have hconvS : Convex ℝ (connectedComponentIn S (-1 : ℂ)) := by
    dsimp [S]
    exact pure_one_left_component_convex_of_subcritical hc' hsub
  have hconvImage : Convex ℝ (connectedComponentIn
      ((fun z : ℂ => center + a * z) '' S) (center + a * (-1 : ℂ))) := by
    exact (Erdos1047CubicNormalize.affine_image_connectedComponentIn_convex_iff
      center a ha hanchor).2 hconvS
  rw [himage] at hconvImage
  have hanchorK : center + a * (-1 : ℂ) ∈ K := by
    rw [← himage]
    exact ⟨-1, hanchor, rfl⟩
  refine ⟨connectedComponentIn K (center + a * (-1 : ℂ)), ?_, hconvImage⟩
  exact ⟨center + a * (-1 : ℂ), hanchorK, rfl⟩

theorem pure_components_ncard_le_one_of_connected
    {K : Set ℂ} (hK : IsConnected K) :
    (Erdos1047.componentsIn K).ncard ≤ 1 := by
  have hsub : Erdos1047.componentsIn K ⊆ {K} := by
    intro t ht
    rcases ht with ⟨z, hz, rfl⟩
    rw [hK.isPreconnected.connectedComponentIn hz]
    simp
  simpa using Set.ncard_le_ncard hsub (Set.finite_singleton K)

theorem pure_cubic_convex_component
    (f : ℂ[X]) (c : ℝ) (hf : f.Monic) (hdeg : f.natDegree = 3)
    (hcount : (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard =
      (f.rootSet ℂ).ncard)
    (hsep : f.Separable)
    (hlin : Erdos1047CubicNormalize.cubicLinear f = 0)
    (hB : Erdos1047CubicNormalize.cubicConstant f ≠ 0)
    (hc : 0 < c) :
    ∃ t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c), Convex ℝ t := by
  obtain ⟨a, ha3⟩ := IsAlgClosed.exists_pow_nat_eq
    (Erdos1047CubicNormalize.cubicConstant f) (by norm_num : (0 : ℕ) < 3)
  have ha : a ≠ 0 := by
    intro ha0
    subst a
    simp at ha3
    exact hB ha3.symm
  let ρ : ℝ := ‖a‖ ^ 3
  have hρ : 0 < ρ := by dsimp [ρ]; positivity
  by_cases hsub : c / ρ < 1
  · apply pure_affine_component_convex f hf hdeg hlin ha ha3 rfl hc
    simpa [ρ] using hsub
  · have hge : 1 ≤ c / ρ := le_of_not_gt hsub
    let S : Set ℂ := pureSublevel 1 (c / ρ)
    let K : Set ℂ := Erdos1047.sublevelSet f c
    let center : ℂ := Erdos1047CubicNormalize.cubicCenter f
    have hc' : 0 ≤ c / ρ := by positivity
    have hanchor : (0 : ℂ) ∈ S := by
      change ‖pureCubicValue 1 (0 : ℂ)‖ ≤ c / ρ
      norm_num [pureCubicValue]
      exact hge
    have hstar : StarConvex ℝ 0 S := by
      dsimp [S]
      exact pureSublevel_starConvex_of_le (b := 1) (c := c / ρ)
        (by norm_num) hge
    have hSconn : IsConnected S := by
      letI : ContractibleSpace S := hstar.contractibleSpace ⟨0, hanchor⟩
      exact (isPathConnected_iff_pathConnectedSpace.mpr inferInstance).isConnected
    have heval : ∀ z : ℂ, f.eval (center + a * z) =
        a ^ 3 * (z ^ 3 + (1 : ℂ)) := by
      intro z
      rw [show center = Erdos1047CubicNormalize.cubicCenter f by rfl]
      rw [Erdos1047CubicNormalize.monic_cubic_eval_center_add f hf hdeg]
      rw [hlin, ← ha3]
      rw [mul_pow]
      ring
    have himage : (fun z : ℂ => center + a * z) '' S = K := by
      ext w
      constructor
      · rintro ⟨z, hz, rfl⟩
        change ‖f.eval (center + a * z)‖ ≤ c
        rw [heval, norm_mul, norm_pow]
        change ‖z ^ 3 + (1 : ℂ)‖ ≤ c / ρ at hz
        calc
          ρ * ‖z ^ 3 + (1 : ℂ)‖ ≤ ρ * (c / ρ) :=
            mul_le_mul_of_nonneg_left hz hρ.le
          _ = c := by dsimp [ρ]; field_simp
      · intro hw
        change ‖f.eval w‖ ≤ c at hw
        let z : ℂ := (w - center) / a
        have hmap : center + a * z = w := by
          dsimp [z]
          field_simp [ha]
          ring
        have heq : a ^ 3 * (z ^ 3 + (1 : ℂ)) = f.eval w := by
          rw [← hmap, heval]
        refine ⟨z, ?_, hmap⟩
        change ‖z ^ 3 + (1 : ℂ)‖ ≤ c / ρ
        apply (le_div_iff₀ hρ).2
        calc
          ‖z ^ 3 + (1 : ℂ)‖ * ρ =
              ρ * ‖z ^ 3 + (1 : ℂ)‖ := mul_comm _ _
          _ = ‖f.eval w‖ := by rw [← heq, norm_mul, norm_pow]
          _ ≤ c := hw
    have hKconn : IsConnected K := by
      rw [← himage]
      exact hSconn.image _ (by fun_prop)
    have hcomp : (Erdos1047.componentsIn K).ncard ≤ 1 :=
      pure_components_ncard_le_one_of_connected hKconn
    have hroot : (f.rootSet ℂ).ncard = 3 := by
      have hcard : Fintype.card (f.rootSet ℂ) = f.natDegree :=
        Polynomial.card_rootSet_eq_natDegree hsep (IsAlgClosed.splits _)
      simpa [hdeg] using hcard
    rw [hcount, hroot] at hcomp
    omega

end
