/-!
# Power-linear family for Erdős #1047

This core records the family

`P_n(z) = z^n - n z`.

Its nonzero critical points satisfy `z^(n-1)=1` and all have the same
critical-value modulus `n-1`.  The geometric statement about strict
sublevel components is deliberately kept separate; this file supplies the
algebraic and critical-value facts needed by that argument.
-/

open Polynomial

namespace Erdos1047PowerLinear

noncomputable section

/-- The power-linear candidate of degree `n`. -/
def polynomial (n : ℕ) : ℂ[X] := X ^ n - C (n : ℂ) * X

theorem eval (n : ℕ) (z : ℂ) :
    (polynomial n).eval z = z ^ n - (n : ℂ) * z := by
  simp [polynomial]

theorem monic {n : ℕ} (hn : 2 ≤ n) : (polynomial n).Monic := by
  unfold polynomial
  have hcn : (n : ℂ) ≠ 0 := by
    exact_mod_cast (show n ≠ 0 by omega)
  have hdeg : (C (n : ℂ) * X : ℂ[X]).degree < (X ^ n : ℂ[X]).degree := by
    rw [degree_C_mul hcn, degree_X, degree_X_pow]
    exact_mod_cast hn
  exact (monic_X_pow n).sub_of_left hdeg

theorem natDegree {n : ℕ} (hn : 2 ≤ n) :
    (polynomial n).natDegree = n := by
  unfold polynomial
  have hcn : (n : ℂ) ≠ 0 := by
    exact_mod_cast (show n ≠ 0 by omega)
  have hdeg : (C (n : ℂ) * X : ℂ[X]).natDegree < (X ^ n : ℂ[X]).natDegree := by
    rw [natDegree_C_mul hcn, natDegree_X, natDegree_X_pow]
    exact hn
  rw [natDegree_sub_eq_left_of_natDegree_lt hdeg]
  simp

theorem derivative :
    (polynomial n).derivative = C (n : ℂ) * (X ^ (n - 1) - C (1 : ℂ)) := by
  unfold polynomial
  rw [derivative_sub, derivative_pow, derivative_mul, derivative_C,
    derivative_X]
  simp
  ring

/-! The displayed factorisation is also an exact description of the critical
    points.  This iff is more useful than a one-way estimate when the family
    is used as a regular-value candidate. -/
theorem derivative_eval_zero_iff {n : ℕ} (hn : 2 ≤ n) (z : ℂ) :
    (polynomial n).derivative.eval z = 0 ↔ z ^ (n - 1) = 1 := by
  rw [derivative]
  simp only [eval_mul, eval_C, eval_sub, eval_pow, eval_X]
  have hn0 : (n : ℂ) ≠ 0 := by
    exact_mod_cast (show n ≠ 0 by omega)
  constructor
  · intro h
    apply sub_eq_zero.mp
    exact (mul_eq_zero.mp h).resolve_left hn0
  · intro h
    rw [h]
    ring

theorem factorization {n : ℕ} (hn : 1 ≤ n) :
    polynomial n = X * (X ^ (n - 1) - C (n : ℂ)) := by
  apply Polynomial.funext
  intro z
  simp [polynomial]
  rw [show n = (n - 1) + 1 by omega, pow_succ]
  have hexp : n - 1 + 1 - 1 = n - 1 := by omega
  have hsum : n - 1 + 1 = n := by omega
  rw [hexp, hsum]
  ring

theorem separable {n : ℕ} (hn : 2 ≤ n) : (polynomial n).Separable := by
  rw [factorization (by omega)]
  have hX : (X : ℂ[X]).Separable := by
    simpa using (separable_X (R := ℂ))
  have hpow : (X ^ (n - 1) - C (n : ℂ) : ℂ[X]).Separable := by
    apply Polynomial.separable_X_pow_sub_C
    · exact_mod_cast (show n - 1 ≠ 0 by omega)
    · intro h
      have hcn : (n : ℂ) ≠ 0 := by
        exact_mod_cast (show n ≠ 0 by omega)
      exact hcn h
  apply hX.mul hpow
  rw [Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed (k := ℂ)
    ℂ X (X ^ (n - 1) - C (n : ℂ))]
  intro z
  by_cases hz : z = 0
  · right
    have hcn : (n : ℂ) ≠ 0 := by
      exact_mod_cast (show n ≠ 0 by omega)
    intro h
    have h' : (n : ℂ) = 0 := by
      simpa [hz, zero_pow (show n - 1 ≠ 0 by omega)] using h
    exact hcn h'
  · left
    simpa using hz

theorem rootSet_ncard {n : ℕ} (hn : 2 ≤ n) :
    ((polynomial n).rootSet ℂ).ncard = n := by
  have hcard : Fintype.card ((polynomial n).rootSet ℂ) =
      (polynomial n).natDegree :=
    Polynomial.card_rootSet_eq_natDegree (separable hn) (IsAlgClosed.splits _)
  simpa [natDegree hn] using hcard

/-! The factorisation gives a usable pointwise description of the roots. -/
theorem mem_rootSet_iff {n : ℕ} (hn : 2 ≤ n) (z : ℂ) :
    z ∈ (polynomial n).rootSet ℂ ↔
      z = 0 ∨ z ^ (n - 1) = (n : ℂ) := by
  rw [(monic hn).mem_rootSet]
  change (polynomial n).eval z = 0 ↔
    z = 0 ∨ z ^ (n - 1) = (n : ℂ)
  rw [factorization (by omega), eval_mul]
  simp only [eval_X, eval_sub, eval_pow, eval_C, mul_eq_zero]
  constructor
  · intro h
    rcases h with h | h
    · left
      exact h
    · right
      exact sub_eq_zero.mp h
  · intro h
    rcases h with h | h
    · left
      exact h
    · right
      exact sub_eq_zero.mpr h

theorem nonzero_root_pow_eq_natCast {n : ℕ} (hn : 2 ≤ n) {z : ℂ}
    (hz : z ∈ (polynomial n).rootSet ℂ) (hz0 : z ≠ 0) :
    z ^ (n - 1) = (n : ℂ) := by
  rcases (mem_rootSet_iff hn z).mp hz with hzero | hpow
  · exact (hz0 hzero).elim
  · exact hpow

theorem nonzero_root_norm_pow_eq_natCast {n : ℕ} (hn : 2 ≤ n) {z : ℂ}
    (hz : z ∈ (polynomial n).rootSet ℂ) (hz0 : z ≠ 0) :
    ‖z‖ ^ (n - 1) = (n : ℝ) := by
  have hpow := nonzero_root_pow_eq_natCast hn hz hz0
  rw [← norm_pow, hpow]
  norm_num

theorem nonzero_root_norm_pos {z : ℂ} (hz0 : z ≠ 0) :
    0 < ‖z‖ := norm_pos_iff.mpr hz0

/-! Nonzero roots all lie on one circle, and multiplication by an
    `(n−1)`-st root of unity is the natural symmetry of this family. -/
theorem nonzero_root_norm_eq {n : ℕ} (hn : 2 ≤ n) {z w : ℂ}
    (hz : z ∈ (polynomial n).rootSet ℂ) (hz0 : z ≠ 0)
    (hw : w ∈ (polynomial n).rootSet ℂ) (hw0 : w ≠ 0) :
    ‖z‖ = ‖w‖ := by
  apply (pow_left_inj₀ (norm_nonneg z) (norm_nonneg w) (by omega : n - 1 ≠ 0)).mp
  rw [nonzero_root_norm_pow_eq_natCast hn hz hz0,
    nonzero_root_norm_pow_eq_natCast hn hw hw0]

theorem eval_mul_root_of_unity {n : ℕ} (hn : 2 ≤ n) {u z : ℂ}
    (hu : u ^ (n - 1) = 1) :
    (polynomial n).eval (u * z) = u * (polynomial n).eval z := by
  rw [eval n (u * z), eval n z]
  have hun : u ^ n = u := by
    rw [show n = (n - 1) + 1 by omega, pow_succ, hu]
    ring
  rw [mul_pow, hun]
  ring

theorem norm_eval_mul_root_of_unity {n : ℕ} (hn : 2 ≤ n) {u z : ℂ}
    (hu : u ^ (n - 1) = 1) :
    ‖(polynomial n).eval (u * z)‖ = ‖(polynomial n).eval z‖ := by
  have hunormpow : ‖u‖ ^ (n - 1) = 1 := by
    rw [← norm_pow, hu, norm_one]
  have hunorm : ‖u‖ = 1 := by
    exact (pow_eq_one_iff_of_nonneg (norm_nonneg u)
      (by omega : n - 1 ≠ 0)).mp hunormpow
  rw [eval_mul_root_of_unity hn hu, norm_mul, hunorm, one_mul]

theorem mul_root_of_unity_mem_rootSet {n : ℕ} (hn : 2 ≤ n) {u z : ℂ}
    (hu : u ^ (n - 1) = 1) (hz : z ∈ (polynomial n).rootSet ℂ) :
    u * z ∈ (polynomial n).rootSet ℂ := by
  apply (monic hn).mem_rootSet.mpr
  change (polynomial n).eval (u * z) = 0
  rw [eval_mul_root_of_unity hn hu]
  have hzero : (polynomial n).eval z = 0 := (monic hn).mem_rootSet.mp hz
  rw [hzero, mul_zero]

/-! Critical points on the nonzero branch have a common critical modulus. -/
theorem critical_point_eval {n : ℕ} {s : ℂ}
    (hs : s ^ (n - 1) = 1) :
    (polynomial n).derivative.eval s = 0 := by
  rw [derivative]
  simp [hs]

theorem critical_point_value {n : ℕ} (hn : 2 ≤ n) {s : ℂ}
    (hs : s ^ (n - 1) = 1) :
    (polynomial n).eval s = -(n - 1 : ℂ) * s := by
  rw [eval]
  have hpow : s ^ n = s := by
    rw [show n = (n - 1) + 1 by omega, pow_succ, hs]
    ring
  rw [hpow]
  ring

theorem critical_point_norm {n : ℕ} (hn : 2 ≤ n) {s : ℂ}
    (hs : s ^ (n - 1) = 1) :
    ‖(polynomial n).eval s‖ = n - 1 := by
  have hs0 : s ≠ 0 := by
    intro hz
    rw [hz] at hs
    have hpow : (0 : ℂ) ^ (n - 1) = 0 := zero_pow (by omega)
    rw [hpow] at hs
    norm_num at hs
  have hnormpow : ‖s‖ ^ (n - 1) = 1 := by
    rw [← norm_pow, hs, norm_one]
  have hnorm : ‖s‖ = 1 := by
    have hnonneg : 0 ≤ ‖s‖ := norm_nonneg s
    exact (pow_eq_one_iff_of_nonneg hnonneg (by omega : n - 1 ≠ 0)).mp hnormpow
  rw [critical_point_value hn hs, norm_mul, norm_neg, hnorm]
  simp only [mul_one]
  have hcast : (n : ℂ) - 1 = ((n - 1 : ℕ) : ℂ) := by
    norm_num [Nat.cast_sub (by omega : 1 ≤ n)]
  calc
    ‖(n : ℂ) - 1‖ = ‖((n - 1 : ℕ) : ℂ)‖ := by rw [hcast]
    _ = (n - 1 : ℝ) := by
      rw [RCLike.norm_natCast]
      norm_num [Nat.cast_sub (by omega : 1 ≤ n)]

theorem critical_value_norm_eq {n : ℕ} (hn : 2 ≤ n) {z : ℂ}
    (hz : (polynomial n).derivative.eval z = 0) :
    ‖(polynomial n).eval z‖ = n - 1 := by
  exact critical_point_norm hn ((derivative_eval_zero_iff hn z).mp hz)

theorem critical_value_norm_ge {n : ℕ} (hn : 2 ≤ n) (z : ℂ)
    (hz : (polynomial n).derivative.eval z = 0) :
    n - 1 ≤ ‖(polynomial n).eval z‖ := by
  exact (critical_value_norm_eq hn hz).ge

end
end Erdos1047PowerLinear

end

