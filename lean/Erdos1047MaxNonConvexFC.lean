      mul_nonneg (sub_nonneg.mpr hs1) (by linarith)
    have hstep : 0 ≤ s ^ 2 * (1 - s) :=
      mul_nonneg (sq_nonneg s) (sub_nonneg.mpr hs1)
    nlinarith [hsq, hstep]
  have ha1 : 1 - s ^ 3 ≤ 1 := by
    nlinarith [pow_nonneg hs0 3]
  have hb0 : 0 ≤ s ^ 2 * (1 - s) :=
    mul_nonneg (sq_nonneg s) (sub_nonneg.mpr hs1)
  have hx : 1 ≤ (r + 2).re := by
    norm_num [Complex.add_re]
    linarith
  have hfac : 0 ≤ s ^ 2 * (3 - 2 * s) * (2 * s ^ 3 - 3 * s ^ 2 + 2) := by
    have hfirst : 0 ≤ s ^ 2 := sq_nonneg s
    have hsecond : 0 ≤ 3 - 2 * s := by nlinarith
    have hthird : 0 ≤ 2 * s ^ 3 - 3 * s ^ 2 + 2 := by
      nlinarith [mul_nonneg (sq_nonneg s) (sub_nonneg.mpr (show s ≤ 3 / 2 by nlinarith))]
    exact mul_nonneg (mul_nonneg hfirst hsecond) hthird
  have hscalar : 0 ≤ 1 - (1 - s ^ 3) ^ 2 +
      6 * (1 - s ^ 3) * (s ^ 2 * (1 - s)) -
      9 * (s ^ 2 * (1 - s)) ^ 2 := by
    convert hfac using 1 <;> ring
  have hnormsq : Complex.normSq
      (-((1 - s ^ 3 : ℝ) : ℂ) * (r + 2) +
        3 * ((s ^ 2 : ℝ) : ℂ) * ((1 - s : ℝ) : ℂ)) ≤ Complex.normSq (r + 2) := by
    have hnormA : 0 ≤ Complex.normSq (r + 2) - ((r + 2).re) ^ 2 := by
      simp only [Complex.normSq_apply]
      nlinarith [sq_nonneg (r + 2).im]
    have hcoef : 0 ≤ 1 - (1 - s ^ 3) ^ 2 := by nlinarith
    have hA : ((r + 2).re) ^ 2 ≤ Complex.normSq (r + 2) := by
      rw [Complex.normSq_apply]
      nlinarith [sq_nonneg (r + 2).im]
    have hlin : 0 ≤ ((r + 2).re) - 1 := by linarith
    have hmul : 0 ≤ 6 * (1 - s ^ 3) * (s ^ 2 * (1 - s)) := by positivity
    have hsq : 0 ≤ (s ^ 2 * (1 - s)) ^ 2 := sq_nonneg _
    have hnormA' : 0 ≤ Complex.normSq (2 + r) - (r.re + 2) ^ 2 := by
      simpa [add_comm, Complex.normSq_apply] using hnormA
    have hA' : (r.re + 2) ^ 2 ≤ Complex.normSq (2 + r) := by
      simpa [add_comm, Complex.normSq_apply] using hA
    have hN1 : 1 ≤ Complex.normSq (2 + r) := by
      nlinarith [hA', sq_nonneg ((r.re + 2) - 1)]
