theorem positive_on_preconnected {S : Set ℂ} {r : ℂ} {φ : ℂ → ℝ}
    (hS : IsPreconnected S) (hφ : Continuous φ) (hzero : ∀ z ∈ S, φ z ≠ 0)
    (hr : r ∈ S) (hpos : 0 < φ r) : ∀ z ∈ S, 0 < φ z := by
  intro z hz
  by_contra hnonpos
  obtain ⟨w, hw, hwzero⟩ :=
    hS.intermediate_value hz hr hφ.continuousOn
      (show (0 : ℝ) ∈ Set.Icc (φ z) (φ r) from ⟨le_of_not_gt hnonpos, hpos.le⟩)
  exact hzero w hw hwzero

/-! Half-line variants of the coordinate barrier lemmas.  These are the
    precise form needed when an avoided horizontal line is known only on one
    side of the imaginary axis: first trap the component in that half-plane,
    then apply the sign argument to the height function. -/
theorem connectedComponentIn_im_gt_of_left_halfline_avoids
    {S : Set ℂ} {r : ℂ} (y0 : ℝ)
    (hzeroRe : ∀ z ∈ S, z.re ≠ 0) (hr : r ∈ S) (hrRe : r.re < 0)
    (hrIm : y0 < r.im)
    (hbarrier : ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (y0 : ℂ) * Complex.I ∉ S) :
    ∀ z ∈ connectedComponentIn S r, y0 < z.im := by
  let C := connectedComponentIn S r
  have hleft : ∀ z ∈ C, z.re < 0 := by
    exact connectedComponentIn_re_lt_of_avoids 0 hzeroRe hr hrRe
  have hpos := positive_on_preconnected (S := C) (r := r)
    (φ := fun z : ℂ ↦ z.im - y0) isPreconnected_connectedComponentIn
    (by fun_prop)
    (by
      intro z hz hzero
      have hzS : z ∈ S := connectedComponentIn_subset S r hz
      have hx : z.re ≤ 0 := (hleft z hz).le
      have hrepr : z = (z.re : ℂ) + (y0 : ℂ) * Complex.I := by
        apply Complex.ext <;> simp
        linarith
      rw [hrepr] at hzS
      exact hbarrier z.re hx hzS)
    (mem_connectedComponentIn hr) (by linarith)
  intro z hz
  linarith [hpos z hz]

theorem connectedComponentIn_im_lt_of_left_halfline_avoids
    {S : Set ℂ} {r : ℂ} (y0 : ℝ)
    (hzeroRe : ∀ z ∈ S, z.re ≠ 0) (hr : r ∈ S) (hrRe : r.re < 0)
    (hrIm : r.im < y0)
    (hbarrier : ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (y0 : ℂ) * Complex.I ∉ S) :
    ∀ z ∈ connectedComponentIn S r, z.im < y0 := by
  let C := connectedComponentIn S r
  have hleft : ∀ z ∈ C, z.re < 0 := by
    exact connectedComponentIn_re_lt_of_avoids 0 hzeroRe hr hrRe
  have hpos := positive_on_preconnected (S := C) (r := r)
    (φ := fun z : ℂ ↦ y0 - z.im) isPreconnected_connectedComponentIn
    (by fun_prop)
    (by
      intro z hz hzero
      have hzS : z ∈ S := connectedComponentIn_subset S r hz
      have hx : z.re ≤ 0 := (hleft z hz).le
      have hrepr : z = (z.re : ℂ) + (y0 : ℂ) * Complex.I := by
        apply Complex.ext <;> simp
        linarith
      rw [hrepr] at hzS
      exact hbarrier z.re hx hzS)
    (mem_connectedComponentIn hr) (by linarith)
  intro z hz
  linarith [hpos z hz]

/-! Right-half-line analogues.  These are needed for a pair of new roots
    lying to the right of the imaginary axis: the real-axis barrier is only
    required for `0 ≤ Re z`, so the sign argument is applied after trapping
