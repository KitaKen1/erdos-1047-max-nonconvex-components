/-!
# Strict robust-certificate bookkeeping (Formal Conjectures target)

The proved core already contains the corresponding argument for closed
sublevel sets.  This module records the strict variant separately: a positive
certificate margin turns the two witness segments into strict members of the
open sublevel, and the midpoint margin puts the midpoint outside.  The
result is a reusable finite-family lower bound, independent of the analytic
construction that produced the certificates.
-/

open Polynomial
open Set
open Erdos1047

namespace Erdos1047FCStrictCertificateCore

noncomputable section

open Erdos1047Proof

/-! If a witness already attains the degree bound, then its component/root
count equality forces all roots to be simple.  This supplies the separability
input required by the degree-raising packages, without assuming separability
in the registered attainable predicate. -/
theorem separable_of_maximal_attainable_witness
    {m : ℕ} (hmpos : 0 < m) (hm : m ∈ attainableNonConvexCounts m) :
    ∃ (f : ℂ[X]) (c : ℝ), f.Monic ∧ f.natDegree = m ∧ 0 < c ∧
      f.Separable ∧
      (componentsIn (sublevelSet f c)).ncard = (f.rootSet ℂ).ncard ∧
      {t ∈ componentsIn (sublevelSet f c) | ¬ Convex ℝ t}.ncard = m := by
  obtain ⟨f, c, hf, hdeg, hc, hcompRoot, hcount⟩ := hm
  have hrootpos : 0 < (f.rootSet ℂ).ncard :=
    rootSet_ncard_pos f hf (by omega)
  have hcompfin : (componentsIn (sublevelSet f c)).Finite := by
    apply Set.finite_of_ncard_pos
    rw [hcompRoot]
    exact hrootpos
  have hlower : m ≤ (componentsIn (sublevelSet f c)).ncard := by
    rw [← hcount]
    exact Set.ncard_le_ncard (by
      intro t ht
      exact ht.1) hcompfin
  have hrootle : (f.rootSet ℂ).ncard ≤ f.natDegree :=
    f.ncard_rootSet_le ℂ
  have hrootEq : (f.rootSet ℂ).ncard = m := by
    omega
  have hcard : Fintype.card (f.rootSet ℂ) = f.natDegree := by
    simpa [Set.ncard_coe_finset, hdeg] using hrootEq
  have hfsep : f.Separable :=
    (Polynomial.card_rootSet_eq_natDegree_iff_of_splits hf.ne_zero
      (IsAlgClosed.splits _)).mp hcard
  exact ⟨f, c, hf, hdeg, hc, hfsep, hcompRoot, hcount⟩

/-! Degree-raising wrapper with separability discharged from maximality.  A
future geometric provider only has to supply the scale, coprimality, regular
level, component separation, and non-convexity data for the witness returned
by the registered predicate. -/
theorem attainable_of_degree_raise_from_maximal_witness
    {m : ℕ} (hmge : 5 ≤ m)
    (hm : m ∈ attainableNonConvexCounts m)
    (hprovider : ∀ (p : ℂ[X]) (c₀ : ℝ),
      p.Monic → p.natDegree = m → 0 < c₀ →
      ∃ (L e : ℂ) (c : ℝ),
        e ≠ 0 ∧
        IsCoprime p (Erdos1047DegreeRaise.raiseFactor L (e ^ 2)) ∧
        0 < c ∧
        Metric.closedBall (0 : ℂ) c ⊆
          ((Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval ''
            {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p L
              (e ^ 2)).derivative.eval u = 0})ᶜ ∧
        Set.InjOn
          (fun z : ℂ => connectedComponentIn
            (sublevelSet
              (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)
          ((↑(p.rootSet ℂ) : Set ℂ) ∪
            ({L + e * Complex.I, L - e * Complex.I} : Set ℂ)) ∧
        (∀ z ∈
          ((↑(p.rootSet ℂ) : Set ℂ) ∪
            ({L + e * Complex.I, L - e * Complex.I} : Set ℂ)),
          ¬ Convex ℝ (connectedComponentIn
            (sublevelSet
              (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)) ) :
    m + 2 ∈ attainableNonConvexCounts (m + 2) := by
  obtain ⟨p, c₀, hp, hdeg, hc₀, hpsep, hroot, hcount⟩ :=
    separable_of_maximal_attainable_witness (m := m) (by omega) hm
  obtain ⟨L, e, c, he, hcop, hc, hreg, hcompInj, hnc⟩ :=
    hprovider p c₀ hp hdeg hc₀
  exact attainable_of_degree_raise_canonical_anchor_package_auto_mem
    hp hpsep hdeg he hcop hc hreg hcompInj hnc

/-! Strong-induction interface using the preceding wrapper.  The provider is
geometric only; separability of each maximal witness is recovered internally. -/
theorem proposed_answer_attainable_of_maximal_witness_raise_provider
    (hprovider : ∀ (m : ℕ), 5 ≤ m →
      ∀ (p : ℂ[X]) (c₀ : ℝ),
        p.Monic → p.natDegree = m → 0 < c₀ →
        ∃ (L e : ℂ) (c : ℝ),
          e ≠ 0 ∧
          IsCoprime p (Erdos1047DegreeRaise.raiseFactor L (e ^ 2)) ∧
          0 < c ∧
          Metric.closedBall (0 : ℂ) c ⊆
            ((Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)).eval ''
              {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p L
                (e ^ 2)).derivative.eval u = 0})ᶜ ∧
          Set.InjOn
            (fun z : ℂ => connectedComponentIn
              (sublevelSet
                (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)
            ((↑(p.rootSet ℂ) : Set ℂ) ∪
              ({L + e * Complex.I, L - e * Complex.I} : Set ℂ)) ∧
          (∀ z ∈
            ((↑(p.rootSet ℂ) : Set ℂ) ∪
              ({L + e * Complex.I, L - e * Complex.I} : Set ℂ)),
            ¬ Convex ℝ (connectedComponentIn
              (sublevelSet
                (Erdos1047DegreeRaise.raisePolynomial p L (e ^ 2)) c) z)) )
    (n : ℕ) (hn : 6 ≤ n) :
    maxNonConvexAnswer n ∈ attainableNonConvexCounts n := by
  have hstep : ∀ m : ℕ, 5 ≤ m →
      m ∈ attainableNonConvexCounts m →
        m + 2 ∈ attainableNonConvexCounts (m + 2) := by
    intro m hm hmax
    exact attainable_of_degree_raise_from_maximal_witness hm hmax
      (hprovider m hm)
  exact proposed_answer_attainable_six_le_of_degree_raise_step hstep n hn

theorem robust_not_convex_component_strict
    {F : ℂ → ℂ} {c : ℝ} {r a b : ℂ}
    (hcert : RobustNonconvexCertificate F c r a b) :
    ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖F z‖ < c} r) := by
  apply component_not_convex_of_segments
  · intro z hz
    change ‖F z‖ < c
    have hm := hcert.lineA_margin z hz
    linarith [hcert.eps_pos]
  · intro z hz
    change ‖F z‖ < c
    have hm := hcert.lineB_margin z hz
    linarith [hcert.eps_pos]
  · intro hm
    change ‖F (midpoint ℝ a b)‖ < c at hm
    linarith [hcert.midpoint_margin, hcert.eps_pos]

/-!
Uniform perturbations can be handled directly at the strict level.  This is
the form needed when a degree-raising polynomial is only known to be close to
the transported model on the two segments and at the midpoint.
-/
theorem robust_certificate_stable_strict
    {F G : ℂ → ℂ} {c : ℝ} {r a b : ℂ}
    (hcert : RobustNonconvexCertificate F c r a b)
    (hA : ∀ z ∈ segment ℝ r a, ‖G z - F z‖ < hcert.eps)
    (hB : ∀ z ∈ segment ℝ r b, ‖G z - F z‖ < hcert.eps)
    (hM : ‖G (midpoint ℝ a b) - F (midpoint ℝ a b)‖ < hcert.eps) :
    ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖G z‖ < c} r) := by
  apply component_not_convex_of_segments
  · intro z hz
    have htriangle : ‖G z‖ ≤ ‖F z‖ + ‖G z - F z‖ := by
      calc
        ‖G z‖ = ‖F z + (G z - F z)‖ := by congr 1 <;> ring
        _ ≤ ‖F z‖ + ‖G z - F z‖ := norm_add_le _ _
    have hclose := hA z hz
    have hmargin := hcert.lineA_margin z hz
    change ‖G z‖ < c
    linarith
  · intro z hz
    have htriangle : ‖G z‖ ≤ ‖F z‖ + ‖G z - F z‖ := by
      calc
        ‖G z‖ = ‖F z + (G z - F z)‖ := by congr 1 <;> ring
        _ ≤ ‖F z‖ + ‖G z - F z‖ := norm_add_le _ _
    have hclose := hB z hz
    have hmargin := hcert.lineB_margin z hz
    change ‖G z‖ < c
    linarith
  · intro hm
    have htriangle : ‖F (midpoint ℝ a b)‖ ≤
        ‖G (midpoint ℝ a b)‖ +
          ‖G (midpoint ℝ a b) - F (midpoint ℝ a b)‖ := by
      calc
        ‖F (midpoint ℝ a b)‖ =
            ‖G (midpoint ℝ a b) +
              (F (midpoint ℝ a b) - G (midpoint ℝ a b))‖ := by
                congr 1 <;> ring
        _ ≤ ‖G (midpoint ℝ a b)‖ +
              ‖F (midpoint ℝ a b) - G (midpoint ℝ a b)‖ := norm_add_le _ _
        _ = ‖G (midpoint ℝ a b)‖ +
              ‖G (midpoint ℝ a b) - F (midpoint ℝ a b)‖ := by
                rw [norm_sub_rev]
    have hclose := hM
    have hmargin := hcert.midpoint_margin
    change ‖G (midpoint ℝ a b)‖ < c at hm
    linarith

theorem nonconvex_ncard_ge_of_robust_certificate_family
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    {F : ℂ → ℂ} {c : ℝ} {r a b : ι → ℂ}
    (hcert : ∀ i, Nonempty (RobustNonconvexCertificate F c
      (r i) (a i) (b i)))
    (hrinj : Function.Injective r)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn
        {w : ℂ | ‖F w‖ < c} z)
      (Set.range r))
    (hcompfin : (Erdos1047.componentsIn
      {w : ℂ | ‖F w‖ < c}).Finite) :
    Fintype.card ι ≤
      {t ∈ Erdos1047.componentsIn {w : ℂ | ‖F w‖ < c} |
        ¬ Convex ℝ t}.ncard := by
  let S : Set ℂ := {w : ℂ | ‖F w‖ < c}
  let A : Set ℂ := Set.range r
  have hAfin : A.Finite := Set.finite_range _
  have hAcard : A.ncard = Fintype.card ι := by
    rw [Set.ncard_range_of_injective hrinj]
    simp
  have hmem : ∀ z ∈ A, z ∈ S := by
    rintro z ⟨i, rfl⟩
    obtain ⟨hc⟩ := hcert i
    have hm := hc.lineA_margin (r i)
      (left_mem_segment ℝ (r i) (a i))
    change ‖F (r i)‖ < c
    linarith [hc.eps_pos]
  have hnc : ∀ z ∈ A,
      ¬ Convex ℝ (connectedComponentIn S z) := by
    rintro z ⟨i, rfl⟩
    obtain ⟨hc⟩ := hcert i
    exact robust_not_convex_component_strict hc
  have hcompInj' : Set.InjOn
      (fun z : ℂ => connectedComponentIn S z) A := by
    simpa [S, A] using hcompInj
  have hcompfin' : (Erdos1047.componentsIn S).Finite := by
    simpa [S] using hcompfin
  simpa [S, A] using
    (Erdos1047Proof.nonconvex_ncard_ge_of_finite_witnesses
      hAfin hAcard hmem hcompInj' hnc hcompfin')

/-! A p₅-anchor wrapper that keeps endpoint maps abstract.  This avoids
depending on the generated FC object file while the source-level p₅ family
is still being reorganized. -/
theorem p5_anchor_family_nonconvex_lower_bound_strict
    {F : ℂ → ℂ} {c : ℝ} {a b : Fin 5 → ℂ}
    (hcert : ∀ i, Nonempty (RobustNonconvexCertificate F c
      (p5FiveAnchor i) (a i) (b i)))
    (hcompInj : Set.InjOn (fun z : ℂ => connectedComponentIn
      {w : ℂ | ‖F w‖ < c} z) (Set.range p5FiveAnchor))
    (hcompfin : (Erdos1047.componentsIn
      {w : ℂ | ‖F w‖ < c}).Finite) :
    5 ≤ {t ∈ Erdos1047.componentsIn {w : ℂ | ‖F w‖ < c} |
      ¬ Convex ℝ t}.ncard := by
  simpa using
    (nonconvex_ncard_ge_of_robust_certificate_family
      (ι := Fin 5) (r := p5FiveAnchor) (a := a) (b := b)
      hcert p5FiveAnchor_injective hcompInj hcompfin)

