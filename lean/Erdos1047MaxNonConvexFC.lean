/-! q₂-parameterized provider form.  It is enough to represent every point of
    the two witness segments by an upper-lobe inverse value with parameter norm
    below `c`; the midpoint only needs a parameter whose norm is above `c`. -/
theorem proposed_answer_attainable_even_of_upper_anchor_powered_provider
    (hprovider : ∀ m : ℕ, 2 ≤ m →
      ∃ (c : ℝ) (a b : ℂ),
        0 < c ∧ c < 1 ∧
        (∀ z ∈ segment ℝ (evenFamilyUpperAnchor m) a,
          ∃ w : ℂ, ‖w‖ < c ∧ z ^ m = q2InverseU w) ∧
        (∀ z ∈ segment ℝ (evenFamilyUpperAnchor m) b,
          ∃ w : ℂ, ‖w‖ < c ∧ z ^ m = q2InverseU w) ∧
        ∃ w : ℂ, c < ‖w‖ ∧
          (midpoint ℝ a b) ^ m = q2InverseU w)
    (m : ℕ) (hm : 2 ≤ m) :
    maxNonConvexAnswer (2 * m) ∈ attainableNonConvexCounts (2 * m) := by
  have hstrict : ∀ m' : ℕ, 2 ≤ m' →
      ∃ (c : ℝ) (a b : ℂ),
        0 < c ∧ c < 1 ∧
        (∀ z ∈ segment ℝ (evenFamilyUpperAnchor m') a,
          ‖(Erdos1047EvenFamily.evenFamilyPolynomial m').eval z‖ < c) ∧
        (∀ z ∈ segment ℝ (evenFamilyUpperAnchor m') b,
          ‖(Erdos1047EvenFamily.evenFamilyPolynomial m').eval z‖ < c) ∧
        c < ‖(Erdos1047EvenFamily.evenFamilyPolynomial m').eval
          (midpoint ℝ a b)‖ := by
    intro m' hm'
    obtain ⟨c, a, b, hc, hc1, hA, hB, hM⟩ := hprovider m' hm'
    refine ⟨c, a, b, hc, hc1, ?_, ?_, ?_⟩
    · intro z hz
      rcases hA z hz with ⟨w, hw, hzpow⟩
      exact evenFamily_norm_eval_lt_of_pow_eq_upper_inverse (m := m') hw hzpow
    · intro z hz
      rcases hB z hz with ⟨w, hw, hzpow⟩
      exact evenFamily_norm_eval_lt_of_pow_eq_upper_inverse (m := m') hw hzpow
    · rcases hM with ⟨w, hw, hzpow⟩
      exact lt_norm_evenFamily_eval_of_pow_eq_upper_inverse (m := m') hw hzpow
  exact proposed_answer_attainable_even_of_upper_anchor_strict_provider hstrict m hm

