section


/-!
# Exact component bookkeeping for the strict cubic certificate

The strict open sublevel of the explicit cubic has exactly three components.
Two are certified non-convex by the rational line segments, while the left
component is convex by the strip quadratic-form argument.  This file packages
those facts into an exact count of two non-convex components for the witness.
-/

open Polynomial
open Set

namespace Erdos1047StrictCubicExact

noncomputable section

open Erdos1047StrictCubicLower
open Erdos1047StrictLowDegreeAudit
open Erdos1047StrictGeneralCore
open Erdos1047CubicLower

theorem strict_three_component_set_ncard :
    let K := strictSublevelSet
    ({connectedComponentIn K p3LeftAnchor,
      connectedComponentIn K p3LowerAnchor,
      connectedComponentIn K (star p3LowerAnchor)} : Set (Set ℂ)).ncard = 3 := by
  dsimp only
  let K := strictSublevelSet
  let CL := connectedComponentIn K p3LeftAnchor
  let CD := connectedComponentIn K p3LowerAnchor
  let CU := connectedComponentIn K (star p3LowerAnchor)
  change ({CL, CD, CU} : Set (Set ℂ)).ncard = 3
  obtain ⟨h01, h02, h12⟩ := p3_strict_three_components_pairwise_distinct
  have h01' : CL ≠ CD := by simpa [CL, CD, K] using h01
  have h02' : CL ≠ CU := by simpa [CL, CU, K] using h02
  have h12' : CD ≠ CU := by simpa [CD, CU, K] using h12
  rw [Set.ncard_insert_of_notMem (by simp [h01', h02'])]
  rw [Set.ncard_insert_of_notMem (by simp [h12'])]
  simp

theorem strict_three_component_set_subset_componentsIn :
    let K := strictSublevelSet
    ({connectedComponentIn K p3LeftAnchor,
      connectedComponentIn K p3LowerAnchor,
      connectedComponentIn K (star p3LowerAnchor)} : Set (Set ℂ)) ⊆
        Erdos1047StrictCubicLower.componentsIn K := by
  dsimp only
  simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
  exact ⟨⟨p3LeftAnchor,
      strictLeftSublevel_subset_full p3LeftAnchor_mem_strict, rfl⟩,
    ⟨p3LowerAnchor, p3LowerAnchor_mem_strict, rfl⟩,
    ⟨star p3LowerAnchor, p3UpperAnchor_mem_strict, rfl⟩⟩

theorem strict_componentsIn_ncard :
    (Erdos1047StrictCubicLower.componentsIn strictSublevelSet).ncard = 3 := by
  have hfin : (Erdos1047StrictCubicLower.componentsIn strictSublevelSet).Finite := by
    rw [Erdos1047StrictCubicLower.strict_componentsIn_eq_image_rootSet]
    exact (p3Polynomial.rootSet_finite ℂ).image _
  have hlower : 3 ≤ (Erdos1047StrictCubicLower.componentsIn strictSublevelSet).ncard := by
    rw [← strict_three_component_set_ncard]
    exact Set.ncard_le_ncard strict_three_component_set_subset_componentsIn hfin
  have hupper : (Erdos1047StrictCubicLower.componentsIn strictSublevelSet).ncard ≤ 3 :=
    strict_componentsIn_ncard_le_three
  omega

theorem strict_componentsIn_eq_three :
    let K := strictSublevelSet
    Erdos1047StrictCubicLower.componentsIn K =
      {connectedComponentIn K p3LeftAnchor,
        connectedComponentIn K p3LowerAnchor,
        connectedComponentIn K (star p3LowerAnchor)} := by
  dsimp only
  symm
  refine Set.eq_of_subset_of_ncard_le strict_three_component_set_subset_componentsIn ?_
    (ht := ?_)
  · rw [strict_componentsIn_ncard, strict_three_component_set_ncard]
  · rw [Erdos1047StrictCubicLower.strict_componentsIn_eq_image_rootSet]
    exact (p3Polynomial.rootSet_finite ℂ).image _

theorem strict_two_le_nonconvex_ncard :
    2 ≤ {t ∈ Erdos1047StrictCubicLower.componentsIn strictSublevelSet |
      ¬ Convex ℝ t}.ncard := by
  let K := strictSublevelSet
  let CD := connectedComponentIn K p3LowerAnchor
  let CU := connectedComponentIn K (star p3LowerAnchor)
  let N := {t ∈ Erdos1047StrictCubicLower.componentsIn K | ¬ Convex ℝ t}
  have hpair : ({CD, CU} : Set (Set ℂ)).ncard = 2 := by
    obtain ⟨_, _, hne⟩ := p3_strict_three_components_pairwise_distinct
    have hne' : CD ≠ CU := by simpa [CD, CU, K] using hne
    simp [hne']
  have hpairsub : ({CD, CU} : Set (Set ℂ)) ⊆ N := by
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
    constructor
    · exact ⟨⟨p3LowerAnchor, p3LowerAnchor_mem_strict, rfl⟩,
        p3Lower_component_not_convex_strict⟩
    · exact ⟨⟨star p3LowerAnchor, p3UpperAnchor_mem_strict, rfl⟩,
        p3Upper_component_not_convex_strict⟩
  have hcomponentsFinite :
      (Erdos1047StrictCubicLower.componentsIn K).Finite := by
    rw [Erdos1047StrictCubicLower.strict_componentsIn_eq_image_rootSet]
    exact (p3Polynomial.rootSet_finite ℂ).image _
  have hNfinite : N.Finite := hcomponentsFinite.subset (fun _ ht => ht.1)
  change 2 ≤ N.ncard
  rw [← hpair]
  exact Set.ncard_le_ncard hpairsub hNfinite

theorem strict_nonconvex_ncard_eq_two
    (hleft : Convex ℝ (connectedComponentIn strictSublevelSet p3LeftAnchor)) :
    {t ∈ Erdos1047StrictCubicLower.componentsIn strictSublevelSet |
      ¬ Convex ℝ t}.ncard = 2 := by
  let K := strictSublevelSet
  let CL := connectedComponentIn K p3LeftAnchor
  let CD := connectedComponentIn K p3LowerAnchor
  let CU := connectedComponentIn K (star p3LowerAnchor)
  let N := {t ∈ Erdos1047StrictCubicLower.componentsIn K | ¬ Convex ℝ t}
  have hcomponents : Erdos1047StrictCubicLower.componentsIn K = {CL, CD, CU} := by
    simpa [K, CL, CD, CU] using strict_componentsIn_eq_three
  have hNsub : N ⊆ ({CD, CU} : Set (Set ℂ)) := by
    rintro t ⟨ht, hnconv⟩
    rw [hcomponents] at ht
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ht ⊢
    rcases ht with rfl | rfl | rfl
    · exact (hnconv (by simpa [K, CL] using hleft)).elim
    · exact Or.inl rfl
    · exact Or.inr rfl
  have hp : 2 ≤ N.ncard := by
    simpa [K, N] using strict_two_le_nonconvex_ncard
  have hpair : ({CD, CU} : Set (Set ℂ)).ncard = 2 := by
    obtain ⟨_, _, hne⟩ := p3_strict_three_components_pairwise_distinct
    have hne' : CD ≠ CU := by simpa [CD, CU, K] using hne
    simp [hne']
  have hle : N.ncard ≤ 2 := by
    rw [← hpair]
    exact Set.ncard_le_ncard hNsub (by simp)
  change N.ncard = 2
  omega

theorem strict_cubic_two_nonconvex_attainable :
    2 ∈ strictAttainableNonConvexCounts 3 := by
  refine ⟨p3Polynomial, p3Level, p3Polynomial_monic,
    p3Polynomial_natDegree, by norm_num [p3Level], ?_⟩
  apply strict_nonconvex_ncard_eq_two
  exact p3_strict_left_component_convex

theorem strict_cubic_nonconvex_count_le_three
    {f : ℂ[X]} (hf : f.Monic) (hdeg : f.natDegree = 3)
    {c : ℝ} (hc : 0 < c) :
    {t ∈ Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) |
      ¬ Convex ℝ t}.ncard ≤ 3 := by
  have hdegree : 0 < f.degree := by
    rw [degree_eq_natDegree hf.ne_zero]
    exact_mod_cast (show 0 < f.natDegree by omega)
  simpa [hdeg] using
    (strict_nonconvex_ncard_le_natDegree hf hdegree hc)

theorem strict_attainable_degree_three_le_three {k : ℕ}
    (hk : k ∈ strictAttainableNonConvexCounts 3) : k ≤ 3 := by
  obtain ⟨f, c, hf, hdeg, hc, hcount⟩ := hk
  rw [← hcount]
  exact strict_cubic_nonconvex_count_le_three hf hdeg hc

#print axioms strict_componentsIn_ncard
