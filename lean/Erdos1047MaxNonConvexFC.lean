/- Source: Erdos1047StrictAllDegrees.lean; SHA256: 58849238723202f981e8b595e63858c34eb15e8ac22024eb16c3d4ccaf07dc3c -/
section


/-!
# Exact maximum for the unrestricted strict target

No equality between component and root counts is assumed. For the upper bound,
every component contains a root, so there are at most `n` components. For the
lower bound in degree at least four, the balanced construction provides `n`
distinct strict non-convex components directly, without the closed-level bridge.
The separate strict low-degree proofs give the values `0, 0, 1, 2`.
-/

open Polynomial Set Erdos1047
open Erdos1047BalancedRaise Erdos1047BalancedCertificates
open Erdos1047StrictGeneralCore Erdos1047StrictLowDegreeAudit

namespace Erdos1047StrictAllDegrees

def maxNonConvexAnswer (n : ℕ) : ℕ :=
  if n ≤ 1 then 0 else if n = 2 then 1 else if n = 3 then 2 else n

theorem attainable_le_degree {n k : ℕ} (hn : 0 < n)
    (hk : k ∈ strictAttainableNonConvexCounts n) : k ≤ n := by
  obtain ⟨f, c, hf, hdeg, hc, hcount⟩ := hk
  have hdegree : 0 < f.degree := by
    rw [degree_eq_natDegree hf.ne_zero, hdeg]
    exact_mod_cast hn
  rw [← hcount]
  simpa only [hdeg] using strict_nonconvex_ncard_le_natDegree hf hdegree hc

theorem strict_attainable_of_witness_family {n : ℕ}
    (w : RealWitnessFamily n) (hn : 0 < n) :
    n ∈ strictAttainableNonConvexCounts n := by
  let f := complexify w.polynomial
  have hf : f.Monic := w.monic.map _
  have hdeg : f.natDegree = n := by
    simpa only [f, complexify,
      natDegree_map_eq_of_injective (algebraMap ℝ ℂ).injective] using w.degree
  have hdegree : 0 < f.degree := by
    rw [degree_eq_natDegree hf.ne_zero, hdeg]
    exact_mod_cast hn
  have hfinite : (componentsIn (strictSublevelSet f w.level)).Finite := by
    rw [strict_componentsIn_eq_image_rootSet hf hdegree w.level_pos]
    exact (f.rootSet_finite ℂ).image _
  have hlower : n ≤
      {t ∈ componentsIn (strictSublevelSet f w.level) | ¬ Convex ℝ t}.ncard := by
    simpa only [Fintype.card_fin, f, strictSublevelSet] using
      Erdos1047FCStrictCertificateCore.nonconvex_ncard_ge_of_robust_certificate_family
        (fun i => ⟨w.certificate i⟩) w.anchor_injective w.component_injective hfinite
  have hupper :
      {t ∈ componentsIn (strictSublevelSet f w.level) | ¬ Convex ℝ t}.ncard ≤ n := by
    simpa only [hdeg] using strict_nonconvex_ncard_le_natDegree hf hdegree w.level_pos
  exact ⟨f, w.level, hf, hdeg, w.level_pos, Nat.le_antisymm hupper hlower⟩

theorem strict_attainable_all_large_degrees (n : ℕ) (hn : 4 ≤ n) :
    n ∈ strictAttainableNonConvexCounts n := by
  obtain ⟨w⟩ := Erdos1047BalancedInduction.witnessFamily_all_large_degrees n hn
  exact strict_attainable_of_witness_family w (by omega)

theorem strict_max_nonconvex_all_large_degrees (n : ℕ) (hn : 4 ≤ n) :
    IsGreatest (strictAttainableNonConvexCounts n) n := by
  exact ⟨strict_attainable_all_large_degrees n hn,
    fun _ hk => attainable_le_degree (by omega) hk⟩

theorem strict_max_nonconvex_all_degrees (n : ℕ) :
    IsGreatest (strictAttainableNonConvexCounts n) (maxNonConvexAnswer n) := by
  by_cases h0 : n = 0
  · subst n
    simpa [maxNonConvexAnswer] using strict_max_nonconvex_of_degree_zero
  by_cases h1 : n = 1
  · subst n
    simpa [maxNonConvexAnswer] using strict_max_nonconvex_of_degree_one
  by_cases h2 : n = 2
  · subst n
    simpa [maxNonConvexAnswer] using
      Erdos1047StrictQuadraticExact.strict_max_nonconvex_of_degree_two
  by_cases h3 : n = 3
  · subst n
    simpa [maxNonConvexAnswer] using
      Erdos1047StrictCubicMax.strict_max_nonconvex_of_degree_three
  have hn : 4 ≤ n := by omega
  simpa [maxNonConvexAnswer, show ¬ n ≤ 1 by omega, h2, h3] using
    strict_max_nonconvex_all_large_degrees n hn

/-- info: 'Erdos1047StrictAllDegrees.strict_attainable_all_large_degrees' depends on axioms:
[propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms strict_attainable_all_large_degrees

/-- info: 'Erdos1047StrictAllDegrees.strict_max_nonconvex_all_degrees' depends on axioms:
[propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms strict_max_nonconvex_all_degrees

end Erdos1047StrictAllDegrees

end

open Polynomial Set Erdos1047

namespace Erdos1047Proof

/-- The current FC strict target, with only its answer placeholder filled. -/
theorem erdos_1047_max_non_convex_components_solved (n : ℕ) :
    IsGreatest {k : ℕ | ∃ (f : ℂ[X]) (c : ℝ), f.Monic ∧ f.natDegree = n ∧ 0 < c ∧
      {t ∈ componentsIn (strictSublevelSet f c) | ¬ Convex ℝ t}.ncard = k}
      answer(if n ≤ 1 then 0 else if n = 2 then 1 else if n = 3 then 2 else n) := by
  exact Erdos1047StrictAllDegrees.strict_max_nonconvex_all_degrees n

/-- info: 'Erdos1047Proof.erdos_1047_max_non_convex_components_solved' depends on axioms:
[propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms erdos_1047_max_non_convex_components_solved

end Erdos1047Proof

-- A fully qualified type check excludes accidental use of local look-alike definitions.
example (n : ℕ) :
    IsGreatest {k : ℕ | ∃ (f : ℂ[X]) (c : ℝ), f.Monic ∧ f.natDegree = n ∧ 0 < c ∧
      {t ∈ Erdos1047.componentsIn (Erdos1047.strictSublevelSet f c) |
        ¬ Convex ℝ t}.ncard = k}
      (if n ≤ 1 then 0 else if n = 2 then 1 else if n = 3 then 2 else n) := by
