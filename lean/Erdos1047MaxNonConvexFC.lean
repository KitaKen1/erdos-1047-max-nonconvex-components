/-! Symmetry transport for the six candidate witnesses.  The target polynomial
is invariant under multiplication by powers of the primitive cube root and
commutes with complex conjugation; both operations preserve real convex
combinations and the norm sublevel set. -/
theorem p6_mem_mul_omega_pow_iff (k : ℕ) (z : ℂ) :
    Erdos1047P6.omega ^ k * z ∈ sublevelSet Erdos1047P6.polynomial Erdos1047P6.level ↔
      z ∈ sublevelSet Erdos1047P6.polynomial Erdos1047P6.level := by
  change ‖Erdos1047P6.polynomial.eval (Erdos1047P6.omega ^ k * z)‖ ≤ Erdos1047P6.level ↔
    ‖Erdos1047P6.polynomial.eval z‖ ≤ Erdos1047P6.level
  rw [Erdos1047P6.polynomial_eval_omega_pow_norm]

theorem p6_mem_star_iff (z : ℂ) :
    star z ∈ sublevelSet Erdos1047P6.polynomial Erdos1047P6.level ↔
      z ∈ sublevelSet Erdos1047P6.polynomial Erdos1047P6.level := by
  change ‖Erdos1047P6.polynomial.eval (star z)‖ ≤ Erdos1047P6.level ↔
    ‖Erdos1047P6.polynomial.eval z‖ ≤ Erdos1047P6.level
  rw [Erdos1047P6.polynomial_eval_star_norm]

theorem p6_mul_omega_pow_segment {k : ℕ} {r a : ℂ}
    (h : segment ℝ r a ⊆
      sublevelSet Erdos1047P6.polynomial Erdos1047P6.level) :
    segment ℝ (Erdos1047P6.omega ^ k * r) (Erdos1047P6.omega ^ k * a) ⊆
      sublevelSet Erdos1047P6.polynomial Erdos1047P6.level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hmap : u • (Erdos1047P6.omega ^ k * r) + v •
      (Erdos1047P6.omega ^ k * a) =
      Erdos1047P6.omega ^ k * (u • r + v • a) := by
    rw [Complex.real_smul, Complex.real_smul, Complex.real_smul,
      Complex.real_smul]
    ring
  rw [hmap]
  exact (p6_mem_mul_omega_pow_iff k _).2 (h ⟨u, v, hu, hv, huv, rfl⟩)

theorem p6_star_segment {r a : ℂ}
    (h : segment ℝ r a ⊆
      sublevelSet Erdos1047P6.polynomial Erdos1047P6.level) :
    segment ℝ (star r) (star a) ⊆
      sublevelSet Erdos1047P6.polynomial Erdos1047P6.level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  rw [show u • star r + v • star a = star (u • r + v • a) by simp]
  exact (p6_mem_star_iff _).2 (h ⟨u, v, hu, hv, huv, rfl⟩)

theorem p6_mul_omega_pow_midpoint_outside {k : ℕ} {a b : ℂ}
    (h : midpoint ℝ a b ∉
      sublevelSet Erdos1047P6.polynomial Erdos1047P6.level) :
    midpoint ℝ (Erdos1047P6.omega ^ k * a) (Erdos1047P6.omega ^ k * b) ∉
      sublevelSet Erdos1047P6.polynomial Erdos1047P6.level := by
  intro hm
  apply h
  have hmap : midpoint ℝ (Erdos1047P6.omega ^ k * a)
      (Erdos1047P6.omega ^ k * b) =
      Erdos1047P6.omega ^ k * midpoint ℝ a b := by
    simp [midpoint, AffineMap.lineMap_apply_module]
    ring
  rw [hmap] at hm
  exact (p6_mem_mul_omega_pow_iff k _).1 hm

theorem p6_star_midpoint_outside {a b : ℂ}
    (h : midpoint ℝ a b ∉
      sublevelSet Erdos1047P6.polynomial Erdos1047P6.level) :
    midpoint ℝ (star a) (star b) ∉
      sublevelSet Erdos1047P6.polynomial Erdos1047P6.level := by
  intro hm
  apply h
  rw [← p6_mem_star_iff]
  convert hm using 1
  simp [midpoint, AffineMap.lineMap_apply_module]

theorem p6_mul_omega_pow_component_not_convex (k : ℕ) :
    ¬ Convex ℝ (connectedComponentIn
      (sublevelSet Erdos1047P6.polynomial Erdos1047P6.level)
      (Erdos1047P6.omega ^ k * Erdos1047P6.anchor)) := by
  exact component_not_convex_of_segments
    (p6_mul_omega_pow_segment p6_lineA_subset)
    (p6_mul_omega_pow_segment p6_lineB_subset)
    (p6_mul_omega_pow_midpoint_outside p6_midpoint_outside)

theorem p6_star_component_not_convex :
    ¬ Convex ℝ (connectedComponentIn
      (sublevelSet Erdos1047P6.polynomial Erdos1047P6.level)
      (star Erdos1047P6.anchor)) := by
  exact component_not_convex_of_segments
    (p6_star_segment p6_lineA_subset)
    (p6_star_segment p6_lineB_subset)
    (p6_star_midpoint_outside p6_midpoint_outside)

theorem p6_star_mul_omega_pow_component_not_convex (k : ℕ) :
    ¬ Convex ℝ (connectedComponentIn
      (sublevelSet Erdos1047P6.polynomial Erdos1047P6.level)
      (star (Erdos1047P6.omega ^ k * Erdos1047P6.anchor))) := by
  exact component_not_convex_of_segments
    (p6_star_segment (p6_mul_omega_pow_segment p6_lineA_subset))
    (p6_star_segment (p6_mul_omega_pow_segment p6_lineB_subset))
    (p6_star_midpoint_outside
      (p6_mul_omega_pow_midpoint_outside p6_midpoint_outside))

/-! The three separating lines are the zero sets of
`z ↦ Im (ω^k z)`, for `k=0,1,2`.  On each such line the polynomial has norm at
least one, so it is disjoint from the level set of radius `9999/10000`. -/
theorem p6_not_mem_of_rotated_im_zero (k : ℕ) {z : ℂ}
    (hz : (Erdos1047P6.omega ^ k * z).im = 0) :
    z ∉ sublevelSet Erdos1047P6.polynomial Erdos1047P6.level := by
  change z ∉ {w : ℂ | ‖Erdos1047P6.polynomial.eval w‖ ≤ Erdos1047P6.level}
  exact Erdos1047P6.polynomial_not_mem_of_rotated_im_zero k hz

/-! Early separator-sign lemmas used by the explicit six-anchor certificate.
They are stated here because the certificate precedes the general geometry
section below. -/
theorem negative_on_component_early {S : Set ℂ} {r : ℂ} {φ : ℂ → ℝ}
    (hφ : Continuous φ) (hzero : ∀ z ∈ S, φ z ≠ 0) (hr : r ∈ S) (hneg : φ r < 0) :
    ∀ z ∈ connectedComponentIn S r, φ z < 0 := by
  intro z hz
  by_contra hnonneg
  obtain ⟨w, hw, hwzero⟩ :=
    isPreconnected_connectedComponentIn.intermediate_value
      (mem_connectedComponentIn hr) hz hφ.continuousOn
      (show (0 : ℝ) ∈ Set.Icc (φ r) (φ z) from ⟨hneg.le, le_of_not_gt hnonneg⟩)
  exact hzero w (connectedComponentIn_subset S r hw) hwzero

theorem p6_component_im_positive_early (k : ℕ) {r : ℂ}
    (hr : r ∈ sublevelSet Erdos1047P6.polynomial Erdos1047P6.level)
    (hpos : 0 < (Erdos1047P6.omega ^ k * r).im) :
    ∀ z ∈ connectedComponentIn
      (sublevelSet Erdos1047P6.polynomial Erdos1047P6.level) r,
      0 < (Erdos1047P6.omega ^ k * z).im := by
  have hnz : ∀ w ∈ sublevelSet Erdos1047P6.polynomial Erdos1047P6.level,
      -(Erdos1047P6.omega ^ k * w).im ≠ 0 := by
    intro w hw hzero
    have hzero' : (Erdos1047P6.omega ^ k * w).im = 0 := by linarith
    exact (p6_not_mem_of_rotated_im_zero k hzero') hw
  intro z hz
  have h := negative_on_component_early
    (S := sublevelSet Erdos1047P6.polynomial Erdos1047P6.level)
    (r := r) (φ := fun w : ℂ => -(Erdos1047P6.omega ^ k * w).im)
    (by fun_prop) hnz hr (by linarith) z hz
  linarith

theorem p6_component_im_negative_early (k : ℕ) {r : ℂ}
    (hr : r ∈ sublevelSet Erdos1047P6.polynomial Erdos1047P6.level)
    (hneg : (Erdos1047P6.omega ^ k * r).im < 0) :
    ∀ z ∈ connectedComponentIn
      (sublevelSet Erdos1047P6.polynomial Erdos1047P6.level) r,
      (Erdos1047P6.omega ^ k * z).im < 0 := by
  have hnz : ∀ w ∈ sublevelSet Erdos1047P6.polynomial Erdos1047P6.level,
      (Erdos1047P6.omega ^ k * w).im ≠ 0 := by
    intro w hw hzero
    exact (p6_not_mem_of_rotated_im_zero k hzero) hw
  intro z hz
  exact negative_on_component_early
    (S := sublevelSet Erdos1047P6.polynomial Erdos1047P6.level)
    (r := r) (φ := fun w : ℂ => (Erdos1047P6.omega ^ k * w).im)
    (by fun_prop) hnz hr hneg z hz

theorem p6_components_ne_of_separator_sign_early {k : ℕ} {r s : ℂ}
