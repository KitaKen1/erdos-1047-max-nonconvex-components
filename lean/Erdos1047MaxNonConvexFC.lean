/- Source: Erdos1047CubicNormalizeCore.lean; SHA256: 5e7f8bf5c16ea62d26a79ba6bf82d6ed0d61f159c16e5da6b6c3271a6c5cb1d0 -/
section


/-! Centering and scaling lemmas for arbitrary monic cubics. -/

open Polynomial

namespace Erdos1047CubicNormalize

noncomputable section

theorem monic_cubic_eq (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3) :
    f = X ^ 3 + C (f.coeff 2) * X ^ 2 + C (f.coeff 1) * X + C (f.coeff 0) := by
  conv_lhs =>
    rw [f.as_sum_range_C_mul_X_pow, hdeg, Finset.sum_range_succ,
      Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_one,
      ← hdeg, hf.coeff_natDegree, hdeg]
  simp only [C_1]
  ring

def cubicCenter (f : ℂ[X]) : ℂ := -(f.coeff 2) / 3

def cubicLinear (f : ℂ[X]) : ℂ := f.coeff 1 - (f.coeff 2) ^ 2 / 3

def cubicConstant (f : ℂ[X]) : ℂ :=
  f.coeff 0 - f.coeff 1 * f.coeff 2 / 3 + 2 * (f.coeff 2) ^ 3 / 27

theorem monic_cubic_eval_center_add (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 3) (z : ℂ) :
    f.eval (cubicCenter f + z) = z ^ 3 + cubicLinear f * z + cubicConstant f := by
  rw [monic_cubic_eq f hf hdeg]
  simp [cubicCenter, cubicLinear, cubicConstant]
  ring

theorem monic_cubic_derivative_eval_center_add (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 3) (z : ℂ) :
    f.derivative.eval (cubicCenter f + z) = 3 * z ^ 2 + cubicLinear f := by
  rw [monic_cubic_eq f hf hdeg]
  norm_num [cubicCenter, cubicLinear]
  ring

theorem monic_cubic_second_derivative_eval_center_add (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 3) (z : ℂ) :
    f.derivative.derivative.eval (cubicCenter f + z) = 6 * z := by
  rw [monic_cubic_eq f hf hdeg]
  norm_num [cubicCenter]
  ring

theorem exists_cubic_scale {A : ℂ} (hA : A ≠ 0) :
    ∃ d : ℂ, d ≠ 0 ∧ d ^ 2 = -A / 3 := by
  let g : ℂ[X] := X ^ 2 - C (-A / 3)
  have hgdeg : g.degree = 2 := by
    dsimp [g]
    compute_degree <;> norm_num
  have hg : g.degree ≠ 0 := by rw [hgdeg]; norm_num
  obtain ⟨d, hd⟩ := IsAlgClosed.exists_root g hg
  have hd2 : d ^ 2 = -A / 3 := by
    have hd' : d ^ 2 - (-A / 3) = 0 := by simpa [g] using hd
    exact sub_eq_zero.mp hd'
  refine ⟨d, ?_, hd2⟩
  intro hd0
  subst d
  norm_num at hd2
  apply hA
  linear_combination 3 * hd2

def normalizedCubicConstant (f : ℂ[X]) (d : ℂ) : ℂ :=
  cubicConstant f / d ^ 3

def normalizedCubic (f : ℂ[X]) (d : ℂ) : ℂ[X] :=
  X ^ 3 - C 3 * X + C (normalizedCubicConstant f d)

def pureCubic (B : ℂ) : ℂ[X] := X ^ 3 + C B

theorem pureCubic_monic (B : ℂ) : (pureCubic B).Monic := by
  unfold pureCubic
  monicity!

theorem pureCubic_natDegree (B : ℂ) : (pureCubic B).natDegree = 3 := by
  unfold pureCubic
  compute_degree!

theorem pureCubic_separable_of_ne_zero {B : ℂ} (hB : B ≠ 0) :
    (pureCubic B).Separable := by
  have hpoly : (X ^ 3 - C (-B) : ℂ[X]) = pureCubic B := by
    simp [pureCubic, C_neg]
  rw [← hpoly]
  exact separable_X_pow_sub_C (-B) (by norm_num : (3 : ℂ) ≠ 0)
    (neg_ne_zero.mpr hB)

theorem pureCubic_rootSet_ncard_of_ne_zero {B : ℂ} (hB : B ≠ 0) :
    ((pureCubic B).rootSet ℂ).ncard = 3 := by
  have hcard : Fintype.card ((pureCubic B).rootSet ℂ) =
      (pureCubic B).natDegree :=
    Polynomial.card_rootSet_eq_natDegree (pureCubic_separable_of_ne_zero hB)
      (IsAlgClosed.splits _)
  rw [pureCubic_natDegree] at hcard
  simpa using hcard

theorem normalizedCubic_monic (f : ℂ[X]) (d : ℂ) :
    (normalizedCubic f d).Monic := by
  unfold normalizedCubic
  monicity!

theorem normalizedCubic_natDegree (f : ℂ[X]) (d : ℂ) :
    (normalizedCubic f d).natDegree = 3 := by
  unfold normalizedCubic
  compute_degree!

theorem normalizedCubic_eval (f : ℂ[X]) (d z : ℂ) :
    (normalizedCubic f d).eval z =
      z ^ 3 - 3 * z + normalizedCubicConstant f d := by
  norm_num [normalizedCubic]

theorem affine_image_convex {S : Set ℂ} (hS : Convex ℝ S) (center d : ℂ) :
    Convex ℝ ((fun z : ℂ => center + d * z) '' S) := by
  intro x hx y hy a b ha hb hab
  rcases hx with ⟨u, hu, rfl⟩
  rcases hy with ⟨v, hv, rfl⟩
  refine ⟨a • u + b • v, hS hu hv ha hb hab, ?_⟩
  simp only [Complex.real_smul]
  have hab' : (a : ℂ) + (b : ℂ) = 1 := by exact_mod_cast hab
  calc
    center + d * ((a : ℂ) * u + (b : ℂ) * v) =
        center * ((a : ℂ) + (b : ℂ)) +
          d * ((a : ℂ) * u + (b : ℂ) * v) := by rw [hab']; ring
    _ = (a : ℂ) * (center + d * u) +
        (b : ℂ) * (center + d * v) := by ring

/-- The similarity used in cubic normalization is a homeomorphism whenever the
    scale is nonzero.  Keeping this as a named object lets component arguments
    use the general `Homeomorph.image_connectedComponentIn` theorem. -/
def affineHomeomorph (center d : ℂ) (hd : d ≠ 0) : ℂ ≃ₜ ℂ :=
  (Homeomorph.mulLeft₀ d hd).trans (Homeomorph.addLeft center)

@[simp]
theorem affineHomeomorph_apply (center d : ℂ) (hd : d ≠ 0) (z : ℂ) :
    affineHomeomorph center d hd z = center + d * z := by
  rfl

@[simp]
theorem affineHomeomorph_coe (center d : ℂ) (hd : d ≠ 0) :
    (affineHomeomorph center d hd : ℂ → ℂ) =
      (fun z : ℂ => center + d * z) := by
  funext z
  rfl

theorem affine_image_connectedComponentIn_eq
    {S : Set ℂ} (center d : ℂ) (hd : d ≠ 0) {x : ℂ} (hx : x ∈ S) :
    (fun z : ℂ => center + d * z) '' connectedComponentIn S x =
      connectedComponentIn ((fun z : ℂ => center + d * z) '' S) (center + d * x) := by
  simpa only [affineHomeomorph_coe, affineHomeomorph_apply] using
    (Homeomorph.image_connectedComponentIn (affineHomeomorph center d hd) hx)

theorem affine_image_connectedComponentIn_ncard
    {S : Set ℂ} (center d : ℂ) (hd : d ≠ 0) {x : ℂ} (hx : x ∈ S) :
    (connectedComponentIn ((fun z : ℂ => center + d * z) '' S) (center + d * x)).ncard =
      (connectedComponentIn S x).ncard := by
  rw [← affine_image_connectedComponentIn_eq center d hd hx]
  exact Set.ncard_image_of_injective _ (affineHomeomorph center d hd).injective

theorem affine_image_convex_iff {S : Set ℂ} (center d : ℂ) (hd : d ≠ 0) :
    Convex ℝ ((fun z : ℂ => center + d * z) '' S) ↔ Convex ℝ S := by
  constructor
  · intro himage
    have hinv := affine_image_convex himage (-d⁻¹ * center) d⁻¹
    have hset :
        (fun w : ℂ => -d⁻¹ * center + d⁻¹ * w) ''
            ((fun z : ℂ => center + d * z) '' S) = S := by
      ext z
      constructor
      · rintro ⟨w, ⟨u, hu, rfl⟩, rfl⟩
        have hzu : -d⁻¹ * center + d⁻¹ * (center + d * u) = u := by
          field_simp [hd]
          ring
        change -d⁻¹ * center + d⁻¹ * (center + d * u) ∈ S
        rw [hzu]
        exact hu
      · intro hz
        refine ⟨center + d * z, ⟨z, hz, rfl⟩, ?_⟩
        field_simp [hd]
        ring
    rw [hset] at hinv
    exact hinv
  · exact fun hS => affine_image_convex hS center d

theorem affine_image_connectedComponentIn_convex_iff
    {S : Set ℂ} (center d : ℂ) (hd : d ≠ 0) {x : ℂ} (hx : x ∈ S) :
    Convex ℝ (connectedComponentIn
      ((fun z : ℂ => center + d * z) '' S) (center + d * x)) ↔
      Convex ℝ (connectedComponentIn S x) := by
  rw [← affine_image_connectedComponentIn_eq center d hd hx]
  exact affine_image_convex_iff center d hd

theorem monic_cubic_eval_normalized (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 3) {d : ℂ} (hd0 : d ≠ 0)
    (hd : d ^ 2 = -cubicLinear f / 3) (z : ℂ) :
    f.eval (cubicCenter f + d * z) =
      d ^ 3 * (z ^ 3 - 3 * z + normalizedCubicConstant f d) := by
  rw [monic_cubic_eval_center_add f hf hdeg]
  dsimp [normalizedCubicConstant]
  field_simp [hd0]
  have hrel : cubicLinear f + 3 * d ^ 2 = 0 := by
    linear_combination 3 * hd
  linear_combination d * z * hrel

theorem monic_cubic_derivative_eval_normalized (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 3) {d : ℂ}
    (hd : d ^ 2 = -cubicLinear f / 3) (z : ℂ) :
    f.derivative.eval (cubicCenter f + d * z) = 3 * d ^ 2 * (z ^ 2 - 1) := by
  rw [monic_cubic_derivative_eval_center_add f hf hdeg]
  have hrel : cubicLinear f + 3 * d ^ 2 = 0 := by
    linear_combination 3 * hd
  linear_combination hrel

theorem monic_cubic_eval_normalized_as_polynomial
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3) {d : ℂ}
    (hd0 : d ≠ 0) (hd : d ^ 2 = -cubicLinear f / 3) (z : ℂ) :
    f.eval (cubicCenter f + d * z) =
      d ^ 3 * (normalizedCubic f d).eval z := by
  rw [monic_cubic_eval_normalized f hf hdeg hd0 hd z,
    normalizedCubic_eval]

theorem affine_image_normalized_rootSet_eq
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3) {d : ℂ}
    (hd0 : d ≠ 0) (hd : d ^ 2 = -cubicLinear f / 3) :
    (fun z : ℂ => cubicCenter f + d * z) ''
        (normalizedCubic f d).rootSet ℂ = f.rootSet ℂ := by
  ext w
  constructor
  · rintro ⟨z, hz, rfl⟩
    have hz0 : (normalizedCubic f d).eval z = 0 :=
      (normalizedCubic_monic f d).mem_rootSet.mp hz
    apply hf.mem_rootSet.mpr
    have heval : f.eval (cubicCenter f + d * z) = 0 := by
      rw [monic_cubic_eval_normalized_as_polynomial f hf hdeg hd0 hd z,
        hz0, mul_zero]
    simpa [aeval_def] using heval
  · intro hw
    have hw0 : f.eval w = 0 := hf.mem_rootSet.mp hw
    let z : ℂ := (w - cubicCenter f) / d
    have hmap : cubicCenter f + d * z = w := by
      dsimp [z]
      field_simp [hd0]
      ring
    refine ⟨z, ?_, hmap⟩
    apply (normalizedCubic_monic f d).mem_rootSet.mpr
    have he := monic_cubic_eval_normalized_as_polynomial
      f hf hdeg hd0 hd z
    rw [hmap, hw0] at he
    have hzero : (normalizedCubic f d).eval z = 0 :=
      (mul_eq_zero.mp he.symm).resolve_left (pow_ne_zero 3 hd0)
    simpa [aeval_def] using hzero

theorem affine_image_normalized_rootSet_ncard
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3) {d : ℂ}
    (hd0 : d ≠ 0) (hd : d ^ 2 = -cubicLinear f / 3) :
    ((normalizedCubic f d).rootSet ℂ).ncard = (f.rootSet ℂ).ncard := by
  rw [← affine_image_normalized_rootSet_eq f hf hdeg hd0 hd]
  symm
  apply Set.ncard_image_of_injective
  intro z w hzw
  apply mul_left_cancel₀ hd0
  linear_combination hzw

theorem monic_cubic_critical_normalized_iff (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 3) {d : ℂ} (hd0 : d ≠ 0)
    (hd : d ^ 2 = -cubicLinear f / 3) (z : ℂ) :
    f.derivative.eval (cubicCenter f + d * z) = 0 ↔ z = 1 ∨ z = -1 := by
  rw [monic_cubic_derivative_eval_normalized f hf hdeg hd z]
  have hd2 : d ^ 2 ≠ 0 := pow_ne_zero 2 hd0
  constructor
  · intro h
    have hz : z ^ 2 = 1 := by
      apply sub_eq_zero.mp
      rcases mul_eq_zero.mp h with hdzero | hz
      · have hd2zero : d ^ 2 = 0 :=
          (mul_eq_zero.mp hdzero).resolve_left (by norm_num)
        exact (hd2 hd2zero).elim
      · exact hz
    exact sq_eq_one_iff.mp hz
  · rintro (rfl | rfl) <;> norm_num

theorem monic_cubic_eval_normalized_one (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 3) {d : ℂ} (hd0 : d ≠ 0)
    (hd : d ^ 2 = -cubicLinear f / 3) :
    f.eval (cubicCenter f + d) = d ^ 3 * (normalizedCubicConstant f d - 2) := by
  convert monic_cubic_eval_normalized f hf hdeg hd0 hd 1 using 1 <;> ring

theorem monic_cubic_eval_normalized_neg_one (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 3) {d : ℂ} (hd0 : d ≠ 0)
    (hd : d ^ 2 = -cubicLinear f / 3) :
    f.eval (cubicCenter f - d) = d ^ 3 * (normalizedCubicConstant f d + 2) := by
  have h := monic_cubic_eval_normalized f hf hdeg hd0 hd (-1)
  convert h using 1 <;> ring

theorem monic_cubic_eval_pure (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 3) (hlin : cubicLinear f = 0) (z : ℂ) :
    f.eval (cubicCenter f + z) = z ^ 3 + cubicConstant f := by
  rw [monic_cubic_eval_center_add f hf hdeg, hlin]
  ring

theorem monic_cubic_derivative_eval_pure (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 3) (hlin : cubicLinear f = 0) (z : ℂ) :
    f.derivative.eval (cubicCenter f + z) = 3 * z ^ 2 := by
  rw [monic_cubic_derivative_eval_center_add f hf hdeg, hlin]
  ring

/-! The two normal-form branches are exhaustive for a separable monic cubic.
The first branch has two distinct critical points and can be scaled to
`z^3 - 3*z + B`; the second branch is the pure cubic case. -/

theorem centered_cubic_constant_ne_zero_of_separable
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3)
    (hlin : cubicLinear f = 0) (hsep : f.Separable) :
    cubicConstant f ≠ 0 := by
  intro hconst
  have heval := monic_cubic_eval_center_add f hf hdeg 0
  have hroot : f.eval (cubicCenter f) = 0 := by
    simpa [hlin, hconst] using heval
  have hderiv := monic_cubic_derivative_eval_center_add f hf hdeg 0
  have hderiv_zero : f.derivative.eval (cubicCenter f) = 0 := by
    simpa [hlin] using hderiv
  rw [Polynomial.separable_def'] at hsep
  obtain ⟨a, b, hab⟩ := hsep
  have hev := congrArg (Polynomial.eval (cubicCenter f)) hab
  simp only [eval_add, eval_mul, hroot, hderiv_zero, mul_zero, add_zero,
    eval_one] at hev
  exact zero_ne_one hev

theorem monic_cubic_normalization_cases
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3)
    (hsep : f.Separable) :
    (∃ d : ℂ, d ≠ 0 ∧ d ^ 2 = -cubicLinear f / 3) ∨
      (cubicLinear f = 0 ∧ cubicConstant f ≠ 0) := by
  by_cases hlin : cubicLinear f = 0
  · exact Or.inr ⟨hlin,
      centered_cubic_constant_ne_zero_of_separable f hf hdeg hlin hsep⟩
  · left
    exact exists_cubic_scale hlin

/- The normalization split is algebraic and should not introduce `sorryAx`. -/
/- The exact axiom list is checked when this core is rebuilt in either target package. -/
/-- info: 'Erdos1047CubicNormalize.monic_cubic_normalization_cases' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms monic_cubic_normalization_cases
#print axioms affine_image_connectedComponentIn_convex_iff

end

end Erdos1047CubicNormalize

end

/- Source: Erdos1047CubicBarrierCore.lean; SHA256: bb213e1f6c8231fc768765fe4c89575e960bbb5f14a6425f08de729e567c3be6 -/
section


open Polynomial
open Filter Topology Set

namespace Erdos1047CubicBarrier

noncomputable section

/-- Real form of the left hyperbolic branch used for a centered cubic. -/
lemma hyperbolic_region_midpoint
    {x₁ y₁ x₂ y₂ a b : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1)
    (hx₁ : x₁ < -1) (hq₁ : 0 < 3 * x₁ ^ 2 - y₁ ^ 2 - 3)
    (hx₂ : x₂ < -1) (hq₂ : 0 < 3 * x₂ ^ 2 - y₂ ^ 2 - 3) :
    let x := a * x₁ + b * x₂
    let y := a * y₁ + b * y₂
    x < -1 ∧ 0 < 3 * x ^ 2 - y ^ 2 - 3 := by
  dsimp
  let u₁ : ℝ := -x₁
  let u₂ : ℝ := -x₂
  let s₁ : ℝ := Real.sqrt (3 * (u₁ ^ 2 - 1))
  let s₂ : ℝ := Real.sqrt (3 * (u₂ ^ 2 - 1))
  let u : ℝ := a * u₁ + b * u₂
  let s : ℝ := Real.sqrt (3 * (u ^ 2 - 1))
  have hu₁ : 1 < u₁ := by dsimp [u₁]; linarith
  have hu₂ : 1 < u₂ := by dsimp [u₂]; linarith
  have hu₁q : 0 ≤ 3 * (u₁ ^ 2 - 1) := by nlinarith
  have hu₂q : 0 ≤ 3 * (u₂ ^ 2 - 1) := by nlinarith
  have hu : 1 < u := by
    by_cases ha0 : a = 0
    · have hb1 : b = 1 := by linarith
      dsimp [u]
      rw [ha0, hb1]
      simpa [ha0, hb1] using hu₂
    · have ha' : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
      have hstrict : 0 < a * (u₁ - 1) + b * (u₂ - 1) := by
        have h1' : 0 < a * (u₁ - 1) := mul_pos ha' (by linarith)
        have h2 : 0 ≤ b * (u₂ - 1) := mul_nonneg hb (by linarith)
        linarith
      dsimp [u]
      nlinarith [hstrict, hab]
  have husq : 0 ≤ 3 * (u ^ 2 - 1) := by nlinarith
  have hs₁ : 0 ≤ s₁ := by dsimp [s₁]; positivity
  have hs₂ : 0 ≤ s₂ := by dsimp [s₂]; positivity
  have hs : 0 ≤ s := by dsimp [s]; positivity
  have hs₁sq : s₁ ^ 2 = 3 * (u₁ ^ 2 - 1) := by
    dsimp [s₁]
    rw [Real.sq_sqrt hu₁q]
  have hs₂sq : s₂ ^ 2 = 3 * (u₂ ^ 2 - 1) := by
    dsimp [s₂]
    rw [Real.sq_sqrt hu₂q]
  have hssq : s ^ 2 = 3 * (u ^ 2 - 1) := by
    dsimp [s]
    rw [Real.sq_sqrt husq]
  have hcross : s₁ * s₂ ≤ 3 * (u₁ * u₂ - 1) := by
    have hright : 0 ≤ 3 * (u₁ * u₂ - 1) := by nlinarith
    have hid : (3 * (u₁ * u₂ - 1)) ^ 2 - (s₁ * s₂) ^ 2 =
        9 * (u₁ - u₂) ^ 2 := by
      simp only [mul_pow]
      rw [hs₁sq, hs₂sq]
      ring
    nlinarith [sq_nonneg (s₁ * s₂), sq_nonneg (u₁ - u₂)]
  have hsum_sq : (a * s₁ + b * s₂) ^ 2 ≤ s ^ 2 := by
    have hid : s ^ 2 - (a * s₁ + b * s₂) ^ 2 =
        2 * a * b * (3 * (u₁ * u₂ - 1) - s₁ * s₂) := by
      calc
        s ^ 2 - (a * s₁ + b * s₂) ^ 2 =
            s ^ 2 - (a ^ 2 * s₁ ^ 2 + b ^ 2 * s₂ ^ 2 + 2 * a * b * s₁ * s₂) := by ring
        _ = 2 * a * b * (3 * (u₁ * u₂ - 1) - s₁ * s₂) := by
          rw [hssq, hs₁sq, hs₂sq]
          dsimp [u]
          nlinarith [hab]
    have habnon : 0 ≤ a * b := mul_nonneg ha hb
    have hnon : 0 ≤ 2 * a * b := mul_nonneg (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) ha) hb
    have hterm : 0 ≤ 3 * (u₁ * u₂ - 1) - s₁ * s₂ := by linarith
    exact le_of_sub_nonneg (by nlinarith [hid, mul_nonneg hnon hterm])
  have hy₁abs : |y₁| < s₁ := by
    apply (sq_lt_sq₀ (abs_nonneg y₁) hs₁).mp
    rw [sq_abs, hs₁sq]
    dsimp [u₁]
    nlinarith
  have hy₁u : y₁ < s₁ := (abs_lt.mp hy₁abs).2
  have hny₁u : -s₁ < y₁ := (abs_lt.mp hy₁abs).1
  have hy₂abs : |y₂| < s₂ := by
    apply (sq_lt_sq₀ (abs_nonneg y₂) hs₂).mp
    rw [sq_abs, hs₂sq]
    dsimp [u₂]
    nlinarith
  have hy₂u : y₂ < s₂ := (abs_lt.mp hy₂abs).2
  have hny₂u : -s₂ < y₂ := (abs_lt.mp hy₂abs).1
  have hyupper : a * y₁ + b * y₂ < a * s₁ + b * s₂ := by
    by_cases ha0 : a = 0
    · subst a
      simp only [zero_mul, zero_add] at hab ⊢
      have : b = 1 := by linarith
      simpa [this] using hy₂u
    · have ha' : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
      have hA := mul_lt_mul_of_pos_left hy₁u ha'
      have hB := mul_le_mul_of_nonneg_left (le_of_lt hy₂u) hb
      linarith
  have hylower : -(a * s₁ + b * s₂) < a * y₁ + b * y₂ := by
    by_cases ha0 : a = 0
    · subst a
      simp only [zero_mul, zero_add] at hab ⊢
      have : b = 1 := by linarith
      simpa [this] using hny₂u
    · have ha' : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
      have hA := mul_lt_mul_of_pos_left hny₁u ha'
      have hB := mul_le_mul_of_nonneg_left (le_of_lt hny₂u) hb
      linarith
  have hy_sq : (a * y₁ + b * y₂) ^ 2 < s ^ 2 := by
    have hsum_nonneg : 0 ≤ a * s₁ + b * s₂ :=
      add_nonneg (mul_nonneg ha hs₁) (mul_nonneg hb hs₂)
    have hsum_le : a * s₁ + b * s₂ ≤ s :=
      (sq_le_sq₀ hsum_nonneg hs).mp hsum_sq
    have hsumpos : 0 < s + (a * y₁ + b * y₂) := by
      linarith only [hylower, hsum_le]
    have hdiffpos : 0 < s - (a * y₁ + b * y₂) := by
      linarith only [hyupper, hsum_le]
    have hid : s ^ 2 - (a * y₁ + b * y₂) ^ 2 =
        (s - (a * y₁ + b * y₂)) * (s + (a * y₁ + b * y₂)) := by ring
    have hdiffsq : 0 < s ^ 2 - (a * y₁ + b * y₂) ^ 2 := by
      rw [hid]
      exact mul_pos hdiffpos hsumpos
    linarith only [hdiffsq]
  have hxeq : a * x₁ + b * x₂ = -u := by
    dsimp [u, u₁, u₂]
    ring
  constructor
  · rw [hxeq]
    linarith only [hu]
  · rw [hxeq]
    nlinarith only [hssq, hy_sq]

/-- The left branch `x < -1`, `3x²-y²-3 > 0` is convex. -/
def region (z : ℂ) : Prop :=
  z.re < -1 ∧ 0 < 3 * z.re ^ 2 - z.im ^ 2 - 3

theorem region_convex : Convex ℝ {z : ℂ | region z} := by
  rw [convex_iff_add_mem]
  intro z hz w hw a b ha hb hab
  change region (a • z + b • w)
  change z.re < -1 ∧ 0 < 3 * z.re ^ 2 - z.im ^ 2 - 3 at hz
  change w.re < -1 ∧ 0 < 3 * w.re ^ 2 - w.im ^ 2 - 3 at hw
  have h := hyperbolic_region_midpoint ha hb hab hz.1 hz.2 hw.1 hw.2
  simpa [region, Complex.add_re, Complex.add_im, Complex.real_smul,
    Complex.mul_re] using h

/-! A local maximum cannot coexist with a strictly positive second derivative.
    The proof is deliberately filter-level: the second-derivative test gives a
    local minimum, and the simultaneous local minimum/maximum forces the
    function to be locally constant, hence its second derivative is zero. -/
theorem not_isLocalMax_of_deriv_deriv_pos
    {f : ℝ → ℝ} {x : ℝ}
    (hcont : ContinuousAt f x)
    (hsecond : 0 < deriv (deriv f) x)
    (hfirst : deriv f x = 0) :
    ¬ IsLocalMax f x := by
  intro hmax
  have hmin := isLocalMin_of_deriv_deriv_pos hsecond hfirst hcont
  have heq : f =ᶠ[𝓝 x] (fun _ => f x) :=
    eventuallyEq_of_isMinFilter_of_isMaxFilter hmin hmax
  have heq' : deriv f =ᶠ[𝓝 x] deriv (fun _ => f x) := heq.deriv
  have hsec0 : deriv (deriv f) x = 0 := by
    calc
      deriv (deriv f) x = deriv (deriv (fun _ => f x)) x :=
        heq'.deriv_eq
      _ = 0 := by simp
  linarith

/-! Compact one-dimensional bookkeeping used by the segment argument: if a
    continuous function has no interior local maximum, its largest value on a
    closed interval is attained at an endpoint. -/
theorem le_max_endpoints_of_no_isLocalMax
    {f : ℝ → ℝ} {a b : ℝ}
    (hab : a < b) (hcont : ContinuousOn f (Set.Icc a b))
    (hno : ∀ t ∈ Set.Ioo a b, ¬ IsLocalMax f t) :
    ∀ t ∈ Set.Icc a b, f t ≤ max (f a) (f b) := by
  intro t ht
  by_contra hnot
  have hgt : max (f a) (f b) < f t := lt_of_not_ge hnot
  obtain ⟨u, hu, hmax⟩ :=
    isCompact_Icc.exists_isMaxOn (nonempty_Icc.2 hab.le) hcont
  have hu_a : u ≠ a := by
    intro hua
    subst u
    have hle := hmax ht
    change f t ≤ f a at hle
    have hlemax : f a ≤ max (f a) (f b) := le_max_left _ _
    linarith
  have hu_b : u ≠ b := by
    intro hub
    subst u
    have hle := hmax ht
    change f t ≤ f b at hle
    have hlemax : f b ≤ max (f a) (f b) := le_max_right _ _
    linarith
  apply hno u
  exact ⟨lt_of_le_of_ne hu.1 (Ne.symm hu_a),
    lt_of_le_of_ne hu.2 hu_b⟩
  exact hmax.isLocalMax (Icc_mem_nhds
    (lt_of_le_of_ne hu.1 (Ne.symm hu_a))
    (lt_of_le_of_ne hu.2 hu_b))

/-! The algebraic second-derivative calculation used at an interior maximum.
    If `a = conj(p) p' v` is purely imaginary, then the cubic curvature
    inequality forces the second derivative of `|p|²` in direction `v` to be
    positive.  This is the exact local computation behind the normalized
    cubic convexity argument. -/
theorem stationary_second_pos_of_ratio
    {p pd pdd v : ℂ}
    (hpd : pd ≠ 0) (hp : p ≠ 0) (hv : v ≠ 0)
    (hstat : (star p * pd * v).re = 0)
    (hq : 0 < (1 - p * pdd / pd ^ 2).re) :
    0 < 2 * (Complex.normSq pd * Complex.normSq v +
      (star p * pdd * v ^ 2).re) := by
  let a : ℂ := star p * pd * v
  let q : ℂ := p * pdd / pd ^ 2
  have ha_re : a.re = 0 := by simpa [a] using hstat
  have ha_sq : a ^ 2 = -(Complex.normSq a : ℂ) := by
    apply Complex.ext
    · rw [pow_two, Complex.mul_re]
      simp [ha_re, Complex.normSq_apply]
    · rw [pow_two, Complex.mul_im]
      simp [ha_re]
  have hnorm_a : Complex.normSq a =
      Complex.normSq p * Complex.normSq pd * Complex.normSq v := by
    dsimp [a]
    rw [Complex.normSq_mul, Complex.normSq_mul]
    simp
  have hrel : q * a ^ 2 = Complex.normSq p *
      (star p * pdd * v ^ 2) := by
    dsimp [q, a]
    rw [Complex.normSq_eq_conj_mul_self]
    field_simp [hpd]
  have hq' : q.re < 1 := by
    dsimp [q] at hq ⊢
    linarith
  have hnormp : 0 < Complex.normSq p := Complex.normSq_pos.mpr hp
  have hnormpd : 0 < Complex.normSq pd := Complex.normSq_pos.mpr hpd
  have hnormv : 0 < Complex.normSq v := Complex.normSq_pos.mpr hv
  have hrel2 : q * (-(Complex.normSq a : ℂ)) = Complex.normSq p *
      (star p * pdd * v ^ 2) := by simpa [ha_sq] using hrel
  have hsecond :
      (star p * pdd * v ^ 2).re =
        -q.re * Complex.normSq pd * Complex.normSq v := by
    have hrel_re2 := congrArg Complex.re hrel2
    have hleft : (q * (-(Complex.normSq a : ℂ))).re =
        -q.re * Complex.normSq a := by
      norm_num [Complex.mul_re, Complex.neg_re, Complex.neg_im]
    have hright : (Complex.normSq p * (star p * pdd * v ^ 2)).re =
        Complex.normSq p * (star p * pdd * v ^ 2).re := by
      simp [Complex.mul_re]
    rw [hleft, hright, hnorm_a] at hrel_re2
    have hmul : Complex.normSq p * (star p * pdd * v ^ 2).re =
        Complex.normSq p * (-q.re * Complex.normSq pd * Complex.normSq v) := by
      nlinarith [hrel_re2]
    exact mul_left_cancel₀ (ne_of_gt hnormp) hmul
  rw [hsecond]
  have hqpos : 0 < 1 - q.re := by linarith
  have hpos : 0 < Complex.normSq pd * Complex.normSq v * (1 - q.re) := by
    exact mul_pos (mul_pos hnormpd hnormv) hqpos
  dsimp [q] at hpos ⊢
  nlinarith

/-! Real-coordinate formulas for a centered cubic.  These are kept in the
    barrier core so both the Formal Conjectures target and the Lean4Web copy
    use the same verified calculus interface. -/
def cubicValue (B z : ℂ) : ℂ := z ^ 3 - 3 * z + B

def cubicRealPart (B z : ℂ) : ℝ :=
  z.re ^ 3 - 3 * z.re * z.im ^ 2 - 3 * z.re + B.re

def cubicImagPart (B z : ℂ) : ℝ :=
  3 * z.re ^ 2 * z.im - z.im ^ 3 - 3 * z.im + B.im

def cubicRealFirst (z v : ℂ) : ℝ :=
  3 * z.re ^ 2 * v.re - 3 * v.re * z.im ^ 2 -
    6 * z.re * z.im * v.im - 3 * v.re

def cubicImagFirst (z v : ℂ) : ℝ :=
  6 * z.re * v.re * z.im + 3 * z.re ^ 2 * v.im -
    3 * z.im ^ 2 * v.im - 3 * v.im

def cubicRealSecond (z v : ℂ) : ℝ :=
  6 * z.re * v.re ^ 2 - 12 * v.re * z.im * v.im -
    6 * z.re * v.im ^ 2

def cubicImagSecond (z v : ℂ) : ℝ :=
  6 * v.re ^ 2 * z.im + 12 * z.re * v.re * v.im -
    6 * z.im * v.im ^ 2

def cubicNormSq (B z : ℂ) : ℝ :=
  cubicRealPart B z ^ 2 + cubicImagPart B z ^ 2

def cubicNormSqFirst (B z v : ℂ) : ℝ :=
  2 * cubicRealPart B z * cubicRealFirst z v +
    2 * cubicImagPart B z * cubicImagFirst z v

def cubicNormSqSecond (B z v : ℂ) : ℝ :=
  2 * (cubicRealFirst z v ^ 2 + cubicImagFirst z v ^ 2 +
    cubicRealPart B z * cubicRealSecond z v +
    cubicImagPart B z * cubicImagSecond z v)

theorem cubicNormSq_eq (B z : ℂ) :
    cubicNormSq B z = Complex.normSq (cubicValue B z) := by
  norm_num [cubicNormSq, cubicRealPart, cubicImagPart, cubicValue,
    Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
  ring

theorem line_re_hasDerivAt (z v : ℂ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => (z + (s : ℂ) * v).re) v.re t := by
  simpa only [Complex.add_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero, id_eq, one_mul] using
      ((hasDerivAt_id t).mul_const v.re).const_add z.re

theorem line_im_hasDerivAt (z v : ℂ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => (z + (s : ℂ) * v).im) v.im t := by
  simpa only [Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, add_zero, id_eq, one_mul] using
      ((hasDerivAt_id t).mul_const v.im).const_add z.im

theorem cubicRealPart_line_hasDerivAt (B z v : ℂ) (t : ℝ) :
    HasDerivAt
      (fun s : ℝ => cubicRealPart B (z + (s : ℂ) * v))
      (cubicRealFirst (z + (t : ℂ) * v) v) t := by
  have hx := line_re_hasDerivAt z v t
  have hy := line_im_hasDerivAt z v t
  have hraw := (((hx.pow 3).sub (((hx.mul (hy.pow 2)).const_mul 3))).sub
    (hx.const_mul 3)).const_add B.re
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [cubicRealPart, pow_succ]
    ring
  · simp [cubicRealFirst, pow_succ]
    ring

theorem cubicImagPart_line_hasDerivAt (B z v : ℂ) (t : ℝ) :
    HasDerivAt
      (fun s : ℝ => cubicImagPart B (z + (s : ℂ) * v))
      (cubicImagFirst (z + (t : ℂ) * v) v) t := by
  have hx := line_re_hasDerivAt z v t
  have hy := line_im_hasDerivAt z v t
  have hraw := ((((hx.pow 2).mul hy).const_mul 3).sub (hy.pow 3)).sub
    (hy.const_mul 3) |>.const_add B.im
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [cubicImagPart, pow_succ]
    ring
  · simp [cubicImagFirst, pow_succ]
    ring

theorem cubicRealFirst_line_hasDerivAt (z v : ℂ) (t : ℝ) :
    HasDerivAt
      (fun s : ℝ => cubicRealFirst (z + (s : ℂ) * v) v)
      (cubicRealSecond (z + (t : ℂ) * v) v) t := by
  have hx := line_re_hasDerivAt z v t
  have hy := line_im_hasDerivAt z v t
  have hraw := ((((hx.pow 2).const_mul (3 * v.re)).sub
    ((hy.pow 2).const_mul (3 * v.re))).sub
    ((hx.mul hy).const_mul (6 * v.im))).const_add (-3 * v.re)
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [cubicRealFirst, pow_succ]
    ring
  · simp [cubicRealSecond, pow_succ]
    ring

theorem cubicImagFirst_line_hasDerivAt (z v : ℂ) (t : ℝ) :
    HasDerivAt
      (fun s : ℝ => cubicImagFirst (z + (s : ℂ) * v) v)
      (cubicImagSecond (z + (t : ℂ) * v) v) t := by
  have hx := line_re_hasDerivAt z v t
  have hy := line_im_hasDerivAt z v t
  have hraw := (((((hx.mul hy).const_mul (6 * v.re)).add
    ((hx.pow 2).const_mul (3 * v.im))).sub
    ((hy.pow 2).const_mul (3 * v.im))).const_add (-3 * v.im))
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [cubicImagFirst, pow_succ]
    ring
  · simp [cubicImagSecond, pow_succ]
    ring

theorem cubicNormSq_line_hasDerivAt (B z v : ℂ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => cubicNormSq B (z + (s : ℂ) * v))
      (cubicNormSqFirst B (z + (t : ℂ) * v) v) t := by
  have hr := cubicRealPart_line_hasDerivAt B z v t
  have hi := cubicImagPart_line_hasDerivAt B z v t
  have hraw := (hr.pow 2).add (hi.pow 2)
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [cubicNormSq]
  · simp [cubicNormSqFirst, pow_succ]

theorem cubicNormSqFirst_line_hasDerivAt (B z v : ℂ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => cubicNormSqFirst B (z + (s : ℂ) * v) v)
      (cubicNormSqSecond B (z + (t : ℂ) * v) v) t := by
  have hr := cubicRealPart_line_hasDerivAt B z v t
  have hi := cubicImagPart_line_hasDerivAt B z v t
  have hr1 := cubicRealFirst_line_hasDerivAt z v t
  have hi1 := cubicImagFirst_line_hasDerivAt z v t
  have hraw := ((hr.mul hr1).const_mul 2).add ((hi.mul hi1).const_mul 2)
  refine (hraw.congr_of_eventuallyEq ?_).congr_deriv ?_
  · filter_upwards with s
    simp [cubicNormSqFirst]
    ring
  · simp [cubicNormSqSecond, pow_succ]
    ring

theorem cubicNormSqFirst_eq (B z v : ℂ) :
    cubicNormSqFirst B z v =
      2 * (star (cubicValue B z) * (3 * (z ^ 2 - 1)) * v).re := by
  simp only [cubicNormSqFirst, cubicRealPart, cubicImagPart, cubicRealFirst,
    cubicImagFirst, cubicValue]
  simp only [Complex.mul_re, Complex.mul_im, Complex.conj_re, Complex.conj_im]
  norm_num [pow_succ]
  ring

theorem cubicNormSqSecond_eq (B z v : ℂ) :
    cubicNormSqSecond B z v =
      2 * (Complex.normSq (3 * (z ^ 2 - 1)) * Complex.normSq v +
        (star (cubicValue B z) * (6 * z) * v ^ 2).re) := by
  norm_num [cubicNormSqSecond, cubicRealPart, cubicImagPart, cubicRealFirst,
    cubicImagFirst, cubicRealSecond, cubicImagSecond, cubicValue,
    Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
  ring

theorem cubicNormSqSecond_pos_of_ratio
    {B z v : ℂ} (hpd : 3 * (z ^ 2 - 1) ≠ 0) (hv : v ≠ 0)
    (hfirst : cubicNormSqFirst B z v = 0)
    (hq : 0 < (1 - cubicValue B z * (6 * z) /
      (3 * (z ^ 2 - 1)) ^ 2).re) :
    0 < cubicNormSqSecond B z v := by
  by_cases hp : cubicValue B z = 0
  · rw [cubicNormSqSecond_eq, hp]
    have hpdpos : 0 < Complex.normSq (3 * (z ^ 2 - 1)) :=
      Complex.normSq_pos.mpr hpd
    have hvpos : 0 < Complex.normSq v := Complex.normSq_pos.mpr hv
    have hpos : 0 < 2 *
        (Complex.normSq (3 * (z ^ 2 - 1)) * Complex.normSq v) :=
      mul_pos (by norm_num) (mul_pos hpdpos hvpos)
    simpa using hpos
  · rw [cubicNormSqSecond_eq]
    apply stationary_second_pos_of_ratio hpd hp hv ?_ hq
    rw [cubicNormSqFirst_eq] at hfirst
    linarith

theorem cubic_line_no_local_max
    (B z v : ℂ) (t : ℝ)
    (hpd : 3 * ((z + (t : ℂ) * v) ^ 2 - 1) ≠ 0) (hv : v ≠ 0)
    (hq : 0 < (1 - cubicValue B (z + (t : ℂ) * v) *
      (6 * (z + (t : ℂ) * v)) /
        (3 * ((z + (t : ℂ) * v) ^ 2 - 1)) ^ 2).re) :
    ¬ IsLocalMax (fun s : ℝ => cubicNormSq B (z + (s : ℂ) * v)) t := by
  let f : ℝ → ℝ := fun s => cubicNormSq B (z + (s : ℂ) * v)
  let g : ℝ → ℝ := fun s => cubicNormSqFirst B (z + (s : ℂ) * v) v
  have hf : ∀ s : ℝ, HasDerivAt f (g s) s := by
    intro s
    exact cubicNormSq_line_hasDerivAt B z v s
  have hg : HasDerivAt g (cubicNormSqSecond B
      (z + (t : ℂ) * v) v) t := by
    exact cubicNormSqFirst_line_hasDerivAt B z v t
  have hderiv : deriv f = g := by
    funext s
    exact (hf s).deriv
  intro hmax
  have hfirst : cubicNormSqFirst B (z + (t : ℂ) * v) v = 0 := by
    have hzero := hmax.deriv_eq_zero
    rw [hderiv] at hzero
    exact hzero
  have hsecond : 0 < deriv (deriv f) t := by
    rw [hderiv, hg.deriv]
    exact cubicNormSqSecond_pos_of_ratio hpd hv hfirst hq
  exact (not_isLocalMax_of_deriv_deriv_pos (hf t).continuousAt hsecond
    (by rw [hderiv]; exact hfirst)) hmax

/-! Segment-level packaging.  Once the curvature ratio is known at every
    interior point of a line in the left branch, the squared norm on that line
    has no interior local maximum.  The endpoint lemma then gives the exact
    one-dimensional estimate needed for convexity of a sublevel component. -/
theorem cubic_segment_normSq_le_max_endpoints
    (B z v : ℂ) (hv : v ≠ 0)
    (hpd : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
      3 * ((z + (t : ℂ) * v) ^ 2 - 1) ≠ 0)
    (hq : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
      0 < (1 - cubicValue B (z + (t : ℂ) * v) *
        (6 * (z + (t : ℂ) * v)) /
          (3 * ((z + (t : ℂ) * v) ^ 2 - 1)) ^ 2).re) :
    ∀ t ∈ Set.Icc (0 : ℝ) 1,
      cubicNormSq B (z + (t : ℂ) * v) ≤
        max (cubicNormSq B z) (cubicNormSq B (z + v)) := by
  let f : ℝ → ℝ := fun s => cubicNormSq B (z + (s : ℂ) * v)
  have hfcont : ContinuousOn f (Set.Icc (0 : ℝ) 1) := by
    dsimp [f]
    unfold cubicNormSq cubicRealPart cubicImagPart
    fun_prop
  have hno : ∀ t ∈ Set.Ioo (0 : ℝ) 1, ¬ IsLocalMax f t := by
    intro t ht
    apply cubic_line_no_local_max B z v t
    · exact hpd t ht
    · exact hv
    · exact hq t ht
  have hmax := le_max_endpoints_of_no_isLocalMax (f := f)
    (by norm_num : (0 : ℝ) < 1) hfcont hno
  intro t ht
  simpa [f] using hmax t ht

theorem convex_connectedComponentIn_of_segment_subset
    (S : Set ℂ) (r : ℂ)
    (hseg : ∀ ⦃x y : ℂ⦄,
      x ∈ connectedComponentIn S r → y ∈ connectedComponentIn S r →
        segment ℝ x y ⊆ S) :
    Convex ℝ (connectedComponentIn S r) := by
  rw [convex_iff_segment_subset]
  intro x hx y hy
  rw [connectedComponentIn_eq hx]
  apply (convex_segment x y).isPreconnected.subset_connectedComponentIn
    (left_mem_segment ℝ x y)
  exact hseg hx hy

end

