section


/-!
# Balanced degree raising for an arbitrary real polynomial

The centre value is synchronized with the old level by setting
`D = b L² / p(L)` and `A = -p'(L) D / p(L)`.  The raised polynomial is
`p(z) ((z-L)² + A(z-L) + D)`.  This file proves the algebraic identities and
uniform approximation on every fixed compact set as `L → ∞`.

This approximation preserves finite old witnesses, not global component
separation.  The new two-component local construction remains a separate task.
-/

open Polynomial Set Filter
open scoped Topology
open Erdos1047TunedRaise

namespace Erdos1047BalancedRaise

noncomputable section

def complexify (p : ℝ[X]) : ℂ[X] := p.map (algebraMap ℝ ℂ)

def balancedD (p : ℝ[X]) (b L : ℝ) : ℝ := b * L ^ 2 / p.eval L

def balancedA (p : ℝ[X]) (b L : ℝ) : ℝ :=
  -p.derivative.eval L * balancedD p b L / p.eval L

def raisedReal (p : ℝ[X]) (b L : ℝ) : ℝ[X] :=
  p * ((X - C L) ^ 2 + C (balancedA p b L) * (X - C L) + C (balancedD p b L))

def raised (p : ℝ[X]) (b L : ℝ) : ℂ[X] := complexify (raisedReal p b L)

theorem complexify_eval_real (p : ℝ[X]) (L : ℝ) :
    (complexify p).eval (L : ℂ) = ((p.eval L : ℝ) : ℂ) := by
  exact eval_map_apply (algebraMap ℝ ℂ) L

theorem raised_eq_tuned (p : ℝ[X]) (b L : ℝ) :
    raised p b L = tunedRaisePolynomial (complexify p) (L : ℂ)
      (balancedA p b L : ℂ) (balancedD p b L : ℂ) := by
  simp [raised, raisedReal, complexify, tunedRaisePolynomial, tunedRaiseFactor]

theorem raised_monic {p : ℝ[X]} (hp : p.Monic) (b L : ℝ) :
    (raised p b L).Monic := by
  rw [raised_eq_tuned]
  exact tunedRaisePolynomial_monic _ _ _ _ (hp.map _)

theorem raised_natDegree {p : ℝ[X]} (hp : p.Monic) (b L : ℝ) :
    (raised p b L).natDegree = p.natDegree + 2 := by
  calc
    (raised p b L).natDegree = (complexify p).natDegree + 2 := by
      rw [raised_eq_tuned]
      exact tunedRaisePolynomial_natDegree _ _ _ _ (hp.map _)
    _ = p.natDegree + 2 := ?_
  rw [complexify, natDegree_map_eq_of_injective (algebraMap ℝ ℂ).injective]

theorem raised_eval (p : ℝ[X]) (b L : ℝ) (z : ℂ) :
    (raised p b L).eval z = (complexify p).eval z *
      ((z - (L : ℂ)) ^ 2 + (balancedA p b L : ℂ) * (z - (L : ℂ)) +
        (balancedD p b L : ℂ)) := by
  rw [raised_eq_tuned, tunedRaisePolynomial_eval]

theorem raised_eval_center {p : ℝ[X]} {b L : ℝ} (hpL : p.eval L ≠ 0) :
    (raised p b L).eval (L : ℂ) = ((b * L ^ 2 : ℝ) : ℂ) := by
  rw [raised_eq_tuned, tunedRaisePolynomial_eval_center, complexify_eval_real]
  have hreal : p.eval L * balancedD p b L = b * L ^ 2 := by
    unfold balancedD
    field_simp
  exact_mod_cast hreal

theorem raised_derivative_eval_center {p : ℝ[X]} {b L : ℝ}
    (hpL : p.eval L ≠ 0) : (raised p b L).derivative.eval (L : ℂ) = 0 := by
  have hslope : (balancedA p b L : ℂ) =
      tunedRaiseSlope (complexify p) (L : ℂ) (balancedD p b L : ℂ) := by
    have hderiv : (complexify p).derivative = complexify p.derivative := by
      simp [complexify, derivative_map]
    rw [tunedRaiseSlope, hderiv, complexify_eval_real, complexify_eval_real]
    simp [balancedA]
  rw [raised_eq_tuned, hslope]
  apply tunedRaisePolynomial_derivative_eval_center_of_slope
  rw [complexify_eval_real]
  exact_mod_cast hpL

theorem tendsto_balancedD {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) :
    Tendsto (balancedD p b) atTop (𝓝 0) := by
  have hdegree : (X ^ 2 : ℝ[X]).degree < p.degree := by
    rw [degree_X_pow, degree_eq_natDegree hp.ne_zero]
    exact_mod_cast hdeg
  have h := (X ^ 2 : ℝ[X]).div_tendsto_atTop_zero_of_degree_lt p hdegree
  change Tendsto (fun L => b * L ^ 2 / p.eval L) atTop (𝓝 0)
  simpa [mul_div_assoc] using h.const_mul b

theorem tendsto_balancedA {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) :
    Tendsto (balancedA p b) atTop (𝓝 0) := by
  have h := p.derivative.div_tendsto_atTop_zero_of_degree_lt p
    (degree_derivative_lt hp.ne_zero)
  change Tendsto (fun L => -p.derivative.eval L * balancedD p b L / p.eval L)
    atTop (𝓝 0)
  simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using
    h.neg.mul (tendsto_balancedD hp hdeg b)

theorem norm_quadratic_error_le (u v w : ℂ) :
    ‖-2 * u + u ^ 2 + v * (u - 1) + w‖ ≤
      2 * ‖u‖ + ‖u‖ ^ 2 + ‖v‖ * (‖u‖ + 1) + ‖w‖ := by
  calc
    _ ≤ ‖-2 * u + u ^ 2 + v * (u - 1)‖ + ‖w‖ := norm_add_le _ _
    _ ≤ (‖-2 * u + u ^ 2‖ + ‖v * (u - 1)‖) + ‖w‖ := by
      gcongr
      exact norm_add_le _ _
    _ ≤ (‖-2 * u‖ + ‖u ^ 2‖ + ‖v * (u - 1)‖) + ‖w‖ := by
      gcongr
      exact norm_add_le _ _
    _ ≤ _ := by
      simp only [norm_mul, norm_pow]
      norm_num
      gcongr
      simpa using norm_sub_le u (1 : ℂ)

theorem scaled_difference_norm_le
    (p : ℝ[X]) (b : ℝ) {L R M : ℝ} (hL : 0 < L)
    (_hR : 0 ≤ R) (hM : 0 ≤ M) {z : ℂ}
    (hz : ‖z‖ ≤ R) (hpz : ‖(complexify p).eval z‖ ≤ M) :
    ‖(raised p b L).eval z / (L : ℂ) ^ 2 - (complexify p).eval z‖ ≤
      M * (2 * (R / L) + (R / L) ^ 2 +
        (|balancedA p b L| / L) * (R / L + 1) + |balancedD p b L| / L ^ 2) := by
  have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hL)
  have hid : (raised p b L).eval z / (L : ℂ) ^ 2 - (complexify p).eval z =
      (complexify p).eval z *
        (-2 * (z / (L : ℂ)) + (z / (L : ℂ)) ^ 2 +
          ((balancedA p b L : ℂ) / (L : ℂ)) * (z / (L : ℂ) - 1) +
          (balancedD p b L : ℂ) / (L : ℂ) ^ 2) := by
    rw [raised_eval]
    field_simp
    ring
  rw [hid, norm_mul]
  have hzdiv : ‖z / (L : ℂ)‖ ≤ R / L := by
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
    exact div_le_div_of_nonneg_right hz hL.le
  have hnorm := norm_quadratic_error_le (z / (L : ℂ))
    ((balancedA p b L : ℂ) / (L : ℂ))
    ((balancedD p b L : ℂ) / (L : ℂ) ^ 2)
  have hbound : ‖-2 * (z / (L : ℂ)) + (z / (L : ℂ)) ^ 2 +
      ((balancedA p b L : ℂ) / (L : ℂ)) * (z / (L : ℂ) - 1) +
      (balancedD p b L : ℂ) / (L : ℂ) ^ 2‖ ≤
      2 * (R / L) + (R / L) ^ 2 +
        (|balancedA p b L| / L) * (R / L + 1) + |balancedD p b L| / L ^ 2 := by
    apply hnorm.trans
    simp only [norm_div, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
    gcongr
  exact mul_le_mul hpz hbound (norm_nonneg _) hM

theorem eventually_uniform_scaled_close_on_compact
    {p : ℝ[X]} (hp : p.Monic) (hdeg : 2 < p.natDegree) (b : ℝ)
    {K : Set ℂ} (hK : IsCompact K) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ z ∈ K,
      ‖(raised p b L).eval z / (L : ℂ) ^ 2 - (complexify p).eval z‖ < ε := by
  obtain ⟨R₀, hR₀⟩ := hK.exists_bound_of_continuousOn continuous_id.continuousOn
  obtain ⟨M₀, hM₀⟩ := hK.exists_bound_of_continuousOn
    (complexify p).continuous.continuousOn
  let R := max R₀ 0
  let M := max M₀ 0
  have hR : 0 ≤ R := le_max_right _ _
  have hM : 0 ≤ M := le_max_right _ _
  have hRdiv : Tendsto (fun L : ℝ => R / L) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop tendsto_id
  have hAdiv : Tendsto (fun L : ℝ => |balancedA p b L| / L) atTop (𝓝 0) := by
    simpa using (tendsto_balancedA hp hdeg b).abs.div_atTop tendsto_id
  have hDdiv : Tendsto (fun L : ℝ => |balancedD p b L| / L ^ 2) atTop (𝓝 0) := by
    simpa using (tendsto_balancedD hp hdeg b).abs.div_atTop
      (tendsto_pow_atTop (by norm_num : (2 : ℕ) ≠ 0))
  have hlim : Tendsto (fun L : ℝ => M * (2 * (R / L) + (R / L) ^ 2 +
      (|balancedA p b L| / L) * (R / L + 1) + |balancedD p b L| / L ^ 2))
      atTop (𝓝 0) := by
    simpa using (((hRdiv.const_mul 2).add (hRdiv.pow 2)).add
      (hAdiv.mul (hRdiv.add_const 1))).add hDdiv |>.const_mul M
  filter_upwards [eventually_gt_atTop (0 : ℝ), hlim.eventually_lt_const hε]
    with L hL hclose
  intro z hz
  exact (scaled_difference_norm_le p b hL hR hM
    ((hR₀ z hz).trans (le_max_left _ _))
    ((hM₀ z hz).trans (le_max_left _ _))).trans_lt hclose

#print axioms raised_eval_center
#print axioms raised_derivative_eval_center
#print axioms eventually_uniform_scaled_close_on_compact

end
end Erdos1047BalancedRaise

end

