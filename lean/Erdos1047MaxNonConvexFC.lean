  rw [p5_imaginary_axis_re] at hrele
  have hs0 : 0 ≤ y ^ 2 := sq_nonneg y
  have hs1 : 0 ≤ y ^ 4 := by positivity
  have hgap : 0 < (6066209 / 1069056 : ℝ) - p5Level := by
    rw [p5_constant_sub_level]
    norm_num
  nlinarith

theorem p5Polynomial_monic : p5Polynomial.Monic := by
  unfold p5Polynomial
  monicity!

theorem p5Polynomial_natDegree : p5Polynomial.natDegree = 5 := by
  unfold p5Polynomial
  compute_degree!

/-- No zero of p5 can be critical.  This proof uses the exhaustive critical-point
classification above and the exact value at each of the four points. -/
theorem p5Polynomial_separable : p5Polynomial.Separable := by
  rw [Polynomial.separable_def,
    Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed (k := ℂ) ℂ
      p5Polynomial p5Polynomial.derivative]
  intro z
  change p5Polynomial.eval z ≠ 0 ∨ p5Polynomial.derivative.eval z ≠ 0
  by_cases hd : p5Polynomial.derivative.eval z = 0
  · left
    rcases (p5_derivative_eval_zero_iff z).mp hd with rfl | rfl | rfl | rfl
    · rw [p5_eval_zero]
      norm_num
    · rw [p5_eval_one]
      norm_num [p5Level]
    · rw [p5_eval_splus]
      intro h
      have hi := congrArg Complex.im h
      norm_num at hi
    · rw [p5_eval_sminus]
      intro h
      have hi := congrArg Complex.im h
      norm_num at hi
  · exact Or.inr hd

theorem p5_rootSet_ncard : (p5Polynomial.rootSet ℂ).ncard = 5 := by
  have hcard : Fintype.card (p5Polynomial.rootSet ℂ) = p5Polynomial.natDegree :=
    Polynomial.card_rootSet_eq_natDegree p5Polynomial_separable (IsAlgClosed.splits _)
  rw [p5Polynomial_natDegree] at hcard
  simpa using hcard

theorem p5_cauchyBound_lt_100 : Polynomial.cauchyBound p5Polynomial < 100 := by
  unfold Polynomial.cauchyBound
  rw [p5Polynomial_natDegree]
  have hs : (Finset.range 5).sup (fun x => ‖p5Polynomial.coeff x‖₊) < 10 := by
    apply lt_of_le_of_lt (Finset.sup_le (a := (9 : NNReal)) ?_) (by norm_num)
    intro x hx
    have hxlt : x < 5 := by simpa using hx
    have hx' : x = 0 ∨ x = 1 ∨ x = 2 ∨ x = 3 ∨ x = 4 := by omega
    rcases hx' with rfl | rfl | rfl | rfl | rfl <;>
      norm_num [p5Polynomial, NNReal.coe_le_coe, div_le_iff₀]
  have hlead : ‖p5Polynomial.leadingCoeff‖₊ = 1 := by
    rw [Polynomial.leadingCoeff, p5Polynomial_natDegree]
    norm_num [p5Polynomial]
  rw [hlead]
  simp only [div_one]
  calc
    (Finset.range 5).sup (fun x => ‖p5Polynomial.coeff x‖₊) + 1 < 10 + 1 := by
      simpa [add_comm] using add_lt_add_right hs 1
    _ < 100 := by norm_num

theorem p5_root_norm_lt_100 {z : ℂ} (hz : z ∈ p5Polynomial.rootSet ℂ) : ‖z‖ < 100 := by
  have hroot : p5Polynomial.IsRoot z := by
    exact p5Polynomial_monic.mem_rootSet.mp hz
  have hcb : ‖z‖₊ < p5Polynomial.cauchyBound :=
    Polynomial.IsRoot.norm_lt_cauchyBound p5Polynomial_monic.ne_zero hroot
  have hcb' : p5Polynomial.cauchyBound < 100 := by
    exact (by
      unfold Polynomial.cauchyBound
      rw [p5Polynomial_natDegree]
      have hs : (Finset.range 5).sup (fun x => ‖p5Polynomial.coeff x‖₊) < 9 := by
        apply lt_of_le_of_lt (Finset.sup_le (a := (8 : NNReal)) ?_) (by norm_num)
        intro x hx
        have hxlt : x < 5 := by simpa using hx
        have hx' : x = 0 ∨ x = 1 ∨ x = 2 ∨ x = 3 ∨ x = 4 := by omega
        rcases hx' with rfl | rfl | rfl | rfl | rfl <;>
          norm_num [p5Polynomial, NNReal.coe_le_coe, div_le_iff₀]
      have hlead : ‖p5Polynomial.leadingCoeff‖₊ = 1 := by
        rw [Polynomial.leadingCoeff, p5Polynomial_natDegree]
        norm_num [p5Polynomial]
      rw [hlead]
      simp only [div_one]
      calc
        (Finset.range 5).sup (fun x => ‖p5Polynomial.coeff x‖₊) + 1 < 9 + 1 := by
          simpa [add_comm] using add_lt_add_right hs 1
        _ < 100 := by norm_num)
  have hcbNN : ‖z‖₊ < (100 : NNReal) := lt_trans hcb hcb'
  have hcoerc : (‖z‖₊ : ℝ) < (100 : ℝ) := (NNReal.coe_lt_coe).mpr hcbNN
  simpa only [coe_nnnorm] using hcoerc

theorem p5_real_square_raise_factor_coprime_of_large_center {L : ℝ} (hL : 100 ≤ L) :
    IsCoprime p5Polynomial
      (Erdos1047DegreeRaise.raiseFactor (L : ℂ) ((L : ℂ) ^ 2)) := by
  apply Erdos1047DegreeRaise.raiseFactor_coprime_of_no_common_root
  intro z hz hfactor
  have hzroot : z ∈ p5Polynomial.rootSet ℂ :=
    p5Polynomial_monic.mem_rootSet.mpr hz
  have hnorm : ‖z‖ < 100 := by
    have hroot : p5Polynomial.IsRoot z := p5Polynomial_monic.mem_rootSet.mp hzroot
    have hcb : ‖z‖₊ < p5Polynomial.cauchyBound :=
      Polynomial.IsRoot.norm_lt_cauchyBound p5Polynomial_monic.ne_zero hroot
    have hbound : p5Polynomial.cauchyBound < 100 := by
      unfold Polynomial.cauchyBound
      rw [p5Polynomial_natDegree]
      have hs : (Finset.range 5).sup (fun x => ‖p5Polynomial.coeff x‖₊) < 9 := by
        apply lt_of_le_of_lt (Finset.sup_le (a := (8 : NNReal)) ?_) (by norm_num)
        intro x hx
        have hxlt : x < 5 := by simpa using hx
        have hx' : x = 0 ∨ x = 1 ∨ x = 2 ∨ x = 3 ∨ x = 4 := by omega
        rcases hx' with rfl | rfl | rfl | rfl | rfl <;>
          norm_num [p5Polynomial, NNReal.coe_le_coe, div_le_iff₀]
      have hlead : ‖p5Polynomial.leadingCoeff‖₊ = 1 := by
        rw [Polynomial.leadingCoeff, p5Polynomial_natDegree]
        norm_num [p5Polynomial]
      rw [hlead]
      simp only [div_one]
      calc
        (Finset.range 5).sup (fun x => ‖p5Polynomial.coeff x‖₊) + 1 < 9 + 1 := by
          simpa [add_comm] using add_lt_add_right hs 1
        _ < 100 := by norm_num
    have hcbNN : ‖z‖₊ < (100 : NNReal) := lt_trans hcb hbound
    have hcoerc : (‖z‖₊ : ℝ) < (100 : ℝ) := (NNReal.coe_lt_coe).mpr hcbNN
    simpa only [coe_nnnorm] using hcoerc
  have hfactorroot :
      (Erdos1047DegreeRaise.raiseFactor (L : ℂ) ((L : ℂ) ^ 2)).eval z = 0 := by
    simpa [Erdos1047DegreeRaise.raiseFactor_eval] using hfactor
  have hzset : z ∈ (Erdos1047DegreeRaise.raiseFactor (L : ℂ)
      ((L : ℂ) ^ 2)).rootSet ℂ :=
    (Erdos1047DegreeRaise.raiseFactor_monic (L : ℂ) ((L : ℂ)^2)).mem_rootSet.mpr hfactorroot
  have hznew : z ∈ ({(L : ℂ) + (L : ℂ) * Complex.I,
      (L : ℂ) - (L : ℂ) * Complex.I} : Set ℂ) := by
    have hLne : (L : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt (by linarith : 0 < L))
    rw [Erdos1047DegreeRaise.raiseFactor_rootSet_eq_two
      (L : ℂ) (L : ℂ) hLne] at hzset
    exact hzset
  rcases hznew with hzplus | hzminus
  · have hz' : z = (L : ℂ) + (L : ℂ) * Complex.I := by simpa using hzplus
    subst z
    have hLnorm : L ≤ ‖(L : ℂ) + (L : ℂ) * Complex.I‖ := by
      simpa using (Complex.re_le_norm ((L : ℂ) + (L : ℂ) * Complex.I))
    linarith
  · have hz' : z = (L : ℂ) - (L : ℂ) * Complex.I := by simpa using hzminus
    subst z
    have hLnorm : L ≤ ‖(L : ℂ) - (L : ℂ) * Complex.I‖ := by
      simpa using (Complex.re_le_norm ((L : ℂ) - (L : ℂ) * Complex.I))
    linarith


/-- `p5Level` really is the minimum modulus of a critical value. -/
theorem p5_critical_value_norm_ge (z : ℂ)
    (hz : p5Polynomial.derivative.eval z = 0) :
    p5Level ≤ ‖p5Polynomial.eval z‖ := by
  rcases (p5_derivative_eval_zero_iff z).mp hz with rfl | rfl | rfl | rfl
  · rw [p5_eval_zero]
    norm_num [p5Level]
  · rw [p5_eval_one]
    norm_num [p5Level]
  · rw [p5_splus_norm]
  · rw [p5_sminus_norm]

/-- Every strict subcritical p5 sublevel set is free of critical points.  This is
the exact hypothesis needed by a covering/inverse-branch argument. -/
theorem p5_derivative_ne_zero_on_sublevel {c : ℝ} (hc : c < p5Level) (z : ℂ)
    (hz : z ∈ Erdos1047.sublevelSet p5Polynomial c) :
    p5Polynomial.derivative.eval z ≠ 0 := by
  intro hcritical
  have hmin := p5_critical_value_norm_ge z hcritical
  have hzlevel : ‖p5Polynomial.eval z‖ ≤ c := hz
  linarith

/-- The set whose greatest element is requested by the registered theorem. -/
abbrev attainableNonConvexCounts (n : ℕ) : Set ℕ :=
  {k : ℕ | ∃ (f : ℂ[X]) (c : ℝ), f.Monic ∧ f.natDegree = n ∧ 0 < c ∧
    (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard =
      (f.rootSet ℂ).ncard ∧
    {t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c) |
      ¬ Convex ℝ t}.ncard = k}

/-- A positive-degree monic complex polynomial has a nonempty finite root set. -/
theorem rootSet_ncard_pos (f : ℂ[X]) (hf : f.Monic) (hn : 0 < f.natDegree) :
    0 < (f.rootSet ℂ).ncard := by
  apply (Set.ncard_pos (f.rootSet_finite ℂ)).2
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_root f (by
    intro h
    have : f.natDegree = 0 := natDegree_eq_of_degree_eq_some h
    omega)
  exact ⟨z, hf.mem_rootSet.mpr (by simpa using hz)⟩

/-- The component-count hypothesis already gives the general degree upper bound.

No critical-point count, Riemann–Hurwitz formula, or curvature theorem is needed.
The positivity step matters: `Set.ncard` is also zero for infinite sets.
-/
theorem attainable_le_degree {n k : ℕ} (hn : 0 < n)
    (hk : k ∈ attainableNonConvexCounts n) : k ≤ n := by
  obtain ⟨f, c, hf, hdeg, _, hcount, hk⟩ := hk
  have hfin : (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).Finite :=
    Set.finite_of_ncard_pos (by
      rw [hcount]
      exact rootSet_ncard_pos f hf (by omega))
  calc
    k = {t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet f c) | ¬ Convex ℝ t}.ncard := hk.symm
    _ ≤ (Erdos1047.componentsIn (Erdos1047.sublevelSet f c)).ncard :=
      Set.ncard_le_ncard (by intro t ht; exact ht.1) hfin
    _ = (f.rootSet ℂ).ncard := hcount
    _ ≤ f.natDegree := f.ncard_rootSet_le ℂ
    _ = n := hdeg

/-- The upper-bound half of the exact target is complete in every degree at least four. -/
theorem attainable_le_proposed_answer_of_four_le {n k : ℕ} (hn : 4 ≤ n)
    (hk : k ∈ attainableNonConvexCounts n) : k ≤ maxNonConvexAnswer n := by
  rw [maxNonConvexAnswer_of_four_le hn]
  exact attainable_le_degree (by omega) hk

/-! Connected components are monotone under enlarging the ambient set.  This
    elementary fact is the bookkeeping needed when a sublevel is raised past
    a critical value: components can merge, but never split. -/
theorem connectedComponentIn_mono {S T : Set ℂ} (hST : S ⊆ T)
    {x : ℂ} (hx : x ∈ S) :
    connectedComponentIn S x ⊆ connectedComponentIn T x := by
  intro y hy
  have hST' : connectedComponentIn S x ⊆ T :=
    (connectedComponentIn_subset S x).trans hST
  exact isPreconnected_connectedComponentIn.subset_connectedComponentIn
    (mem_connectedComponentIn hx) hST' hy

/-! A continuous path in an ambient set gives the endpoint component equality
    used by the critical-value collision route.  Keeping this independent of
    polynomials makes later path-lifting constructions purely analytic. -/
theorem path_endpoints_same_connectedComponentIn
    {S : Set ℂ} {γ : ℝ → ℂ}
    (hcont : ContinuousOn γ (Set.Icc (0 : ℝ) 1))
    (hpath : ∀ t ∈ Set.Icc (0 : ℝ) 1, γ t ∈ S) :
    connectedComponentIn S (γ 0) = connectedComponentIn S (γ 1) := by
  have hImpre : IsPreconnected (γ '' Set.Icc (0 : ℝ) 1) :=
    isPreconnected_Icc.image γ hcont
  have hImsub : γ '' Set.Icc (0 : ℝ) 1 ⊆ S := by
    rintro z ⟨t, ht, rfl⟩
    exact hpath t ht
  have h0Im : γ 0 ∈ γ '' Set.Icc (0 : ℝ) 1 :=
    ⟨0, ⟨le_rfl, by norm_num⟩, rfl⟩
  have h1Im : γ 1 ∈ γ '' Set.Icc (0 : ℝ) 1 :=
    ⟨1, ⟨by norm_num, le_rfl⟩, rfl⟩
  have h1C : γ 1 ∈ connectedComponentIn S (γ 0) :=
    hImpre.subset_connectedComponentIn h0Im hImsub h1Im
  exact connectedComponentIn_eq h1C

/-! If two paths in the same ambient set end at a common point, their starting
    points lie in the same connected component.  This is the exact elementary
    topological shell needed once analytic path lifting supplies two branches
    running into a critical point. -/
theorem roots_collide_of_two_paths_to_common_point
    {S : Set ℂ} {r s q : ℂ}
    {γr γs : ℝ → ℂ}
    (hcont_r : ContinuousOn γr (Set.Icc (0 : ℝ) 1))
    (hmem_r : ∀ t ∈ Set.Icc (0 : ℝ) 1, γr t ∈ S)
    (hstart_r : γr 0 = r) (hend_r : γr 1 = q)
    (hcont_s : ContinuousOn γs (Set.Icc (0 : ℝ) 1))
    (hmem_s : ∀ t ∈ Set.Icc (0 : ℝ) 1, γs t ∈ S)
    (hstart_s : γs 0 = s) (hend_s : γs 1 = q) :
    connectedComponentIn S r = connectedComponentIn S s := by
  have hcr := path_endpoints_same_connectedComponentIn hcont_r hmem_r
  have hcs := path_endpoints_same_connectedComponentIn hcont_s hmem_s
  have hcr' : connectedComponentIn S r = connectedComponentIn S q := by
    simpa [hstart_r, hend_r] using hcr
  have hcs' : connectedComponentIn S s = connectedComponentIn S q := by
    simpa [hstart_s, hend_s] using hcs
  exact hcr'.trans hcs'.symm

/-! A finite-cardinality form of the preceding monotonicity principle.  If every
    larger-set component meets the smaller set, choose one point in that
    intersection.  The smaller component containing the chosen point is then an
    injective label for the larger component.  This is the precise bookkeeping
    statement needed for ``raising a sublevel cannot create a new component'';
    the geometric work in the degree-raising argument is isolated in the
    `hmeet` hypothesis. -/
theorem componentsIn_ncard_le_of_component_meets
    {S T : Set ℂ}
    (hST : S ⊆ T)
    (hmeet : ∀ t ∈ componentsIn T, ∃ x ∈ t, x ∈ S)
    (hfin : (componentsIn S).Finite) :
    (componentsIn T).ncard ≤ (componentsIn S).ncard := by
  classical
  let pick : Set ℂ → ℂ := fun t =>
    if ht : t ∈ componentsIn T then Classical.choose (hmeet t ht) else 0
  let f : Set ℂ → Set ℂ := fun t => connectedComponentIn S (pick t)
  apply Set.ncard_le_ncard_of_injOn f _ _ hfin
  · intro t ht
    have hpick : pick t ∈ S := by
      dsimp [pick]
      split <;> rename_i h
      · exact (Classical.choose_spec (hmeet t h)).2
      · exact False.elim (h ht)
    exact ⟨pick t, hpick, rfl⟩
  · intro a ha b hb hab
    have hpa : pick a ∈ a := by
      dsimp [pick]
      split <;> rename_i h
      · exact (Classical.choose_spec (hmeet a h)).1
      · exact False.elim (h ha)
    have hpb : pick b ∈ b := by
      dsimp [pick]
      split <;> rename_i h
      · exact (Classical.choose_spec (hmeet b h)).1
      · exact False.elim (h hb)
    have ha_eq : connectedComponentIn T (pick a) = a := by
      obtain ⟨z, hzT, hz⟩ := ha
      have hpa' : pick a ∈ connectedComponentIn T z := by
        rw [← hz]
        exact hpa
      exact (connectedComponentIn_eq hpa').symm.trans hz.symm
    have hb_eq : connectedComponentIn T (pick b) = b := by
      obtain ⟨z, hzT, hz⟩ := hb
      have hpb' : pick b ∈ connectedComponentIn T z := by
        rw [← hz]
        exact hpb
      exact (connectedComponentIn_eq hpb').symm.trans hz.symm
    have hpaS : pick a ∈ S := by
      dsimp [pick]
      split <;> rename_i h
      · exact (Classical.choose_spec (hmeet a h)).2
      · exact False.elim (h ha)
    have hpbS : pick b ∈ S := by
      dsimp [pick]
      split <;> rename_i h
      · exact (Classical.choose_spec (hmeet b h)).2
      · exact False.elim (h hb)
    have hps : connectedComponentIn S (pick a) = connectedComponentIn S (pick b) :=
      hab
    have hpb_in_Ca : pick b ∈ connectedComponentIn T (pick a) := by
      have hpb_in_CSa : pick b ∈ connectedComponentIn S (pick a) := by
        rw [hps]
        exact mem_connectedComponentIn hpbS
      exact (_root_.connectedComponentIn_mono (pick a) hST) hpb_in_CSa
    have hcomp_eq : connectedComponentIn T (pick a) = connectedComponentIn T (pick b) :=
      connectedComponentIn_eq hpb_in_Ca
    calc
      a = connectedComponentIn T (pick a) := ha_eq.symm
      _ = connectedComponentIn T (pick b) := hcomp_eq
      _ = b := hb_eq

/-- A finite geometric certificate for non-convexity, with no curvature calculation.

Both segments stay in the sublevel set, while the midpoint of their endpoints does not.
-/
theorem component_not_convex_of_segments {S : Set ℂ} {r a b : ℂ}
    (ha : segment ℝ r a ⊆ S) (hb : segment ℝ r b ⊆ S)
    (hm : midpoint ℝ a b ∉ S) :
    ¬ Convex ℝ (connectedComponentIn S r) := by
  have haC : a ∈ connectedComponentIn S r :=
    ((convex_segment r a).isPreconnected.subset_connectedComponentIn
      (left_mem_segment ℝ r a) ha) (right_mem_segment ℝ r a)
  have hbC : b ∈ connectedComponentIn S r :=
    ((convex_segment r b).isPreconnected.subset_connectedComponentIn
      (left_mem_segment ℝ r b) hb) (right_mem_segment ℝ r b)
  intro hc
  exact hm (connectedComponentIn_subset S r (hc.midpoint_mem haC hbC))

/-! A path version of the preceding certificate.  This is useful when the
    natural geometric arcs from a root to two boundary points are not straight
    segments: it only asks that both arcs stay in the sublevel and that their
    endpoint midpoint leaves it. -/
theorem component_not_convex_of_two_paths
    {S : Set ℂ} {r a b : ℂ}
    {γa γb : ℝ → ℂ}
    (hcont_a : ContinuousOn γa (Set.Icc (0 : ℝ) 1))
    (hmem_a : ∀ t ∈ Set.Icc (0 : ℝ) 1, γa t ∈ S)
    (hstart_a : γa 0 = r) (hend_a : γa 1 = a)
    (hcont_b : ContinuousOn γb (Set.Icc (0 : ℝ) 1))
    (hmem_b : ∀ t ∈ Set.Icc (0 : ℝ) 1, γb t ∈ S)
    (hstart_b : γb 0 = r) (hend_b : γb 1 = b)
    (hm : midpoint ℝ a b ∉ S) :
    ¬ Convex ℝ (connectedComponentIn S r) := by
  have hca := path_endpoints_same_connectedComponentIn hcont_a hmem_a
  have hcb := path_endpoints_same_connectedComponentIn hcont_b hmem_b
  have haS : a ∈ S := by
    simpa [hend_a] using hmem_a 1 (by norm_num)
  have hbS : b ∈ S := by
    simpa [hend_b] using hmem_b 1 (by norm_num)
  have haC : a ∈ connectedComponentIn S r := by
    have haCa' : a ∈ connectedComponentIn S a :=
      mem_connectedComponentIn haS
    have haCa : a ∈ connectedComponentIn S (γa 1) := by
      simpa [hend_a] using haCa'
    rw [← hca] at haCa
    simpa [hstart_a] using haCa
  have hbC : b ∈ connectedComponentIn S r := by
    have hbCb' : b ∈ connectedComponentIn S b :=
      mem_connectedComponentIn hbS
    have hbCb : b ∈ connectedComponentIn S (γb 1) := by
      simpa [hend_b] using hbCb'
    rw [← hcb] at hbCb
    simpa [hstart_b] using hbCb
  intro hc
  exact hm (connectedComponentIn_subset S r (hc.midpoint_mem haC hbC))

/-! A finite-witness bookkeeping lemma.  Once a finite set of anchor points is
    known to lie in distinct non-convex components, the component-count
    hypothesis upgrades the lower bound to an exact non-convex-component count.
    This separates the analytic construction of witnesses from the final
    cardinality argument needed by the Formal Conjectures target. -/
theorem nonconvex_ncard_eq_of_finite_witnesses
    {S : Set ℂ} {A : Set ℂ} {n : ℕ}
    (_hAfin : A.Finite) (hAcard : A.ncard = n)
    (hmem : ∀ z ∈ A, z ∈ S)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn S z) A)
    (hnc : ∀ z ∈ A,
      ¬ Convex ℝ (connectedComponentIn S z))
    (hcomp : (componentsIn S).ncard = n)
    (hcompfin : (componentsIn S).Finite) :
    {t ∈ componentsIn S | ¬ Convex ℝ t}.ncard = n := by
  let N : Set (Set ℂ) := {t ∈ componentsIn S | ¬ Convex ℝ t}
  let C : ℂ → Set ℂ := fun z => connectedComponentIn S z
  have hCsub : C '' A ⊆ N := by
    rintro t ⟨z, hzA, rfl⟩
    exact ⟨⟨z, hmem z hzA, rfl⟩, hnc z hzA⟩
  have hCcard : (C '' A).ncard = n := by
    rw [hcompInj.ncard_image, hAcard]
  have hNfin : N.Finite := by
    apply hcompfin.subset
    intro t ht
    exact ht.1
  have hlower : n ≤ N.ncard := by
    rw [← hCcard]
    exact Set.ncard_le_ncard hCsub hNfin
  have hupper : N.ncard ≤ n := by
    rw [← hcomp]
    exact Set.ncard_le_ncard (by
      intro t ht
      exact ht.1) hcompfin
  change N.ncard = n
  exact Nat.le_antisymm hupper hlower

/-! If the non-convex subcollection has the same finite cardinality as the
    whole component collection, then every component is non-convex.  This is
    the converse bookkeeping direction used when a finite witness family has
    already saturated the degree bound. -/
theorem all_components_nonconvex_of_ncard_eq
    {S : Set ℂ} {n : ℕ}
    (hcompfin : (componentsIn S).Finite)
    (hcomp : (componentsIn S).ncard = n)
    (hnc : {t ∈ componentsIn S | ¬ Convex ℝ t}.ncard = n) :
    ∀ t ∈ componentsIn S, ¬ Convex ℝ t := by
  let N : Set (Set ℂ) := {t ∈ componentsIn S | ¬ Convex ℝ t}
  have hsub : N ⊆ componentsIn S := by
    intro t ht
    exact ht.1
  have heq : N = componentsIn S := by
    refine Set.eq_of_subset_of_ncard_le hsub ?_ (ht := hcompfin)
    change (componentsIn S).ncard ≤ N.ncard
    rw [hcomp, ← hnc]
  intro t ht hconv
  have htN : t ∈ N := by
    rw [heq]
    exact ht
  exact htN.2 hconv

/-! Lower-bound form of the preceding bookkeeping.  It is useful before the
raised construction has proved that every component is represented by one of
the proposed anchors: distinct finite witnesses already force at least `n`
non-convex components. -/
theorem nonconvex_ncard_ge_of_finite_witnesses
    {S : Set ℂ} {A : Set ℂ} {n : ℕ}
    (_hAfin : A.Finite) (hAcard : A.ncard = n)
    (hmem : ∀ z ∈ A, z ∈ S)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn S z) A)
    (hnc : ∀ z ∈ A,
      ¬ Convex ℝ (connectedComponentIn S z))
    (hcompfin : (componentsIn S).Finite) :
    n ≤ {t ∈ componentsIn S | ¬ Convex ℝ t}.ncard := by
  let N : Set (Set ℂ) := {t ∈ componentsIn S | ¬ Convex ℝ t}
  let C : ℂ → Set ℂ := fun z => connectedComponentIn S z
  have hCsub : C '' A ⊆ N := by
    rintro t ⟨z, hzA, rfl⟩
    exact ⟨⟨z, hmem z hzA, rfl⟩, hnc z hzA⟩
  have hCcard : (C '' A).ncard = n := by
    rw [hcompInj.ncard_image, hAcard]
  have hNfin : N.Finite := by
    apply hcompfin.subset
    intro t ht
    exact ht.1
  change n ≤ N.ncard
  rw [← hCcard]
  exact Set.ncard_le_ncard hCsub hNfin

/-! The preceding bookkeeping can be packaged directly into the registered
Formal Conjectures predicate.  This is the interface intended for the degree-
raising induction: the analytic work supplies a finite anchor set, while the
root/component equality and pairwise component separation supply the exact
cardinality required by the target. -/
theorem attainable_of_finite_nonconvex_witnesses
    {f : ℂ[X]} {c : ℝ} {n : ℕ}
    (hf : f.Monic) (hdeg : f.natDegree = n) (hn : 0 < n) (hc : 0 < c)
    (hcompRoot :
      (componentsIn (sublevelSet f c)).ncard = (f.rootSet ℂ).ncard)
    (hcomp : (componentsIn (sublevelSet f c)).ncard = n)
    {A : Set ℂ} (hAfin : A.Finite) (hAcard : A.ncard = n)
    (hmem : ∀ z ∈ A, z ∈ sublevelSet f c)
    (hcompInj : Set.InjOn (fun z : ℂ => connectedComponentIn (sublevelSet f c) z) A)
    (hnc : ∀ z ∈ A,
      ¬ Convex ℝ (connectedComponentIn (sublevelSet f c) z)) :
    n ∈ attainableNonConvexCounts n := by
  refine ⟨f, c, hf, hdeg, hc, hcompRoot, ?_⟩
  have hcompfin : (componentsIn (sublevelSet f c)).Finite := by
    apply Set.finite_of_ncard_pos
    rw [hcomp]
    exact hn
  exact nonconvex_ncard_eq_of_finite_witnesses hAfin hAcard hmem hcompInj hnc
    hcomp hcompfin

/-! A smaller interface for constructions that already establish the exact
root cardinality.  Degree-raising proofs naturally produce
`(g.rootSet ℂ).ncard = g.natDegree` and a component count, so this wrapper
derives the Formal Conjectures root/component equality before invoking the
finite-witness bookkeeping above. -/
theorem attainable_of_finite_nonconvex_witnesses_of_root_ncard
    {f : ℂ[X]} {c : ℝ} {n : ℕ}
    (hf : f.Monic) (hdeg : f.natDegree = n) (hn : 0 < n) (hc : 0 < c)
    (hroot : (f.rootSet ℂ).ncard = n)
    (hcomp : (componentsIn (sublevelSet f c)).ncard = n)
    {A : Set ℂ} (hAfin : A.Finite) (hAcard : A.ncard = n)
    (hmem : ∀ z ∈ A, z ∈ sublevelSet f c)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn (sublevelSet f c) z) A)
    (hnc : ∀ z ∈ A,
      ¬ Convex ℝ (connectedComponentIn (sublevelSet f c) z)) :
    n ∈ attainableNonConvexCounts n := by
  apply attainable_of_finite_nonconvex_witnesses hf hdeg hn hc ?_ hcomp
    hAfin hAcard hmem hcompInj hnc
  exact hcomp.trans hroot.symm

/-! In the separable case the root cardinality is forced by the degree.  This
is the form most convenient for the degree-raising induction: separability is
already supplied by the algebraic perturbation lemma, while the geometric
argument supplies only the exact component count and finite non-convex
witnesses. -/
theorem attainable_of_finite_nonconvex_witnesses_of_separable
    {f : ℂ[X]} {c : ℝ} {n : ℕ}
    (hf : f.Monic) (hsep : f.Separable) (hdeg : f.natDegree = n)
    (hn : 0 < n) (hc : 0 < c)
    (hcomp : (componentsIn (sublevelSet f c)).ncard = n)
    {A : Set ℂ} (hAfin : A.Finite) (hAcard : A.ncard = n)
    (hmem : ∀ z ∈ A, z ∈ sublevelSet f c)
    (hcompInj : Set.InjOn
      (fun z : ℂ => connectedComponentIn (sublevelSet f c) z) A)
    (hnc : ∀ z ∈ A,
      ¬ Convex ℝ (connectedComponentIn (sublevelSet f c) z)) :
    n ∈ attainableNonConvexCounts n := by
  have hcard : Fintype.card (f.rootSet ℂ) = f.natDegree :=
    Polynomial.card_rootSet_eq_natDegree hsep (IsAlgClosed.splits _)
  have hroot : (f.rootSet ℂ).ncard = n := by
    simpa [hdeg] using hcard
  exact attainable_of_finite_nonconvex_witnesses_of_root_ncard hf hdeg hn hc
    hroot hcomp hAfin hAcard hmem hcompInj hnc

/-! Named segment certificates for `p₆`.  Keeping these separate from the first
anchor theorem lets the same rational certificate be transported by the
order-three rotation and by conjugation. -/
theorem p6_lineA_subset :
    segment ℝ Erdos1047P6.anchor Erdos1047P6.pointA ⊆
      sublevelSet Erdos1047P6.polynomial Erdos1047P6.level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hv1 : v ≤ 1 := by linarith
  have hparam : u • Erdos1047P6.anchor + v • Erdos1047P6.pointA =
      Erdos1047P6.anchor + (v : ℂ) *
        (Erdos1047P6.pointA - Erdos1047P6.anchor) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination Erdos1047P6.anchor * huv'
  rw [hparam]
  change ‖Erdos1047P6.polynomial.eval
    (Erdos1047P6.anchor + (v : ℂ) *
      (Erdos1047P6.pointA - Erdos1047P6.anchor))‖ ≤ Erdos1047P6.level
  exact (Erdos1047P6.lineA_norm_lt v hv hv1).le

