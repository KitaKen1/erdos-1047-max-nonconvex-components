theorem p4_lineA_norm_lt (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    ‖p4Polynomial.eval (p4Anchor + (t : ℂ) * (p4PointA - p4Anchor))‖ < p4Level := by
  have hs := p4_lineA_normSq t ht0 ht1
  rw [Complex.normSq_eq_norm_sq] at hs
  have hc : 0 ≤ p4Level := by norm_num [p4Level]
  nlinarith [norm_nonneg
    (p4Polynomial.eval (p4Anchor + (t : ℂ) * (p4PointA - p4Anchor)))]

theorem p4_lineB_norm_lt (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    ‖p4Polynomial.eval (p4Anchor + (t : ℂ) * (p4PointB - p4Anchor))‖ < p4Level := by
  have hs := p4_lineB_normSq t ht0 ht1
  rw [Complex.normSq_eq_norm_sq] at hs
  have hc : 0 ≤ p4Level := by norm_num [p4Level]
  nlinarith [norm_nonneg
    (p4Polynomial.eval (p4Anchor + (t : ℂ) * (p4PointB - p4Anchor)))]

/-- One exact segment contained in the quartic lemniscate sublevel set. -/
theorem p4_lineA_subset :
    segment ℝ p4Anchor p4PointA ⊆ Erdos1047.sublevelSet p4Polynomial p4Level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hv1 : v ≤ 1 := by linarith
  have hparam : u • p4Anchor + v • p4PointA =
      p4Anchor + (v : ℂ) * (p4PointA - p4Anchor) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination p4Anchor * huv'
  rw [hparam]
  change ‖p4Polynomial.eval (p4Anchor + (v : ℂ) * (p4PointA - p4Anchor))‖ ≤ p4Level
  have hs := p4_lineA_normSq v hv hv1
  rw [Complex.normSq_eq_norm_sq] at hs
  have hc : 0 ≤ p4Level := by norm_num [p4Level]
  nlinarith [norm_nonneg
    (p4Polynomial.eval (p4Anchor + (v : ℂ) * (p4PointA - p4Anchor)))]

/-- A second exact segment contained in the same quartic sublevel component. -/
theorem p4_lineB_subset :
    segment ℝ p4Anchor p4PointB ⊆ Erdos1047.sublevelSet p4Polynomial p4Level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hv1 : v ≤ 1 := by linarith
  have hparam : u • p4Anchor + v • p4PointB =
      p4Anchor + (v : ℂ) * (p4PointB - p4Anchor) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination p4Anchor * huv'
  rw [hparam]
  change ‖p4Polynomial.eval (p4Anchor + (v : ℂ) * (p4PointB - p4Anchor))‖ ≤ p4Level
  have hs := p4_lineB_normSq v hv hv1
  rw [Complex.normSq_eq_norm_sq] at hs
  have hc : 0 ≤ p4Level := by norm_num [p4Level]
  nlinarith [norm_nonneg
    (p4Polynomial.eval (p4Anchor + (v : ℂ) * (p4PointB - p4Anchor)))]

/-- The first segment is uniformly separated from the boundary; this pointwise
strict form is turned into a quantitative margin below. -/
theorem p4_lineA_strict :
    ∀ z ∈ segment ℝ p4Anchor p4PointA, ‖p4Polynomial.eval z‖ < p4Level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hv1 : v ≤ 1 := by linarith
  have hparam : u • p4Anchor + v • p4PointA =
      p4Anchor + (v : ℂ) * (p4PointA - p4Anchor) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination p4Anchor * huv'
  rw [hparam]
  exact p4_lineA_norm_lt v hv hv1

/-- The second segment has the same strict interior property. -/
theorem p4_lineB_strict :
    ∀ z ∈ segment ℝ p4Anchor p4PointB, ‖p4Polynomial.eval z‖ < p4Level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hv1 : v ≤ 1 := by linarith
  have hparam : u • p4Anchor + v • p4PointB =
      p4Anchor + (v : ℂ) * (p4PointB - p4Anchor) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination p4Anchor * huv'
  rw [hparam]
  exact p4_lineB_norm_lt v hv hv1

/-- Exact strict separation of the witness midpoint from the level. -/
theorem p4_midpoint_norm_gt :
    p4Level < ‖p4Polynomial.eval (midpoint ℝ p4PointA p4PointB)‖ := by
  have hgt : p4Level ^ 2 <
      Complex.normSq (p4Polynomial.eval (midpoint ℝ p4PointA p4PointB)) := by
    norm_num [p4Polynomial, p4PointA, p4PointB, p4Level, midpoint,
      AffineMap.lineMap_apply_module, Complex.normSq, pow_succ,
      Complex.mul_re, Complex.mul_im]
  rw [Complex.normSq_eq_norm_sq] at hgt
  have hc : 0 ≤ p4Level := by norm_num [p4Level]
  nlinarith [norm_nonneg (p4Polynomial.eval (midpoint ℝ p4PointA p4PointB))]

/-- The midpoint of the two certified endpoints is strictly outside the sublevel set. -/
theorem p4_midpoint_outside :
    midpoint ℝ p4PointA p4PointB ∉ Erdos1047.sublevelSet p4Polynomial p4Level := by
  intro hm
  have hmnorm : ‖p4Polynomial.eval (midpoint ℝ p4PointA p4PointB)‖ ≤ p4Level := hm
  have hmsq : Complex.normSq (p4Polynomial.eval (midpoint ℝ p4PointA p4PointB)) ≤
      p4Level ^ 2 := by
    rw [Complex.normSq_eq_norm_sq]
    exact pow_le_pow_left₀ (norm_nonneg _) hmnorm 2
  rw [Complex.normSq_eq_norm_sq] at hmsq
  nlinarith [p4_midpoint_norm_gt,
    norm_nonneg (p4Polynomial.eval (midpoint ℝ p4PointA p4PointB))]

/-- The quartic witness now carries an explicit positive perturbation margin,
obtained from compactness of the two exact rational segments. -/
theorem p4_robust_certificate :
    Nonempty (RobustNonconvexCertificate (fun z ↦ p4Polynomial.eval z) p4Level
      p4Anchor p4PointA p4PointB) := by
  apply robustNonconvexCertificate_of_strict (by fun_prop)
  · exact p4_lineA_strict
  · exact p4_lineB_strict
  · exact p4_midpoint_norm_gt

/-- An actual connected component of the quartic sublevel set is non-convex. -/
theorem p4_component_not_convex :
    ¬ Convex ℝ
      (connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) p4Anchor) := by
  exact component_not_convex_of_segments p4_lineA_subset p4_lineB_subset p4_midpoint_outside

theorem p4_component_mem_componentsIn :
    connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) p4Anchor ∈
      Erdos1047.componentsIn (Erdos1047.sublevelSet p4Polynomial p4Level) := by
  refine ⟨p4Anchor, p4_lineA_subset (left_mem_segment ℝ p4Anchor p4PointA), rfl⟩

/-- In particular, the quartic's set of non-convex components is nonempty. -/
theorem p4_nonconvexComponents_nonempty :
    {t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet p4Polynomial p4Level) |
      ¬ Convex ℝ t}.Nonempty :=
  ⟨connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) p4Anchor,
    p4_component_mem_componentsIn, p4_component_not_convex⟩

theorem p4_eval_neg (z : ℂ) : p4Polynomial.eval (-z) = p4Polynomial.eval z := by
  simp [p4Polynomial]

theorem p4_eval_star (z : ℂ) :
    p4Polynomial.eval (star z) = star (p4Polynomial.eval z) := by
  simp [p4Polynomial]

/-! The single p₄ certificate therefore generates all four symmetry-related
    robust certificates, with their quantitative margins unchanged. -/
theorem p4_four_robust_certificates :
    Nonempty (RobustNonconvexCertificate (fun z : ℂ => p4Polynomial.eval z)
      p4Level p4Anchor p4PointA p4PointB) ∧
    Nonempty (RobustNonconvexCertificate (fun z : ℂ => p4Polynomial.eval z)
      p4Level (star p4Anchor) (star p4PointA) (star p4PointB)) ∧
    Nonempty (RobustNonconvexCertificate (fun z : ℂ => p4Polynomial.eval z)
      p4Level (-p4Anchor) (-p4PointA) (-p4PointB)) ∧
    Nonempty (RobustNonconvexCertificate (fun z : ℂ => p4Polynomial.eval z)
      p4Level (-star p4Anchor) (-star p4PointA) (-star p4PointB)) := by
  have h0 := p4_robust_certificate
  have h1 := robustNonconvexCertificate_of_star p4_eval_star h0
  have h2 := robustNonconvexCertificate_of_neg p4_eval_neg h0
  have h3 := robustNonconvexCertificate_of_neg p4_eval_neg h1
  exact ⟨h0, h1, h2, h3⟩

theorem p4_mem_neg_iff (z : ℂ) :
    -z ∈ Erdos1047.sublevelSet p4Polynomial p4Level ↔
      z ∈ Erdos1047.sublevelSet p4Polynomial p4Level := by
  simp only [Erdos1047.sublevelSet, Set.mem_ofPred_eq, p4_eval_neg]

theorem p4_mem_star_iff (z : ℂ) :
    star z ∈ Erdos1047.sublevelSet p4Polynomial p4Level ↔
      z ∈ Erdos1047.sublevelSet p4Polynomial p4Level := by
  simp only [Erdos1047.sublevelSet, Set.mem_ofPred_eq, p4_eval_star, norm_star]

theorem p4_neg_segment {r a : ℂ}
    (h : segment ℝ r a ⊆ Erdos1047.sublevelSet p4Polynomial p4Level) :
    segment ℝ (-r) (-a) ⊆ Erdos1047.sublevelSet p4Polynomial p4Level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  rw [show u • (-r) + v • (-a) = -(u • r + v • a) by module]
  exact (p4_mem_neg_iff _).2 (h ⟨u, v, hu, hv, huv, rfl⟩)

theorem p4_star_segment {r a : ℂ}
    (h : segment ℝ r a ⊆ Erdos1047.sublevelSet p4Polynomial p4Level) :
    segment ℝ (star r) (star a) ⊆ Erdos1047.sublevelSet p4Polynomial p4Level := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  rw [show u • star r + v • star a = star (u • r + v • a) by simp]
  exact (p4_mem_star_iff _).2 (h ⟨u, v, hu, hv, huv, rfl⟩)

theorem p4_neg_midpoint_outside {a b : ℂ}
    (h : midpoint ℝ a b ∉ Erdos1047.sublevelSet p4Polynomial p4Level) :
    midpoint ℝ (-a) (-b) ∉ Erdos1047.sublevelSet p4Polynomial p4Level := by
  intro hm
  apply h
  rw [← p4_mem_neg_iff]
  convert hm using 1
  simp only [midpoint, AffineMap.lineMap_apply_module, smul_neg]
  abel

theorem p4_star_midpoint_outside {a b : ℂ}
    (h : midpoint ℝ a b ∉ Erdos1047.sublevelSet p4Polynomial p4Level) :
    midpoint ℝ (star a) (star b) ∉ Erdos1047.sublevelSet p4Polynomial p4Level := by
  intro hm
  apply h
  rw [← p4_mem_star_iff]
  convert hm using 1
  simp [midpoint, AffineMap.lineMap_apply_module]

/-- Negation and conjugation propagate the finite certificate to all four quadrants. -/
theorem p4_neg_component_not_convex :
    ¬ Convex ℝ
      (connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) (-p4Anchor)) := by
  exact component_not_convex_of_segments
    (p4_neg_segment p4_lineA_subset) (p4_neg_segment p4_lineB_subset)
    (p4_neg_midpoint_outside p4_midpoint_outside)

theorem p4_star_component_not_convex :
    ¬ Convex ℝ
      (connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) (star p4Anchor)) := by
  exact component_not_convex_of_segments
    (p4_star_segment p4_lineA_subset) (p4_star_segment p4_lineB_subset)
    (p4_star_midpoint_outside p4_midpoint_outside)

theorem p4_neg_star_component_not_convex :
    ¬ Convex ℝ
      (connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) (-star p4Anchor)) := by
  exact component_not_convex_of_segments
    (p4_neg_segment (p4_star_segment p4_lineA_subset))
    (p4_neg_segment (p4_star_segment p4_lineB_subset))
    (p4_neg_midpoint_outside (p4_star_midpoint_outside p4_midpoint_outside))

/-- The coordinate axes are outside this sublevel set. They separate the four witnesses. -/
theorem p4_not_mem_of_re_zero (z : ℂ) (hz : z.re = 0) :
    z ∉ Erdos1047.sublevelSet p4Polynomial p4Level := by
  intro h
  have hs : Complex.normSq (p4Polynomial.eval z) ≤ p4Level ^ 2 := by
    rw [Complex.normSq_eq_norm_sq]
    exact pow_le_pow_left₀ (norm_nonneg _) h 2
  norm_num [p4Polynomial, p4Level, Complex.normSq, pow_succ,
    Complex.mul_re, Complex.mul_im, hz] at hs
  nlinarith [sq_nonneg (z.im ^ 2 + 1)]

theorem p4_not_mem_of_im_zero (z : ℂ) (hz : z.im = 0) :
    z ∉ Erdos1047.sublevelSet p4Polynomial p4Level := by
  intro h
  have hs : Complex.normSq (p4Polynomial.eval z) ≤ p4Level ^ 2 := by
    rw [Complex.normSq_eq_norm_sq]
    exact pow_le_pow_left₀ (norm_nonneg _) h 2
  norm_num [p4Polynomial, p4Level, Complex.normSq, pow_succ,
    Complex.mul_re, Complex.mul_im, hz] at hs
  nlinarith [sq_nonneg (z.re ^ 2 - 1)]

theorem p4_component_re_pos (r : ℂ)
    (hr : r ∈ Erdos1047.sublevelSet p4Polynomial p4Level) (hrpos : 0 < r.re) :
    ∀ z ∈ connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) r,
      0 < z.re := by
  intro z hz
  have hnz : ∀ w ∈ Erdos1047.sublevelSet p4Polynomial p4Level, -w.re ≠ 0 := by
    intro w hw hwzero
    exact p4_not_mem_of_re_zero w (by linarith) hw
  have h := negative_on_component (S := Erdos1047.sublevelSet p4Polynomial p4Level)
    (r := r) (φ := fun w : ℂ ↦ -w.re) (by fun_prop) hnz hr (by linarith) z hz
  linarith

theorem p4_component_im_pos (r : ℂ)
    (hr : r ∈ Erdos1047.sublevelSet p4Polynomial p4Level) (hrpos : 0 < r.im) :
    ∀ z ∈ connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) r,
      0 < z.im := by
  intro z hz
  have hnz : ∀ w ∈ Erdos1047.sublevelSet p4Polynomial p4Level, -w.im ≠ 0 := by
    intro w hw hwzero
    exact p4_not_mem_of_im_zero w (by linarith) hw
  have h := negative_on_component (S := Erdos1047.sublevelSet p4Polynomial p4Level)
    (r := r) (φ := fun w : ℂ ↦ -w.im) (by fun_prop) hnz hr (by linarith) z hz
  linarith

theorem p4_components_ne_of_re_sign {r s : ℂ}
    (hr : r ∈ Erdos1047.sublevelSet p4Polynomial p4Level)
    (hs : s ∈ Erdos1047.sublevelSet p4Polynomial p4Level)
    (hrpos : 0 < r.re) (hsneg : s.re < 0) :
    connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) r ≠
      connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) s := by
  intro heq
  have hsC : s ∈ connectedComponentIn
      (Erdos1047.sublevelSet p4Polynomial p4Level) r := by
    rw [heq]
    exact mem_connectedComponentIn hs
  have := p4_component_re_pos r hr hrpos s hsC
  linarith

theorem p4_components_ne_of_im_sign {r s : ℂ}
    (hr : r ∈ Erdos1047.sublevelSet p4Polynomial p4Level)
    (hs : s ∈ Erdos1047.sublevelSet p4Polynomial p4Level)
    (hrpos : 0 < r.im) (hsneg : s.im < 0) :
    connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) r ≠
      connectedComponentIn (Erdos1047.sublevelSet p4Polynomial p4Level) s := by
  intro heq
  have hsC : s ∈ connectedComponentIn
      (Erdos1047.sublevelSet p4Polynomial p4Level) r := by
    rw [heq]
    exact mem_connectedComponentIn hs
  have := p4_component_im_pos r hr hrpos s hsC
  linarith

/-- The four symmetry-related non-convex components are genuinely distinct. -/
theorem p4_four_components_pairwise_distinct :
    let K := Erdos1047.sublevelSet p4Polynomial p4Level
    let C0 := connectedComponentIn K p4Anchor
    let C1 := connectedComponentIn K (star p4Anchor)
    let C2 := connectedComponentIn K (-p4Anchor)
    let C3 := connectedComponentIn K (-star p4Anchor)
    C0 ≠ C1 ∧ C0 ≠ C2 ∧ C0 ≠ C3 ∧ C1 ≠ C2 ∧ C1 ≠ C3 ∧ C2 ≠ C3 := by
  dsimp only
  have h0 : p4Anchor ∈ Erdos1047.sublevelSet p4Polynomial p4Level :=
    p4_lineA_subset (left_mem_segment ℝ p4Anchor p4PointA)
  have h1 : star p4Anchor ∈ Erdos1047.sublevelSet p4Polynomial p4Level :=
    (p4_mem_star_iff p4Anchor).2 h0
  have h2 : -p4Anchor ∈ Erdos1047.sublevelSet p4Polynomial p4Level :=
    (p4_mem_neg_iff p4Anchor).2 h0
  have h3 : -star p4Anchor ∈ Erdos1047.sublevelSet p4Polynomial p4Level :=
    (p4_mem_neg_iff (star p4Anchor)).2 h1
  have hre0 : 0 < p4Anchor.re := by norm_num [p4Anchor]
  have him0 : 0 < p4Anchor.im := by norm_num [p4Anchor]
  have hre1 : 0 < (star p4Anchor).re := by norm_num [p4Anchor]
  have him1 : (star p4Anchor).im < 0 := by norm_num [p4Anchor]
  have hre2 : (-p4Anchor).re < 0 := by norm_num [p4Anchor]
  have him2 : (-p4Anchor).im < 0 := by norm_num [p4Anchor]
  have hre3 : (-star p4Anchor).re < 0 := by norm_num [p4Anchor]
  have him3 : 0 < (-star p4Anchor).im := by norm_num [p4Anchor]
  exact ⟨p4_components_ne_of_im_sign h0 h1 him0 him1,
    p4_components_ne_of_re_sign h0 h2 hre0 hre2,
    p4_components_ne_of_re_sign h0 h3 hre0 hre3,
    p4_components_ne_of_re_sign h1 h2 hre1 hre2,
    p4_components_ne_of_re_sign h1 h3 hre1 hre3,
    (p4_components_ne_of_im_sign h3 h2 him3 him2).symm⟩

theorem p4Polynomial_monic : p4Polynomial.Monic := by
  unfold p4Polynomial
  monicity!

theorem p4Polynomial_natDegree : p4Polynomial.natDegree = 4 := by
  unfold p4Polynomial
  compute_degree!

theorem p4Polynomial_separable : p4Polynomial.Separable := by
  have hd : p4Polynomial.derivative = C 4 * X ^ 3 - C 4 * X := by
    apply Polynomial.funext
    intro z
    simp [p4Polynomial, Polynomial.derivative_pow]
    ring
  rw [Polynomial.separable_def']
  refine ⟨C (1 / 2 : ℂ) * (1 + X ^ 2), -C (1 / 8 : ℂ) * X ^ 3, ?_⟩
  rw [hd]
  apply Polynomial.funext
  intro z
  norm_num [p4Polynomial]
  ring

/-- The quartic has four distinct roots, so the only remaining degree-four construction
issue is proving that its four exhibited components exhaust the sublevel set. -/
theorem p4_rootSet_ncard : (p4Polynomial.rootSet ℂ).ncard = 4 := by
  have hcard : Fintype.card (p4Polynomial.rootSet ℂ) = p4Polynomial.natDegree :=
    Polynomial.card_rootSet_eq_natDegree p4Polynomial_separable (IsAlgClosed.splits _)
  rw [p4Polynomial_natDegree] at hcard
  simpa using hcard

/-- Once the four exhibited components are known to exhaust the quartic sublevel set,
their pairwise separation and non-convexity force the non-convex count to be four. -/
theorem p4_nonconvex_ncard_of_components_ncard
    (hc : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p4Polynomial p4Level)).ncard = 4) :
    {t ∈ Erdos1047.componentsIn (Erdos1047.sublevelSet p4Polynomial p4Level) |
      ¬ Convex ℝ t}.ncard = 4 := by
  let K := Erdos1047.sublevelSet p4Polynomial p4Level
  let C0 := connectedComponentIn K p4Anchor
  let C1 := connectedComponentIn K (star p4Anchor)
  let C2 := connectedComponentIn K (-p4Anchor)
  let C3 := connectedComponentIn K (-star p4Anchor)
  let N := {t ∈ Erdos1047.componentsIn K | ¬ Convex ℝ t}
  have h0K : p4Anchor ∈ K :=
    p4_lineA_subset (left_mem_segment ℝ p4Anchor p4PointA)
  have h1K : star p4Anchor ∈ K := (p4_mem_star_iff p4Anchor).2 h0K
  have h2K : -p4Anchor ∈ K := (p4_mem_neg_iff p4Anchor).2 h0K
  have h3K : -star p4Anchor ∈ K := (p4_mem_neg_iff (star p4Anchor)).2 h1K
  have h0 : C0 ∈ N := ⟨⟨p4Anchor, h0K, rfl⟩, p4_component_not_convex⟩
  have h1 : C1 ∈ N :=
    ⟨⟨star p4Anchor, h1K, rfl⟩, p4_star_component_not_convex⟩
  have h2 : C2 ∈ N := ⟨⟨-p4Anchor, h2K, rfl⟩, p4_neg_component_not_convex⟩
  have h3 : C3 ∈ N :=
    ⟨⟨-star p4Anchor, h3K, rfl⟩, p4_neg_star_component_not_convex⟩
  obtain ⟨h01, h02, h03, h12, h13, h23⟩ := p4_four_components_pairwise_distinct
  change C0 ≠ C1 at h01
  change C0 ≠ C2 at h02
  change C0 ≠ C3 at h03
  change C1 ≠ C2 at h12
  change C1 ≠ C3 at h13
  change C2 ≠ C3 at h23
  have hfour : ({C0, C1, C2, C3} : Set (Set ℂ)).ncard = 4 := by
    rw [Set.ncard_insert_of_notMem (by simp [h01, h02, h03])]
    rw [Set.ncard_insert_of_notMem (by simp [h12, h13])]
    rw [Set.ncard_insert_of_notMem (by simp [h23])]
    simp
  have hfour_subset : ({C0, C1, C2, C3} : Set (Set ℂ)) ⊆ N := by
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨h0, h1, h2, h3⟩
  have hKfin : (Erdos1047.componentsIn K).Finite := Set.finite_of_ncard_pos (by
    dsimp [K]
    rw [hc]
    norm_num)
  have hNfin : N.Finite := hKfin.subset (by intro t ht; exact ht.1)
  have hlower : 4 ≤ N.ncard := by
    rw [← hfour]
    exact Set.ncard_le_ncard hfour_subset hNfin
  have hupper : N.ncard ≤ 4 := by
    rw [← hc]
    exact Set.ncard_le_ncard (by intro t ht; exact ht.1) hKfin
  change N.ncard = 4
  omega

/-- Degree four is now reduced to the single topological exhaustion statement `hc`. -/
theorem four_attainable_of_p4_components_ncard
    (hc : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p4Polynomial p4Level)).ncard = 4) :
    4 ∈ attainableNonConvexCounts 4 := by
  refine ⟨p4Polynomial, p4Level, p4Polynomial_monic, p4Polynomial_natDegree,
    by norm_num [p4Level], ?_, p4_nonconvex_ncard_of_components_ncard hc⟩
  calc
    (Erdos1047.componentsIn
      (Erdos1047.sublevelSet p4Polynomial p4Level)).ncard = 4 := hc
    _ = (p4Polynomial.rootSet ℂ).ncard := p4_rootSet_ncard.symm

/- The remaining topological exhaustion is proved by an explicit inverse branch. -/

def p4InverseUR (w : ℂ) : ℂ :=
  Complex.sqrt (1 + Complex.I * Complex.sqrt (1 - w))

theorem complex_sqrt_sq_of_re_pos (z : ℂ) (hz : 0 < z.re) :
    Complex.sqrt (z ^ 2) = z := by
  unfold Complex.sqrt
  exact Complex.sq_cpow_two_inv hz

theorem complex_sqrt_re_pos_of_re_pos (z : ℂ) (hz : 0 < z.re) :
    0 < (Complex.sqrt z).re := by
  rw [Complex.sqrt_eq_real_add_ite]
  simp only [Complex.add_re, Complex.ofReal_re]
  split_ifs <;> norm_num [Complex.mul_re, Complex.mul_im]
  all_goals nlinarith [norm_nonneg z]

theorem complex_sqrt_im_pos_of_im_pos (z : ℂ) (hz : 0 < z.im) :
    0 < (Complex.sqrt z).im := by
  rw [Complex.sqrt_eq_real_add_ite]
  simp [Complex.mul_im, hz.le]
  nlinarith [Complex.sq_norm_sub_sq_re z, sq_pos_of_pos hz, norm_nonneg z]

theorem complex_sqrt_re_pos_of_im_ne_zero (z : ℂ) (hz : z.im ≠ 0) :
    0 < (Complex.sqrt z).re := by
  rw [Complex.sqrt_eq_real_add_ite]
  simp only [Complex.add_re, Complex.ofReal_re]
  split_ifs <;> norm_num [Complex.mul_re, Complex.mul_im]
  all_goals
    nlinarith [Complex.sq_norm_sub_sq_re z, sq_pos_of_ne_zero hz, norm_nonneg z]

def p4OutputDisk : Set ℂ := Metric.closedBall 0 p4Level

theorem lt_one_of_le_p4Level {c : ℝ} (hc : c ≤ p4Level) : c < 1 := by
  have hp4 : p4Level < 1 := by norm_num [p4Level]
  linarith

/-! The upper inverse branch for the quadratic factor
    `q(w) = (w - 1)^2 + 1` is obtained by squaring the first-quadrant
    inverse branch of the quartic witness. -/
def q2InverseU (w : ℂ) : ℂ := p4InverseUR w ^ 2

def q2InverseL (w : ℂ) : ℂ := 2 - q2InverseU w

def q2Polynomial : ℂ[X] := (X - C (1 : ℂ)) ^ 2 + C (1 : ℂ)

def q2SublevelSet (c : ℝ) : Set ℂ := sublevelSet q2Polynomial c

theorem q2Polynomial_eval (z : ℂ) :
    q2Polynomial.eval z = (z - 1) ^ 2 + 1 := by
  simp [q2Polynomial]

theorem q2Polynomial_eval_star (z : ℂ) :
    q2Polynomial.eval (star z) = star (q2Polynomial.eval z) := by
  simpa [q2Polynomial] using
    (Erdos1047EvenFamily.evenFamily_eval_star 1 z)

theorem q2Polynomial_eq_evenFamily_one :
    q2Polynomial = Erdos1047EvenFamily.evenFamilyPolynomial 1 := by
  apply Polynomial.funext
  intro z
  simp [q2Polynomial, Erdos1047EvenFamily.evenFamilyPolynomial]

theorem q2Polynomial_algebraic_data :
    q2Polynomial.Monic ∧ q2Polynomial.natDegree = 2 ∧
      q2Polynomial.Separable ∧ (q2Polynomial.rootSet ℂ).ncard = 2 := by
  rw [q2Polynomial_eq_evenFamily_one]
  exact ⟨Erdos1047EvenFamily.evenFamily_monic 1 (by omega),
    Erdos1047EvenFamily.evenFamily_natDegree 1 (by omega),
    Erdos1047EvenFamily.evenFamily_separable 1 (by omega),
    Erdos1047EvenFamily.evenFamily_rootSet_ncard 1 (by omega)⟩

theorem q2_norm_ge_two_of_re_nonpos {z : ℂ} (hz : z.re ≤ 0) :
    2 ≤ ‖q2Polynomial.eval z‖ := by
  rw [q2Polynomial_eval]
  have hnormsq : Complex.normSq ((z - 1) ^ 2 + 1) =
      ((z.re - 1) ^ 2 + z.im ^ 2) ^ 2 + 2 * (z.re - 1) ^ 2 -
        2 * z.im ^ 2 + 1 := by
    norm_num [Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
      Complex.mul_re, Complex.mul_im, pow_two]
    ring_nf
  have hsq : 4 ≤ ‖(z - 1) ^ 2 + 1‖ ^ 2 := by
    rw [← Complex.normSq_eq_norm_sq, hnormsq]
    have hx : 1 ≤ (z.re - 1) ^ 2 := by nlinarith [sq_nonneg (z.re - 1)]
    have hy : 0 ≤ z.im ^ 2 := sq_nonneg z.im
    nlinarith [sq_nonneg ((z.re - 1) ^ 2 + z.im ^ 2 - 1)]
  nlinarith [norm_nonneg ((z - 1) ^ 2 + 1)]

theorem q2_norm_ge_one_of_im_zero {z : ℂ} (hz : z.im = 0) :
    1 ≤ ‖q2Polynomial.eval z‖ := by
  have h := Erdos1047EvenFamily.evenFamily_norm_ge_one_of_pow_im_zero
    (m := 1) (z := z) (by simpa using hz)
  simpa [q2Polynomial, Erdos1047EvenFamily.evenFamilyPolynomial] using h

theorem mem_p4OutputDisk_of_norm_le_level {w : ℂ} (hw : ‖w‖ ≤ p4Level) :
    w ∈ p4OutputDisk := by
  simpa [p4OutputDisk] using hw

theorem p4_inverse_eval (w : ℂ) : p4Polynomial.eval (p4InverseUR w) = w := by
  have hs : (Complex.sqrt (1 - w)) ^ 2 = 1 - w := by
    unfold Complex.sqrt
    exact Complex.cpow_nat_inv_pow _ (by norm_num)
  have hz : (Complex.sqrt (1 + Complex.I * Complex.sqrt (1 - w))) ^ 2 =
      1 + Complex.I * Complex.sqrt (1 - w) := by
    unfold Complex.sqrt
    exact Complex.cpow_nat_inv_pow _ (by norm_num)
  simp only [p4Polynomial, p4InverseUR, eval_add, eval_pow, eval_sub, eval_X,
    eval_one]
  rw [hz]
  rw [show 1 + Complex.I * Complex.sqrt (1 - w) - 1 =
    Complex.I * Complex.sqrt (1 - w) by ring, mul_pow, Complex.I_sq, hs]
  ring

theorem q2_inverse_eval (w : ℂ) :
    q2Polynomial.eval (q2InverseU w) = w := by
  simpa [q2Polynomial, q2InverseU, p4Polynomial,
    eval_add, eval_pow, eval_sub, eval_X, eval_one] using p4_inverse_eval w

theorem q2_inverse_lower_eval (w : ℂ) :
    q2Polynomial.eval (q2InverseL w) = w := by
  have hu := q2_inverse_eval w
  rw [q2Polynomial_eval] at hu ⊢
  rw [q2InverseL]
  calc
    (2 - q2InverseU w - 1) ^ 2 + 1 =
        (q2InverseU w - 1) ^ 2 + 1 := by ring
    _ = w := hu

/-! The same explicit quadratic inverse used for the quartic witness can be
    followed by the principal logarithmic `m`-th root.  This gives a verified
    inverse branch for the even family, once the nonvanishing of the inner
    square-root expression is supplied. -/
theorem evenFamily_principalRoot_p4InverseUR_eval
    {m : ℕ} (hm : 0 < m) {w : ℂ}
    (hroot : p4InverseUR w ≠ 0) :
    (Erdos1047EvenFamily.evenFamilyPolynomial m).eval
        (Erdos1047EvenFamily.principalRoot m (p4InverseUR w ^ 2)) = w := by
  rw [Erdos1047EvenFamily.evenFamily_eval_principalRoot_square hm hroot]
  simpa [p4Polynomial] using p4_inverse_eval w

theorem p4_inverse_mem_and_signs (w : ℂ) (hw : w ∈ p4OutputDisk) :
    p4InverseUR w ∈ sublevelSet p4Polynomial p4Level ∧
      0 < (p4InverseUR w).re ∧ 0 < (p4InverseUR w).im := by
  have hwnorm : ‖w‖ ≤ p4Level := by simpa [p4OutputDisk] using hw
  have hlevel : p4Level < 1 := by norm_num [p4Level]
  have hare : 0 < (1 - w).re := by
    have := Complex.re_le_norm w
    norm_num
    nlinarith
  let s := Complex.sqrt (1 - w)
  have hsre : 0 < s.re := complex_sqrt_re_pos_of_re_pos _ hare
  have htim : 0 < (1 + Complex.I * s).im := by
    norm_num [Complex.mul_re, Complex.mul_im]
    exact hsre
  have hzre : 0 < (p4InverseUR w).re := by
    apply complex_sqrt_re_pos_of_im_ne_zero
    dsimp [p4InverseUR]
    exact ne_of_gt htim
  have hzim : 0 < (p4InverseUR w).im := by
    apply complex_sqrt_im_pos_of_im_pos
    exact htim
  exact ⟨by simpa [sublevelSet, p4_inverse_eval] using hwnorm, hzre, hzim⟩

theorem q2_inverse_im_pos_of_output_disk {w : ℂ}
    (hw : w ∈ p4OutputDisk) : 0 < (q2InverseU w).im := by
  have hs := p4_inverse_mem_and_signs w hw
  dsimp [q2InverseU]
  norm_num [pow_two, Complex.mul_im]
  nlinarith [hs.2.1, hs.2.2]

theorem q2_inverse_lower_im_neg_of_output_disk {w : ℂ}
    (hw : w ∈ p4OutputDisk) : (q2InverseL w).im < 0 := by
  have hp := q2_inverse_im_pos_of_output_disk hw
  simpa [q2InverseL] using (neg_lt_neg hp)

/-! The two coordinate barriers descend to a level-set exclusion statement.
    For every level below `1`, the `m`-th-power image cannot meet either
    coordinate axis.  This is the first topological input for a sector proof. -/
theorem evenFamily_sublevel_pow_axes_avoid
    {m : ℕ} {c : ℝ} (hc : c < 1) {z : ℂ}
    (hz : z ∈ sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) :
    (z ^ m).im ≠ 0 ∧ (z ^ m).re ≠ 0 := by
  have hnorm : ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ ≤ c := by
    simpa [sublevelSet] using hz
  constructor
  · intro him
    have hge := Erdos1047EvenFamily.evenFamily_norm_ge_one_of_pow_im_zero him
    linarith
  · intro hre
    have hge := Erdos1047EvenFamily.evenFamily_norm_ge_two_of_pow_re_zero hre
    linarith

theorem evenFamily_component_pow_re_pos
    {m : ℕ} {c : ℝ} (hc : c < 1) {r : ℂ}
    (hr : r ∈ sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
    (hrpos : 0 < (r ^ m).re) :
    ∀ z ∈ connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r,
      0 < (z ^ m).re := by
  apply positive_on_preconnected
    (S := connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r)
    (r := r) (φ := fun z : ℂ => (z ^ m).re)
    isPreconnected_connectedComponentIn (by fun_prop)
  · intro z hz hzero
    have hzS := connectedComponentIn_subset
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r hz
    exact (evenFamily_sublevel_pow_axes_avoid hc hzS).2 hzero
  · exact mem_connectedComponentIn hr
  · exact hrpos

theorem evenFamily_component_pow_re_neg
    {m : ℕ} {c : ℝ} (hc : c < 1) {r : ℂ}
    (hr : r ∈ sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
    (hrneg : (r ^ m).re < 0) :
    ∀ z ∈ connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r,
      (z ^ m).re < 0 := by
  intro z hz
  exact negative_on_component (S := sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c) (r := r)
    (φ := fun z : ℂ => (z ^ m).re) (by fun_prop)
    (by
      intro w hw hzero
      exact (evenFamily_sublevel_pow_axes_avoid hc hw).2 hzero)
    hr hrneg z hz

theorem evenFamily_component_pow_im_pos
    {m : ℕ} {c : ℝ} (hc : c < 1) {r : ℂ}
    (hr : r ∈ sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
    (hrpos : 0 < (r ^ m).im) :
    ∀ z ∈ connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r,
      0 < (z ^ m).im := by
  apply positive_on_preconnected
    (S := connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r)
    (r := r) (φ := fun z : ℂ => (z ^ m).im)
    isPreconnected_connectedComponentIn (by fun_prop)
  · intro z hz hzero
    have hzS := connectedComponentIn_subset
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r hz
    exact (evenFamily_sublevel_pow_axes_avoid hc hzS).1 hzero
  · exact mem_connectedComponentIn hr
  · exact hrpos

theorem evenFamily_component_pow_im_neg
    {m : ℕ} {c : ℝ} (hc : c < 1) {r : ℂ}
    (hr : r ∈ sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
    (hrneg : (r ^ m).im < 0) :
    ∀ z ∈ connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r,
      (z ^ m).im < 0 := by
  intro z hz
  exact negative_on_component (S := sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c) (r := r)
    (φ := fun z : ℂ => (z ^ m).im) (by fun_prop)
    (by
      intro w hw hzero
      exact (evenFamily_sublevel_pow_axes_avoid hc hw).1 hzero)
    hr hrneg z hz

theorem preconnected_finite_real_image_subsingleton
    {S : Set ℂ} (hS : IsPreconnected S) {f : ℂ → ℝ}
    (hf : ContinuousOn f S) (hfin : (f '' S).Finite) :
    (f '' S).Subsingleton := by
  intro x hx y hy
  rcases hx with ⟨a, ha, hax⟩
  rcases hy with ⟨b, hb, hby⟩
  have hab : f a = f b := by
    by_contra hxy
    rcases lt_or_gt_of_ne hxy with hlt | hgt
    · have hIcc : Set.Icc (f a) (f b) ⊆ f '' S :=
        hS.intermediate_value ha hb hf
      have hIccfin : (Set.Icc (f a) (f b)).Finite := hfin.subset hIcc
      exact hIccfin.not_infinite (Set.Icc_infinite hlt)
    · have hIcc : Set.Icc (f b) (f a) ⊆ f '' S :=
        hS.intermediate_value hb ha hf
      have hIccfin : (Set.Icc (f b) (f a)).Finite := hfin.subset hIcc
      exact hIccfin.not_infinite (Set.Icc_infinite hgt)
  exact hax.symm.trans (hab.trans hby)

theorem finite_mth_roots_unity {m : ℕ} (hm : 0 < m) :
    ({u : ℂ | u ^ m = 1}).Finite := by
  let q : ℂ[X] := X ^ m - 1
  have hq : q ≠ 0 := by
    intro hzero
    have hval : q.coeff m = 1 := by
      simp [q, Polynomial.coeff_X_pow, Polynomial.coeff_one, Nat.ne_of_gt hm]
    rw [hzero] at hval
    simpa using hval
  have hroot : (q.rootSet ℂ).Finite := q.rootSet_finite ℂ
  apply hroot.subset
  intro u hu
  apply q.mem_rootSet.mpr
  refine ⟨hq, ?_⟩
  simpa [q, aeval_def, eval_sub, eval_pow, eval_X, eval_one] using
    (sub_eq_zero.mpr hu)

theorem evenFamily_principal_root_unity_ratio_const_test
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : c < 1)
    {r : ℂ} (hr : r ∈ sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c)
    (hrim : (r ^ m).im ≠ 0) {z : ℂ}
    (hz : z ∈ connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r) :
    z / Erdos1047EvenFamily.principalRoot m (z ^ m) =
      r / Erdos1047EvenFamily.principalRoot m (r ^ m) := by
  let S : Set ℂ := connectedComponentIn
    (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r
  let ρ : ℂ → ℂ := fun w => w /
    Erdos1047EvenFamily.principalRoot m (w ^ m)
  have hsign : ∀ w ∈ S, (w ^ m).im ≠ 0 := by
    intro w hw
    exact (evenFamily_sublevel_pow_axes_avoid hc
      (connectedComponentIn_subset _ _ hw)).1
  have hslit : ∀ w ∈ S, w ^ m ∈ Complex.slitPlane := by
    intro w hw
    rw [Complex.mem_slitPlane_iff]
    right
    exact hsign w hw
  have hpowcont : ContinuousOn (fun w : ℂ => w ^ m) S := by
    fun_prop
  have hrootcont : ContinuousOn
      (fun w : ℂ => Erdos1047EvenFamily.principalRoot m (w ^ m)) S := by
    apply (Erdos1047EvenFamily.principalRoot_continuousOn_slitPlane hm).comp
      hpowcont
    exact hslit
  have hrhocont : ContinuousOn ρ S := by
    dsimp [ρ]
    apply ContinuousOn.div continuousOn_id hrootcont
    intro w hw
    exact Erdos1047EvenFamily.principalRoot_ne_zero m _
  have hρpow : ∀ w ∈ S, (ρ w) ^ m = 1 := by
    intro w hw
    have hw0 : w ^ m ≠ 0 := by
      intro hzero
      have := hsign w hw
      rw [hzero] at this
      exact this rfl
    dsimp [ρ]
    rw [div_pow, Erdos1047EvenFamily.principalRoot_pow hm hw0]
    exact div_self hw0
  have hρfin : (ρ '' S).Finite := by
    apply (finite_mth_roots_unity hm).subset
    intro u hu
    rcases hu with ⟨w, hw, rfl⟩
    exact hρpow w hw
  have hpre : IsPreconnected (ρ '' S) := by
    exact (isPreconnected_connectedComponentIn.image ρ hrhocont)
  have hRepre : IsPreconnected ((fun u : ℂ => u.re) '' (ρ '' S)) := by
    exact hpre.image (fun u : ℂ => u.re) (by fun_prop)
  have hImpre : IsPreconnected ((fun u : ℂ => u.im) '' (ρ '' S)) := by
    exact hpre.image (fun u : ℂ => u.im) (by fun_prop)
  have hRefin : ((fun u : ℂ => u.re) '' (ρ '' S)).Finite :=
    hρfin.image _
  have hImfin : ((fun u : ℂ => u.im) '' (ρ '' S)).Finite :=
    hρfin.image _
  have hResub := preconnected_finite_real_image_subsingleton
    (S := ρ '' S) (f := fun u : ℂ => u.re) hpre
    (by fun_prop) hRefin
  have hImsub := preconnected_finite_real_image_subsingleton
    (S := ρ '' S) (f := fun u : ℂ => u.im) hpre
    (by fun_prop) hImfin
  have hρsub : (ρ '' S).Subsingleton := by
    intro u hu v hv
    apply Complex.ext
    · exact hResub ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩
    · exact hImsub ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩
  apply hρsub
  · exact ⟨z, hz, rfl⟩
  · exact ⟨r, mem_connectedComponentIn hr, rfl⟩

theorem evenFamily_root_component_injOn_via_sheet
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc0 : 0 ≤ c) (hc1 : c < 1) :
    Set.InjOn (fun z : ℂ => connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) z)
      (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ) := by
  intro r hr s hs hrs
  change connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r =
    connectedComponentIn
      (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) s at hrs
  have hroot : ∀ {z : ℂ}, z ∈
      (Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ →
      (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z = 0 := by
    intro z hz
    simpa [aeval_def] using
      (Erdos1047EvenFamily.evenFamily_monic m hm).mem_rootSet.mp hz
  have hrS : r ∈ sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c := by
    change ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval r‖ ≤ c
    rw [hroot hr, norm_zero]
    exact hc0
  have hsS : s ∈ sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c := by
    change ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval s‖ ≤ c
    rw [hroot hs, norm_zero]
    exact hc0
  rcases (Erdos1047EvenFamily.evenFamily_mem_rootSet_iff hm r).mp hr with hrplus | hrminus
  · have hrpos : 0 < (r ^ m).im := by rw [hrplus]; norm_num
    have hrsign := evenFamily_component_pow_im_pos hc1 hrS hrpos
    have hsCr : s ∈ connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r := by
      rw [hrs]
      exact mem_connectedComponentIn hsS
    have hsim : 0 < (s ^ m).im := hrsign s hsCr
    rcases (Erdos1047EvenFamily.evenFamily_mem_rootSet_iff hm s).mp hs with hsplus | hsminus
    · have hratio := evenFamily_principal_root_unity_ratio_const_test hm hc1 hrS
        (ne_of_gt hrpos) hsCr
      have heqpow : s ^ m = r ^ m := hsplus.trans hrplus.symm
      rw [heqpow] at hratio
      have hden : Erdos1047EvenFamily.principalRoot m (r ^ m) ≠ 0 :=
        Erdos1047EvenFamily.principalRoot_ne_zero m _
      field_simp [hden] at hratio
      exact hratio.symm

    · have : (0 : ℝ) < -1 := by simpa [hsminus] using hsim
      linarith
  · have hrneg : (r ^ m).im < 0 := by rw [hrminus]; norm_num
    have hrsign := evenFamily_component_pow_im_neg hc1 hrS hrneg
    have hsCr : s ∈ connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) r := by
      rw [hrs]
      exact mem_connectedComponentIn hsS
    have hsim : (s ^ m).im < 0 := hrsign s hsCr
    rcases (Erdos1047EvenFamily.evenFamily_mem_rootSet_iff hm s).mp hs with hsplus | hsminus
    · have : (1 : ℝ) < 0 := by simpa [hsplus] using hsim
      linarith
    · have hratio := evenFamily_principal_root_unity_ratio_const_test hm hc1 hrS
        (ne_of_lt hrneg) hsCr
      have heqpow : s ^ m = r ^ m := hsminus.trans hrminus.symm
      rw [heqpow] at hratio
      have hden : Erdos1047EvenFamily.principalRoot m (r ^ m) ≠ 0 :=
        Erdos1047EvenFamily.principalRoot_ne_zero m _
      field_simp [hden] at hratio
      exact hratio.symm

/-! The sheet argument closes the component-count bookkeeping for every even
    degree.  It does not yet certify that all of those components are
    non-convex, which is the separate geometric part of the construction. -/
theorem evenFamily_componentsIn_ncard_eq_two_mul_of_sheet
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc0 : 0 ≤ c) (hc1 : c < 1) :
    (componentsIn (sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c)).ncard = 2 * m := by
  apply evenFamily_componentsIn_ncard_eq_two_mul_of_root_injOn hm hc0 hc1
  exact evenFamily_root_component_injOn_via_sheet hm hc0 hc1

/-! With the sheet invariant, the even-family attainment interface needs only
    non-convexity of each rooted component; the component-count input is
    supplied automatically. -/
theorem evenFamily_attainable_of_sheet_and_nonconvex
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : 0 < c) (hc1 : c < 1)
    (hnc : ∀ z ∈
      (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ),
      ¬ Convex ℝ (connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) z)) :
    2 * m ∈ attainableNonConvexCounts (2 * m) := by
  apply evenFamily_attainable_of_root_inj_and_nonconvex hm hc hc1
  · exact evenFamily_root_component_injOn_via_sheet hm (le_of_lt hc) hc1
  · exact hnc

/-! A single representative certificate now suffices for the whole even
    family: rotation and conjugation transport its non-convexity, while the
    sheet invariant supplies the component count and separation. -/
theorem evenFamily_attainable_of_single_certificate_and_sheet
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hc : 0 < c) (hc1 : c < 1)
    {r a b : ℂ}
    (hr : r ∈ (↑((Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ) : Set ℂ))
    (hrplus : r ^ m = 1 + Complex.I)
    (hcert : Nonempty (RobustNonconvexCertificate
      (fun z : ℂ => (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z)
      c r a b)) :
    2 * m ∈ attainableNonConvexCounts (2 * m) := by
  apply evenFamily_attainable_of_sheet_and_nonconvex hm hc hc1
  intro z hz
  exact evenFamily_root_nonconvex_of_single_certificate hm hr hrplus hcert z hz
/-! On the whole output disk the principal-root inverse is automatically
    well-defined: the first-quadrant sign certificate gives a nonzero inner
    point.  This is the disk-level form used by the even-family route. -/
theorem evenFamily_principalRoot_p4InverseUR_eval_of_output_disk
    {m : ℕ} (hm : 0 < m) {w : ℂ} (hw : w ∈ p4OutputDisk) :
    (Erdos1047EvenFamily.evenFamilyPolynomial m).eval
        (Erdos1047EvenFamily.principalRoot m (p4InverseUR w ^ 2)) = w := by
  apply evenFamily_principalRoot_p4InverseUR_eval hm
  intro hzero
  have hRe := congrArg Complex.re hzero
  have hpos := (p4_inverse_mem_and_signs w hw).2.1
  simp at hRe
  linarith

theorem p4_inverse_eval_eq_self (z : ℂ) (hzre : 0 < z.re) (hzim : 0 < z.im) :
    p4InverseUR (p4Polynomial.eval z) = z := by
  let q := z ^ 2 - 1
  let x := -Complex.I * q
  have hxre : 0 < x.re := by
    dsimp [x, q]
    norm_num [pow_succ, Complex.mul_re, Complex.mul_im]
    nlinarith
  have hsq : 1 - p4Polynomial.eval z = x ^ 2 := by
    dsimp [x, q]
    simp only [p4Polynomial, eval_add, eval_pow, eval_sub, eval_X, eval_one]
    ring_nf
    rw [Complex.I_sq]
    ring
  have hinner : Complex.sqrt (1 - p4Polynomial.eval z) = x := by
    rw [hsq]
    exact complex_sqrt_sq_of_re_pos x hxre
  rw [p4InverseUR, hinner]
  have houter : 1 + Complex.I * x = z ^ 2 := by
    dsimp [x, q]
    ring_nf
    rw [Complex.I_sq]
    ring
  rw [houter]
  exact complex_sqrt_sq_of_re_pos z hzre

theorem q2UpperRegion_eq_sublevel_inter_upper
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) :
    q2InverseU '' Metric.closedBall (0 : ℂ) c =
      q2SublevelSet c ∩ {z : ℂ | 0 < z.im} := by
  have hc_lt_one : c < 1 := lt_one_of_le_p4Level hc1
  ext z
  constructor
  · rintro ⟨w, hw, rfl⟩
    constructor
    · change ‖q2Polynomial.eval (q2InverseU w)‖ ≤ c
      rw [q2_inverse_eval]
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    · apply q2_inverse_im_pos_of_output_disk
      apply mem_p4OutputDisk_of_norm_le_level
      have hw' : ‖w‖ ≤ c := by
        simpa [Metric.mem_closedBall, dist_zero_right] using hw
      linarith
  · rintro ⟨hz, hzim⟩
    have hnorm : ‖q2Polynomial.eval z‖ ≤ c := hz
    have hzre : 0 < z.re := by
      by_contra hnot
      have hle : z.re ≤ 0 := le_of_not_gt hnot
      have hge := q2_norm_ge_two_of_re_nonpos hle
      linarith
    have hw : q2Polynomial.eval z ∈ Metric.closedBall (0 : ℂ) c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hnorm
    refine ⟨q2Polynomial.eval z, ?_, ?_⟩
    · exact hw
    have hsqrt_re : 0 < (Complex.sqrt z).re :=
      complex_sqrt_re_pos_of_re_pos z hzre
    have hsqrt_im : 0 < (Complex.sqrt z).im :=
      complex_sqrt_im_pos_of_im_pos z hzim
    have hsqrt_sq : (Complex.sqrt z) ^ 2 = z := by
      unfold Complex.sqrt
      exact Complex.cpow_nat_inv_pow _ (by norm_num)
    have hp4q : p4Polynomial.eval (Complex.sqrt z) = q2Polynomial.eval z := by
      rw [q2Polynomial_eval]
      simp only [p4Polynomial, eval_add, eval_pow, eval_sub, eval_X, eval_one]
      rw [hsqrt_sq]
    rw [q2InverseU, ← hp4q]
    rw [p4_inverse_eval_eq_self (Complex.sqrt z) hsqrt_re hsqrt_im]
    exact hsqrt_sq

theorem q2_upper_inverse_eq_of_sublevel_of_im_pos
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) {z : ℂ}
    (hz : z ∈ q2SublevelSet c) (hzim : 0 < z.im) :
    q2InverseU (q2Polynomial.eval z) = z := by
  have hzimg : z ∈ q2InverseU '' Metric.closedBall (0 : ℂ) c :=
    by
      rw [q2UpperRegion_eq_sublevel_inter_upper hcpos hc1]
      exact ⟨hz, hzim⟩
  rcases hzimg with ⟨w, hw, hEq⟩
  have hweq : w = q2Polynomial.eval z := by
    have heval := congrArg (fun u : ℂ => q2Polynomial.eval u) hEq
    simpa [q2_inverse_eval] using heval
  subst w
  exact hEq

theorem q2_lower_inverse_eq_of_sublevel_of_im_neg
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) {z : ℂ}
    (hz : z ∈ q2SublevelSet c) (hzim : z.im < 0) :
    q2InverseL (q2Polynomial.eval z) = z := by
  have hq : q2Polynomial.eval (2 - z) = q2Polynomial.eval z := by
    rw [q2Polynomial_eval, q2Polynomial_eval]
    ring
  have hz' : (2 - z) ∈ q2SublevelSet c := by
    change ‖q2Polynomial.eval (2 - z)‖ ≤ c
    rw [hq]
    exact hz
  have hzim' : 0 < (2 - z).im := by
    change 0 < (2 - z).im
    norm_num [Complex.sub_im]
    linarith
  have hrep := q2_upper_inverse_eq_of_sublevel_of_im_pos
    hcpos hc1 hz' hzim'
  calc
    q2InverseL (q2Polynomial.eval z) =
        2 - q2InverseU (q2Polynomial.eval z) := by rfl
    _ = 2 - q2InverseU (q2Polynomial.eval (2 - z)) := by rw [hq]
    _ = 2 - (2 - z) := by rw [hrep]
    _ = z := by ring

theorem q2LowerRegion_eq_sublevel_inter_lower
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) :
    q2InverseL '' Metric.closedBall (0 : ℂ) c =
      q2SublevelSet c ∩ {z : ℂ | z.im < 0} := by
  ext z
  constructor
  · rintro ⟨w, hw, rfl⟩
    constructor
    · change ‖q2Polynomial.eval (q2InverseL w)‖ ≤ c
      rw [q2_inverse_lower_eval]
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    · apply q2_inverse_lower_im_neg_of_output_disk
      apply mem_p4OutputDisk_of_norm_le_level
      have hw' : ‖w‖ ≤ c := by
        simpa [Metric.mem_closedBall, dist_zero_right] using hw
      linarith
  · rintro ⟨hz, hzim⟩
    change z.im < 0 at hzim
    have hq : q2Polynomial.eval (2 - z) = q2Polynomial.eval z := by
      rw [q2Polynomial_eval, q2Polynomial_eval]
      ring
    have hz' : (2 - z) ∈ q2SublevelSet c := by
      change ‖q2Polynomial.eval (2 - z)‖ ≤ c
      rw [hq]
      exact hz
    have hzim' : 0 < (2 - z).im := by
      change 0 < (2 - z).im
      norm_num [Complex.sub_im]
      linarith
    have hrep := q2_upper_inverse_eq_of_sublevel_of_im_pos
      hcpos hc1 hz' hzim'
    have hweq : q2Polynomial.eval (2 - z) = q2Polynomial.eval z := by
      exact hq
    have hw : q2Polynomial.eval z ∈ Metric.closedBall (0 : ℂ) c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using (show
        ‖q2Polynomial.eval z‖ ≤ c from hz)
    refine ⟨q2Polynomial.eval z, hw, ?_⟩
    dsimp [q2InverseL]
    rw [← hweq, hrep]
    ring

def p4QuadrantUR : Set ℂ :=
  {z | z ∈ sublevelSet p4Polynomial p4Level ∧ 0 < z.re ∧ 0 < z.im}

theorem p4_quadrant_eq_image : p4QuadrantUR = p4InverseUR '' p4OutputDisk := by
  ext z
  constructor
  · rintro ⟨hzK, hzre, hzim⟩
    refine ⟨p4Polynomial.eval z, ?_, p4_inverse_eval_eq_self z hzre hzim⟩
    simpa [p4OutputDisk, sublevelSet] using hzK
  · rintro ⟨w, hw, rfl⟩
    exact p4_inverse_mem_and_signs w hw

theorem p4_continuousOn_inverse : ContinuousOn p4InverseUR p4OutputDisk := by
  intro w hw
  change ContinuousWithinAt
    (fun u : ℂ ↦ Complex.sqrt (1 + Complex.I * Complex.sqrt (1 - u))) p4OutputDisk w
  have hwnorm : ‖w‖ ≤ p4Level := by simpa [p4OutputDisk] using hw
  have hlevel : p4Level < 1 := by norm_num [p4Level]
  have hare : 0 < (1 - w).re := by
    have := Complex.re_le_norm w
    norm_num
    nlinarith
  have hinnerAt : ContinuousAt (fun u : ℂ ↦ Complex.sqrt (1 - u)) w :=
    (Complex.continuousAt_sqrt (Or.inl hare.le)).comp
      (continuousAt_const.sub continuousAt_id)
  have hsre : 0 < (Complex.sqrt (1 - w)).re :=
    complex_sqrt_re_pos_of_re_pos _ hare
  have htim : 0 < (1 + Complex.I * Complex.sqrt (1 - w)).im := by
    norm_num [Complex.mul_re, Complex.mul_im]
    exact hsre
  have houterAt : ContinuousAt
      (fun u : ℂ ↦ 1 + Complex.I * Complex.sqrt (1 - u)) w :=
    continuousAt_const.add (continuousAt_const.mul hinnerAt)
  have hsqrtAt : ContinuousAt Complex.sqrt
      (1 + Complex.I * Complex.sqrt (1 - w)) :=
    Complex.continuousAt_sqrt (Or.inr (ne_of_gt htim))
  have hcomp := ContinuousAt.comp
    (f := fun u : ℂ ↦ 1 + Complex.I * Complex.sqrt (1 - u))
    (g := Complex.sqrt) hsqrtAt houterAt
  simpa [Function.comp_def] using hcomp.continuousWithinAt

theorem q2_continuousOn_inverse : ContinuousOn q2InverseU p4OutputDisk := by
  intro w hw
  change ContinuousWithinAt (fun u : ℂ => p4InverseUR u ^ 2) p4OutputDisk w
  exact (p4_continuousOn_inverse w hw).pow 2

theorem q2_lower_continuousOn_inverse : ContinuousOn q2InverseL p4OutputDisk := by
  intro w hw
  change ContinuousWithinAt (fun u : ℂ => 2 - q2InverseU u) p4OutputDisk w
  exact continuousWithinAt_const.sub (q2_continuousOn_inverse w hw)

def q2UpperRegion : Set ℂ := q2InverseU '' p4OutputDisk

def q2UpperRegionAt (c : ℝ) : Set ℂ :=
  q2InverseU '' Metric.closedBall (0 : ℂ) c

def q2LowerRegionAt (c : ℝ) : Set ℂ :=
  q2InverseL '' Metric.closedBall (0 : ℂ) c

theorem q2UpperRegion_preconnected : IsPreconnected q2UpperRegion := by
  exact (convex_closedBall (0 : ℂ) p4Level).isPreconnected.image
    q2InverseU q2_continuousOn_inverse

theorem q2UpperRegionAt_preconnected {c : ℝ} (hc1 : c ≤ p4Level) :
    IsPreconnected (q2UpperRegionAt c) := by
  have hsmall : ∀ w ∈ Metric.closedBall (0 : ℂ) c,
      w ∈ p4OutputDisk := by
    intro w hw
    apply mem_p4OutputDisk_of_norm_le_level
    have hw' : ‖w‖ ≤ c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    linarith
  have hcont : ContinuousOn q2InverseU (Metric.closedBall (0 : ℂ) c) := by
    intro w hw
    exact (q2_continuousOn_inverse w (hsmall w hw)).mono (by
      intro z hz
      exact hsmall z hz)
  exact (convex_closedBall (0 : ℂ) c).isPreconnected.image
    q2InverseU hcont

theorem q2UpperRegionAt_subset_slitPlane {c : ℝ} (hc1 : c ≤ p4Level) :
    q2UpperRegionAt c ⊆ Complex.slitPlane := by
  rintro z ⟨w, hw, rfl⟩
  rw [Complex.mem_slitPlane_iff]
  right
  apply ne_of_gt (q2_inverse_im_pos_of_output_disk ?_)
  apply mem_p4OutputDisk_of_norm_le_level
  have hw' : ‖w‖ ≤ c := by
    simpa [Metric.mem_closedBall, dist_zero_right] using hw
  linarith

def evenFamilyUpperSector (m : ℕ) (c : ℝ) : Set ℂ :=
  Erdos1047EvenFamily.principalRoot m '' q2UpperRegionAt c

def evenFamilyRotatedUpperSector (m : ℕ) (c : ℝ) (u : ℂ) : Set ℂ :=
  (fun z : ℂ => u * z) '' evenFamilyUpperSector m c

def q2LowerRegionAt_preconnected_helper {c : ℝ} (hc1 : c ≤ p4Level) :
    IsPreconnected (q2LowerRegionAt c) := by
  have hsmall : ∀ w ∈ Metric.closedBall (0 : ℂ) c,
      w ∈ p4OutputDisk := by
    intro w hw
    apply mem_p4OutputDisk_of_norm_le_level
    have hw' : ‖w‖ ≤ c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    linarith
  have hcont : ContinuousOn q2InverseL (Metric.closedBall (0 : ℂ) c) := by
    intro w hw
    exact (q2_lower_continuousOn_inverse w (hsmall w hw)).mono (by
      intro z hz
      exact hsmall z hz)
  exact (convex_closedBall (0 : ℂ) c).isPreconnected.image
    q2InverseL hcont

theorem q2LowerRegionAt_subset_slitPlane {c : ℝ} (hc1 : c ≤ p4Level) :
    q2LowerRegionAt c ⊆ Complex.slitPlane := by
  rintro z ⟨w, hw, rfl⟩
  rw [Complex.mem_slitPlane_iff]
  right
  exact ne_of_lt (q2_inverse_lower_im_neg_of_output_disk
    (mem_p4OutputDisk_of_norm_le_level (by
      have hw' : ‖w‖ ≤ c := by
        simpa [Metric.mem_closedBall, dist_zero_right] using hw
      linarith)))

def evenFamilyLowerSector (m : ℕ) (c : ℝ) : Set ℂ :=
  Erdos1047EvenFamily.principalRoot m '' q2LowerRegionAt c

theorem evenFamilyLowerSector_preconnected {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hc1 : c ≤ p4Level) :
    IsPreconnected (evenFamilyLowerSector m c) := by
  have hrootcont : ContinuousOn (Erdos1047EvenFamily.principalRoot m)
      (q2LowerRegionAt c) := by
    intro z hz
    exact (Erdos1047EvenFamily.principalRoot_continuousOn_slitPlane hm z
      (q2LowerRegionAt_subset_slitPlane hc1 hz)).mono
      (q2LowerRegionAt_subset_slitPlane hc1)
  exact (q2LowerRegionAt_preconnected_helper hc1).image
    (Erdos1047EvenFamily.principalRoot m) hrootcont

theorem evenFamilyLowerSector_subset_sublevel {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) :
    evenFamilyLowerSector m c ⊆
      sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c := by
  rintro y ⟨z, ⟨w, hw, rfl⟩, rfl⟩
  have hw' : ‖w‖ ≤ c := by
    simpa [Metric.mem_closedBall, dist_zero_right] using hw
  have hslit : q2InverseL w ∈ Complex.slitPlane :=
    q2LowerRegionAt_subset_slitPlane hc1 ⟨w, hw, rfl⟩
  have hpow := Erdos1047EvenFamily.principalRoot_pow hm
    (Complex.slitPlane_ne_zero hslit)
  have hval : (q2InverseL w - 1) ^ 2 + 1 = w := by
    simpa [q2Polynomial_eval] using q2_inverse_lower_eval w
  change ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval
    (Erdos1047EvenFamily.principalRoot m (q2InverseL w))‖ ≤ c
  rw [Erdos1047EvenFamily.evenFamily_eval, hpow, hval]
  exact hw'

def evenFamilyRotatedLowerSector (m : ℕ) (c : ℝ) (u : ℂ) : Set ℂ :=
  (fun z : ℂ => u * z) '' evenFamilyLowerSector m c

theorem evenFamilyRotatedLowerSector_preconnected {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hc1 : c ≤ p4Level) (u : ℂ) :
    IsPreconnected (evenFamilyRotatedLowerSector m c u) := by
  exact (evenFamilyLowerSector_preconnected hm hc1).image _ (by fun_prop)

theorem evenFamilyRotatedLowerSector_subset_sublevel {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) {u : ℂ} (hu : u ^ m = 1) :
    evenFamilyRotatedLowerSector m c u ⊆
      sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c := by
  rintro z ⟨y, hy, rfl⟩
  change ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval (u * y)‖ ≤ c
  rw [Erdos1047EvenFamily.evenFamily_norm_eval_mul_root_of_unity hu]
  exact evenFamilyLowerSector_subset_sublevel hm hcpos hc1 hy

theorem evenFamilyRotatedLowerSector_disjoint {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hc1 : c ≤ p4Level) {u v : ℂ}
    (hu : u ^ m = 1) (hv : v ^ m = 1) (huv : u ≠ v) :
    Disjoint (evenFamilyRotatedLowerSector m c u)
      (evenFamilyRotatedLowerSector m c v) := by
  apply Set.disjoint_left.2
  intro x hxU hxV
  rcases hxU with ⟨r₁, ⟨a₁, ⟨w₁, hw₁, ha₁⟩, hr₁⟩, hxr₁⟩
  rcases hxV with ⟨r₂, ⟨a₂, ⟨w₂, hw₂, ha₂⟩, hr₂⟩, hxr₂⟩
  have hEq : u * r₁ = v * r₂ := hxr₁.trans hxr₂.symm
  have hpowEq := congrArg (fun z : ℂ => z ^ m) hEq
  rw [mul_pow, mul_pow, hu, hv, one_mul, one_mul] at hpowEq
  have hslit₁ : q2InverseL w₁ ∈ Complex.slitPlane :=
    q2LowerRegionAt_subset_slitPlane hc1 ⟨w₁, hw₁, rfl⟩
  have hslit₂ : q2InverseL w₂ ∈ Complex.slitPlane :=
    q2LowerRegionAt_subset_slitPlane hc1 ⟨w₂, hw₂, rfl⟩
  rw [← hr₁, ← hr₂, ← ha₁, ← ha₂] at hpowEq
  have hqEq : q2InverseL w₁ = q2InverseL w₂ := by
    calc
      q2InverseL w₁ =
          (Erdos1047EvenFamily.principalRoot m (q2InverseL w₁)) ^ m :=
        (Erdos1047EvenFamily.principalRoot_pow hm
          (Complex.slitPlane_ne_zero hslit₁)).symm
      _ = (Erdos1047EvenFamily.principalRoot m (q2InverseL w₂)) ^ m := hpowEq
      _ = q2InverseL w₂ := Erdos1047EvenFamily.principalRoot_pow hm
        (Complex.slitPlane_ne_zero hslit₂)
  have hwEq : w₁ = w₂ := by
    have heval := congrArg (fun z : ℂ => q2Polynomial.eval z) hqEq
    simpa [q2_inverse_lower_eval] using heval
  have hrEq : r₁ = r₂ := by
    calc
      r₁ = Erdos1047EvenFamily.principalRoot m a₁ := hr₁.symm
      _ = Erdos1047EvenFamily.principalRoot m (q2InverseL w₁) := by rw [ha₁]
      _ = Erdos1047EvenFamily.principalRoot m (q2InverseL w₂) := by rw [hwEq]
      _ = Erdos1047EvenFamily.principalRoot m a₂ := by rw [ha₂]
      _ = r₂ := hr₂
  have hmul : u * r₁ = v * r₁ := by simpa [hrEq] using hEq
  have hr0 : r₁ ≠ 0 := by
    intro hzero
    apply Erdos1047EvenFamily.principalRoot_ne_zero m a₁
    rw [hr₁]
    exact hzero
  have : u = v := by
    exact (mul_right_cancel₀ hr0) hmul
  exact huv this

theorem evenFamilyRotatedUpperLowerSector_disjoint {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hc1 : c ≤ p4Level) {u v : ℂ}
    (hu : u ^ m = 1) (hv : v ^ m = 1) :
    Disjoint (evenFamilyRotatedUpperSector m c u)
      (evenFamilyRotatedLowerSector m c v) := by
  apply Set.disjoint_left.2
  intro x hxU hxL
  rcases hxU with ⟨r₁, ⟨a₁, ⟨w₁, hw₁, ha₁⟩, hr₁⟩, hxr₁⟩
  rcases hxL with ⟨r₂, ⟨a₂, ⟨w₂, hw₂, ha₂⟩, hr₂⟩, hxr₂⟩
  have hEq : u * r₁ = v * r₂ := hxr₁.trans hxr₂.symm
  have hpowEq := congrArg (fun z : ℂ => z ^ m) hEq
  rw [mul_pow, mul_pow, hu, hv, one_mul, one_mul] at hpowEq
  have hslit₁ : q2InverseU w₁ ∈ Complex.slitPlane :=
    q2UpperRegionAt_subset_slitPlane hc1 ⟨w₁, hw₁, rfl⟩
  have hslit₂ : q2InverseL w₂ ∈ Complex.slitPlane :=
    q2LowerRegionAt_subset_slitPlane hc1 ⟨w₂, hw₂, rfl⟩
  rw [← hr₁, ← hr₂, ← ha₁, ← ha₂] at hpowEq
  have hqEq : q2InverseU w₁ = q2InverseL w₂ := by
    calc
      q2InverseU w₁ =
          (Erdos1047EvenFamily.principalRoot m (q2InverseU w₁)) ^ m :=
        (Erdos1047EvenFamily.principalRoot_pow hm
          (Complex.slitPlane_ne_zero hslit₁)).symm
      _ = (Erdos1047EvenFamily.principalRoot m (q2InverseL w₂)) ^ m := hpowEq
      _ = q2InverseL w₂ := Erdos1047EvenFamily.principalRoot_pow hm
        (Complex.slitPlane_ne_zero hslit₂)
  have hsmall₁ : w₁ ∈ p4OutputDisk := by
    apply mem_p4OutputDisk_of_norm_le_level
    have hw' : ‖w₁‖ ≤ c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw₁
    linarith
  have hsmall₂ : w₂ ∈ p4OutputDisk := by
    apply mem_p4OutputDisk_of_norm_le_level
    have hw' : ‖w₂‖ ≤ c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw₂
    linarith
  have hpos := q2_inverse_im_pos_of_output_disk hsmall₁
  have hneg := q2_inverse_lower_im_neg_of_output_disk hsmall₂
  have him := congrArg Complex.im hqEq
  linarith

theorem evenFamily_sublevel_mem_rotated_upper_or_lower_sector
    {m : ℕ} (hm : 0 < m) {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level)
    {z : ℂ} (hz : z ∈ sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c) :
    ∃ u : ℂ, u ^ m = 1 ∧
      (z ∈ evenFamilyRotatedUpperSector m c u ∨
       z ∈ evenFamilyRotatedLowerSector m c u) := by
  have hc_lt_one : c < 1 := lt_one_of_le_p4Level hc1
  have hqeval : q2Polynomial.eval (z ^ m) =
      (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z := by
    rw [q2Polynomial_eval, Erdos1047EvenFamily.evenFamily_eval]
  have hw : z ^ m ∈ q2SublevelSet c := by
    change ‖q2Polynomial.eval (z ^ m)‖ ≤ c
    rw [hqeval]
    exact hz
  have hwne : (z ^ m).im ≠ 0 := by
    intro him
    have hge := q2_norm_ge_one_of_im_zero him
    have hzle : ‖q2Polynomial.eval (z ^ m)‖ ≤ c := hw
    linarith
  rcases lt_or_gt_of_ne hwne with hwneg | hwpos
  · have hwinv := q2_lower_inverse_eq_of_sublevel_of_im_neg
      hcpos hc1 hw hwneg
    have hwball : q2Polynomial.eval (z ^ m) ∈
        Metric.closedBall (0 : ℂ) c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using (show
        ‖q2Polynomial.eval (z ^ m)‖ ≤ c from hw)
    have hslit : z ^ m ∈ Complex.slitPlane := by
      rw [Complex.mem_slitPlane_iff]
      right
      exact hwne
    let r : ℂ := Erdos1047EvenFamily.principalRoot m (z ^ m)
    have hrpow : r ^ m = z ^ m := by
      dsimp [r]
      exact Erdos1047EvenFamily.principalRoot_pow hm
        (Complex.slitPlane_ne_zero hslit)
    have hr0 : r ≠ 0 := Erdos1047EvenFamily.principalRoot_ne_zero m _
    have hzpow0 : z ^ m ≠ 0 := by
      intro hzero
      have himzero := congrArg Complex.im hzero
      simp at himzero
      exact hwne himzero
    let u : ℂ := z / r
    have hu : u ^ m = 1 := by
      dsimp [u]
      rw [div_pow, hrpow]
      field_simp [hr0, hzpow0]
    have hrsec : r ∈ evenFamilyLowerSector m c := by
      refine ⟨z ^ m, ⟨q2Polynomial.eval (z ^ m), hwball, hwinv⟩, rfl⟩
    refine ⟨u, hu, Or.inr ?_⟩
    refine ⟨r, hrsec, ?_⟩
    dsimp [u]
    field_simp [hr0]
  · have hwinv := q2_upper_inverse_eq_of_sublevel_of_im_pos
      hcpos hc1 hw hwpos
    have hwball : q2Polynomial.eval (z ^ m) ∈
        Metric.closedBall (0 : ℂ) c := by
      simpa [Metric.mem_closedBall, dist_zero_right] using (show
        ‖q2Polynomial.eval (z ^ m)‖ ≤ c from hw)
    have hslit : z ^ m ∈ Complex.slitPlane := by
      rw [Complex.mem_slitPlane_iff]
      right
      exact hwne
    let r : ℂ := Erdos1047EvenFamily.principalRoot m (z ^ m)
    have hrpow : r ^ m = z ^ m := by
      dsimp [r]
      exact Erdos1047EvenFamily.principalRoot_pow hm
        (Complex.slitPlane_ne_zero hslit)
    have hr0 : r ≠ 0 := Erdos1047EvenFamily.principalRoot_ne_zero m _
    have hzpow0 : z ^ m ≠ 0 := by
      intro hzero
      have himzero := congrArg Complex.im hzero
      simp at himzero
      exact hwne himzero
    let u : ℂ := z / r
    have hu : u ^ m = 1 := by
      dsimp [u]
      rw [div_pow, hrpow]
      field_simp [hr0, hzpow0]
    have hrsec : r ∈ evenFamilyUpperSector m c := by
      refine ⟨z ^ m, ⟨q2Polynomial.eval (z ^ m), hwball, hwinv⟩, rfl⟩
    refine ⟨u, hu, Or.inl ?_⟩
    refine ⟨r, hrsec, ?_⟩
    dsimp [u]
    field_simp [hr0]

theorem evenFamilyUpperSector_preconnected {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hc1 : c ≤ p4Level) :
    IsPreconnected (evenFamilyUpperSector m c) := by
  have hrootcont : ContinuousOn (Erdos1047EvenFamily.principalRoot m)
      (q2UpperRegionAt c) := by
    intro z hz
    exact (Erdos1047EvenFamily.principalRoot_continuousOn_slitPlane hm z
      (q2UpperRegionAt_subset_slitPlane hc1 hz)).mono
      (q2UpperRegionAt_subset_slitPlane hc1)
  exact (q2UpperRegionAt_preconnected hc1).image
    (Erdos1047EvenFamily.principalRoot m) hrootcont

theorem evenFamilyUpperSector_subset_sublevel {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) :
    evenFamilyUpperSector m c ⊆
      sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c := by
  rintro y ⟨z, ⟨w, hw, rfl⟩, rfl⟩
  have hw' : ‖w‖ ≤ c := by
    simpa [Metric.mem_closedBall, dist_zero_right] using hw
  have hslit : q2InverseU w ∈ Complex.slitPlane :=
    q2UpperRegionAt_subset_slitPlane hc1 ⟨w, hw, rfl⟩
  have hpow := Erdos1047EvenFamily.principalRoot_pow hm
    (Complex.slitPlane_ne_zero hslit)
  have hval : (q2InverseU w - 1) ^ 2 + 1 = w := by
    simpa [q2Polynomial_eval] using q2_inverse_eval w
  change ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval
    (Erdos1047EvenFamily.principalRoot m (q2InverseU w))‖ ≤ c
  rw [Erdos1047EvenFamily.evenFamily_eval, hpow, hval]
  exact hw'

def evenFamilyUpperAnchor (m : ℕ) : ℂ :=
  Erdos1047EvenFamily.principalRoot m (q2InverseU 0)

theorem evenFamilyUpperAnchor_mem_sublevel {m : ℕ} (hm : 0 < m)
    {c : ℝ} (hcpos : 0 < c) (hc1 : c ≤ p4Level) :
    evenFamilyUpperAnchor m ∈
      sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c := by
  apply evenFamilyUpperSector_subset_sublevel hm hcpos hc1
  refine ⟨q2InverseU 0, ?_, rfl⟩
  exact ⟨0, by simp [Metric.mem_closedBall, hcpos.le], rfl⟩

theorem evenFamilyUpperAnchor_mem_rootSet {m : ℕ} (hm : 0 < m) :
    evenFamilyUpperAnchor m ∈
      (Erdos1047EvenFamily.evenFamilyPolynomial m).rootSet ℂ := by
  have hslit : q2InverseU 0 ∈ Complex.slitPlane := by
    rw [Complex.mem_slitPlane_iff]
    right
    have hzero : (0 : ℂ) ∈ p4OutputDisk := by
      have hnorm : ‖(0 : ℂ)‖ ≤ p4Level := by norm_num [p4Level]
      simpa [p4OutputDisk] using hnorm
    exact ne_of_gt (q2_inverse_im_pos_of_output_disk hzero)
  have hpow := Erdos1047EvenFamily.principalRoot_pow hm
    (Complex.slitPlane_ne_zero hslit)
  apply (Erdos1047EvenFamily.evenFamily_monic m hm).mem_rootSet.mpr
  change (Erdos1047EvenFamily.evenFamilyPolynomial m).eval
    (Erdos1047EvenFamily.principalRoot m (q2InverseU 0)) = 0
  rw [Erdos1047EvenFamily.evenFamily_eval, hpow]
  have hq0 : (q2InverseU 0 - 1) ^ 2 + 1 = 0 := by
    simpa [q2Polynomial_eval] using q2_inverse_eval 0
  exact hq0

def evenFamilyLowerAnchor (m : ℕ) : ℂ :=
  Erdos1047EvenFamily.principalRoot m (q2InverseL 0)

theorem evenFamilyLowerAnchor_mem_sublevel {m : ℕ} (hm : 0 < m)
