theorem bernstein16_neg (c : Fin 17 → ℝ) (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hc : ∀ i, c i < 0) :
    (∑ i : Fin 17, c i * t ^ (i : ℕ) * (1 - t) ^ (16 - (i : ℕ))) < 0 := by
  by_cases ht : t < 1
  · by_cases htz : t = 0
    · subst t
      simpa [Fin.sum_univ_succ] using hc 0
    · have htp : 0 < t := lt_of_le_of_ne ht0 (Ne.symm htz)
      have hsub : 0 < 1 - t := by linarith
      apply Finset.sum_neg
      · intro i hi
        calc
          c i * t ^ (i : ℕ) * (1 - t) ^ (16 - (i : ℕ)) =
              c i * (t ^ (i : ℕ) * (1 - t) ^ (16 - (i : ℕ))) := by ring
          _ < 0 := mul_neg_of_neg_of_pos (hc i)
            (mul_pos (pow_pos htp _) (pow_pos hsub _))
      · exact Finset.univ_nonempty
  · have ht' : t = 1 := le_antisymm ht1 (le_of_not_gt ht)
    subst t
    simpa [Fin.sum_univ_succ] using hc 16

