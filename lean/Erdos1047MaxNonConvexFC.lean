/-!
# The small positive local scale and cubic parameter

The quadratic Taylor coefficient is normalized to one.  The cubic parameter
is eventually positive and tends to zero; fourth and higher coefficients have
controlled ratios to its square.  All limits are for an arbitrary real monic
polynomial of degree greater than two, not for a fixed numerical example.
-/

open Polynomial Filter
open scoped Topology
open Erdos1047BalancedRaise Erdos1047BalancedTaylor

namespace Erdos1047BalancedNormalization

noncomputable section

def localScale (p : ℝ[X]) (b L : ℝ) : ℝ :=
  Real.sqrt (balancedD p b L / quadraticFactor p b L)

def cubicParam (p : ℝ[X]) (b L : ℝ) : ℝ :=
  raisedRatio p b 1 L * localScale p b L / quadraticFactor p b L

/-- Coefficient of `w^(j+4)` after quadratic normalization. -/
def tailCoeff (p : ℝ[X]) (b : ℝ) (j : ℕ) (L : ℝ) : ℝ :=
  raisedRatio p b (j + 2) L * localScale p b L ^ (j + 2) / quadraticFactor p b L

/-- A form of `tailCoeff / cubicParam^2` with no small scale in the denominator. -/
def tailRatio (p : ℝ[X]) (b : ℝ) (j : ℕ) (L : ℝ) : ℝ :=
  quadraticFactor p b L *
    (raisedRatio p b (j + 2) L / raisedRatio p b 1 L ^ 2) * localScale p b L ^ j

theorem tendsto_localScale {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) :
    Tendsto (localScale p b) atTop (𝓝 0) := by
  have h := ((tendsto_balancedD hp hdeg b).div
    (tendsto_quadraticFactor hp hdeg b) (by norm_num : (1 : ℝ) ≠ 0)).sqrt
  change Tendsto (fun L => Real.sqrt (balancedD p b L / quadraticFactor p b L)) atTop (𝓝 0)
  simpa using h

theorem tendsto_cubicFactor {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) :
    Tendsto (raisedRatio p b 1) atTop (𝓝 0) := by
  have h := (tendsto_scaled_cubicFactor hp hdeg b).div_atTop tendsto_id
  apply h.congr'
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with L hL
  dsimp
  field_simp

theorem tendsto_cubicParam {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) :
    Tendsto (cubicParam p b) atTop (𝓝 0) := by
  have h := ((tendsto_cubicFactor hp hdeg b).mul (tendsto_localScale hp hdeg b)).div
    (tendsto_quadraticFactor hp hdeg b) (by norm_num : (1 : ℝ) ≠ 0)
  have heq : ((fun L => raisedRatio p b 1 L * localScale p b L) / quadraticFactor p b) =
      cubicParam p b := by
    ext L
    rfl
  rw [heq] at h
  simpa using h

theorem eventually_parameters_pos {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) {b : ℝ} (hb : 0 < b) :
    ∀ᶠ L : ℝ in atTop, 0 < L ∧ 0 < p.eval L ∧ 0 < quadraticFactor p b L ∧
      0 < raisedRatio p b 1 L ∧ 0 < localScale p b L ∧
      0 < cubicParam p b L ∧ cubicParam p b L ≤ 1 / 10000 := by
  have hn : (0 : ℝ) < p.natDegree := by exact_mod_cast (show 0 < p.natDegree by omega)
  have hpdeg : 0 < p.degree := natDegree_pos_iff_degree_pos.mp (by omega)
  have hpinf := p.tendsto_atTop_of_leadingCoeff_nonneg hpdeg (by rw [hp.leadingCoeff]; norm_num)
  filter_upwards [eventually_gt_atTop (0 : ℝ),
    hpinf.eventually (eventually_gt_atTop (0 : ℝ)),
    (tendsto_quadraticFactor hp hdeg b).eventually_const_lt (by norm_num : (0 : ℝ) < 1),
    (tendsto_scaled_cubicFactor hp hdeg b).eventually_const_lt hn,
    (tendsto_cubicParam hp hdeg b).eventually_lt_const (by norm_num : (0 : ℝ) < 1 / 10000)]
    with L hL hpL hH hB hk
  have hBpos : 0 < raisedRatio p b 1 L := (mul_pos_iff_of_pos_left hL).mp hB
  have hD : 0 < balancedD p b L := div_pos (mul_pos hb (sq_pos_of_pos hL)) hpL
  have hs : 0 < localScale p b L := Real.sqrt_pos.2 (div_pos hD hH)
  exact ⟨hL, hpL, hH, hBpos, hs, div_pos (mul_pos hBpos hs) hH, hk.le⟩

theorem localScale_sq {p : ℝ[X]} {b L : ℝ}
    (hD : 0 ≤ balancedD p b L) (hH : 0 < quadraticFactor p b L) :
    localScale p b L ^ 2 = balancedD p b L / quadraticFactor p b L :=
  Real.sq_sqrt (div_nonneg hD hH.le)

theorem tendsto_ratio_to_cubic_sq {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) {j : ℕ} {a : ℝ}
    (ha : Tendsto (fun L : ℝ => L ^ 2 * raisedRatio p b j L) atTop (𝓝 a)) :
    Tendsto (fun L : ℝ => raisedRatio p b j L / raisedRatio p b 1 L ^ 2)
      atTop (𝓝 (a / (p.natDegree : ℝ) ^ 2)) := by
  have hn : (p.natDegree : ℝ) ≠ 0 := by exact_mod_cast (show p.natDegree ≠ 0 by omega)
  have h := ha.div ((tendsto_scaled_cubicFactor hp hdeg b).pow 2) (pow_ne_zero 2 hn)
  apply h.congr'
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with L hL
  dsimp
  rw [mul_pow]
  exact mul_div_mul_left _ _ (pow_ne_zero 2 hL.ne')

theorem tendsto_tailRatio_zero {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) :
    Tendsto (tailRatio p b 0) atTop
      (𝓝 ((p.natDegree.choose 2 : ℝ) / (p.natDegree : ℝ) ^ 2)) := by
  have h := (tendsto_quadraticFactor hp hdeg b).mul
    (tendsto_ratio_to_cubic_sq hp hdeg b (tendsto_scaled_quarticFactor hp hdeg b))
  change Tendsto (fun L => tailRatio p b 0 L) atTop _
  simpa [tailRatio] using h

theorem tendsto_tailRatio_succ {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) (j : ℕ) :
    Tendsto (tailRatio p b (j + 1)) atTop (𝓝 0) := by
  have h := ((tendsto_quadraticFactor hp hdeg b).mul
    (tendsto_ratio_to_cubic_sq hp hdeg b
      (tendsto_scaled_higherFactor hp hdeg b (show 2 < j + 1 + 2 by omega)))).mul
    ((tendsto_localScale hp hdeg b).pow (j + 1))
  change Tendsto (fun L => tailRatio p b (j + 1) L) atTop _
  simpa [tailRatio] using h

theorem tailCoeff_eq_param_sq_mul_ratio {p : ℝ[X]} {b L : ℝ}
    (hH : quadraticFactor p b L ≠ 0) (hB : raisedRatio p b 1 L ≠ 0) (j : ℕ) :
    tailCoeff p b j L = cubicParam p b L ^ 2 * tailRatio p b j L := by
  unfold tailCoeff cubicParam tailRatio
  rw [pow_add]
  field_simp

def tailMass (p : ℝ[X]) (b : ℝ) (N : ℕ) (L : ℝ) : ℝ :=
  ∑ j ∈ Finset.range N, |tailRatio p b j L| * 2 ^ j

theorem tendsto_tailMass {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) (N : ℕ) :
    Tendsto (tailMass p b (N + 1)) atTop
      (𝓝 ((p.natDegree.choose 2 : ℝ) / (p.natDegree : ℝ) ^ 2)) := by
  have hz : Tendsto (fun L => ∑ j ∈ Finset.range N,
      |tailRatio p b (j + 1) L| * 2 ^ (j + 1)) atTop (𝓝 0) := by
    have h := tendsto_finsetSum (Finset.range N) (fun j _ =>
      ((tendsto_tailRatio_succ hp hdeg b j).abs).mul_const (2 ^ (j + 1)))
    simpa using h
  have h0 := (tendsto_tailRatio_zero hp hdeg b).abs
  have hc : 0 ≤ (p.natDegree.choose 2 : ℝ) / (p.natDegree : ℝ) ^ 2 := by positivity
  change Tendsto (fun L => tailMass p b (N + 1) L) atTop _
  simpa [tailMass, Finset.sum_range_succ', abs_of_nonneg hc] using hz.add h0

theorem quartic_limit_lt_one {n : ℕ} (hn : 0 < n) :
    (n.choose 2 : ℝ) / (n : ℝ) ^ 2 < 1 := by
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  rw [Nat.cast_choose_two]
  apply (div_lt_iff₀ (sq_pos_of_pos hn')).mpr
  nlinarith

/-- A fixed finite collection of normalized tail coefficients satisfies the
weighted estimate needed on the radius-two disk, for sufficiently large centres. -/
theorem eventually_tail_coeff_bound {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) {b : ℝ} (hb : 0 < b) (N : ℕ) :
    ∀ᶠ L : ℝ in atTop,
      (∑ j ∈ Finset.range (N + 1), |tailCoeff p b j L| * 2 ^ j) ≤
        1000 * cubicParam p b L ^ 2 := by
  have hc : (p.natDegree.choose 2 : ℝ) / (p.natDegree : ℝ) ^ 2 < 1000 :=
    (quartic_limit_lt_one (by omega : 0 < p.natDegree)).trans (by norm_num)
  filter_upwards [eventually_parameters_pos hp hdeg hb,
    (tendsto_tailMass hp hdeg b N).eventually_lt_const hc] with L hpos hmass
  have heq : (∑ j ∈ Finset.range (N + 1), |tailCoeff p b j L| * 2 ^ j) =
      cubicParam p b L ^ 2 * tailMass p b (N + 1) L := by
    unfold tailMass
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j hj
    rw [tailCoeff_eq_param_sq_mul_ratio hpos.2.2.1.ne' hpos.2.2.2.1.ne' j,
      abs_mul, abs_of_nonneg (sq_nonneg _)]
    ring
  rw [heq, mul_comm (1000 : ℝ)]
  exact mul_le_mul_of_nonneg_left hmass.le (sq_nonneg _)

/-- info: 'Erdos1047BalancedNormalization.eventually_parameters_pos' depends on axioms:
[propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms eventually_parameters_pos

/-- info: 'Erdos1047BalancedNormalization.eventually_tail_coeff_bound' depends on axioms:
[propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms eventually_tail_coeff_bound

end
end Erdos1047BalancedNormalization

end

/- Source: Erdos1047QuadraticCore.lean; SHA256: c87ee78a54d408ba949ae36faf0130278bc517495542e241e1709437dd375820 -/
section


/-!
# Degree two of Erdős Problem 1047

This module proves that every connected component of a positive-level monic quadratic
lemniscate satisfying the component-count hypothesis is convex.  The separable case is
reduced by an affine change of variable to the two lobes of a Cassini oval.
-/

open Polynomial

namespace Erdos1047Quadratic

noncomputable section

/-- The polynomial sublevel set, duplicated definitionally so this module needs only mathlib. -/
def sublevelSet (f : ℂ[X]) (c : ℝ) : Set ℂ :=
  {z : ℂ | ‖f.eval z‖ ≤ c}

/-- Connected components represented as subsets of `ℂ`. -/
def componentsIn (s : Set ℂ) : Set (Set ℂ) :=
  {t : Set ℂ | ∃ z ∈ s, t = connectedComponentIn s z}

theorem componentsIn_eq_singleton_of_isPreconnected {S : Set ℂ}
    (hS : IsPreconnected S) (hne : S.Nonempty) : componentsIn S = {S} := by
  ext t
  constructor
  · rintro ⟨z, hz, rfl⟩
    simpa using hS.connectedComponentIn hz
  · intro ht
    obtain ⟨z, hz⟩ := hne
    exact ⟨z, hz, (Set.mem_singleton_iff.mp ht).trans (hS.connectedComponentIn hz).symm⟩

/-- A continuous nonvanishing real function keeps its sign on a connected component. -/
theorem negative_on_component {S : Set ℂ} {r : ℂ} {φ : ℂ → ℝ}
    (hφ : Continuous φ) (hzero : ∀ z ∈ S, φ z ≠ 0) (hr : r ∈ S) (hneg : φ r < 0) :
    ∀ z ∈ connectedComponentIn S r, φ z < 0 := by
  intro z hz
  by_contra hnonneg
  obtain ⟨w, hw, hwzero⟩ :=
    isPreconnected_connectedComponentIn.intermediate_value
      (mem_connectedComponentIn hr) hz hφ.continuousOn
      (show (0 : ℝ) ∈ Set.Icc (φ r) (φ z) from ⟨hneg.le, le_of_not_gt hnonneg⟩)
  exact hzero w (connectedComponentIn_subset S r hw) hwzero

def centeredSublevel (q : ℂ) (c : ℝ) : Set ℂ :=
  {z | ‖z ^ 2 + q‖ ≤ c}

theorem centeredSublevel_starConvex (q : ℂ) (c : ℝ) (hq : ‖q‖ ≤ c) :
    StarConvex ℝ 0 (centeredSublevel q c) := by
  intro z hz a b ha hb hab
  change ‖(a • (0 : ℂ) + b • z) ^ 2 + q‖ ≤ c
  rw [smul_zero, zero_add]
  have hb1 : b ≤ 1 := by linarith
  have hb2 : 0 ≤ b ^ 2 := sq_nonneg b
  have hb2one : b ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg ha (sub_nonneg.mpr hb1)]
  have hid : (b • z) ^ 2 + q =
      (b ^ 2) • (z ^ 2 + q) + (1 - b ^ 2) • q := by
    simp only [Complex.real_smul]
    push_cast
    ring
  rw [hid]
  calc
    ‖(b ^ 2) • (z ^ 2 + q) + (1 - b ^ 2) • q‖ ≤
        ‖(b ^ 2) • (z ^ 2 + q)‖ + ‖(1 - b ^ 2) • q‖ := norm_add_le _ _
    _ = b ^ 2 * ‖z ^ 2 + q‖ + (1 - b ^ 2) * ‖q‖ := by
      rw [norm_smul, norm_smul]
      simp [abs_of_nonneg hb2, abs_of_nonneg (sub_nonneg.mpr hb2one)]
    _ ≤ b ^ 2 * c + (1 - b ^ 2) * c :=
      add_le_add (mul_le_mul_of_nonneg_left hz hb2)
        (mul_le_mul_of_nonneg_left hq (sub_nonneg.mpr hb2one))
    _ = c := by ring

theorem monic_quadratic_eq (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) :
    f = X ^ 2 + C (f.coeff 1) * X + C (f.coeff 0) := by
  conv_lhs =>
    rw [f.as_sum_range_C_mul_X_pow, hdeg, Finset.sum_range_succ, Finset.sum_range_succ,
      Finset.sum_range_one, ← hdeg, hf.coeff_natDegree, hdeg]
  simp only [C_1, mul_one]
  ring

def center (f : ℂ[X]) : ℂ := -(f.coeff 1) / 2

def criticalValue (f : ℂ[X]) : ℂ := f.coeff 0 - (f.coeff 1) ^ 2 / 4

theorem monic_quadratic_eval_center_add (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (z : ℂ) :
    f.eval (center f + z) = z ^ 2 + criticalValue f := by
  rw [monic_quadratic_eq f hf hdeg]
  simp [center, criticalValue]
  ring

theorem monic_quadratic_sublevel_eq (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) :
    sublevelSet f c = (fun z => center f + z) '' centeredSublevel (criticalValue f) c := by
  ext z
  constructor
  · intro hz
    change ‖f.eval z‖ ≤ c at hz
    refine ⟨z - center f, ?_, by ring⟩
    change ‖(z - center f) ^ 2 + criticalValue f‖ ≤ c
    rw [← monic_quadratic_eval_center_add f hf hdeg (z - center f)]
    simpa only [add_sub_cancel] using hz
  · rintro ⟨w, hw, rfl⟩
    change ‖w ^ 2 + criticalValue f‖ ≤ c at hw
    change ‖f.eval (center f + w)‖ ≤ c
    rw [monic_quadratic_eval_center_add f hf hdeg]
    exact hw

theorem monic_quadratic_sublevel_starConvex (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) (hc : ‖criticalValue f‖ ≤ c) :
    StarConvex ℝ (center f) (sublevelSet f c) := by
  rw [monic_quadratic_sublevel_eq f hf hdeg c]
  simpa using (centeredSublevel_starConvex (criticalValue f) c hc).add_left (center f)

theorem monic_quadratic_center_mem_sublevel (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) (hc : ‖criticalValue f‖ ≤ c) :
    center f ∈ sublevelSet f c := by
  change ‖f.eval (center f)‖ ≤ c
  have he := monic_quadratic_eval_center_add f hf hdeg 0
  have heval : f.eval (center f) = criticalValue f := by simpa using he
  rw [heval]
  exact hc

theorem monic_quadratic_sublevel_isPreconnected (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) (hc : ‖criticalValue f‖ ≤ c) :
    IsPreconnected (sublevelSet f c) :=
  (((monic_quadratic_sublevel_starConvex f hf hdeg c hc).isPathConnected
    (monic_quadratic_center_mem_sublevel f hf hdeg c hc)).isConnected).isPreconnected

theorem monic_quadratic_components_ncard_eq_one (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) (hc : ‖criticalValue f‖ ≤ c) :
    (componentsIn (sublevelSet f c)).ncard = 1 := by
  rw [componentsIn_eq_singleton_of_isPreconnected
    (monic_quadratic_sublevel_isPreconnected f hf hdeg c hc)
    ⟨center f, monic_quadratic_center_mem_sublevel f hf hdeg c hc⟩]
  simp

theorem monic_quadratic_derivative (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) :
    f.derivative = C 2 * X + C (f.coeff 1) := by
  rw [monic_quadratic_eq f hf hdeg]
  norm_num

theorem monic_quadratic_separable_iff (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) :
    f.Separable ↔ criticalValue f ≠ 0 := by
  rw [Polynomial.separable_def,
    Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed (k := ℂ) ℂ f f.derivative]
  change (∀ z : ℂ, f.eval z ≠ 0 ∨ f.derivative.eval z ≠ 0) ↔ criticalValue f ≠ 0
  constructor
  · intro hsep hq
    have heval := monic_quadratic_eval_center_add f hf hdeg 0
    have hroot : f.eval (center f) = 0 := by simpa [hq] using heval
    have hder : f.derivative.eval (center f) = 0 := by
      rw [monic_quadratic_derivative f hf hdeg]
      simp [center]
      ring
    exact (hsep (center f)).elim (fun hn => hn hroot) (fun hn => hn hder)
  · intro hq z
    by_cases hd : f.derivative.eval z = 0
    · left
      have hz : z = center f := by
        rw [monic_quadratic_derivative f hf hdeg] at hd
        simp [center] at hd ⊢
        linear_combination (1 / 2 : ℂ) * hd
      subst z
      have heval := monic_quadratic_eval_center_add f hf hdeg 0
      simpa using (show f.eval (center f) = criticalValue f by simpa using heval).trans_ne hq
    · exact Or.inr hd

theorem monic_quadratic_rootSet_ncard_eq_two (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (hq : criticalValue f ≠ 0) :
    (f.rootSet ℂ).ncard = 2 := by
  have hsep : f.Separable := (monic_quadratic_separable_iff f hf hdeg).mpr hq
  have hcard : Fintype.card (f.rootSet ℂ) = f.natDegree :=
    Polynomial.card_rootSet_eq_natDegree hsep (IsAlgClosed.splits _)
  simpa [hdeg] using hcard

theorem monic_quadratic_criticalValue_norm_gt_of_component_count (f : ℂ[X])
    (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ)
    (hcount : (componentsIn (sublevelSet f c)).ncard = (f.rootSet ℂ).ncard)
    (hq : criticalValue f ≠ 0) :
    c < ‖criticalValue f‖ := by
  by_contra h
  have hc : ‖criticalValue f‖ ≤ c := le_of_not_gt h
  have hcomponents := monic_quadratic_components_ncard_eq_one f hf hdeg c hc
  have hroots := monic_quadratic_rootSet_ncard_eq_two f hf hdeg hq
  omega

theorem monic_quadratic_sublevel_eq_closedBall_of_criticalValue_eq_zero
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ) (hc : 0 ≤ c)
    (hq : criticalValue f = 0) :
    sublevelSet f c = Metric.closedBall (center f) (Real.sqrt c) := by
  ext z
  have heval : f.eval z = (z - center f) ^ 2 := by
    have he := monic_quadratic_eval_center_add f hf hdeg (z - center f)
    simpa [hq] using he
  rw [sublevelSet, Set.mem_setOf_eq, heval, norm_pow, Metric.mem_closedBall, dist_eq_norm]
  rw [← sq_le_sq₀ (norm_nonneg _) (Real.sqrt_nonneg c), Real.sq_sqrt hc]

theorem monic_quadratic_sublevel_convex_of_criticalValue_eq_zero
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 2) (c : ℝ) (hc : 0 ≤ c)
    (hq : criticalValue f = 0) :
    Convex ℝ (sublevelSet f c) := by
  rw [monic_quadratic_sublevel_eq_closedBall_of_criticalValue_eq_zero f hf hdeg c hc hq]
  exact convex_closedBall _ _

def cassiniDelta (ρ y : ℝ) : ℝ := Real.sqrt (ρ ^ 2 - 4 * y ^ 2)

def cassiniLower (ρ y : ℝ) : ℝ := Real.sqrt (1 - y ^ 2 - cassiniDelta ρ y)

def cassiniUpper (ρ y : ℝ) : ℝ := Real.sqrt (1 - y ^ 2 + cassiniDelta ρ y)

def cassiniLowerDeriv (ρ y : ℝ) : ℝ :=
  y * (2 - cassiniDelta ρ y) / (cassiniLower ρ y * cassiniDelta ρ y)

def cassiniLowerSecond (ρ y : ℝ) : ℝ :=
  ρ ^ 2 * (ρ ^ 2 - 6 * y ^ 2 - 3 * cassiniDelta ρ y + 2) /
    (cassiniLower ρ y ^ 3 * cassiniDelta ρ y ^ 3)

theorem cassini_radicand_pos {ρ y : ℝ} (hρ : 0 < ρ) (hy : y ∈ Set.Ioo (-ρ / 2) (ρ / 2)) :
    0 < ρ ^ 2 - 4 * y ^ 2 := by
  have hp : 0 < (ρ / 2 - y) * (ρ / 2 + y) :=
    mul_pos (by linarith [hy.2]) (by linarith [hy.1])
  nlinarith

theorem cassiniDelta_pos {ρ y : ℝ} (hρ : 0 < ρ) (hy : y ∈ Set.Ioo (-ρ / 2) (ρ / 2)) :
    0 < cassiniDelta ρ y := by
  rw [cassiniDelta, Real.sqrt_pos]
  exact cassini_radicand_pos hρ hy

theorem cassini_lower_radicand_pos {ρ y : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hy : y ∈ Set.Ioo (-ρ / 2) (ρ / 2)) :
    0 < 1 - y ^ 2 - cassiniDelta ρ y := by
  have hrad := cassini_radicand_pos hρ hy
  have hdsq : (cassiniDelta ρ y) ^ 2 = ρ ^ 2 - 4 * y ^ 2 := by
    rw [cassiniDelta, Real.sq_sqrt hrad.le]
  have hd0 : 0 ≤ cassiniDelta ρ y := Real.sqrt_nonneg _
  have hyabs : |y| < ρ / 2 := (abs_lt).2 ⟨by linarith [hy.1], hy.2⟩
  have hy2 : y ^ 2 < 1 := by
    have hρhalf : ρ / 2 < 1 := by linarith
    nlinarith [sq_abs y, sq_nonneg y, sq_nonneg (ρ / 2 - |y|)]
  have hone : 0 ≤ 1 - y ^ 2 := by linarith
  have hprod : 0 < (1 + y ^ 2 - ρ) * (1 + y ^ 2 + ρ) := by
    apply mul_pos <;> nlinarith [sq_nonneg y]
  have hsq : (cassiniDelta ρ y) ^ 2 < (1 - y ^ 2) ^ 2 := by
    rw [hdsq]
    nlinarith
  exact sub_pos.mpr ((sq_lt_sq₀ hd0 hone).mp hsq)

theorem cassiniLower_pos {ρ y : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hy : y ∈ Set.Ioo (-ρ / 2) (ρ / 2)) :
    0 < cassiniLower ρ y := by
  rw [cassiniLower, Real.sqrt_pos]
  exact cassini_lower_radicand_pos hρ hρ1 hy

theorem hasDerivAt_cassiniDelta {ρ y : ℝ} (hρ : 0 < ρ)
    (hy : y ∈ Set.Ioo (-ρ / 2) (ρ / 2)) :
    HasDerivAt (cassiniDelta ρ) (-4 * y / cassiniDelta ρ y) y := by
  have hinner : HasDerivAt (fun x : ℝ => ρ ^ 2 - 4 * x ^ 2) (-8 * y) y := by
    have hraw : HasDerivAt (fun x : ℝ => ρ ^ 2 - 4 * x ^ 2)
        (-(4 * (2 * y ^ (2 - 1)))) y := by
      simpa only [Pi.pow_apply, id_eq, Nat.cast_ofNat, mul_one] using
        (((hasDerivAt_id y).pow 2).const_mul 4).const_sub (ρ ^ 2)
    convert hraw using 1 <;> norm_num <;> ring
  have hne : ρ ^ 2 - 4 * y ^ 2 ≠ 0 := (cassini_radicand_pos hρ hy).ne'
  convert hinner.sqrt hne using 1
  · rfl
  · rw [cassiniDelta]
    field_simp
    ring

theorem hasDerivAt_cassiniLower {ρ y : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hy : y ∈ Set.Ioo (-ρ / 2) (ρ / 2)) :
    HasDerivAt (cassiniLower ρ)
      (y * (2 - cassiniDelta ρ y) / (cassiniLower ρ y * cassiniDelta ρ y)) y := by
  have hd := hasDerivAt_cassiniDelta hρ hy
  have hg : HasDerivAt (fun x : ℝ => 1 - x ^ 2 - cassiniDelta ρ x)
      (-2 * y + 4 * y / cassiniDelta ρ y) y := by
    have hraw := (((hasDerivAt_id y).pow 2).const_sub 1).sub hd
    have hfun : (fun x : ℝ => 1 - x ^ 2 - cassiniDelta ρ x) =ᶠ[nhds y]
        ((fun x : ℝ => 1 - x ^ 2) - cassiniDelta ρ) :=
      Filter.Eventually.of_forall (fun x => by rfl)
    have hsame := hraw.congr_of_eventuallyEq hfun
    apply hsame.congr_deriv
    norm_num
    ring
  have hgne : 1 - y ^ 2 - cassiniDelta ρ y ≠ 0 :=
    (cassini_lower_radicand_pos hρ hρ1 hy).ne'
  convert hg.sqrt hgne using 1
  · rfl
  · rw [cassiniLower]
    have hdne := (cassiniDelta_pos hρ hy).ne'
    field_simp
    ring

theorem hasDerivAt_cassiniLowerDeriv {ρ y : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hy : y ∈ Set.Ioo (-ρ / 2) (ρ / 2)) :
    HasDerivAt (cassiniLowerDeriv ρ) (cassiniLowerSecond ρ y) y := by
  have hd := hasDerivAt_cassiniDelta hρ hy
  have hL := hasDerivAt_cassiniLower hρ hρ1 hy
  have hdne := (cassiniDelta_pos hρ hy).ne'
  have hLne := (cassiniLower_pos hρ hρ1 hy).ne'
  have hnum := (hasDerivAt_id y).mul (hd.const_sub 2)
  have hden := hL.mul hd
  have hraw := hnum.div hden (mul_ne_zero hLne hdne)
  have hfun : cassiniLowerDeriv ρ =ᶠ[nhds y]
      ((fun x : ℝ => x) * (fun x => 2 - cassiniDelta ρ x) /
        (cassiniLower ρ * cassiniDelta ρ)) :=
    Filter.Eventually.of_forall (fun x => by rfl)
  have hsame := hraw.congr_of_eventuallyEq hfun
  apply hsame.congr_deriv
  have hdsq : cassiniDelta ρ y ^ 2 = ρ ^ 2 - 4 * y ^ 2 := by
    rw [cassiniDelta, Real.sq_sqrt (cassini_radicand_pos hρ hy).le]
  have hLsq : cassiniLower ρ y ^ 2 = 1 - y ^ 2 - cassiniDelta ρ y := by
    rw [cassiniLower, Real.sq_sqrt (cassini_lower_radicand_pos hρ hρ1 hy).le]
  dsimp [cassiniLowerSecond]
  field_simp
  rw [hLsq]
  linear_combination
    (cassiniDelta ρ y ^ 2 - 3 * cassiniDelta ρ y + ρ ^ 2 - 2 * y ^ 2 + 2) * hdsq

theorem cassiniLowerSecond_pos {ρ y : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hy : y ∈ Set.Ioo (-ρ / 2) (ρ / 2)) :
    0 < cassiniLowerSecond ρ y := by
  have hrad := cassini_radicand_pos hρ hy
  have hdsq : cassiniDelta ρ y ^ 2 = ρ ^ 2 - 4 * y ^ 2 := by
    rw [cassiniDelta, Real.sq_sqrt hrad.le]
  have hd0 : 0 ≤ cassiniDelta ρ y := Real.sqrt_nonneg _
  have hdle : cassiniDelta ρ y ≤ ρ := by
    apply (sq_le_sq₀ hd0 hρ.le).mp
    rw [hdsq]
    nlinarith [sq_nonneg y]
  have hdiff : 0 ≤ ρ - cassiniDelta ρ y := sub_nonneg.mpr hdle
  have hsum : ρ + cassiniDelta ρ y ≤ 2 := by linarith
  have hprod : (ρ - cassiniDelta ρ y) * (ρ + cassiniDelta ρ y) = 4 * y ^ 2 := by
    nlinarith [hdsq]
  have haux : 2 * y ^ 2 ≤ ρ - cassiniDelta ρ y := by
    have hmul := mul_le_mul_of_nonneg_left hsum hdiff
    nlinarith
  have hbase : 0 < (1 - ρ) * (2 - ρ) := mul_pos (by linarith) (by linarith)
  have hnum : 0 < ρ ^ 2 - 6 * y ^ 2 - 3 * cassiniDelta ρ y + 2 := by
    nlinarith
  have hden : 0 < cassiniLower ρ y ^ 3 * cassiniDelta ρ y ^ 3 :=
    mul_pos (pow_pos (cassiniLower_pos hρ hρ1 hy) 3)
      (pow_pos (cassiniDelta_pos hρ hy) 3)
  dsimp [cassiniLowerSecond]
  exact div_pos (mul_pos (sq_pos_of_pos hρ) hnum) hden

theorem cassiniLower_convexOn {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ConvexOn ℝ (Set.Icc (-ρ / 2) (ρ / 2)) (cassiniLower ρ) := by
  let D : Set ℝ := Set.Icc (-ρ / 2) (ρ / 2)
  have hD : Convex ℝ D := convex_Icc _ _
  have hinterior : interior D = Set.Ioo (-ρ / 2) (ρ / 2) := by
    exact interior_Icc
  apply convexOn_of_hasDerivWithinAt2_nonneg hD
  · change ContinuousOn
      (fun y => Real.sqrt (1 - y ^ 2 - Real.sqrt (ρ ^ 2 - 4 * y ^ 2))) D
    exact (by fun_prop : Continuous
      (fun y => Real.sqrt (1 - y ^ 2 - Real.sqrt (ρ ^ 2 - 4 * y ^ 2)))).continuousOn
  · intro y hy
    rw [hinterior] at hy
    exact (hasDerivAt_cassiniLower hρ hρ1 hy).hasDerivWithinAt
  · intro y hy
    rw [hinterior] at hy
    exact (hasDerivAt_cassiniLowerDeriv hρ hρ1 hy).hasDerivWithinAt
  · intro y hy
    rw [hinterior] at hy
    exact (cassiniLowerSecond_pos hρ hρ1 hy).le

theorem concaveOn_sqrt_comp {D : Set ℝ} {f : ℝ → ℝ}
    (hf : ConcaveOn ℝ D f) (h0 : ∀ x ∈ D, 0 ≤ f x) :
    ConcaveOn ℝ D (fun x => Real.sqrt (f x)) := by
  refine ⟨hf.1, ?_⟩
  intro x hx y hy a b ha hb hab
  have hconcave := hf.2 hx hy ha hb hab
  have hsqrt := Real.strictConcaveOn_sqrt.concaveOn.2 (h0 x hx) (h0 y hy) ha hb hab
  exact hsqrt.trans (Real.sqrt_le_sqrt hconcave)

theorem cassiniRadicand_nonneg {ρ y : ℝ} (hρ : 0 ≤ ρ)
    (hy : y ∈ Set.Icc (-ρ / 2) (ρ / 2)) :
    0 ≤ ρ ^ 2 - 4 * y ^ 2 := by
  have hp : 0 ≤ (ρ / 2 - y) * (ρ / 2 + y) :=
    mul_nonneg (by linarith [hy.2]) (by linarith [hy.1])
  nlinarith

theorem cassiniRadicand_concaveOn (ρ : ℝ) :
    ConcaveOn ℝ (Set.Icc (-ρ / 2) (ρ / 2)) (fun y => ρ ^ 2 - 4 * y ^ 2) := by
  refine ⟨convex_Icc _ _, ?_⟩
  intro x hx y hy a b ha hb hab
  simp only [smul_eq_mul]
  have hgap : 0 ≤ 4 * (a * b) * (x - y) ^ 2 :=
    mul_nonneg (mul_nonneg (by positivity) (mul_nonneg ha hb)) (sq_nonneg _)
  have hid : ρ ^ 2 - 4 * (a * x + b * y) ^ 2 =
      a * (ρ ^ 2 - 4 * x ^ 2) + b * (ρ ^ 2 - 4 * y ^ 2) +
        4 * (a * b) * (x - y) ^ 2 := by
    have hbval : b = 1 - a := by linarith
    rw [hbval]
    ring
  rw [hid]
  exact le_add_of_nonneg_right hgap

theorem cassiniDelta_concaveOn {ρ : ℝ} (hρ : 0 ≤ ρ) :
    ConcaveOn ℝ (Set.Icc (-ρ / 2) (ρ / 2)) (cassiniDelta ρ) := by
  change ConcaveOn ℝ (Set.Icc (-ρ / 2) (ρ / 2))
    (fun y => Real.sqrt (ρ ^ 2 - 4 * y ^ 2))
  exact concaveOn_sqrt_comp (cassiniRadicand_concaveOn ρ)
    (fun x hx => cassiniRadicand_nonneg hρ hx)

theorem cassiniUpperRadicand_concaveOn {ρ : ℝ} (hρ : 0 ≤ ρ) :
    ConcaveOn ℝ (Set.Icc (-ρ / 2) (ρ / 2))
      (fun y => 1 - y ^ 2 + cassiniDelta ρ y) := by
  refine ⟨convex_Icc _ _, ?_⟩
  intro x hx y hy a b ha hb hab
  have hd := (cassiniDelta_concaveOn hρ).2 hx hy ha hb hab
  simp only [smul_eq_mul] at hd ⊢
  have hgap : 0 ≤ (a * b) * (x - y) ^ 2 :=
    mul_nonneg (mul_nonneg ha hb) (sq_nonneg _)
  have hbase : a * (1 - x ^ 2) + b * (1 - y ^ 2) ≤
      1 - (a * x + b * y) ^ 2 := by
    have hid : 1 - (a * x + b * y) ^ 2 =
        a * (1 - x ^ 2) + b * (1 - y ^ 2) + (a * b) * (x - y) ^ 2 := by
      have hbval : b = 1 - a := by linarith
      rw [hbval]
      ring
    rw [hid]
    exact le_add_of_nonneg_right hgap
  nlinarith

theorem cassiniUpperRadicand_nonneg {ρ y : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (hy : y ∈ Set.Icc (-ρ / 2) (ρ / 2)) :
    0 ≤ 1 - y ^ 2 + cassiniDelta ρ y := by
  have hrad := cassiniRadicand_nonneg hρ hy
  have hy2 : y ^ 2 ≤ 1 := by
    have habs : |y| ≤ ρ / 2 := (abs_le).2 ⟨by linarith [hy.1], hy.2⟩
    nlinarith [sq_abs y, sq_nonneg (ρ / 2 - |y|)]
  exact add_nonneg (sub_nonneg.mpr hy2) (Real.sqrt_nonneg _)

theorem cassiniUpper_concaveOn {ρ : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ ≤ 1) :
    ConcaveOn ℝ (Set.Icc (-ρ / 2) (ρ / 2)) (cassiniUpper ρ) := by
  change ConcaveOn ℝ (Set.Icc (-ρ / 2) (ρ / 2))
    (fun y => Real.sqrt (1 - y ^ 2 + cassiniDelta ρ y))
  exact concaveOn_sqrt_comp (cassiniUpperRadicand_concaveOn hρ)
    (fun x hx => cassiniUpperRadicand_nonneg hρ hρ1 hx)

def cassiniBand (ρ : ℝ) : Set ℂ :=
  {z | z.im ∈ Set.Icc (-ρ / 2) (ρ / 2) ∧
    cassiniLower ρ z.im ≤ z.re ∧ z.re ≤ cassiniUpper ρ z.im}

theorem cassiniBand_convex {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    Convex ℝ (cassiniBand ρ) := by
  intro z hz w hw a b ha hb hab
  have him : (a • z + b • w).im = a * z.im + b * w.im := by simp
  have hre : (a • z + b • w).re = a * z.re + b * w.re := by simp
  have hD : a * z.im + b * w.im ∈ Set.Icc (-ρ / 2) (ρ / 2) := by
    simpa only [smul_eq_mul] using
      (convex_Icc (-ρ / 2) (ρ / 2)) hz.1 hw.1 ha hb hab
  have hlower := (cassiniLower_convexOn hρ hρ1).2 hz.1 hw.1 ha hb hab
  have hupper := (cassiniUpper_concaveOn hρ.le hρ1.le).2 hz.1 hw.1 ha hb hab
  simp only [smul_eq_mul] at hlower hupper
  change (a • z + b • w).im ∈ Set.Icc (-ρ / 2) (ρ / 2) ∧
    cassiniLower ρ (a • z + b • w).im ≤ (a • z + b • w).re ∧
    (a • z + b • w).re ≤ cassiniUpper ρ (a • z + b • w).im
  rw [him, hre]
  refine ⟨hD, ?_, ?_⟩
  · exact hlower.trans (add_le_add
      (mul_le_mul_of_nonneg_left hz.2.1 ha)
      (mul_le_mul_of_nonneg_left hw.2.1 hb))
  · exact (add_le_add
      (mul_le_mul_of_nonneg_left hz.2.2 ha)
      (mul_le_mul_of_nonneg_left hw.2.2 hb)).trans hupper

def cassiniRightSublevel (ρ : ℝ) : Set ℂ :=
  {z | ‖z ^ 2 - 1‖ ≤ ρ ∧ 0 ≤ z.re}

theorem cassini_normSq_sub_one (z : ℂ) :
    Complex.normSq (z ^ 2 - 1) =
      (z.re ^ 2 + z.im ^ 2 - 1) ^ 2 + 4 * z.im ^ 2 := by
  norm_num [Complex.normSq, pow_succ, Complex.mul_re, Complex.mul_im]
  ring

theorem cassini_norm_le_iff_normSq_le {ρ : ℝ} (hρ : 0 ≤ ρ) (z : ℂ) :
    ‖z ^ 2 - 1‖ ≤ ρ ↔ Complex.normSq (z ^ 2 - 1) ≤ ρ ^ 2 := by
  rw [Complex.normSq_eq_norm_sq, sq_le_sq₀ (norm_nonneg _) hρ]

theorem cassini_lower_radicand_nonneg {ρ y : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (hy : y ∈ Set.Icc (-ρ / 2) (ρ / 2)) :
    0 ≤ 1 - y ^ 2 - cassiniDelta ρ y := by
  have hrad := cassiniRadicand_nonneg hρ hy
  have hdsq : cassiniDelta ρ y ^ 2 = ρ ^ 2 - 4 * y ^ 2 := by
    rw [cassiniDelta, Real.sq_sqrt hrad]
  have hd0 : 0 ≤ cassiniDelta ρ y := Real.sqrt_nonneg _
  have hyabs : |y| ≤ ρ / 2 := (abs_le).2 ⟨by linarith [hy.1], hy.2⟩
  have hy2 : y ^ 2 ≤ 1 := by
    nlinarith [sq_abs y, sq_nonneg (ρ / 2 - |y|)]
  have hone : 0 ≤ 1 - y ^ 2 := by linarith
  have hprod : 0 ≤ (1 + y ^ 2 - ρ) * (1 + y ^ 2 + ρ) := by
    apply mul_nonneg <;> nlinarith [sq_nonneg y]
  have hsq : cassiniDelta ρ y ^ 2 ≤ (1 - y ^ 2) ^ 2 := by
    rw [hdsq]
    nlinarith
  exact sub_nonneg.mpr ((sq_le_sq₀ hd0 hone).mp hsq)

theorem cassiniLower_sq {ρ y : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (hy : y ∈ Set.Icc (-ρ / 2) (ρ / 2)) :
    cassiniLower ρ y ^ 2 = 1 - y ^ 2 - cassiniDelta ρ y := by
  rw [cassiniLower, Real.sq_sqrt (cassini_lower_radicand_nonneg hρ hρ1 hy)]

theorem cassiniUpper_sq {ρ y : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (hy : y ∈ Set.Icc (-ρ / 2) (ρ / 2)) :
    cassiniUpper ρ y ^ 2 = 1 - y ^ 2 + cassiniDelta ρ y := by
  rw [cassiniUpper, Real.sq_sqrt (cassiniUpperRadicand_nonneg hρ hρ1 hy)]

theorem cassiniRightSublevel_eq_band {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    cassiniRightSublevel ρ = cassiniBand ρ := by
  ext z
  constructor
  · rintro ⟨hnorm, hx⟩
    have hnormSq : (z.re ^ 2 + z.im ^ 2 - 1) ^ 2 + 4 * z.im ^ 2 ≤ ρ ^ 2 := by
      rw [← cassini_normSq_sub_one]
      exact (cassini_norm_le_iff_normSq_le hρ.le z).mp hnorm
    have hySq : z.im ^ 2 ≤ (ρ / 2) ^ 2 := by
      nlinarith [sq_nonneg (z.re ^ 2 + z.im ^ 2 - 1)]
    have hyAbs : |z.im| ≤ ρ / 2 := by
      apply (sq_le_sq₀ (abs_nonneg _) (by linarith)).mp
      simpa only [sq_abs] using hySq
    have hy : z.im ∈ Set.Icc (-ρ / 2) (ρ / 2) := by
      constructor <;> linarith [(abs_le.mp hyAbs).1, (abs_le.mp hyAbs).2]
    have hdsq := Real.sq_sqrt (cassiniRadicand_nonneg hρ.le hy)
    have hdeltaSq : cassiniDelta ρ z.im ^ 2 = ρ ^ 2 - 4 * z.im ^ 2 := by
      simpa only [cassiniDelta] using hdsq
    have hsSq : (z.re ^ 2 + z.im ^ 2 - 1) ^ 2 ≤ cassiniDelta ρ z.im ^ 2 := by
      nlinarith
    have hd0 : 0 ≤ cassiniDelta ρ z.im := by
      rw [cassiniDelta]
      exact Real.sqrt_nonneg _
    have hsAbs : |z.re ^ 2 + z.im ^ 2 - 1| ≤ cassiniDelta ρ z.im := by
      apply (sq_le_sq₀ (abs_nonneg _) hd0).mp
      simpa only [sq_abs] using hsSq
    have hs := abs_le.mp hsAbs
    have hLsq := cassiniLower_sq hρ.le hρ1.le hy
    have hUsq := cassiniUpper_sq hρ.le hρ1.le hy
    have hL0 : 0 ≤ cassiniLower ρ z.im := by
      rw [cassiniLower]
      exact Real.sqrt_nonneg _
    have hU0 : 0 ≤ cassiniUpper ρ z.im := by
      rw [cassiniUpper]
      exact Real.sqrt_nonneg _
    have hL : cassiniLower ρ z.im ≤ z.re := by
      apply (sq_le_sq₀ hL0 hx).mp
      rw [hLsq]
      nlinarith [hs.1]
    have hU : z.re ≤ cassiniUpper ρ z.im := by
      apply (sq_le_sq₀ hx hU0).mp
      rw [hUsq]
      nlinarith [hs.2]
    exact ⟨hy, hL, hU⟩
  · rintro ⟨hy, hL, hU⟩
    have hL0 : 0 ≤ cassiniLower ρ z.im := by
      rw [cassiniLower]
      exact Real.sqrt_nonneg _
    have hU0 : 0 ≤ cassiniUpper ρ z.im := by
      rw [cassiniUpper]
      exact Real.sqrt_nonneg _
    have hx : 0 ≤ z.re := hL0.trans hL
    have hLsq := cassiniLower_sq hρ.le hρ1.le hy
    have hUsq := cassiniUpper_sq hρ.le hρ1.le hy
    have hsLower : -cassiniDelta ρ z.im ≤ z.re ^ 2 + z.im ^ 2 - 1 := by
      have := (sq_le_sq₀ hL0 hx).mpr hL
      rw [hLsq] at this
      nlinarith
    have hsUpper : z.re ^ 2 + z.im ^ 2 - 1 ≤ cassiniDelta ρ z.im := by
      have := (sq_le_sq₀ hx hU0).mpr hU
      rw [hUsq] at this
      nlinarith
    have hsSq : (z.re ^ 2 + z.im ^ 2 - 1) ^ 2 ≤ cassiniDelta ρ z.im ^ 2 :=
      sq_le_sq' hsLower hsUpper
    have hdeltaSq : cassiniDelta ρ z.im ^ 2 = ρ ^ 2 - 4 * z.im ^ 2 := by
      rw [cassiniDelta, Real.sq_sqrt (cassiniRadicand_nonneg hρ.le hy)]
    refine ⟨(cassini_norm_le_iff_normSq_le hρ.le z).mpr ?_, hx⟩
    rw [cassini_normSq_sub_one]
    nlinarith

theorem cassiniRightSublevel_convex {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    Convex ℝ (cassiniRightSublevel ρ) := by
  rw [cassiniRightSublevel_eq_band hρ hρ1]
  exact cassiniBand_convex hρ hρ1

def cassiniLeftSublevel (ρ : ℝ) : Set ℂ :=
  {z | ‖z ^ 2 - 1‖ ≤ ρ ∧ z.re ≤ 0}

theorem cassiniLeftSublevel_eq_neg_right (ρ : ℝ) :
    cassiniLeftSublevel ρ = -(cassiniRightSublevel ρ) := by
  ext z
  constructor
  · rintro ⟨hz, hre⟩
    rw [Set.mem_neg]
    refine ⟨?_, ?_⟩
    · simpa only [neg_sq, neg_sub, norm_neg] using hz
    · simpa using hre
  · intro hz
    rw [Set.mem_neg] at hz
    rcases hz with ⟨hnorm, hre⟩
    refine ⟨?_, ?_⟩
    · simpa only [neg_sq, neg_sub, norm_neg] using hnorm
    · simpa using hre

theorem cassiniLeftSublevel_convex {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    Convex ℝ (cassiniLeftSublevel ρ) := by
  rw [cassiniLeftSublevel_eq_neg_right]
  exact (cassiniRightSublevel_convex hρ hρ1).neg

def cassiniSublevel (ρ : ℝ) : Set ℂ := {z | ‖z ^ 2 - 1‖ ≤ ρ}

theorem cassini_re_ne_zero {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    {z : ℂ} (hz : z ∈ cassiniSublevel ρ) : z.re ≠ 0 := by
  intro hre
  have hnormSq : Complex.normSq (z ^ 2 - 1) ≤ ρ ^ 2 :=
    (cassini_norm_le_iff_normSq_le hρ.le z).mp hz
  rw [cassini_normSq_sub_one] at hnormSq
  have hρsq : ρ ^ 2 < 1 := by nlinarith
  rw [hre] at hnormSq
  norm_num at hnormSq
  nlinarith [sq_nonneg (z.im ^ 2)]

/-- Every component of a strict two-lobed normalized quadratic sublevel set is one of
the two convex Cassini lobes. -/
theorem cassini_component_convex {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    {z : ℂ} (hz : z ∈ cassiniSublevel ρ) :
    Convex ℝ (connectedComponentIn (cassiniSublevel ρ) z) := by
  rcases lt_or_gt_of_ne (cassini_re_ne_zero hρ hρ1 hz) with hzneg | hzpos
  · have hzleft : z ∈ cassiniLeftSublevel ρ := ⟨hz, hzneg.le⟩
    have hstay : ∀ w ∈ connectedComponentIn (cassiniSublevel ρ) z, w.re < 0 := by
      apply negative_on_component (φ := fun w : ℂ => w.re) (by fun_prop) _ hz hzneg
      intro w hw
      exact cassini_re_ne_zero hρ hρ1 hw
    have heq : connectedComponentIn (cassiniSublevel ρ) z = cassiniLeftSublevel ρ := by
      apply Set.Subset.antisymm
      · intro w hw
        have hwS : w ∈ cassiniSublevel ρ :=
          connectedComponentIn_subset (cassiniSublevel ρ) z hw
        exact ⟨hwS, (hstay w hw).le⟩
      · exact (cassiniLeftSublevel_convex hρ hρ1).isPreconnected.subset_connectedComponentIn
          hzleft (fun w hw => hw.1)
    rw [heq]
    exact cassiniLeftSublevel_convex hρ hρ1
  · have hzright : z ∈ cassiniRightSublevel ρ := ⟨hz, hzpos.le⟩
    have hstay : ∀ w ∈ connectedComponentIn (cassiniSublevel ρ) z, 0 < w.re := by
      have h := negative_on_component
        (S := cassiniSublevel ρ) (r := z) (φ := fun w : ℂ => -w.re)
        (by fun_prop) (fun w hw hzero => cassini_re_ne_zero hρ hρ1 hw (by linarith))
        hz (by linarith)
      intro w hw
      linarith [h w hw]
    have heq : connectedComponentIn (cassiniSublevel ρ) z = cassiniRightSublevel ρ := by
      apply Set.Subset.antisymm
      · intro w hw
        have hwS : w ∈ cassiniSublevel ρ :=
          connectedComponentIn_subset (cassiniSublevel ρ) z hw
        exact ⟨hwS, (hstay w hw).le⟩
      · exact (cassiniRightSublevel_convex hρ hρ1).isPreconnected.subset_connectedComponentIn
          hzright (fun w hw => hw.1)
    rw [heq]
    exact cassiniRightSublevel_convex hρ hρ1

theorem cassini_components_convex {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ∀ t ∈ componentsIn (cassiniSublevel ρ), Convex ℝ t := by
  rintro _ ⟨z, hz, rfl⟩
  exact cassini_component_convex hρ hρ1 hz

def complexAffineImage (h d : ℂ) (S : Set ℂ) : Set ℂ :=
  (fun w => h + d * w) '' S

theorem complexAffineImage_convex {h d : ℂ} {S : Set ℂ} (hS : Convex ℝ S) :
    Convex ℝ (complexAffineImage h d S) := by
  rintro _ ⟨z, hz, rfl⟩ _ ⟨w, hw, rfl⟩ a b ha hb hab
  refine ⟨a • z + b • w, hS hz hw ha hb hab, ?_⟩
  simp only [Complex.real_smul]
  push_cast
  apply Complex.ext <;> norm_num [Complex.mul_re, Complex.mul_im]
  all_goals have hbval : b = 1 - a := by linarith
  all_goals rw [hbval]
  all_goals ring

theorem affineCoordinate_apply {h d w : ℂ} (hd : d ≠ 0) :
    (h + d * w - h) / d = w := by
  field_simp
  ring

theorem affineCassini_components_convex {h d : ℂ} (hd : d ≠ 0)
    {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ∀ t ∈ componentsIn (complexAffineImage h d (cassiniSublevel ρ)), Convex ℝ t := by
  rintro _ ⟨z, hz, rfl⟩
  obtain ⟨w, hw, rfl⟩ := hz
  have hwne : w.re ≠ 0 := cassini_re_ne_zero hρ hρ1 hw
  let φ : ℂ → ℝ := fun z => ((z - h) / d).re
  have hφ : Continuous φ := by
    dsimp [φ]
    fun_prop
  have hφzero : ∀ z ∈ complexAffineImage h d (cassiniSublevel ρ), φ z ≠ 0 := by
    rintro _ ⟨u, hu, rfl⟩
    have hcoord := affineCoordinate_apply (h := h) (d := d) (w := u) hd
    dsimp [φ]
    rw [hcoord]
    exact cassini_re_ne_zero hρ hρ1 hu
  rcases lt_or_gt_of_ne hwne with hwneg | hwpos
  · let L := complexAffineImage h d (cassiniLeftSublevel ρ)
    have hanchor : h + d * w ∈ L := ⟨w, ⟨hw, hwneg.le⟩, rfl⟩
    have hLconv : Convex ℝ L := complexAffineImage_convex
      (cassiniLeftSublevel_convex hρ hρ1)
    have hLsub : L ⊆ complexAffineImage h d (cassiniSublevel ρ) := by
      rintro _ ⟨u, hu, rfl⟩
      exact ⟨u, hu.1, rfl⟩
    have hstart : φ (h + d * w) < 0 := by
      dsimp [φ]
      rw [affineCoordinate_apply hd]
      exact hwneg
    have hstay := negative_on_component hφ hφzero
      ⟨w, hw, rfl⟩ hstart
    have heq : connectedComponentIn (complexAffineImage h d (cassiniSublevel ρ))
        (h + d * w) = L := by
      apply Set.Subset.antisymm
      · intro z hzC
        have hzS := connectedComponentIn_subset _ _ hzC
        obtain ⟨u, hu, rfl⟩ := hzS
        refine ⟨u, ⟨hu, ?_⟩, rfl⟩
        have huφ := hstay (h + d * u) hzC
        dsimp [φ] at huφ
        rw [affineCoordinate_apply hd] at huφ
        exact huφ.le
      · exact hLconv.isPreconnected.subset_connectedComponentIn hanchor hLsub
    rw [heq]
    exact hLconv
  · let R := complexAffineImage h d (cassiniRightSublevel ρ)
    have hanchor : h + d * w ∈ R := ⟨w, ⟨hw, hwpos.le⟩, rfl⟩
    have hRconv : Convex ℝ R := complexAffineImage_convex
      (cassiniRightSublevel_convex hρ hρ1)
    have hRsub : R ⊆ complexAffineImage h d (cassiniSublevel ρ) := by
      rintro _ ⟨u, hu, rfl⟩
      exact ⟨u, hu.1, rfl⟩
    have hstart : -φ (h + d * w) < 0 := by
      dsimp [φ]
      rw [affineCoordinate_apply hd]
      linarith
    have hstay := negative_on_component
      (S := complexAffineImage h d (cassiniSublevel ρ)) (r := h + d * w)
      (φ := fun z => -φ z) hφ.neg
      (fun z hzS hzero => hφzero z hzS (by linarith)) ⟨w, hw, rfl⟩ hstart
    have heq : connectedComponentIn (complexAffineImage h d (cassiniSublevel ρ))
        (h + d * w) = R := by
      apply Set.Subset.antisymm
      · intro z hzC
        have hzS := connectedComponentIn_subset _ _ hzC
        obtain ⟨u, hu, rfl⟩ := hzS
        refine ⟨u, ⟨hu, ?_⟩, rfl⟩
        have huφ := hstay (h + d * u) hzC
        dsimp [φ] at huφ
        rw [affineCoordinate_apply hd] at huφ
        linarith
      · exact hRconv.isPreconnected.subset_connectedComponentIn hanchor hRsub
    rw [heq]
    exact hRconv

theorem exists_quadratic_scale (q : ℂ) (hq : q ≠ 0) :
    ∃ d : ℂ, d ≠ 0 ∧ d ^ 2 = -q := by
  let p : ℂ[X] := X ^ 2 + C q
  have hpdeg : p.degree = 2 := by
    dsimp [p]
    compute_degree!
  obtain ⟨d, hdroot⟩ := IsAlgClosed.exists_root p (by rw [hpdeg]; norm_num)
  have hdpow : d ^ 2 = -q := by
    have := hdroot
    simp only [p, IsRoot.def, eval_add, eval_pow, eval_X, eval_C] at this
    exact eq_neg_of_add_eq_zero_left this
  refine ⟨d, ?_, hdpow⟩
  intro hd0
  subst d
  exact hq (by simpa using hdpow)

theorem monic_quadratic_eval_affine (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) {d : ℂ} (hd : d ^ 2 = -criticalValue f) (w : ℂ) :
    f.eval (center f + d * w) = -(criticalValue f) * (w ^ 2 - 1) := by
  rw [monic_quadratic_eval_center_add f hf hdeg]
  rw [mul_pow, hd]
  ring

theorem monic_quadratic_sublevel_eq_affine_cassini (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) (hq : criticalValue f ≠ 0)
    {d : ℂ} (hd0 : d ≠ 0) (hd : d ^ 2 = -criticalValue f) :
    sublevelSet f c = complexAffineImage (center f) d (cassiniSublevel (c / ‖criticalValue f‖)) := by
  have hqnorm : 0 < ‖criticalValue f‖ := norm_pos_iff.mpr hq
  ext z
  constructor
  · intro hz
    change ‖f.eval z‖ ≤ c at hz
    let w := (z - center f) / d
    refine ⟨w, ?_, ?_⟩
    · change ‖w ^ 2 - 1‖ ≤ c / ‖criticalValue f‖
      have heval : f.eval z = -(criticalValue f) * (w ^ 2 - 1) := by
        have hzrepr : center f + d * w = z := by
          dsimp [w]
          field_simp
          ring
        rw [← hzrepr]
        exact monic_quadratic_eval_affine f hf hdeg hd w
      rw [heval, norm_mul, norm_neg] at hz
      exact (le_div_iff₀ hqnorm).mpr (by simpa [mul_comm] using hz)
    · dsimp [w]
      field_simp
      ring
  · rintro ⟨w, hw, rfl⟩
    change ‖f.eval (center f + d * w)‖ ≤ c
    rw [monic_quadratic_eval_affine f hf hdeg hd, norm_mul, norm_neg]
    simpa [mul_comm] using (le_div_iff₀ hqnorm).mp hw

/-- Every connected component of an admissible positive-level quadratic sublevel set
is convex.  In the double-root case the whole set is a disk; in the separable case
the component-count hypothesis forces the level below the critical value, where the
two components are affine images of the two convex Cassini lobes. -/
theorem monic_quadratic_components_convex (f : ℂ[X]) (hf : f.Monic)
    (hdeg : f.natDegree = 2) (c : ℝ) (hc : 0 < c)
    (hcount : (componentsIn (sublevelSet f c)).ncard = (f.rootSet ℂ).ncard) :
    ∀ t ∈ componentsIn (sublevelSet f c), Convex ℝ t := by
  by_cases hq : criticalValue f = 0
  · have hconv := monic_quadratic_sublevel_convex_of_criticalValue_eq_zero
      f hf hdeg c hc.le hq
    rintro _ ⟨z, hz, rfl⟩
    rwa [hconv.isPreconnected.connectedComponentIn hz]
  · have hcritical : c < ‖criticalValue f‖ :=
      monic_quadratic_criticalValue_norm_gt_of_component_count
        f hf hdeg c hcount hq
    obtain ⟨d, hd0, hd⟩ := exists_quadratic_scale (criticalValue f) hq
    have hqnorm : 0 < ‖criticalValue f‖ := norm_pos_iff.mpr hq
    have hρ : 0 < c / ‖criticalValue f‖ := div_pos hc hqnorm
    have hρ1 : c / ‖criticalValue f‖ < 1 := (div_lt_one hqnorm).mpr hcritical
    rw [monic_quadratic_sublevel_eq_affine_cassini f hf hdeg c hq hd0 hd]
    exact affineCassini_components_convex hd0 hρ hρ1

end

