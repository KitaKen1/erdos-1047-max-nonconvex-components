    ∀ z ∈ connectedComponentIn S r, y0 < z.im := by
  let C := connectedComponentIn S r
  have hright : ∀ z ∈ C, 0 < z.re := by
    exact connectedComponentIn_re_gt_of_avoids 0 hzeroRe hr hrRe
