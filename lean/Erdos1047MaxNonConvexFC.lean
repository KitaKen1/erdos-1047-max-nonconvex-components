        (-586164629549788223395225201 / 1000000000000000000000000000 : ℝ) * t ^ 7 * (1 - t) ^ 1 +
        (-14044294963287821786137919 / 160000000000000000000000000000 : ℝ) * t ^ 8 * (1 - t) ^ 0 := by
