    simpa [Metric.mem_closedBall, dist_zero_right] using hw
  have hmin :
      (n : ℝ) - 1 ≤ ‖(powerLinearPolynomial n).eval u‖ := by
    simpa [powerLinearPolynomial] using
      (Erdos1047PowerLinear.critical_value_norm_ge hn u hu)
  linarith

theorem p8Polynomial_expanded :
    p8Polynomial = X ^ 8 - C (2 : ℂ) * X ^ 4 + C (2 : ℂ) := by
  simpa [p8Polynomial, Erdos1047P8.polynomial] using Erdos1047P8.polynomial_expanded

theorem p8Polynomial_algebraic_data :
    p8Polynomial.Monic ∧ p8Polynomial.natDegree = 8 ∧ p8Polynomial.Separable ∧
      (p8Polynomial.rootSet ℂ).ncard = 8 := by
