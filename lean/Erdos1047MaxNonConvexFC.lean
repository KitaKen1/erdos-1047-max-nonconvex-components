      connectedComponentIn {w : ℂ | ‖(normalized p b L).eval w‖ < level (cubicParam p b L)}
        (anchor (cubicParam p b L)) ≠
      connectedComponentIn {w : ℂ | ‖(normalized p b L).eval w‖ < level (cubicParam p b L)}
        (star (anchor (cubicParam p b L))) := by
  filter_upwards [eventually_fixed_disk_remainder hp hdeg hb] with L h
  exact (Erdos1047PerturbedCubicDisk.two_distinct_nonconvex_components h.1 h.2.1 h.2.2).2.2.2.2

