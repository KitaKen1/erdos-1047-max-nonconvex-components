/-!
# The new pair in the original coordinates

Positive affine transport preserves robust certificates. A continuous inverse
chart preserves separation of anchor components. The new anchors have real part
at least their centre, so large centres put them outside every fixed old ball.
All certificates use the common level `L² * (b * level(k(L)))`.
-/

open Polynomial Set Filter Erdos1047 Erdos1047Proof
open scoped Topology
open Erdos1047BalancedRaise Erdos1047BalancedNormalization Erdos1047BalancedDisk
open Erdos1047StrictLocalCubicModel

namespace Erdos1047BalancedTransport

noncomputable section

def realAffine (L s : ℝ) (w : ℂ) : ℂ := (L : ℂ) + (s : ℂ) * w

def inverseAffine (L s : ℝ) (z : ℂ) : ℂ := (z - (L : ℂ)) / (s : ℂ)

theorem realAffine_inverse (L : ℝ) {s : ℝ} (hs : s ≠ 0) (z : ℂ) :
    realAffine L s (inverseAffine L s z) = z := by
  have hsC : (s : ℂ) ≠ 0 := by exact_mod_cast hs
  dsimp [realAffine, inverseAffine]
  field_simp
  ring

theorem inverseAffine_realAffine (L : ℝ) {s : ℝ} (hs : s ≠ 0) (w : ℂ) :
    inverseAffine L s (realAffine L s w) = w := by
  have hsC : (s : ℂ) ≠ 0 := by exact_mod_cast hs
  dsimp [realAffine, inverseAffine]
  field_simp
  ring

theorem realAffine_combination (L s u v : ℝ) (huv : u + v = 1) (r a : ℂ) :
    u • realAffine L s r + v • realAffine L s a = realAffine L s (u • r + v • a) := by
  have huvC : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
  simp only [realAffine, Complex.real_smul]
  linear_combination (L : ℂ) * huvC

theorem certificate_of_realAffine
    {F G : ℂ → ℂ} {c α L s : ℝ} {r a b : ℂ}
    (hcert : RobustNonconvexCertificate G c r a b) (hα : 0 < α)
    (heval : ∀ w, F (realAffine L s w) = (α : ℂ) * G w) :
    Nonempty (RobustNonconvexCertificate F (α * c)
      (realAffine L s r) (realAffine L s a) (realAffine L s b)) := by
  have hnorm (w : ℂ) : ‖F (realAffine L s w)‖ = α * ‖G w‖ := by
    rw [heval, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hα]
  refine ⟨⟨α * hcert.eps, mul_pos hα hcert.eps_pos, ?_, ?_, ?_⟩⟩
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
    rw [realAffine_combination L s u v huv, hnorm, ← mul_add]
    exact mul_le_mul_of_nonneg_left (hcert.lineA_margin _ ⟨u, v, hu, hv, huv, rfl⟩) hα.le
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
    rw [realAffine_combination L s u v huv, hnorm, ← mul_add]
    exact mul_le_mul_of_nonneg_left (hcert.lineB_margin _ ⟨u, v, hu, hv, huv, rfl⟩) hα.le
  · have hmid : midpoint ℝ (realAffine L s a) (realAffine L s b) =
        realAffine L s (midpoint ℝ a b) := by
      simpa only [midpoint_eq_smul_add, invOf_eq_inv, one_div, smul_add] using
        realAffine_combination L s (1 / 2) (1 / 2) (by norm_num) a b
    rw [hmid, hnorm, ← mul_add]
    exact mul_le_mul_of_nonneg_left hcert.midpoint_margin hα.le

theorem certificate_anchor_mem {F : ℂ → ℂ} {c : ℝ} {r a b : ℂ}
    (hcert : RobustNonconvexCertificate F c r a b) : ‖F r‖ < c := by
  linarith [hcert.lineA_margin r (left_mem_segment ℝ r a), hcert.eps_pos]

theorem components_ne_of_continuous_map {S T : Set ℂ} {f : ℂ → ℂ}
    (hf : Continuous f) (hmap : MapsTo f S T) {r s : ℂ} (hr : r ∈ S) (hs : s ∈ S)
    (hne : connectedComponentIn T (f r) ≠ connectedComponentIn T (f s)) :
    connectedComponentIn S r ≠ connectedComponentIn S s := by
  intro heq
  have hscomp : s ∈ connectedComponentIn S r := by rw [heq]; exact mem_connectedComponentIn hs
  have hsub : f '' S ⊆ T := mapsTo_iff_image_subset.mp hmap
  have himage := hf.continuousOn.mapsTo_connectedComponentIn hr hscomp
  have hm := connectedComponentIn_mono (f r) hsub himage
  exact hne (connectedComponentIn_eq hm)

def movingLevel (p : ℝ[X]) (b L : ℝ) : ℝ := b * level (cubicParam p b L)

def raisedLevel (p : ℝ[X]) (b L : ℝ) : ℝ := L ^ 2 * movingLevel p b L

def localAnchor (k : ℝ) (i : Fin 2) : ℂ := if i = 0 then anchor k else star (anchor k)
def localPointA (k : ℝ) (i : Fin 2) : ℂ := if i = 0 then pointA k else star (pointA k)
def localPointB (k : ℝ) (i : Fin 2) : ℂ := if i = 0 then pointB k else star (pointB k)

def newAnchor (p : ℝ[X]) (b L : ℝ) (i : Fin 2) : ℂ :=
  realAffine L (localScale p b L) (localAnchor (cubicParam p b L) i)
def newPointA (p : ℝ[X]) (b L : ℝ) (i : Fin 2) : ℂ :=
  realAffine L (localScale p b L) (localPointA (cubicParam p b L) i)
def newPointB (p : ℝ[X]) (b L : ℝ) (i : Fin 2) : ℂ :=
  realAffine L (localScale p b L) (localPointB (cubicParam p b L) i)

theorem tendsto_movingLevel {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) :
    Tendsto (movingLevel p b) atTop (𝓝 b) := by
  have h1 : Tendsto (fun _ : ℝ => (1 : ℝ)) atTop (𝓝 1) := tendsto_const_nhds
  have h := (h1.sub
    (((tendsto_cubicParam hp hdeg b).pow 4).div_const 65536)).const_mul b
  change Tendsto (fun L => b * (1 - cubicParam p b L ^ 4 / 65536)) atTop (𝓝 b)
  simpa using h

theorem raised_eval_realAffine {p : ℝ[X]} {b L : ℝ} (hb : 0 < b) (hL : 0 < L) (w : ℂ) :
    (raised p b L).eval (realAffine L (localScale p b L) w) =
      ((b * L ^ 2 : ℝ) : ℂ) * (normalized p b L).eval w := by
  have hα : ((b * L ^ 2 : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast (ne_of_gt (mul_pos hb (sq_pos_of_pos hL)))
  rw [normalized_eval]
  dsimp [realAffine]
  field_simp

theorem mem_raised_iff_inverse {p : ℝ[X]} {b L : ℝ}
    (hb : 0 < b) (hL : 0 < L) (hs : 0 < localScale p b L) (z : ℂ) :
    z ∈ strictSublevelSet (raised p b L) (raisedLevel p b L) ↔
      ‖(normalized p b L).eval (inverseAffine L (localScale p b L) z)‖ < level (cubicParam p b L) := by
  have hα : 0 < b * L ^ 2 := mul_pos hb (sq_pos_of_pos hL)
  have heval := normalized_eval p b L (inverseAffine L (localScale p b L) z)
  change (normalized p b L).eval (inverseAffine L (localScale p b L) z) =
    (raised p b L).eval (realAffine L (localScale p b L)
      (inverseAffine L (localScale p b L) z)) / ((b * L ^ 2 : ℝ) : ℂ) at heval
  rw [realAffine_inverse L hs.ne'] at heval
  change ‖(raised p b L).eval z‖ < raisedLevel p b L ↔ _
  rw [heval, norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hα, div_lt_iff₀ hα]
  rw [show raisedLevel p b L = level (cubicParam p b L) * (b * L ^ 2) by
    dsimp [raisedLevel, movingLevel]
    ring]

theorem eventually_new_certificates {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) {b : ℝ} (hb : 0 < b) :
    ∀ᶠ L : ℝ in atTop, ∀ i : Fin 2,
      Nonempty (RobustNonconvexCertificate (fun z => (raised p b L).eval z)
        (raisedLevel p b L) (newAnchor p b L i) (newPointA p b L i) (newPointB p b L i)) := by
  filter_upwards [eventually_two_local_certificates hp hdeg hb,
    eventually_gt_atTop (0 : ℝ)] with L hcert hL
  intro i
  have hi : Nonempty (RobustNonconvexCertificate (fun w => (normalized p b L).eval w)
      (level (cubicParam p b L)) (localAnchor (cubicParam p b L) i)
      (localPointA (cubicParam p b L) i) (localPointB (cubicParam p b L) i)) := by
    fin_cases i
    · simpa [localAnchor, localPointA, localPointB] using hcert.1
    · simpa [localAnchor, localPointA, localPointB] using hcert.2
  obtain ⟨hi⟩ := hi
  have ht := certificate_of_realAffine (F := fun z => (raised p b L).eval z)
    (L := L) (s := localScale p b L) hi (mul_pos hb (sq_pos_of_pos hL))
    (raised_eval_realAffine (p := p) hb hL)
  simpa only [newAnchor, newPointA, newPointB, raisedLevel, movingLevel,
    mul_assoc, mul_left_comm, mul_comm] using ht

theorem eventually_new_components_injective {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) {b : ℝ} (hb : 0 < b) :
    ∀ᶠ L : ℝ in atTop, Function.Injective (fun i : Fin 2 =>
      connectedComponentIn (strictSublevelSet (raised p b L) (raisedLevel p b L)) (newAnchor p b L i)) := by
  filter_upwards [eventually_local_components_distinct hp hdeg hb,
    eventually_new_certificates hp hdeg hb, eventually_parameters_pos hp hdeg hb] with L hne hc hpos
  obtain ⟨hL, hpL, hH, hB, hs, hk, hk'⟩ := hpos
  have hmem (i : Fin 2) : newAnchor p b L i ∈ strictSublevelSet (raised p b L) (raisedLevel p b L) := by
    obtain ⟨hi⟩ := hc i
    exact certificate_anchor_mem hi
  have h01 : connectedComponentIn (strictSublevelSet (raised p b L) (raisedLevel p b L))
      (newAnchor p b L 0) ≠
      connectedComponentIn (strictSublevelSet (raised p b L) (raisedLevel p b L)) (newAnchor p b L 1) := by
    apply components_ne_of_continuous_map
      (f := inverseAffine L (localScale p b L)) (T := {w : ℂ | ‖(normalized p b L).eval w‖ < level (cubicParam p b L)})
      (by unfold inverseAffine; fun_prop)
      (fun z hz => (mem_raised_iff_inverse hb hL hs z).mp hz) (hmem 0) (hmem 1)
    simpa [newAnchor, localAnchor, inverseAffine_realAffine L hs.ne'] using hne
  intro i j heq
  fin_cases i <;> fin_cases j
  · rfl
  · exact False.elim (h01 heq)
  · exact False.elim (h01 heq.symm)
  · rfl

theorem centre_le_newAnchor_norm {p : ℝ[X]} {b L : ℝ}
    (hs : 0 ≤ localScale p b L) (hk : 0 ≤ cubicParam p b L) (i : Fin 2) :
    L ≤ ‖newAnchor p b L i‖ := by
  have hre : L ≤ (newAnchor p b L i).re := by
    fin_cases i <;>
      simp [newAnchor, localAnchor, realAffine, anchor, chart, Complex.mul_re] <;>
      positivity
  exact hre.trans (Complex.re_le_norm _)

theorem eventually_raisedLevel_pos {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) {b : ℝ} (hb : 0 < b) :
    ∀ᶠ L : ℝ in atTop, 0 < raisedLevel p b L := by
  filter_upwards [eventually_parameters_pos hp hdeg hb] with L hpos
  obtain ⟨hL, hpL, hH, hB, hs, hk, hk'⟩ := hpos
  exact mul_pos (sq_pos_of_pos hL) (mul_pos hb (level_bounds hk hk').1)

