section


/-!
# A stable pair of nonconvex components on a fixed disk

A fourth-order error bounded by `1000 * k^2 * ‖z‖^4` on `‖z‖ ≤ 2`
preserves two robust cubic-model certificates.  Circle and real-diameter
barriers keep their components inside the disk and on opposite sides of the
real axis.  No continuity or conjugation symmetry of the perturbed function
is required.  Supplying this disk estimate for a general raised polynomial
remains a separate analytic obligation.
-/

open Set Erdos1047Proof Erdos1047StrictLocalCubicModel
open Erdos1047BalancedOldComponents

namespace Erdos1047PerturbedCubicDisk

noncomputable section

theorem circle_barrier {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000)
    {G : ℂ → ℂ}
    (hrem : ∀ z : ℂ, ‖z‖ ≤ 2 → ‖G z - model k z‖ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4)
    {z : ℂ} (hz : ‖z‖ = 2) : 1 < ‖G z‖ := by
  have hk2 := pow_le_pow_left₀ hk.le hk' 2
  have herr := hrem z hz.le
  rw [hz] at herr
  have hpow : ‖z ^ 2‖ ≤ ‖1 + z ^ 2‖ + 1 := by
    calc
      _ = ‖(1 + z ^ 2) - 1‖ := by congr 1; ring
      _ ≤ _ := by simpa only [norm_one] using norm_sub_le (1 + z ^ 2) (1 : ℂ)
  have hcubic : ‖1 + z ^ 2‖ ≤ ‖model k z‖ + k * 8 := by
    have h := norm_sub_le (model k z) ((k : ℂ) * z ^ 3)
    norm_num [model, norm_mul, norm_pow, hz, abs_of_pos hk] at h ⊢
    exact h
  have hG : ‖model k z‖ ≤ ‖G z‖ + ‖G z - model k z‖ := by
    simpa using norm_sub_le (G z) (G z - model k z)
  rw [norm_pow, hz] at hpow
  nlinarith

theorem real_diameter_barrier {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000)
    {G : ℂ → ℂ}
    (hrem : ∀ z : ℂ, ‖z‖ ≤ 2 → ‖G z - model k z‖ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4)
    {z : ℂ} (hz : ‖z‖ ≤ 2) (him : z.im = 0) : 1 ≤ ‖G z‖ := by
  have hzreal : z = (z.re : ℂ) := by apply Complex.ext <;> simp [him]
  have hnorm : ‖z‖ = |z.re| := by conv_lhs => rw [hzreal]; simp
  have hx : |z.re| ≤ 2 := by rwa [hnorm] at hz
  have hx2 : z.re ^ 2 ≤ 4 := by nlinarith [(abs_le.mp hx).1, (abs_le.mp hx).2]
  have hx4 : z.re ^ 4 ≤ 4 * z.re ^ 2 := by
    nlinarith [mul_nonneg (sq_nonneg z.re) (sub_nonneg.mpr hx2)]
  have hk2 := pow_le_pow_left₀ hk.le hk' 2
  have hcoef : 0 ≤ 1 - 2 * k - 4000 * k ^ 2 := by nlinarith
  have hx3 : -(2 * k * z.re ^ 2) ≤ k * z.re ^ 3 := by
    nlinarith [mul_nonneg (mul_nonneg hk.le (sq_nonneg z.re))
      (show 0 ≤ z.re + 2 by linarith [(abs_le.mp hx).1])]
  have herr : ‖G z - model k z‖ ≤ 4000 * k ^ 2 * z.re ^ 2 := by
    calc
      _ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4 := hrem z hz
      _ = 1000 * k ^ 2 * z.re ^ 4 := by rw [hnorm, ← abs_pow, abs_of_nonneg (by positivity)]
      _ ≤ 1000 * k ^ 2 * (4 * z.re ^ 2) := by gcongr
      _ = 4000 * k ^ 2 * z.re ^ 2 := by ring
  have hG : ‖model k z‖ ≤ ‖G z‖ + ‖G z - model k z‖ := by
    simpa using norm_sub_le (G z) (G z - model k z)
  have hre := Complex.re_le_norm (model k z)
  rw [model_re, him] at hre
  nlinarith [mul_nonneg hcoef (sq_nonneg z.re)]

/-- An explicit reflected certificate retains the known numerical margin. -/
def lowerModelCertificate {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    RobustNonconvexCertificate (model k) (level k)
      (star (anchor k)) (star (pointA k)) (star (pointB k)) where
  eps := k ^ 4 / 65536
  eps_pos := by positivity
  lineA_margin := by
    rintro z ⟨u, v, hu, hv, huv, rfl⟩
    rw [show u • star (anchor k) + v • star (pointA k) =
      star (u • anchor k + v • pointA k) by simp, model_star, norm_star]
    exact (explicitCertificate hk hk').lineA_margin _ ⟨u, v, hu, hv, huv, rfl⟩
  lineB_margin := by
    rintro z ⟨u, v, hu, hv, huv, rfl⟩
    rw [show u • star (anchor k) + v • star (pointB k) =
      star (u • anchor k + v • pointB k) by simp, model_star, norm_star]
    exact (explicitCertificate hk hk').lineB_margin _ ⟨u, v, hu, hv, huv, rfl⟩
  midpoint_margin := by
    rw [show midpoint ℝ (star (pointA k)) (star (pointB k)) =
      star (midpoint ℝ (pointA k) (pointB k)) by
        simp [midpoint, AffineMap.lineMap_apply_module], model_star, norm_star]
    exact (explicitCertificate hk hk').midpoint_margin

theorem witness_norms {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000) :
    ‖anchor k‖ ≤ k ∧ ‖pointA k‖ ≤ k ∧ ‖pointB k‖ ≤ k := by
  have hk1 : k ≤ 1 := by linarith
  exact ⟨chart_norm_le hk hk1 (by norm_num) (by norm_num),
    chart_norm_le hk hk1 (by norm_num) (by norm_num),
    chart_norm_le hk hk1 (by norm_num) (by norm_num)⟩

theorem certificate_of_disk_remainder {k : ℝ}
    (hk : 0 < k) (hk' : k ≤ 1 / 10000) {G : ℂ → ℂ}
    (hrem : ∀ z : ℂ, ‖z‖ ≤ 2 → ‖G z - model k z‖ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4)
    {r a b : ℂ} (hcert : RobustNonconvexCertificate (model k) (level k) r a b)
    (heps : hcert.eps = k ^ 4 / 65536)
    (hr : ‖r‖ ≤ k) (ha : ‖a‖ ≤ k) (hb : ‖b‖ ≤ k) :
    Nonempty (RobustNonconvexCertificate G (level k) r a b) := by
  let δ := 1000 * k ^ 2 * k ^ 4
  have hδ : 0 ≤ δ := by dsimp [δ]; positivity
  have hk2 := pow_le_pow_left₀ hk.le hk' 2
  have hδlt : δ < hcert.eps := by
    rw [heps]
    have hc : 1000 * k ^ 2 < 1 / 65536 := by nlinarith
    calc
      _ < (1 / 65536) * k ^ 4 := mul_lt_mul_of_pos_right hc (by positivity)
      _ = k ^ 4 / 65536 := by ring
  have hclose : ∀ z ∈ Metric.closedBall (0 : ℂ) k, ‖G z - model k z‖ ≤ δ := by
    intro z hz
    have hzk : ‖z‖ ≤ k := by simpa only [Metric.mem_closedBall, dist_zero_right] using hz
    calc
      _ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4 := hrem z (by linarith)
      _ ≤ δ := by dsimp [δ]; gcongr
  have hrball : r ∈ Metric.closedBall (0 : ℂ) k := by simpa using hr
  have haball : a ∈ Metric.closedBall (0 : ℂ) k := by simpa using ha
  have hbball : b ∈ Metric.closedBall (0 : ℂ) k := by simpa using hb
  have hc := convex_closedBall (0 : ℂ) k
  exact hcert.of_uniform_close hδ hδlt
    (fun z hz => hclose z (hc.segment_subset hrball haball hz))
    (fun z hz => hclose z (hc.segment_subset hrball hbball hz))
    (hclose _ (hc.midpoint_mem haball hbball))

theorem two_robust_certificates {k : ℝ}
    (hk : 0 < k) (hk' : k ≤ 1 / 10000) {G : ℂ → ℂ}
    (hrem : ∀ z : ℂ, ‖z‖ ≤ 2 → ‖G z - model k z‖ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4) :
    Nonempty (RobustNonconvexCertificate G (level k) (anchor k) (pointA k) (pointB k)) ∧
    Nonempty (RobustNonconvexCertificate G (level k)
      (star (anchor k)) (star (pointA k)) (star (pointB k))) := by
  obtain ⟨hr, ha, hb⟩ := witness_norms hk hk'
  constructor
  · exact certificate_of_disk_remainder hk hk' hrem (explicitCertificate hk hk') rfl hr ha hb
  · exact certificate_of_disk_remainder hk hk' hrem (lowerModelCertificate hk hk') rfl
      (by simpa using hr) (by simpa using ha) (by simpa using hb)

theorem sphere_avoidance {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000)
    {G : ℂ → ℂ}
    (hrem : ∀ z : ℂ, ‖z‖ ≤ 2 → ‖G z - model k z‖ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4) :
    ∀ z ∈ {w : ℂ | ‖G w‖ < level k}, ‖z‖ ≠ 2 := by
  intro z hz heq
  have hb := circle_barrier hk hk' hrem heq
  have hl := (level_bounds hk hk').2
  change ‖G z‖ < level k at hz
  linarith

theorem components_confined {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000)
    {G : ℂ → ℂ}
    (hrem : ∀ z : ℂ, ‖z‖ ≤ 2 → ‖G z - model k z‖ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4) :
    connectedComponentIn {z : ℂ | ‖G z‖ < level k} (anchor k) ⊆ Metric.ball (0 : ℂ) 2 ∧
    connectedComponentIn {z : ℂ | ‖G z‖ < level k} (star (anchor k)) ⊆
      Metric.ball (0 : ℂ) 2 := by
  obtain ⟨⟨hu⟩, ⟨hl⟩⟩ := two_robust_certificates hk hk' hrem
  have hupper : ‖G (anchor k)‖ < level k := by
    linarith [hu.lineA_margin _ (left_mem_segment ℝ _ _), hu.eps_pos]
  have hlower : ‖G (star (anchor k))‖ < level k := by
    linarith [hl.lineA_margin _ (left_mem_segment ℝ _ _), hl.eps_pos]
  have hr : ‖anchor k‖ < 2 := (witness_norms hk hk').1.trans_lt (by linarith)
  exact ⟨component_subset_ball_of_sphere_avoidance hupper hr (sphere_avoidance hk hk' hrem),
    component_subset_ball_of_sphere_avoidance hlower (by simpa using hr)
      (sphere_avoidance hk hk' hrem)⟩

theorem upper_component_im_pos {k : ℝ} (hk : 0 < k) (hk' : k ≤ 1 / 10000)
    {G : ℂ → ℂ}
    (hrem : ∀ z : ℂ, ‖z‖ ≤ 2 → ‖G z - model k z‖ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4) :
    ∀ z ∈ connectedComponentIn {w : ℂ | ‖G w‖ < level k} (anchor k), 0 < z.im := by
  let S := {w : ℂ | ‖G w‖ < level k}
  obtain ⟨hu⟩ := (two_robust_certificates hk hk' hrem).1
  have hr : anchor k ∈ S := by
    change ‖G (anchor k)‖ < level k
    linarith [hu.lineA_margin _ (left_mem_segment ℝ _ _), hu.eps_pos]
  have hzero : ∀ z ∈ connectedComponentIn S (anchor k), z.im ≠ 0 := by
    intro z hz heq
    have hball := (components_confined hk hk' hrem).1 hz
    have hnorm : ‖z‖ < 2 := by simpa only [Metric.mem_ball, dist_zero_right] using hball
    have hb := real_diameter_barrier hk hk' hrem hnorm.le heq
    have hm := connectedComponentIn_subset S (anchor k) hz
    change ‖G z‖ < level k at hm
    linarith [(level_bounds hk hk').2]
  apply Erdos1047CubicLower.positive_on_preconnected isPreconnected_connectedComponentIn
    Complex.continuous_im hzero (mem_connectedComponentIn hr)
  simp [anchor, chart, Complex.mul_im]
  positivity

theorem two_distinct_nonconvex_components {k : ℝ}
    (hk : 0 < k) (hk' : k ≤ 1 / 10000) {G : ℂ → ℂ}
    (hrem : ∀ z : ℂ, ‖z‖ ≤ 2 → ‖G z - model k z‖ ≤ 1000 * k ^ 2 * ‖z‖ ^ 4) :
    0 < level k ∧ level k < 1 ∧
    ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖G z‖ < level k} (anchor k)) ∧
    ¬ Convex ℝ (connectedComponentIn {z : ℂ | ‖G z‖ < level k} (star (anchor k))) ∧
    connectedComponentIn {z : ℂ | ‖G z‖ < level k} (anchor k) ≠
      connectedComponentIn {z : ℂ | ‖G z‖ < level k} (star (anchor k)) := by
  obtain ⟨⟨hu⟩, ⟨hl⟩⟩ := two_robust_certificates hk hk' hrem
  refine ⟨(level_bounds hk hk').1, (level_bounds hk hk').2,
    Erdos1047FCStrictCertificateCore.robust_not_convex_component_strict hu,
    Erdos1047FCStrictCertificateCore.robust_not_convex_component_strict hl, ?_⟩
  intro heq
  have hm : ‖G (star (anchor k))‖ < level k := by
    linarith [hl.lineA_margin _ (left_mem_segment ℝ _ _), hl.eps_pos]
  have hmem : star (anchor k) ∈
      connectedComponentIn {z : ℂ | ‖G z‖ < level k} (star (anchor k)) :=
    mem_connectedComponentIn hm
  rw [← heq] at hmem
  have him := upper_component_im_pos hk hk' hrem _ hmem
  simp [anchor, chart, Complex.mul_im] at him
  nlinarith

/-- info: 'Erdos1047PerturbedCubicDisk.two_distinct_nonconvex_components' depends on axioms:
[propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms two_distinct_nonconvex_components

end
end Erdos1047PerturbedCubicDisk

end

/- Source: Erdos1047BalancedDisk.lean; SHA256: f93d4f6ab2dce0aba1211c7e4482295e8abe741075dd8ec73b952063014a332f -/
section


/-!
# The general balanced polynomial satisfies the fixed-disk cubic estimate

The finite Taylor expansion and its weighted coefficient bound give a uniform
fourth-order remainder on the radius-two disk.  This supplies, rather than
assumes, the analytic input of the stable local two-component construction.
Transporting those components to the original coordinates and separating them
from the old components are subsequent steps.
-/

open Polynomial Filter Set
open scoped Topology
open Erdos1047BalancedRaise Erdos1047BalancedTaylor Erdos1047BalancedNormalization
open Erdos1047StrictLocalCubicModel

namespace Erdos1047BalancedDisk

noncomputable section

def normalizedReal (p : ℝ[X]) (b L : ℝ) : ℝ[X] :=
  C (1 / (b * L ^ 2)) * (taylor L (raisedReal p b L)).comp (C (localScale p b L) * X)

def normalized (p : ℝ[X]) (b L : ℝ) : ℂ[X] := complexify (normalizedReal p b L)

theorem normalized_eval (p : ℝ[X]) (b L : ℝ) (w : ℂ) :
    (normalized p b L).eval w =
      (raised p b L).eval ((L : ℂ) + (localScale p b L : ℂ) * w) /
        ((b * L ^ 2 : ℝ) : ℂ) := by
  simp only [normalized, normalizedReal, complexify, raised, Polynomial.map_mul,
    Polynomial.map_C, Polynomial.map_comp, Polynomial.map_taylor, Polynomial.map_X,
    eval_mul, eval_C, eval_comp, eval_X, taylor_eval,
    Complex.coe_algebraMap, Complex.ofReal_div, Complex.ofReal_one]
  rw [add_comm ((localScale p b L : ℂ) * w) (L : ℂ)]
  ring

theorem normalizedReal_coeff (p : ℝ[X]) (b L : ℝ) (j : ℕ) :
    (normalizedReal p b L).coeff j =
      (taylor L (raisedReal p b L)).coeff j * localScale p b L ^ j / (b * L ^ 2) := by
  rw [normalizedReal, coeff_C_mul, comp_C_mul_X_coeff]
  ring

theorem normalizedReal_coeff_zero {p : ℝ[X]} {b L : ℝ}
    (hpL : p.eval L ≠ 0) (hb : b ≠ 0) (hL : L ≠ 0) :
    (normalizedReal p b L).coeff 0 = 1 := by
  rw [normalizedReal_coeff, raised_taylor_coeff_zero hpL]
  simp [hb, hL]

theorem normalizedReal_coeff_one {p : ℝ[X]} {b L : ℝ} (hpL : p.eval L ≠ 0) :
    (normalizedReal p b L).coeff 1 = 0 := by
  rw [normalizedReal_coeff, raised_taylor_coeff_one hpL]
  simp

theorem normalizedReal_coeff_add_two {p : ℝ[X]} {b L : ℝ}
    (hpL : p.eval L ≠ 0) (hb : b ≠ 0) (hL : L ≠ 0)
    (hD : 0 ≤ balancedD p b L) (hH : 0 < quadraticFactor p b L) (j : ℕ) :
    (normalizedReal p b L).coeff (j + 2) =
      raisedRatio p b j L * localScale p b L ^ j / quadraticFactor p b L := by
  rw [normalizedReal_coeff, raised_taylor_coeff hpL, pow_add, localScale_sq hD hH]
  unfold balancedD
  field_simp

theorem normalizedReal_coeff_two {p : ℝ[X]} {b L : ℝ}
    (hpL : p.eval L ≠ 0) (hb : b ≠ 0) (hL : L ≠ 0)
    (hD : 0 ≤ balancedD p b L) (hH : 0 < quadraticFactor p b L) :
    (normalizedReal p b L).coeff 2 = 1 := by
  rw [normalizedReal_coeff, raised_taylor_coeff_two hpL, localScale_sq hD hH]
  unfold balancedD
  field_simp

theorem normalizedReal_coeff_three {p : ℝ[X]} {b L : ℝ}
    (hpL : p.eval L ≠ 0) (hb : b ≠ 0) (hL : L ≠ 0)
    (hD : 0 ≤ balancedD p b L) (hH : 0 < quadraticFactor p b L) :
    (normalizedReal p b L).coeff 3 = cubicParam p b L := by
  simpa [cubicParam] using normalizedReal_coeff_add_two hpL hb hL hD hH 1

theorem normalizedReal_coeff_tail {p : ℝ[X]} {b L : ℝ}
    (hpL : p.eval L ≠ 0) (hb : b ≠ 0) (hL : L ≠ 0)
    (hD : 0 ≤ balancedD p b L) (hH : 0 < quadraticFactor p b L) (j : ℕ) :
    (normalizedReal p b L).coeff (j + 4) = tailCoeff p b j L := by
  simpa [tailCoeff, Nat.add_assoc] using
    normalizedReal_coeff_add_two hpL hb hL hD hH (j + 2)

theorem normalizedReal_natDegree_le {p : ℝ[X]} (hp : p.Monic) (b L : ℝ) :
    (normalizedReal p b L).natDegree ≤ p.natDegree + 2 := by
  have hdeg : (raisedReal p b L).natDegree = p.natDegree + 2 := by
    have h := raised_natDegree hp b L
    simpa only [raised, complexify, natDegree_map_eq_of_injective (algebraMap ℝ ℂ).injective] using h
  apply natDegree_le_iff_coeff_eq_zero.mpr
  intro j hj
  rw [normalizedReal_coeff, coeff_eq_zero_of_natDegree_lt, zero_mul, zero_div]
  simpa [natDegree_taylor, hdeg] using hj

/-- Turn finitely many weighted coefficient bounds into one disk estimate. -/
theorem polynomial_disk_remainder_bound {q : ℝ[X]} {k M : ℝ} {N : ℕ}
    (hdeg : q.natDegree < 4 + N)
    (h0 : q.coeff 0 = 1) (h1 : q.coeff 1 = 0)
    (h2 : q.coeff 2 = 1) (h3 : q.coeff 3 = k)
    (hcoeff : (∑ j ∈ Finset.range N, |q.coeff (j + 4)| * 2 ^ j) ≤ M)
    {w : ℂ} (hw : ‖w‖ ≤ 2) :
    ‖(complexify q).eval w - model k w‖ ≤ M * ‖w‖ ^ 4 := by
  have heval : (complexify q).eval w - model k w =
      ∑ j ∈ Finset.range N, (q.coeff (j + 4) : ℂ) * w ^ (j + 4) := by
    rw [eval_eq_sum_range' (by simpa only [complexify,
      natDegree_map_eq_of_injective (algebraMap ℝ ℂ).injective] using hdeg), Finset.sum_range_add]
    simp only [complexify, coeff_map]
    simp [Finset.sum_range_succ, h0, h1, h2, h3, model, Nat.add_comm 4]
  rw [heval]
  calc
    _ ≤ ∑ j ∈ Finset.range N, ‖(q.coeff (j + 4) : ℂ) * w ^ (j + 4)‖ := norm_sum_le _ _
    _ = (∑ j ∈ Finset.range N, |q.coeff (j + 4)| * ‖w‖ ^ j) * ‖w‖ ^ 4 := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro j hj
      simp [norm_pow, pow_add, mul_assoc]
    _ ≤ (∑ j ∈ Finset.range N, |q.coeff (j + 4)| * 2 ^ j) * ‖w‖ ^ 4 := by gcongr
    _ ≤ M * ‖w‖ ^ 4 := mul_le_mul_of_nonneg_right hcoeff (by positivity)

theorem eventually_fixed_disk_remainder {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) {b : ℝ} (hb : 0 < b) :
    ∀ᶠ L : ℝ in atTop,
      0 < cubicParam p b L ∧ cubicParam p b L ≤ 1 / 10000 ∧
      ∀ w : ℂ, ‖w‖ ≤ 2 →
        ‖(normalized p b L).eval w - model (cubicParam p b L) w‖ ≤
          1000 * cubicParam p b L ^ 2 * ‖w‖ ^ 4 := by
  filter_upwards [eventually_parameters_pos hp hdeg hb,
    eventually_tail_coeff_bound hp hdeg hb p.natDegree] with L hpos htail
  obtain ⟨hL, hpL, hH, hB, hs, hk, hk'⟩ := hpos
  have hD : 0 ≤ balancedD p b L := by unfold balancedD; positivity
  refine ⟨hk, hk', ?_⟩
  intro w hw
  apply polynomial_disk_remainder_bound (N := p.natDegree + 1)
    (lt_of_le_of_lt (normalizedReal_natDegree_le hp b L) (by omega))
    (normalizedReal_coeff_zero hpL.ne' hb.ne' hL.ne')
    (normalizedReal_coeff_one hpL.ne')
    (normalizedReal_coeff_two hpL.ne' hb.ne' hL.ne' hD hH)
    (normalizedReal_coeff_three hpL.ne' hb.ne' hL.ne' hD hH) ?_ hw
  simpa only [normalizedReal_coeff_tail hpL.ne' hb.ne' hL.ne' hD hH] using htail

theorem eventually_two_local_certificates {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) {b : ℝ} (hb : 0 < b) :
    ∀ᶠ L : ℝ in atTop,
      Nonempty (Erdos1047Proof.RobustNonconvexCertificate
        (fun w => (normalized p b L).eval w) (level (cubicParam p b L))
        (anchor (cubicParam p b L)) (pointA (cubicParam p b L)) (pointB (cubicParam p b L))) ∧
      Nonempty (Erdos1047Proof.RobustNonconvexCertificate
        (fun w => (normalized p b L).eval w) (level (cubicParam p b L))
        (star (anchor (cubicParam p b L))) (star (pointA (cubicParam p b L)))
        (star (pointB (cubicParam p b L)))) := by
  filter_upwards [eventually_fixed_disk_remainder hp hdeg hb] with L h
  exact Erdos1047PerturbedCubicDisk.two_robust_certificates h.1 h.2.1 h.2.2

theorem eventually_local_components_distinct {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) {b : ℝ} (hb : 0 < b) :
