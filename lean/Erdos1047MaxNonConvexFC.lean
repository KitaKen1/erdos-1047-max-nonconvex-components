  change ‖Erdos1047P6.polynomial.eval
    (Erdos1047P6.anchor + (v : ℂ) *
      (Erdos1047P6.pointB - Erdos1047P6.anchor))‖ ≤ Erdos1047P6.level
  exact (Erdos1047P6.lineB_norm_lt v hv hv1).le

theorem p6_midpoint_outside :
    midpoint ℝ Erdos1047P6.pointA Erdos1047P6.pointB ∉
      sublevelSet Erdos1047P6.polynomial Erdos1047P6.level := by
  intro hm
  change ‖Erdos1047P6.polynomial.eval
    (midpoint ℝ Erdos1047P6.pointA Erdos1047P6.pointB)‖ ≤
      Erdos1047P6.level at hm
  exact (not_le_of_gt Erdos1047P6.midpoint_norm_gt) hm

/-! An exact degree-six geometric certificate.  This is deliberately stated as
one component certificate: it does not yet assert that all six components have
been localized or that all six are non-convex. -/
theorem p6_anchor_component_not_convex :
    ¬ Convex ℝ (connectedComponentIn
      (Erdos1047.sublevelSet Erdos1047P6.polynomial Erdos1047P6.level)
      Erdos1047P6.anchor) := by
  apply component_not_convex_of_segments
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
    have hv1 : v ≤ 1 := by linarith
    have hparam : u • Erdos1047P6.anchor + v • Erdos1047P6.pointA =
        Erdos1047P6.anchor + (v : ℂ) *
          (Erdos1047P6.pointA - Erdos1047P6.anchor) := by
      rw [Complex.real_smul, Complex.real_smul]
      have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
      linear_combination Erdos1047P6.anchor * huv'
    rw [hparam]
    change ‖Erdos1047P6.polynomial.eval
      (Erdos1047P6.anchor + (v : ℂ) *
        (Erdos1047P6.pointA - Erdos1047P6.anchor))‖ ≤ Erdos1047P6.level
    exact (Erdos1047P6.lineA_norm_lt v hv hv1).le
  · rintro z ⟨u, v, hu, hv, huv, rfl⟩
    have hv1 : v ≤ 1 := by linarith
    have hparam : u • Erdos1047P6.anchor + v • Erdos1047P6.pointB =
        Erdos1047P6.anchor + (v : ℂ) *
          (Erdos1047P6.pointB - Erdos1047P6.anchor) := by
      rw [Complex.real_smul, Complex.real_smul]
      have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
      linear_combination Erdos1047P6.anchor * huv'
    rw [hparam]
    change ‖Erdos1047P6.polynomial.eval
      (Erdos1047P6.anchor + (v : ℂ) *
        (Erdos1047P6.pointB - Erdos1047P6.anchor))‖ ≤ Erdos1047P6.level
    exact (Erdos1047P6.lineB_norm_lt v hv hv1).le
  · intro hm
    change ‖Erdos1047P6.polynomial.eval
      (midpoint ℝ Erdos1047P6.pointA Erdos1047P6.pointB)‖ ≤
        Erdos1047P6.level at hm
    exact (not_le_of_gt Erdos1047P6.midpoint_norm_gt) hm

