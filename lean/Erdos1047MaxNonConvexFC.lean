/-!
# Taylor coefficient asymptotics for general balanced raising

The Taylor coefficients of a fixed real monic polynomial at a large positive
centre have universal leading ratios.  These limits replace polynomial-specific
coefficient estimates in the normalization of the new local pair.
-/

open Polynomial Filter
open scoped Topology
open Erdos1047BalancedRaise

namespace Erdos1047BalancedTaylor

noncomputable section

def taylorRatio (p : ℝ[X]) (j : ℕ) (L : ℝ) : ℝ :=
  (taylor L p).coeff j / p.eval L

theorem hasse_leadingCoeff {p : ℝ[X]} (hp : p.Monic) {j : ℕ}
    (hj : j ≤ p.natDegree) :
    (hasseDeriv j p).leadingCoeff = (p.natDegree.choose j : ℝ) := by
  rw [leadingCoeff, natDegree_hasseDeriv, hasseDeriv_coeff, Nat.sub_add_cancel hj,
    hp.coeff_natDegree, mul_one]

theorem hasse_ne_zero {p : ℝ[X]} (hp : p.Monic) {j : ℕ}
    (hj : j ≤ p.natDegree) : hasseDeriv j p ≠ 0 := by
  apply leadingCoeff_ne_zero.mp
  rw [hasse_leadingCoeff hp hj]
  exact_mod_cast (Nat.choose_pos hj).ne'

/-- `L^j` times the relative `j`th Taylor coefficient tends to `choose n j`. -/
theorem tendsto_scaled_taylorRatio {p : ℝ[X]} (hp : p.Monic) (j : ℕ) :
    Tendsto (fun L : ℝ => L ^ j * taylorRatio p j L) atTop
      (𝓝 (p.natDegree.choose j : ℝ)) := by
  by_cases hj : j ≤ p.natDegree
  · have hq : (X ^ j * hasseDeriv j p : ℝ[X]).natDegree = p.natDegree := by
      rw [natDegree_mul (pow_ne_zero _ X_ne_zero) (hasse_ne_zero hp hj),
        natDegree_X_pow, natDegree_hasseDeriv]
      omega
    have hd : (X ^ j * hasseDeriv j p : ℝ[X]).degree = p.degree := by
      rw [degree_eq_natDegree (mul_ne_zero (pow_ne_zero _ X_ne_zero) (hasse_ne_zero hp hj)),
        degree_eq_natDegree hp.ne_zero, hq]
    have h := (X ^ j * hasseDeriv j p : ℝ[X]).div_tendsto_atTop_leadingCoeff_div_of_degree_eq p hd
    simpa [taylorRatio, taylor_coeff, leadingCoeff_mul, hasse_leadingCoeff hp hj,
      hp.leadingCoeff, mul_div_assoc] using h
  · have hj' : p.natDegree < j := by omega
    simp [taylorRatio, taylor_coeff, hasseDeriv_eq_zero_of_lt_natDegree p j hj',
      Nat.choose_eq_zero_of_lt hj']

/-- Every smaller power of `L` gives a vanishing relative Taylor coefficient. -/
theorem tendsto_lower_scaled_taylorRatio {p : ℝ[X]} (hp : p.Monic)
    {m j : ℕ} (hmj : m < j) :
    Tendsto (fun L : ℝ => L ^ m * taylorRatio p j L) atTop (𝓝 0) := by
  by_cases hj : j ≤ p.natDegree
  · have hq : (X ^ m * hasseDeriv j p : ℝ[X]).natDegree < p.natDegree := by
      rw [natDegree_mul (pow_ne_zero _ X_ne_zero) (hasse_ne_zero hp hj),
        natDegree_X_pow, natDegree_hasseDeriv]
      omega
    have hd : (X ^ m * hasseDeriv j p : ℝ[X]).degree < p.degree := by
      rw [degree_eq_natDegree (mul_ne_zero (pow_ne_zero _ X_ne_zero) (hasse_ne_zero hp hj)),
        degree_eq_natDegree hp.ne_zero]
      exact_mod_cast hq
    have h := (X ^ m * hasseDeriv j p : ℝ[X]).div_tendsto_atTop_zero_of_degree_lt p hd
    simpa [taylorRatio, taylor_coeff, mul_div_assoc] using h
  · have hj' : p.natDegree < j := by omega
    simp [taylorRatio, taylor_coeff, hasseDeriv_eq_zero_of_lt_natDegree p j hj']

theorem tendsto_taylorRatio {p : ℝ[X]} (hp : p.Monic) {j : ℕ} (hj : 0 < j) :
    Tendsto (taylorRatio p j) atTop (𝓝 0) := by
  simpa using tendsto_lower_scaled_taylorRatio hp hj

def quadraticFactor (p : ℝ[X]) (b L : ℝ) : ℝ :=
  1 + balancedD p b L * (taylorRatio p 2 L - taylorRatio p 1 L ^ 2)

/-- The coefficient of degree `j+2` in the shifted raised polynomial, divided by `p(L)`. -/
def raisedRatio (p : ℝ[X]) (b : ℝ) (j : ℕ) (L : ℝ) : ℝ :=
  taylorRatio p j L + balancedD p b L *
    (taylorRatio p (j + 2) L - taylorRatio p 1 L * taylorRatio p (j + 1) L)

theorem tendsto_quadraticFactor {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) :
    Tendsto (quadraticFactor p b) atTop (𝓝 1) := by
  have h1 := tendsto_taylorRatio hp (by norm_num : 0 < 1)
  have h2 := tendsto_taylorRatio hp (by norm_num : 0 < 2)
  change Tendsto (fun L => 1 + balancedD p b L *
    (taylorRatio p 2 L - taylorRatio p 1 L ^ 2)) atTop (𝓝 1)
  simpa using ((tendsto_balancedD hp hdeg b).mul (h2.sub (h1.pow 2))).const_add 1

theorem tendsto_scaled_cubicFactor {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) :
    Tendsto (fun L : ℝ => L * raisedRatio p b 1 L) atTop (𝓝 (p.natDegree : ℝ)) := by
  have h1 : Tendsto (fun L : ℝ => L * taylorRatio p 1 L) atTop (𝓝 (p.natDegree : ℝ)) := by
    simpa using tendsto_scaled_taylorRatio hp 1
  have h2 := tendsto_taylorRatio hp (by norm_num : 0 < 2)
  have h3 : Tendsto (fun L : ℝ => L * taylorRatio p 3 L) atTop (𝓝 0) := by
    simpa using tendsto_lower_scaled_taylorRatio hp (by norm_num : 1 < 3)
  have h := h1.add ((tendsto_balancedD hp hdeg b).mul (h3.sub (h1.mul h2)))
  simp only [mul_zero, sub_zero, add_zero] at h
  convert h using 1
  ext L
  dsimp [raisedRatio]
  ring

theorem tendsto_scaled_raisedRatio_of_limit {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) {j : ℕ} (hj : 2 ≤ j) {a : ℝ}
    (ha : Tendsto (fun L : ℝ => L ^ 2 * taylorRatio p j L) atTop (𝓝 a)) :
    Tendsto (fun L : ℝ => L ^ 2 * raisedRatio p b j L) atTop (𝓝 a) := by
  have h1 : Tendsto (fun L : ℝ => L * taylorRatio p 1 L) atTop (𝓝 (p.natDegree : ℝ)) := by
    simpa using tendsto_scaled_taylorRatio hp 1
  have hnext : Tendsto (fun L : ℝ => L * taylorRatio p (j + 1) L) atTop (𝓝 0) := by
    simpa using tendsto_lower_scaled_taylorRatio hp (show 1 < j + 1 by omega)
  have hlast := tendsto_lower_scaled_taylorRatio hp (show 2 < j + 2 by omega)
  have h := ha.add ((tendsto_balancedD hp hdeg b).mul (hlast.sub (h1.mul hnext)))
  simp only [mul_zero, sub_zero, add_zero] at h
  convert h using 1
  ext L
  dsimp [raisedRatio]
  ring

theorem tendsto_scaled_quarticFactor {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) :
    Tendsto (fun L : ℝ => L ^ 2 * raisedRatio p b 2 L) atTop
      (𝓝 (p.natDegree.choose 2 : ℝ)) :=
  tendsto_scaled_raisedRatio_of_limit hp hdeg b le_rfl (tendsto_scaled_taylorRatio hp 2)

theorem tendsto_scaled_higherFactor {p : ℝ[X]} (hp : p.Monic)
    (hdeg : 2 < p.natDegree) (b : ℝ) {j : ℕ} (hj : 2 < j) :
    Tendsto (fun L : ℝ => L ^ 2 * raisedRatio p b j L) atTop (𝓝 0) :=
  tendsto_scaled_raisedRatio_of_limit hp hdeg b hj.le (tendsto_lower_scaled_taylorRatio hp hj)

theorem raised_taylor (p : ℝ[X]) (b L : ℝ) :
    taylor L (raisedReal p b L) = taylor L p *
      (X ^ 2 + C (balancedA p b L) * X + C (balancedD p b L)) := by
  simp [taylor_apply, raisedReal]

theorem raised_taylor_coeff {p : ℝ[X]} {b L : ℝ} (hpL : p.eval L ≠ 0) (j : ℕ) :
    (taylor L (raisedReal p b L)).coeff (j + 2) = p.eval L * raisedRatio p b j L := by
  rw [raised_taylor]
  simp only [mul_add, ← mul_assoc, coeff_add, coeff_mul_X_pow, coeff_mul_C,
    show j + 2 = (j + 1) + 1 from rfl, coeff_mul_X]
  simp only [raisedRatio, taylorRatio, taylor_coeff_one, balancedA]
  field_simp
  ring

theorem raised_taylor_coeff_zero {p : ℝ[X]} {b L : ℝ} (hpL : p.eval L ≠ 0) :
    (taylor L (raisedReal p b L)).coeff 0 = b * L ^ 2 := by
  simp only [taylor_coeff_zero, raisedReal, eval_mul, eval_add, eval_pow,
    eval_sub, eval_X, eval_C, sub_self, zero_pow (by norm_num : (2 : ℕ) ≠ 0),
    mul_zero, zero_add, balancedD]
  field_simp

theorem raised_taylor_coeff_one {p : ℝ[X]} {b L : ℝ} (hpL : p.eval L ≠ 0) :
    (taylor L (raisedReal p b L)).coeff 1 = 0 := by
  rw [raised_taylor]
  simp [mul_add, ← mul_assoc, coeff_mul_X_pow', coeff_mul_C, balancedA]
  field_simp
  ring

theorem raised_taylor_coeff_two {p : ℝ[X]} {b L : ℝ} (hpL : p.eval L ≠ 0) :
    (taylor L (raisedReal p b L)).coeff 2 = p.eval L * quadraticFactor p b L := by
  simpa [raisedRatio, quadraticFactor, taylorRatio, hpL, pow_two] using
    raised_taylor_coeff (b := b) hpL 0

