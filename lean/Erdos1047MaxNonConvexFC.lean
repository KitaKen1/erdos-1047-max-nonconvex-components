/-! The five p₅ anchors can be separated using only the three coordinate
    barriers that occur naturally in the degree-raising argument: the
    imaginary axis, the two left horizontal half-lines at heights ±1/2, and
    the right real half-line.  Unlike a full-line separator, a half-line does
    not by itself give a global sign function; the preceding component-trap
    lemmas first keep a component in the appropriate half-plane. -/
theorem p5_component_map_injOn_of_halfline_barriers
    {S : Set ℂ}
    (hmem : ∀ z ∈ (Set.range p5FiveAnchor : Set ℂ), z ∈ S)
    (hzeroRe : ∀ z ∈ S, z.re ≠ 0)
    (hupper : ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + ((1 / 2 : ℝ) : ℂ) * Complex.I ∉ S)
    (hlower : ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + ((-1 / 2 : ℝ) : ℂ) * Complex.I ∉ S)
    (hright : ∀ x : ℝ, 0 ≤ x →
      (x : ℂ) + ((0 : ℝ) : ℂ) * Complex.I ∉ S) :
    Set.InjOn (fun z : ℂ ↦ connectedComponentIn S z)
      (Set.range p5FiveAnchor) := by
  let C : ℂ → Set ℂ := fun z ↦ connectedComponentIn S z
  have h0 : p5UpperLeftAnchor ∈ S :=
    hmem p5UpperLeftAnchor ⟨0, by simp [p5FiveAnchor]⟩
  have h1 : star p5UpperLeftAnchor ∈ S :=
    hmem (star p5UpperLeftAnchor) ⟨1, by simp [p5FiveAnchor]⟩
  have h2 : p5CentralAnchor ∈ S :=
    hmem p5CentralAnchor ⟨2, by simp [p5FiveAnchor]⟩
  have h3 : p5RightAnchor ∈ S :=
    hmem p5RightAnchor ⟨3, by simp [p5FiveAnchor]⟩
  have h4 : star p5RightAnchor ∈ S :=
    hmem (star p5RightAnchor) ⟨4, by simp [p5FiveAnchor]⟩
  have hre0 : p5UpperLeftAnchor.re < 0 := by
    norm_num [p5UpperLeftAnchor]
  have hre1 : (star p5UpperLeftAnchor).re < 0 := by
    norm_num [p5UpperLeftAnchor]
  have hre2 : p5CentralAnchor.re < 0 := by
    norm_num [p5CentralAnchor]
  have hre3 : 0 < p5RightAnchor.re := by
    norm_num [p5RightAnchor]
  have hre4 : 0 < (star p5RightAnchor).re := by
    norm_num [p5RightAnchor]
  have him0 : (1 / 2 : ℝ) < p5UpperLeftAnchor.im := by
    norm_num [p5UpperLeftAnchor]
  have him1 : (star p5UpperLeftAnchor).im < (1 / 2 : ℝ) := by
    norm_num [p5UpperLeftAnchor]
  have him2u : p5CentralAnchor.im < (1 / 2 : ℝ) := by
    norm_num [p5CentralAnchor]
  have him2l : (-1 / 2 : ℝ) < p5CentralAnchor.im := by
    norm_num [p5CentralAnchor]
  have him1l : (star p5UpperLeftAnchor).im < (-1 / 2 : ℝ) := by
    norm_num [p5UpperLeftAnchor]
  have him3 : 0 < p5RightAnchor.im := by
    norm_num [p5RightAnchor]
  have him4 : (star p5RightAnchor).im < 0 := by
    norm_num [p5RightAnchor]
  have h01 : C p5UpperLeftAnchor ≠ C (star p5UpperLeftAnchor) := by
    intro heq
    have hsC : star p5UpperLeftAnchor ∈ C p5UpperLeftAnchor := by
      rw [heq]
      exact mem_connectedComponentIn h1
    have hside := connectedComponentIn_im_gt_of_left_halfline_avoids
      (S := S) (r := p5UpperLeftAnchor) (1 / 2 : ℝ)
      hzeroRe h0 hre0 him0 hupper (star p5UpperLeftAnchor) hsC
    linarith
  have h02 : C p5UpperLeftAnchor ≠ C p5CentralAnchor := by
    intro heq
    have hsC : p5CentralAnchor ∈ C p5UpperLeftAnchor := by
      rw [heq]
      exact mem_connectedComponentIn h2
    have hside := connectedComponentIn_im_gt_of_left_halfline_avoids
      (S := S) (r := p5UpperLeftAnchor) (1 / 2 : ℝ)
      hzeroRe h0 hre0 him0 hupper p5CentralAnchor hsC
    linarith
  have h03 : C p5UpperLeftAnchor ≠ C p5RightAnchor := by
    intro heq
    have hsC : p5RightAnchor ∈ C p5UpperLeftAnchor := by
      rw [heq]
      exact mem_connectedComponentIn h3
    have hside := connectedComponentIn_re_lt_of_avoids
      (S := S) (r := p5UpperLeftAnchor) 0 hzeroRe h0 hre0
      p5RightAnchor hsC
    linarith
  have h04 : C p5UpperLeftAnchor ≠ C (star p5RightAnchor) := by
    intro heq
    have hsC : star p5RightAnchor ∈ C p5UpperLeftAnchor := by
      rw [heq]
      exact mem_connectedComponentIn h4
    have hside := connectedComponentIn_re_lt_of_avoids
      (S := S) (r := p5UpperLeftAnchor) 0 hzeroRe h0 hre0
      (star p5RightAnchor) hsC
    linarith
  have h12 : C (star p5UpperLeftAnchor) ≠ C p5CentralAnchor := by
    intro heq
    have hsC : p5CentralAnchor ∈ C (star p5UpperLeftAnchor) := by
      rw [heq]
      exact mem_connectedComponentIn h2
    have hside := connectedComponentIn_im_lt_of_left_halfline_avoids
      (S := S) (r := star p5UpperLeftAnchor) (-1 / 2 : ℝ)
      hzeroRe h1 hre1 him1l hlower p5CentralAnchor hsC
    linarith
  have h13 : C (star p5UpperLeftAnchor) ≠ C p5RightAnchor := by
    intro heq
    have hsC : p5RightAnchor ∈ C (star p5UpperLeftAnchor) := by
      rw [heq]
      exact mem_connectedComponentIn h3
    have hside := connectedComponentIn_re_lt_of_avoids
      (S := S) (r := star p5UpperLeftAnchor) 0 hzeroRe h1 hre1
      p5RightAnchor hsC
    linarith
  have h14 : C (star p5UpperLeftAnchor) ≠ C (star p5RightAnchor) := by
    intro heq
    have hsC : star p5RightAnchor ∈ C (star p5UpperLeftAnchor) := by
      rw [heq]
      exact mem_connectedComponentIn h4
    have hside := connectedComponentIn_re_lt_of_avoids
      (S := S) (r := star p5UpperLeftAnchor) 0 hzeroRe h1 hre1
      (star p5RightAnchor) hsC
    linarith
  have h23 : C p5CentralAnchor ≠ C p5RightAnchor := by
    intro heq
    have hsC : p5RightAnchor ∈ C p5CentralAnchor := by
      rw [heq]
      exact mem_connectedComponentIn h3
    have hside := connectedComponentIn_re_lt_of_avoids
      (S := S) (r := p5CentralAnchor) 0 hzeroRe h2 hre2
      p5RightAnchor hsC
    linarith
  have h24 : C p5CentralAnchor ≠ C (star p5RightAnchor) := by
    intro heq
    have hsC : star p5RightAnchor ∈ C p5CentralAnchor := by
      rw [heq]
      exact mem_connectedComponentIn h4
    have hside := connectedComponentIn_re_lt_of_avoids
      (S := S) (r := p5CentralAnchor) 0 hzeroRe h2 hre2
      (star p5RightAnchor) hsC
    linarith
  have h34 : C p5RightAnchor ≠ C (star p5RightAnchor) := by
    intro heq
    have hsC : star p5RightAnchor ∈ C p5RightAnchor := by
      rw [heq]
      exact mem_connectedComponentIn h4
    have hside := connectedComponentIn_im_gt_of_right_halfline_avoids
      (S := S) (r := p5RightAnchor) 0 hzeroRe h3 hre3 him3 hright
      (star p5RightAnchor) hsC
    linarith
  have hAcard : (Set.range p5FiveAnchor : Set ℂ).ncard = 5 := by
    rw [Set.ncard_range_of_injective p5FiveAnchor_injective]
    simp
  have himage : C '' (Set.range p5FiveAnchor : Set ℂ) =
      {C p5UpperLeftAnchor, C (star p5UpperLeftAnchor), C p5CentralAnchor,
        C p5RightAnchor, C (star p5RightAnchor)} := by
    ext t
    constructor
    · rintro ⟨z, ⟨i, rfl⟩, rfl⟩
      fin_cases i <;> simp [p5FiveAnchor]
    · intro ht
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ht
      rcases ht with rfl | rfl | rfl | rfl | rfl
      · exact ⟨p5UpperLeftAnchor, ⟨⟨0, by decide⟩, by simp [p5FiveAnchor]⟩, rfl⟩
      · exact ⟨star p5UpperLeftAnchor, ⟨⟨1, by decide⟩, by simp [p5FiveAnchor]⟩, rfl⟩
      · exact ⟨p5CentralAnchor, ⟨⟨2, by decide⟩, by simp [p5FiveAnchor]⟩, rfl⟩
      · exact ⟨p5RightAnchor, ⟨⟨3, by decide⟩, by simp [p5FiveAnchor]⟩, rfl⟩
      · exact ⟨star p5RightAnchor, ⟨⟨4, by decide⟩, by simp [p5FiveAnchor]⟩, rfl⟩
  have himagecard : (C '' (Set.range p5FiveAnchor : Set ℂ)).ncard = 5 := by
    rw [himage]
    have hn0 : C p5UpperLeftAnchor ∉
        ({C (star p5UpperLeftAnchor), C p5CentralAnchor,
          C p5RightAnchor, C (star p5RightAnchor)} : Set (Set ℂ)) := by
      intro h
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at h
      rcases h with h | h | h | h
      · exact h01 h
      · exact h02 h
      · exact h03 h
      · exact h04 h
    have hn1 : C (star p5UpperLeftAnchor) ∉
        ({C p5CentralAnchor, C p5RightAnchor, C (star p5RightAnchor)} : Set (Set ℂ)) := by
      intro h
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at h
      rcases h with h | h | h
      · exact h12 h
      · exact h13 h
      · exact h14 h
    have hn2 : C p5CentralAnchor ∉
        ({C p5RightAnchor, C (star p5RightAnchor)} : Set (Set ℂ)) := by
      intro h
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at h
      rcases h with h | h
      · exact h23 h
      · exact h24 h
    have hn3 : C p5RightAnchor ∉ ({C (star p5RightAnchor)} : Set (Set ℂ)) := by
      intro h
      simpa only [Set.mem_singleton_iff] using h34 h
    rw [Set.ncard_insert_of_notMem hn0]
    rw [Set.ncard_insert_of_notMem hn1]
    rw [Set.ncard_insert_of_notMem hn2]
    rw [Set.ncard_insert_of_notMem hn3]
    simp
  have heq : (C '' (Set.range p5FiveAnchor : Set ℂ)).ncard =
      (Set.range p5FiveAnchor : Set ℂ).ncard := himagecard.trans hAcard.symm
  have hinj : Set.InjOn C (Set.range p5FiveAnchor : Set ℂ) :=
    Set.injOn_of_ncard_image_eq heq (Set.finite_range p5FiveAnchor)
  simpa [C] using hinj

/-! p₅ bridge for the parameter-free barriers.  Once the four direct factor
    bounds and membership of the five old anchors are supplied, all ten
    component labels are separated by the previously checked half-line sign
    argument.  The only numerical input here is the large-scale inequality
    needed on the two horizontal lines. -/
theorem p5_component_map_injOn_of_raised_factor_barriers
    {L : ℝ} {d : ℂ}
    (hLlarge : 1000 ≤ L)
    (hvertical : ∀ y : ℝ, L ^ 2 ≤
      ‖(((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + d)‖)
    (hupper : ∀ x : ℝ, x ≤ 0 → L ^ 2 - (1 / 2 : ℝ) ^ 2 ≤
      ‖(((x : ℂ) + (1 / 2 : ℝ) * Complex.I - (L : ℂ)) ^ 2 + d)‖)
    (hlower : ∀ x : ℝ, x ≤ 0 → L ^ 2 - (-1 / 2 : ℝ) ^ 2 ≤
      ‖(((x : ℂ) + (-1 / 2 : ℝ) * Complex.I - (L : ℂ)) ^ 2 + d)‖)
    (hright : ∀ x : ℝ, 0 ≤ x → L ^ 2 ≤
      ‖(((x : ℂ) - (L : ℂ)) ^ 2 + d)‖)
    (hmem : ∀ z ∈ (Set.range p5FiveAnchor : Set ℂ), z ∈
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ) d)
        (p5WitnessLevel * L ^ 2)) :
    Set.InjOn (fun z : ℂ ↦ connectedComponentIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ) d)
        (p5WitnessLevel * L ^ 2)) z)
      (Set.range p5FiveAnchor) := by
  have hL : 0 < L := by nlinarith
  have hWlt : p5WitnessLevel < p5Level := by
    norm_num [p5WitnessLevel, p5Level]
  have hzeroRe : ∀ y : ℝ, (y : ℂ) * Complex.I ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ) d)
        (p5WitnessLevel * L ^ 2) := by
    apply degree_raise_vertical_line_avoids_of_factor_norm_ge
      (p := p5Polynomial) (c := p5WitnessLevel) (L := L) hL
      hvertical
    intro y
    exact lt_trans hWlt (p5_imaginary_axis_eval_norm_gt y)
  have hbaseHalf : 0 ≤ L ^ 2 - (1 / 2 : ℝ) ^ 2 := by
    nlinarith [sq_nonneg (L - 1000)]
  have hlevelHalf : p5WitnessLevel * L ^ 2 <
      p5Level * (L ^ 2 - (1 / 2 : ℝ) ^ 2) := by
    norm_num [p5WitnessLevel, p5Level]
    nlinarith [sq_nonneg (L - 1000)]
  have hupper' : ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (1 / 2 : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ) d)
          (p5WitnessLevel * L ^ 2) := by
    have h := degree_raise_horizontal_set_avoids_of_factor_norm_ge
      (p := p5Polynomial) (c₀ := p5Level)
      (c := p5WitnessLevel * L ^ 2) (L := L) (a := (1 / 2 : ℝ))
      (d := d) (P := fun x : ℝ => x ≤ 0) hbaseHalf
      (by intro x hx; exact p5_left_upper_horizontal_eval_norm_ge x hx)
      (by intro x hx; exact hupper x hx) hlevelHalf
    simpa using h
  have hbaseHalf' : 0 ≤ L ^ 2 - (-1 / 2 : ℝ) ^ 2 := by
    norm_num [pow_two] at hbaseHalf ⊢
    exact hbaseHalf
  have hlevelHalf' : p5WitnessLevel * L ^ 2 <
      p5Level * (L ^ 2 - (-1 / 2 : ℝ) ^ 2) := by
    norm_num [pow_two] at hlevelHalf ⊢
    exact hlevelHalf
  have hlower' : ∀ x : ℝ, x ≤ 0 →
      (x : ℂ) + (-1 / 2 : ℂ) * Complex.I ∉
        Erdos1047.sublevelSet
          (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ) d)
          (p5WitnessLevel * L ^ 2) := by
    have h := degree_raise_horizontal_set_avoids_of_factor_norm_ge
      (p := p5Polynomial) (c₀ := p5Level)
      (c := p5WitnessLevel * L ^ 2) (L := L) (a := (-1 / 2 : ℝ))
      (d := d) (P := fun x : ℝ => x ≤ 0) hbaseHalf'
      (by intro x hx; exact p5_left_lower_horizontal_eval_norm_ge x hx)
      (by intro x hx; exact hlower x hx) hlevelHalf'
    simpa using h
  have hbaseRight : 0 ≤ L ^ 2 := sq_nonneg L
  have hlevelRight : p5WitnessLevel * L ^ 2 < p5Level * L ^ 2 := by
    nlinarith [hWlt, sq_pos_of_pos hL]
  have hright' : ∀ x : ℝ, 0 ≤ x → (x : ℂ) ∉
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ) d)
        (p5WitnessLevel * L ^ 2) := by
    have h := degree_raise_horizontal_set_avoids_of_factor_norm_ge
      (p := p5Polynomial) (c₀ := p5Level)
      (c := p5WitnessLevel * L ^ 2) (L := L) (a := (0 : ℝ))
      (d := d) (P := fun x : ℝ => 0 ≤ x) (by simpa using hbaseRight)
      (by
        intro x hx
        have hre := p5_real_right_eval_re_ge x hx
        have hn := Complex.re_le_norm (p5Polynomial.eval (x : ℂ))
        have hnorm : p5Level ≤ ‖p5Polynomial.eval (x : ℂ)‖ :=
          le_trans hre hn
        simpa using hnorm)
      (by intro x hx; simpa using hright x hx) (by simpa using hlevelRight)
    intro x hx
    have hx' := h x hx
    convert hx' using 1 <;> norm_num
  apply p5_component_map_injOn_of_halfline_barriers (S :=
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ) d)
        (p5WitnessLevel * L ^ 2)) hmem
  · intro z hz hzero
    have hrepr : z = (z.im : ℂ) * Complex.I := by
      apply Complex.ext <;> simp [hzero]
    rw [hrepr] at hz
    exact hzeroRe z.im hz
  · simpa using hupper'
  · simpa using hlower'
  · simpa using hright'

/-! For the real-square factor `d = L²`, all four barrier inequalities are
    unconditional once `L` is large.  This packages the exact arithmetic
    instantiation of the preceding parameterized separator theorem. -/
theorem p5_component_map_injOn_of_real_square_factor
    {L : ℝ} (hLlarge : 1000 ≤ L)
    (hmem : ∀ z ∈ (Set.range p5FiveAnchor : Set ℂ), z ∈
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2)) :
    Set.InjOn (fun z : ℂ ↦ connectedComponentIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2)) z)
      (Set.range p5FiveAnchor) := by
  have hL : 0 < L := by nlinarith
  have hvertical : ∀ y : ℝ, L ^ 2 ≤
      ‖(((y : ℂ) * Complex.I - (L : ℂ)) ^ 2 + (L : ℂ) ^ 2)‖ := by
    intro y
    exact Erdos1047DegreeRaise.real_square_factor_norm_ge_on_imaginary_axis (L := L) (E := L)
      (by simpa using le_rfl) y
  have hhalf : 0 ≤ L ^ 2 - (1 / 2 : ℝ) ^ 2 := by
    nlinarith [sq_nonneg (L - 1000)]
  have hupper : ∀ x : ℝ, x ≤ 0 → L ^ 2 - (1 / 2 : ℝ) ^ 2 ≤
      ‖(((x : ℂ) + (1 / 2 : ℝ) * Complex.I - (L : ℂ)) ^ 2 +
        (L : ℂ) ^ 2)‖ := by
    intro x hx
    simpa using (Erdos1047DegreeRaise.real_square_factor_norm_ge_on_left_halfline
      (L := L) (E := L) (a := (1 / 2 : ℝ))
      (le_of_lt hL) (by nlinarith [hhalf]) x hx)
  have hlower : ∀ x : ℝ, x ≤ 0 → L ^ 2 - (-1 / 2 : ℝ) ^ 2 ≤
      ‖(((x : ℂ) + (-1 / 2 : ℝ) * Complex.I - (L : ℂ)) ^ 2 +
        (L : ℂ) ^ 2)‖ := by
    intro x hx
    have hhalf' : 0 ≤ L ^ 2 - (-1 / 2 : ℝ) ^ 2 := by
      convert hhalf using 1 <;> norm_num
    simpa using (Erdos1047DegreeRaise.real_square_factor_norm_ge_on_left_halfline
      (L := L) (E := L) (a := (-1 / 2 : ℝ))
      (le_of_lt hL) (by nlinarith [hhalf']) x hx)
  have hright : ∀ x : ℝ, 0 ≤ x → L ^ 2 ≤
      ‖(((x : ℂ) - (L : ℂ)) ^ 2 + (L : ℂ) ^ 2)‖ := by
    intro x hx
    have hre : L ^ 2 ≤
        ((((x : ℂ) - (L : ℂ)) ^ 2 + (L : ℂ) ^ 2).re) := by
      norm_num [Complex.sub_re, Complex.sub_im, Complex.add_re,
        Complex.add_im, Complex.mul_re, Complex.mul_im, pow_two]
      nlinarith [sq_nonneg (x - L)]
    exact hre.trans (Complex.re_le_norm _)
  exact p5_component_map_injOn_of_raised_factor_barriers
    hLlarge hvertical hupper hlower hright hmem

/-! Concrete adapter for the real-square factor branch.  The separator proof
    is now discharged internally; only the transported certificate family and
    finiteness of the raised component collection remain as hypotheses. -/
theorem p5_real_square_nonconvex_lower_bound_of_certificate_data
    {L : ℝ} (hLlarge : 1000 ≤ L)
    (hcert : p5FiveCertificateFamily
      (fun z : ℂ =>
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2)).eval z)
      (p5WitnessLevel * L ^ 2))
    (hmem : ∀ z ∈ (Set.range p5FiveAnchor : Set ℂ), z ∈
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2))
    (hcompfin : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2))).Finite) :
    5 ≤ {t ∈ Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2)) |
      ¬ Convex ℝ t}.ncard := by
  have hinj := p5_component_map_injOn_of_real_square_factor hLlarge hmem
  have hbound := p5_certificate_family_nonconvex_lower_bound hcert
    (by simpa [Erdos1047.sublevelSet] using hinj) (by
      simpa [Erdos1047.sublevelSet] using hcompfin)
  simpa [Erdos1047.sublevelSet] using hbound

/-! The robust certificate family already contains the endpoint margin at each
    anchor.  Consequently the anchor-membership field used by the preceding
    real-square adapter is not an independent geometric obligation. -/
theorem p5_real_square_nonconvex_lower_bound_of_certificate_data_auto_mem
    {L : ℝ} (hLlarge : 1000 ≤ L)
    (hcert : p5FiveCertificateFamily
      (fun z : ℂ =>
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2)).eval z)
      (p5WitnessLevel * L ^ 2))
    (hcompfin : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2))).Finite) :
    5 ≤ {t ∈ Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2)) |
      ¬ Convex ℝ t}.ncard := by
  have hmem : ∀ z ∈ (Set.range p5FiveAnchor : Set ℂ), z ∈
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2) := by
    rintro z ⟨i, rfl⟩
    obtain ⟨hc⟩ := hcert i
    have hm := hc.lineA_margin (p5FiveAnchor i)
      (left_mem_segment ℝ (p5FiveAnchor i) (p5FivePointA i))
    change ‖(Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
      ((L : ℂ) ^ 2)).eval (p5FiveAnchor i)‖ ≤
      p5WitnessLevel * L ^ 2
    linarith [hm, hc.eps_pos]
  exact p5_real_square_nonconvex_lower_bound_of_certificate_data
    hLlarge hcert hmem hcompfin

/-! Regular-value variant of the real-square adapter.  The finite component
    hypothesis is discharged from the root-image exhaustion theorem, so the
    remaining analytic gate is a single closed-ball avoidance statement. -/
theorem p5_real_square_nonconvex_lower_bound_of_regular_values
    {L : ℝ} (hLlarge : 1000 ≤ L)
    (hcert : p5FiveCertificateFamily
      (fun z : ℂ =>
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2)).eval z)
      (p5WitnessLevel * L ^ 2))
    (hmem : ∀ z ∈ (Set.range p5FiveAnchor : Set ℂ), z ∈
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2))
    (hreg : Metric.closedBall (0 : ℂ) (p5WitnessLevel * L ^ 2) ⊆
      ((Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
        ((L : ℂ) ^ 2)).eval ''
        {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2)).derivative.eval u = 0})ᶜ) :
    5 ≤ {t ∈ Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2)) |
      ¬ Convex ℝ t}.ncard := by
  let q : ℂ[X] := Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
    ((L : ℂ) ^ 2)
  have hmonic : q.Monic := by
    exact Erdos1047DegreeRaise.raisePolynomial_monic p5Polynomial (L : ℂ)
      ((L : ℂ) ^ 2) p5Polynomial_monic
  have hc0 : 0 ≤ p5WitnessLevel * L ^ 2 := by
    have hp : 0 ≤ p5WitnessLevel := by
      norm_num [p5WitnessLevel, p5Level]
    positivity
  have hcompfin : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet q (p5WitnessLevel * L ^ 2))).Finite := by
    rw [componentsIn_eq_image_rootSet_of_regular_values hmonic hc0 (by
      simpa [q] using hreg)]
    exact (q.rootSet_finite ℂ).image _
  exact p5_real_square_nonconvex_lower_bound_of_certificate_data hLlarge
    hcert hmem (by simpa [q] using hcompfin)

/-! Regular-value adapter with the anchor-membership obligation discharged
    from the same robust family. -/
theorem p5_real_square_nonconvex_lower_bound_of_regular_values_auto_mem
    {L : ℝ} (hLlarge : 1000 ≤ L)
    (hcert : p5FiveCertificateFamily
      (fun z : ℂ =>
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2)).eval z)
      (p5WitnessLevel * L ^ 2))
    (hreg : Metric.closedBall (0 : ℂ) (p5WitnessLevel * L ^ 2) ⊆
      ((Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
        ((L : ℂ) ^ 2)).eval ''
        {u : ℂ | (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2)).derivative.eval u = 0})ᶜ) :
    5 ≤ {t ∈ Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2)) |
      ¬ Convex ℝ t}.ncard := by
  have hcompfin : (Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2))).Finite := by
    let q : ℂ[X] := Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
      ((L : ℂ) ^ 2)
    have hmonic : q.Monic := by
      exact Erdos1047DegreeRaise.raisePolynomial_monic p5Polynomial (L : ℂ)
        ((L : ℂ) ^ 2) p5Polynomial_monic
    have hc0 : 0 ≤ p5WitnessLevel * L ^ 2 := by
      have hp : 0 ≤ p5WitnessLevel := by
        norm_num [p5WitnessLevel, p5Level]
      positivity
    rw [show Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2)) (p5WitnessLevel * L ^ 2) =
        Erdos1047.sublevelSet q (p5WitnessLevel * L ^ 2) by rfl]
    rw [componentsIn_eq_image_rootSet_of_regular_values hmonic hc0 (by
      simpa [q] using hreg)]
    exact (q.rootSet_finite ℂ).image _
  exact p5_real_square_nonconvex_lower_bound_of_certificate_data_auto_mem
    hLlarge hcert hcompfin

/-! The final regularity input can be expressed as a strict critical-value
    norm estimate, matching the usual analytic formulation. -/
theorem p5_real_square_nonconvex_lower_bound_of_critical_value_bounds
    {L : ℝ} (hLlarge : 1000 ≤ L)
    (hcert : p5FiveCertificateFamily
      (fun z : ℂ =>
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2)).eval z)
      (p5WitnessLevel * L ^ 2))
    (hmem : ∀ z ∈ (Set.range p5FiveAnchor : Set ℂ), z ∈
      Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2))
    (hcrit : ∀ u : ℂ,
      (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
        ((L : ℂ) ^ 2)).derivative.eval u = 0 →
      p5WitnessLevel * L ^ 2 <
        ‖(Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2)).eval u‖) :
    5 ≤ {t ∈ Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2)) |
      ¬ Convex ℝ t}.ncard := by
  apply p5_real_square_nonconvex_lower_bound_of_regular_values hLlarge hcert hmem
  exact closedBall_subset_regular_values_of_critical_value_norm_gt hcrit

/-! Critical-value adapter with anchor membership recovered automatically. -/
theorem p5_real_square_nonconvex_lower_bound_of_critical_value_bounds_auto_mem
    {L : ℝ} (hLlarge : 1000 ≤ L)
    (hcert : p5FiveCertificateFamily
      (fun z : ℂ =>
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2)).eval z)
      (p5WitnessLevel * L ^ 2))
    (hcrit : ∀ u : ℂ,
      (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
        ((L : ℂ) ^ 2)).derivative.eval u = 0 →
      p5WitnessLevel * L ^ 2 <
        ‖(Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2)).eval u‖) :
    5 ≤ {t ∈ Erdos1047.componentsIn
      (Erdos1047.sublevelSet
        (Erdos1047DegreeRaise.raisePolynomial p5Polynomial (L : ℂ)
          ((L : ℂ) ^ 2))
        (p5WitnessLevel * L ^ 2)) |
      ¬ Convex ℝ t}.ncard := by
  apply p5_real_square_nonconvex_lower_bound_of_regular_values_auto_mem
