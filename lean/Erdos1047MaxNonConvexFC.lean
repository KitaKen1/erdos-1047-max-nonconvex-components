/- Source: Erdos1047StrictThresholdCore.lean; SHA256: 8ea48223f6cf7a6256784dd4c57779c08e68659c02e8246864282044c2b0ba55 -/
section


/-!
# Strict critical-value threshold interface

This file isolates the topological/cardinality part of the cubic upper-bound
argument for the exact strict target.  If two distinct roots can be joined to
one common point by paths staying in the strict sublevel, then their root
labels collide.  Once every strict component is represented by a root, this
forces a strict drop in component count.  Consequently a three-component
configuration can only occur below a supplied critical threshold.

The analytic construction of the paths is deliberately left as an explicit
hypothesis; this keeps the theorem reusable for the centered cubic and makes
the remaining gap precise rather than hiding it in an axiom.
-/

open Polynomial
open Set

namespace Erdos1047StrictThresholdCore

noncomputable section

theorem path_endpoints_same_connectedComponentIn
    {S : Set ℂ} {γ : ℝ → ℂ}
    (hcont : ContinuousOn γ (Set.Icc (0 : ℝ) 1))
    (hpath : ∀ t ∈ Set.Icc (0 : ℝ) 1, γ t ∈ S) :
    connectedComponentIn S (γ 0) = connectedComponentIn S (γ 1) := by
  have hImpre : IsPreconnected (γ '' Set.Icc (0 : ℝ) 1) :=
    isPreconnected_Icc.image γ hcont
  have hImsub : γ '' Set.Icc (0 : ℝ) 1 ⊆ S := by
    rintro z ⟨t, ht, rfl⟩
    exact hpath t ht
  have h0Im : γ 0 ∈ γ '' Set.Icc (0 : ℝ) 1 :=
    ⟨0, ⟨le_rfl, by norm_num⟩, rfl⟩
  have h1Im : γ 1 ∈ γ '' Set.Icc (0 : ℝ) 1 :=
    ⟨1, ⟨by norm_num, le_rfl⟩, rfl⟩
  have h1C : γ 1 ∈ connectedComponentIn S (γ 0) :=
    hImpre.subset_connectedComponentIn h0Im hImsub h1Im
  exact connectedComponentIn_eq h1C

theorem roots_collide_of_two_paths_to_common_point
    {S : Set ℂ} {r s q : ℂ}
    {γr γs : ℝ → ℂ}
    (hcont_r : ContinuousOn γr (Set.Icc (0 : ℝ) 1))
    (hmem_r : ∀ t ∈ Set.Icc (0 : ℝ) 1, γr t ∈ S)
    (hstart_r : γr 0 = r) (hend_r : γr 1 = q)
    (hcont_s : ContinuousOn γs (Set.Icc (0 : ℝ) 1))
    (hmem_s : ∀ t ∈ Set.Icc (0 : ℝ) 1, γs t ∈ S)
    (hstart_s : γs 0 = s) (hend_s : γs 1 = q) :
    connectedComponentIn S r = connectedComponentIn S s := by
  have hcr := path_endpoints_same_connectedComponentIn hcont_r hmem_r
  have hcs := path_endpoints_same_connectedComponentIn hcont_s hmem_s
  have hcr' : connectedComponentIn S r = connectedComponentIn S q := by
    simpa [hstart_r, hend_r] using hcr
  have hcs' : connectedComponentIn S s = connectedComponentIn S q := by
    simpa [hstart_s, hend_s] using hcs
  exact hcr'.trans hcs'.symm

theorem strict_componentsIn_ncard_lt_of_root_collision
    {S R : Set ℂ} (C : ℂ → Set ℂ)
    (hcomp : Erdos1047.componentsIn S = C '' R) (hRfin : R.Finite)
    (hcollision : ∃ r ∈ R, ∃ s ∈ R, r ≠ s ∧ C r = C s) :
    (Erdos1047.componentsIn S).ncard < R.ncard := by
  have hle : (C '' R).ncard ≤ R.ncard := Set.ncard_image_le hRfin
  have hne : (C '' R).ncard ≠ R.ncard := by
    intro heq
    have hinj : Set.InjOn C R := Set.injOn_of_ncard_image_eq heq hRfin
    obtain ⟨r, hr, s, hs, hrs, hC⟩ := hcollision
    exact hrs (hinj hr hs hC)
  rw [hcomp]
  exact Nat.lt_of_le_of_ne hle hne

/-! Three strict components rule out every level at or above a threshold once
the corresponding two-path collision package is available. -/
theorem strict_three_components_forces_strict_subcritical
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree)
    {c τ : ℝ} (hc : 0 < c)
    (hcount : (Erdos1047.componentsIn
      (Erdos1047.strictSublevelSet f c)).ncard = 3)
    (hroot : (f.rootSet ℂ).ncard = 3)
    (hpaths : ∀ hge : τ ≤ c ^ 2,
      ∃ r ∈ f.rootSet ℂ, ∃ s ∈ f.rootSet ℂ,
        ∃ q : ℂ, r ≠ s ∧
          (∃ γr : ℝ → ℂ,
            ContinuousOn γr (Set.Icc (0 : ℝ) 1) ∧
            (∀ t ∈ Set.Icc (0 : ℝ) 1,
              γr t ∈ Erdos1047.strictSublevelSet f c) ∧
            γr 0 = r ∧ γr 1 = q) ∧
          (∃ γs : ℝ → ℂ,
            ContinuousOn γs (Set.Icc (0 : ℝ) 1) ∧
            (∀ t ∈ Set.Icc (0 : ℝ) 1,
              γs t ∈ Erdos1047.strictSublevelSet f c) ∧
            γs 0 = s ∧ γs 1 = q)) :
    c ^ 2 < τ := by
  by_contra hnot
  have hge : τ ≤ c ^ 2 := le_of_not_gt hnot
  rcases hpaths hge with
    ⟨r, hr, s, hs, q, hrs, ⟨γr, hcr, hmr, hsr, her⟩,
      ⟨γs, hcs, hms, hss, hes⟩⟩
  let S : Set ℂ := Erdos1047.strictSublevelSet f c
  let R : Set ℂ := (↑(f.rootSet ℂ) : Set ℂ)
  let C : ℂ → Set ℂ := fun z => connectedComponentIn S z
  have himage : Erdos1047.componentsIn S = C '' R := by
    simpa [S, R, C] using
      (Erdos1047StrictGeneralCore.strict_componentsIn_eq_image_rootSet
        hf hdeg hc)
  have hcollision : ∃ r ∈ R, ∃ s ∈ R, r ≠ s ∧ C r = C s := by
    refine ⟨r, hr, s, hs, hrs, ?_⟩
    exact roots_collide_of_two_paths_to_common_point
      hcr hmr hsr her hcs hms hss hes
  have hlt := strict_componentsIn_ncard_lt_of_root_collision C himage
    (f.rootSet_finite ℂ) hcollision
  rw [hcount, hroot] at hlt
  omega

/-! A weaker but often more usable variant: if the path construction is only
available for genuinely supercritical levels (`τ < c²`), then three strict
components still force `c² ≤ τ`.  This is the exact conclusion obtainable
without a separate equality-case argument. -/
theorem strict_three_components_forces_not_strict_supercritical
    {f : ℂ[X]} (hf : f.Monic) (hdeg : 0 < f.degree)
    {c τ : ℝ} (hc : 0 < c)
    (hcount : (Erdos1047.componentsIn
      (Erdos1047.strictSublevelSet f c)).ncard = 3)
    (hroot : (f.rootSet ℂ).ncard = 3)
    (hpaths : ∀ hgt : τ < c ^ 2,
      ∃ r ∈ f.rootSet ℂ, ∃ s ∈ f.rootSet ℂ,
        ∃ q : ℂ, r ≠ s ∧
          (∃ γr : ℝ → ℂ,
            ContinuousOn γr (Set.Icc (0 : ℝ) 1) ∧
            (∀ t ∈ Set.Icc (0 : ℝ) 1,
              γr t ∈ Erdos1047.strictSublevelSet f c) ∧
            γr 0 = r ∧ γr 1 = q) ∧
          (∃ γs : ℝ → ℂ,
            ContinuousOn γs (Set.Icc (0 : ℝ) 1) ∧
            (∀ t ∈ Set.Icc (0 : ℝ) 1,
              γs t ∈ Erdos1047.strictSublevelSet f c) ∧
            γs 0 = s ∧ γs 1 = q)) :
    c ^ 2 ≤ τ := by
  by_contra hnot
  have hgt : τ < c ^ 2 := lt_of_not_ge hnot
  rcases hpaths hgt with
    ⟨r, hr, s, hs, q, hrs, ⟨γr, hcr, hmr, hsr, her⟩,
      ⟨γs, hcs, hms, hss, hes⟩⟩
  let S : Set ℂ := Erdos1047.strictSublevelSet f c
  let R : Set ℂ := (↑(f.rootSet ℂ) : Set ℂ)
  let C : ℂ → Set ℂ := fun z => connectedComponentIn S z
  have himage : Erdos1047.componentsIn S = C '' R := by
    simpa [S, R, C] using
      (Erdos1047StrictGeneralCore.strict_componentsIn_eq_image_rootSet
        hf hdeg hc)
  have hcollision : ∃ r ∈ R, ∃ s ∈ R, r ≠ s ∧ C r = C s := by
    refine ⟨r, hr, s, hs, hrs, ?_⟩
    exact roots_collide_of_two_paths_to_common_point
      hcr hmr hsr her hcs hms hss hes
  have hlt := strict_componentsIn_ncard_lt_of_root_collision C himage
    (f.rootSet_finite ℂ) hcollision
  rw [hcount, hroot] at hlt
  omega

#print axioms roots_collide_of_two_paths_to_common_point
#print axioms strict_componentsIn_ncard_lt_of_root_collision
#print axioms strict_three_components_forces_strict_subcritical
#print axioms strict_three_components_forces_not_strict_supercritical

end
end Erdos1047StrictThresholdCore

end

/- Source: Erdos1047StrictCubicPaths.lean; SHA256: a85ba14b27105e225ddedb60cec458fe3ad2db5d3af75ebddb5d49f311266de4 -/
section


/-!
# Strict paths for the centered cubic

For `z^3 - 3z + B`, the root-to-critical-point chord estimate is already
available in `Erdos1047CubicRootChordCore`.  This file converts its closed
bound into a strict path package whenever
`‖B - 2‖² < c²`.  The only remaining cubic-specific input is the existence of
two distinct roots with real part at least `-1`.
-/

open Polynomial
open Set

namespace Erdos1047StrictCubicPaths

noncomputable section

noncomputable def cubicPolynomial (B : ℂ) : ℂ[X] :=
  Polynomial.X ^ 3 - Polynomial.C 3 * Polynomial.X + Polynomial.C B

theorem cubicPolynomial_monic (B : ℂ) : (cubicPolynomial B).Monic := by
  unfold cubicPolynomial
  monicity!

theorem cubicPolynomial_natDegree (B : ℂ) : (cubicPolynomial B).natDegree = 3 := by
  unfold cubicPolynomial
  compute_degree!

theorem cubicPolynomial_eval_one (B : ℂ) :
    (cubicPolynomial B).eval (1 : ℂ) = B - 2 := by
  norm_num [cubicPolynomial]
  ring

theorem cubic_eval_segment_norm_le_of_root_re_ge_neg_one
    {B r : ℂ} {t : ℝ}
    (hrzero : (cubicPolynomial B).eval r = 0)
    (hr : -1 ≤ r.re) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    ‖(cubicPolynomial B).eval (r + (t : ℂ) * (1 - r))‖ ≤ ‖B - 2‖ := by
  have hz : r ^ 3 - 3 * r + B = 0 := by
    simpa [cubicPolynomial] using hrzero
  have hrel : B - 2 = -(r - 1) ^ 2 * (r + 2) := by
    linear_combination hz
  have hB : B = 2 - (r - 1) ^ 2 * (r + 2) := by
    linear_combination hrel
  let s : ℝ := 1 - t
  have hs0 : 0 ≤ s := by dsimp [s]; linarith
  have hs1 : s ≤ 1 := by dsimp [s]; linarith
  have hcore := Erdos1047CubicRootChord.affine_cubic_segment_norm_le
    (r := r) (s := s) hr hs0 hs1
  have heval : (cubicPolynomial B).eval (r + (t : ℂ) * (1 - r)) =
      (r - 1) ^ 2 *
        (-((1 - s ^ 3 : ℝ) : ℂ) * (r + 2) +
          3 * ((s ^ 2 : ℝ) : ℂ) * ((1 - s : ℝ) : ℂ)) := by
    dsimp [s]
    rw [hB]
    norm_num [cubicPolynomial]
    ring
  calc
    ‖(cubicPolynomial B).eval (r + (t : ℂ) * (1 - r))‖ =
        ‖r - 1‖ ^ 2 *
          ‖-((1 - s ^ 3 : ℝ) : ℂ) * (r + 2) +
            3 * ((s ^ 2 : ℝ) : ℂ) * ((1 - s : ℝ) : ℂ)‖ := by
      rw [heval, norm_mul, norm_pow]
    _ ≤ ‖r - 1‖ ^ 2 * ‖r + 2‖ := by
      exact mul_le_mul_of_nonneg_left hcore (by positivity)
    _ = ‖B - 2‖ := by
      calc
        ‖r - 1‖ ^ 2 * ‖r + 2‖ = ‖-(r - 1) ^ 2 * (r + 2)‖ := by
          rw [norm_mul, norm_neg, norm_pow]
        _ = ‖B - 2‖ := by rw [← hrel]

theorem strict_path_to_one_of_root_re_ge_neg_one
    {B r : ℂ} {c : ℝ}
    (hrzero : (cubicPolynomial B).eval r = 0)
    (hr : -1 ≤ r.re) (hc : 0 ≤ c)
    (hcrit : Complex.normSq (B - 2) < c ^ 2) :
    ∃ γ : ℝ → ℂ,
      ContinuousOn γ (Set.Icc (0 : ℝ) 1) ∧
      (∀ t ∈ Set.Icc (0 : ℝ) 1,
        γ t ∈ Erdos1047.strictSublevelSet (cubicPolynomial B) c) ∧
      γ 0 = r ∧ γ 1 = 1 := by
  have hcrit' : ‖B - 2‖ ^ 2 < c ^ 2 := by
    simpa [Complex.normSq_eq_norm_sq] using hcrit
  have hnormcrit : ‖B - 2‖ < c := by
    nlinarith [norm_nonneg (B - 2)]
  let γ : ℝ → ℂ := fun t => r + (t : ℂ) * (1 - r)
  have hcont : ContinuousOn γ (Set.Icc (0 : ℝ) 1) := by
    dsimp [γ]
    fun_prop
  have hmem : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      γ t ∈ Erdos1047.strictSublevelSet (cubicPolynomial B) c := by
    intro t ht
    change ‖(cubicPolynomial B).eval (r + (t : ℂ) * (1 - r))‖ < c
    exact (cubic_eval_segment_norm_le_of_root_re_ge_neg_one hrzero hr
      ht.1 ht.2).trans_lt hnormcrit
  refine ⟨γ, hcont, hmem, ?_, ?_⟩
  · simp [γ]
  · simp [γ]

/-! With `Re B ≥ 0`, the Vieta lemma from the shared root-chord core says
that at most one distinct root can lie in `Re z < -1`.  A cubic with three
distinct roots therefore has two roots on the complementary side. -/
theorem cubic_exists_two_roots_re_ge_neg_one
    {B : ℂ} (hB : 0 ≤ B.re)
    (hroot : ((cubicPolynomial B).rootSet ℂ).ncard = 3) :
    ∃ r ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ s ∈ (cubicPolynomial B).rootSet ℂ, r ≠ s ∧
        -1 ≤ r.re ∧ -1 ≤ s.re := by
  let R : Set ℂ := (↑((cubicPolynomial B).rootSet ℂ) : Set ℂ)
  let L : Set ℂ := {z : ℂ | z ∈ R ∧ z.re < -1}
  let G : Set ℂ := {z : ℂ | z ∈ R ∧ -1 ≤ z.re}
  have hRfin : R.Finite := (cubicPolynomial B).rootSet_finite ℂ
  have hLfin : L.Finite := hRfin.subset (by intro z hz; exact hz.1)
  have hGfin : G.Finite := hRfin.subset (by intro z hz; exact hz.1)
  have hLsub : L.Subsingleton := by
    intro r hr s hs
    by_contra hrs
    have hrzero : r ^ 3 - 3 * r + B = 0 := by
      simpa [cubicPolynomial] using
        (cubicPolynomial_monic B).mem_rootSet.mp hr.1
    have hszero : s ^ 3 - 3 * s + B = 0 := by
      simpa [cubicPolynomial] using
        (cubicPolynomial_monic B).mem_rootSet.mp hs.1
    apply Erdos1047CubicRootChord.not_two_roots_re_lt_neg_one hB
      hrzero hszero hrs hr.2 hs.2
  have hLcard : L.ncard ≤ 1 := (Set.ncard_le_one_iff_subsingleton).2 hLsub
  have hdisj : Disjoint G L := by
    rw [Set.disjoint_left]
    intro z hzG hzL
    linarith [hzG.2, hzL.2]
  have hRU : R = G ∪ L := by
    ext z
    constructor
    · intro hz
      by_cases h : -1 ≤ z.re
      · exact Or.inl ⟨hz, h⟩
      · exact Or.inr ⟨hz, lt_of_not_ge h⟩
    · intro hz
      exact hz.elim (fun h => h.1) (fun h => h.1)
  have hRcard : R.ncard = 3 := by simpa [R] using hroot
  have hcard : R.ncard = G.ncard + L.ncard := by
    rw [hRU, Set.ncard_union_eq hdisj hGfin hLfin]
  have hGgt : 1 < G.ncard := by omega
  obtain ⟨r, hrG, s, hsG, hrs⟩ := Set.one_lt_ncard hGfin |>.mp hGgt
  exact ⟨r, hrG.1, s, hsG.1, hrs, hrG.2, hsG.2⟩

theorem strict_two_paths_to_one_of_root_pair
    {B r s : ℂ} {c : ℝ}
    (hrzero : (cubicPolynomial B).eval r = 0)
    (hszero : (cubicPolynomial B).eval s = 0)
    (hr : -1 ≤ r.re) (hs : -1 ≤ s.re)
    (hc : 0 ≤ c) (hcrit : Complex.normSq (B - 2) < c ^ 2)
    (hrs : r ≠ s) :
    ∃ γr γs : ℝ → ℂ, r ≠ s ∧
      ContinuousOn γr (Set.Icc (0 : ℝ) 1) ∧
      (∀ t ∈ Set.Icc (0 : ℝ) 1,
        γr t ∈ Erdos1047.strictSublevelSet (cubicPolynomial B) c) ∧
      γr 0 = r ∧ γr 1 = 1 ∧
      ContinuousOn γs (Set.Icc (0 : ℝ) 1) ∧
      (∀ t ∈ Set.Icc (0 : ℝ) 1,
        γs t ∈ Erdos1047.strictSublevelSet (cubicPolynomial B) c) ∧
      γs 0 = s ∧ γs 1 = 1 := by
  rcases strict_path_to_one_of_root_re_ge_neg_one hrzero hr hc hcrit with
    ⟨γr, hcr, hmr, hsr, her⟩
  rcases strict_path_to_one_of_root_re_ge_neg_one hszero hs hc hcrit with
    ⟨γs, hcs, hms, hss, hes⟩
  exact ⟨γr, γs, hrs, hcr, hmr, hsr, her, hcs, hms, hss, hes⟩

theorem strict_two_root_paths_to_one_of_rootSet_pair
    {B r s : ℂ} {c : ℝ}
    (hr : r ∈ (cubicPolynomial B).rootSet ℂ)
    (hs : s ∈ (cubicPolynomial B).rootSet ℂ)
    (hrre : -1 ≤ r.re) (hsre : -1 ≤ s.re)
    (hc : 0 ≤ c) (hcrit : Complex.normSq (B - 2) < c ^ 2)
    (hrs : r ≠ s) :
    ∃ γr γs : ℝ → ℂ, r ≠ s ∧
      ContinuousOn γr (Set.Icc (0 : ℝ) 1) ∧
      (∀ t ∈ Set.Icc (0 : ℝ) 1,
        γr t ∈ Erdos1047.strictSublevelSet (cubicPolynomial B) c) ∧
      γr 0 = r ∧ γr 1 = 1 ∧
      ContinuousOn γs (Set.Icc (0 : ℝ) 1) ∧
      (∀ t ∈ Set.Icc (0 : ℝ) 1,
        γs t ∈ Erdos1047.strictSublevelSet (cubicPolynomial B) c) ∧
      γs 0 = s ∧ γs 1 = 1 := by
  have hrzero : (cubicPolynomial B).eval r = 0 :=
    (cubicPolynomial_monic B).mem_rootSet.mp hr
  have hszero : (cubicPolynomial B).eval s = 0 :=
    (cubicPolynomial_monic B).mem_rootSet.mp hs
  exact strict_two_paths_to_one_of_root_pair hrzero hszero hrre hsre hc hcrit hrs

/-! End-to-end centered-cubic threshold interface.  Supplying the elementary
root-placement statement (two distinct roots with real part at least `-1` at
each genuinely supercritical level) now rules out strict three-component
configurations above the critical value. -/
theorem centered_cubic_three_components_forces_not_supercritical
    {B : ℂ} {c : ℝ} (hc : 0 < c)
    (hcount : (Erdos1047.componentsIn
      (Erdos1047.strictSublevelSet (cubicPolynomial B) c)).ncard = 3)
    (hroot : ((cubicPolynomial B).rootSet ℂ).ncard = 3)
    (hpair : ∀ hgt : Complex.normSq (B - 2) < c ^ 2,
      ∃ r ∈ (cubicPolynomial B).rootSet ℂ,
      ∃ s ∈ (cubicPolynomial B).rootSet ℂ,
        r ≠ s ∧ -1 ≤ r.re ∧ -1 ≤ s.re) :
    c ^ 2 ≤ Complex.normSq (B - 2) := by
  have hdeg : 0 < (cubicPolynomial B).degree := by
    rw [degree_eq_natDegree (cubicPolynomial_monic B).ne_zero]
    exact_mod_cast (show 0 < (cubicPolynomial B).natDegree by
      rw [cubicPolynomial_natDegree]
      norm_num)
  apply Erdos1047StrictThresholdCore.strict_three_components_forces_not_strict_supercritical
    (hf := cubicPolynomial_monic B) hdeg hc hcount hroot
  intro hgt
  rcases hpair hgt with ⟨r, hr, s, hs, hrs, hrre, hsre⟩
  rcases strict_two_root_paths_to_one_of_rootSet_pair hr hs hrre hsre
      (le_of_lt hc) hgt hrs with
    ⟨γr, γs, hrs', hcr, hmr, hsr, her, hcs, hms, hss, hes⟩
  refine ⟨r, hr, s, hs, 1, ?_⟩
  exact ⟨hrs', ⟨γr, hcr, hmr, hsr, her⟩,
    ⟨γs, hcs, hms, hss, hes⟩⟩

theorem centered_cubic_three_components_forces_not_supercritical_of_root_count
    {B : ℂ} {c : ℝ} (hB : 0 ≤ B.re) (hc : 0 < c)
    (hcount : (Erdos1047.componentsIn
      (Erdos1047.strictSublevelSet (cubicPolynomial B) c)).ncard = 3)
    (hroot : ((cubicPolynomial B).rootSet ℂ).ncard = 3) :
    c ^ 2 ≤ Complex.normSq (B - 2) := by
  apply centered_cubic_three_components_forces_not_supercritical hc hcount hroot
  intro hgt
  rcases cubic_exists_two_roots_re_ge_neg_one hB hroot with
    ⟨r, hr, s, hs, hrs, hrre, hsre⟩
  exact ⟨r, hr, s, hs, hrs, hrre, hsre⟩

#print axioms strict_path_to_one_of_root_re_ge_neg_one
#print axioms strict_two_root_paths_to_one_of_rootSet_pair
#print axioms centered_cubic_three_components_forces_not_supercritical
#print axioms cubic_exists_two_roots_re_ge_neg_one
#print axioms centered_cubic_three_components_forces_not_supercritical_of_root_count

end
end Erdos1047StrictCubicPaths

end

/- Source: Erdos1047StrictCubicUpper.lean; SHA256: 11fee469de595e92a485b23fcefa134d9307f6722b517260409c72c58658768c -/
section


/-!
The FC target carries the same centered-cubic interface as the standalone
Lean4Web target.  Keep this bridge local to the strict-cubic file so the FC
package does not need to depend on the Lean4Web package (which would make the
shared core module names ambiguous to Lake).
-/
namespace Erdos1047Lean4Web

noncomputable section

abbrev sublevelSet := Erdos1047.sublevelSet
abbrev cubicPolynomial := Erdos1047Proof.cubicPolynomial
abbrev cubicBarrier := Erdos1047Proof.cubicBarrier
abbrev continuous_cubicBarrier := Erdos1047Proof.continuous_cubicBarrier
abbrev cubicBarrier_neg_iff := Erdos1047Proof.cubicBarrier_neg_iff
abbrev cubic_boundary_normSq := Erdos1047Proof.cubic_boundary_normSq
abbrev cubic_convex_of_subcritical := Erdos1047Proof.cubic_convex_of_subcritical
abbrev cubicPolynomial_monic := Erdos1047Proof.cubicPolynomial_monic
abbrev cubicPolynomial_natDegree := Erdos1047Proof.cubicPolynomial_natDegree
abbrev cubic_exists_root_left := Erdos1047Proof.cubic_exists_root_left
abbrev pathConnected_component_of_isOpen
    {S : Set ℂ} {r : ℂ} (hr : r ∈ S)
    (hop : IsOpen (connectedComponentIn S r)) :
    IsPathConnected (connectedComponentIn S r) :=
  Erdos1047Proof.pathConnected_component_of_isOpen hr hop
abbrev affine_image_nonconvex_components_ncard
    {S : Set ℂ} (center d : ℂ) (hd : d ≠ 0) :
    {t | t ∈ Erdos1047.componentsIn ((fun z : ℂ => center + d * z) '' S) ∧
      ¬ Convex ℝ t}.ncard =
      {t | t ∈ Erdos1047.componentsIn S ∧ ¬ Convex ℝ t}.ncard :=
  Erdos1047Proof.affine_image_nonconvex_components_ncard center d hd

end
end Erdos1047Lean4Web

/-!
# Strict cubic convex-component bridge

The closed centered-cubic proof already establishes convexity below the first
critical level.  This file supplies the missing strict-set transfer.  Given
two points in one strict component, a compact path between them has a maximum
strictly below the ambient level; lowering to an intermediate level places the
two points in one closed subcritical component.  The closed convexity theorem
then puts the whole chord below the original strict level.

The argument also handles the critical equality case
`c² = ‖B - 2‖²`: the intermediate level is chosen from the path margin, so
the closed theorem is always used with a genuinely strict subcritical gap.
-/

open Polynomial
open Set
open scoped Topology

namespace Erdos1047StrictCubicUpper

noncomputable section

open Erdos1047Lean4Web

private theorem connectedComponentIn_mono
    {S T : Set ℂ} (hST : S ⊆ T) {x : ℂ} (hx : x ∈ S) :
    connectedComponentIn S x ⊆ connectedComponentIn T x := by
  intro y hy
  have hST' : connectedComponentIn S x ⊆ T :=
    (connectedComponentIn_subset S x).trans hST
  exact isPreconnected_connectedComponentIn.subset_connectedComponentIn
    (mem_connectedComponentIn hx) hST' hy

theorem strict_cubic_component_stays_left
    (B : ℂ) (c : ℝ) (r : ℂ)
    (hB : 0 ≤ B.re) (hcrit : c ^ 2 ≤ Complex.normSq (B - 2))
    (hr : r ∈ Erdos1047.strictSublevelSet
      (Erdos1047Lean4Web.cubicPolynomial B) c)
    (hleft : Erdos1047Lean4Web.cubicBarrier r < 0) :
    ∀ z ∈ connectedComponentIn
      (Erdos1047.strictSublevelSet (Erdos1047Lean4Web.cubicPolynomial B) c) r,
      Erdos1047Lean4Web.cubicBarrier z < 0 := by
  let S : Set ℂ := Erdos1047.strictSublevelSet
    (Erdos1047Lean4Web.cubicPolynomial B) c
  have hzero : ∀ z ∈ S, Erdos1047Lean4Web.cubicBarrier z ≠ 0 := by
    intro z hz hboundary
    have hzlevel : ‖(Erdos1047Lean4Web.cubicPolynomial B).eval z‖ < c := hz
    have hsq : Complex.normSq
        ((Erdos1047Lean4Web.cubicPolynomial B).eval z) < c ^ 2 := by
      rw [Complex.normSq_eq_norm_sq]
      nlinarith [norm_nonneg
        ((Erdos1047Lean4Web.cubicPolynomial B).eval z)]
    have hbound := Erdos1047Lean4Web.cubic_boundary_normSq z B hB hboundary
    have hbound' : Complex.normSq
        ((Erdos1047Lean4Web.cubicPolynomial B).eval z) ≥
        Complex.normSq (B - 2) := by
      simpa [Erdos1047Proof.cubicPolynomial,
        Erdos1047CubicBarrier.cubicValue] using hbound
    linarith
  intro z hz
  have hrS : r ∈ S := by simpa [S] using hr
  exact Erdos1047CubicLower.negative_on_component
    (S := S) (r := r) (φ := Erdos1047Lean4Web.cubicBarrier)
    Erdos1047Lean4Web.continuous_cubicBarrier hzero hrS hleft z hz

theorem strict_component_convex_of_le_critical
    (B : ℂ) (c : ℝ) (r : ℂ)
    (hB : 0 ≤ B.re) (hc : 0 < c)
    (hcrit : c ^ 2 ≤ Complex.normSq (B - 2))
    (hr : r ∈ Erdos1047.strictSublevelSet
      (Erdos1047Lean4Web.cubicPolynomial B) c)
    (hleft : Erdos1047Lean4Web.cubicBarrier r < 0) :
    Convex ℝ (connectedComponentIn
      (Erdos1047.strictSublevelSet (Erdos1047Lean4Web.cubicPolynomial B) c) r) := by
  let P : ℂ[X] := Erdos1047Lean4Web.cubicPolynomial B
  let S : Set ℂ := Erdos1047.strictSublevelSet P c
  let C : Set ℂ := connectedComponentIn S r
  have hSopen : IsOpen S := by
    exact isOpen_lt (continuous_norm.comp P.continuous_aeval) continuous_const
  have hCopen : IsOpen C := by
    dsimp [C]
    exact hSopen.connectedComponentIn
  have hpath : IsPathConnected C := by
    apply Erdos1047Lean4Web.pathConnected_component_of_isOpen
    · have hrS : r ∈ S := by simpa [S] using hr
      exact hrS
    · exact hCopen
  have hstay : ∀ z ∈ C, Erdos1047Lean4Web.cubicBarrier z < 0 := by
    intro z hz
    exact strict_cubic_component_stays_left B c r hB hcrit hr hleft z hz
  rw [convex_iff_segment_subset]
  intro x hx y hy
  obtain ⟨γ, hγ⟩ := hpath.joinedIn x hx y hy
  let φ : unitInterval → ℝ := fun t => ‖P.eval (γ t)‖
  have hφcont : Continuous φ := by
    dsimp [φ]
    fun_prop
  obtain ⟨tm, htm, hmax⟩ :=
    (isCompact_univ.exists_isMaxOn (f := φ)
      (Set.univ_nonempty : (Set.univ : Set unitInterval).Nonempty)
      hφcont.continuousOn)
  have hm_lt : φ tm < c := by
    have htmC : γ tm ∈ C := hγ tm
    have htmS : γ tm ∈ S := connectedComponentIn_subset S r htmC
    exact htmS
  let d : ℝ := (φ tm + c) / 2
  have hdm : φ tm < d := by
    dsimp [d]
    linarith
  have hdc : d < c := by
    dsimp [d]
    linarith
  have hdpos : 0 ≤ d := by
    have hnon : 0 ≤ φ tm := norm_nonneg _
    dsimp [d]
    linarith
  have hdp : 0 < d := by
    have hnon : 0 ≤ φ tm := norm_nonneg _
    dsimp [d]
    linarith
  have hdcrit : d ^ 2 < Complex.normSq (B - 2) := by
    have hdc_sq : d ^ 2 < c ^ 2 := by
      nlinarith [sq_nonneg d, sq_nonneg c]
    exact hdc_sq.trans_le hcrit
  have hpath_strict : ∀ t : unitInterval,
      γ t ∈ Erdos1047.strictSublevelSet P d := by
    intro t
    have hle : φ t ≤ φ tm := hmax (Set.mem_univ t)
    have hle' : ‖P.eval (γ t)‖ ≤ φ tm := by
      simpa [φ] using hle
    change ‖P.eval (γ t)‖ < d
    exact hle'.trans_lt hdm
  have hx_strict : x ∈ Erdos1047.strictSublevelSet P d := by
    simpa only [γ.source] using hpath_strict (0 : unitInterval)
  have hy_strict : y ∈ Erdos1047.strictSublevelSet P d := by
    simpa only [γ.target] using hpath_strict (1 : unitInterval)
  have hdegree : 0 < P.degree := by
    dsimp [P]
    rw [degree_eq_natDegree (Erdos1047Lean4Web.cubicPolynomial_monic B).ne_zero]
    exact_mod_cast (show 0 <
      (Erdos1047Lean4Web.cubicPolynomial B).natDegree by
      rw [Erdos1047Lean4Web.cubicPolynomial_natDegree]
      norm_num)
  obtain ⟨rr, hrrroot, hrrcomp⟩ :=
    Erdos1047StrictGeneralCore.strict_exists_root_in_component
      (hf := Erdos1047Lean4Web.cubicPolynomial_monic B) hdegree hdp x hx_strict
  have hrr_strict : rr ∈ Erdos1047.strictSublevelSet P d :=
    connectedComponentIn_subset _ _ hrrcomp
  have hSsmall : Erdos1047.strictSublevelSet P d ⊆ S := by
    intro z hz
    change ‖P.eval z‖ < c
    change ‖P.eval z‖ < d at hz
    exact hz.trans hdc
  have hrrC : rr ∈ C := by
    have hrrx : rr ∈ connectedComponentIn S x :=
      connectedComponentIn_mono hSsmall
        (show x ∈ Erdos1047.strictSublevelSet P d from hx_strict) hrrcomp
    have hxC : x ∈ C := by simpa [C, S, P] using hx
    have hEq : connectedComponentIn S r = connectedComponentIn S x :=
      connectedComponentIn_eq hxC
    have hrrr : rr ∈ connectedComponentIn S r := hEq.symm ▸ hrrx
    simpa [C] using hrrr
  have hrrleft : Erdos1047Lean4Web.cubicBarrier rr < 0 := hstay rr hrrC
  let K : Set ℂ := Erdos1047Lean4Web.sublevelSet P d
  have hsmallK : Erdos1047.strictSublevelSet P d ⊆ K := by
    intro z hz
    change ‖P.eval z‖ ≤ d
    change ‖P.eval z‖ < d at hz
    exact hz.le
  have hxK : x ∈ K := hsmallK hx_strict
  have hyK : y ∈ K := hsmallK hy_strict
  have hrrK : rr ∈ K := by
    change ‖P.eval rr‖ ≤ d
    have hzero : P.eval rr = 0 :=
      (Erdos1047Lean4Web.cubicPolynomial_monic B).mem_rootSet.mp hrrroot
    rw [hzero, norm_zero]
    exact hdpos
  have hrrKx : rr ∈ connectedComponentIn K x := by
    exact connectedComponentIn_mono hsmallK hx_strict hrrcomp
  have hpathK : IsPreconnected (γ '' (Set.univ : Set unitInterval)) :=
    isPreconnected_univ.image γ γ.continuous.continuousOn
  have hpathKsub : γ '' (Set.univ : Set unitInterval) ⊆ K := by
    rintro z ⟨t, _, rfl⟩
    exact hsmallK (hpath_strict t)
  have hximg : x ∈ γ '' (Set.univ : Set unitInterval) := by
    exact ⟨0, Set.mem_univ _, γ.source⟩
  have hyimg : y ∈ γ '' (Set.univ : Set unitInterval) := by
    exact ⟨1, Set.mem_univ _, γ.target⟩
  have hyKx : y ∈ connectedComponentIn K x :=
    hpathK.subset_connectedComponentIn hximg hpathKsub hyimg
  have hcomp_eq : connectedComponentIn K x = connectedComponentIn K rr :=
    connectedComponentIn_eq hrrKx
  have hxKrr : x ∈ connectedComponentIn K rr := by
    rw [← hcomp_eq]
    exact mem_connectedComponentIn hxK
  have hyKrr : y ∈ connectedComponentIn K rr := by
    rw [← hcomp_eq]
    exact hyKx
  have hconvK : Convex ℝ (connectedComponentIn K rr) := by
    dsimp [K, P] at hrrK hrrleft ⊢
    exact Erdos1047Lean4Web.cubic_convex_of_subcritical B d rr hB hdcrit hrrK hrrleft
  intro z hz
  have hzK : z ∈ connectedComponentIn K rr :=
    (convex_iff_segment_subset.mp hconvK) hxKrr hyKrr hz
  have hzlevel : ‖P.eval z‖ ≤ d := connectedComponentIn_subset K rr hzK
  have hzCx : z ∈ connectedComponentIn S x := by
    have hsegS : segment ℝ x y ⊆ S := by
      intro w hw
      have hwK : w ∈ connectedComponentIn K rr :=
        (convex_iff_segment_subset.mp hconvK) hxKrr hyKrr hw
      have hwlevel : ‖P.eval w‖ ≤ d := connectedComponentIn_subset K rr hwK
      change ‖P.eval w‖ < c
      exact hwlevel.trans_lt hdc
    exact (convex_segment x y).isPreconnected.subset_connectedComponentIn
      (left_mem_segment ℝ x y) hsegS hz
  have hxC : x ∈ C := by simpa [C, S, P] using hx
  have hEq : connectedComponentIn S r = connectedComponentIn S x :=
    connectedComponentIn_eq hxC
  have hzC : z ∈ connectedComponentIn S r := hEq.symm ▸ hzCx
  simpa [C] using hzC

/-! The centered-cubic count reduction.  If there are fewer than three strict
components, the general root bound already gives the desired estimate.  If
there are exactly three, root-image bookkeeping forces three distinct roots;
the path threshold then supplies `c² ≤ ‖B-2‖²`, and the left barrier component
is convex by the preceding transfer theorem. -/
theorem strict_centered_cubic_nonconvex_ncard_le_two
    {B : ℂ} {c : ℝ} (hB : 0 ≤ B.re) (hc : 0 < c) :
    {t ∈ Erdos1047.componentsIn
        (Erdos1047.strictSublevelSet
          (Erdos1047Lean4Web.cubicPolynomial B) c) |
      ¬ Convex ℝ t}.ncard ≤ 2 := by
  let P : ℂ[X] := Erdos1047Lean4Web.cubicPolynomial B
  let S : Set ℂ := Erdos1047.strictSublevelSet P c
  let Cset : Set (Set ℂ) := Erdos1047.componentsIn S
  let N : Set (Set ℂ) := {t ∈ Cset | ¬ Convex ℝ t}
  have hmonic : P.Monic := by
    dsimp [P]
    exact Erdos1047Lean4Web.cubicPolynomial_monic B
  have hdegree : 0 < P.degree := by
    dsimp [P]
    rw [degree_eq_natDegree (Erdos1047Lean4Web.cubicPolynomial_monic B).ne_zero]
    rw [Erdos1047Lean4Web.cubicPolynomial_natDegree]
    norm_num
  have hcompfin : Cset.Finite := by
    dsimp [Cset, S]
    rw [Erdos1047StrictGeneralCore.strict_componentsIn_eq_image_rootSet
      hmonic hdegree hc]
    exact (P.rootSet_finite ℂ).image _
  have hcomp_le : Cset.ncard ≤ 3 := by
    dsimp [Cset, S]
    simpa [P, Erdos1047Proof.cubicPolynomial_natDegree] using
      (Erdos1047StrictGeneralCore.strict_componentsIn_ncard_le_natDegree
        hmonic hdegree hc)
  have hNsub : N ⊆ Cset := by
    intro t ht
    exact ht.1
  have hN_le_comp : N.ncard ≤ Cset.ncard :=
    Set.ncard_le_ncard hNsub hcompfin
  by_cases hcount3 : Cset.ncard = 3
  · have hcomp_le_root : Cset.ncard ≤ (P.rootSet ℂ).ncard := by
      dsimp [Cset, S]
      rw [Erdos1047StrictGeneralCore.strict_componentsIn_eq_image_rootSet
        hmonic hdegree hc]
      exact Set.ncard_image_le (P.rootSet_finite ℂ)
    have hroot_le : (P.rootSet ℂ).ncard ≤ 3 := by
      simpa [P, Erdos1047Proof.cubicPolynomial_natDegree] using
        (Polynomial.ncard_rootSet_le P ℂ)
    have hroot3 : (P.rootSet ℂ).ncard = 3 := by omega
    have hcount3' :
        (Erdos1047.componentsIn
          (Erdos1047.strictSublevelSet
            (Erdos1047StrictCubicPaths.cubicPolynomial B) c)).ncard = 3 := by
      simpa [Cset, S, P, Erdos1047StrictCubicPaths.cubicPolynomial,
        Erdos1047Proof.cubicPolynomial] using hcount3
    have hroot3' :
        ((Erdos1047StrictCubicPaths.cubicPolynomial B).rootSet ℂ).ncard = 3 := by
      simpa [P, Erdos1047StrictCubicPaths.cubicPolynomial,
        Erdos1047Proof.cubicPolynomial] using hroot3
    have hcrit : c ^ 2 ≤ Complex.normSq (B - 2) := by
      apply Erdos1047StrictCubicPaths.centered_cubic_three_components_forces_not_supercritical_of_root_count
        hB hc
      · exact hcount3'
      · exact hroot3'
    obtain ⟨r, hrzero, hrleft, hrregion⟩ :=
      Erdos1047Lean4Web.cubic_exists_root_left B hB
    have hrroot : r ∈ P.rootSet ℂ := by
      apply hmonic.mem_rootSet.mpr
      simpa [P] using hrzero
    have hrS : r ∈ S := by
      change ‖P.eval r‖ < c
      have hzero : P.eval r = 0 := hmonic.mem_rootSet.mp hrroot
      rw [hzero, norm_zero]
      exact hc
    have hleft : Erdos1047Lean4Web.cubicBarrier r < 0 := by
      exact (Erdos1047Lean4Web.cubicBarrier_neg_iff r).mpr
        ⟨hrleft, hrregion⟩
    have hconv : Convex ℝ (connectedComponentIn S r) := by
      simpa [S, P] using
        (strict_component_convex_of_le_critical B c r hB hc hcrit hrS hleft)
    have hproper : N ⊂ Cset := by
      refine ⟨hNsub, ?_⟩
      intro hreverse
      have htC : connectedComponentIn S r ∈ Cset := by
        exact ⟨r, hrS, rfl⟩
      have htN := hreverse htC
      exact htN.2 hconv
    have hlt : N.ncard < Cset.ncard := Set.ncard_lt_ncard hproper hcompfin
    have hNle : N.ncard ≤ 2 := by omega
    simpa [N, Cset, S, P] using hNle
  · have hcount_le_two : Cset.ncard ≤ 2 := by omega
    have hNle : N.ncard ≤ 2 := hN_le_comp.trans hcount_le_two
    simpa [N, Cset, S, P] using hNle

/-! Strict affine transport for the cubic normal form.  This is the set-level
identity needed to pass the centered result to an arbitrary monic cubic; the
component and convexity transport is already available in the normalization
core. -/
theorem affine_image_normalized_strictSublevelSet_eq
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3) {d : ℂ}
    (hd0 : d ≠ 0) (hd : d ^ 2 =
      -Erdos1047CubicNormalize.cubicLinear f / 3) (c : ℝ) :
    (fun z : ℂ => Erdos1047CubicNormalize.cubicCenter f + d * z) ''
        Erdos1047.strictSublevelSet
          (Erdos1047CubicNormalize.normalizedCubic f d) c =
      Erdos1047.strictSublevelSet f (‖d‖ ^ 3 * c) := by
  ext w
  constructor
  · rintro ⟨z, hz, rfl⟩
    change ‖f.eval (Erdos1047CubicNormalize.cubicCenter f + d * z)‖ <
      ‖d‖ ^ 3 * c
    change ‖(Erdos1047CubicNormalize.normalizedCubic f d).eval z‖ < c at hz
    rw [Erdos1047CubicNormalize.monic_cubic_eval_normalized_as_polynomial
      f hf hdeg hd0 hd z, norm_mul, norm_pow]
    exact mul_lt_mul_of_pos_left hz (by positivity)
  · intro hw
    change ‖f.eval w‖ < ‖d‖ ^ 3 * c at hw
    let z : ℂ := (w - Erdos1047CubicNormalize.cubicCenter f) / d
    have hmap : Erdos1047CubicNormalize.cubicCenter f + d * z = w := by
      dsimp [z]
      field_simp [hd0]
      ring
    refine ⟨z, ?_, hmap⟩
    change ‖(Erdos1047CubicNormalize.normalizedCubic f d).eval z‖ < c
    have hevalmap : f.eval w = d ^ 3 *
        (Erdos1047CubicNormalize.normalizedCubic f d).eval z := by
      rw [← hmap]
      exact Erdos1047CubicNormalize.monic_cubic_eval_normalized_as_polynomial
        f hf hdeg hd0 hd z
    have hleft :
        ‖d‖ ^ 3 * ‖(Erdos1047CubicNormalize.normalizedCubic f d).eval z‖ =
          ‖f.eval w‖ := by
      rw [hevalmap, norm_mul, norm_pow]
    apply lt_of_mul_lt_mul_left (a := ‖d‖ ^ 3) ?_
      (show 0 ≤ ‖d‖ ^ 3 by
        have : 0 < ‖d‖ := norm_pos_iff.mpr hd0
        positivity)
    rw [hleft]
    exact hw

theorem affine_image_normalized_strict_nonconvex_components_ncard
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3) {d : ℂ}
    (hd0 : d ≠ 0) (hd : d ^ 2 =
      -Erdos1047CubicNormalize.cubicLinear f / 3) (c : ℝ) :
    {t ∈ Erdos1047.componentsIn
        (Erdos1047.strictSublevelSet f (‖d‖ ^ 3 * c)) |
      ¬ Convex ℝ t}.ncard =
      {t ∈ Erdos1047.componentsIn
          (Erdos1047.strictSublevelSet
            (Erdos1047CubicNormalize.normalizedCubic f d) c) |
        ¬ Convex ℝ t}.ncard := by
  rw [← affine_image_normalized_strictSublevelSet_eq f hf hdeg hd0 hd c]
  exact Erdos1047Lean4Web.affine_image_nonconvex_components_ncard
    (Erdos1047CubicNormalize.cubicCenter f) d hd0

theorem strict_monic_cubic_nonconvex_ncard_le_two_of_normalized
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3)
    {c : ℝ} (hc : 0 < c) {d B : ℂ} (hd0 : d ≠ 0)
    (hd : d ^ 2 = -Erdos1047CubicNormalize.cubicLinear f / 3)
    (hB : 0 ≤ B.re)
    (hnorm : Erdos1047CubicNormalize.normalizedCubic f d =
      Erdos1047Lean4Web.cubicPolynomial B) :
    {t ∈ Erdos1047.componentsIn
        (Erdos1047.strictSublevelSet f c) |
      ¬ Convex ℝ t}.ncard ≤ 2 := by
  have hdnorm : 0 < ‖d‖ ^ 3 := by
    have : 0 < ‖d‖ := norm_pos_iff.mpr hd0
    positivity
  let c0 : ℝ := c / ‖d‖ ^ 3
  have hc0 : 0 < c0 := div_pos hc hdnorm
  have hscale : ‖d‖ ^ 3 * c0 = c := by
    dsimp [c0]
    field_simp
  have hcenter :
      {t ∈ Erdos1047.componentsIn
          (Erdos1047.strictSublevelSet
            (Erdos1047Lean4Web.cubicPolynomial B) c0) |
        ¬ Convex ℝ t}.ncard ≤ 2 := by
    exact strict_centered_cubic_nonconvex_ncard_le_two hB hc0
  have htrans := affine_image_normalized_strict_nonconvex_components_ncard
    f hf hdeg hd0 hd c0
  rw [hscale] at htrans
  calc
    {t ∈ Erdos1047.componentsIn
        (Erdos1047.strictSublevelSet f c) |
      ¬ Convex ℝ t}.ncard =
        {t ∈ Erdos1047.componentsIn
            (Erdos1047.strictSublevelSet
              (Erdos1047CubicNormalize.normalizedCubic f d) c0) |
          ¬ Convex ℝ t}.ncard := htrans
    _ = {t ∈ Erdos1047.componentsIn
          (Erdos1047.strictSublevelSet
            (Erdos1047Lean4Web.cubicPolynomial B) c0) |
        ¬ Convex ℝ t}.ncard := by rw [hnorm]
    _ ≤ 2 := hcenter

theorem strict_monic_cubic_nonconvex_ncard_le_two_of_nonzero_linear
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3)
    {c : ℝ} (hc : 0 < c)
    (hlin : Erdos1047CubicNormalize.cubicLinear f ≠ 0) :
    {t ∈ Erdos1047.componentsIn
        (Erdos1047.strictSublevelSet f c) |
      ¬ Convex ℝ t}.ncard ≤ 2 := by
  let S : Set ℂ := Erdos1047.strictSublevelSet f c
  let Cset : Set (Set ℂ) := Erdos1047.componentsIn S
  let N : Set (Set ℂ) := {t ∈ Cset | ¬ Convex ℝ t}
  have hdegree : 0 < f.degree := by
    rw [degree_eq_natDegree hf.ne_zero]
    exact_mod_cast (show 0 < f.natDegree by omega)
  have hcompfin : Cset.Finite := by
    dsimp [Cset, S]
    rw [Erdos1047StrictGeneralCore.strict_componentsIn_eq_image_rootSet
      hf hdegree hc]
    exact (f.rootSet_finite ℂ).image _
  have hcomp_le : Cset.ncard ≤ 3 := by
    dsimp [Cset, S]
    simpa [hdeg] using
      (Erdos1047StrictGeneralCore.strict_componentsIn_ncard_le_natDegree
        hf hdegree hc)
  have hNsub : N ⊆ Cset := by
    intro t ht
    exact ht.1
  have hN_le_comp : N.ncard ≤ Cset.ncard :=
    Set.ncard_le_ncard hNsub hcompfin
  by_cases hcount3 : Cset.ncard = 3
  · obtain ⟨d, hd0, hd⟩ := Erdos1047CubicNormalize.exists_cubic_scale hlin
    let B0 : ℂ := Erdos1047CubicNormalize.normalizedCubicConstant f d
    by_cases hB0 : 0 ≤ B0.re
    · have hnorm : Erdos1047CubicNormalize.normalizedCubic f d =
          Erdos1047Lean4Web.cubicPolynomial B0 := by
        rfl
      have hbound := strict_monic_cubic_nonconvex_ncard_le_two_of_normalized
        f hf hdeg hc hd0 hd hB0 hnorm
      simpa [N, Cset, S] using hbound
    · have hnormneg : Erdos1047CubicNormalize.normalizedCubic f (-d) =
          Erdos1047Lean4Web.cubicPolynomial (-B0) := by
        apply Polynomial.funext
        intro z
        simp [Erdos1047CubicNormalize.normalizedCubic,
          Erdos1047Proof.cubicPolynomial,
          Erdos1047CubicNormalize.normalizedCubicConstant, B0]
        field_simp
      have hdneg0 : -d ≠ 0 := neg_ne_zero.mpr hd0
      have hdneg : (-d) ^ 2 =
          -Erdos1047CubicNormalize.cubicLinear f / 3 := by
        calc
          (-d) ^ 2 = d ^ 2 := by ring
          _ = -Erdos1047CubicNormalize.cubicLinear f / 3 := hd
      have hBneg : 0 ≤ (-B0).re := by
        simp only [Complex.neg_re]
        linarith
      have hbound := strict_monic_cubic_nonconvex_ncard_le_two_of_normalized
        f hf hdeg hc hdneg0 hdneg hBneg hnormneg
      simpa [N, Cset, S] using hbound
  · have hcount_le_two : Cset.ncard ≤ 2 := by omega
    have hNle : N.ncard ≤ 2 := hN_le_comp.trans hcount_le_two
    simpa [N, Cset, S] using hNle

def strictPureSublevel (b c : ℝ) : Set ℂ :=
  {z : ℂ | ‖Erdos1047PureCubic.pureCubicValue b z‖ < c}

theorem strict_pure_boundary_avoids
    {b c : ℝ} (hb : 0 < b) (hc : 0 ≤ c) (hcb : c ≤ b)
    {z : ℂ} (hline : z.re = 0 ∨
      Real.sqrt 3 * z.im + z.re = 0 ∨
      -Real.sqrt 3 * z.im + z.re = 0) :
    z ∉ strictPureSublevel b c := by
  intro hz
  have hnorm : ‖Erdos1047PureCubic.pureCubicValue b z‖ < c := hz
  have hnormb : ‖Erdos1047PureCubic.pureCubicValue b z‖ < b :=
    hnorm.trans_le hcb
  have hge := Erdos1047PureCubic.pure_boundary_normSq_ge hb.le hline
  rw [Complex.normSq_eq_norm_sq] at hge
  nlinarith [norm_nonneg
    (Erdos1047PureCubic.pureCubicValue b z)]

theorem strict_pure_component_stays_leftWedge
    {b c : ℝ} (hb : 0 < b) (hc : 0 ≤ c) (hcb : c ≤ b)
    {r : ℂ} (hr : r ∈ strictPureSublevel b c)
    (hrw : Erdos1047PureCubic.leftWedge r) :
    ∀ z ∈ connectedComponentIn (strictPureSublevel b c) r,
      Erdos1047PureCubic.leftWedge z := by
  let S : Set ℂ := strictPureSublevel b c
  have hzero0 : ∀ z ∈ S, z.re ≠ 0 := by
    intro z hz hline
    exact (strict_pure_boundary_avoids hb hc hcb (Or.inl hline)) hz
  have hzero1 : ∀ z ∈ S,
      Real.sqrt 3 * z.im + z.re ≠ 0 := by
    intro z hz hline
    exact (strict_pure_boundary_avoids hb hc hcb (Or.inr (Or.inl hline))) hz
  have hzero2 : ∀ z ∈ S,
      -Real.sqrt 3 * z.im + z.re ≠ 0 := by
    intro z hz hline
    exact (strict_pure_boundary_avoids hb hc hcb (Or.inr (Or.inr hline))) hz
  intro z hz
  have hx := Erdos1047PureCubic.negative_on_component
    (S := S) (r := r) (φ := fun w : ℂ => w.re) (by fun_prop)
    hzero0 (show r ∈ S from hr) hrw.1 z hz
  have hu := Erdos1047PureCubic.negative_on_component
    (S := S) (r := r) (φ := fun w : ℂ =>
      Real.sqrt 3 * w.im + w.re) (by fun_prop)
    hzero1 (show r ∈ S from hr) (by linarith [hrw.2.1]) z hz
  have hlo := Erdos1047PureCubic.negative_on_component
    (S := S) (r := r) (φ := fun w : ℂ =>
      -Real.sqrt 3 * w.im + w.re) (by fun_prop)
    hzero2 (show r ∈ S from hr) (by linarith [hrw.2.2]) z hz
  exact ⟨hx, by linarith, by linarith⟩

theorem strict_pure_one_component_convex_of_le_one
    {c : ℝ} (hc : 0 < c) (hcle : c ≤ 1) {r : ℂ}
    (hr : r ∈ strictPureSublevel 1 c)
    (hrw : Erdos1047PureCubic.leftWedge r) :
    Convex ℝ (connectedComponentIn (strictPureSublevel 1 c) r) := by
  let S : Set ℂ := strictPureSublevel 1 c
  let C : Set ℂ := connectedComponentIn S r
  have hpure_cont : Continuous (fun z : ℂ =>
      Erdos1047PureCubic.pureCubicValue 1 z) := by
    dsimp [Erdos1047PureCubic.pureCubicValue]
    fun_prop
  have hSopen : IsOpen S := by
    exact isOpen_lt (continuous_norm.comp hpure_cont) continuous_const
  have hCopen : IsOpen C := by
    dsimp [C]
    exact hSopen.connectedComponentIn
  have hpath : IsPathConnected C := by
    apply Erdos1047Lean4Web.pathConnected_component_of_isOpen
    · exact (show r ∈ S from hr)
    · exact hCopen
  have hstay : ∀ z ∈ C, Erdos1047PureCubic.leftWedge z := by
    intro z hz
    exact strict_pure_component_stays_leftWedge
      (b := 1) (c := c) (by norm_num) (le_of_lt hc) hcle hr hrw z hz
  rw [convex_iff_segment_subset]
  intro x hx y hy
  obtain ⟨γ, hγ⟩ := hpath.joinedIn x hx y hy
  let φ : unitInterval → ℝ := fun t =>
    ‖Erdos1047PureCubic.pureCubicValue 1 (γ t)‖
  have hφcont : Continuous φ := by
    dsimp [φ]
    exact (continuous_norm.comp hpure_cont).comp
      (by fun_prop)
  obtain ⟨tm, htm, hmax⟩ :=
    (isCompact_univ.exists_isMaxOn (f := φ)
      (Set.univ_nonempty : (Set.univ : Set unitInterval).Nonempty)
      hφcont.continuousOn)
  have hm_lt : φ tm < c := by
    have htmC : γ tm ∈ C := hγ tm
    have htmS : γ tm ∈ S := connectedComponentIn_subset S r htmC
    exact htmS
  let d : ℝ := (φ tm + c) / 2
  have hdm : φ tm < d := by
    dsimp [d]
    linarith
  have hdc : d < c := by
    dsimp [d]
    linarith
  have hd1 : d < 1 := lt_of_lt_of_le hdc hcle
  have hdp : 0 < d := by
    have hnon : 0 ≤ φ tm := norm_nonneg _
    dsimp [d]
    linarith
  have hpath_strict : ∀ t : unitInterval,
      t.1 ∈ Set.Icc (0 : ℝ) 1 →
      γ t ∈ strictPureSublevel 1 d := by
    intro t ht
    have hle : φ t ≤ φ tm := hmax (Set.mem_univ t)
    have hle' : ‖Erdos1047PureCubic.pureCubicValue 1 (γ t)‖ ≤ φ tm := by
      simpa [φ] using hle
    change ‖Erdos1047PureCubic.pureCubicValue 1 (γ t)‖ < d
    exact hle'.trans_lt hdm
  let Q : ℂ[X] := Polynomial.X ^ 3 + Polynomial.C (1 : ℂ)
  have hQmonic : Q.Monic := by
    dsimp [Q]
    monicity!
  have hQdeg : 0 < Q.degree := by
    have hQnat : Q.natDegree = 3 := by
      dsimp [Q]
      compute_degree!
    rw [degree_eq_natDegree hQmonic.ne_zero]
    rw [hQnat]
    norm_num
  have hx_strict : x ∈ Erdos1047.strictSublevelSet Q d := by
    change ‖Q.eval x‖ < d
    have hx' := hpath_strict (0 : unitInterval) (by norm_num)
    change ‖Erdos1047PureCubic.pureCubicValue 1 (γ 0)‖ < d at hx'
    have hx'' : ‖Erdos1047PureCubic.pureCubicValue 1 x‖ < d := by
      simpa only [γ.source] using hx'
    simpa [Q, Erdos1047PureCubic.pureCubicValue] using hx''
  have hy_strict : y ∈ Erdos1047.strictSublevelSet Q d := by
    change ‖Q.eval y‖ < d
    have hy' := hpath_strict (1 : unitInterval) (by norm_num)
    change ‖Erdos1047PureCubic.pureCubicValue 1 (γ 1)‖ < d at hy'
    have hy'' : ‖Erdos1047PureCubic.pureCubicValue 1 y‖ < d := by
      simpa only [γ.target] using hy'
    simpa [Q, Erdos1047PureCubic.pureCubicValue] using hy''
  obtain ⟨rr, hrrroot, hrrcomp⟩ :=
    Erdos1047StrictGeneralCore.strict_exists_root_in_component
      hQmonic hQdeg hdp x hx_strict
  have hrr_strict : rr ∈ Erdos1047.strictSublevelSet Q d :=
    connectedComponentIn_subset _ _ hrrcomp
  have hSsmall : Erdos1047.strictSublevelSet Q d ⊆ S := by
    intro z hz
    change ‖Q.eval z‖ < d at hz
    change ‖Erdos1047PureCubic.pureCubicValue 1 z‖ < c
    simpa [Q, Erdos1047PureCubic.pureCubicValue] using hz.trans hdc
  have hrrC : rr ∈ C := by
    have hrrx : rr ∈ connectedComponentIn S x :=
      connectedComponentIn_mono hSsmall hx_strict hrrcomp
    have hxC : x ∈ C := by simpa [C] using hx
    have hEq : connectedComponentIn S r = connectedComponentIn S x :=
      connectedComponentIn_eq hxC
    have hrrr : rr ∈ connectedComponentIn S r := hEq.symm ▸ hrrx
    simpa [C] using hrrr
  have hrrw : Erdos1047PureCubic.leftWedge rr := hstay rr hrrC
  let K : Set ℂ := Erdos1047PureCubic.pureSublevel 1 d
  have hsmallK : Erdos1047.strictSublevelSet Q d ⊆ K := by
    intro z hz
    change ‖Erdos1047PureCubic.pureCubicValue 1 z‖ ≤ d
    have hz' : ‖Erdos1047PureCubic.pureCubicValue 1 z‖ < d := by
      change ‖Q.eval z‖ < d at hz
      simpa [Q, Erdos1047PureCubic.pureCubicValue] using hz
    exact hz'.le
  have hxK : x ∈ K := hsmallK hx_strict
  have hyK : y ∈ K := hsmallK hy_strict
  have hrrK : rr ∈ K := by
    have hzero : Q.eval rr = 0 := hQmonic.mem_rootSet.mp hrrroot
    dsimp [K]
    change ‖Erdos1047PureCubic.pureCubicValue 1 rr‖ ≤ d
    have hzero' : Erdos1047PureCubic.pureCubicValue 1 rr = 0 := by
      simpa [Q, Erdos1047PureCubic.pureCubicValue] using hzero
    rw [hzero', norm_zero]
    exact le_of_lt hdp
  have hrrKx : rr ∈ connectedComponentIn K x :=
    connectedComponentIn_mono hsmallK hx_strict hrrcomp
  have hpathK : IsPreconnected (γ '' (Set.univ : Set unitInterval)) :=
    isPreconnected_univ.image γ γ.continuous.continuousOn
  have hpathKsub : γ '' (Set.univ : Set unitInterval) ⊆ K := by
    rintro z ⟨t, ht, rfl⟩
    have htQ : γ t ∈ Erdos1047.strictSublevelSet Q d := by
      change ‖Q.eval (γ t)‖ < d
      have ht' := hpath_strict t (by exact ⟨t.2.1, t.2.2⟩)
      change ‖Erdos1047PureCubic.pureCubicValue 1 (γ t)‖ < d at ht'
      simpa [Q, Erdos1047PureCubic.pureCubicValue] using ht'
    exact hsmallK htQ
  have hximg : x ∈ γ '' (Set.univ : Set unitInterval) :=
    ⟨0, Set.mem_univ _, γ.source⟩
  have hyimg : y ∈ γ '' (Set.univ : Set unitInterval) :=
    ⟨1, Set.mem_univ _, γ.target⟩
  have hyKx : y ∈ connectedComponentIn K x :=
    hpathK.subset_connectedComponentIn hximg hpathKsub hyimg
  have hcomp_eq : connectedComponentIn K x = connectedComponentIn K rr :=
    connectedComponentIn_eq hrrKx
  have hxKrr : x ∈ connectedComponentIn K rr := by
    rw [← hcomp_eq]
    exact mem_connectedComponentIn hxK
  have hyKrr : y ∈ connectedComponentIn K rr := by
    rw [← hcomp_eq]
    exact hyKx
  have hconvK : Convex ℝ (connectedComponentIn K rr) := by
    dsimp [K]
    exact Erdos1047PureCubic.pure_component_convex_of_subcritical
      (by norm_num) (le_of_lt hdp) hd1 (by exact hrrK) hrrw
  intro z hz
  have hzK : z ∈ connectedComponentIn K rr :=
    (convex_iff_segment_subset.mp hconvK) hxKrr hyKrr hz
  have hzlevel : ‖Erdos1047PureCubic.pureCubicValue 1 z‖ ≤ d :=
    connectedComponentIn_subset K rr hzK
  have hzS : z ∈ S := by
    change ‖Erdos1047PureCubic.pureCubicValue 1 z‖ < c
    exact hzlevel.trans_lt hdc
  have hzCx : z ∈ connectedComponentIn S x := by
    have hsegS : segment ℝ x y ⊆ S := by
      intro w hw
      have hwK : w ∈ connectedComponentIn K rr :=
        (convex_iff_segment_subset.mp hconvK) hxKrr hyKrr hw
      have hwlevel : ‖Erdos1047PureCubic.pureCubicValue 1 w‖ ≤ d :=
        connectedComponentIn_subset K rr hwK
      change ‖Erdos1047PureCubic.pureCubicValue 1 w‖ < c
      exact hwlevel.trans_lt hdc
    exact (convex_segment x y).isPreconnected.subset_connectedComponentIn
      (left_mem_segment ℝ x y) hsegS hz
  have hxC : x ∈ C := by simpa [C] using hx
  have hEq : connectedComponentIn S r = connectedComponentIn S x :=
    connectedComponentIn_eq hxC
  have hzC : z ∈ connectedComponentIn S r := hEq.symm ▸ hzCx
  simpa [C] using hzC

theorem strict_pureSublevel_starConvex_of_lt
    {b c : ℝ} (hb : 0 ≤ b) (hbc : b < c) :
    StarConvex ℝ 0 (strictPureSublevel b c) := by
  intro z hz a t ha ht hat
  change ‖Erdos1047PureCubic.pureCubicValue b
      (a • (0 : ℂ) + t • z)‖ < c
  rw [smul_zero, zero_add]
  change ‖Erdos1047PureCubic.pureCubicValue b z‖ < c at hz
  have ht1 : t ≤ 1 := by linarith
  have ht3 : 0 ≤ t ^ 3 := pow_nonneg ht _
  have ht31 : t ^ 3 ≤ 1 := by
    nlinarith [sq_nonneg t, mul_nonneg ht (sub_nonneg.mpr ht1)]
  have hid : Erdos1047PureCubic.pureCubicValue b (t • z) =
      (t ^ 3 : ℂ) * Erdos1047PureCubic.pureCubicValue b z +
        (1 - t ^ 3 : ℂ) * (b : ℂ) := by
    simp [Erdos1047PureCubic.pureCubicValue, Complex.real_smul]
    ring
  rw [hid]
  have hnorm :
      ‖(t ^ 3 : ℂ) * Erdos1047PureCubic.pureCubicValue b z +
          (1 - t ^ 3 : ℂ) * (b : ℂ)‖ ≤
        t ^ 3 * ‖Erdos1047PureCubic.pureCubicValue b z‖ +
          (1 - t ^ 3) * b := by
    calc
      _ ≤ ‖(t ^ 3 : ℂ) * Erdos1047PureCubic.pureCubicValue b z‖ +
          ‖(1 - t ^ 3 : ℂ) * (b : ℂ)‖ := norm_add_le _ _
      _ = t ^ 3 * ‖Erdos1047PureCubic.pureCubicValue b z‖ +
          (1 - t ^ 3) * b := by
        rw [norm_mul, norm_mul]
        have hcast0 : (t : ℂ) ^ 3 = ((t ^ 3 : ℝ) : ℂ) := by norm_num
        have hcast1 : (1 : ℂ) - ((t ^ 3 : ℝ) : ℂ) =
            ((1 - t ^ 3 : ℝ) : ℂ) := by norm_num
        rw [hcast0, hcast1]
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ht3]
        rw [Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (sub_nonneg.mpr ht31)]
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hb]
  by_cases ht0 : t = 0
  · subst t
    simp [Erdos1047PureCubic.pureCubicValue, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg hb]
    exact hbc
  · have htpos : 0 < t ^ 3 := pow_pos (lt_of_le_of_ne ht (Ne.symm ht0)) _
    have hstrict : t ^ 3 *
        ‖Erdos1047PureCubic.pureCubicValue b z‖ +
          (1 - t ^ 3) * b <
        t ^ 3 * c + (1 - t ^ 3) * c := by
      have h1 := mul_lt_mul_of_pos_left hz htpos
      have h2 := mul_le_mul_of_nonneg_left hbc.le
        (sub_nonneg.mpr ht31)
      linarith
    exact hnorm.trans_lt (by
      calc
        t ^ 3 * ‖Erdos1047PureCubic.pureCubicValue b z‖ +
              (1 - t ^ 3) * b <
            t ^ 3 * c + (1 - t ^ 3) * c := hstrict
        _ = c := by ring)

theorem strict_pure_one_nonconvex_ncard_le_two
    {c : ℝ} (hc : 0 < c) :
    {t ∈ Erdos1047.componentsIn (strictPureSublevel 1 c) |
      ¬ Convex ℝ t}.ncard ≤ 2 := by
  let Q : ℂ[X] := Polynomial.X ^ 3 + Polynomial.C (1 : ℂ)
  have hQmonic : Q.Monic := by
    dsimp [Q]
    monicity!
  have hQdeg : 0 < Q.degree := by
    have hQnat : Q.natDegree = 3 := by
      dsimp [Q]
      compute_degree!
    rw [degree_eq_natDegree hQmonic.ne_zero, hQnat]
    norm_num
  have hset : strictPureSublevel 1 c =
      Erdos1047.strictSublevelSet Q c := by
    ext z
    change ‖Erdos1047PureCubic.pureCubicValue 1 z‖ < c ↔ ‖Q.eval z‖ < c
    simp [Q, Erdos1047PureCubic.pureCubicValue]
  let Cset : Set (Set ℂ) := Erdos1047.componentsIn (strictPureSublevel 1 c)
  let N : Set (Set ℂ) := {t ∈ Cset | ¬ Convex ℝ t}
  have hcompfin : Cset.Finite := by
    dsimp [Cset]
    rw [hset]
    rw [Erdos1047StrictGeneralCore.strict_componentsIn_eq_image_rootSet
      hQmonic hQdeg hc]
    exact (Q.rootSet_finite ℂ).image _
  have hcomp_le : Cset.ncard ≤ 3 := by
    dsimp [Cset]
    rw [hset]
    have hQnat : Q.natDegree = 3 := by
      dsimp [Q]
      compute_degree!
    simpa [hQnat] using
      (Erdos1047StrictGeneralCore.strict_componentsIn_ncard_le_natDegree
        hQmonic hQdeg hc)
  have hNsub : N ⊆ Cset := by
    intro t ht
    exact ht.1
  have hN_le_comp : N.ncard ≤ Cset.ncard :=
    Set.ncard_le_ncard hNsub hcompfin
  by_cases hcle : c ≤ 1
  · by_cases hcount3 : Cset.ncard = 3
    · have hrmem : (-1 : ℂ) ∈ strictPureSublevel 1 c := by
        change ‖Erdos1047PureCubic.pureCubicValue 1 (-1 : ℂ)‖ < c
        norm_num [Erdos1047PureCubic.pureCubicValue, Complex.norm_real,
          Real.norm_eq_abs, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1)]
        exact hc
      have hrw : Erdos1047PureCubic.leftWedge (-1 : ℂ) := by
        norm_num [Erdos1047PureCubic.leftWedge]
      have hconv : Convex ℝ (connectedComponentIn
          (strictPureSublevel 1 c) (-1 : ℂ)) :=
        strict_pure_one_component_convex_of_le_one hc hcle hrmem hrw
      have hproper : N ⊂ Cset := by
        refine ⟨hNsub, ?_⟩
        intro hreverse
        have htC : connectedComponentIn
            (strictPureSublevel 1 c) (-1 : ℂ) ∈ Cset :=
          ⟨-1, hrmem, rfl⟩
        exact (hreverse htC).2 hconv
      have hlt : N.ncard < Cset.ncard :=
        Set.ncard_lt_ncard hproper hcompfin
      have hNle : N.ncard ≤ 2 := by omega
      simpa [N, Cset] using hNle
    · have hcount_le_two : Cset.ncard ≤ 2 := by omega
      have hNle : N.ncard ≤ 2 := hN_le_comp.trans hcount_le_two
      simpa [N, Cset] using hNle
  · have hc1 : 1 < c := lt_of_not_ge hcle
    have hstar : StarConvex ℝ 0 (strictPureSublevel 1 c) :=
      strict_pureSublevel_starConvex_of_lt (by norm_num) hc1
    have hzero : (0 : ℂ) ∈ strictPureSublevel 1 c := by
      change ‖Erdos1047PureCubic.pureCubicValue 1 (0 : ℂ)‖ < c
      norm_num [Erdos1047PureCubic.pureCubicValue, Complex.norm_real,
        Real.norm_eq_abs, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1)]
      exact hc1
    have hconn : IsConnected (strictPureSublevel 1 c) := by
      letI : ContractibleSpace (strictPureSublevel 1 c) :=
        hstar.contractibleSpace ⟨0, hzero⟩
      exact (isPathConnected_iff_pathConnectedSpace.mpr inferInstance).isConnected
    have hcount : Cset.ncard ≤ 1 := by
      dsimp [Cset]
      have hsub : Erdos1047.componentsIn (strictPureSublevel 1 c) ⊆
          {strictPureSublevel 1 c} := by
        intro t ht
        rcases ht with ⟨z, hz, rfl⟩
        rw [hconn.isPreconnected.connectedComponentIn hz]
        simp
      exact (Set.ncard_le_ncard hsub (Set.finite_singleton _)).trans_eq
        (by simp)
    have hNle : N.ncard ≤ 1 := hN_le_comp.trans hcount
    have hNle2 : N.ncard ≤ 2 := hNle.trans (by norm_num)
    simpa [N, Cset] using hNle2

theorem affine_image_pure_strictSublevelSet_eq
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3)
    (hlin : Erdos1047CubicNormalize.cubicLinear f = 0)
    {a B : ℂ} (ha : a ≠ 0) (ha3 : a ^ 3 = B)
    (hBf : Erdos1047CubicNormalize.cubicConstant f = B) (c : ℝ) :
    (fun z : ℂ => Erdos1047CubicNormalize.cubicCenter f + a * z) ''
        strictPureSublevel 1 (c / ‖a‖ ^ 3) =
      Erdos1047.strictSublevelSet f c := by
  have hanorm : 0 < ‖a‖ ^ 3 := by
    have : 0 < ‖a‖ := norm_pos_iff.mpr ha
    positivity
  have heval : ∀ z : ℂ, f.eval
      (Erdos1047CubicNormalize.cubicCenter f + a * z) =
      a ^ 3 * (z ^ 3 + (1 : ℂ)) := by
    intro z
    rw [Erdos1047CubicNormalize.monic_cubic_eval_center_add f hf hdeg]
    rw [hlin, hBf, ← ha3]
    rw [mul_pow]
    ring
  ext w
  constructor
  · rintro ⟨z, hz, rfl⟩
    change ‖f.eval (Erdos1047CubicNormalize.cubicCenter f + a * z)‖ < c
    have hz' : ‖z ^ 3 + (1 : ℂ)‖ < c / ‖a‖ ^ 3 := by
      change ‖Erdos1047PureCubic.pureCubicValue 1 z‖ <
        c / ‖a‖ ^ 3 at hz
      simpa [Erdos1047PureCubic.pureCubicValue] using hz
    rw [heval, norm_mul, norm_pow]
    calc
      ‖a‖ ^ 3 * ‖z ^ 3 + (1 : ℂ)‖ <
          ‖a‖ ^ 3 * (c / ‖a‖ ^ 3) :=
        mul_lt_mul_of_pos_left hz' hanorm
      _ = c := by field_simp
  · intro hw
    change ‖f.eval w‖ < c at hw
    let z : ℂ := (w - Erdos1047CubicNormalize.cubicCenter f) / a
    have hmap : Erdos1047CubicNormalize.cubicCenter f + a * z = w := by
      dsimp [z]
      field_simp [ha]
      ring
    refine ⟨z, ?_, hmap⟩
    change ‖Erdos1047PureCubic.pureCubicValue 1 z‖ < c / ‖a‖ ^ 3
    have hevalw : f.eval w = a ^ 3 * (z ^ 3 + (1 : ℂ)) := by
      rw [← hmap]
      exact heval z
    have hprod : ‖a‖ ^ 3 * ‖z ^ 3 + (1 : ℂ)‖ < c := by
      calc
        ‖a‖ ^ 3 * ‖z ^ 3 + (1 : ℂ)‖ = ‖f.eval w‖ := by
          rw [hevalw, norm_mul, norm_pow]
        _ < c := hw
    have hprod' : ‖z ^ 3 + (1 : ℂ)‖ * ‖a‖ ^ 3 < c := by
      simpa [mul_comm] using hprod
    have hz' : ‖z ^ 3 + (1 : ℂ)‖ < c / ‖a‖ ^ 3 :=
      (lt_div_iff₀ hanorm).2 hprod'
    simpa [Erdos1047PureCubic.pureCubicValue] using hz'

theorem strict_pure_zero_nonconvex_ncard_le_one
    {c : ℝ} (hc : 0 < c) :
    {t ∈ Erdos1047.componentsIn (strictPureSublevel 0 c) |
      ¬ Convex ℝ t}.ncard ≤ 1 := by
  let S : Set ℂ := strictPureSublevel 0 c
  have hzero : (0 : ℂ) ∈ S := by
    change ‖Erdos1047PureCubic.pureCubicValue 0 (0 : ℂ)‖ < c
    simpa [Erdos1047PureCubic.pureCubicValue] using hc
  have hstar : StarConvex ℝ 0 S := by
    dsimp [S]
    exact strict_pureSublevel_starConvex_of_lt (b := 0) (c := c)
      (by norm_num) hc
  have hconn : IsConnected S := by
    letI : ContractibleSpace S := hstar.contractibleSpace ⟨0, hzero⟩
    exact (isPathConnected_iff_pathConnectedSpace.mpr inferInstance).isConnected
  let Cset : Set (Set ℂ) := Erdos1047.componentsIn S
  have hCsub : Cset ⊆ {S} := by
    intro t ht
    rcases ht with ⟨z, hz, rfl⟩
    rw [hconn.isPreconnected.connectedComponentIn hz]
    simp
  have hCfin : Cset.Finite := (Set.finite_singleton S).subset hCsub
  have hCle : Cset.ncard ≤ 1 := by
    exact (Set.ncard_le_ncard hCsub (Set.finite_singleton S)).trans_eq
      (by simp)
  let N : Set (Set ℂ) := {t ∈ Cset | ¬ Convex ℝ t}
  have hNsub : N ⊆ Cset := by
    intro t ht
    exact ht.1
  have hNle : N.ncard ≤ 1 := (Set.ncard_le_ncard hNsub hCfin).trans hCle
  simpa [N, Cset, S] using hNle

theorem strict_monic_cubic_nonconvex_ncard_le_two_of_zero_linear
    (f : ℂ[X]) (hf : f.Monic) (hdeg : f.natDegree = 3)
    {c : ℝ} (hc : 0 < c)
    (hlin : Erdos1047CubicNormalize.cubicLinear f = 0) :
    {t ∈ Erdos1047.componentsIn
        (Erdos1047.strictSublevelSet f c) |
      ¬ Convex ℝ t}.ncard ≤ 2 := by
  let B : ℂ := Erdos1047CubicNormalize.cubicConstant f
  by_cases hB : B = 0
  ·
    have hBf0 : Erdos1047CubicNormalize.cubicConstant f = 0 := by
      simpa [B] using hB
    have himage :
        (fun z : ℂ => Erdos1047CubicNormalize.cubicCenter f + (1 : ℂ) * z) ''
            strictPureSublevel 0 c =
          Erdos1047.strictSublevelSet f c := by
      ext w
      constructor
      · rintro ⟨z, hz, rfl⟩
        change ‖f.eval
          (Erdos1047CubicNormalize.cubicCenter f + (1 : ℂ) * z)‖ < c
        rw [Erdos1047CubicNormalize.monic_cubic_eval_center_add f hf hdeg]
        rw [hlin, hBf0]
        change ‖Erdos1047PureCubic.pureCubicValue 0 z‖ < c at hz
        simpa [Erdos1047PureCubic.pureCubicValue] using hz
      · intro hw
        change ‖f.eval w‖ < c at hw
        let z : ℂ := w - Erdos1047CubicNormalize.cubicCenter f
        have hmap : Erdos1047CubicNormalize.cubicCenter f + (1 : ℂ) * z = w := by
          dsimp [z]
          ring
        refine ⟨z, ?_, hmap⟩
        change ‖Erdos1047PureCubic.pureCubicValue 0 z‖ < c
        rw [Erdos1047PureCubic.pureCubicValue]
        have heval : f.eval
            (Erdos1047CubicNormalize.cubicCenter f + z) = z ^ 3 := by
          rw [Erdos1047CubicNormalize.monic_cubic_eval_center_add f hf hdeg]
          rw [hlin, hBf0]
          ring
        have hmap' : Erdos1047CubicNormalize.cubicCenter f + z = w := by
          simpa using hmap
        have hw' : ‖f.eval
            (Erdos1047CubicNormalize.cubicCenter f + z)‖ < c := by
          simpa [hmap'] using hw
        simpa [heval] using hw'
    have htrans := Erdos1047Lean4Web.affine_image_nonconvex_components_ncard
      (Erdos1047CubicNormalize.cubicCenter f) (1 : ℂ) (by norm_num)
        (S := strictPureSublevel 0 c)
    rw [himage] at htrans
    have hNleQ := strict_pure_zero_nonconvex_ncard_le_one hc
    exact htrans ▸ hNleQ.trans (by omega : (1 : ℕ) ≤ 2)
  · obtain ⟨a, ha3⟩ := IsAlgClosed.exists_pow_nat_eq B
      (by norm_num : (0 : ℕ) < 3)
    have ha : a ≠ 0 := by
      intro ha0
      subst a
      simp at ha3
      exact hB ha3.symm
    let c0 : ℝ := c / ‖a‖ ^ 3
    have hc0 : 0 < c0 := by
      dsimp [c0]
      exact div_pos hc (by
        have : 0 < ‖a‖ := norm_pos_iff.mpr ha
        positivity)
    have hBf : Erdos1047CubicNormalize.cubicConstant f = B := by
      rfl
    have himage := affine_image_pure_strictSublevelSet_eq
      f hf hdeg hlin ha ha3 hBf c
    have himage' :
        (fun z : ℂ => Erdos1047CubicNormalize.cubicCenter f + a * z) ''
            strictPureSublevel 1 c0 =
          Erdos1047.strictSublevelSet f c := by
      simpa [c0] using himage
    have htrans := Erdos1047Lean4Web.affine_image_nonconvex_components_ncard
      (Erdos1047CubicNormalize.cubicCenter f) a ha
        (S := strictPureSublevel 1 c0)
    rw [himage'] at htrans
    have hpure := strict_pure_one_nonconvex_ncard_le_two hc0
    calc
      {t ∈ Erdos1047.componentsIn
          (Erdos1047.strictSublevelSet f c) | ¬ Convex ℝ t}.ncard =
          {t ∈ Erdos1047.componentsIn (strictPureSublevel 1 c0) |
            ¬ Convex ℝ t}.ncard := htrans
      _ ≤ 2 := hpure

theorem strict_attainable_degree_three_le_two {k : ℕ}
    (hk : k ∈ Erdos1047StrictLowDegreeAudit.strictAttainableNonConvexCounts 3) :
    k ≤ 2 := by
  obtain ⟨f, c, hf, hdeg, hc, hcount⟩ := hk
  rw [← hcount]
  by_cases hlin : Erdos1047CubicNormalize.cubicLinear f = 0
  · exact strict_monic_cubic_nonconvex_ncard_le_two_of_zero_linear
      f hf hdeg hc hlin
  · exact strict_monic_cubic_nonconvex_ncard_le_two_of_nonzero_linear
      f hf hdeg hc hlin

#print axioms strict_cubic_component_stays_left
#print axioms strict_component_convex_of_le_critical
#print axioms strict_centered_cubic_nonconvex_ncard_le_two
#print axioms affine_image_normalized_strictSublevelSet_eq
#print axioms affine_image_normalized_strict_nonconvex_components_ncard
#print axioms strict_monic_cubic_nonconvex_ncard_le_two_of_normalized
#print axioms strict_monic_cubic_nonconvex_ncard_le_two_of_nonzero_linear
#print axioms strict_pure_zero_nonconvex_ncard_le_one
#print axioms strict_monic_cubic_nonconvex_ncard_le_two_of_zero_linear
#print axioms strict_attainable_degree_three_le_two

end
