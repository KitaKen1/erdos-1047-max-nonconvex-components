section


/-!
# A general degree-raising step for real witness families

Choose a lower old level, synchronize it with the subcritical new level, and
separate the new pair from the old family by the fixed old sphere. The resulting
finite certificates and component labels form a witness family of degree `n+2`.
Concrete seeds and the all-degree induction are in `Erdos1047BalancedInduction`.
-/

open Polynomial Set Filter Erdos1047 Erdos1047Proof
open scoped Topology
open Erdos1047BalancedRaise Erdos1047BalancedNormalization Erdos1047BalancedTransport
open Erdos1047BalancedCertificates Erdos1047BalancedOldComponents

namespace Erdos1047BalancedStep

noncomputable section

/-- Keep the analytic function and anchors as parameters while generating the
record eliminator: expanding the full balanced formulas here is unnecessarily costly. -/
structure SeparatedCertificateData {m n : ℕ} (F : ℂ → ℂ) (c : ℝ)
    (r a b : Fin m → ℂ) (s u v : Fin n → ℂ) where
  level_pos : 0 < c
  old_certificate : ∀ i, RobustNonconvexCertificate F c (r i) (a i) (b i)
  new_certificate : ∀ i, RobustNonconvexCertificate F c (s i) (u i) (v i)
  old_component_injective : Function.Injective (fun i => connectedComponentIn {z | ‖F z‖ < c} (r i))
  new_component_injective : Function.Injective (fun i => connectedComponentIn {z | ‖F z‖ < c} (s i))
  old_new_components_ne : ∀ i j, connectedComponentIn {z | ‖F z‖ < c} (r i) ≠
    connectedComponentIn {z | ‖F z‖ < c} (s j)

abbrev RaisedFamilyData {n : ℕ} (w : RealWitnessFamily n) (b L : ℝ) :=
  SeparatedCertificateData (fun z => (raised w.polynomial b L).eval z) (raisedLevel w.polynomial b L)
    w.anchor w.pointA w.pointB
    (newAnchor w.polynomial b L) (newPointA w.polynomial b L) (newPointB w.polynomial b L)

theorem exists_eventual_raised_data {n : ℕ} (w : RealWitnessFamily n) (hn : 2 < n) :
    ∃ b : ℝ, 0 < b ∧ b < w.level ∧ ∀ᶠ L : ℝ in atTop, Nonempty (RaisedFamilyData w b L) := by
  obtain ⟨b, hb, hbc, hold⟩ :=
    Erdos1047BalancedOldComponents.RealWitnessFamily.exists_level_preserving_old_family w hn
  have hdeg : 2 < w.polynomial.natDegree := by simpa only [w.degree] using hn
  have hlevel := tendsto_movingLevel w.monic hdeg b
  have hanchors : ∀ z ∈ Set.range w.anchor,
      z ∈ strictSublevelSet (complexify w.polynomial) w.level := by
    rintro _ ⟨i, rfl⟩
    exact certificate_anchor_mem (w.certificate i)
  obtain ⟨R, hR, hball, hcontrol⟩ :=
    exists_eventual_old_region_control w.monic hdeg hbc hanchors b hlevel
  refine ⟨b, hb, hbc, ?_⟩
  filter_upwards [hold (movingLevel w.polynomial b) hlevel,
    eventually_new_certificates w.monic hdeg hb,
    eventually_new_components_injective w.monic hdeg hb,
    eventually_raisedLevel_pos w.monic hdeg hb,
    eventually_parameters_pos w.monic hdeg hb, hcontrol, eventually_gt_atTop R]
    with L holdL hnewL hinjnew hlevelpos hpos hcontrolL hLR
  let oldCert := fun i => Classical.choice (holdL.1 i)
  let newCert := fun i => Classical.choice (hnewL i)
  refine ⟨{
    level_pos := hlevelpos
    old_certificate := oldCert
    new_certificate := newCert
    old_component_injective := ?_
    new_component_injective := hinjnew
    old_new_components_ne := ?_
  }⟩
  · intro i j heq
    apply w.anchor_injective
    exact holdL.2 (Set.mem_range_self i) (Set.mem_range_self j) heq
  · intro i j
    apply components_ne_of_sphere_avoidance
      (certificate_anchor_mem (oldCert i)) (certificate_anchor_mem (newCert j))
      (hball _ (Set.mem_range_self i)) _ hcontrolL.1
    exact hLR.le.trans (centre_le_newAnchor_norm hpos.2.2.2.2.1.le hpos.2.2.2.2.2.1.le j)

def RaisedFamilyData.toWitnessFamily {n : ℕ} {w : RealWitnessFamily n} {b L : ℝ}
    (d : RaisedFamilyData w b L) : RealWitnessFamily (n + 2) := by
  let r := Fin.append w.anchor (newAnchor w.polynomial b L)
  let comp := fun z => connectedComponentIn
    (strictSublevelSet (raised w.polynomial b L) (raisedLevel w.polynomial b L)) z
  have hinj : Function.Injective (fun i => comp (r i)) := by
    have heq : (fun i => comp (r i)) =
        Fin.append (fun i => comp (w.anchor i)) (fun j => comp (newAnchor w.polynomial b L j)) := by
      ext i
      cases i using Fin.addCases <;> simp [r]
    rw [heq]
    exact Fin.append_injective_iff.mpr
      ⟨d.old_component_injective, d.new_component_injective, d.old_new_components_ne⟩
  refine {
    polynomial := raisedReal w.polynomial b L
    monic := Polynomial.monic_of_injective (algebraMap ℝ ℂ).injective (raised_monic w.monic b L)
    degree := ?_
    level := raisedLevel w.polynomial b L
    level_pos := d.level_pos
    anchor := r
    pointA := Fin.append w.pointA (newPointA w.polynomial b L)
    pointB := Fin.append w.pointB (newPointB w.polynomial b L)
    anchor_injective := fun i j heq => hinj (congrArg comp heq)
    certificate := ?_
    component_injective := ?_
  }
  · have h := raised_natDegree w.monic b L
    simpa only [raised, complexify, natDegree_map_eq_of_injective (algebraMap ℝ ℂ).injective,
      w.degree] using h
  · intro i
    cases i using Fin.addCases
    · simpa only [r, Fin.append_left, raised] using d.old_certificate _
    · simpa only [r, Fin.append_right, raised] using d.new_certificate _
  · rintro x ⟨i, rfl⟩ y ⟨j, rfl⟩ heq
    exact congrArg r (hinj heq)

/-- The complete general `n → n+2` step. It preserves a real monic polynomial,
positive common level, robust certificates, and distinct anchor components. -/
theorem raise_by_two {n : ℕ} (w : RealWitnessFamily n) (hn : 2 < n) :
    Nonempty (RealWitnessFamily (n + 2)) := by
  obtain ⟨b, hb, hbc, hevent⟩ := exists_eventual_raised_data w hn
  obtain ⟨L, ⟨d⟩⟩ := hevent.exists
  exact ⟨d.toWitnessFamily⟩

/-- info: 'Erdos1047BalancedStep.exists_eventual_raised_data' depends on axioms:
[propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms exists_eventual_raised_data

