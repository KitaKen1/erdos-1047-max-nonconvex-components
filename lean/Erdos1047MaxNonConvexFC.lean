/-- Convert a strict squared-norm estimate on the affine parameterization into
strict containment of the corresponding real segment. -/
theorem segment_strict_of_parametric_normSq_lt
    {F : ℂ → ℂ} {c : ℝ} {r a : ℂ} (hc : 0 ≤ c)
    (h : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
      Complex.normSq (F (r + (t : ℂ) * (a - r))) < c ^ 2) :
    ∀ z ∈ segment ℝ r a, ‖F z‖ < c := by
  rintro z ⟨u, v, hu, hv, huv, rfl⟩
  have hv1 : v ≤ 1 := by linarith
  have hparam : u • r + v • a = r + (v : ℂ) * (a - r) := by
    rw [Complex.real_smul, Complex.real_smul]
    have huv' : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
    linear_combination r * huv'
  rw [hparam]
  have hs := h v hv hv1
  rw [Complex.normSq_eq_norm_sq] at hs
  nlinarith [norm_nonneg (F (r + (v : ℂ) * (a - r)))]

/-- A degree-ten Bernstein certificate, used because the squared norm of a
quintic restricted to a real segment has degree ten. -/
theorem bernstein10_nonpos (t c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 : ℝ)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hc0 : c0 ≤ 0) (hc1 : c1 ≤ 0) (hc2 : c2 ≤ 0) (hc3 : c3 ≤ 0)
    (hc4 : c4 ≤ 0) (hc5 : c5 ≤ 0) (hc6 : c6 ≤ 0) (hc7 : c7 ≤ 0)
    (hc8 : c8 ≤ 0) (hc9 : c9 ≤ 0) (hc10 : c10 ≤ 0) :
    c0 * t ^ 0 * (1 - t) ^ 10 + c1 * t ^ 1 * (1 - t) ^ 9 +
      c2 * t ^ 2 * (1 - t) ^ 8 + c3 * t ^ 3 * (1 - t) ^ 7 +
      c4 * t ^ 4 * (1 - t) ^ 6 + c5 * t ^ 5 * (1 - t) ^ 5 +
      c6 * t ^ 6 * (1 - t) ^ 4 + c7 * t ^ 7 * (1 - t) ^ 3 +
      c8 * t ^ 8 * (1 - t) ^ 2 + c9 * t ^ 9 * (1 - t) ^ 1 +
      c10 * t ^ 10 * (1 - t) ^ 0 ≤ 0 := by
  have hsub : 0 ≤ 1 - t := by linarith
  have h0 := mul_nonpos_of_nonpos_of_nonneg hc0
    (mul_nonneg (pow_nonneg ht0 0) (pow_nonneg hsub 10))
  have h1 := mul_nonpos_of_nonpos_of_nonneg hc1
    (mul_nonneg (pow_nonneg ht0 1) (pow_nonneg hsub 9))
  have h2 := mul_nonpos_of_nonpos_of_nonneg hc2
    (mul_nonneg (pow_nonneg ht0 2) (pow_nonneg hsub 8))
  have h3 := mul_nonpos_of_nonpos_of_nonneg hc3
    (mul_nonneg (pow_nonneg ht0 3) (pow_nonneg hsub 7))
  have h4 := mul_nonpos_of_nonpos_of_nonneg hc4
    (mul_nonneg (pow_nonneg ht0 4) (pow_nonneg hsub 6))
  have h5 := mul_nonpos_of_nonpos_of_nonneg hc5
    (mul_nonneg (pow_nonneg ht0 5) (pow_nonneg hsub 5))
  have h6 := mul_nonpos_of_nonpos_of_nonneg hc6
    (mul_nonneg (pow_nonneg ht0 6) (pow_nonneg hsub 4))
  have h7 := mul_nonpos_of_nonpos_of_nonneg hc7
    (mul_nonneg (pow_nonneg ht0 7) (pow_nonneg hsub 3))
  have h8 := mul_nonpos_of_nonpos_of_nonneg hc8
    (mul_nonneg (pow_nonneg ht0 8) (pow_nonneg hsub 2))
  have h9 := mul_nonpos_of_nonpos_of_nonneg hc9
    (mul_nonneg (pow_nonneg ht0 9) (pow_nonneg hsub 1))
  have h10 := mul_nonpos_of_nonpos_of_nonneg hc10
    (mul_nonneg (pow_nonneg ht0 10) (pow_nonneg hsub 0))
  nlinarith

theorem bernstein10_neg (t c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 : ℝ)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hc0 : c0 < 0) (hc1 : c1 ≤ 0) (hc2 : c2 ≤ 0) (hc3 : c3 ≤ 0)
    (hc4 : c4 ≤ 0) (hc5 : c5 ≤ 0) (hc6 : c6 ≤ 0) (hc7 : c7 ≤ 0)
    (hc8 : c8 ≤ 0) (hc9 : c9 ≤ 0) (hc10 : c10 < 0) :
    c0 * t ^ 0 * (1 - t) ^ 10 + c1 * t ^ 1 * (1 - t) ^ 9 +
      c2 * t ^ 2 * (1 - t) ^ 8 + c3 * t ^ 3 * (1 - t) ^ 7 +
      c4 * t ^ 4 * (1 - t) ^ 6 + c5 * t ^ 5 * (1 - t) ^ 5 +
      c6 * t ^ 6 * (1 - t) ^ 4 + c7 * t ^ 7 * (1 - t) ^ 3 +
      c8 * t ^ 8 * (1 - t) ^ 2 + c9 * t ^ 9 * (1 - t) ^ 1 +
      c10 * t ^ 10 * (1 - t) ^ 0 < 0 := by
  by_cases ht : t < 1
  · have hrest := bernstein10_nonpos t 0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 ht0 ht1
      (le_refl 0) hc1 hc2 hc3 hc4 hc5 hc6 hc7 hc8 hc9 hc10.le
    have hfirst : c0 * t ^ 0 * (1 - t) ^ 10 < 0 := by
      simpa using mul_neg_of_neg_of_pos hc0 (show 0 < (1 - t) ^ 10 by positivity)
    nlinarith
  · have ht' : t = 1 := le_antisymm ht1 (le_of_not_gt ht)
    simpa [ht'] using hc10

