namespace Erdos1047Proof

noncomputable section

/-- Proposed exact answer to the Formal Conjectures target. -/
def maxNonConvexAnswer (n : ℕ) : ℕ :=
  if n ≤ 2 then 0 else if n = 3 then 2 else n

@[simp] theorem maxNonConvexAnswer_of_le_two {n : ℕ} (h : n ≤ 2) :
    maxNonConvexAnswer n = 0 := by
  simp [maxNonConvexAnswer, h]

@[simp] theorem maxNonConvexAnswer_three : maxNonConvexAnswer 3 = 2 := by
  norm_num [maxNonConvexAnswer]

@[simp] theorem maxNonConvexAnswer_of_four_le {n : ℕ} (h : 4 ≤ n) :
    maxNonConvexAnswer n = n := by
  simp [maxNonConvexAnswer, show ¬n ≤ 2 by omega, show n ≠ 3 by omega]

/-- The quintic polynomial proposed for the degree-five construction. -/
def p5Polynomial : ℂ[X] :=
  X ^ 5 + C (15 / 8 : ℂ) * X ^ 4 - C (55 / 48 : ℂ) * X ^ 3 -
    C (145 / 32 : ℂ) * X ^ 2 + C (6066209 / 1069056 : ℂ)

/-- The derivative of `p5Polynomial`, factored to expose all four critical points.

Unlike the earlier algebra spike, this theorem directly mentions `Polynomial.derivative`.
-/
theorem p5Polynomial_derivative :
    p5Polynomial.derivative =
      C 5 * X * (X - C 1) * (X ^ 2 + C (5 / 2 : ℂ) * X + C (29 / 16 : ℂ)) := by
  apply Polynomial.funext
  intro z
  norm_num [p5Polynomial]
  ring

def p5Level : ℝ := 3070625 / 1069056

def p5SPlus : ℂ := (-5 / 4 : ℂ) + Complex.I / 2

def p5SMinus : ℂ := (-5 / 4 : ℂ) - Complex.I / 2

/-! The even-family algebraic candidate used for the first unresolved
degree-raising case.  The core file proves the algebraic facts; this
target-level alias keeps the candidate visible next to the p₅ witness while
making no claim yet about its sublevel-set geometry. -/

def p6Polynomial : ℂ[X] := Erdos1047EvenFamily.evenFamilyPolynomial 3

theorem p6Polynomial_expanded :
    p6Polynomial = X ^ 6 - C (2 : ℂ) * X ^ 3 + C (2 : ℂ) := by
  simpa [p6Polynomial] using Erdos1047EvenFamily.evenFamily_three_expanded

theorem p6Polynomial_algebraic_data :
    p6Polynomial.Monic ∧ p6Polynomial.natDegree = 6 ∧ p6Polynomial.Separable ∧
      (p6Polynomial.rootSet ℂ).ncard = 6 := by
  simpa [p6Polynomial] using Erdos1047EvenFamily.evenFamily_six_algebraic_data

/-! The even-family symmetry is exposed at target level so that a single
    non-convex witness can be transported to the other roots in its rotational
    orbit. -/
theorem evenFamily_eval_mul_root_of_unity {m : ℕ} {u z : ℂ}
    (hu : u ^ m = 1) :
    (Erdos1047EvenFamily.evenFamilyPolynomial m).eval (u * z) =
      (Erdos1047EvenFamily.evenFamilyPolynomial m).eval z := by
  exact Erdos1047EvenFamily.evenFamily_eval_mul_root_of_unity hu

theorem evenFamily_root_unity_component_image_eq
    {m : ℕ} (hm : 0 < m) {u : ℂ} (hu : u ^ m = 1)
    {c : ℝ} {x : ℂ}
    (hx : x ∈ sublevelSet
      (Erdos1047EvenFamily.evenFamilyPolynomial m) c) :
    (fun z : ℂ => u * z) '' connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) x =
      connectedComponentIn
        (sublevelSet (Erdos1047EvenFamily.evenFamilyPolynomial m) c) (u * x) := by
  change x ∈ {z : ℂ |
    ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ ≤ c} at hx
  change (fun z : ℂ => u * z) '' connectedComponentIn
      {z : ℂ | ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ ≤ c} x =
    connectedComponentIn
      {z : ℂ | ‖(Erdos1047EvenFamily.evenFamilyPolynomial m).eval z‖ ≤ c} (u * x)
  exact Erdos1047EvenFamily.evenFamily_mul_root_unity_connectedComponentIn_eq
    hm hu hx

